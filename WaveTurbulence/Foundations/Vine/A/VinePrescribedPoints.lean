module
public import WaveTurbulence.Foundations.Vine.A.VineFineRefinement
public import WaveTurbulence.Foundations.Vine.A.VineGroupExtension
public import Mathlib.Logic.Relation
/-! Fine LF classes with explicit local prescriptions. The exact projection
onto gardens is proved separately; prescription path independence is not assumed. -/
@[expose] public section
set_option autoImplicit false
namespace WaveTurbulence.VineA
open Stage1 RedSplice LFTwist Reg.Skeleton Represents
variable {w p : ℕ} {kind : Bool}

/-- An actual garden with its unique prime reconstruction and a local prescription. -/
structure PrescribedPrimeGarden (w : ℕ) where
  layered : LayeredGarden w
  prime : PrimeData layered
  sigma : GroupPrescription prime.skeleton

namespace PrescribedPrimeGarden

/-- Canonically extend the finite group prescription for S2a's total API. -/
noncomputable def totalSigma (a : PrescribedPrimeGarden w) : Prescription a.prime.skeleton :=
  extendGroupPrescription a.sigma

/-- The actual fine family state of the prescribed garden. -/
noncomputable def state (a : PrescribedPrimeGarden w) := a.prime.fineState a.totalSigma

/-- The actual once-per-member garden output set. -/
def outputs (a : PrescribedPrimeGarden w) : Set (LayeredGarden w) :=
  a.state.allCoreOutputs (p := p) (kind := kind)

/-- Retain the actual transported local prescription at an actual prime output. -/
def ofState {ι : Type*} (A : FamilyReconstruction w ι) (hp : IsPrimeGarden A.skeleton)
    (σ : GroupPrescription A.skeleton) : PrescribedPrimeGarden w :=
  ⟨A.layered, ⟨A.skeleton, hp, A.data, A.decodes⟩, σ⟩

/-- An edge records an actual once-per-member fine batch and its actual sigma transport. -/
def BatchReach (a b : PrescribedPrimeGarden w) : Prop :=
  ∃ (L : List (CoreIndex (vinesV0 a.prime.skeleton a.totalSigma)))
    (B : FamilyReconstruction w (CoreIndex (vinesV0 a.prime.skeleton a.totalSigma)))
    (h : FamilyBatch p kind L a.state B), L.Perm Finset.univ.toList ∧
      b = ofState B (batch_prime h a.prime.prime) (transportGroupPrescription (batchMolIso h) a.sigma)

/-- Actual batch edges preserve the exact once-per-member garden output set. -/
theorem BatchReach.outputs_eq {a b : PrescribedPrimeGarden w} (h : BatchReach (p := p) (kind := kind) a b) :
    a.outputs (p := p) (kind := kind) = b.outputs (p := p) (kind := kind) := by
  obtain ⟨L, B, hb, hL, rfl⟩ := h
  have hr := fine_outputs_rebase hb hL a.prime.prime a.totalSigma (fineState_isV0Fam a.prime a.totalSigma)
  have ht : transportPrescription (batchMolIso hb) a.totalSigma =
      extendGroupPrescription (transportGroupPrescription (batchMolIso hb) a.sigma) :=
    transport_extendGroupPrescription (batchMolIso hb) a.sigma
  rw [ht] at hr
  exact hr

/-- Equivalence generated by actual prescribed batch edges. -/
def Related (a b : PrescribedPrimeGarden w) : Prop :=
  Relation.EqvGen (BatchReach (p := p) (kind := kind)) a b

/-- Prescribed connectivity preserves the exact original batch output set. -/
theorem Related.outputs_eq {a b : PrescribedPrimeGarden w} (h : Related (p := p) (kind := kind) a b) :
    a.outputs (p := p) (kind := kind) = b.outputs (p := p) (kind := kind) := by
  induction h with
  | rel _ _ h => exact h.outputs_eq
  | refl _ => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih hj => exact ih.trans hj

/-- Each prescribed point belongs to its actual once-per-member garden output set. -/
theorem mem_outputs_self (a : PrescribedPrimeGarden w) :
    a.layered ∈ a.outputs (p := p) (kind := kind) := a.prime.mem_fine_outputs_self a.totalSigma

end PrescribedPrimeGarden
end WaveTurbulence.VineA
