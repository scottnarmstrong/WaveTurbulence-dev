/-! Actual fine garden output classes lie in their coarse class and rebase at every member. -/
@[expose] public section
set_option autoImplicit false
set_option linter.unusedSectionVars false
namespace WaveTurbulence.GammaLow.Fama.VineA
open WaveTurbulence.VineA WaveTurbulence.GammaLow.FinalCount
open Stage1 Twist RedSplice LFTwist Reg.Skeleton WaveTurbulence.GammaLow.FinalCount
variable {w p : ℕ} {kind : Bool} {LG LH : LayeredGarden w} {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]





/-- Source-level containment uses actual restricted batches, rather than generated reachability. -/
theorem PrimeData.fine_outputs_subset_coarse (A : PrimeData LG) (σ : Prescription A.skeleton) :
    (PrimeData.fineState γ A σ).allCoreOutputs (p := p) (kind := kind) ⊆
      (PrimeData.coarseState γ A).allCoreOutputs (p := p) (kind := kind) := by
  change (PrimeData.state γ A (vinesV0 γ A.skeleton σ) (vinesV0_subset A.skeleton σ)).allCoreOutputs ⊆ _
  rw [PrimeData.state_eq_restrict A _ _ _ (fun _ h => h) (vinesV0_subset A.skeleton σ)]
  exact allCoreOutputs_restrict_subset _ _ _



/-- Every prescribed garden belongs to its actual fine output class. -/
theorem PrimeData.mem_fine_outputs_self (A : PrimeData LG) (σ : Prescription A.skeleton) :
    LG ∈ (PrimeData.fineState γ A σ).allCoreOutputs (p := p) (kind := kind) :=
  (congruent_layered_iff p kind (PrimeData.fineState γ A σ) LG).mpr
    ⟨PrimeData.fineState γ A σ, WaveTurbulence.Stage1.Congruent.refl p kind (PrimeData.fineState γ A σ), rfl⟩


end WaveTurbulence.GammaLow.Fama.VineA
