/-! Recover a prime exact selected-family state γ from its actual layered
garden and prescription, up to a proved change of family enumeration. -/
@[expose] public section
set_option autoImplicit false
set_option linter.unusedSectionVars false
namespace WaveTurbulence.GammaLow.Fama.VineA
open WaveTurbulence.VineA WaveTurbulence.GammaLow.FinalCount
open WaveTurbulence.Stage1 WaveTurbulence.RedSplice WaveTurbulence.Twist WaveTurbulence.GammaLow.FinalCount
open WaveTurbulence.LFTwist WaveTurbulence.Reg.Skeleton WaveTurbulence.GammaLow.FinalCount
variable {w : ℕ} {ι : Type*} {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]

/-- Canonical fine reconstruction recovers the entire actual state γ up to reindexing. -/
theorem fineState_recovery (A : FamilyReconstruction w ι) (hp : IsPrimeGarden A.skeleton)
    (σ : Prescription A.skeleton) (hF : IsV0Fam γ A.family σ) :
    ∃ e : ι ≃ CoreIndex γ (vinesV0 γ A.skeleton σ),
      stateReindex (PrimeData.fineState γ (⟨A.skeleton, hp, A.data, A.decodes⟩ : PrimeData A.layered) σ) e = A := by
  obtain ⟨e, he⟩ := coreFamilyOf_reindex_data A.family (vinesV0 γ A.skeleton σ)
    (vinesV0_subset A.skeleton σ) hF.1 hF.2
  refine ⟨e, ?_⟩
  apply familyReconstruction_ext
  · rfl
  · apply heq_of_eq
    apply CoreFamily.ext_data
    · exact funext fun i => (he i).1
    · exact funext fun i => (he i).2.1
    · exact funext fun i => (he i).2.2.1
    · exact funext fun i => (he i).2.2.2
  · rfl
  · rfl


end WaveTurbulence.GammaLow.Fama.VineA
