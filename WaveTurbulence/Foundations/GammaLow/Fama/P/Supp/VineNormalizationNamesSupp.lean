/-! Fixed address words in the sigma-independent all-SG normalization. -/
@[expose] public section
set_option autoImplicit false
set_option linter.unusedSectionVars false
namespace WaveTurbulence.GammaLow.Fama.VineA
open WaveTurbulence.VineA WaveTurbulence.GammaLow.FinalCount
open WaveTurbulence.RedSplice WaveTurbulence.Mole WaveTurbulence.Stage1 WaveTurbulence.GammaLow.FinalCount
variable {w : ℕ} {G : Garden w} {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]











/-- The branch-word diagram for the all-SG normalization. -/
theorem coarseAtomWord_twist (Z : TwistGroupSite γ G)
    (hsel : ∃ c ∈ vinesV0 γ G (fun _ => .SG), c.atoms = Z.S0) (v : GBranch G.tree) :
    coarseAtomWord γ Z.target (Z.iso.e v) = coarseAtomWord γ G v := by
  apply congrArg addressWord
  exact (congrArg Subtype.val (unitSplice_pi Z (fun _ => .SG) hsel v)).trans
    (unitSpliceMolIso_address Z (fun _ => .SG) hsel _)

/-- The actual LF map on the all-SG surviving-dart domain. -/
noncomputable def coarseDartTwist (γ : ℝ) [Fact (γ ≤ 1 / 2)] (Z : TwistGroupSite γ G)
    (hsel : ∃ c ∈ vinesV0 γ G (fun _ => .SG), c.atoms = Z.S0) (x : CoarseDart γ G) : CoarseDart γ Z.target :=
  unitSpliceRetainedDart γ Z (fun _ => .SG) hsel x

/-- The dart-word diagram for the all-SG normalization. -/
theorem coarseDartWord_twist (Z : TwistGroupSite γ G)
    (hsel : ∃ c ∈ vinesV0 γ G (fun _ => .SG), c.atoms = Z.S0) (x : CoarseDart γ G) :
    coarseDartWord γ Z.target (coarseDartTwist γ Z hsel x) = coarseDartWord γ G x := by
  apply congrArg dartAddressWord
  exact (congrArg (dartAddress (coarseSplice γ Z.target).G)
    (unitSplice_dartQuotient Z (fun _ => .SG) hsel x)).trans
      (unitSpliceMolIso_dartAddress Z (fun _ => .SG) hsel _)

end WaveTurbulence.GammaLow.Fama.VineA
