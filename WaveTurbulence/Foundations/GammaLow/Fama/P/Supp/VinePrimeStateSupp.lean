variable {w : ℕ} {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]







/-- The coarse congruence state, using every core member of V. -/
noncomputable def PrimeData.coarseState (γ : ℝ) [Fact (γ ≤ 1 / 2)] {LG : LayeredGarden w} (A : PrimeData LG) :
    FamilyReconstruction w (CoreIndex γ (vinesVG γ A.skeleton)) := PrimeData.state γ A (vinesVG γ A.skeleton) (fun _ h => h)









/-- B1a bridge: the coarse′ outputs at `Mk = ∅` are main's coarse outputs. -/
theorem coarseStateMk_empty_outputs {LG : LayeredGarden w} (A : PrimeData LG) {p : ℕ} {kind : Bool} :
    (coarseStateMk γ A ∅).allCoreOutputs (p := p) (kind := kind) =
      (PrimeData.coarseState γ A).allCoreOutputs (p := p) (kind := kind) :=
  PrimeData.state_allCoreOutputs_congr A (by ext c; simp) _ _



end WaveTurbulence.GammaLow.Fama.VineA
