/-!
# S2 REPRESENTS, UnitGap (7), R83 successor

`hZ_stStN`, `unitGap_stStN`, `mem_outSet_of_gsbN`: `hZ_stSt`, `unitGap_stSt`, `mem_outSet_of_gsb` against the successor
`VineA.NormalizedSplice.gapSpecification` / `selOf` (the G2 glue; `exists_ext_of_shape` of `RepUG7` is designation-free and reused).
-/

@[expose] public section
set_option autoImplicit false
open WaveTurbulence.Induct WaveTurbulence.GammaLow.FinalCount
open WaveTurbulence.VineParamContract WaveTurbulence.GammaLow.FinalCount
set_option linter.unusedSectionVars false
namespace WaveTurbulence.GammaLow.Fama.Represents
open WaveTurbulence.Represents WaveTurbulence.GammaLow.FinalCount
open Finset TTree WaveTurbulence WaveTurbulence.Mole WaveTurbulence.RegRed WaveTurbulence.RedSplice WaveTurbulence.VineB WaveTurbulence.GammaLow.FinalCount
  WaveTurbulence.LGSpine WaveTurbulence.VineEstS3 WaveTurbulence.VineEstS2 WaveTurbulence.RepAnalytic WaveTurbulence.VineEstS3.Eng

variable {w d : ℕ} {S : Garden w} {J : Type} [Fintype J] [DecidableEq J] {blk : J → CLBlock S} {Gsb : Garden w} {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]

open scoped Classical in
/-- **hZ.**  The literal spliced gap indicator at the restriction of a skeleton decoration is `[selOf γ σ]`. -/
theorem hZ_stStN (hM : S.molecule.IsMolecule) (hS : S.IsPlain) (σ : Prescription S) {L : ℝ} (hL : L ≠ 0) (γ' η : ℝ)
    (base : Mom d) (roots : Fin w → (Fin d → ℤ)) (κ : GenDecoration S d roots 0)
    (D : SplicedKernelData (stSt γ S σ).G d) (hD : D.gapSpecification = VineA.NormalizedSplice.gapSpecification γ S σ) :
    splicedGapIndicator (stSt γ S σ).G D L γ' η base
        ((stShape γ hM σ).resDec hS (unitBlk_disj hM σ) κ).1 =
      if VineA.NormalizedSplice.selOf γ (VineA.NormalizedSplice.GroupPrescription.ofPrescription γ σ) L γ' η base κ.1 then 1 else 0 :=
  VineA.NormalizedSplice.splicedGapIndicator_eq_selOf_gen hM hS σ hL γ' η base roots κ _
    (fun y => bondIndex_stSt_od hM σ κ.1 y) D hD

open scoped Classical in
/-- **G2, SG clause, for every decoration of `G_sb`.** -/
theorem unitGap_stStN (hM : S.molecule.IsMolecule) (hS : S.IsPlain) (σ : Prescription S) {L : ℝ} (hL : L ≠ 0) (γ' η : ℝ)
    (base : Mom d) (roots : Fin w → (Fin d → ℤ)) (z : GenDecoration (stSt γ S σ).G d roots 0)
    (D : SplicedKernelData (stSt γ S σ).G d) (hD : D.gapSpecification = VineA.NormalizedSplice.gapSpecification γ S σ)
    (hz : splicedGapIndicator (stSt γ S σ).G D L γ' η base z.1 ≠ 0) (j : Fin (unitBlocks γ S σ).length) :
    VineB.UnitGap L γ' η (fun i => base + latticePoint L (z.1 ((stShape γ hM σ).hmom (unitBlk_disj hM σ) j i))) := by
  classical
  obtain ⟨κ, hκ⟩ := exists_ext_of_shape (stShape γ hM σ) hS (unitBlk_disj hM σ) hL base roots z
  subst hκ
  have h1 := hZ_stStN hM hS σ hL γ' η base roots κ D hD
  have hsel : VineA.NormalizedSplice.selOf γ (VineA.NormalizedSplice.GroupPrescription.ofPrescription γ σ) L γ' η base κ.1 := by
    by_contra hn
    rw [if_neg hn] at h1
    exact hz h1
  have hu : unitBlk γ hM σ j ∈ unitBlocks γ S σ := List.get_mem _ _
  have hg := unitGap_of_selOfN hM hS σ hL γ' η base roots κ hsel hu
  have heq : ∀ i, ((stShape γ hM σ).resDec hS (unitBlk_disj hM σ) κ).1
      ((stShape γ hM σ).hmom (unitBlk_disj hM σ) j i) = κ.1 (bnodes (unitBlk γ hM σ j) i) := by
    intro i
    rw [SpliceShape.resDec_val]
    exact congrArg κ.1 ((stShape γ hM σ).node_hmom (unitBlk_disj hM σ) j i)
  simp only [heq]
  exact hg

open scoped Classical in
/-- **G2 (`outSet` membership) for every decoration of `G_sb` with non-vanishing literal gap indicator.** -/
theorem mem_outSet_of_gsbN (hM : S.molecule.IsMolecule) (hS : S.IsPlain) (σ : Prescription S) {L : ℝ} (hL : L ≠ 0)
    (γ' η : ℝ) (base : Mom d) (roots : Fin w → (Fin d → ℤ)) (z : GenDecoration (stSt γ S σ).G d roots 0)
    (D : SplicedKernelData (stSt γ S σ).G d) (hD : D.gapSpecification = VineA.NormalizedSplice.gapSpecification γ S σ)
    (hz : splicedGapIndicator (stSt γ S σ).G D L γ' η base z.1 ≠ 0) (j : Fin (unitBlocks γ S σ).length)
    (c : Fin 4 → Fin d → ℤ)
    (hball : ∀ i, ‖(base + latticePoint L (z.1 ((stShape γ hM σ).hmom (unitBlk_disj hM σ) j i))) - latPt d (c i)‖ ≤ 1)
    (DS : SumintDatum d) (hw : DS.wBar = base)
    (hct : DS.centre = sumintBoundary (S.sign (unitBlk γ hM σ j).upper.toNode) (fun i => latPt d (c i))) :
    sumintBoundary (S.sign (unitBlk γ hM σ j).upper.toNode)
        (fun i => base + latticePoint L (z.1 ((stShape γ hM σ).hmom (unitBlk_disj hM σ) j i))) ∈ outSet DS L γ' η := by
  have hcore := (stShape γ hM σ).hmom_outSet_core (unitBlk_disj hM σ) j L base z.1 z.2.1
  have hg := (sumintBoundary_gap_iff (S.sign (unitBlk γ hM σ j).upper.toNode) L γ' η
    (fun i => base + latticePoint L (z.1 ((stShape γ hM σ).hmom (unitBlk_disj hM σ) j i)))).mpr
    (unitGap_stStN hM hS σ hL γ' η base roots z D hD hz j)
  refine ⟨fun c' => ⟨?_, ?_⟩, hcore.2, hg.1, hg.2⟩
  · rw [hw]; exact hcore.1 c'
  · rw [hct]
    exact sumintBoundary_close _ _ _ hball c'

