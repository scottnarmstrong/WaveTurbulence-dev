/-!
# S2 REPRESENTS, session 10: the producer's `Stage1Data` and `Stage1Counts`

`prodData`: pieces `PcA P.γ R p kind A`, the piece of `π` is the successor producer's `normalizedPiece` of its
representative prescribed point, with an arbitrary value assignment `val` (a `Stage1DataG P R`).  (L5a: main's
`prod_stage1Counts`, which needs the class count — L5c's item I — is moved to the assembly, item J.)
-/

@[expose] public section
set_option autoImplicit false
set_option linter.unusedSectionVars false
open WaveTurbulence.Induct WaveTurbulence.GammaLow.FinalCount
open WaveTurbulence.VineParamContract WaveTurbulence.GammaLow.FinalCount
namespace WaveTurbulence.GammaLow.Fama.Represents
open WaveTurbulence.Represents WaveTurbulence.GammaLow.FinalCount
open scoped Classical WaveTurbulence.GammaLow.FinalCount
open Finset WaveTurbulence WaveTurbulence.VineA WaveTurbulence.LGSpine WaveTurbulence.Reg.Skeleton WaveTurbulence.RegRed WaveTurbulence.GammaLow.FinalCount
  WaveTurbulence.VineA.PrescribedPrimeGarden WaveTurbulence.ClassCount

variable {R : ℕ} {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]

/-- The producer's `Stage1Data` over the finite set `A` (values supplied). -/
noncomputable def prodData (P : WTParams) [Fact (P.γ ≤ 1 / 2)] (p : ℕ) (kind : Bool)
    (A : Finset (LayeredGarden (2 * R))) {mk : Stage1Mk.MarkFn P.γ (2 * R)} (val : PcA P.γ R p kind A mk → ℂ) :
    Stage1DataG P R where
  Pc := PcA P.γ R p kind A mk
  fin := inferInstance
  piece := fun π => (repPt P.γ π).normalizedPiece P.d (mk (repPt P.γ π).prime)
  val := val

/-- B1b (Mk-general form of `prod_piece_gsb_order`, with the truncation-free carrier `Stage1CarriesW`, R156). -/
theorem prod_piece_gsb_orderMk (P : WTParams) (p N : ℕ) (kind : Bool) (A : Finset (LayeredGarden (2 * R)))
    (hA : ∀ LG ∈ A, Stage1Mk.Stage1CarriesW P p N LG) {mk : Stage1Mk.MarkFn γ _} (π : PcA γ (mk := mk) R p kind A) :
    (repPt γ π).prime.skeleton.order ≤ N := by
  have hc := hA _ (repPt_layered_memMk (mk := mk) π)
  have hsz := (repPt γ π).prime.data.decoded_order (repPt γ π).prime.prime.1 (repPt γ π).prime.decodes
  have hord : (repPt γ π).layered.garden.order = N := hc.2.1
  omega

theorem prod_piece_gsb_order (P : WTParams) (p N : ℕ) (kind : Bool) (A : Finset (LayeredGarden (2 * R)))
    (hA : ∀ LG ∈ A, Stage1Carries P p N LG) (π : PcA γ R p kind A) :
    (repPt γ π).prime.skeleton.order ≤ N :=
  prod_piece_gsb_orderMk (mk := fun _ => ∅) P p N kind A
    (fun LG h => Stage1Mk.stage1CarriesW_of_stage1Carries (hA LG h)) π



end WaveTurbulence.GammaLow.Fama.Represents
