/-!
# S2 REPRESENTS, VINE-E (2): VINEEST's premise `RowCoherent` holds for canonical gardens

V5's `rowCoherent_iff` reduces `RowCoherent` (for the Step 3 data `step3W … (qOutOf …)`) to the chart-free `RowsCoh`: every
regional couple and every interior tree of incoherency count `0` is coherent at the parent-core layers.  For a canonical
garden this is S2's `couple_coherent_at` / `tree_coherent_at` (RepBr6/RepBr8), with V5's bridges
`incoherency_native_couple` / `incoherency_native_tree` (count = native incoherency) and the identification of the slot clock
layers with the parent-core layers at non-root nodes (`clkLayer_nonroot`); regional leaves and interior branches are
non-root (`cl_realization_parent`).
-/

@[expose] public section
set_option autoImplicit false
set_option linter.unusedSectionVars false
open WaveTurbulence.VineParamContract WaveTurbulence.GammaLow.FinalCount
namespace WaveTurbulence.GammaLow.Fama.Represents
open WaveTurbulence.Represents WaveTurbulence.GammaLow.FinalCount
open WaveTurbulence WaveTurbulence.VineEstS2 WaveTurbulence.VineEstS3 WaveTurbulence.VineEstS4 WaveTurbulence.GammaLow.FinalCount
  WaveTurbulence.LFTwist WaveTurbulence.RegRed WaveTurbulence.Reg.Skeleton WaveTurbulence.Reg TTree
  VineParamContract

variable {w : ℕ} {S : Garden w} {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]




/-- **VINEEST's `Famb.VineEstS3.RowCoherentΓ` premise for a unit of a canonical garden.** -/
theorem rowCoherent_of_canonical (hM9 : Famb.NormalChartSupply γ) {U : Finset (GBranch S.tree)} {a b : GBranch S.tree}
    {R : CLRegionData S U a b} {n : ℕ} (B : Famb.VineEstS2.CLChainAssemblyΓ γ S R n) (D : ReconstructionData S) (hS : S.IsPlain)
    (layer : GNode (D.forest hS) → ℕ) (hLayer : IsLayering (D.garden hS) layer) (p : ℕ)
    (hcan : IsCanonGC (p + 1) (layeredReconstruction D hS layer hLayer))
    {d : ℕ} (centre : Fin 4 → Mom d) (wBar : Mom d) (L γ δ : ℝ) (F : ℕ → Mom d → ℝ) :
    Famb.VineEstS3.RowCoherentΓ hM9 B D hS layer hLayer
      (Famb.VineEstS3.step3WΓ hM9 B D hS layer hLayer (Famb.VineEstS3.canonBadKindΓ hM9 B D hS layer) (qOutOf D hS layer a b R) centre wBar)
      L γ δ F p := by
  rw [Famb.VineEstS4.rowCoherent_iffΓ hM9 B D hS layer hLayer _ rfl rfl]
  exact rowsCoh_of_canonical D hS layer hLayer p hcan B.isBlock R

end WaveTurbulence.GammaLow.Fama.Represents
