/-!
# S2 REPRESENTS, VINE-E: the exponent facts `hg`, `hb` of `representsIntA_of_vineModes`

`gsk_bound`: `g_sk = g_reg + Σ_T vineIncoh(T) ≤ Σ_{outer slots} slotIncoh + Σ_j (cohmolIndex B_j + M₁_j)`, with
`M₁_j = Σ_{regional pairs} coupleCnt + Σ_{interior branches} treeCnt` (V5's chart-free `step3D_M1`), from
`gregOf = Σ_s slotIncoh` (`gregOf_eq_sum_slotIncoh`), the splitting of the slots into outer and regional ones, and
`sum_vineIncoh_le_cohmol`.  `bsk_bound`: `b_sk ≤ Σ_j #{i | nor_i = false}`.
-/

@[expose] public section
set_option autoImplicit false
set_option linter.unusedSectionVars false
open WaveTurbulence.Induct WaveTurbulence.GammaLow.FinalCount
open WaveTurbulence.VineParamContract WaveTurbulence.GammaLow.FinalCount
namespace WaveTurbulence.GammaLow.Fama.Represents
open WaveTurbulence.Represents WaveTurbulence.GammaLow.FinalCount
open Finset TTree Reg Reg.Skeleton WaveTurbulence WaveTurbulence.RedSplice WaveTurbulence.VineEstS2 WaveTurbulence.Vine WaveTurbulence.GammaLow.FinalCount
  WaveTurbulence.RegRed WaveTurbulence.VineEstS3 WaveTurbulence.Stage1 WaveTurbulence.VineB WaveTurbulence.VineEstS4
  WaveTurbulence.LGSpine

variable {R : ℕ} {S : Garden (2 * R)} {J : Type} [Fintype J] [DecidableEq J] {blk : J → CLBlock S} {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]
  {Gsb : Garden (2 * R)}





/-- B1b (Mk-general form of `gsk_bound`). -/
theorem gsk_boundMk (Φ : SpliceShape blk Gsb) (hd : Disj blk) (D : ReconstructionData S) (hS : S.IsPlain)
    (hSb : Gsb.IsPlain) (layer : GNode (D.forest hS) → ℕ) (hLayer : IsLayering (D.garden hS) layer)
    (σ : Prescription S) {n₀ : J → ℕ} (B₀ : ∀ j, Famb.VineEstS2.CLChainAssemblyΓ γ S (regionOf (blk j)) (n₀ j))
    {Mk : Set (CLVineG γ _)} (hcov : ∀ T ∈ unitIngredients γ (Mk := Mk) S σ, ∃ j, IsIngredientG γ S.molecule (blk j).atoms T)
    (layer0 : GBranch S.tree → ℕ) (hl : ∀ v, layer0 v = atomLayer D hS layer v) :
    gskOf γ (Mk := Mk) (gregOf D hS (layeredReconstruction D hS layer hLayer)) S σ layer0 ≤
      (∑ s', slotIncoh D hS layer hLayer (Φ.iota hS hSb s')) +
        ∑ j, (Famb.VineEstS3.cohmolIndexΓ (B₀ j) D hS layer + unitM1 blk D hS layer hLayer j) := by
  have hl' : layer0 = atomLayer D hS layer := funext hl
  have h1 := sum_vineIncoh_le_cohmolMk (Mk := Mk) σ B₀ hcov layer0
  have h2 : ∑ j, Famb.VineEstS3.cohmolIndexΓ (B₀ j) D hS layer =
      ∑ j, ∑ i : Fin (n₀ j), Famb.groupIncoherency (Famb.famGroups γ S.molecule
        (Famb.VineEstS2.assemblyPieceAtΓ (B₀ j) i).atoms (Famb.VineEstS2.assemblyPieceAtΓ (B₀ j) i).upper
        (Famb.VineEstS2.assemblyPieceAtΓ (B₀ j) i).lower) layer0 := by
    refine Finset.sum_congr rfl fun j _ => ?_
    unfold Famb.VineEstS3.cohmolIndexΓ
    rw [hl']
  unfold gskOf
  have hg : gregOf D hS (layeredReconstruction D hS layer hLayer) = ∑ s, slotIncoh D hS layer hLayer s :=
    Represents.gregOf_eq_sum_slotIncoh D hS layer hLayer
  rw [hg, sum_slotIncoh_split Φ hd D hS hSb layer hLayer, Finset.sum_add_distrib]
  omega

theorem gsk_bound (Φ : SpliceShape blk Gsb) (hd : Disj blk) (D : ReconstructionData S) (hS : S.IsPlain)
    (hSb : Gsb.IsPlain) (layer : GNode (D.forest hS) → ℕ) (hLayer : IsLayering (D.garden hS) layer)
    (σ : Prescription S) {n₀ : J → ℕ} (B₀ : ∀ j, Famb.VineEstS2.CLChainAssemblyΓ γ S (regionOf (blk j)) (n₀ j))
    (hcov : ∀ T ∈ unitIngredients γ S σ, ∃ j, IsIngredientG γ S.molecule (blk j).atoms T)
    (layer0 : GBranch S.tree → ℕ) (hl : ∀ v, layer0 v = atomLayer D hS layer v) :
    gskOf γ (gregOf D hS (layeredReconstruction D hS layer hLayer)) S σ layer0 ≤
      (∑ s', slotIncoh D hS layer hLayer (Φ.iota hS hSb s')) +
        ∑ j, (Famb.VineEstS3.cohmolIndexΓ (B₀ j) D hS layer + unitM1 blk D hS layer hLayer j) := by apply gsk_boundMk (Mk := ∅) <;> assumption

open scoped Classical in
/-- B1b (Mk-general form of `bsk_bound`). -/
theorem bsk_boundMk {n₀ : J → ℕ} (hM9 : Famb.NormalChartSupply γ) (σ : Prescription S)
    (B₀ : ∀ j, Famb.VineEstS2.CLChainAssemblyΓ γ S (regionOf (blk j)) (n₀ j))
    {Mk : Set (CLVineG γ _)} (hcov : ∀ T ∈ unitIngredients γ (Mk := Mk) S σ, ∃ j, IsIngredientG γ S.molecule (blk j).atoms T) :
    bskOf γ (Mk := Mk) S σ ≤ ∑ j, (Finset.univ.filter fun i : Fin (n₀ j) => (Famb.VineEstS2.assemblyShapeΓ hM9 (B₀ j)).nor i = false).card := by
  refine (card_bad_leMk (Mk := Mk) σ B₀ hcov hM9).trans (le_of_eq ?_)
  refine Finset.sum_congr rfl fun j _ => ?_
  refine congrArg Finset.card (Finset.filter_congr fun i _ => ?_)
  simp [Famb.VineEstS2.assemblyShapeΓ, shapeFamily]

open scoped Classical in
theorem bsk_bound {n₀ : J → ℕ} (hM9 : Famb.NormalChartSupply γ) (σ : Prescription S)
    (B₀ : ∀ j, Famb.VineEstS2.CLChainAssemblyΓ γ S (regionOf (blk j)) (n₀ j))
    (hcov : ∀ T ∈ unitIngredients γ S σ, ∃ j, IsIngredientG γ S.molecule (blk j).atoms T) :
    bskOf γ S σ ≤ ∑ j, (Finset.univ.filter fun i : Fin (n₀ j) => (Famb.VineEstS2.assemblyShapeΓ hM9 (B₀ j)).nor i = false).card := by apply bsk_boundMk (Mk := ∅) <;> assumption

end WaveTurbulence.GammaLow.Fama.Represents
