variable {w : ℕ} {S : Garden w} {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]




/-- B1b (Mk-general form of `heq_layer`). -/
theorem heq_layerMk (σ : Prescription S) {Mk : Set (CLVineG γ _)} (h : unitBlocks γ (Mk := Mk) S σ = []) (f : GBranch S.tree → ℕ) :
    HEq ((stSt γ (Mk := Mk) S σ).layer f) f := by
  have key : ∀ st : SpState S, st = SpState.init S → HEq (st.layer f) f := by
    rintro st rfl
    exact HEq.rfl
  exact key _ (stSt_eq_init_of_unitBlocks_emptyMk (Mk := Mk) σ h)

theorem heq_layer (σ : Prescription S) (h : unitBlocks γ S σ = []) (f : GBranch S.tree → ℕ) :
    HEq ((stSt γ S σ).layer f) f := heq_layerMk (Mk := ∅) σ h f





end WaveTurbulence.GammaLow.Fama.Represents
