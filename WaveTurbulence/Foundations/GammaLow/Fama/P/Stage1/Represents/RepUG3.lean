/-!
# S2 REPRESENTS, UnitGap (3): the SG gap clause of `outSet` for every unit

`unitGap_of_selOf`: for a decoration `z` of a plain molecule garden `G` satisfying the prescription restriction `selOf γ σ`
(TARGET L1950) and every unit `u ∈ unitBlocks γ G σ`, the unit's boundary momenta `β i = base + latticePoint L (z (bnodes u i))`
satisfy `UnitGap L γ' η β` (`β 0 ≠ β 1`, `‖β 0 - β 1‖ ≤ L^(-γ+η)`), the SG clause of `outSet`.
Route: `exists_unitSpec` (an external pair at a joint of `u`), `unitSpec_gapKind` (its gap has the kind of the designated
object, SG since `σ S = SG` and `selOf`), `extPair_nodes` (the pair sits on the boundary nodes of that joint) and the signed
block conservation to pass between the joints.
-/

@[expose] public section
set_option autoImplicit false
open WaveTurbulence.Induct WaveTurbulence.GammaLow.FinalCount
open WaveTurbulence.VineParamContract WaveTurbulence.GammaLow.FinalCount
set_option linter.unusedSectionVars false
namespace WaveTurbulence.GammaLow.Fama.Represents
open WaveTurbulence.Represents WaveTurbulence.GammaLow.FinalCount
open Finset TTree WaveTurbulence WaveTurbulence.Mole WaveTurbulence.RegRed WaveTurbulence.RedSplice WaveTurbulence.VineB WaveTurbulence.GammaLow.FinalCount
  WaveTurbulence.LGSpine WaveTurbulence.LGSpine.SourceVine

variable {w : ℕ} {G : Garden w} {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]

/-- The joint of the external pair of a unit is one of its joints. -/
theorem unitSpec_joint {Sg : Finset (GBranch G.tree)} {u : CLBlock G} (hu : u ∈ (groupUnitsOf γ G Sg).units)
    {p : GardenDart G × GardenDart G} (hsp : UnitSpec γ G Sg u p) :
    ∃ j, (j = u.upper ∨ j = u.lower) ∧ G.molecule.atom p.1 = j ∧ G.molecule.atom p.2 = j := by
  obtain ⟨j, hj, hT, hn1, hn2, hrel⟩ := hsp
  refine ⟨j, ?_, hT.1, hT.2.1⟩
  rcases hsk : (groupUnitsOf γ G Sg).skip with _ | sk
  · exact (hrel.2 hsk).2
  · obtain ⟨hjxy, -⟩ := hrel.1 sk hsk
    obtain ⟨hu', hL, hR⟩ := (groupUnitsOf γ G Sg).skip_units sk hsk
    have hX := sk.vine
    have hxy : sk.x ≠ sk.y := (Src.isBlock_of_isSomeVine hX).2.2.2.1
    rcases hu' u hu with ⟨hat, hjn⟩ | ⟨hat, hjn⟩
    · rw [hat] at hj
      rcases hjxy with rfl | rfl
      · rcases hjn with ⟨-, h⟩ | ⟨h, -⟩
        · exact Or.inr h.symm
        · exact Or.inl h.symm
      · exfalso
        rcases sk.left with ⟨h0, -⟩ | ⟨-, -, -, hLA⟩
        · rw [h0] at hj; exact absurd hj (by simp)
        · have : sk.y ∈ sk.L0 ∩ sk.A := Finset.mem_inter.mpr ⟨hj, (Src.isBlock_of_isSomeVine hX).2.2.1⟩
          rw [hLA, Finset.mem_singleton] at this
          exact hxy this.symm
    · rw [hat] at hj
      rcases hjxy with rfl | rfl
      · exfalso
        rcases sk.right with ⟨h0, -⟩ | ⟨-, -, -, hRA⟩
        · rw [h0] at hj; exact absurd hj (by simp)
        · have : sk.x ∈ sk.R0 ∩ sk.A := Finset.mem_inter.mpr ⟨hj, (Src.isBlock_of_isSomeVine hX).2.1⟩
          rw [hRA, Finset.mem_singleton] at this
          exact hxy this
      · rcases hjn with ⟨h, -⟩ | ⟨-, h⟩
        · exact Or.inl h.symm
        · exact Or.inr h.symm



end WaveTurbulence.GammaLow.Fama.Represents
