/-!
# S2 REPRESENTS, G1 (4): layer indices of the clocks of a unit on `G_sb`

For the layer `lay = (stSt γ S σ).layer (coreLayer …)` of `G_sb` (`lay c = layer (core (ob c))`):
* `lay_hinge`: the layer of the hinge of unit `j` is `layer (core (blk j).upper)` (= `qOut 0`);
* `lay_branch_child`: for a branch lower child `c` of the hinge (`nodeClk (hmom j k) = inr c`, `k ∈ {2, 3}`) the layer
  `lay c` is `layer (core ⟨(bnodes (blk j) k).1, _⟩)`, the layer of the core of the skeleton branch carrying that node.
  This is the exact value of `qOut` (for a branch child) in the R74 box (`outNode` = the core).
-/

@[expose] public section
set_option autoImplicit false
open WaveTurbulence.Induct WaveTurbulence.GammaLow.FinalCount
open WaveTurbulence.VineParamContract WaveTurbulence.GammaLow.FinalCount
set_option linter.unusedSectionVars false
namespace WaveTurbulence.GammaLow.Fama.Represents
open WaveTurbulence.Represents WaveTurbulence.GammaLow.FinalCount
open Finset TTree Reg Reg.Skeleton WaveTurbulence WaveTurbulence.RegRed WaveTurbulence.RedSplice WaveTurbulence.VineB WaveTurbulence.GammaLow.FinalCount
  WaveTurbulence.LGSpine WaveTurbulence.RegRedLeaf

variable {w : ℕ} {S : Garden w} {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]

/-- B1b (Mk-general form of `lay_hinge`). -/
theorem lay_hingeMk (hM : S.molecule.IsMolecule) (σ : Prescription S) {Mk : Set (CLVineG γ _)} (j : Fin (unitBlocks γ (Mk := Mk) S σ).length)
    (D : ReconstructionData S) (hS : S.IsPlain) (layer : GNode (D.forest hS) → ℕ)
    (hLayer : IsLayering (D.garden hS) layer) :
    (stSt γ (Mk := Mk) S σ).layer (RegRed.coreLayer (layeredReconstruction D hS layer hLayer) D hS (D.garden_decodes hS))
        ((stShape γ (Mk := Mk) hM σ).hinge (unitBlkMk_disj (Mk := Mk) hM σ) j) =
      layer (D.coreBranch hS (unitBlkMk γ (Mk := Mk) hM σ j).upper).toNode := by
  have h := (stShape γ (Mk := Mk) hM σ).br_hinge (unitBlkMk_disj (Mk := Mk) hM σ) j
  have h' : (stSt γ (Mk := Mk) S σ).M.ob ((stShape γ (Mk := Mk) hM σ).hinge (unitBlkMk_disj (Mk := Mk) hM σ) j) = (unitBlkMk γ (Mk := Mk) hM σ j).upper := h
  show layer (D.coreBranch hS ((stSt γ (Mk := Mk) S σ).M.ob ((stShape γ (Mk := Mk) hM σ).hinge (unitBlkMk_disj (Mk := Mk) hM σ) j))).toNode = _
  rw [h']


/-- B1b (Mk-general form of `lay_branch_child`). -/
theorem lay_branch_childMk (hM : S.molecule.IsMolecule) (σ : Prescription S) {Mk : Set (CLVineG γ _)} (j : Fin (unitBlocks γ (Mk := Mk) S σ).length)
    (D : ReconstructionData S) (hS : S.IsPlain) (layer : GNode (D.forest hS) → ℕ)
    (hLayer : IsLayering (D.garden hS) layer) (k : Fin 4) (c : GBranch (stSt γ (Mk := Mk) S σ).G.tree)
    (hc : nodeClk (stSt γ (Mk := Mk) S σ).G ((stShape γ (Mk := Mk) hM σ).hmom (unitBlkMk_disj (Mk := Mk) hM σ) j k) = Sum.inr c) :
    ∃ hb : (bnodes (unitBlkMk γ (Mk := Mk) hM σ j) k).1.2 ∈ (S.tree (bnodes (unitBlkMk γ (Mk := Mk) hM σ j) k).1.1).branching,
      (stSt γ (Mk := Mk) S σ).layer (RegRed.coreLayer (layeredReconstruction D hS layer hLayer) D hS (D.garden_decodes hS)) c =
        layer (D.coreBranch hS ⟨(bnodes (unitBlkMk γ (Mk := Mk) hM σ j) k).1, hb⟩).toNode := by
  have hcn : c.toNode = (stShape γ (Mk := Mk) hM σ).hmom (unitBlkMk_disj (Mk := Mk) hM σ) j k := by
    unfold nodeClk at hc
    by_cases h : ((stShape γ (Mk := Mk) hM σ).hmom (unitBlkMk_disj (Mk := Mk) hM σ) j k).1.2 ∈
        ((stSt γ (Mk := Mk) S σ).G.tree ((stShape γ (Mk := Mk) hM σ).hmom (unitBlkMk_disj (Mk := Mk) hM σ) j k).1.1).branching
    · rw [dif_pos h] at hc
      have := Sum.inr.inj hc
      subst this
      rfl
    · rw [dif_neg h] at hc
      exact absurd hc (by simp)
  have hnode : ((stShape γ (Mk := Mk) hM σ).br c).toNode = bnodes (unitBlkMk γ (Mk := Mk) hM σ j) k := by
    rw [(stShape γ (Mk := Mk) hM σ).br_node, hcn]
    exact (stShape γ (Mk := Mk) hM σ).node_hmom (unitBlkMk_disj (Mk := Mk) hM σ) j k
  have hb : (bnodes (unitBlkMk γ (Mk := Mk) hM σ j) k).1.2 ∈ (S.tree (bnodes (unitBlkMk γ (Mk := Mk) hM σ j) k).1.1).branching := by
    rw [← hnode]; exact ((stShape γ (Mk := Mk) hM σ).br c).2
  refine ⟨hb, ?_⟩
  have hbr : (stShape γ (Mk := Mk) hM σ).br c = ⟨(bnodes (unitBlkMk γ (Mk := Mk) hM σ j) k).1, hb⟩ := by
    apply WaveTurbulence.Mole.branch_toNode_injective
    rw [hnode]
    rfl
  have hob : (stSt γ (Mk := Mk) S σ).M.ob c = ⟨(bnodes (unitBlkMk γ (Mk := Mk) hM σ j) k).1, hb⟩ := hbr
  show layer (D.coreBranch hS ((stSt γ (Mk := Mk) S σ).M.ob c)).toNode = _
  rw [hob]




end WaveTurbulence.GammaLow.Fama.Represents
