/-!
# S2 REPRESENTS, UnitGap (6): the dart labels of `G_sb` are the labels of the original darts (`hlab`)

VINE-B♯'s fold invariant `spliceFoldInv` and VINE-A's `spliceFoldLeafTrace` are built by the same recipe; their leaf maps agree
(`fold_leaf_eq`).  With VINE-A's `spliceFoldDartTrace` (the dart map `od` on PC and LP darts), the node carrying the bond of the
original dart `od y` is the image under `stShape` of the node carrying the bond of `y` (`stSt_od_node`), whence
`bondIndex_stSt_od`: `bondIndex G_sb (fun y => κ (node y)) y = bondIndex S κ (od y)`.
-/

@[expose] public section
set_option autoImplicit false
open WaveTurbulence.Induct WaveTurbulence.GammaLow.FinalCount
open WaveTurbulence.VineParamContract WaveTurbulence.GammaLow.FinalCount
set_option linter.unusedSectionVars false
namespace WaveTurbulence.GammaLow.Fama.Represents
open WaveTurbulence.Represents WaveTurbulence.GammaLow.FinalCount
open Finset TTree WaveTurbulence WaveTurbulence.Mole WaveTurbulence.RegRed WaveTurbulence.RedSplice WaveTurbulence.VineB WaveTurbulence.GammaLow.FinalCount
  WaveTurbulence.LGSpine WaveTurbulence.VineA

variable {w : ℕ} {G0 : Garden w} {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]








variable {S : Garden w}

/-- B1b (Mk-general form of `stSt_od_node`). -/
theorem stSt_od_nodeMk (hM : S.molecule.IsMolecule) (σ : Prescription S) {Mk : Set (CLVineG γ _)} (y : GardenDart (stSt γ (Mk := Mk) S σ).G) :
    Represents.dartNode S ((stSt γ (Mk := Mk) S σ).M.od y) = (stShape γ (Mk := Mk) hM σ).node (Represents.dartNode (stSt γ (Mk := Mk) S σ).G y) := by
  rcases y with ⟨c, side⟩ | l
  · have h := (spliceFoldDartTrace (unitBlocks γ (Mk := Mk) S σ)).pc c side
    change Represents.dartNode S ((spliceFold S (unitBlocks γ (Mk := Mk) S σ)).M.od (.inl (c, side))) = _
    rw [h]
    exact (stInv γ (Mk := Mk) hM σ).br_node c.1
  · have h := (spliceFoldDartTrace (unitBlocks γ (Mk := Mk) S σ)).lp l
    change Represents.dartNode S ((spliceFold S (unitBlocks γ (Mk := Mk) S σ)).M.od (.inr l)) = _
    rw [h]
    have hl := spliceFoldInv_leaf (unitBlocks γ (Mk := Mk) S σ) (unitBlocks_pairwiseMk (Mk := Mk) hM σ)
    have h2 := (stInv γ (Mk := Mk) hM σ).leaf_node l.1
    have h3 : (spliceFoldLeafTrace (unitBlocks γ (Mk := Mk) S σ)).leaf l.1 = (stInv γ (Mk := Mk) hM σ).leaf l.1 :=
      (congrFun hl l.1).symm
    show ((spliceFoldLeafTrace (unitBlocks γ (Mk := Mk) S σ)).leaf l.1).toNode = _
    rw [h3]
    exact h2


/-- B1b (Mk-general form of `bondIndex_stSt_od`). -/
theorem bondIndex_stSt_odMk (hM : S.molecule.IsMolecule) (σ : Prescription S) {d : ℕ}
    (κ : GNode S.tree → (Fin d → ℤ)) {Mk : Set (CLVineG γ _)} (y : GardenDart (stSt γ (Mk := Mk) S σ).G) :
    bondIndex (stSt γ (Mk := Mk) S σ).G (fun x => κ ((stShape γ (Mk := Mk) hM σ).node x)) y = bondIndex S κ ((stSt γ (Mk := Mk) S σ).M.od y) := by
  rw [bondIndex_eq_dartNode, bondIndex_eq_dartNode, stSt_od_nodeMk (Mk := Mk) hM σ y]

theorem bondIndex_stSt_od (hM : S.molecule.IsMolecule) (σ : Prescription S) {d : ℕ}
    (κ : GNode S.tree → (Fin d → ℤ)) (y : GardenDart (stSt γ S σ).G) :
    bondIndex (stSt γ S σ).G (fun x => κ ((stShape γ hM σ).node x)) y = bondIndex S κ ((stSt γ S σ).M.od y) := bondIndex_stSt_odMk (Mk := ∅) hM σ κ y

end WaveTurbulence.GammaLow.Fama.Represents
