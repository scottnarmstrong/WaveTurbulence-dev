/-!
# S2 REPRESENTS, session 10: the fibre bound `3^N` of the producer

The pieces `PcA γ R p kind A` of the producer with a given representative layered garden `LG` are injected into the
prescribed points `⟨LG, primeDataOf LG _, σ⟩`, so there are at most `Nat.card (GroupPrescription γ _) ≤ 3^{n_sk} ≤ 3^N`
of them (TARGET L1950: "at most `3^n` terms").
-/

@[expose] public section
set_option autoImplicit false
set_option linter.unusedSectionVars false
open WaveTurbulence.Induct WaveTurbulence.GammaLow.FinalCount
open WaveTurbulence.VineParamContract WaveTurbulence.GammaLow.FinalCount
namespace WaveTurbulence.GammaLow.Fama.Represents
open WaveTurbulence.Represents WaveTurbulence.GammaLow.FinalCount
open scoped Classical WaveTurbulence.GammaLow.FinalCount
open Finset WaveTurbulence WaveTurbulence.VineA WaveTurbulence.LGSpine WaveTurbulence.Reg.Skeleton WaveTurbulence.RegRed WaveTurbulence.GammaLow.FinalCount
  WaveTurbulence.VineA.PrescribedPrimeGarden

variable {R : ℕ} {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]

/-- B1b (Mk-general form of `repPt_injective`). -/
theorem repPt_injectiveMk {p : ℕ} {kind : Bool} {A : Finset (LayeredGarden (2 * R))} {mk : Stage1Mk.MarkFn γ _} :
    Function.Injective (fun π : PcA γ (mk := mk) R p kind A => repPt γ π) := by
  intro π π' h
  have h1 : (Quotient.out π : PtA γ R A) = Quotient.out π' := Subtype.ext h
  rw [← Quotient.out_eq π, ← Quotient.out_eq π', h1]


/-- B1b (Mk-general form of `repPt_mem_range`). -/
theorem repPt_mem_rangeMk {p : ℕ} {kind : Bool} {A : Finset (LayeredGarden (2 * R))} {mk : Stage1Mk.MarkFn γ _} (π : PcA γ (mk := mk) R p kind A)
    (LG : LayeredGarden (2 * R)) (h : (repPt γ π).layered = LG) (hp : LG.garden.IsPlain) :
    repPt γ π ∈ Set.range (fun σ : GroupPrescription γ (primeDataOf LG hp).skeleton =>
      (⟨LG, primeDataOf LG hp, σ⟩ : VineA.PrescribedPrimeGarden γ (2 * R))) := by
  generalize repPt γ π = b at h ⊢
  obtain ⟨LG1, pr, σ⟩ := b
  change LG1 = LG at h
  subst h
  have e : pr = primeDataOf LG1 hp := primeData_unique _ _
  subst e
  exact ⟨σ, rfl⟩


/-- At most `#branches` maximal groups over `𝒱_γ` (main's `ncard_maximalGroups_le`). -/
theorem ncard_maximalGroupsG_le {w : ℕ} (G : Garden w) (hM : G.molecule.IsMolecule) :
    (maximalGroupsG γ G.molecule).ncard ≤ Fintype.card (GBranch G.tree) :=
  ncard_le_of_pairwise_disjoint _ (fun S hS => hS.1.nonempty)
    (fun S hS T hT hne => maximalGroups_disjoint hM hS hT hne)

/-- At most `3^{#branches}` prescriptions on the groups over `𝒱_γ` (main's `natCard_groupPrescription_le`). -/
theorem natCard_groupPrescriptionG_le {w : ℕ} (G : Garden w) (hM : G.molecule.IsMolecule) :
    Nat.card (GroupPrescription γ G) ≤ 3 ^ Fintype.card (GBranch G.tree) := by
  classical
  have hfin : (maximalGroupsG γ G.molecule).Finite := Set.toFinite _
  haveI : Finite (maximalGroupsG γ G.molecule) := hfin
  unfold GroupPrescription
  rw [Nat.card_fun, natCard_gapKind]
  have : Nat.card {S : Finset (GBranch G.tree) // S ∈ maximalGroupsG γ G.molecule} =
      (maximalGroupsG γ G.molecule).ncard := (Nat.card_coe_set_eq _)
  rw [this]
  exact Nat.pow_le_pow_right (by norm_num) (ncard_maximalGroupsG_le G hM)

/-- B1b (Mk-general form of `fibre_card_le`). -/
theorem fibre_card_leMk (p : ℕ) (kind : Bool) (A : Finset (LayeredGarden (2 * R))) (LG : LayeredGarden (2 * R))
    (hp : LG.garden.IsPlain) {N : ℕ} (hN : LG.garden.order = N) {mk : Stage1Mk.MarkFn γ _} :
    ((Finset.univ : Finset (PcA γ (mk := mk) R p kind A)).filter fun π => (repPt γ π).layered = LG).card ≤ 3 ^ N := by
  classical
  set T : Set (VineA.PrescribedPrimeGarden γ (2 * R)) := Set.range (fun σ : GroupPrescription γ (primeDataOf LG hp).skeleton =>
      (⟨LG, primeDataOf LG hp, σ⟩ : VineA.PrescribedPrimeGarden γ (2 * R))) with hT
  have hfin : Finite (GroupPrescription γ (primeDataOf LG hp).skeleton) :=
    finite_groupPrescription (γ := γ) _
  have hTfin : T.Finite := Set.finite_range _
  have h1 : ((Finset.univ : Finset (PcA γ (mk := mk) R p kind A)).filter fun π => (repPt γ π).layered = LG).card ≤ T.ncard := by
    rw [← Set.ncard_coe_finset]
    refine Set.ncard_le_ncard_of_injOn (fun π => repPt γ π) ?_ ?_ hTfin
    · intro π hπ
      have := (Finset.mem_filter.1 (Finset.mem_coe.1 hπ)).2
      exact repPt_mem_rangeMk (mk := mk) π LG this hp
    · intro a _ b _ hab
      exact repPt_injectiveMk (mk := mk) hab
  have h2 : T.ncard ≤ Nat.card (GroupPrescription γ (primeDataOf LG hp).skeleton) := by
    rw [← Nat.card_coe_set_eq]
    exact Nat.card_le_card_of_surjective _ (Set.rangeFactorization_surjective (f := fun σ : GroupPrescription γ (primeDataOf LG hp).skeleton =>
      (⟨LG, primeDataOf LG hp, σ⟩ : VineA.PrescribedPrimeGarden γ (2 * R))))
  have h3 := natCard_groupPrescriptionG_le (γ := γ) (primeDataOf LG hp).skeleton (Mole.garden_isMolecule _)
  have h4 : Fintype.card (GBranch (primeDataOf LG hp).skeleton.tree) = (primeDataOf LG hp).skeleton.order :=
    WaveTurbulence.Mole.card_gbranch _
  have hsz := (primeDataOf LG hp).data.decoded_order (primeDataOf LG hp).prime.1 (primeDataOf LG hp).decodes
  have h5 : (primeDataOf LG hp).skeleton.order ≤ N := by omega
  calc _ ≤ T.ncard := h1
    _ ≤ _ := h2
    _ ≤ 3 ^ Fintype.card (GBranch (primeDataOf LG hp).skeleton.tree) := h3
    _ ≤ 3 ^ N := Nat.pow_le_pow_right (by norm_num) (by omega)

theorem fibre_card_le (p : ℕ) (kind : Bool) (A : Finset (LayeredGarden (2 * R))) (LG : LayeredGarden (2 * R))
    (hp : LG.garden.IsPlain) {N : ℕ} (hN : LG.garden.order = N) :
    ((Finset.univ : Finset (PcA γ R p kind A)).filter fun π => (repPt γ π).layered = LG).card ≤ 3 ^ N := fibre_card_leMk (mk := fun _ => ∅) p kind A LG hp hN

