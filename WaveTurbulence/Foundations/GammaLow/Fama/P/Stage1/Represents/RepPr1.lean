/-!
# S2 REPRESENTS: the producer, part 1 (prime data, decoration transport, selection)

* `layered_eq_reconstruction`: a layered garden decoded by `D` is `layeredReconstruction D hS layer hLayer`.
* `VineA.PrimeData.gardenEq`, `decCast`: decorations of `LG.garden` are decorations of the reconstructed garden.
* `selAt`: the `σ`-restriction of VINE-A's successor `VineA.NormalizedSplice.selOf`, read at a prescribed point.
-/

@[expose] public section
set_option autoImplicit false
set_option linter.unusedSectionVars false
open WaveTurbulence.Induct WaveTurbulence.GammaLow.FinalCount
open WaveTurbulence.VineParamContract WaveTurbulence.GammaLow.FinalCount
namespace WaveTurbulence.GammaLow.Fama.Represents
open WaveTurbulence.Represents WaveTurbulence.GammaLow.FinalCount
open WaveTurbulence WaveTurbulence.VineA WaveTurbulence.LGSpine WaveTurbulence.Reg.Skeleton WaveTurbulence.RegRed WaveTurbulence.GammaLow.FinalCount

variable {w : ℕ} {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]




/-- The `σ`-restriction (VINE-A's successor `selOf`) of the skeleton decoration collapsed from `κ`. -/
def selAt (γ : ℝ) [Fact (γ ≤ 1 / 2)] (P : WTParams) (base : Mom P.d) {roots : Fin w → (Fin P.d → ℤ)} {LG : LayeredGarden w}
    (pr : VineA.PrimeData LG) (σ : GroupPrescription γ pr.skeleton) (κ : GenDecoration LG.garden P.d roots 0) : Prop :=
  VineA.NormalizedSplice.selOf γ σ P.L P.γ P.η base (collapseGenDecoration pr.data pr.prime.1 (decCast pr κ)).1

theorem selAt_exists_unique (P : WTParams) (base : Mom P.d) {roots : Fin w → (Fin P.d → ℤ)}
    {LG : LayeredGarden w} (pr : VineA.PrimeData LG) (κ : GenDecoration LG.garden P.d roots 0) :
    ∃! σ : GroupPrescription γ pr.skeleton, selAt γ P base pr σ κ :=
  VineA.NormalizedSplice.exists_unique_prescription P.L P.γ P.η base _

end WaveTurbulence.GammaLow.Fama.Represents
