variable {w p : ℕ} {kind : Bool} {ι : Type*} {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]
  {A : FamilyReconstruction w ι} {i : ι} {σ : Prescription A.skeleton}


/-- B1b (Mk-general form of `shape_leaf_prescription_cast`). -/
theorem shape_leaf_prescription_castMk {S : Garden w} {τ σ : Prescription S} (he : τ = σ)
    {Mk : Set (CLVineG γ _)} (e : (stSt γ (Mk := Mk) S σ).G = (stSt γ (Mk := Mk) S τ).G) (l : GLeaf (stSt γ (Mk := Mk) S σ).G.tree) :
    (stShape γ (Mk := Mk) (Mole.garden_isMolecule S) τ).leaf (leafCast e l) =
      (stShape γ (Mk := Mk) (Mole.garden_isMolecule S) σ).leaf l := by subst τ; rfl


/-- B1b (Mk-general form of `shape_branch_prescription_cast`). -/
theorem shape_branch_prescription_castMk {S : Garden w} {τ σ : Prescription S} (he : τ = σ)
    {Mk : Set (CLVineG γ _)} (e : (stSt γ (Mk := Mk) S σ).G = (stSt γ (Mk := Mk) S τ).G) (b : GBranch (stSt γ (Mk := Mk) S σ).G.tree) :
    (stSt γ (Mk := Mk) S τ).M.ob (gardenBranchCast e b) = (stSt γ (Mk := Mk) S σ).M.ob b := by subst τ; rfl


/-- B1b-3 (Mk-general form of `operation_leaf_cast`). -/
theorem operation_leaf_castMk {Mk : Set (CLVineG γ A.skeleton)} (hA : IsV0Fam γ A.family σ Mk)
    (op : FamilyOperation (p := p) (kind := kind) A i)
    {Mk' : Set (CLVineG γ op.output.skeleton)} (hT : Stage1Mk.MarkTransported γ (operationMolIso op) Mk Mk')
    (l : GLeaf (stSt γ A.skeleton σ Mk).G.tree) :
    (stShape γ (Mole.garden_isMolecule op.output.skeleton) (transportPrescription (operationMolIso op) σ) Mk').leaf
      (leafCast (operation_splice_garden_eqMk hA op hT).symm l) =
    chosenLeafEquiv A.skeleton (A.family.placement i) op.choice
      ((stShape γ (Mole.garden_isMolecule A.skeleton) σ Mk).leaf l) := by
  cases op with
  | mk hc he ht hq ε C =>
    cases ε
    · obtain rfl : Mk = Mk' := Stage1Mk.markTransported_refl_eq hT
      change (stShape γ _ (transportPrescription (molIsoRefl _) σ) Mk).leaf _ = _
      exact shape_leaf_prescription_castMk (transportPrescription_refl σ) _ l
    · exact unit_leaf_castMk (selectedMemberSite γ hA i) σ hT ⟨familyVine γ A.family i, hA.1 i, rfl⟩ l


/-- B1b-3 (Mk-general form of `operation_branch_cast`). -/
theorem operation_branch_castMk {Mk : Set (CLVineG γ A.skeleton)} (hA : IsV0Fam γ A.family σ Mk)
    (op : FamilyOperation (p := p) (kind := kind) A i)
    {Mk' : Set (CLVineG γ op.output.skeleton)} (hT : Stage1Mk.MarkTransported γ (operationMolIso op) Mk Mk')
    (b : GBranch (stSt γ A.skeleton σ Mk).G.tree) :
    (stSt γ op.output.skeleton (transportPrescription (operationMolIso op) σ) Mk').M.ob
      (gardenBranchCast (operation_splice_garden_eqMk hA op hT).symm b) =
    chosenBranchEquiv A.skeleton (A.family.placement i) op.choice ((stSt γ A.skeleton σ Mk).M.ob b) := by
  cases op with
  | mk hc he ht hq ε C =>
    cases ε
    · obtain rfl : Mk = Mk' := Stage1Mk.markTransported_refl_eq hT
      change (stSt γ _ (transportPrescription (molIsoRefl _) σ) Mk).M.ob _ = _
      exact shape_branch_prescription_castMk (transportPrescription_refl σ) _ b
    · exact unit_branch_castMk (selectedMemberSite γ hA i) σ hT ⟨familyVine γ A.family i, hA.1 i, rfl⟩ b


variable {G H : Garden w}



/-- B1b-3 (Mk-general form of `operation_iota`). -/
theorem operation_iotaMk {Mk : Set (CLVineG γ A.skeleton)} (hA : IsV0Fam γ A.family σ Mk)
    (op : FamilyOperation (p := p) (kind := kind) A i)
    {Mk' : Set (CLVineG γ op.output.skeleton)} (hT : Stage1Mk.MarkTransported γ (operationMolIso op) Mk Mk')
    (s : ReplacementSlot (stSt γ A.skeleton σ Mk).G) :
    (stShape γ (Mole.garden_isMolecule op.output.skeleton) (transportPrescription (operationMolIso op) σ) Mk').iota
      op.output.plain ((stSt γ _ _ Mk').plain op.output.plain)
      (slotCast (operation_splice_garden_eqMk hA op hT).symm s) =
    operationSlotMap op
      ((stShape γ (Mole.garden_isMolecule A.skeleton) σ Mk).iota A.plain ((stSt γ _ _ Mk).plain A.plain) s) := by
  cases s with
  | inl q =>
    rw [slotCast_pair]
    simp only [SpliceShape.iota, operationSlotMap]
    rw [pairCast_first _ ((stSt γ _ _ Mk).plain A.plain), operation_leaf_castMk hA op hT]
    exact congrArg Sum.inl (sourcePairEquiv_pairOfLeaf A.plain op.output.plain
      (chosenLeafEquiv A.skeleton (A.family.placement i) op.choice)
      (chosenLeafEquiv_pair _ _ _) _).symm
  | inr b =>
    rw [slotCast_inr]
    exact congrArg Sum.inr (operation_branch_castMk hA op hT b)


end WaveTurbulence.GammaLow.Fama
