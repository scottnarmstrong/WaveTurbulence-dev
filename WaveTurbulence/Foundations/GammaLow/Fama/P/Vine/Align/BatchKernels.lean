/-- B1b-3 (Mk-general form of `spliceKernel_congr`). -/
theorem spliceKernel_congrMk (A : FamilyReconstruction w ι) {σ τ : Prescription A.skeleton}
    (Mk : Set (CLVineG γ A.skeleton)) (h : σ = τ) {G : Garden w} (e : G = (stSt γ A.skeleton σ Mk).G)
    (e' : G = (stSt γ A.skeleton τ Mk).G) (f : ℕ → Fin w → Fin w → Mom d → ℝ) (L γ' δ : ℝ) (s : ReplacementSlot G) :
    spliceKernelMk γ A σ Mk f L γ' δ (slotCast e s) = spliceKernelMk γ A τ Mk f L γ' δ (slotCast e' s) := by
  subst τ
  rfl

/-- B1b-3 (Mk-general form of `batch_spliceKernel`): R-SLOT along a batch carrying the marking. -/
theorem batch_spliceKernelMk {A B : FamilyReconstruction w ι} {xs : List ι}
    {F : MolIso A.skeleton.molecule B.skeleton.molecule} (h : BatchIso p kind xs A B F)
    (σ : Prescription A.skeleton) {Mk : Set (CLVineG γ A.skeleton)} {Mk' : Set (CLVineG γ B.skeleton)}
    (hT : Stage1Mk.MarkTransported γ F Mk Mk') (hA : IsV0Fam γ A.family σ Mk)
    (f : ℕ → Fin w → Fin w → Mom d → ℝ) (L γ' δ : ℝ) (s : ReplacementSlot (stSt γ A.skeleton σ Mk).G) :
    spliceKernelMk γ B (transportPrescription F σ) Mk' f L γ' δ (slotCast (BatchIso.splice_garden_eqMk h σ hT hA).symm s) =
      spliceKernelMk γ A σ Mk f L γ' δ s := by
  induction h with
  | nil A =>
    obtain rfl := Stage1Mk.markTransported_refl_eq hT
    exact spliceKernel_congrMk A Mk (transportPrescription_refl σ) _ rfl f L γ' δ s
  | skip _ _ ih => exact ih σ hT hA s
  | @apply xs A B i op F h ih =>
    obtain ⟨h1, h2⟩ := Stage1Mk.markTransported_split (operationMolIso op) F hT
    let τ := transportPrescription (operationMolIso op) σ
    let hB := isV0Fam_operationMk hA op h1
    let e0 := (operation_splice_garden_eqMk hA op h1).symm
    let e1 := (BatchIso.splice_garden_eqMk h τ h2 hB).symm
    calc
      _ = spliceKernelMk γ B (transportPrescription F τ) Mk' f L γ' δ (slotCast (e0.trans e1) s) :=
        spliceKernel_congrMk B Mk' (transportPrescription_trans _ _ σ).symm _ _ f L γ' δ s
      _ = spliceKernelMk γ B (transportPrescription F τ) Mk' f L γ' δ (slotCast e1 (slotCast e0 s)) :=
        congrArg _ (slotCast_trans e0 e1 s).symm
      _ = spliceKernelMk γ op.output τ _ f L γ' δ (slotCast e0 s) := ih τ h2 hB (slotCast e0 s)
      _ = _ := operation_spliceKernelMk hA op h1 f L γ' δ s


end WaveTurbulence.GammaLow.Fama
