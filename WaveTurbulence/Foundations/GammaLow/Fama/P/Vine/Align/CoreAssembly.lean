/-! Choose valid chain labels that recognize every geometrically core vine.
The source core carrier is existential in the vine type. This normalization
retains every atom set and both ordered joints, and retains the original label
when no core label exists. It adds no assumption to the output-set bridge. -/
@[expose] public section
set_option autoImplicit false
set_option linter.unusedSectionVars false
open WaveTurbulence.VineParamContract WaveTurbulence.GammaLow.FinalCount
namespace WaveTurbulence.GammaLow.Fama
open WaveTurbulence.VineAlign WaveTurbulence.GammaLow.FinalCount
open VineEstS2 VineEstS3 VineEstS4 VineA RedSplice Stage1 Twist RegRed WaveTurbulence.GammaLow.FinalCount
variable {w : ℕ} {G : Garden w} {U : Finset (GBranch G.tree)} {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]
  {a b : GBranch G.tree} {R : CLRegionData G U a b} {n : ℕ} 







/-- Same chain and region (main's core relabelling). Over `𝒱_γ` the chain assembly records no drawn type (the label
of a piece is derived, L5b's `ChainPieceΓ.label`: `I`, `II` for the bad vines), so the relabelling is the identity. -/
noncomputable def coreAssembly {U : Finset (GBranch G.tree)} {a b : GBranch G.tree}
    {R : CLRegionData G U a b} {n : ℕ} (B : Famb.VineEstS2.CLChainAssemblyΓ γ G R n) :
    Famb.VineEstS2.CLChainAssemblyΓ γ G R n := B

/-- A drawn vine (I) has two atoms. -/
theorem isVine_I_card {S : Finset (GBranch G.tree)} {p q : GBranch G.tree}
    (h : G.molecule.IsVine .I S p q) : S.card = 2 := by
  obtain ⟨-, k, hk, f, hinj, himg, -, -⟩ := h
  rw [← Finset.card_image_of_injOn hinj, himg, Finset.card_range]
  exact TVine.Struct.expand_I_n hk

/-- A drawn vine (II) has an even number `≥ 4` of atoms. -/
theorem isVine_II_card {S : Finset (GBranch G.tree)} {p q : GBranch G.tree}
    (h : G.molecule.IsVine .II S p q) : ∃ m, S.card = 2 * m + 4 := by
  obtain ⟨-, k, hk, f, hinj, himg, -, -⟩ := h
  rw [← Finset.card_image_of_injOn hinj, himg, Finset.card_range]
  exact TVine.Struct.expand_II_n hk

/-- Each piece whose geometric vine is core carries its core type as label. -/
theorem coreAssembly_piece_core (B : Famb.VineEstS2.CLChainAssemblyΓ γ G R n) (i : Fin n)
    (h : ∃ Y, IsCoreCLVine G Y (Famb.VineEstS2.assemblyPieceAtΓ (coreAssembly B) i).atoms
      (Famb.VineEstS2.assemblyPieceAtΓ (coreAssembly B) i).upper (Famb.VineEstS2.assemblyPieceAtΓ (coreAssembly B) i).lower) :
    IsCoreCLVine G (Famb.VineEstS2.assemblyPieceAtΓ (coreAssembly B) i).label
      (Famb.VineEstS2.assemblyPieceAtΓ (coreAssembly B) i).atoms
      (Famb.VineEstS2.assemblyPieceAtΓ (coreAssembly B) i).upper (Famb.VineEstS2.assemblyPieceAtΓ (coreAssembly B) i).lower := by
  obtain ⟨Y, hY⟩ := h
  set P := Famb.VineEstS2.assemblyPieceAtΓ (coreAssembly B) i with hP
  rcases hY.2.2 with rfl | ⟨rfl, -⟩
  · rw [P.label_of_I hY.1]; exact hY
  · have hnI : ¬ G.molecule.IsVine .I P.atoms P.upper P.lower := fun hI => by
      have h2 := isVine_I_card hI
      obtain ⟨m, hm⟩ := isVine_II_card hY.1
      omega
    rw [P.label_of_II hnI hY.1]; exact hY

/-- Actual unit assemblies with core labels chosen by the source's existential criterion.  B1a: the Mk-general
family (the units are the runs of the marked groups); main's `alignedAssembly γ hM σ` is its value at `Mk = ∅`. -/
noncomputable def alignedAssemblyMk (γ : ℝ) [Fact (γ ≤ 1 / 2)] (hM : G.molecule.IsMolecule) (σ : Prescription G) (Mk : Set (CLVineG γ G))
    (j : Fin (unitBlocks γ G σ Mk).length) := coreAssembly (Fama.Represents.unitAssembly hM σ j)

/-- Actual unit assemblies with core labels chosen by the source's existential criterion. -/
noncomputable abbrev alignedAssembly (γ : ℝ) [Fact (γ ≤ 1 / 2)] (hM : G.molecule.IsMolecule) (σ : Prescription G) :=
  alignedAssemblyMk γ hM σ ∅

end WaveTurbulence.GammaLow.Fama
