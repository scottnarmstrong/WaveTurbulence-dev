@[expose] public section
set_option autoImplicit false
set_option linter.unusedSectionVars false
open WaveTurbulence.VineParamContract WaveTurbulence.GammaLow.FinalCount
namespace WaveTurbulence.GammaLow.Fama
open WaveTurbulence.VineAlign WaveTurbulence.GammaLow.FinalCount
open VineEstS2 VineEstS3 VineEstS4 VineA VineB VineC RedSplice Stage1 Twist RegRed Represents WaveTurbulence.GammaLow.FinalCount
variable {w : ℕ} {S : Garden w} {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]

/-- B1b (Mk-general form of `unitsFamily_isV0Fam`). -/
theorem unitsFamily_isV0FamMk (hM : S.molecule.IsMolecule) (σ : Prescription S) {Mk : Set (CLVineG γ _)} :
    IsV0Fam γ (Mk := Mk) (Famb.VineC.unitsFamilyΓ (alignedAssemblyMk γ (Mk := Mk) hM σ) (unitBlkMk_disj (Mk := Mk) hM σ)) σ := by
  constructor
  · rintro ⟨j, k⟩
    have hmem := assemblyVine_memMk (Mk := Mk) (List.get_mem (unitBlocks γ (Mk := Mk) S σ) j) (alignedAssemblyMk γ (Mk := Mk) hM σ j) k.1
    have he : assemblyVine γ (alignedAssemblyMk γ (Mk := Mk) hM σ j) k.1 =
        familyVine γ (Famb.VineC.unitsFamilyΓ (alignedAssemblyMk γ (Mk := Mk) hM σ) (unitBlkMk_disj (Mk := Mk) hM σ)) ⟨j, k⟩ :=
      clVine_eq_of_atoms rfl
    exact he ▸ hmem
  · intro c hc hcore
    obtain ⟨_, u, hu, hcu⟩ := (Famc.VineA.vinesV0_iff_unit_cover_diffMkG (Mk := Mk) S σ c).mp hc
    obtain ⟨j, rfl⟩ := List.mem_iff_get.mp hu
    obtain ⟨i, hi⟩ := vine_subset_assemblyPiece (alignedAssemblyMk γ (Mk := Mk) hM σ j) c.isVine hcu
    have hm := assemblyVine_memMk (Mk := Mk) (List.get_mem (unitBlocks γ (Mk := Mk) S σ) j) (alignedAssemblyMk γ (Mk := Mk) hM σ j) i
    have he : c = assemblyVine γ (alignedAssemblyMk γ (Mk := Mk) hM σ j) i := by
      by_contra hne
      have hh := vinesV_separated hc.1 hm.1 hne c.upper c.upper_mem (hi c.upper_mem)
        c.lower c.lower_mem (hi c.lower_mem)
      exact (Src.isBlock_of_isSomeVine c.isVine).2.2.2.1 hh
    have hk : IsCoreCLVine S ((Famb.VineEstS4.assemblySourceFamilyΓ (alignedAssemblyMk γ (Mk := Mk) hM σ j)).kind i)
        ((Famb.VineEstS4.assemblySourceFamilyΓ (alignedAssemblyMk γ (Mk := Mk) hM σ j)).atoms i)
        ((Famb.VineEstS4.assemblySourceFamilyΓ (alignedAssemblyMk γ (Mk := Mk) hM σ j)).upper i)
        ((Famb.VineEstS4.assemblySourceFamilyΓ (alignedAssemblyMk γ (Mk := Mk) hM σ j)).lower i) := by
      apply coreAssembly_piece_core (Represents.unitAssembly hM σ j) i
      rw [he] at hcore
      exact hcore
    exact ⟨⟨j, ⟨i, hk⟩⟩, congrArg CLVineG.atoms he.symm⟩

/-- All and only selected core vines occur in the unit assembly family. -/
theorem unitsFamily_isV0Fam (hM : S.molecule.IsMolecule) (σ : Prescription S) :
    IsV0Fam γ (Famb.VineC.unitsFamilyΓ (alignedAssembly γ hM σ) (unitBlk_disj hM σ)) σ := unitsFamily_isV0FamMk (Mk := ∅) hM σ

end WaveTurbulence.GammaLow.Fama
