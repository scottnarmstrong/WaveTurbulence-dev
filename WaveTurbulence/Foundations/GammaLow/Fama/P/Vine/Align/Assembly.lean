/-! Exact source ingredients of the unit assemblies. -/
@[expose] public section
set_option autoImplicit false
set_option linter.unusedSectionVars false
open WaveTurbulence.VineParamContract WaveTurbulence.GammaLow.FinalCount
namespace WaveTurbulence.GammaLow.Fama
open WaveTurbulence.VineAlign WaveTurbulence.GammaLow.FinalCount
open VineEstS2 VineEstS3 VineEstS4 VineA RedSplice Stage1 Twist RegRed WaveTurbulence.GammaLow.FinalCount
variable {w : ℕ} {G : Garden w} {U : Finset (GBranch G.tree)} {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]
  {a b : GBranch G.tree} {R : CLRegionData G U a b} {n : ℕ}

/-- Each assembly piece is an ingredient of the actual source chain. -/
theorem assemblyPiece_ingredient (B : Famb.VineEstS2.CLChainAssemblyΓ γ G R n) (i : Fin n) :
    ChainIngredientG γ G.molecule U a b n (Famb.VineEstS2.assemblyPieceAtΓ B i).atoms
      (Famb.VineEstS2.assemblyPieceAtΓ B i).upper (Famb.VineEstS2.assemblyPieceAtΓ B i).lower := by
  induction B with
  | single hV R => exact .single hV
  | append B hT hi hU R ih =>
    rcases Fin.eq_zero_or_eq_succ i with rfl | ⟨k, rfl⟩
    · exact .append_last B.toSourceChain hT hi hU.2.2.2.1
    · exact .append_left (ih k) hT hi hU.2.2.2.1

/-- A vine contained in an assembly is contained in one of its actual pieces. -/
theorem vine_subset_assemblyPiece (B : Famb.VineEstS2.CLChainAssemblyΓ γ G R n)
    {A : Finset (GBranch G.tree)} {x y : GBranch G.tree} 
    (hA : Src.IsSomeVine γ G.molecule A x y) (hAU : A ⊆ U) :
    ∃ i, A ⊆ (Famb.VineEstS2.assemblyPieceAtΓ B i).atoms := by
  induction B with
  | single hV R => exact ⟨0, hAU⟩
  | append B hT hi hU R ih =>
    rcases vine_in_terminal_split G.molecule (Mole.garden_isMolecule G)
      (Src.isBlock_of_isSomeVine hT) hU (Famb.VineEstS2.chain_joints_memΓ B.toSourceChain).2 hA hAU with hAS | hAT
    · obtain ⟨i, hi⟩ := ih hAS
      exact ⟨i.succ, hi⟩
    · exact ⟨0, hAT⟩

/-- The CL vine of an actual assembly piece, with the source's ordered joints. -/
noncomputable def assemblyVine (γ : ℝ) [Fact (γ ≤ 1 / 2)] (B : Famb.VineEstS2.CLChainAssemblyΓ γ G R n) (i : Fin n) : CLVineG γ G where
  atoms := (Famb.VineEstS2.assemblyPieceAtΓ B i).atoms
  upper := (Famb.VineEstS2.assemblyPieceAtΓ B i).upper
  lower := (Famb.VineEstS2.assemblyPieceAtΓ B i).lower
  isVine := (Famb.VineEstS2.assemblyPieceAtΓ B i).vine
  notParentUpper := (Famb.VineEstS3.assemblyPiece_clΓ B i).1
  parentLower := (Famb.VineEstS3.assemblyPiece_clΓ B i).2

/-- B1b (Mk-general form of `assemblyVine_mem`). -/
theorem assemblyVine_memMk {σ : Prescription G} {u : CLBlock G}
    {Mk : Set (CLVineG γ _)} (hu : u ∈ unitBlocks γ (Mk := Mk) G σ) {n : ℕ} (B : Famb.VineEstS2.CLChainAssemblyΓ γ G (VineB.regionOf u) n) (i : Fin n) :
    assemblyVine γ B i ∈ vinesV0 γ (Mk := Mk) G σ := by
  have hi : (Famb.VineEstS2.assemblyPieceAtΓ B i).atoms ∈ unitIngredients γ (Mk := Mk) G σ :=
    ⟨u, hu, u.upper, u.lower, n, _, _, assemblyPiece_ingredient B i⟩
  obtain ⟨c, hc, he⟩ := (VineA.mem_unitIngredients_iffMk (Mk := Mk)).mp hi
  have hcv : c = assemblyVine γ B i := clVine_eq_of_atoms he
  exact hcv ▸ hc


end WaveTurbulence.GammaLow.Fama
