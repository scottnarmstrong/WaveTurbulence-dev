section HingeMk
variable {w p : ℕ} {kind : Bool} {S : Garden w} {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]
  (hM : S.molecule.IsMolecule) (σ : Prescription S) {Mk : Set (CLVineG γ S)}
  (D : ReconstructionData S) (hS : S.IsPlain)
  (layer : GNode (D.forest hS) → ℕ) (hLayer : IsLayering (D.garden hS) layer)
  {Y : FamilyReconstruction w (Famb.VineC.UnitsIndexΓ (alignedAssemblyMk γ hM σ Mk))}
  {vs : ∀ j, UnitAt Y.skeleton Y.family ((Famb.VineC.unitsSplitΓ (alignedAssemblyMk γ hM σ Mk)).Q j)}
  {L : List (Famb.VineC.UnitsIndexΓ (alignedAssemblyMk γ hM σ Mk))}
  (hr : ReachU p kind (Famb.VineC.unitsSplitΓ (alignedAssemblyMk γ hM σ Mk)).Q L
    (Famb.VineC.unitsStartΓ (alignedAssemblyMk γ hM σ Mk) (unitBlkMk_disj hM σ Mk) D hS layer hLayer)
    (Famb.VineC.unitsRegionΓ (alignedAssemblyMk γ hM σ Mk) (unitBlkMk_disj hM σ Mk)) Y vs)
  (hn : L.Nodup)
  {Mk' : Set (CLVineG γ Y.skeleton)} (hT : Stage1Mk.MarkTransported γ (batchMolIso hr.batch) Mk Mk')

/-- B1b-3 (Mk-general form of `commonShape_br`).
The common shape uses the actual batch map on every surviving original branch. -/
theorem commonShape_brMk (c : GBranch (stSt γ S σ Mk).G.tree) :
    (commonShapeMk hM σ D hS layer hLayer hr hn hT).br c =
      (batchMolIso hr.batch).e ((stSt γ S σ Mk).M.ob c) := by
  let h := batchMolIso_spec hr.batch
  let e := (BatchIso.spliceMolIsoMk γ h σ hT (unitsFamily_isV0FamMk hM σ)).e
  calc
    _ = (endpointShapeMk hM σ D hS layer hLayer hr hn hT).br (e c) := by
      exact (congrArg (commonShapeMk hM σ D hS layer hLayer hr hn hT).br
        (BatchIso.splice_branch_castMk h σ hT (unitsFamily_isV0FamMk hM σ) c).symm).trans
          (castShape_br (BatchIso.splice_garden_eqMk h σ hT (unitsFamily_isV0FamMk hM σ))
            (endpointShapeMk hM σ D hS layer hLayer hr hn hT) (e c))
    _ = (stSt γ Y.skeleton (transportPrescription (batchMolIso hr.batch) σ) Mk').M.ob (e c) := by
      unfold endpointShapeMk
      rw [congrBlocks_br]
      rfl
    _ = _ := BatchIso.spliceMolIso_branch_namesMk h σ hT (unitsFamily_isV0FamMk hM σ) c

/-- B1b-3 (Mk-general form of `commonShape_hinge`).
Each labelled hinge, not just their finite set, is class-independent. -/
theorem commonShape_hingeMk (j : Fin (unitBlocks γ S σ Mk).length) :
    (commonShapeMk hM σ D hS layer hLayer hr hn hT).hinge (member_disjMk hM σ D hS layer hLayer hr hn) j =
      (stShape γ hM σ Mk).hinge (unitBlkMk_disj hM σ Mk) j := by
  classical
  apply (commonShapeMk hM σ D hS layer hLayer hr hn hT).br_inj
  rw [SpliceShape.br_hinge, commonShape_brMk]
  have hc := (reachU_coordinates hr hn (batchMolIso_spec hr.batch) j).2.1
  exact hc.trans (congrArg (batchMolIso hr.batch).e ((stShape γ hM σ Mk).br_hinge (unitBlkMk_disj hM σ Mk) j).symm)



end HingeMk

variable {w p : ℕ} {kind : Bool} {S : Garden w} {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]
  (hM : S.molecule.IsMolecule) (σ : Prescription S)
  (D : ReconstructionData S) (hS : S.IsPlain)
  (layer : GNode (D.forest hS) → ℕ) (hLayer : IsLayering (D.garden hS) layer)
  {Y : FamilyReconstruction w (Famb.VineC.UnitsIndexΓ (alignedAssembly γ hM σ))}
  {vs : ∀ j, UnitAt Y.skeleton Y.family ((Famb.VineC.unitsSplitΓ (alignedAssembly γ hM σ)).Q j)}
  {L : List (Famb.VineC.UnitsIndexΓ (alignedAssembly γ hM σ))}
  (hr : ReachU p kind (Famb.VineC.unitsSplitΓ (alignedAssembly γ hM σ)).Q L
    (Famb.VineC.unitsStartΓ (alignedAssembly γ hM σ) (unitBlk_disj hM σ) D hS layer hLayer)
    (Famb.VineC.unitsRegionΓ (alignedAssembly γ hM σ) (unitBlk_disj hM σ)) Y vs)
  (hn : L.Nodup)

/-- The common shape uses the actual batch map on every surviving original branch. -/
theorem commonShape_br (c : GBranch (stSt γ S σ).G.tree) :
    (commonShape hM σ D hS layer hLayer hr hn).br c =
      (batchMolIso hr.batch).e ((stSt γ S σ).M.ob c) :=
  commonShape_brMk hM σ D hS layer hLayer hr hn (Stage1Mk.markTransported_empty _) c




end WaveTurbulence.GammaLow.Fama
