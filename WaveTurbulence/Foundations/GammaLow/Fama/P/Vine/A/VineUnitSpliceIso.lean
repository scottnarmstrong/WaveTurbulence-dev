/-! Actual selected unit LF twists induce directed molecular isomorphisms
of the actual simultaneous splices, including internal vines of larger units. -/
@[expose] public section
set_option autoImplicit false
set_option linter.unusedSectionVars false
namespace WaveTurbulence.GammaLow.Fama.VineA
open WaveTurbulence.VineA WaveTurbulence.GammaLow.FinalCount
open WaveTurbulence.RedSplice WaveTurbulence.Stage1 WaveTurbulence.GammaLow.FinalCount
variable {w : ℕ} {G : Garden w} {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]

/-- B1b-2 (Mk-general form of `unitSpliceMolIso`). -/
noncomputable def unitSpliceMolIsoMk (γ : ℝ) [Fact (γ ≤ 1 / 2)] (Z : TwistGroupSite γ G) (σ : Prescription G)
    {Mk : Set (CLVineG γ G)} {Mk' : Set (CLVineG γ Z.target)} (hT : Stage1Mk.MarkTransported γ Z.iso Mk Mk')
    (hsel : ∃ c ∈ vinesV0 γ G σ Mk, c.atoms = Z.S0) :
    MolIso (stSt γ G σ Mk).G.molecule
      (stSt γ Z.target (transportPrescription Z.iso σ) Mk').G.molecule :=
  quotientMolIso Z.iso (unitBlocks_cls_twistMk Z σ hT hsel)
    (stSt γ G σ Mk).M
    (stSt γ Z.target (transportPrescription Z.iso σ) Mk').M

/-- The actual molecular map between the two actual selected simultaneous splices. -/
noncomputable def unitSpliceMolIso (γ : ℝ) [Fact (γ ≤ 1 / 2)] (Z : TwistGroupSite γ G) (σ : Prescription G)
    (hsel : ∃ c ∈ vinesV0 γ G σ, c.atoms = Z.S0) :
    MolIso (stSt γ G σ).G.molecule
      (stSt γ Z.target (transportPrescription Z.iso σ)).G.molecule :=
  unitSpliceMolIsoMk γ Z σ (Stage1Mk.markTransported_empty Z.iso) hsel

/-- B1b-2 (Mk-general form of `unitSpliceMolIso_branch_names`). -/
theorem unitSpliceMolIso_branch_namesMk (Z : TwistGroupSite γ G) (σ : Prescription G)
    {Mk : Set (CLVineG γ G)} {Mk' : Set (CLVineG γ Z.target)} (hT : Stage1Mk.MarkTransported γ Z.iso Mk Mk')
    (hsel : ∃ c ∈ vinesV0 γ G σ Mk, c.atoms = Z.S0)
    (c : GBranch (stSt γ G σ Mk).G.tree) :
    (stSt γ Z.target (transportPrescription Z.iso σ) Mk').M.ob
      ((unitSpliceMolIsoMk γ Z σ hT hsel).e c) = Z.iso.e ((stSt γ G σ Mk).M.ob c) :=
  quotientBranchEquiv_comm Z.iso (unitBlocks_cls_twistMk Z σ hT hsel) _ _ c


/-- B1b-2 (Mk-general form of `unitSpliceMolIso_dart_names`). -/
theorem unitSpliceMolIso_dart_namesMk (Z : TwistGroupSite γ G) (σ : Prescription G)
    {Mk : Set (CLVineG γ G)} {Mk' : Set (CLVineG γ Z.target)} (hT : Stage1Mk.MarkTransported γ Z.iso Mk Mk')
    (hsel : ∃ c ∈ vinesV0 γ G σ Mk, c.atoms = Z.S0)
    (x : GardenDart (stSt γ G σ Mk).G) :
    (stSt γ Z.target (transportPrescription Z.iso σ) Mk').M.od
      ((unitSpliceMolIsoMk γ Z σ hT hsel).d x) = Z.iso.d ((stSt γ G σ Mk).M.od x) :=
  quotientDartEquiv_comm Z.iso (unitBlocks_cls_twistMk Z σ hT hsel) _ _ x


/-- B1b-2 (Mk-general form of `active_lower_not_surviving`). -/
theorem active_lower_not_survivingMk (Z : TwistGroupSite γ G) (σ : Prescription G)
    {Mk : Set (CLVineG γ G)}
    (hsel : ∃ c ∈ vinesV0 γ G σ Mk, c.atoms = Z.S0) :
    ¬ ∃ c, (stSt γ G σ Mk).M.ob c = Z.P.lower := by
  intro h
  obtain ⟨u, _, hu, hne⟩ := active_lower_mergedMk Z σ hsel
  have hr := ((stSt γ G σ Mk).M.ob_range Z.P.lower).mp h
  change (stSt γ G σ Mk).cls Z.P.lower = some u.upper at hu
  rw [hu] at hr
  rcases hr with h | h
  · cases h
  · exact hne (Option.some.inj h)


end WaveTurbulence.GammaLow.Fama.VineA
