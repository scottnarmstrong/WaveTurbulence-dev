/-! The actual splice quotient map for both choices of every admissible
selected-family LF operation, with exact original-branch names. -/
@[expose] public section
set_option autoImplicit false
set_option linter.unusedSectionVars false
namespace WaveTurbulence.GammaLow.Fama.VineA
open WaveTurbulence.VineA WaveTurbulence.GammaLow.FinalCount
open WaveTurbulence.Stage1 WaveTurbulence.RedSplice WaveTurbulence.LFTwist WaveTurbulence.GammaLow.FinalCount
variable {w p : ℕ} {kind : Bool} {ι : Type*} {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]

/-- B1b-2 (Mk-general form of `operation_splice_classes`). -/
theorem operation_splice_classesMk {A : FamilyReconstruction w ι} {i : ι}
    {σ : Prescription A.skeleton} {Mk : Set (CLVineG γ A.skeleton)} (hF : IsV0Fam γ A.family σ Mk)
    (op : FamilyOperation (p := p) (kind := kind) A i)
    {Mk' : Set (CLVineG γ op.output.skeleton)} (hT : Stage1Mk.MarkTransported γ (operationMolIso op) Mk Mk')
    (b : GBranch A.skeleton.tree) :
    (stSt γ op.output.skeleton (transportPrescription (operationMolIso op) σ) Mk').cls ((operationMolIso op).e b) =
      ((stSt γ A.skeleton σ Mk).cls b).map (operationMolIso op).e := by
  cases op with
  | mk hc he ht hq ε C =>
    cases ε
    · obtain rfl : Mk = Mk' := Stage1Mk.markTransported_refl_eq hT
      change (stSt γ A.skeleton (transportPrescription (molIsoRefl A.skeleton) σ) Mk).cls b =
        ((stSt γ A.skeleton σ Mk).cls b).map id
      rw [transportPrescription_refl]
      cases (stSt γ A.skeleton σ Mk).cls b <;> rfl
    · exact unitBlocks_cls_twistMk (selectedMemberSite γ hF i) σ hT ⟨familyVine γ A.family i, hF.1 i, rfl⟩ b






end WaveTurbulence.GammaLow.Fama.VineA
