/-! Exact candidate bijections under the actual molecular atom and dart maps. -/
@[expose] public section
open WaveTurbulence.Induct WaveTurbulence.GammaLow.FinalCount
set_option autoImplicit false
set_option linter.unusedSectionVars false
namespace WaveTurbulence.GammaLow.Fama.VineA
open WaveTurbulence.VineA WaveTurbulence.GammaLow.FinalCount
open WaveTurbulence.Stage1 WaveTurbulence.LGSpine.SourceVine WaveTurbulence.GammaLow.FinalCount
variable {w : ℕ} {G H : Garden w} {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]

/-- A molecular map carries the single-HV case to the single-HV case. -/
theorem SingleHVGroup.map {S : Finset (GBranch G.tree)} (h : SingleHVGroup γ G S)
    (F : MolIso G.molecule H.molecule) : SingleHVGroup γ H (F.img S) := by
  refine ⟨MolIso.maximalGroups_img F h.1, ?_, ?_⟩
  · obtain ⟨a, b, hv⟩ := h.2.1
    exact ⟨F.e a, F.e b, MolIso.isHV_img F hv⟩
  · rintro ⟨a, b, hv⟩
    obtain ⟨a, rfl⟩ := F.e.surjective a
    obtain ⟨b, rfl⟩ := F.e.surjective b
    exact h.2.2 ⟨a, b, (MolIso.isHVC_img_iff F).mp hv⟩


/-- Validity is preserved and reflected for every HV triple. -/
theorem hvCandidate_map_iff (F : MolIso G.molecule H.molecule) (S : Finset (GBranch G.tree))
    (t : GBranch G.tree × GBranch G.tree × GardenDart G) :
    HVCandidate γ H (F.img S) (hvTripleEquiv F t) ↔ HVCandidate γ G S t := by
  rcases t with ⟨a, b, e⟩
  constructor
  · intro h
    have he := F.symm.ends_img h.1
    refine ⟨?_, (MolIso.isSomeVine_img_iff (F.erase e)).mp h.2⟩
    change G.molecule.ends (F.d.symm (F.d e)) = s(F.e.symm (F.e a), F.e.symm (F.e b)) at he
    simpa only [Equiv.symm_apply_apply] using he
  · intro h
    exact ⟨F.ends_img h.1, MolIso.isSomeVine_img (F.erase e) h.2⟩

/-- The complete HV candidate carriers are bijective. -/
def hvCandidateEquiv (γ : ℝ) [Fact (γ ≤ 1 / 2)] (F : MolIso G.molecule H.molecule) (S : Finset (GBranch G.tree)) :
    {t // HVCandidate γ G S t} ≃ {t // HVCandidate γ H (F.img S) t} :=
  (hvTripleEquiv F).subtypeEquiv (fun t => (hvCandidate_map_iff F S t).symm)






/-- The pure-DV exclusion conditions are preserved by a molecular map. -/
theorem PureDVGroup.map {S : Finset (GBranch G.tree)} (h : PureDVGroup γ G S)
    (F : MolIso G.molecule H.molecule) : PureDVGroup γ H (F.img S) := by
  refine ⟨MolIso.maximalGroups_img F h.1, ?_, ?_⟩
  · obtain ⟨a, b, hv⟩ := h.2.1
    exact ⟨F.e a, F.e b, isDV_molIso F hv⟩
  · rintro ⟨a, b, hv⟩
    have back : ∃ a b, Src.IsHV γ G.molecule S a b ∨ Src.IsVC γ G.molecule S a b ∨ Src.IsHVC γ G.molecule S a b := by
      rcases hv with hv | hv | hv
      · have hh := MolIso.isHV_img F.symm hv
        rw [F.img_img_symm] at hh
        exact ⟨_, _, Or.inl hh⟩
      · have hh := MolIso.isVC_img F.symm hv
        rw [F.img_img_symm] at hh
        exact ⟨_, _, Or.inr (Or.inl hh)⟩
      · have hh := MolIso.isHVC_img F.symm hv
        rw [F.img_img_symm] at hh
        exact ⟨_, _, Or.inr (Or.inr hh)⟩
    exact h.2.2 back

end WaveTurbulence.GammaLow.Fama.VineA
