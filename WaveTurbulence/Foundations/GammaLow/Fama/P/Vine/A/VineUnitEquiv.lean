/-! Choice-independent transport of the actual unitBlocks γ list under a
selected unit LF twist. Forward and inverse spine containment force equality. -/
@[expose] public section
set_option autoImplicit false
set_option linter.unusedSectionVars false
namespace WaveTurbulence.GammaLow.Fama.VineA
open WaveTurbulence.VineA WaveTurbulence.GammaLow.FinalCount
open Finset WaveTurbulence.RedSplice WaveTurbulence.Stage1 WaveTurbulence.GammaLow.FinalCount
variable {w : ℕ} {G : Garden w} {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]

/-- B1b-2 (Mk-general form of `unitImage_mem`, two marked sets carried by the twist). -/
theorem unitImage_memMk (Z : TwistGroupSite γ G) (σ : Prescription G) {Mk : Set (CLVineG γ G)}
    {Mk' : Set (CLVineG γ Z.target)} (hT : Stage1Mk.MarkTransported γ Z.iso Mk Mk')
    (hsel : ∃ c ∈ vinesV0 γ G σ Mk, c.atoms = Z.S0)
    {u : CLBlock G} (hu : u ∈ unitBlocks γ G σ Mk) :
    Famc.VineA.unitImage γ Z u (Famc.VineA.unitBlocks_goodMk Z σ hsel hu) ∈
      unitBlocks γ Z.target (transportPrescription Z.iso σ) Mk' := by
  obtain ⟨v, hv, hUv⟩ := unitBlocks_image_subsetMk Z σ hT hu
  obtain ⟨u', hu', hvU'⟩ := unitBlocks_preimage_subsetMk Z σ hT hv
  have hUU' : u.atoms ⊆ u'.atoms := by
    have h := (Z.iso.symm.img_subset_iff).mpr hUv
    rw [Z.iso.img_img_symm] at h
    exact h.trans hvU'
  have he : u = u' := Famc.VineA.units_eq_of_mem_inter _ (unitBlocks_pairwiseMk (Mole.garden_isMolecule G) σ Mk)
    hu hu' u.isBlock.2.1 (hUU' u.isBlock.2.1)
  subst u'
  have hvU : v.atoms ⊆ Z.iso.img u.atoms := by
    have h := (Z.iso.img_subset_iff).mpr hvU'
    rw [Z.iso.img_symm_img] at h
    exact h
  have hev : v = Famc.VineA.unitImage γ Z u (Famc.VineA.unitBlocks_goodMk Z σ hsel hu) :=
    Famc.VineA.clBlock_eq_of_atoms (subset_antisymm hvU hUv)
  exact hev ▸ hv


/-- B1b-2 (Mk-general form of `unitBlocks_preimage`). -/
theorem unitBlocks_preimageMk (Z : TwistGroupSite γ G) (σ : Prescription G) {Mk : Set (CLVineG γ G)}
    {Mk' : Set (CLVineG γ Z.target)} (hT : Stage1Mk.MarkTransported γ Z.iso Mk Mk')
    (hsel : ∃ c ∈ vinesV0 γ G σ Mk, c.atoms = Z.S0)
    {v : CLBlock Z.target} (hv : v ∈ unitBlocks γ Z.target (transportPrescription Z.iso σ) Mk') :
    ∃ u ∈ unitBlocks γ G σ Mk, v.atoms = Z.iso.img u.atoms ∧
      v.upper = Z.iso.e u.upper ∧ v.lower = Z.iso.e u.lower := by
  obtain ⟨u, hu, hvu⟩ := unitBlocks_preimage_subsetMk Z σ hT hv
  let u' := Famc.VineA.unitImage γ Z u (Famc.VineA.unitBlocks_goodMk Z σ hsel hu)
  have hu' : u' ∈ unitBlocks γ Z.target (transportPrescription Z.iso σ) Mk' := unitImage_memMk Z σ hT hsel hu
  have hsub : v.atoms ⊆ u'.atoms := by
    have h := (Z.iso.img_subset_iff).mpr hvu
    rw [Z.iso.img_symm_img] at h
    exact h
  have he : v = u' := Famc.VineA.units_eq_of_mem_inter _
    (unitBlocks_pairwiseMk (Mole.garden_isMolecule Z.target) _ Mk') hv hu' v.isBlock.2.1 (hsub v.isBlock.2.1)
  exact ⟨u, hu, congrArg CLBlock.atoms he, congrArg CLBlock.upper he, congrArg CLBlock.lower he⟩






end WaveTurbulence.GammaLow.Fama.VineA
