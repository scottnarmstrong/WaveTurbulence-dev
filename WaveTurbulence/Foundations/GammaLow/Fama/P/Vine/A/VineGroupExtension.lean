/-! Canonical extension of the restricted group prescriptions required by R24 D2. -/
@[expose] public section
set_option autoImplicit false
set_option linter.unusedSectionVars false
namespace WaveTurbulence.GammaLow.Fama.VineA
open WaveTurbulence.VineA WaveTurbulence.GammaLow.FinalCount
open Stage1 RedSplice Represents WaveTurbulence.GammaLow.FinalCount
variable {w : ℕ} {G H : Garden w} {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]

/-- Extend only for the total S2a API; off-group values are the fixed kind LG. -/
noncomputable def extendGroupPrescription (γ : ℝ) [Fact (γ ≤ 1 / 2)] (σ : GroupPrescription γ G) : Prescription G := by
  classical
  exact fun S => if h : S ∈ maximalGroupsG γ G.molecule then σ ⟨S, h⟩ else .LG

/-- Restriction recovers the original finite group prescription exactly. -/
theorem of_extendGroupPrescription (σ : GroupPrescription γ G) :
    GroupPrescription.ofPrescription γ (extendGroupPrescription γ σ) = σ := by
  funext S
  exact dite_eq_left S.2

/-- Canonical extension commutes with actual molecular transport, also off the maximal groups. -/
theorem transport_extendGroupPrescription (F : MolIso G.molecule H.molecule) (σ : GroupPrescription γ G) :
    transportPrescription F (extendGroupPrescription γ σ) =
      extendGroupPrescription γ (transportGroupPrescription γ F σ) := by
  classical
  funext T
  have hm : F.symm.img T ∈ maximalGroupsG γ G.molecule ↔ T ∈ maximalGroupsG γ H.molecule :=
    MolIso.maximalGroups_img_iff F.symm
  change (if h : F.symm.img T ∈ maximalGroupsG γ G.molecule then σ ⟨F.symm.img T, h⟩ else .LG) =
    (if h : T ∈ maximalGroupsG γ H.molecule then σ ((groupEquiv γ F).symm ⟨T, h⟩) else .LG)
  by_cases h : T ∈ maximalGroupsG γ H.molecule
  · rw [dite_eq_left (hm.mpr h), dite_eq_left h]
    rfl
  · rw [dite_eq_right (fun hs => h (hm.mp hs)), dite_eq_right h]

end WaveTurbulence.GammaLow.Fama.VineA
