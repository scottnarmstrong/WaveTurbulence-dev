/-- B1b-3 (Mk-general form of `gapProfile`). -/
noncomputable def gapProfileMk (γ : ℝ) [Fact (γ ≤ 1 / 2)] (G : Garden w) (σ : Prescription G) (Mk : Set (CLVineG γ G)) : GapProfile w :=
  ⟨(stSt γ G σ Mk).G, fun _ L γ' η _ base _ z => NormalizedSplice.gapValueMk γ G σ Mk L γ' η base z.1⟩

/-- B1b-3 (Mk-general form of `gapProfile_twist`). -/
theorem gapProfile_twistMk (Z : TwistGroupSite γ G) (σ : Prescription G)
    {Mk : Set (CLVineG γ G)} {Mk' : Set (CLVineG γ Z.target)} (hT : Stage1Mk.MarkTransported γ Z.iso Mk Mk')
    (hsel : ∃ c ∈ vinesV0 γ G σ Mk, c.atoms = Z.S0) (hH : Z.target.IsPlain)
    (hgS : NormalizedSplice.GapValueSelDartsAt γ G σ Mk)
    (hgT : NormalizedSplice.GapValueSelDartsAt γ Z.target (transportPrescription Z.iso σ) Mk') :
    gapProfileMk γ Z.target (transportPrescription Z.iso σ) Mk' = gapProfileMk γ G σ Mk := by
  apply GapProfile.eq_of_cast (unitSplice_garden_eqMk Z σ hT hsel)
  intro d L γ' η hL base roots z
  change GenDecoration (stSt γ Z.target (transportPrescription Z.iso σ) Mk').G d roots 0 at z
  change NormalizedSplice.gapValueMk γ Z.target _ Mk' L γ' η base z.1 =
    NormalizedSplice.gapValueMk γ G σ Mk L γ' η base (gardenGenCast (unitSplice_garden_eqMk Z σ hT hsel) z).1
  refine (NormalizedSplice.unitSplice_actual_gapValueMk Z σ hT hsel hH hgS hgT hL γ' η base roots z).symm.trans ?_
  apply congrArg (NormalizedSplice.gapValueMk γ G σ Mk L γ' η base)
  funext n
  have he : unitSpliceNodeEquivMk γ Z σ hT hsel n = gardenNodeCast (unitSplice_garden_eqMk Z σ hT hsel).symm n :=
    Subtype.ext ((unitSpliceNodeEquiv_addressMk Z σ hT hsel n).trans (gardenNodeCast_val _ n).symm)
  exact (congrArg z.1 he).trans (gardenGenCast_val (unitSplice_garden_eqMk Z σ hT hsel) z n).symm

/-- B1b-3 (Mk-general form of `operation_gapProfile`). -/
theorem operation_gapProfileMk {p : ℕ} {kind : Bool} {ι : Type*} {A : FamilyReconstruction w ι} {i : ι}
    {σ : Prescription A.skeleton} {Mk : Set (CLVineG γ A.skeleton)} (hA : IsV0Fam γ A.family σ Mk)
    (op : FamilyOperation (p := p) (kind := kind) A i)
    {Mk' : Set (CLVineG γ op.output.skeleton)} (hT : Stage1Mk.MarkTransported γ (operationMolIso op) Mk Mk')
    (hgS : NormalizedSplice.GapValueSelDartsAt γ A.skeleton σ Mk)
    (hgT : NormalizedSplice.GapValueSelDartsAt γ op.output.skeleton (transportPrescription (operationMolIso op) σ) Mk') :
    gapProfileMk γ op.output.skeleton (transportPrescription (operationMolIso op) σ) Mk' = gapProfileMk γ A.skeleton σ Mk := by
  have hp := op.output.plain
  cases op with
  | mk hc he ht hq ε C =>
    cases ε
    · obtain rfl : Mk = Mk' := Stage1Mk.markTransported_refl_eq hT
      exact congrArg (fun τ => gapProfileMk γ A.skeleton τ Mk) (transportPrescription_refl σ)
    · exact gapProfile_twistMk (selectedMemberSite γ hA i) σ hT ⟨familyVine γ A.family i, hA.1 i, rfl⟩ hp hgS hgT


/-- The actual independently constructed successor gap profile. -/
noncomputable def gapProfile (γ : ℝ) [Fact (γ ≤ 1 / 2)] (G : Garden w) (σ : Prescription G) : GapProfile w :=
  ⟨(stSt γ G σ).G, fun _ L γ' η _ base _ z => NormalizedSplice.gapValue γ G σ L γ' η base z.1⟩


/-- Both actual operation choices preserve the constructed gap profile. -/
theorem operation_gapProfile {p : ℕ} {kind : Bool} {ι : Type*} {A : FamilyReconstruction w ι} {i : ι}
    {σ : Prescription A.skeleton} (hA : IsV0Fam γ A.family σ)
    (op : FamilyOperation (p := p) (kind := kind) A i) :
    gapProfile γ op.output.skeleton (transportPrescription (operationMolIso op) σ) = gapProfile γ A.skeleton σ :=
  operation_gapProfileMk hA op (Stage1Mk.markTransported_empty _)
    (NormalizedSplice.gapValueSelDartsAt_empty _ σ) (NormalizedSplice.gapValueSelDartsAt_empty _ _)

/-- Every actual fine batch preserves the complete independently chosen gap product. -/
theorem BatchIso.gapProfile {p : ℕ} {kind : Bool} {ι : Type*} {L : List ι}
    {A B : FamilyReconstruction w ι} {F : MolIso A.skeleton.molecule B.skeleton.molecule}
    (h : BatchIso p kind L A B F) (σ : Prescription A.skeleton) (hA : IsV0Fam γ A.family σ) :
    VineA.gapProfile γ B.skeleton (transportPrescription F σ) = VineA.gapProfile γ A.skeleton σ := by
  induction h with
  | nil => exact congrArg (VineA.gapProfile γ _) (transportPrescription_refl σ)
  | skip _ _ ih => exact ih σ hA
  | apply op _ ih =>
    have hb := ih _ (isV0Fam_operation hA op)
    rw [transportPrescription_trans] at hb
    exact hb.trans (operation_gapProfile hA op)

end WaveTurbulence.GammaLow.Fama.VineA
