  {blk : J → CLBlock S} {Gsb : Garden w}



/-- B1b (Mk-general form of `splice_labels_extend`). -/
theorem splice_labels_extendMk (hS : S.IsPlain) (σ : Prescription S) {L : ℝ} (hL : L ≠ 0)
    (base : Mom d) (roots : Fin w → (Fin d → ℤ)) {Mk : Set (CLVineG γ _)} (z : GenDecoration (stSt γ (Mk := Mk) S σ).G d roots 0) :
    ∃ κ : GenDecoration S d roots 0, ∀ y,
      bondIndex (stSt γ (Mk := Mk) S σ).G z.1 y = bondIndex S κ.1 ((stSt γ (Mk := Mk) S σ).M.od y) := by
  obtain ⟨κ, hk⟩ := exists_ext_of_shape (stShape γ (Mk := Mk) (Mole.garden_isMolecule S) σ) hS
    (unitBlkMk_disj (Mk := Mk) (Mole.garden_isMolecule S) σ) hL base roots z
  refine ⟨κ, ?_⟩
  intro y
  rw [← hk]
  exact bondIndex_stSt_odMk (Mk := Mk) (Mole.garden_isMolecule S) σ κ.1 y


end WaveTurbulence.GammaLow.Fama.VineA
