/-! Whole-support characterization for the R83 successor designation. -/
@[expose] public section
open WaveTurbulence.Induct WaveTurbulence.GammaLow.FinalCount
set_option autoImplicit false
set_option linter.unusedSectionVars false
namespace WaveTurbulence.GammaLow.Fama.VineA.NormalizedSplice
open WaveTurbulence.VineA.NormalizedSplice WaveTurbulence.GammaLow.FinalCount
open WaveTurbulence.VineA
open Stage1 RedSplice LGSpine.SourceVine WaveTurbulence.GammaLow.FinalCount
variable {w : ℕ} {G : Garden w} {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]

/-- All unchanged vine-like cases designate the entire group. -/
theorem isDesig_atoms_of_vineLikeGroup {S : Finset (GBranch G.tree)} {a : GBranch G.tree}
    {O : Src.Object γ G.molecule} (h : IsDesig γ G S a O) (hVL : VineLikeGroup γ G S) : O.atoms = S := by
  rcases hs : (groupUnitsOf γ G S).skip with _ | sk
  · by_cases hu : (groupUnitsOf γ G S).units = []
    · exact h.2.2.2.2.2.2.1 hs hu hVL
    · exact (h.2.2.2.2.1 hs hu).1
  · rcases hb : sk.bond with _ | e
    · exact (h.2.2.1 sk hs hb).1
    · exact (h.2.2.2.1 sk e hs hb).1

theorem designatedObject_atoms {S : Finset (GBranch G.tree)}
    (hS : S ∈ maximalGroupsG γ G.molecule) (hVL : VineLikeGroup γ G S) :
    ∃ O, designatedObject γ G S = some O ∧ O.atoms = S := by
  obtain ⟨a, O, _, hO, hd⟩ := designatedObject_spec hS
  exact ⟨O, hO, isDesig_atoms_of_vineLikeGroup hd hVL⟩

theorem designatedObject_ordinary {S : Finset (GBranch G.tree)}
    (hS : S ∈ maximalGroupsG γ G.molecule) {a b : GBranch G.tree} (hVC : Src.IsVC γ G.molecule S a b) :
    ∃ O, designatedObject γ G S = some O ∧ O.atoms = S ∧ objectHyperTag γ O = false := by
  obtain ⟨O, hO, ha⟩ := designatedObject_atoms hS ⟨a, b, Or.inr (Or.inl hVC)⟩
  exact ⟨O, hO, ha, object_tag_of_block O (ha.symm ▸ hVC.1)⟩

end WaveTurbulence.GammaLow.Fama.VineA.NormalizedSplice
