/-! Equality of the complete normalized candidate sets along an actual LF twist. -/
@[expose] public section
set_option autoImplicit false
set_option linter.unusedSectionVars false
namespace WaveTurbulence.GammaLow.Fama.VineA
open WaveTurbulence.VineA WaveTurbulence.GammaLow.FinalCount
open WaveTurbulence.RedSplice WaveTurbulence.Mole WaveTurbulence.Stage1 WaveTurbulence.GammaLow.FinalCount
variable {w : ℕ} {G : Garden w} {S : Finset (GBranch G.tree)} {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]
variable (Z : TwistGroupSite γ G) (hsel : ∃ c ∈ vinesV0 γ G (fun _ => .SG), c.atoms = Z.S0)
include hsel

/-- Normalized reversal commutes with the actual LF dart map. -/
theorem coarseDartTwist_mate (x : CoarseDart γ G) :
    coarseDartMate γ Z.target (coarseDartTwist γ Z hsel x) =
      coarseDartTwist γ Z hsel (coarseDartMate γ G x) := Subtype.ext (Z.iso.mate_comm x.1)

/-- Every valid HV candidate has exactly the same normalized key after LF. -/
theorem hvGroupKey_twist (hS : SingleHVGroup γ G S) (t : {t // HVCandidate γ G S t}) :
    hvGroupKey γ (hS.map Z.iso) (hvCandidateEquiv γ Z.iso S t) = hvGroupKey γ hS t := by
  have hd : hvCandidateDart γ (hS.map Z.iso) (hvCandidateEquiv γ Z.iso S t) =
      coarseDartTwist γ Z hsel (hvCandidateDart γ hS t) := Subtype.ext rfl
  unfold hvGroupKey
  rw [hd, coarseDartTwist_mate Z hsel, coarseDartWord_twist Z hsel, coarseDartWord_twist Z hsel]
  change [_, _, coarseAtomWord γ Z.target (Z.iso.e t.1.1),
    coarseAtomWord γ Z.target (Z.iso.e t.1.2.1), _] = _
  rw [coarseAtomWord_twist Z hsel, coarseAtomWord_twist Z hsel]


/-- Complete normalized support words agree under the actual atom map. -/
theorem coarseSupportWord_twist (A : Finset (GBranch G.tree)) :
    coarseSupportWord γ Z.target (Z.iso.img A) = coarseSupportWord γ G A := by
  classical
  apply congrArg (fun s : Finset (List ℕ) => s.sort (· ≤ ·))
  change (A.image Z.iso.e).image (coarseAtomWord γ Z.target) = A.image (coarseAtomWord γ G)
  rw [Finset.image_image]
  apply Finset.image_congr
  intro v _
  exact coarseAtomWord_twist Z hsel v

/-- Every DV constituent/joint key agrees after LF, with the whole support retained. -/
theorem dvGroupKey_twist (t : Finset (GBranch G.tree) × GBranch G.tree × GBranch G.tree) :
    dvGroupKey γ Z.target (dvTripleEquiv Z.iso t) = dvGroupKey γ G t := by
  change [coarseSupportWord γ Z.target (Z.iso.img t.1), [coarseAtomWord γ Z.target (Z.iso.e t.2.1)],
    [coarseAtomWord γ Z.target (Z.iso.e t.2.2)]] = _
  rw [coarseSupportWord_twist Z hsel, coarseAtomWord_twist Z hsel, coarseAtomWord_twist Z hsel]
  rfl


end WaveTurbulence.GammaLow.Fama.VineA
