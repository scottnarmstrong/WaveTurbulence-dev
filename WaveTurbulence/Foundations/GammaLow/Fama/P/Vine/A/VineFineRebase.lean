/-! A fine garden orbit can be rebased at every actual output, using its
prime skeleton and the transported prescription. -/
@[expose] public section
set_option autoImplicit false
set_option linter.unusedSectionVars false
namespace WaveTurbulence.GammaLow.Fama.VineA
open WaveTurbulence.VineA WaveTurbulence.GammaLow.FinalCount
open WaveTurbulence.Stage1 WaveTurbulence.RedSplice WaveTurbulence.LFTwist WaveTurbulence.GammaLow.FinalCount
open WaveTurbulence.Reg.Skeleton WaveTurbulence.GammaLow.FinalCount
variable {w p : ℕ} {kind : Bool} {ι : Type*} [Fintype ι] {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]


/-- B1b (R11): `fine_outputs_rebase` at marked sets carried by the batch (`MarkTransported`; the world's
`MarkInvariantBatchV`). -/
theorem fine_outputs_rebaseMk {L : List ι} {A B : FamilyReconstruction w ι}
    (h : FamilyBatch p kind L A B) (hL : L.Perm Finset.univ.toList)
    (hp : IsPrimeGarden A.skeleton) (σ : Prescription A.skeleton) {Mk : Set (CLVineG γ A.skeleton)}
    {Mk' : Set (CLVineG γ B.skeleton)} (hA : IsV0Fam γ A.family σ Mk)
    (hT : Stage1Mk.MarkTransported γ (batchMolIso h) Mk Mk') :
    A.allCoreOutputs (p := p) (kind := kind) =
      (PrimeData.fineState γ (⟨B.skeleton, batch_prime h hp, B.data, B.decodes⟩ : PrimeData B.layered)
        (transportPrescription (batchMolIso h) σ) Mk').allCoreOutputs (p := p) (kind := kind) := by
  have hB := BatchIso.selectedMk (batchMolIso_spec h) σ Mk Mk' hA hT
  obtain ⟨e, he⟩ := fineState_recoveryMk B (batch_prime h hp) _ hB
  have hproj := allCoreOutputs_reindex (p := p) (kind := kind)
    (PrimeData.fineState γ (⟨B.skeleton, batch_prime h hp, B.data, B.decodes⟩ : PrimeData B.layered)
      (transportPrescription (batchMolIso h) σ) Mk') e
  rw [he] at hproj
  exact (congruent_allCoreOutputs_eq ⟨L, hL, h⟩).trans hproj

end WaveTurbulence.GammaLow.Fama.VineA
