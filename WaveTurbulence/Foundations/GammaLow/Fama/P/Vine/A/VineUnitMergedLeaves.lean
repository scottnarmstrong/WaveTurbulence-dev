namespace WaveTurbulence.GammaLow.Fama.VineA
open WaveTurbulence.VineA WaveTurbulence.GammaLow.FinalCount
open WaveTurbulence.RedSplice WaveTurbulence.Stage1 WaveTurbulence.Twist WaveTurbulence.Mole WaveTurbulence.GammaLow.FinalCount
variable {w : ℕ} {G : Garden w} {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]

/-- B1b-2 (Mk-general form of `unitTwist_mergedLeaf_iff`). -/
theorem unitTwist_mergedLeaf_iffMk (Z : TwistGroupSite γ G) (σ : Prescription G)
    {Mk : Set (CLVineG γ G)} {Mk' : Set (CLVineG γ Z.target)} (hT : Stage1Mk.MarkTransported γ Z.iso Mk Mk')
    (hsel : ∃ c ∈ vinesV0 γ G σ Mk, c.atoms = Z.S0) (q : GLeaf G.tree) :
    MergedLeaf (spliceFold Z.target (unitBlocks γ Z.target (transportPrescription Z.iso σ) Mk')).cls
      (coreLeafEquiv G Z.P q) ↔ MergedLeaf (spliceFold G (unitBlocks γ G σ Mk)).cls q := by
  constructor
  · rintro ⟨lp', he, hd⟩
    let lp := (lpLeafEquiv G Z.P).symm lp'
    have hmap : lpLeafEquiv G Z.P lp = lp' := Equiv.apply_symm_apply _ _
    have hval : lp.1 = q := (coreLeafEquiv G Z.P).injective ((congrArg Subtype.val hmap).trans he)
    refine ⟨lp, hval, ?_⟩
    apply (naiveDart_deleted_iffMk Z σ hT hsel (.inr lp)).mp
    change DeletedDart _ (.inr (lpLeafEquiv G Z.P lp))
    rw [hmap]
    exact hd
  · rintro ⟨lp, he, hd⟩
    refine ⟨lpLeafEquiv G Z.P lp, congrArg (coreLeafEquiv G Z.P) he, ?_⟩
    exact (naiveDart_deleted_iffMk Z σ hT hsel (.inr lp)).mpr hd


/-- B1b-2 (Mk-general form of `unitTwist_splice_leaf_ranges`). -/
theorem unitTwist_splice_leaf_rangesMk (Z : TwistGroupSite γ G) (σ : Prescription G)
    {Mk : Set (CLVineG γ G)} {Mk' : Set (CLVineG γ Z.target)} (hT : Stage1Mk.MarkTransported γ Z.iso Mk Mk')
    (hsel : ∃ c ∈ vinesV0 γ G σ Mk, c.atoms = Z.S0) (q' : GLeaf Z.target.tree) :
    (∃ q, coreLeafEquiv G Z.P ((spliceFoldLeafTrace (unitBlocks γ G σ Mk)).leaf q) = q') ↔
      ∃ q, (spliceFoldLeafTrace (unitBlocks γ Z.target (transportPrescription Z.iso σ) Mk')).leaf q = q' := by
  obtain ⟨q, rfl⟩ := (coreLeafEquiv G Z.P).surjective q'
  have hleft : (∃ x, coreLeafEquiv G Z.P ((spliceFoldLeafTrace (unitBlocks γ G σ Mk)).leaf x) = coreLeafEquiv G Z.P q) ↔
      ∃ x, (spliceFoldLeafTrace (unitBlocks γ G σ Mk)).leaf x = q :=
    ⟨fun ⟨x, hx⟩ => ⟨x, (coreLeafEquiv G Z.P).injective hx⟩,
      fun ⟨x, hx⟩ => ⟨x, congrArg (coreLeafEquiv G Z.P) hx⟩⟩
  exact hleft.trans ((spliceFold_leaf_range (unitBlocks γ G σ Mk) q).trans
    ((not_congr (unitTwist_mergedLeaf_iffMk Z σ hT hsel q)).symm.trans
      (spliceFold_leaf_range (unitBlocks γ Z.target (transportPrescription Z.iso σ) Mk')
        (coreLeafEquiv G Z.P q)).symm))


end WaveTurbulence.GammaLow.Fama.VineA
