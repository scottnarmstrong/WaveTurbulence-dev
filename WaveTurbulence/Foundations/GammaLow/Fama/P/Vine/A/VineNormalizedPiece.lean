variable {R : ℕ} {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]

/-- **The Stage 1 piece of the original layered garden `LG` and the prescription `σ`.** -/
noncomputable def stage1PieceOf (γ : ℝ) [Fact (γ ≤ 1 / 2)] (d : ℕ) {S : Garden (2 * R)} {D : ReconstructionData S}
    (hS : S.IsPlain) (LG : LayeredGarden (2 * R)) (hd : D.Decodes hS LG.garden) (σ : Prescription S)
    (Mk : Set (CLVineG γ S) := ∅) : Stage1PieceGD γ d R where
  Gsb := (stSt γ S σ Mk).G
  Cs := collectionChoices γ S σ Mk
  ladders := ladderDataOf (stSt γ S σ Mk).G
  layer := (stSt γ S σ Mk).layer (RegRed.coreLayer LG D hS hd)
  gapSpecification := gapSpecificationMk γ S σ Mk
  gsk := gskOf γ (gregOf D hS LG) S σ (RegRed.coreLayer LG D hS hd) Mk
  bsk := bskOf γ S σ Mk


end WaveTurbulence.GammaLow.Fama.VineA.NormalizedSplice
