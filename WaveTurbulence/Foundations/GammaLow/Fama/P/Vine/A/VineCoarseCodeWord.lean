/-! Fixed-carrier encoding of the exact quotient support qG[S]. -/
@[expose] public section
set_option autoImplicit false
set_option linter.unusedSectionVars false
namespace WaveTurbulence.GammaLow.Fama.VineA
open WaveTurbulence.VineA WaveTurbulence.GammaLow.FinalCount
open Stage1 RedSplice Represents WaveTurbulence.GammaLow.FinalCount
variable {w : ℕ} {G H : Garden w} {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]

/-- The entire quotient support, encoded by its literal ordered addresses. -/
noncomputable def wordGroupCode (γ : ℝ) [Fact (γ ≤ 1 / 2)] (G : Garden w) (S : {S // S ∈ maximalGroupsG γ G.molecule}) :
    Finset (List ℕ) := by
  classical
  exact S.1.image (coarseAtomWord γ G)

/-- This is an injective address encoding of codeG(S) = qG[S]. -/
theorem wordGroupCode_eq (S : {S // S ∈ maximalGroupsG γ G.molecule}) :
    wordGroupCode γ G S = (coarseGroupCode γ G S).image (fun a => addressWord a.1) := by
  classical
  simp only [wordGroupCode, coarseGroupCode, Finset.image_image]
  rfl

theorem wordGroupCode_injective (G : Garden w) : Function.Injective (wordGroupCode γ G) := by
  classical
  intro S T h
  apply coarseGroupCode_injective G
  rw [wordGroupCode_eq, wordGroupCode_eq] at h
  exact Finset.image_injective (fun a b he => Subtype.ext (addressWord_injective he)) h

/-- The fixed-carrier group code γ commutes with any proved atom-word diagram. -/
theorem wordGroupCode_map (F : MolIso G.molecule H.molecule)
    (hd : ∀ v, coarseAtomWord γ H (F.e v) = coarseAtomWord γ G v)
    (S : {S // S ∈ maximalGroupsG γ G.molecule}) :
    wordGroupCode γ H (groupEquiv γ F S) = wordGroupCode γ G S := by
  classical
  change (S.1.image F.e).image (coarseAtomWord γ H) = S.1.image (coarseAtomWord γ G)
  rw [Finset.image_image]
  exact Finset.image_congr fun v _ => hd v

/-- A prescription as its graph on exact normalized support codes. -/
def codedPrescription (γ : ℝ) [Fact (γ ≤ 1 / 2)] (G : Garden w) (σ : GroupPrescription γ G) : Set (Finset (List ℕ) × Molecule.GapKind) :=
  Set.range (fun S => (wordGroupCode γ G S, σ S))

/-- No local colors are identified or discarded by the code. -/
theorem codedPrescription_injective (G : Garden w) : Function.Injective (codedPrescription γ G) := by
  intro σ τ h
  funext S
  have hm : (wordGroupCode γ G S, σ S) ∈ codedPrescription γ G τ := h ▸ ⟨S, rfl⟩
  obtain ⟨T, he⟩ := hm
  have ht : T = S := wordGroupCode_injective G (congrArg Prod.fst he)
  subst T
  exact (congrArg Prod.snd he).symm

/-- Transport preserves the complete graph of group colors whenever the actual words commute. -/
theorem codedPrescription_map (F : MolIso G.molecule H.molecule)
    (hd : ∀ v, coarseAtomWord γ H (F.e v) = coarseAtomWord γ G v) (σ : GroupPrescription γ G) :
    codedPrescription γ H (transportGroupPrescription γ F σ) = codedPrescription γ G σ := by
  ext t
  constructor
  · rintro ⟨T, rfl⟩
    obtain ⟨S, rfl⟩ := (groupEquiv γ F).surjective T
    exact ⟨S, Prod.ext (wordGroupCode_map F hd S).symm (transportGroupPrescription_apply F σ S).symm⟩
  · rintro ⟨S, rfl⟩
    exact ⟨groupEquiv γ F S, Prod.ext (wordGroupCode_map F hd S) (transportGroupPrescription_apply F σ S)⟩

end WaveTurbulence.GammaLow.Fama.VineA
