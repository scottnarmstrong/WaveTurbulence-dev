/-! The actual unit lists agree up to permutation after atom transport.
No order compatibility of independent finite-list choices is assumed. -/
@[expose] public section
set_option autoImplicit false
set_option linter.unusedSectionVars false
namespace WaveTurbulence.GammaLow.Fama.VineA
open WaveTurbulence.VineA WaveTurbulence.GammaLow.FinalCount
open Finset WaveTurbulence.RedSplice WaveTurbulence.Stage1 WaveTurbulence.GammaLow.FinalCount
variable {w : ℕ} {G : Garden w} {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]

/-- B1b (Mk-general form of `unitBlocks_nodup`). -/
theorem unitBlocks_nodupMk (σ : Prescription G) {Mk : Set (CLVineG γ _)} : (unitBlocks γ (Mk := Mk) G σ).Nodup := by
  apply (unitBlocks_pairwiseMk (Mk := Mk) (Mole.garden_isMolecule G) σ).imp
  intro u v hd he
  subst v
  exact (disjoint_left.mp hd u.isBlock.2.1) u.isBlock.2.1

/-- Actual units occur without repetitions, since every unit is nonempty. -/
theorem unitBlocks_nodup (σ : Prescription G) : (unitBlocks γ G σ).Nodup := unitBlocks_nodupMk (Mk := (∅ : Set (CLVineG γ _))) σ

/-- B1b-2 (Mk-general form of `unitBlocks_image_perm`, two marked sets carried by the twist). -/
theorem unitBlocks_image_permMk (Z : TwistGroupSite γ G) (σ : Prescription G) {Mk : Set (CLVineG γ G)}
    {Mk' : Set (CLVineG γ Z.target)} (hT : Stage1Mk.MarkTransported γ Z.iso Mk Mk')
    (hsel : ∃ c ∈ vinesV0 γ G σ Mk, c.atoms = Z.S0) :
    ((unitBlocks γ G σ Mk).map (fun u => Z.iso.img u.atoms)).Perm
      ((unitBlocks γ Z.target (transportPrescription Z.iso σ) Mk').map CLBlock.atoms) := by
  apply (List.perm_ext_iff_of_nodup
    ((unitBlocks_nodupMk σ (Mk := Mk)).map (fun _ _ h => Famc.VineA.clBlock_eq_of_atoms (Z.iso.img_injective h)))
    ((unitBlocks_nodupMk (transportPrescription Z.iso σ) (Mk := Mk')).map
      (fun _ _ h => Famc.VineA.clBlock_eq_of_atoms h))).mpr
  intro A
  constructor
  · intro h
    obtain ⟨u, hu, rfl⟩ := List.mem_map.mp h
    exact List.mem_map.mpr ⟨Famc.VineA.unitImage γ Z u (Famc.VineA.unitBlocks_goodMk Z σ hsel hu), unitImage_memMk Z σ hT hsel hu, rfl⟩
  · intro h
    obtain ⟨v, hv, rfl⟩ := List.mem_map.mp h
    obtain ⟨u, hu, he, _, _⟩ := unitBlocks_preimageMk Z σ hT hsel hv
    exact List.mem_map.mpr ⟨u, hu, he.symm⟩


end WaveTurbulence.GammaLow.Fama.VineA
