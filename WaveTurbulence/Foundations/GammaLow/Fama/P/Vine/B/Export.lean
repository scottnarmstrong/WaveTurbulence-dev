/-!
# VINE-B♯: the export for `G_sb = (stSt γ S σ).G` (S2's `hval`, `src`, `src_dart`, `src_root`)
-/

@[expose] public section
set_option autoImplicit false
open WaveTurbulence.Induct WaveTurbulence.GammaLow.FinalCount
open WaveTurbulence.VineParamContract WaveTurbulence.GammaLow.FinalCount
set_option linter.unusedSectionVars false
namespace WaveTurbulence.GammaLow.Fama
open WaveTurbulence.VineB WaveTurbulence.GammaLow.FinalCount
open TTree WaveTurbulence.RegRed WaveTurbulence.RedSplice Finset WaveTurbulence.Represents WaveTurbulence.GammaLow.FinalCount
  WaveTurbulence.Reg.Skeleton WaveTurbulence.LGSpine WaveTurbulence.RegRedLeaf WaveTurbulence.VineEstS3.FS
  WaveTurbulence.VineEstS5C.Cont WaveTurbulence.VineEstS4 WaveTurbulence.VineEstS5C MeasureTheory

variable {w d : ℕ} {S : Garden w} {γ : ℝ} [Fact TVineF1Input] [Fact VinechainlemPrimeInput] [Fact (γ ≤ 1 / 2)] [Fact TVineIsoInvariant]


/-- B1a: `stSt_hinges_mem` for every marked vine set. -/
theorem stSt_hinges_memMk (hM : S.molecule.IsMolecule) (σ : Prescription S) (Mk : Set (CLVineG γ S))
    (c : GBranch (stSt γ S σ Mk).G.tree) :
    c ∈ (stSt γ S σ Mk).hinges ↔ c ∈ (stShape γ hM σ Mk).hinges (unitBlkMk_disj hM σ Mk) := by
  rw [stShape_hingesMk]

/-- **G3.** The hinge dart (or root) giving the momentum of `hmom j i`, for the units of `σ`.  B1a: for the marked
vine set `Mk`, inferred from `hSb`. -/
noncomputable def stSrc (γ : ℝ) [Fact (γ ≤ 1 / 2)] (hM : S.molecule.IsMolecule) (σ : Prescription S) {Mk : Set (CLVineG γ S)}
    (hSb : (stSt γ S σ Mk).G.IsPlain) (j : Fin (unitBlocks γ S σ Mk).length) (i : Fin 4) :
    HingeDarts (stSt γ S σ Mk).G (stSt γ S σ Mk).hinges ⊕ Fin w :=
  (stShape γ hM σ Mk).src (unitBlkMk_disj hM σ Mk) hSb (stSt γ S σ Mk).hinges (stSt_hinges_memMk hM σ Mk) j i

/-- B1b (Mk-general form of `stSrc_dart`). -/
theorem stSrc_dartMk (hM : S.molecule.IsMolecule) (σ : Prescription S) {Mk : Set (CLVineG γ _)} (hSb : (stSt γ (Mk := Mk) S σ).G.IsPlain)
    (j : Fin (unitBlocks γ (Mk := Mk) S σ).length) (i : Fin 4) (x : HingeDarts (stSt γ (Mk := Mk) S σ).G (stSt γ (Mk := Mk) S σ).hinges)
    (hx : stSrc γ hM σ hSb j i = Sum.inl x) (roots : Fin w → (Fin d → ℤ))
    (z : GenDecoration (stSt γ (Mk := Mk) S σ).G d roots 0) :
    bondIndex (stSt γ (Mk := Mk) S σ).G z.1 x.1 = z.1 ((stShape γ (Mk := Mk) hM σ).hmom (unitBlkMk_disj (Mk := Mk) hM σ) j i) :=
  (stShape γ (Mk := Mk) hM σ).src_dart (unitBlkMk_disj (Mk := Mk) hM σ) hSb _ (stSt_hinges_memMk (Mk := Mk) hM σ) j i x hx d roots z

theorem stSrc_dart (hM : S.molecule.IsMolecule) (σ : Prescription S) (hSb : (stSt γ S σ).G.IsPlain)
    (j : Fin (unitBlocks γ S σ).length) (i : Fin 4) (x : HingeDarts (stSt γ S σ).G (stSt γ S σ).hinges)
    (hx : stSrc γ hM σ hSb j i = Sum.inl x) (roots : Fin w → (Fin d → ℤ))
    (z : GenDecoration (stSt γ S σ).G d roots 0) :
    bondIndex (stSt γ S σ).G z.1 x.1 = z.1 ((stShape γ hM σ).hmom (unitBlk_disj hM σ) j i) := stSrc_dartMk (Mk := ∅) hM σ hSb j i x hx roots z

/-- B1b (Mk-general form of `stSrc_root`). -/
theorem stSrc_rootMk (hM : S.molecule.IsMolecule) (σ : Prescription S) {Mk : Set (CLVineG γ _)} (hSb : (stSt γ (Mk := Mk) S σ).G.IsPlain)
    (j : Fin (unitBlocks γ (Mk := Mk) S σ).length) (i : Fin 4) (r : Fin w)
    (hr : stSrc γ hM σ hSb j i = Sum.inr r) (roots : Fin w → (Fin d → ℤ))
    (z : GenDecoration (stSt γ (Mk := Mk) S σ).G d roots 0) :
    z.1 ((stShape γ (Mk := Mk) hM σ).hmom (unitBlkMk_disj (Mk := Mk) hM σ) j i) = roots r :=
  (stShape γ (Mk := Mk) hM σ).src_root (unitBlkMk_disj (Mk := Mk) hM σ) hSb _ (stSt_hinges_memMk (Mk := Mk) hM σ) j i r hr d roots z

theorem stSrc_root (hM : S.molecule.IsMolecule) (σ : Prescription S) (hSb : (stSt γ S σ).G.IsPlain)
    (j : Fin (unitBlocks γ S σ).length) (i : Fin 4) (r : Fin w)
    (hr : stSrc γ hM σ hSb j i = Sum.inr r) (roots : Fin w → (Fin d → ℤ))
    (z : GenDecoration (stSt γ S σ).G d roots 0) :
    z.1 ((stShape γ hM σ).hmom (unitBlk_disj hM σ) j i) = roots r := stSrc_rootMk (Mk := ∅) hM σ hSb j i r hr roots z


end WaveTurbulence.GammaLow.Fama
