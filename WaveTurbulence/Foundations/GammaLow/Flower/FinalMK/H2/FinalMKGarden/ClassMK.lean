  · rintro κ' ⟨κ, ⟨hκ, -⟩, rfl⟩
    exact h0_unloop hD.hSL (hD.hmate κ hκ) (hD.h0 κ hκ)
  · rintro k0 ⟨κ, ⟨hκ, hcl⟩, rfl⟩ v hv hvZ x y hx hy
    exact kvec_injective hL0 0 κ (((hcl.1 v hv).2 hvZ).1 x.1 y.1 hx hy)
  · rintro k0 ⟨κ, ⟨hκ, -⟩, rfl⟩ x
