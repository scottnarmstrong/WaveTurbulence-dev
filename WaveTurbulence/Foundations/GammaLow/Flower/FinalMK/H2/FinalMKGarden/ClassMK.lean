      survFst := ?_
      hostConnFLE := ?_ }
  · intro a ha
    obtain ⟨c, hc⟩ := hD.pin a ha
    refine ⟨c, fun k0 hk0 => ?_⟩
    obtain ⟨κ, ⟨hκ, -⟩, rfl⟩ := hk0
    unfold chargeAt
    rw [sum_unloop_kvec M (hD.hmate κ hκ) a]
