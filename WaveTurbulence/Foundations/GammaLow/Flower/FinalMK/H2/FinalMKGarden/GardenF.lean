section loops
variable {R d : ℕ} {G : Garden (2 * R)}
variable {D : SplicedKernelData G d} {C : Src.CountingChoices Src.γL G d} {L γ η : ℝ} {base : Mom d}
  {roots : Fin (2 * R) → (Fin d → ℤ)} {κ : GardenDart G → (Fin d → ℤ)}

theorem garden_loop_heq_z (hg : Src.CountingGeometry G C) (hD : D.hinges = C.subpro.hinges)
    (hA : ∃ z : GenDecoration G d roots 0, (∀ x, bondIndex G z.1 x = κ x) ∧ splicedEpsilon G D.hinges z.1 ≠ 0 ∧
      splicedGapIndicator G D L γ η base z.1 ≠ 0) :
    ∀ y : GardenDart G, G.molecule.atom y = G.molecule.atom (G.molecule.mate y) →
      ∀ x : GardenDart G, G.molecule.atom x = G.molecule.atom y → κ x = κ y := by
  obtain ⟨z, hz, hε, -⟩ := hA
  intro y hy x hx
  rcases y with ⟨c, b⟩ | ℓ
  · exact absurd hy (inl_dart_nonloop c b)
  obtain ⟨hk, hvz⟩ := FinalCount.H.loop_values hg hD hε ℓ hy
  set v := G.molecule.atom (Sum.inr ℓ) with hv
  rw [← hz x, ← hz (Sum.inr ℓ)]
  rcases x with ⟨c, b⟩ | ℓ'
  · cases b
    · have : c.1 = v := hx
      show z.1 c.1.toNode = z.1 ℓ.1.toNode
      rw [this]; exact hvz
    · have hx' : GNode.parent c.1.toNode c.2 = v := hx
      obtain ⟨k, hk'⟩ := node_eq_child (G := G) c.2 hx'
      show z.1 c.1.toNode = z.1 ℓ.1.toNode
      rw [hk']; exact hk k
  · have hx' : GNode.parent ℓ'.1.toNode ℓ'.2.2.1 = v := hx
    obtain ⟨k, hk'⟩ := node_eq_child (G := G) ℓ'.2.2.1 hx'
    show z.1 ℓ'.1.toNode = z.1 ℓ.1.toNode
    rw [hk']; exact hk k

/-- **`hdet`**: two admissible decorations that agree off the loop darts are equal. -/
theorem garden_loop_det_z (hp : G.IsPlain) (hg : Src.CountingGeometry G C) (hD : D.hinges = C.subpro.hinges)
    {κ₁ κ₂ : GardenDart G → (Fin d → ℤ)}
    (hA₁ : ∃ z : GenDecoration G d roots 0, (∀ x, bondIndex G z.1 x = κ₁ x) ∧ splicedEpsilon G D.hinges z.1 ≠ 0 ∧
      splicedGapIndicator G D L γ η base z.1 ≠ 0)
    (hA₂ : ∃ z : GenDecoration G d roots 0, (∀ x, bondIndex G z.1 x = κ₂ x) ∧ splicedEpsilon G D.hinges z.1 ≠ 0 ∧
      splicedGapIndicator G D L γ η base z.1 ≠ 0)
    (h : ∀ x : GardenDart G, G.molecule.atom x ≠ G.molecule.atom (G.molecule.mate x) → κ₁ x = κ₂ x) : κ₁ = κ₂ := by
  obtain ⟨z₁, hz₁, hε₁, -⟩ := hA₁
  obtain ⟨z₂, hz₂, hε₂, -⟩ := hA₂
  funext x
  by_cases hx : G.molecule.atom x ≠ G.molecule.atom (G.molecule.mate x)
  · exact h x hx
  push Not at hx
  rcases x with ⟨c, b⟩ | ℓ
  · exact absurd hx (inl_dart_nonloop c b)
  obtain ⟨hk₁, hvz₁⟩ := FinalCount.H.loop_values hg hD hε₁ ℓ hx
  obtain ⟨hk₂, hvz₂⟩ := FinalCount.H.loop_values hg hD hε₂ ℓ hx
  obtain ⟨i, j, hij, hi, hj, hs⟩ := loop_inr_struct ℓ hx
  set v := G.molecule.atom (Sum.inr ℓ) with hv
  -- the third child
  obtain ⟨k, hki, hkj⟩ := exists_third i j
  rw [← hz₁, ← hz₂]
  show z₁.1 ℓ.1.toNode = z₂.1 ℓ.1.toNode
  rw [← hk₁ k, ← hk₂ k]
  -- the node `v.child k` has equal values in both decorations
  have hnr : (v.child k).1.2 ≠ [] := by simp [GBranch.child]
  have hpar : GNode.parent (v.child k) hnr = v := parent_child' v k hnr
  rcases (TTree.mem_nodes_iff _ _).1 (v.child k).2 with hleaf | hbr
  · -- a leaf
    let l : GLeaf G.tree := ⟨(v.child k).1, hleaf⟩
    have hlm : G.mark l = none := hp l
    have hln : l.toNode = v.child k := rfl
    by_cases hpr : (G.pair l).1.2 = []
    · -- the partner is a root leaf: both decorations have the root value
      have e1 : z₁.1 l.toNode = z₁.1 (G.pair l).toNode := z₁.2.1.2 l
      have e2 : z₂.1 l.toNode = z₂.1 (G.pair l).toNode := z₂.2.1.2 l
      have hroot : (G.pair l).toNode = GNode.root G.tree (G.pair l).1.1 := by
        apply Subtype.ext
        change (G.pair l).1 = ((G.pair l).1.1, [])
        exact Prod.ext rfl hpr
      rw [hln] at e1 e2
      rw [e1, e2, hroot, z₁.2.2.1, z₂.2.2.1]
    · -- the dart `.inr l` exists and is not a loop
      let y : GardenDart G := Sum.inr ⟨l, hlm, hnr, hpr⟩
      have hynl : G.molecule.atom y ≠ G.molecule.atom (G.molecule.mate y) := by
        intro hyl
        obtain ⟨i', j', hij', hi', hj', hs'⟩ := loop_inr_struct ⟨l, hlm, hnr, hpr⟩ hyl
        have hav : G.molecule.atom y = v := hpar
        rw [hav] at hi' hj'
        have hik : i' = k := (child_injective G v) hi'.symm
        have hjk : j' ≠ k := fun e => hij' (hik.trans e.symm)
        have hpl : G.pair l ≠ l := fun e => ((G.pair_eq_iff l).1 e) hlm
        rcases fin3_other i j k j' hij hki hkj hjk with e | e
        · rw [e] at hj'
          have h1 : G.pair l = ℓ.1 := Mole.leaf_toNode_injective (hj'.trans hi.symm)
          have h2 : l = G.pair ℓ.1 := by rw [← h1, G.pair_pair]
          have h3 : l.toNode = v.child j := by rw [h2]; exact hj
          exact hkj ((child_injective G v) (hln.symm.trans h3).symm).symm
        · rw [e] at hj'
          have h1 : G.pair l = G.pair ℓ.1 := Mole.leaf_toNode_injective (hj'.trans hj.symm)
          have h2 : l = ℓ.1 := by
            have := congrArg G.pair h1
            rwa [G.pair_pair, G.pair_pair] at this
          have h3 : l.toNode = v.child i := by rw [h2]; exact hi
          exact hki ((child_injective G v) (hln.symm.trans h3).symm).symm
      have := h y hynl
      rw [← hz₁ y, ← hz₂ y] at this
      exact this
  · let c : {c : GBranch G.tree // c.1.2 ≠ []} := ⟨⟨(v.child k).1, hbr⟩, hnr⟩
    have := h (Sum.inl (c, true)) (inl_dart_nonloop c true)
    rw [← hz₁, ← hz₂] at this
    exact this


/-- `gdec` from the decoration part of the admissibility. -/
theorem gdec_z (hp : G.IsPlain) (hL : L ≠ 0)
    (h : ∃ z : GenDecoration G d roots 0, (∀ x, bondIndex G z.1 x = κ x) ∧ splicedEpsilon G D.hinges z.1 ≠ 0 ∧
      splicedGapIndicator G D L γ η base z.1 ≠ 0) :
    ∃ c, G.molecule.IsDecoration L base c κ ∧ ∀ v ∈ G.molecule.atoms, G.molecule.deg v = 4 → c v = 0 := by
  obtain ⟨z, hz, -, -⟩ := h
  have e : bondIndex G z.1 = κ := funext hz
  refine ⟨_, e ▸ spliced_molecule_decoration G hp hL base roots z, fun v _ hd => ?_⟩
  exact gardenSource_eq_zero_of_deg_four G hp _ v hd

end loops

section inl
variable {R d : ℕ} {G : Garden (2 * R)}
variable {D : SplicedKernelData G d} {C : Src.CountingChoices Src.γL G d} {S : SurvivorDataG Src.γL G} {L γ η : ℝ} {base : Mom d}
  {roots : Fin (2 * R) → (Fin d → ℤ)}

theorem inl_loop_heqMK (hg : Src.CountingGeometry G C) (hD : D.hinges = C.subpro.hinges) {κ : GardenDart G → (Fin d → ℤ)}
    (hA : splicedCountingAdmissibleMKG G D C S L γ η base roots κ) :
    ∀ y : GardenDart G, (inlMol G.molecule).atom y = (inlMol G.molecule).atom ((inlMol G.molecule).mate y) →
      ∀ x : GardenDart G, (inlMol G.molecule).atom x = (inlMol G.molecule).atom y → κ x = κ y := by
  intro y hy x hx
  simp only [mapAtoms_atom, mapAtoms_mate, inlEmb_apply, Sum.inl.injEq] at hy hx
  exact garden_loop_heq_z hg hD hA.1 y hy x hx

theorem inl_loop_detMK (hp : G.IsPlain) (hg : Src.CountingGeometry G C) (hD : D.hinges = C.subpro.hinges)
    {Adm : (GardenDart G → (Fin d → ℤ)) → Prop}
    (hA : ∀ κ, Adm κ → splicedCountingAdmissibleMKG G D C S L γ η base roots κ) :
    ∀ κ₁ κ₂, Adm κ₁ → Adm κ₂ →
      (∀ x : GardenDart G, (inlMol G.molecule).atom x ≠ (inlMol G.molecule).atom ((inlMol G.molecule).mate x) →
        κ₁ x = κ₂ x) → κ₁ = κ₂ := by
  intro κ₁ κ₂ h1 h2 h
  refine garden_loop_det_z hp hg hD (hA κ₁ h1).1 (hA κ₂ h2).1 fun x hx => h x ?_
  simpa only [mapAtoms_atom, mapAtoms_mate, inlEmb_apply, ne_eq, Sum.inl.injEq] using hx

end inl

section garden
variable {R d : ℕ} {G : Garden (2 * R)}

/-- The survivor atoms of the garden. -/
noncomputable def survAtomsG (S : SurvivorDataG Src.γL G) : Finset (GBranch G.tree) :=
  Finset.univ.biUnion fun i => (S.surv i).atoms

/-- **The garden pool carrier**: main's `gCol C` with the survivor atoms added to the hinge set (pool only). -/
noncomputable def gColF (C : Src.CountingChoices Src.γL G d) (S : SurvivorDataG Src.γL G) : FinalCount.H.CollData G.molecule :=
  { FinalCount.H.gCol C with hinges := C.subpro.hinges ∪ survAtomsG S }

theorem forbiddenOf_gColF (C : Src.CountingChoices Src.γL G d) (S : SurvivorDataG Src.γL G) :
    FinalCount.H.forbiddenOf (gColF C S) = forbiddenMKG C.subpro S := by
  ext v
  simp only [FinalCount.H.forbiddenOf, forbiddenMKG, Src.SubproChoices.forbidden, gColF, FinalCount.H.gCol, FinalCount.H.collDataOf, survAtomsG,
    Set.mem_union, Set.mem_iUnion, Finset.mem_coe, Finset.mem_union, Finset.mem_biUnion, Finset.mem_univ, true_and]
  tauto

/-- The omitted vines of the MK pool, at base `0`. -/
abbrev unGF (C : Src.CountingChoices Src.γL G d) (S : SurvivorDataG Src.γL G) (L γ η : ℝ) (κ : GardenDart G → (Fin d → ℤ)) :
    Set (Src.Object Src.γL G.molecule) :=
  FinalCount.H.unselOf (gColF C S) L γ η 0 κ C.omittedDVConstituents

variable {C : Src.CountingChoices Src.γL G d} {S : SurvivorDataG Src.γL G} {L γ η : ℝ} {base : Mom d} {κ : GardenDart G → (Fin d → ℤ)}

theorem unselOK_GF (hadm : AdmissibleMKG C S L γ η base κ) : (gColF C S).UnselOK L γ η 0 κ (unGF C S L γ η κ) := by
  obtain ⟨rk, -, K, hK, -⟩ := hadm.2.1
  rw [← forbiddenOf_gColF] at hK
  have h := FinalCount.H.unselOK_of_second8 (Mole.garden_isMolecule G) (gColF C S) (L := L) (γ := γ) (η := η) (base := base)
    (omitted := C.omittedDVConstituents) hK
  rw [FinalCount.H.unselOf_base_eq (gColF C S) L γ η base 0 κ, FinalCount.H.unselOK_base_iff (gColF C S) L γ η base 0 κ] at h
  exact h

theorem c2OfF_G_base {U : Src.Object Src.γL G.molecule} (hU : U ∈ (gColF C S).C2Of L γ η 0 κ (unGF C S L γ η κ)) :
    U ∈ (gColF C S).C2Of L γ η base κ (FinalCount.H.unselOf (gColF C S) L γ η base κ C.omittedDVConstituents) := by
  rw [FinalCount.H.c2Of_base_eq (gColF C S) L γ η base 0 κ, FinalCount.H.unselOf_base_eq (gColF C S) L γ η base 0 κ]
  exact hU

theorem hd22_GF {c : GBranch G.tree → Mom d} (hκ : G.molecule.IsDecoration L base c κ)
    (hc : ∀ v ∈ G.molecule.atoms, G.molecule.deg v = 4 → c v = 0) (hadm : AdmissibleMKG C S L γ η base κ)
    {U U' : Src.Object Src.γL G.molecule} (hU : U ∈ (gColF C S).C2Of L γ η 0 κ (unGF C S L γ η κ))
    (hU' : U' ∈ (gColF C S).C2Of L γ η 0 κ (unGF C S L γ η κ)) : U.atoms = U'.atoms ∨ Disjoint U.atoms U'.atoms := by
  obtain ⟨rk, -, K, hK, -⟩ := hadm.2.1
  rw [← forbiddenOf_gColF] at hK
  exact FinalCount.H.c2Of_atoms_eq_or_disjoint (Mole.garden_isMolecule G) hκ hc (gColF C S) hK (c2OfF_G_base hU)
    (c2OfF_G_base hU')

end garden

/-! ### The shape of `C₂` members from the pool's own host (no support structure) -/

section shape
variable {w d : ℕ}

/-- **`step1_vc_shape'` from the host** (main's version reads `SubproSupportA` only through `contained`, to get this
host). -/
theorem step1_vc_shape_host (G : Garden w) (C : FinalCount.H.CollData G.molecule) {L γ η : ℝ} {base : Mom d}
    {κ : GardenDart G → (Fin d → ℤ)} (c : GBranch G.tree → Mom d) (hκ : G.molecule.IsDecoration L base c κ)
    (hc : ∀ v ∈ G.molecule.atoms, G.molecule.deg v = 4 → c v = 0)
    (P : Src.Object Src.γL G.molecule) (hP : P.HasGapKind L γ η base κ .SG) (hhost : C.Host L γ η base κ P)
    (hvc : ∃ h, P.shape = Src.VineLikeObject.vc h) :
    Vine.DoubleChain G.molecule P.atoms P.upper P.lower 1 ∨ Vine.DoubleChain G.molecule P.atoms P.upper P.lower 2 ∨
      G.molecule.IsTVine P.atoms P.upper P.lower := by
  have hcls : Vine.DoubleChain G.molecule P.atoms P.upper P.lower 1 ∨
      Vine.DoubleChain G.molecule P.atoms P.upper P.lower 2 ∨ G.molecule.IsTVine P.atoms P.upper P.lower ∨
      ∃ e, G.molecule.ends e = s(P.upper, P.lower) ∧
        (Vine.DoubleChain (Mole.eraseBond G.molecule e) P.atoms P.upper P.lower 2 ∨
          (Mole.eraseBond G.molecule e).IsTVine P.atoms P.upper P.lower) := by
    obtain ⟨r', hr', hk'⟩ := hP
    have hG := WaveTurbulence.Mole.garden_isMolecule G
    have hrP := (P.shape.toVine_isGap L base κ r').mpr hr'
    rcases hhost with ⟨S, a, b, hDV, hPS, -, -⟩ | ⟨Q, hPQ, hQk, -, -⟩
    · exact FinalCount.H.subsetvc_classification G.molecule hG P.shape.toVine hPS L γ η base c κ hκ hc hrP hk' (Or.inl hDV)
    · obtain ⟨r, hr, hkr⟩ : ∃ r, Q.shape.IsGap L base κ r ∧
          (Molecule.gapKind L γ η r = .LG ∨ Molecule.gapKind L γ η r = .ZG) := by
        rcases hQk with ⟨r, hr, hk⟩ | ⟨r, hr, hk⟩
        · exact ⟨r, hr, Or.inl hk⟩
        · exact ⟨r, hr, Or.inr hk⟩
      obtain ⟨h, hs'⟩ := hvc
      have hcont : P.shape.IsContained Q.shape := by
        rw [hs']
        exact hPQ
      exact FinalCount.H.subsetvc_classification G.molecule hG P.shape.toVine hPQ L γ η base c κ hκ hc hrP hk'
        (Or.inr ⟨Q.shape.toVine, (P.shape.toVine_isContained Q.shape).mpr hcont,
          r, (Q.shape.toVine_isGap L base _ r).mpr hr, hkr⟩)
  rcases hcls with h | h | h | ⟨e, he, h⟩
  · exact Or.inl h
  · exact Or.inr (Or.inl h)
  · exact Or.inr (Or.inr h)
  · exfalso
    have hB := FinalCount.H.object_vc_block P hvc
    have hlt := Subpro.eraseBond_degIn_lt_two_of_block hB he
    rcases h with h | h
    · exact absurd (Subpro.doubleChain_two_le_degIn h) (by omega)
    · exact absurd (Mole.block_joint_degrees _ h.1).1 (by omega)

/-- **`c2_shape` for any pool carrier** (main's `c2_shape` with the host of the pool instead of `Src.SubproSupport`). -/
theorem c2_shape_host {G : Garden w} (C : FinalCount.H.CollData G.molecule) {L γ η : ℝ} {base : Mom d}
    {κ : GardenDart G → (Fin d → ℤ)} {c : GBranch G.tree → Mom d} (hκ : G.molecule.IsDecoration L base c κ)
    (hc : ∀ v ∈ G.molecule.atoms, G.molecule.deg v = 4 → c v = 0)
    {Un : Set (Src.Object Src.γL G.molecule)} {U : Src.Object Src.γL G.molecule} (hU : U ∈ C.C2Of L γ η base κ Un) :
    U.atoms.card = 3 ∨ FinalCount.H.ObjVine G.molecule U := by
  have hM := Mole.garden_isMolecule G
  obtain ⟨⟨⟨hsg, -, -, hhost⟩, -⟩, -⟩ := hU
  rcases FinalCount.H.object_shape_cases U with hvc | ⟨R, hR⟩
  · rcases step1_vc_shape_host G C c hκ hc U hsg hhost hvc with h | h | h
    · right
      obtain ⟨hh, hsh⟩ := hvc
      unfold FinalCount.H.ObjVine
      rw [hsh]
      exact Or.inl (doubleChain_one_isVineI h)
    · left; have := Vine.doubleChain_card h; omega
    · right
      obtain ⟨hh, hsh⟩ := hvc
      unfold FinalCount.H.ObjVine
      rw [hsh]
      exact Or.inr (Or.inr h)
  · obtain ⟨r', hr', hk'⟩ := hsg
    have hrP := (U.shape.toVine_isGap L base κ r').mpr hr'
    rcases hhost with ⟨S, a, b, hDV, hUS, -, -⟩ | ⟨Q, hUQ, hQk, -, -⟩
    · exact FinalCount.H.hyper_shape_of_cls U hR
        (FinalCount.H.subsetvc_classification G.molecule hM U.shape.toVine hUS L γ η base c κ hκ hc hrP hk' (Or.inl hDV))
    · obtain ⟨r, hr, hkr⟩ : ∃ r, Q.shape.IsGap L base κ r ∧
          (Molecule.gapKind L γ η r = .LG ∨ Molecule.gapKind L γ η r = .ZG) := by
        rcases hQk with ⟨r, hr, hk⟩ | ⟨r, hr, hk⟩
        · exact ⟨r, hr, Or.inl hk⟩
        · exact ⟨r, hr, Or.inr hk⟩
      by_cases hcont : U.IsContained Q
      · exact FinalCount.H.hyper_shape_of_cls U hR
          (FinalCount.H.subsetvc_classification G.molecule hM U.shape.toVine hUQ L γ η base c κ hκ hc hrP hk'
            (Or.inr ⟨Q.shape.toVine, (U.shape.toVine_isContained Q.shape).mpr hcont,
              r, (Q.shape.toVine_isGap L base κ r).mpr hr, hkr⟩))
      · exact Or.inr (FinalCount.H.objVine_of_not_contained U Q hR hUQ hcont)

end shape

section garden2
variable {R d : ℕ} {G : Garden (2 * R)}
variable {C : Src.CountingChoices Src.γL G d} {S : SurvivorDataG Src.γL G} {L γ η : ℝ} {base : Mom d} {κ : GardenDart G → (Fin d → ℤ)}

theorem vcShape_GF {c : GBranch G.tree → Mom d} (hκ : G.molecule.IsDecoration L base c κ)
    (hc : ∀ v ∈ G.molecule.atoms, G.molecule.deg v = 4 → c v = 0)
    {U : Src.Object Src.γL G.molecule} (hU : U ∈ (gColF C S).C2Of L γ η 0 κ (unGF C S L γ η κ)) (hvc : ∃ h, U.shape = .vc h) :
    Vine.DoubleChain G.molecule U.atoms U.upper U.lower 1 ∨ Vine.DoubleChain G.molecule U.atoms U.upper U.lower 2 ∨
      G.molecule.IsTVine U.atoms U.upper U.lower := by
  obtain ⟨⟨⟨hsg, -, -, hhost⟩, -⟩, -⟩ := c2OfF_G_base (base := base) hU
  exact step1_vc_shape_host G (gColF C S) c hκ hc U hsg hhost hvc

theorem shape_GF {c : GBranch G.tree → Mom d} (hκ : G.molecule.IsDecoration L base c κ)
    (hc : ∀ v ∈ G.molecule.atoms, G.molecule.deg v = 4 → c v = 0)
    {U : Src.Object Src.γL G.molecule} (hU : U ∈ (gColF C S).C2Of L γ η 0 κ (unGF C S L γ η κ)) :
    U.atoms.card = 3 ∨ FinalCount.H.ObjVine G.molecule U :=
  c2_shape_host (gColF C S) hκ hc (c2OfF_G_base hU)

/-- **Interior atoms of `C₂` members are not critical** (MK second collection). -/
theorem not_critical_of_interior_c2MK (hSC : SecondCollectionOKMKG C S L γ η base κ) {U : Src.Object Src.γL G.molecule}
    (hU : U ∈ (gColF C S).C2Of L γ η base κ (FinalCount.H.unselOf (gColF C S) L γ η base κ C.omittedDVConstituents))
    {v : GBranch G.tree} (hv : U.IsInterior v) : ¬ C.CriticalSG v := by
  intro hcrit
  obtain ⟨rk, -, K, hK, hsec⟩ := hSC
  rw [← forbiddenOf_gColF] at hK
  have hel := FinalCount.H.eligible_of_pool (gColF C S) hU.1.1
  have hno : U.atoms ∉ C.omittedDVConstituents := fun h => hU.1.2 ⟨hU.1.1, h⟩
  obtain ⟨Q, hQK, hUQ⟩ := FinalCount.H.source_secondCollection_covers G L γ η base κ _ _ K hK U hel hno
  obtain ⟨Q', hQ'mem, hQ'at, -⟩ := FinalCount.H.canonicalSub_covers rk K Q hQK
  refine hcrit.2.2 Q' (hsec ▸ hQ'mem) (FinalCount.H.interior_of_contained ?_ hv)
  rw [hQ'at]
  exact Src.Object.contained_atoms_subset U Q hUQ

theorem crit_GF (hadm : AdmissibleMKG C S L γ η base κ) {U : Src.Object Src.γL G.molecule}
    (hU : FinalCount.H.Coll2 (gColF C S) (unGF C S L γ η κ) L γ η 0 κ U) {v : GBranch G.tree} (hv : U.IsInterior v) :
    ¬ CriticalSGMKG C S v := by
  intro hcrit
  rcases hU with ⟨i, rfl⟩ | hU
  · exact FinalCount.H.not_critical_of_interior_c1 C hv hcrit.1
  · exact not_critical_of_interior_c2MK hadm.2.1 (c2OfF_G_base hU) hv hcrit.1

/-- `atomLabel = SG` and requirement (c) give an SG triple at the atom (main's `sgat_of_label`). -/
theorem sgat_of_labelMK (hgk : ∀ v, atomGapKind G L γ η base κ v = C.atomLabel v) {a : GBranch G.tree}
    (ha : C.atomLabel a = .SG) : SGat G.molecule L γ η base κ a := by
  have h := hgk a
  rw [ha] at h
  unfold atomGapKind at h
  by_cases h1 : ∃ x y, TripleAt G a x y ∧ Molecule.gapKind L γ η (Molecule.gapAt L base κ x y) = .SG
  · obtain ⟨x, y, ⟨hx, hy, hne, ho⟩, hk⟩ := h1
    by_cases hxo : G.molecule.out x = false
    · have hyo : G.molecule.out y = true := by
        cases h' : G.molecule.out y
        · exact absurd (hxo.trans h'.symm) ho
        · rfl
      exact ⟨x, y, hx, hy, hxo, hyo, hne, hk⟩
    · have hxo' : G.molecule.out x = true := by
        cases h' : G.molecule.out x
        · exact absurd h' hxo
        · rfl
      have hyo : G.molecule.out y = false := by
        cases h' : G.molecule.out y
        · rfl
        · exact absurd (hxo'.trans h'.symm) ho
      refine ⟨y, x, hy, hx, hyo, hxo', ?_, ?_⟩
      · intro e; apply hne; rw [e, G.molecule.mate_mate]
      · rw [AtomTransport.gapAt_swap, AtomTransport.gapKind_neg]; exact hk
  · rw [ite_eq_right h1] at h
    split_ifs at h

/-- TARGET `subpro` (3) from the survivor-aware support (main's `degenSGT_of_support`; it reads `hingeSG`, `zeroTame`). -/
theorem degenSGT_of_supportMK {kFix : Finset (Mom d)} (h : SubproSupportMKG G C.subpro S L γ η base kFix κ) :
    DegenSGT G.molecule L γ η base κ (fun v => G.molecule.IsTame L base kFix κ v) := by
  intro a ha x y hx hy hxo hyo hne hz
  by_cases hh : a ∈ C.subpro.hinges
  · left
    obtain ⟨x', y', -, -, hT, hk⟩ := h.hingeSG a hh
    obtain ⟨ha1, ha2, hne', hne2⟩ := hT
    by_cases ho : G.molecule.out x' = false
    · have hy' : G.molecule.out y' = true := by
        cases h1 : G.molecule.out y' <;> simp_all
      exact ⟨x', y', ha1, ha2, ho, hy', hne', hk⟩
    · have hx'' : G.molecule.out x' = true := by simpa using ho
      have hy' : G.molecule.out y' = false := by
        cases h1 : G.molecule.out y' <;> simp_all
      refine ⟨y', x', ha2, ha1, hy', hx'', ?_, ?_⟩
      · intro e
        apply hne'
        rw [e, G.molecule.mate_mate]
      · rw [AtomTransport.gapAt_swap, AtomTransport.gapKind_neg]; exact hk
  · right
    refine h.zeroTame a hh ⟨x, y, ⟨hx, hy, hne, ?_⟩, ?_⟩
    · rw [hxo, hyo]; simp
    · have : Molecule.gapAt L base κ x y = 0 := by
        unfold Molecule.gapKind at hz
        split_ifs at hz with h0
        exact h0
      exact this

end garden2

/-! ### The MK critical atoms on the renamed molecule -/

section crit
variable {w d : ℕ} {G : Garden w} {W : Type*} [DecidableEq W]

/-- The MK critical-SG predicate transported along `ι`. -/
def critMapMK (ι : GBranch G.tree ↪ W) (C : Src.CountingChoices Src.γL G d) (S : SurvivorDataG Src.γL G) (v' : W) : Prop :=
  ∃ a, ι a = v' ∧ CriticalSGMKG C S a

theorem critMapMK_iff (ι : GBranch G.tree ↪ W) (C : Src.CountingChoices Src.γL G d) (S : SurvivorDataG Src.γL G) (a : GBranch G.tree) :
    critMapMK ι C S (ι a) ↔ CriticalSGMKG C S a :=
  ⟨fun ⟨_b, hb, h⟩ => ι.injective hb ▸ h, fun h => ⟨a, rfl, h⟩⟩

theorem numCriticalSGMK_eq (ι : GBranch G.tree ↪ W) (C : Src.CountingChoices Src.γL G d) (S : SurvivorDataG Src.γL G) :
    numCriticalSGMKG C S = ((mapAtoms G.molecule ι).atoms.filter (critMapMK ι C S)).card := by
  unfold numCriticalSGMKG
  rw [show (mapAtoms G.molecule ι).atoms = (Finset.univ : Finset (GBranch G.tree)).map ι from rfl,
    Finset.filter_map, Finset.card_map]
  congr 1
  ext a
  simp only [Finset.mem_filter, Finset.mem_univ, true_and, Function.comp_apply, critMapMK_iff]

end crit

end WaveTurbulence.GammaLow.Flower.H2
