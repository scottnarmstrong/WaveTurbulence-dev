/-! **L8-H2 port of main `WaveTurbulence.Foundations.Flower.FinalMKChain.Num`** (sha256 in H2/COPIED-SHA256SUMS): only the declarations
that depend on the vine-family carrier, re-stated over L6's low run (`FinalCount.H`, `Src … Src.γL`,
`Step1.VineCut Src.γL`) and L8's marked carrier (`SurvivorDataG Src.γL`); everything else is main's,
by import. Low-range changes are marked `L8-H2:` at their site (H2-PLAN §0).

 # C1b2 MK-CHAIN (11): the numerics with survivors (`ll_numE`, `exists_NLE`, the `L^{2m}` factor)

- `exists_NLE`: main's `exists_NL` (LowChain45) with the extra node count `c_D⁴` of the re-cut nodes in the phase-1
  bound (C1b1's `phase1_coverLE_of_inputs`, four node families).
- `ll_numE`: main's `ll_num` (LowChain44) twice, for the D1 constant and for the re-cut constant `CR` of C1a's
  `Ex1RC` (same shape `Cs·ν·(1+δ⁻¹)²·(12/(η²−η³))¹²`).
- `WPot_g1_add`, `WPot_init_eqLE`, `init_exp_leE`: the survivor budget at the initial state. With
  `Fmax = 2R − 1 + m` and C1a's `WPot_g1E_le` (`W(Y, g1E) ≤ W(Y·L^m, g1)`), the initial potential is main's times
  `L^{m}·L^{γ₀ m} ≤ L^{2m}` (`γ₀ = min γ (1−γ) ≤ 1`).

**Low-range change (L8-H2, re-cut bank `3/2`, FINDINGS F1; helper wt-l6count).** The potential is H2's `g1E32`
(`H2/Bank.lean`), not main's `g1E` (its re-cut step needs `hmarg : 2γ₀ + 4η² ≤ 1`, false at γ = 1/2). So
`WPot_init_eqLE` charges `L^{(3/2)m + γ₀ m}` (via `WPot_g1E32_le`: `W(Y, g1E32) ≤ W(Y·L^{(3/2)m}, g1)`), and
`init_exp_leE32` is main's `init_exp_leE` with that charge, closed by `init_charge32_le`
(`L^{(3/2)m}·L^{γ₀ m} ≤ L^{2m}` because `γ₀ ≤ 1/2`). Main's `WPot_g1_add` is used by import. -/
@[expose] public section
open WaveTurbulence.VineParamContract
set_option autoImplicit false
set_option linter.unusedSectionVars false
open Finset Classical
open Set (Ioo Ioc)
open scoped ENNReal
namespace WaveTurbulence.GammaLow.Flower.H2
open WaveTurbulence.GammaLow.FinalCount WaveTurbulence.GammaLow.Flower
open WaveTurbulence.Flower.FinalMKChain
open WaveTurbulence WaveTurbulence.FinalCount WaveTurbulence.FinalCountG3 WaveTurbulence.FinalCountAsm
open WaveTurbulence.Flower.FinalMKDefs WaveTurbulence.Flower.FinalMKStep WaveTurbulence.LGSpine.SourceVine

universe u
variable {d : ℕ}

section pot
variable {V : Type*} [DecidableEq V] {D₀ : Type u} [Fintype D₀] [DecidableEq D₀]

/-- **The initial potential with the survivor budget** (main's `WPot_init_eqL` with `g1E32`, `Fmax = 2R − 1 + m`):
at most main's value times `L^{(3/2)m + γ₀ m}` (low-range change: bank `3/2`; main: `L^{m + γ₀ m}`). -/
theorem WPot_init_eqLE {Rn R : ℕ} {M₀ : Molecule V D₀} (hS : SubHypL Rn M₀) {L γ η ε0 c : ℝ} (hc : 0 ≤ c)
    (hL1 : 1 ≤ L) (crit : V → Prop) {m : ℕ} (E : Fin m → Src.Object Src.γL M₀) :
    WPot L γ η (c * L ^ (eraseA γ η * (R : ℝ) + 4 * η * ((R : ℝ) - 1) - ε0))
        (g1E32 γ η crit (2 * (R : ℝ) - 1 + m) E) (HSt.init M₀) ≤
      ENNReal.ofReal (c * L ^ (3 / 2 * (m : ℝ) + min γ (1 - γ) * m)) *
        ENNReal.ofReal (L ^ ((R - 1 : ℝ) * (eraseA γ η + 2 * min γ (1 - γ) + 4 * η) - ε0 -
          4 * η ^ 6 * ((M₀.rho : ℝ) + ((M₀.atoms.filter crit).card : ℝ)))) := by
  have hL : 0 < L := by linarith
  have hap : 0 < apProd L γ η (HSt.init M₀).s := by
    have e3 : apProd L γ η (HSt.init M₀).s = 1 := apProd_init L γ η M₀
    rw [e3]; norm_num
  have hY : 0 ≤ c * L ^ (eraseA γ η * (R : ℝ) + 4 * η * ((R : ℝ) - 1) - ε0) := by positivity
  refine (WPot_g1E32_le hL1 hY crit _ E hap).trans (le_of_eq ?_)
  rw [WPot_g1_add hL]
  have e : c * L ^ (eraseA γ η * (R : ℝ) + 4 * η * ((R : ℝ) - 1) - ε0) * L ^ (3 / 2 * (m : ℝ)) *
        L ^ (min γ (1 - γ) * m) =
      c * L ^ (3 / 2 * (m : ℝ) + min γ (1 - γ) * m) * L ^ (eraseA γ η * (R : ℝ) + 4 * η * ((R : ℝ) - 1) - ε0) := by
    rw [Real.rpow_add hL]; ring
  rw [e]
  exact WPot_init_eqL hS (by positivity) hL crit

/-- Real arithmetic of the initial state with survivors: main's `init_exp_leE` with the bank-`3/2` charge
`L^{(3/2)m + γ₀ m}` (low-range change, FINDINGS F1), closed by `init_charge32_le`. -/
theorem init_exp_leE32 (hd : 3 ≤ d) {γ η : ℝ} (hγ0 : 0 < γ) (hγ1 : γ < 1) (hη0 : 0 < η) (hη : η ≤ 1 / 40) {R S : ℝ}
    (hR : 1 ≤ R) {L : ℝ} (hL : 1 ≤ L) {N4 : ℝ} (hN0 : 0 ≤ N4) (hN4 : N4 ≤ L ^ ((η ^ 5 - 4 * η ^ 6) / 4)) (m : ℕ) :
    N4 * (L ^ (3 / 2 * (m : ℝ) + min γ (1 - γ) * m) *
        L ^ ((R - 1) * (eraseA γ η + 2 * min γ (1 - γ) + 4 * η) - (η ^ 5 - 4 * η ^ 6) / 2 - 4 * η ^ 6 * S)) ≤
      L ^ (2 * (m : ℝ)) * L ^ (-4 * η ^ 6 * S) *
        L ^ ((R - 1) * ((d : ℝ) - γ - 1 / 4 - 1 / 40 - 1 / 20) - (η ^ 5 - 4 * η ^ 6) / 4) := by
  have hL0 : 0 < L := by linarith
  have hmain := init_exp_le hd hγ0 hγ1 hη0 hη hR hL hN4 (S := S)
  have hpow : L ^ (3 / 2 * (m : ℝ) + min γ (1 - γ) * m) ≤ L ^ (2 * (m : ℝ)) := by
    rw [Real.rpow_add hL0]; exact init_charge32_le hL m
  calc N4 * (L ^ (3 / 2 * (m : ℝ) + min γ (1 - γ) * m) *
        L ^ ((R - 1) * (eraseA γ η + 2 * min γ (1 - γ) + 4 * η) - (η ^ 5 - 4 * η ^ 6) / 2 - 4 * η ^ 6 * S))
      = L ^ (3 / 2 * (m : ℝ) + min γ (1 - γ) * m) *
        (N4 * L ^ ((R - 1) * (eraseA γ η + 2 * min γ (1 - γ) + 4 * η) - (η ^ 5 - 4 * η ^ 6) / 2 -
          4 * η ^ 6 * S)) := by ring
    _ ≤ L ^ (2 * (m : ℝ)) * (L ^ (-4 * η ^ 6 * S) *
        L ^ ((R - 1) * ((d : ℝ) - γ - 1 / 4 - 1 / 40 - 1 / 20) - (η ^ 5 - 4 * η ^ 6) / 4)) := by
        gcongr
    _ = _ := by ring

end pot

end WaveTurbulence.GammaLow.Flower.H2
