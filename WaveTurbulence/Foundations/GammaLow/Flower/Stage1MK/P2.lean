/-- B1b (Mk-general form of `gsk_of_spec`). -/
theorem gsk_of_specMkLow {w : ℕ} {S : Garden w} (D : ReconstructionData S) (hS : S.IsPlain)
    (layer : GNode (D.forest hS) → ℕ) (hLayer : IsLayering (D.garden hS) layer) (LG : LayeredGarden w)
    (hspec : layeredReconstruction D hS layer hLayer = LG) (hd : D.Decodes hS LG.garden) (σ : Prescription S) {Mk : Set (Fama.CLVineG γF _)} :
