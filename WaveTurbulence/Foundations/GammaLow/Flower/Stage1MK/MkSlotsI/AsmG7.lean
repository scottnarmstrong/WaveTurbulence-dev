/-- The slot mass of the general obligation at an outer slot. -/
def μsGenLow (Kg : ℕ → ℝ → ℝ) (b : ℝ) (sl : ReplacementSlot (Fama.stSt P.γ a.prime.skeleton a.totalSigma Mk).G) : ℝ≥0∞ :=
  if SelAdjOLow J kSel a Mk sl then
    ENNReal.ofReal (Kg P.d P.η * P.L ^ (47 * (P.d : ℝ) + 2) * genSlotMassLow P P.C₁ b a J pat t s kSel Rs (iotaAtLow a Mk sl))
  else ENNReal.ofReal (Kg P.d P.η * genSlotMassLow P P.C₁ b a J pat t s kSel Rs (iotaAtLow a Mk sl))

end

