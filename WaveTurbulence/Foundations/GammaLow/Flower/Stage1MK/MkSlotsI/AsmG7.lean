open WaveTurbulence.Flower.MkSlots (withC₁ recLG outerValMμD fixMeasure)
open WaveTurbulence.Flower.FinalMKDefs (RepresentsIntMKSel)
open scoped ENNReal Classical
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable (P : WTParams) [Fact (P.γ ≤ 1 / 2)] {R : ℕ} (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat) (t s : ℝ)
  (kSel : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ) (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R))
  (Mk : Set (Fama.CLVineG P.γ a.prime.skeleton))

/-- **`hμb`**: the slot masses in the engine's form. -/
theorem hμb_genLow (Kg : ℕ → ℝ → ℝ) (hC : 0 ≤ P.C₁) (hL : 0 ≤ P.L) (hRs : ∀ j, 1 ≤ Rs j) {b : ℝ} (hb : 0 ≤ b)
    (sl : ReplacementSlot (Fama.stSt P.γ a.prime.skeleton a.totalSigma Mk).G) :
    μsGenLow P J pat t s kSel Rs a Mk Kg b sl ≤
      ENNReal.ofReal (max 1 (Kg P.d P.η) * (P.C₁ * Real.sqrt P.δ) ^ slotSize a.prime.data (iotaAtLow a Mk sl) *
        P.L ^ (-(P.η ^ 8) * (slotIncoh a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)
          (iotaAtLow a Mk sl) : ℝ)) * lfGenLow P J pat t s kSel Rs a Mk b sl) := by
  have hK : Kg P.d P.η ≤ max 1 (Kg P.d P.η) := le_max_right _ _
  have hX : 0 ≤ (P.C₁ * Real.sqrt P.δ) ^ slotSize a.prime.data (iotaAtLow a Mk sl) :=
    pow_nonneg (mul_nonneg hC (Real.sqrt_nonneg _)) _
  have hY : 0 ≤ P.L ^ (-(P.η ^ 8) * (slotIncoh a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a) (iotaAtLow a Mk sl) : ℝ)) := Real.rpow_nonneg hL _
  have hZ := hlf_genLow P J pat t s kSel Rs a Mk hL hRs hb sl
  refine le_trans (le_of_eq ?_) (ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_right
    (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hK hX) hY) hZ))
  unfold μsGenLow lfGenLow genSlotMassLow
  split_ifs <;> ring_nf

end

