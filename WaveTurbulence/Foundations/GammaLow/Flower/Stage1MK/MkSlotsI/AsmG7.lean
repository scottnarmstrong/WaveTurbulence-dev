variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable (P : WTParams) [Fact (P.γ ≤ 1 / 2)] {R : ℕ} (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat) (t s : ℝ)
  (kSel : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ) (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R))
  (Mk : Set (Fama.CLVineG P.γ a.prime.skeleton))

theorem hlf_genLow (hL : 0 ≤ P.L) (hRs : ∀ j, 1 ≤ Rs j) {b : ℝ} (hb : 0 ≤ b)
    (sl : ReplacementSlot (Fama.stSt P.γ a.prime.skeleton a.totalSigma Mk).G) :
    0 ≤ lfGenLow P J pat t s kSel Rs a Mk b sl := by
  unfold lfGenLow
  have hc0 : 0 ≤ frontierConst P.d := le_trans zero_le_one (one_le_frontierConst _)
  refine mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg (pow_nonneg hc0 _) (genLeaf_nonnegLow _ J hb _))
    (Real.rpow_nonneg hL _)) (Finset.prod_nonneg fun v _ => Real.rpow_nonneg (le_trans zero_le_one (hRs _)) _)) ?_
  split_ifs
  · exact Real.rpow_nonneg hL _
  · exact zero_le_one

end

