/-- **`hμ`**: the moment masses of the centre-indexed families of the slot data. -/
theorem hμ_genLow (Kg : ℕ → ℝ → ℝ) (p : ℕ) (σ : Fin (2 * R) → Option ℕ) (roots : Fin (2 * R) → (Fin P.d → ℤ))
    (h : ℕ → Fin (2 * R) → Fin (2 * R) → Mom P.d → ℝ) (b : ℝ) (Rf : Fin (2 * R) → Option ℝ)
    (dag : Option (Fin (2 * R) → Fin 3 → Mom P.d))
    (sd : ReplacementSlot (Fama.stSt P.γ a.prime.skeleton a.totalSigma Mk).G → (Fin P.d → ℤ) → SlotDatum P.d)
    (hsd : SlotDataOKLow Kg P P.C₁ p a J pat t s kSel σ Rs roots h b Rf dag Mk sd)
    (X : CentredSlot (Fama.stSt P.γ a.prime.skeleton a.totalSigma Mk).G → (Fin P.d → ℤ))
    (sl : ReplacementSlot (Fama.stSt P.γ a.prime.skeleton a.totalSigma Mk).G) :
    ∑' l, maxBracketPow (θsGenLow P J kSel a Mk sl) (half ((famX (fam₀Of sd hsd.supp) (famCOfData sd) X).m sl l)) *
      ENNReal.ofReal ((famX (fam₀Of sd hsd.supp) (famCOfData sd) X).w sl l) ≤
      μsGenLow P J pat t s kSel Rs a Mk Kg b sl := by
  refine tsum_famX_le (fam₀Of sd hsd.supp) (famCOfData sd) X sl _ _ (fun _ => ?_) (fun c hc => ?_)
  · unfold θsGenLow μsGenLow
    by_cases hsa : SelAdjOLow J kSel a Mk sl
    · rw [if_pos hsa, if_pos hsa]
      exact hsd.massSel sl 0 hsa
    · rw [if_neg hsa, if_neg hsa]
      exact hsd.massEta sl 0 hsa
  · subst hc
    unfold θsGenLow μsGenLow
    by_cases hsa : SelAdjOLow J kSel a Mk (Sum.inr c.1)
    · rw [if_pos hsa, if_pos hsa]
      exact hsd.massSel (Sum.inr c.1) (X c) hsa
    · rw [if_neg hsa, if_neg hsa]
      exact hsd.massEta (Sum.inr c.1) (X c) hsa

end

