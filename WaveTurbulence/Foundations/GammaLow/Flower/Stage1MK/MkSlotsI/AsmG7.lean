variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable (P : WTParams) [Fact (P.γ ≤ 1 / 2)] {R : ℕ} (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat) (t s : ℝ)
  (kSel : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ) (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R))
  (Mk : Set (Fama.CLVineG P.γ a.prime.skeleton))

/-- **`hcθ`**: the per-slot exponent pays the two hinge losses `2·6η⁶` and the selection moments (`η ≤ 1/4`). -/
theorem hcθ_genLow (hη : 0 < P.η) (hη4 : P.η ≤ 1 / 4) (sl : ReplacementSlot (Fama.stSt P.γ a.prime.skeleton a.totalSigma Mk).G) :
    2 * (6 * P.η ^ 6) + (MkSlotsS.selE ((Fama.stShape P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma Mk).route
        a.prime.prime.1 ((Fama.stSt P.γ a.prime.skeleton a.totalSigma Mk).plain a.prime.prime.1)) (selRAtLow J kSel a Mk) sl 0 +
      MkSlotsS.selE ((Fama.stShape P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma Mk).route
        a.prime.prime.1 ((Fama.stSt P.γ a.prime.skeleton a.totalSigma Mk).plain a.prime.prime.1)) (selRAtLow J kSel a Mk) sl 1)
      ≤ θsGenLow P J kSel a Mk sl := by
  unfold θsGenLow
  by_cases hsa : SelAdjOLow J kSel a Mk sl
  · rw [if_pos hsa]
    have he0 := MkSlotsS.selE_le ((Fama.stShape P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma Mk).route
      a.prime.prime.1 ((Fama.stSt P.γ a.prime.skeleton a.totalSigma Mk).plain a.prime.prime.1)) (selRAtLow J kSel a Mk) sl 0
    have he1 := MkSlotsS.selE_le ((Fama.stShape P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma Mk).route
      a.prime.prime.1 ((Fama.stSt P.γ a.prime.skeleton a.totalSigma Mk).plain a.prime.prime.1)) (selRAtLow J kSel a Mk) sl 1
    have h6 : P.η ^ 6 ≤ (1 / 4 : ℝ) ^ 6 := pow_le_pow_left₀ hη.le hη4 6
    norm_num at h6
    linarith
  · rw [if_neg hsa]
    have hna : ¬ MkSlotsS.AdjS ((Fama.stShape P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma Mk).route
        a.prime.prime.1 ((Fama.stSt P.γ a.prime.skeleton a.totalSigma Mk).plain a.prime.prime.1)) (selRAtLow J kSel a Mk) sl :=
      fun h' => hsa (selAdj_iota_of_adjSLow J kSel a Mk sl h')
    rw [MkSlotsS.selE_eq_zero_of_not_adj _ _ sl hna 0, MkSlotsS.selE_eq_zero_of_not_adj _ _ sl hna 1]
    have h5 : P.η ^ 5 ≤ (1 / 4 : ℝ) ^ 5 := pow_le_pow_left₀ hη.le hη4 5
    have e : P.η ^ 6 = P.η ^ 5 * P.η := by ring
    norm_num at h5
    nlinarith

end

