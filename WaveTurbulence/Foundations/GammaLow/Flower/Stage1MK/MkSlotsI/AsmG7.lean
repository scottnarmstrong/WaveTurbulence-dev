/-- The leaf factor of an outer slot. -/
def lfGenLow (b : ℝ) (sl : ReplacementSlot (Fama.stSt P.γ a.prime.skeleton a.totalSigma Mk).G) : ℝ :=
  frontierConst P.d ^ Stage1WNoVine.slotNr a.prime.data a.prime.prime.1 (iotaAtLow a Mk sl) *
    genLeafLow a J b (iotaAtLow a Mk sl) *
    P.L ^ (if HasProtNative a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)
      (protI (recLGLow a) J pat t s kSel) (iotaAtLow a Mk sl) then genLossExp P.d else 0) *
    (∏ v ∈ MkSlotsS.selNative a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J kSel
      (iotaAtLow a Mk sl), Rs v.1.1 ^ (-(1 / 18 : ℝ))) *
    (if SelAdjOLow J kSel a Mk sl then P.L ^ (47 * (P.d : ℝ) + 2) else 1)

end

