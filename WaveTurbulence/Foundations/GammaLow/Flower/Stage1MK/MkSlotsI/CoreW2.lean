variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {R p : ℕ} {kind : Bool} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R))
  (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (hy : y ∈ Fama.sourceClass γF a p kind mk)
  (J : Finset (Fin (2 * R)))
  (hcapA : ∀ j ∈ J, (a.prime.data.garden a.prime.prime.1).tree j = TTree.leaf)
  (hcapY : ∀ j ∈ J, (y.1.data.garden y.1.plain).tree j = TTree.leaf)
  (hG : (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.IsPlain)
  (hrepU : ∀ j, ∀ b ∈ (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).atoms,
    ¬ IsCapFlowerParent (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a)) J (a.prime.data.coreBranch a.prime.prime.1 b))
  (hc : CleanPtLow J a)
  (honeA : MkSlotsS.OneFlower (recLGLow a) J)
  (honeY : MkSlotsS.OneFlower (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J)
  (kSel : Fin (2 * R) → Option ℕ)
variable (L : ℝ) (σ : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ)

include hy hcapA hcapY hG hrepU hc honeA honeY in
/-- **Item 2: the member transfer of the atom part.** The atom factor of the member's core multiplier `genCoreW`
(over the non-hinge `G_sb` atoms, at the skeleton resonance factors of the coset decoration of `κ`) is the atom weight
`zatomGLow` of `G_sb` at the restricted decoration `(memShapeLow a mk y hy).resDec … κ`. -/
theorem zatom_memberLow
    (hex : ∀ j, (selCap (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J
      kSel j).isSome ↔ (selCap (recLGLow a) J kSel j).isSome)
    {d : ℕ} {roots : Fin (2 * R) → (Fin d → ℤ)} (κ : GenDecoration y.1.skeleton d roots 0) :
    ∏ c ∈ univ.filter (fun c => c ∉ (memShapeLow a mk y hy).hinges (Fama.source_disjMk a mk y hy)),
        genNW (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J L σ kSel Rs
          (y.1.data.coreBranch y.1.plain ((memShapeLow a mk y hy).br c)).toNode
          (omegaNode y.1.skeleton (cosetDecoration y.1.skeleton L 0 κ.1) ((memShapeLow a mk y hy).br c)) =
      zatomGLow J L σ kSel Rs a (mk a.prime) ((memShapeLow a mk y hy).resDec y.1.plain (Fama.source_disjMk a mk y hy) κ) := by
  rw [zatomG_eqLow, memShape_hingesLow]
  refine Finset.prod_congr rfl fun c hc' => ?_
  have hh : c ∉ (memShapeLow a mk y hy).hinges (Fama.source_disjMk a mk y hy) := by
    rw [memShape_hingesLow]; exact (Finset.mem_filter.1 hc').2
  have hnu : ∀ j, (memShapeLow a mk y hy).br c ≠ (unitClBlock (y.2 j)).upper := fun j h =>
    hh (((memShapeLow a mk y hy).mem_hinges (Fama.source_disjMk a mk y hy) c).2 ⟨j, h⟩)
  rw [genNW_memberLow a mk y hy J hcapA hcapY hG hrepU hc honeA honeY kSel L σ Rs hex c,
    MkSlotsT.omegaNode_shape (memShapeLow a mk y hy) (cosetDecoration y.1.skeleton L 0 κ.1)
      (cosetDecoration (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G L 0
        ((memShapeLow a mk y hy).resDec y.1.plain (Fama.source_disjMk a mk y hy) κ).1) (fun _ => rfl) c hnu]

include hy hcapA hcapY hG hrepU hc honeA honeY in

