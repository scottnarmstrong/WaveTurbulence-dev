variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {R p : ℕ} {kind : Bool} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R))
  (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (hy : y ∈ Fama.sourceClass γF a p kind mk)
  (J : Finset (Fin (2 * R)))
  (hcapA : ∀ j ∈ J, (a.prime.data.garden a.prime.prime.1).tree j = TTree.leaf)
  (hcapY : ∀ j ∈ J, (y.1.data.garden y.1.plain).tree j = TTree.leaf)
  (hG : (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.IsPlain)
  (hrepU : ∀ j, ∀ b ∈ (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).atoms,
    ¬ IsCapFlowerParent (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a)) J (a.prime.data.coreBranch a.prime.prime.1 b))
  (hc : CleanPtLow J a)
  (honeA : MkSlotsS.OneFlower (recLGLow a) J)
  (honeY : MkSlotsS.OneFlower (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J)
  (kSel : Fin (2 * R) → Option ℕ)

include hy hcapA hcapY hG hrepU hc honeA honeY in
/-- The member's core of a `G_sb` atom is a selected vertex iff the representative's is. -/
theorem coreY_mem_selSetCap_iffLow (c : GBranch (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.tree) :
    y.1.data.coreBranch y.1.plain ((memShapeLow a mk y hy).br c) ∈
        selSetCap (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J kSel ↔
      coreRecLow a (mk a.prime) c ∈ selSetCap (recLGLow a) J kSel := by
  exact (mem_selSetCap_iff' _).trans ((exists_congr fun j =>
    selCap_member_core_iffLow a mk y hy J hcapA hcapY hG hrepU hc honeA honeY kSel j c).trans
      (mem_selSetCap_iff' _).symm)

end

