variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {R p : ℕ} {kind : Bool} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R))
  (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (hy : y ∈ Fama.sourceClass γF a p kind mk)
  (J : Finset (Fin (2 * R)))
  (hcapA : ∀ j ∈ J, (a.prime.data.garden a.prime.prime.1).tree j = TTree.leaf)
  (hcapY : ∀ j ∈ J, (y.1.data.garden y.1.plain).tree j = TTree.leaf)
  (hG : (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.IsPlain)
  (hrepU : ∀ j, ∀ b ∈ (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).atoms,
    ¬ IsCapFlowerParent (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a)) J (a.prime.data.coreBranch a.prime.prime.1 b))
  (hc : CleanPtLow J a)
  (honeA : MkSlotsS.OneFlower (recLGLow a) J)
  (honeY : MkSlotsS.OneFlower (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J)
  (kSel : Fin (2 * R) → Option ℕ)
variable (L : ℝ) (σ : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ)

include hy hcapA hcapY hG hrepU hc honeA honeY in
/-- **The stem node weight at a `G_sb` atom is common to the run class** (given the per-tree existence of the
selected vertex, for the shells). -/
theorem genNW_memberLow
    (hex : ∀ j, (selCap (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J
      kSel j).isSome ↔ (selCap (recLGLow a) J kSel j).isSome)
    (c : GBranch (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.tree) (x : ℝ) :
    genNW (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J L σ kSel Rs
        (y.1.data.coreBranch y.1.plain ((memShapeLow a mk y hy).br c)).toNode x =
      genNW (recLGLow a) J L σ kSel Rs (coreRecLow a (mk a.prime) c).toNode x := by
  have htY : (y.1.data.coreBranch y.1.plain ((memShapeLow a mk y hy).br c)).1.1 = c.1.1 :=
    (MkSlots.IntRest.coreBranch_fst y.1.data y.1.plain _).trans (MkSlotsT.shape_br_fst (memShapeLow a mk y hy) c)
  have htA : (coreRecLow a (mk a.prime) c).1.1 = c.1.1 :=
    (MkSlots.IntRest.coreBranch_fst a.prime.data a.prime.prime.1 _).trans
      (MkSlotsT.shape_br_fst (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)) c)
  exact genNW_congr_data _ _ c.1.1 htY htA (stemB_member_iffLow a mk y hy J hcapA hcapY hG hrepU c)
    (coreY_mem_selSetCap_iffLow a mk y hy J hcapA hcapY hG hrepU hc honeA honeY kSel c) (hex c.1.1)
    (selCap_member_core_iffLow a mk y hy J hcapA hcapY hG hrepU hc honeA honeY kSel c.1.1 c) x

include hy hcapA hcapY hG hrepU hc honeA honeY in

end

