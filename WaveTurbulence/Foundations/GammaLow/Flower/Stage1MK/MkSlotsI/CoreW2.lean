/-- **No core of an atom of a unit of the representative is a selected vertex** (the fine marking marks the vines
containing a selected vertex; α's `rep_units_not_cfp` for the selections). -/
theorem rep_units_not_selLow {R : ℕ} (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat) (t s : ℝ)
    (kSel : Fin (2 * R) → Option ℕ) (mkF : Fama.Stage1Mk.MarkFn γF (2 * R))
    (hsub : ∀ {LG : LayeredGarden (2 * R)} (B : PrimeData LG), markILow (γF := γF) J pat t s kSel B ⊆ mkF B)
    (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R)) (hset : mk a.prime = classMkLow mkF a)
    (j : Fin (Fama.unitBlocks γF a.prime.skeleton a.totalSigma (mk a.prime)).length) (b : GBranch a.prime.skeleton.tree)
    (hb : b ∈ (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).atoms) :
    a.prime.data.coreBranch a.prime.prime.1 b ∉ selSetCap (recLGLow a) J kSel := by
  have hu : Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j ∈
      Fama.unitBlocks γF a.prime.skeleton a.totalSigma (classMkLow mkF a) := by
    rw [← hset]
    exact List.get_mem _ _
  have h0 := coreBranch_unit_not_selLow pat t s kSel mkF hsub a hu hb
  rwa [← mem_selSetCap_congr (sourceLayer_reconstructsLow a) J kSel
    (b := a.prime.data.coreBranch a.prime.prime.1 b) rfl] at h0

end

