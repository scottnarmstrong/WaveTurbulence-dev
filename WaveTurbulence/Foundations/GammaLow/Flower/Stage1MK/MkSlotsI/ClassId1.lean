/-- **The uniform chain-piece mass bound** (`hMC` of VBC) from the moment masses of `SlotDataOKLow`: the slot masses are
centre-free, so one constant (a finite sum over the centred slots) bounds every `∑' l, (famCOfData sd c y).w l`. -/
theorem exists_hMCLow {Kg : ℕ → ℝ → ℝ} {P : WTParams} [Fact (P.γ ≤ 1 / 2)] (hη0 : 0 ≤ P.η) {C : ℝ} {R : ℕ} {p : ℕ}
    {a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R)} {J : Finset (Fin (2 * R))} {pat : Fin (2 * R) → FixPat} {t s : ℝ}
    {kSel σ : Fin (2 * R) → Option ℕ} {Rs : Fin (2 * R) → ℝ} {roots : Fin (2 * R) → (Fin P.d → ℤ)}
    {h : ℕ → Fin (2 * R) → Fin (2 * R) → Mom P.d → ℝ} {b : ℝ} {Rf : Fin (2 * R) → Option ℝ}
    {dag : Option (Fin (2 * R) → Fin 3 → Mom P.d)} {Mk : Set (Fama.CLVineG P.γ a.prime.skeleton)}
    {sd : ReplacementSlot (Fama.stSt P.γ a.prime.skeleton a.totalSigma Mk).G → (Fin P.d → ℤ) → SlotDatum P.d}
    (hsd : SlotDataOKLow Kg P C p a J pat t s kSel σ Rs roots h b Rf dag Mk sd) :
    ∃ MC : ℝ, ∀ (c : CentredSlot (Fama.stSt P.γ a.prime.skeleton a.totalSigma Mk).G) (y : Fin P.d → ℤ),
      ∑' l, (famCOfData sd c y).w l ≤ MC := by
  classical
  set A : CentredSlot (Fama.stSt P.γ a.prime.skeleton a.totalSigma Mk).G → ℝ := fun c =>
    max (Kg P.d P.η * genSlotMassLow P C b a J pat t s kSel Rs (iotaAtLow a Mk (.inr c.1))) 0 +
      max (Kg P.d P.η * P.L ^ (47 * (P.d : ℝ) + 2) * genSlotMassLow P C b a J pat t s kSel Rs (iotaAtLow a Mk (.inr c.1))) 0
    with hA
  refine ⟨∑ c, A c, fun c y => ?_⟩
  have hA0 : ∀ c, 0 ≤ A c := fun c => add_nonneg (le_max_right _ _) (le_max_right _ _)
  have hle : A c ≤ ∑ c, A c := Finset.single_le_sum (fun c _ => hA0 c) (Finset.mem_univ c)
  refine le_trans ?_ hle
  show ∑' l, (sd (.inr c.1) y).w l ≤ A c
  by_cases hsel : SelAdj (a.prime.data) a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J kSel
      (iotaAtLow a Mk (.inr c.1))
  · exact (tsum_w_le_of_mass _ (by norm_num) (hsd.massSel (.inr c.1) y hsel)).trans (le_add_of_nonneg_left
      (le_max_right _ _))
  · exact (tsum_w_le_of_mass _ hη0 (hsd.massEta (.inr c.1) y hsel)).trans (le_add_of_nonneg_right
      (le_max_right _ _))

end

