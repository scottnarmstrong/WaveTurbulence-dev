open WaveTurbulence.Flower.Stage1W WaveTurbulence.Flower.Stage1MKGate
open WaveTurbulence.RedSplice (stSt unitBlocks)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w : ℕ}
variable {S : Garden w} (σ : RedSplice.Prescription S) (Mk : Set (Fama.CLVineG γF S))
  (u : Fin (Fama.unitBlocks γF S σ Mk).length)

/-- **A native node of a regional slot of a unit is near a non-upper atom of one of the unit's vines.** -/
theorem exists_vine_near_of_regSlotLow (D : ReconstructionData S) (hS : S.IsPlain) {sl : ReplacementSlot S}
    (hsl : sl ∈ VineB.regSlots (Fama.unitBlkMk γF (Mole.garden_isMolecule S) σ Mk) hS u)
    (z : GNode (D.forest hS)) (hz : MkSlots.slotOf D hS z = sl) :
    ∃ c ∈ Fama.vinesV0 γF S σ Mk, ∃ b ∈ c.atoms, b ≠ c.upper ∧ z.1 ∈ nearRegion S D.tree b := by
  rcases sl with q | β
  · rw [VineB.mem_regSlots_inl] at hsl
    rcases MkSlotsT.owner_slotOf_inl D hS z q hz with h | h
    · exact exists_vine_near_of_internalLeafLow σ Mk u D.tree hsl ((MkMark.mem_ownRegion_iff S D.tree).mpr h)
    · exact exists_vine_near_of_internalLeafLow σ Mk u D.tree ((VineB.second_internal_iff hS _ q).mpr hsl)
        ((MkMark.mem_ownRegion_iff S D.tree).mpr h)
  · rw [VineB.mem_regSlots_inr, VineB.mem_inter] at hsl
    obtain ⟨c, hc, hbc, hbu⟩ := exists_vine_nonUpperLow σ Mk u hsl.1 hsl.2
    exact ⟨c, hc, β, hbc, hbu, ProtGeo.mem_nearRegion_own
      ((MkMark.mem_ownRegion_iff S D.tree).mpr (MkSlotsT.owner_slotOf_inr D hS z β hz))⟩

end

