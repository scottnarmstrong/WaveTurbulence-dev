variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w : ℕ}
variable {S : Garden w} (σ : RedSplice.Prescription S) (Mk : Set (Fama.CLVineG γF S))
  (u : Fin (Fama.unitBlocks γF S σ Mk).length)

/-- **The region of an internal leaf of a unit is near a non-upper atom of one of its vines**: the parent of the leaf
(own region of a child) or the parent of its partner (own region of the partner of a leaf child); they are not both the
upper joint (`not_loop_at_joint`). -/
theorem exists_vine_near_of_internalLeafLow (X : GBranch S.tree → RegChain) {ℓ : GLeaf S.tree}
    (hℓ : Mole.IsInternalLeaf S (Fama.unitBlkMk γF (Mole.garden_isMolecule S) σ Mk u).atoms ℓ)
    {z : Address w} (hz : z ∈ ownRegion S X ℓ.toNode) :
    ∃ c ∈ Fama.vinesV0 γF S σ Mk, ∃ b ∈ c.atoms, b ≠ c.upper ∧ z ∈ nearRegion S X b := by
  obtain ⟨hm, hn, hp, hg⟩ := hℓ
  have hxU : GNode.parent ℓ.toNode hn ∈ (Fama.unitBlkMk γF (Mole.garden_isMolecule S) σ Mk u).atoms := hg.1
  have hx'U : GNode.parent (S.pair ℓ).toNode hp ∈ (Fama.unitBlkMk γF (Mole.garden_isMolecule S) σ Mk u).atoms :=
    hg.2
  by_cases hx : GNode.parent ℓ.toNode hn = (Fama.unitBlkMk γF (Mole.garden_isMolecule S) σ Mk u).upper
  · by_cases hx' : GNode.parent (S.pair ℓ).toNode hp = (Fama.unitBlkMk γF (Mole.garden_isMolecule S) σ Mk u).upper
    · exact (not_loop_at_joint S.molecule (Fama.unitBlkMk γF (Mole.garden_isMolecule S) σ Mk u).isBlock hg hx
        hx').elim
    · obtain ⟨c, hc, hbc, hbu⟩ := exists_vine_nonUpperLow σ Mk u hx'U hx'
      refine ⟨c, hc, _, hbc, hbu, ProtGeo.mem_nearRegion_partner (ℓ := S.pair ℓ)
        ⟨rfl, (S.pair ℓ).1.2.getLast hp, (List.dropLast_append_getLast hp).symm⟩ ?_⟩
      rw [S.pair_pair]
      exact hz
  · obtain ⟨c, hc, hbc, hbu⟩ := exists_vine_nonUpperLow σ Mk u hxU hx
    have he := ProtGeo.node_eq_child_of_parent (c := ℓ.toNode) hn rfl
    refine ⟨c, hc, _, hbc, hbu, ProtGeo.mem_nearRegion_child (ℓ.toNode.1.2.getLast hn) ?_⟩
    rw [← he]
    exact hz

end

