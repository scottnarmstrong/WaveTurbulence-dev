variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w : ℕ}
variable {S : Garden w} (σ : RedSplice.Prescription S) (Mk : Set (Fama.CLVineG γF S))
  (u : Fin (Fama.unitBlocks γF S σ Mk).length)

/-- **A non-upper atom of a unit is a non-upper atom of one of its vines** (of `𝒱₀ ∖ Mk`; γ's
`exists_piece_nonUpper` on the aligned assembly of the unit). -/
theorem exists_vine_nonUpperLow {β : GBranch S.tree}
    (hβ : β ∈ (Fama.unitBlkMk γF (Mole.garden_isMolecule S) σ Mk u).atoms)
    (hne : β ≠ (Fama.unitBlkMk γF (Mole.garden_isMolecule S) σ Mk u).upper) :
    ∃ c ∈ Fama.vinesV0 γF S σ Mk, β ∈ c.atoms ∧ β ≠ c.upper := by
  obtain ⟨i, hi, hiu⟩ :=
    exists_piece_nonUpperLow (Fama.alignedAssemblyMk γF (Mole.garden_isMolecule S) σ Mk u) β hβ hne
  obtain ⟨c, hc, hca⟩ := alignedPiece_mem_vinesV0Low σ Mk u i
  refine ⟨c, hc, by rw [hca]; exact hi, ?_⟩
  exact ne_upper_of_pieceLow (Fama.alignedAssemblyMk γF (Mole.garden_isMolecule S) σ Mk u) i c hca hi hiu

end

