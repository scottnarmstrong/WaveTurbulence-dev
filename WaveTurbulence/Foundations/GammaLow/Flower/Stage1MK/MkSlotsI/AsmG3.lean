open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkSlotsI
open scoped Classical ENNReal
open WaveTurbulence WaveTurbulence.LGSpine WaveTurbulence.Induct Set Finset MeasureTheory
open WaveTurbulence.Reg WaveTurbulence.Reg.Skeleton WaveTurbulence.RegRed WaveTurbulence.Represents
open WaveTurbulence.LGSpine.SourceVine WaveTurbulence.Flower.MkDefs WaveTurbulence.Flower.FinalMKDefs
open WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden WaveTurbulence.VineEstS3 WaveTurbulence.VineEstS3.FS WaveTurbulence.RepAnalytic WaveTurbulence.VineAlign
open WaveTurbulence.Flower.Stage1W WaveTurbulence.Flower.Stage1MKGate
open WaveTurbulence.RedSplice (stSt unitBlocks)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w : ℕ}

/-- **An absorbed selected vertex is a non-core native node of an outer slot.** If the selected vertex `v` of tree `j`
(at the reconstruction of `a`) is not the core branch of a residual selected atom (`j ∉ image selR`), then
`v ∈ selNative (iotaAtLow a (classMkLow mkF a) s')` for some slot `s'` of `G_sb`. -/
theorem exists_selNative_of_absorbedLow {J : Finset (Fin w)} (pat : Fin w → FixPat) (t s : ℝ)
    (kSel : Fin w → Option ℕ) (mkF : Fama.Stage1Mk.MarkFn γF w)
    (hsub : ∀ {LG : LayeredGarden w} (B : PrimeData LG), markILow (γF := γF) J pat t s kSel B ⊆ mkF B)
    (a : Fama.VineA.PrescribedPrimeGarden γF w) {j : Fin w} {v : GBranch (recLGLow a).garden.tree}
    (hv : selCap (recLGLow a) J kSel j = some v)
    (hj : j ∉ (selRAtLow J kSel a (classMkLow mkF a)).image (fun c => c.1.1)) :
    ∃ s' : ReplacementSlot (Fama.stSt γF a.prime.skeleton a.totalSigma (classMkLow mkF a)).G,
      v ∈ MkSlotsS.selNative a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J kSel
        (iotaAtLow a (classMkLow mkF a) s') := by
  obtain ⟨v', hv', hvv⟩ := selCap_congr (sourceLayer_reconstructsLow a) hv
  have hv's : v' ∈ selSetCap a.layered J kSel := Finset.mem_filter.2 ⟨Finset.mem_univ _, j, hv'⟩
  rcases selVertex_dichotomyLow pat t s kSel mkF hsub a hv' with ⟨c, hc, hcv, -⟩ | ⟨⟨r, hr⟩, -⟩
  · -- case (a): a residual selected atom of tree `j`
    exfalso
    apply hj
    refine Finset.mem_image.2 ⟨c, hc, ?_⟩
    rw [← coreOf_fstLow mkF a c, hcv]
    exact MkSlotsS.selCap_fst hv'
  · -- case (b): a native clock branch
    let z : GNode (a.prime.data.forest a.prime.prime.1) := v.toNode
    obtain ⟨an, han⟩ := MkSlots.IntGeo.exists_nativeNodeAt_of_slotOf a.prime.data a.prime.prime.1
      (z := z) (sl := MkSlots.slotOf a.prime.data a.prime.prime.1 z) rfl
    have hcore : ∀ β : GBranch a.prime.skeleton.tree,
        nativeNodeAt a.prime.data a.prime.prime.1 (MkSlots.slotOf a.prime.data a.prime.prime.1 z) an ≠
          (a.prime.data.coreBranch a.prime.prime.1 β).toNode := by
      intro β hβ
      rw [han] at hβ
      have h1 : (sourceBranchEquiv a.prime.data a.prime.prime.1 (.inr r)).1 =
          (sourceBranchEquiv a.prime.data a.prime.prime.1 (.inl β)).1 := by
        rw [hr, hvv, sourceBranchEquiv_core]
        have h2 := congrArg (fun n : GNode (a.prime.data.forest a.prime.prime.1) => n.1) hβ
        exact h2
      exact absurd ((sourceBranchEquiv a.prime.data a.prime.prime.1).injective (Subtype.ext h1)) (by simp)
    -- the slot is outer
    have hout : MkSlots.slotOf a.prime.data a.prime.prime.1 z ∈
        VineB.outerSlots (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (classMkLow mkF a))
          a.prime.prime.1 := by
      simp only [VineB.outerSlots, Finset.mem_filter, Finset.mem_univ, true_and]
      intro u hu
      obtain ⟨c, hc, b, hbc, hbu, hnear⟩ :=
        exists_vine_near_of_regSlotLow a.totalSigma (classMkLow mkF a) u a.prime.data a.prime.prime.1 hu z rfl
      have hm : c ∈ markILow (γF := γF) J pat t s kSel a.prime :=
        ⟨Fama.vinesV0_subsetMk _ _ _ hc, b, hbc, hbu, v'.toNode, ProtGeo.sel_mem_protI pat t s hv's, by
          show v'.1 ∈ _
          rw [hvv]
          exact hnear⟩
      obtain ⟨hc0, hcMk⟩ := Fama.mem_vinesV0.mp hc
      exact hcMk ⟨hsub a.prime hm, hc0⟩
    obtain ⟨s', hs'⟩ := (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma
      (classMkLow mkF a)).exists_iota a.prime.prime.1
      ((Fama.stSt γF a.prime.skeleton a.totalSigma (classMkLow mkF a)).plain a.prime.prime.1) hout
    refine ⟨s', ?_⟩
    show v ∈ MkSlotsS.selNative a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J kSel
      ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (classMkLow mkF a)).iota a.prime.prime.1
        ((Fama.stSt γF a.prime.skeleton a.totalSigma (classMkLow mkF a)).plain a.prime.prime.1) s')
    rw [hs']
    refine Finset.mem_filter.mpr ⟨Finset.mem_filter.2 ⟨Finset.mem_univ _, j, hv⟩, an, hcore, ?_⟩
    rw [han]
    rfl

end

