open WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden WaveTurbulence.VineEstS3 WaveTurbulence.VineEstS3.FS WaveTurbulence.RepAnalytic WaveTurbulence.VineAlign
open WaveTurbulence.Flower.Stage1W WaveTurbulence.Flower.Stage1MKGate
open WaveTurbulence.RedSplice (stSt unitBlocks)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w : ℕ}

/-- **Mass accounting of the absorbed selections.** The product over the outer slots `s'` of the selected native
gains `Rs_{j(v)}^{-1/18}` (`v ∈ selNative (iotaAtLow a Mk s')`, the mass factors of the general slot obligation) is at
most the product of `Rs_j^{-1/18}` over the absorbed selected trees `j` (requested, `j ∉ image selR`; the factor of
`selMassMK`). -/
theorem prod_selNative_leLow {R : ℕ} (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat) (t s : ℝ)
    (kSel : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ) (mkF : Fama.Stage1Mk.MarkFn γF (2 * R))
    (hsub : ∀ {LG : LayeredGarden (2 * R)} (B : PrimeData LG), markILow (γF := γF) J pat t s kSel B ⊆ mkF B)
    (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (Mk : Set (Fama.CLVineG γF a.prime.skeleton)) (hMk : Mk = classMkLow mkF a)
    (hRs : ∀ j, 1 ≤ Rs j)
    (hok : ∀ j, (kSel j).isSome → (selCap (recLGLow a) J kSel j).isSome) :
    ∏ s' : ReplacementSlot (Fama.stSt γF a.prime.skeleton a.totalSigma Mk).G,
      ∏ v ∈ MkSlotsS.selNative a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J kSel
        (iotaAtLow a Mk s'), Rs v.1.1 ^ (-(1 / 18 : ℝ)) ≤
      ∏ j : Fin (2 * R), (if (kSel j).isSome ∧ j ∉ (selRAtLow J kSel a Mk).image (fun v => v.1.1) then
        Rs j ^ (-(1 / 18 : ℝ)) else 1) := by
  subst hMk
  have hf0 : ∀ j, 0 ≤ Rs j ^ (-(1 / 18 : ℝ)) := fun j => Real.rpow_nonneg (by linarith [hRs j]) _
  have hf1 : ∀ j, Rs j ^ (-(1 / 18 : ℝ)) ≤ 1 := fun j =>
    Real.rpow_le_one_of_one_le_of_nonpos (hRs j) (by norm_num)
  rw [← Finset.prod_filter]
  rw [Finset.prod_sigma']
  refine prod_le_prod_of_subset_image (F := fun j => Rs j ^ (-(1 / 18 : ℝ))) _ _ _ ?_ hf0 hf1
  intro j hj
  obtain ⟨hk, hjn⟩ := (Finset.mem_filter.mp hj).2
  obtain ⟨v, hv⟩ := Option.isSome_iff_exists.mp (hok j hk)
  obtain ⟨s', hs'⟩ := exists_selNative_of_absorbedLow pat t s kSel mkF hsub a hv hjn
  exact Finset.mem_image.mpr ⟨⟨s', v⟩, Finset.mem_sigma.mpr ⟨Finset.mem_univ _, hs'⟩, MkSlotsS.selCap_fst hv⟩

end

