/-- The unit leaf factors. -/
def lfjGenLow (j : Fin (Fama.unitBlocks P.γ a.prime.skeleton a.totalSigma (mk a.prime)).length) : ℝ :=
  topFilterMass ^ (SUGenLow P J σ kSel Rs a mk j).length *
    (frontierConst P.d ^ (9 * (Fama.unitBlkMk P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).atoms.card +
      4 * clLocalOrder2 a.prime.data a.prime.prime.1
        (regionOf (Fama.unitBlkMk P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j))) *
    regionLeafSize a.prime.data a.prime.prime.1
      (regionOf (Fama.unitBlkMk P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j))
      (sourceLayerLow a) (sourceLayer_isLayeringLow a) (fun _ => ((b.toNNReal : NNReal) : ℝ)))

end

