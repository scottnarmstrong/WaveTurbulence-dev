open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable (P : WTParams) [Fact (P.γ ≤ 1 / 2)] (hM9 : Famb.NormalChartSupply P.γ) {R : ℕ} (J : Finset (Fin (2 * R))) (σ kSel : Fin (2 * R) → Option ℕ)
  (Rs : Fin (2 * R) → ℝ) (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R)) (mk : Fama.Stage1Mk.MarkFn P.γ (2 * R)) (b : ℝ)

/-- **`hM`**: the unit masses in the engine's form. -/
theorem hM_genLow (hC : 0 ≤ P.C₁) (hL : 0 ≤ P.L) (j : Fin (Fama.unitBlocks P.γ a.prime.skeleton a.totalSigma (mk a.prime)).length) :
    0 ≤ M0GenLow P hM9 J σ kSel Rs a mk b j ∧ M0GenLow P hM9 J σ kSel Rs a mk b j ≤
      (P.C₁ * Real.sqrt P.δ) ^ (cl2GenLow a mk j) *
        P.L ^ (-(P.η ^ 8) * (gjGenLow P hM9 a mk j : ℝ) - P.η ^ 2 / 2 * (njGenLow hM9 a mk j : ℝ) + P.η ^ 7) *
        lfjGenLow P J σ kSel Rs a mk b j := by
  refine ⟨mul_nonneg (pow_nonneg topFilterMass_nonneg _) (unitMassC_nonnegLow P hM9 a mk b hC hL j), le_of_eq ?_⟩
  unfold M0GenLow lfjGenLow cl2GenLow gjGenLow njGenLow unitMassCLow unitMassLow
  rw [nor_card_eqLow hM9 (Fama.sourceAssemblyMk P.γ a mk j)]
  simp only [neg_mul]
  ring

end

