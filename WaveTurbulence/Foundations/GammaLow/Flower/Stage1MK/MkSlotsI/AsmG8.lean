variable (P : WTParams) [Fact (P.γ ≤ 1 / 2)] (hM9 : Famb.NormalChartSupply P.γ) {R : ℕ} (J : Finset (Fin (2 * R))) (σ kSel : Fin (2 * R) → Option ℕ)
