variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable (P : WTParams) [Fact (P.γ ≤ 1 / 2)] (hM9 : Famb.NormalChartSupply P.γ) {R : ℕ} (J : Finset (Fin (2 * R))) (σ kSel : Fin (2 * R) → Option ℕ)
  (Rs : Fin (2 * R) → ℝ) (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R)) (mk : Fama.Stage1Mk.MarkFn P.γ (2 * R)) (b : ℝ)

theorem unitMassC_nonnegLow (hC : 0 ≤ P.C₁) (hL : 0 ≤ P.L)
    (j : Fin (Fama.unitBlocks P.γ a.prime.skeleton a.totalSigma (mk a.prime)).length) :
    0 ≤ unitMassCLow P hM9 (Fama.sourceAssemblyMk P.γ a mk j) a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a) (frontierConst P.d) b.toNNReal := by
  unfold unitMassCLow unitMassLow
  have hc0 : 0 ≤ frontierConst P.d := le_trans zero_le_one (one_le_frontierConst _)
  refine mul_nonneg (pow_nonneg hc0 _) ?_
  exact mul_nonneg (mul_nonneg (pow_nonneg (mul_nonneg hC (Real.sqrt_nonneg _)) _) (Real.rpow_nonneg hL _))
    (WaveTurbulence.VineEstS5C.regionLeafSize_const_nonneg _ _ _ _ _ (NNReal.coe_nonneg _))

end

