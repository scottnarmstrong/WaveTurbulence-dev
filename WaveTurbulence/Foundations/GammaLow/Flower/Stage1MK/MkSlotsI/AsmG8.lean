/-- The unit masses (B3-2: `topFilterMass^{|SU j|}` times B3's `unitMassCLow`). -/
def M0GenLow (j : Fin (Fama.unitBlocks P.γ a.prime.skeleton a.totalSigma (mk a.prime)).length) : ℝ :=
  topFilterMass ^ (SUGenLow P J σ kSel Rs a mk j).length *
    unitMassCLow P hM9 (Fama.sourceAssemblyMk P.γ a mk j) a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)
      (frontierConst P.d) b.toNNReal

