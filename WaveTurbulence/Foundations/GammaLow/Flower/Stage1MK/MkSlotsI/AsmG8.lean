/-- **`hhinge`**: the hinge data of the class kernels `unitKerGenLow` (B3-2's `unit_hinge_dataWMkL`) with the domain
conjunct on `domOfLow ∩ pinSet` (`hHkPropD_pieceGenAtLow`), for every vector of unit modes `lam`. -/
theorem hhinge_genLow (P : WTParams) [Fact (P.γ ≤ 1 / 2)] (hV : V5FrontierClassBoundAtLLow P) (hM9 : Famb.NormalChartSupply P.γ)
    (hgate : CoherentGateH P) (hinc : IncoherentGateH P) (htop : TopIncoherentDecayAtR P)
    (hd1 : 1 ≤ P.d) (hη0 : 0 < P.η) (hη6 : 6 * P.η ^ 6 ≤ P.η)
    (hη2 : P.η ≤ 1 / 2) (hC1 : 1 ≤ P.C₁) (hδ : 0 < P.δ) (hL1 : 1 ≤ P.L) (hL2 : 2 ≤ P.L)
    (hw : 0 ≤ P.gamma1 - Real.sqrt P.η)
    {p : ℕ} (hp : p < P.D) {R : ℕ} (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat) (t s : ℝ)
    (kSel σ : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ) (hRs : ∀ j, P.L ≤ Rs j) (mkF : Fama.Stage1Mk.MarkFn P.γ (2 * R))
    (hsub : ∀ {LG : LayeredGarden (2 * R)} (B : PrimeData LG), markILow (γF := P.γ) J pat t s kSel B ⊆ mkF B)
    (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R)) (hG : CapGeo a.layered J p) (hpat : CapPatValid a.layered J pat p)
    (hroot : ∀ j ∉ J, ∃ ℓ : GLeaf a.layered.garden.tree, IsCapFlower a.layered J ℓ ∧ ℓ.1.1 = j)
    (hs : s ∈ Set.Ioo (p : ℝ) t) (ht : t < p + 1) (dag : Option (Fin (2 * R) → Fin 3 → Mom P.d))
    (mk : Fama.Stage1Mk.MarkFn P.γ (2 * R)) (hset : mk a.prime = classMkLow mkF a)
    (hcan : IsCanonGC (p + 1) a.layered) (hord : (a.prime.data.garden a.prime.prime.1).order ≤ P.N (p + 1) ^ 4)
    (roots : Fin (2 * R) → (Fin P.d → ℤ)) (h : ℕ → Fin (2 * R) → Fin (2 * R) → Mom P.d → ℝ) (b : ℝ) (hb : 0 ≤ b)
    (hsn : ∀ q ≤ p, ∀ j j', SNormR (40 * P.d) (40 * P.d) (h q j j') ≤ ENNReal.ofReal b)
    (Rf : Fin (2 * R) → Option ℝ) (hRf : ∀ j r, Rf j = some r → P.L / 2 ≤ r)
    (lam : Fin (Fama.unitBlocks P.γ a.prime.skeleton a.totalSigma (mk a.prime)).length → ℤ) :
    ∃ (H : HingeFam (Fin (Fama.unitBlocks P.γ a.prime.skeleton a.totalSigma (mk a.prime)).length) P.d)
      (Mh : Fin (Fama.unitBlocks P.γ a.prime.skeleton a.totalSigma (mk a.prime)).length → ℝ),
      (∀ j c', ∑' l, H.w j c' l ≤ Mh j) ∧
      mkSlotsS_HHkPropDLow (pieceGenAtLow P J pat t s kSel σ Rs a (mk a.prime) dag).toStage1PieceGD (fun _ => t) 0 roots
        (selSkCMkLow a mk P.L P.γ P.η (lt_of_lt_of_le zero_lt_one hL1).ne' 0 roots)
        (domOfLow (pieceGenAtLow P J pat t s kSel σ Rs a (mk a.prime) dag) (fun _ => t) ∩
          MkSlotsB.pinSet (pieceGenAtLow P J pat t s kSel σ Rs a (mk a.prime) dag).fix)
        ((Fama.stShape P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).hclk
          (Fama.unitBlkMk_disj (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)))
        ((Fama.stShape P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).hmom
          (Fama.unitBlkMk_disj (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)))
        (fun j => unitKerGenLow P p J σ kSel Rs a mk h Rf j (lam j)) H ∧
      ∏ j, Mh j ≤ (∏ j, (ChFWLLow P.d P.η * M0GenLow P hM9 J σ kSel Rs a mk b j)) *
        ∏ j, (1 + |((lam j : ℤ) : ℝ)|) ^ (6 * P.η ^ 6) := by
  have hL0 : 0 < P.L := lt_of_lt_of_le zero_lt_one hL1
  have hc0 : 0 ≤ frontierConst P.d := le_trans zero_le_one (one_le_frontierConst _)
  have hgp : ∀ j, GPresented (32 * P.d) (frontierG (Rf j)) (frontierConst P.d) := fun j =>
    gPresented_frontierG P.d (Rf j) (fun r hr => by have := hRf j r hr; linarith)
  have hSU : ∀ j, ∀ x ∈ SUGenLow P J σ kSel Rs a mk j, 0 < x := by
    intro j x hx
    unfold SUGenLow SURepLow MkSlotsT.SUStem at hx
    split_ifs at hx
    · exact lt_of_lt_of_le one_pos (one_le_radTGen hL1 hRs _ x hx)
    · simp at hx
  obtain ⟨H, Mh, hsum', hHk, hprod⟩ := unit_hinge_dataWMkLLow P hV hM9 hgate hinc htop hd1 hη0 hη6 hη2 hC1
    hδ hL1 hw hp a mk hcan hord (fun _ => t) 0 roots (fun j => frontierG (Rf j)) (frontierConst P.d)
    (one_le_frontierConst _) hgp (fun j x => frontierG_im _ x) (SUGenLow P J σ kSel Rs a mk) hSU h b hb
    (fun q j j' hq => hsn q hq j j') lam
  refine ⟨H, Mh, hsum', hHkPropD_pieceGenAtLow P J pat t s kSel σ Rs mkF hsub a hG hpat hroot hs ht dag (mk a.prime)
    hset roots _ _ H hHk, ?_⟩
  have hpt : ∀ j, ChinFWLLow P.d P.η *
      unitMassFWLLow P (SUGenLow P J σ kSel Rs a mk j) hM9 (Fama.sourceAssemblyMk P.γ a mk j) a.prime.data
        a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) (frontierConst P.d) b ≤
      ChFWLLow P.d P.η * M0GenLow P hM9 J σ kSel Rs a mk b j := fun j => by
    have e : ChinFWLLow P.d P.η *
        unitMassFWLLow P (SUGenLow P J σ kSel Rs a mk j) hM9 (Fama.sourceAssemblyMk P.γ a mk j) a.prime.data
          a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) (frontierConst P.d) b =
        ChinFWLLow P.d P.η * M0GenLow P hM9 J σ kSel Rs a mk b j := by
      unfold unitMassFWLLow M0GenLow unitMassCLow
      rw [Real.coe_toNNReal b hb]
      ring
    rw [e]
    exact mul_le_mul_of_nonneg_right (le_max_right _ _)
      (mul_nonneg (pow_nonneg topFilterMass_nonneg _) (unitMassC_nonnegLow P hM9 a mk b (by linarith) hL0.le j))
  have hlam : 0 ≤ ∏ j, (1 + |((lam j : ℤ) : ℝ)|) ^ (6 * P.η ^ 6) :=
    Finset.prod_nonneg fun j _ => Real.rpow_nonneg (by positivity) _
  have hch := ChinFWL_specLow P.d P.η hη0.le
  rw [hprod, ← Finset.card_univ, ← Finset.prod_const, ← Finset.prod_mul_distrib]
  exact mul_le_mul_of_nonneg_right (Finset.prod_le_prod₀ (fun j _ => mul_nonneg hch
    (unitMassFWL_nonnegLow P _ hM9 _ _ _ _ _ _ b hc0 (by linarith) hL0 hb))
    (fun j _ => hpt j)) hlam

end

