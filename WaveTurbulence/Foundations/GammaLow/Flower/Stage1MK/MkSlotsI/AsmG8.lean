/-- B3's incoherence exponents of the units. -/
def gjGenLow (j : Fin (Fama.unitBlocks P.γ a.prime.skeleton a.totalSigma (mk a.prime)).length) : ℕ :=
  Famb.VineEstS3.cohmolIndexΓ (Fama.sourceAssemblyMk P.γ a mk j) a.prime.data a.prime.prime.1 (sourceLayerLow a) +
    (Famb.VineEstS3.step3DΓ hM9 (Fama.sourceAssemblyMk P.γ a mk j) a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)
      (Famb.VineEstS3.canonBadKindΓ hM9 (Fama.sourceAssemblyMk P.γ a mk j) a.prime.data a.prime.prime.1 (sourceLayerLow a))
      (qOutOf a.prime.data a.prime.prime.1 (sourceLayerLow a)
        (Fama.unitBlkMk P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).upper
        (Fama.unitBlkMk P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).lower
        (regionOf (Fama.unitBlkMk P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j)))
      (fun _ => (0 : Mom P.d)) (0 : Mom P.d)).M₁

end

