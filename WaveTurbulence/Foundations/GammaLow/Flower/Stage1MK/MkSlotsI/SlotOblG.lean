open scoped Classical ENNReal
open WaveTurbulence WaveTurbulence.LGSpine WaveTurbulence.Induct Set Finset MeasureTheory
open WaveTurbulence.Reg WaveTurbulence.Reg.Skeleton WaveTurbulence.RegRed WaveTurbulence.Represents
open WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden WaveTurbulence.VineEstS3 WaveTurbulence.VineEstS3.FS WaveTurbulence.RepAnalytic WaveTurbulence.VineAlign
open WaveTurbulence.Flower.MkDefs WaveTurbulence.Flower.Stage1W WaveTurbulence.Flower.Stage1WNoVine
open WaveTurbulence.Flower.Stage1MKGate
open WaveTurbulence.Flower.MkSlots (anchProfiles recLG IsCapPair capTreeOf stA fixCore)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w d : ℕ}

/-- The per-record obligation is monotone in the large constants (it reads `C₁` only through `C ≥ C₁`). -/
theorem genSlotObligationAt_monoLow (Kg : ℕ → ℝ → ℝ) :
    LargeConstantMonotone (fun P => ∀ hγP : P.γ ≤ 1 / 2, haveI := Fact.mk hγP; GenSlotObligationAtLow Kg P) := by
  intro P c₁ c₂ _ _ _ _ h₁ _ h hγP C hC R p a J pat t s hp hcan hsz
  exact h hγP C (h₁.trans hC) (R := R) (p := p) a J pat t s hp hcan (by rw [← vineEstHalfMK_N P c₁ c₂ (p + 1)]; exact hsz)

end

