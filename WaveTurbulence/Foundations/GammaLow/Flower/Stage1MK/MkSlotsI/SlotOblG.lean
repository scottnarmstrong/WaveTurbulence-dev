/-- **`GenSlotObligationLow`** — the ONE isolated hypothesis of the general assembly (B3s-HELPER7). -/
def GenSlotObligationLow : Prop :=
  ∃ Kg : ℕ → ℝ → ℝ, (∀ d η, 1 ≤ Kg d η) ∧ WTPrefix (fun P => ∀ hγP : P.γ ≤ 1 / 2, haveI := Fact.mk hγP; GenSlotObligationAtLow Kg P)

end

