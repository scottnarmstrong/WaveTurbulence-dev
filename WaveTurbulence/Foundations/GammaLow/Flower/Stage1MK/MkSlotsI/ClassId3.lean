/-- The clock pins of the outer slots are common to the run class. -/
theorem clkPin_memberLow (tt : Fin (2 * R) → ℝ)
    (s' : ReplacementSlot (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G) (i : Fin 2) :
    clkPin tt (fixCore y.1.data y.1.plain
        (fixCap (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J pat t s))
        (argSrc y.1.plain ((memShapeLow a mk y hy).iota y.1.plain hG s') i) =
      clkPin tt (fixCore a.prime.data a.prime.prime.1 (fixCap (recLGLow a) J pat t s))
        (argSrc a.prime.prime.1
          ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).iota a.prime.prime.1 hG s')
          i) := by
  rcases clk_corrLow a mk y hy hG J hcapA hcapY pat t s hrepUP s' i with ⟨r, h1, h2⟩ | ⟨by', ba, h1, h2, h3⟩
  · rw [h1, h2]; rfl
  · rw [h1, h2]; exact h3

include hy hG hcapA hcapY hrepUP in

end

