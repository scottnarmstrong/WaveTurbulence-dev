/-- **The clock sources of the outer slots correspond**: root clocks are equal, branch clocks carry equal pins. -/
theorem clk_corrLow (s' : ReplacementSlot (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G) (i : Fin 2) :
    (∃ r, argSrc y.1.plain ((memShapeLow a mk y hy).iota y.1.plain hG s') i = .inl r ∧
        argSrc a.prime.prime.1
          ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).iota a.prime.prime.1 hG s') i
          = .inl r) ∨
      ∃ by' ba, argSrc y.1.plain ((memShapeLow a mk y hy).iota y.1.plain hG s') i = .inr by' ∧
        argSrc a.prime.prime.1
          ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).iota a.prime.prime.1 hG s') i
          = .inr ba ∧
        fixCore y.1.data y.1.plain
            (fixCap (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J pat t s)
            by' =
          fixCore a.prime.data a.prime.prime.1 (fixCap (recLGLow a) J pat t s) ba := by
  have hroute := congrFun (congrFun (memShape_routeLow a mk y hy hG) s') i
  rcases hr' : (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).route
      a.prime.prime.1 hG s' i with y' | j
  · rw [hr'] at hroute
    rw [(memShapeLow a mk y hy).route_inl _ hG hroute,
      (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).route_inl _ hG hr']
    rcases y' with r | c
    · exact Or.inl ⟨r, rfl, rfl⟩
    · refine Or.inr ⟨(memShapeLow a mk y hy).br c,
        (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).br c, rfl, rfl, ?_⟩
      exact (member_fixCap_patLow a mk y hy hG J hcapA hcapY pat t s hrepUP c).trans
        (MkSlotsB.fixCap_decoded_eq a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) a.layered
          (sourceLayer_reconstructsLow a) a.prime.decodes J pat t s _)
  · rw [hr'] at hroute
    rw [(memShapeLow a mk y hy).route_inr _ hG hroute,
      (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).route_inr _ hG hr']
    refine Or.inr ⟨_, _, rfl, rfl, ?_⟩
    show fixCap _ J pat t s _ = fixCap _ J pat t s _
    rw [member_fix_unit_patLow a mk y hy hG J hcapA hcapY pat t s hrepUP j _ (lower_mem _),
      hrepUP j _ (lower_mem _)]

include hy hG hcapA hcapY hrepUP in

