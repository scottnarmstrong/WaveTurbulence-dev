/-- **The member's general slot box is the representative's** `genBoxAtLow`. -/
theorem genSlotBox_memberLow (tt : Fin (2 * R) → ℝ)
    (s' : ReplacementSlot (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G) :
    genSlotBox p (fun b => stateLayer y.1 (y.1.data.coreBranch y.1.plain b).toNode) y.1.plain tt
        (fixCore y.1.data y.1.plain
          (fixCap (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J pat t s))
        ((memShapeLow a mk y hy).iota y.1.plain hG s') =
      genSlotBox p (fun b => sourceLayerLow a (a.prime.data.coreBranch a.prime.prime.1 b).toNode) a.prime.prime.1 tt
        (fixCore a.prime.data a.prime.prime.1 (fixCap (recLGLow a) J pat t s))
        ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).iota a.prime.prime.1 hG s') := by
  ext ts
  unfold genSlotBox
  simp only [Set.mem_ofPred_eq, clkPin_memberLow a mk y hy hG J hcapA hcapY pat t s hrepUP tt s',
    memShape_slotBoxLow a mk y hy hG s']

end

