variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {R p : ℕ} {kind : Bool} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R))
  (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (hy : y ∈ Fama.sourceClass γF a p kind mk)
  (hG : (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.IsPlain)
  (J : Finset (Fin (2 * R)))
  (hGeoA : CapGeo (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)) J p)
  (hGeoY : CapGeo (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J p)
  (pat : Fin (2 * R) → FixPat) (t s : ℝ)
  (hrepUP : ∀ j, ∀ b ∈ (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).atoms,
    fixCap (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)) J pat t s
      (a.prime.data.coreBranch a.prime.prime.1 b) = none)

include hy hG hGeoA hGeoY hrepUP in
/-- **The lower bounds at the unit lowers are common to the run class.** -/
theorem member_lbS_lowerLow (j : Fin (Fama.unitBlocks γF a.prime.skeleton a.totalSigma (mk a.prime)).length) :
    MkSlotsB.lbS y.1.data y.1.plain
        (fixCap (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J pat t s) s
        (unitClBlock (y.2 j)).lower =
      MkSlotsB.lbS a.prime.data a.prime.prime.1
        (fixCap (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)) J pat
          t s) s (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).lower := by
  have hcapA : ∀ j ∈ J, (a.prime.data.garden a.prime.prime.1).tree j = TTree.leaf := hGeoA.cap_leaf
  have hcapY : ∀ j ∈ J, (y.1.data.garden y.1.plain).tree j = TTree.leaf := hGeoY.cap_leaf
  have hfy : MkSlots.fixCore y.1.data y.1.plain
      (fixCap (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J pat t s)
      (unitClBlock (y.2 j)).lower = none :=
    member_fix_unit_patLow a mk y hy hG J hcapA hcapY pat t s hrepUP j _ (lower_mem _)
  have hfa : MkSlots.fixCore a.prime.data a.prime.prime.1
      (fixCap (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)) J pat
        t s) (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).lower = none :=
    hrepUP j _ (lower_mem _)
  have hroute := memShape_routeLow a mk y hy hG
  have hdy := Fama.source_disjMk a mk y hy
  have hda := Fama.unitBlkMk_disj (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)
  rw [lbS_eq_leaf y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) J hcapY pat t s,
    lbS_eq_leaf a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J hcapA pat t s]
  refine if_congr ⟨fun h => ⟨hfa, ?_⟩, fun h => ⟨hfy, ?_⟩⟩ rfl rfl
  · exact leafPinBelow_transfer (memShapeLow a mk y hy)
      (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)) y.1.plain a.prime.prime.1 hcapY
      _ _ _ hfy (fun m hm => clk_lower_transfer _ _ y.1.plain a.prime.prime.1 hG hdy hda hroute m j hm)
      (fun m hm => (member_leafPin_iffLow a mk y hy hG J hGeoA hGeoY pat t s hrepUP m).mp hm) h.2
  · exact leafPinBelow_transfer (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime))
      (memShapeLow a mk y hy) a.prime.prime.1 y.1.plain hcapA
      _ _ _ hfa (fun m hm => clk_lower_transfer _ _ a.prime.prime.1 y.1.plain hG hda hdy hroute.symm m j hm)
      (fun m hm => (member_leafPin_iffLow a mk y hy hG J hGeoA hGeoY pat t s hrepUP m).mpr hm) h.2

include hy hG hGeoA hGeoY hrepUP in

end

section
open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkSlotsI
open scoped Classical
open WaveTurbulence WaveTurbulence.LGSpine Finset TTree
open WaveTurbulence.Reg WaveTurbulence.Reg.Skeleton WaveTurbulence.RegRed WaveTurbulence.LFTwist
open WaveTurbulence.Flower.MkDefs WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden
open WaveTurbulence.RedSplice WaveTurbulence.VineB WaveTurbulence.VineC WaveTurbulence.Flower.MkUnits
open WaveTurbulence.Represents WaveTurbulence.VineEstS4 WaveTurbulence.Flower.Stage1W WaveTurbulence.VineAlign WaveTurbulence.Stage1 WaveTurbulence.Twist WaveTurbulence.Flower.Stage1WVine
open WaveTurbulence.Flower.MkSlots
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {R p : ℕ} {kind : Bool} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R))
  (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (hy : y ∈ Fama.sourceClass γF a p kind mk)
  (hG : (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.IsPlain)
  (J : Finset (Fin (2 * R)))
  (hGeoA : CapGeo (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)) J p)
  (hGeoY : CapGeo (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J p)
  (pat : Fin (2 * R) → FixPat) (t s : ℝ)
  (hrepUP : ∀ j, ∀ b ∈ (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).atoms,
    fixCap (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)) J pat t s
      (a.prime.data.coreBranch a.prime.prime.1 b) = none)

include hy hG hGeoA hGeoY hrepUP in
/-- **The lower bounds at the clock branches of the outer slots are common to the run class.** -/
theorem member_lbS_clkLow (s' : ReplacementSlot (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G) (i : Fin 2)
    (by' : GBranch y.1.skeleton.tree) (ba : GBranch a.prime.skeleton.tree)
    (hby : argSrc y.1.plain ((memShapeLow a mk y hy).iota y.1.plain hG s') i = .inr by')
    (hba : argSrc a.prime.prime.1
      ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).iota a.prime.prime.1 hG s') i =
        .inr ba) :
    MkSlotsB.lbS y.1.data y.1.plain
        (fixCap (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J pat t s) s
        by' =
      MkSlotsB.lbS a.prime.data a.prime.prime.1
        (fixCap (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)) J pat
          t s) s ba := by
  have hroute := memShape_routeLow a mk y hy hG
  rcases (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).route_natural a.prime.prime.1
      hG s' i with hr | ⟨j, hj⟩
  · have hr' : (memShapeLow a mk y hy).route y.1.plain hG s' i = .inl (argSrc hG s' i) := by
      rw [hroute]; exact hr
    rw [SpliceShape.route_inl _ _ _ hr] at hba
    rw [SpliceShape.route_inl _ _ _ hr'] at hby
    rcases hx : argSrc hG s' i with r | c'
    · rw [hx] at hba
      exact absurd hba (by simp [SpliceShape.srcMap])
    · rw [hx] at hba hby
      obtain rfl : (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).br c' = ba :=
        Sum.inr_injective hba
      obtain rfl : (memShapeLow a mk y hy).br c' = by' := Sum.inr_injective hby
      exact member_lbS_br_repLow a mk y hy hG J hGeoA hGeoY pat t s hrepUP c'
  · have hj' : (memShapeLow a mk y hy).route y.1.plain hG s' i = .inr j := by
      rw [hroute]; exact hj
    rw [SpliceShape.route_inr _ _ _ hj] at hba
    rw [SpliceShape.route_inr _ _ _ hj'] at hby
    obtain rfl := Sum.inr_injective hba
    obtain rfl := Sum.inr_injective hby
    exact member_lbS_lowerLow a mk y hy hG J hGeoA hGeoY pat t s hrepUP j

end

end WaveTurbulence.GammaLow.Flower
