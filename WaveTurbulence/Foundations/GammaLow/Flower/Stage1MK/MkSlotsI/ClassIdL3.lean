open WaveTurbulence.Flower.MkSlots
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {R p : ℕ} {kind : Bool} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R))
  (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (hy : y ∈ Fama.sourceClass γF a p kind mk)
  (hG : (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.IsPlain)
  (J : Finset (Fin (2 * R)))
  (hGeoA : CapGeo (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)) J p)
  (hGeoY : CapGeo (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J p)
  (pat : Fin (2 * R) → FixPat) (t s : ℝ)
  (hrepUP : ∀ j, ∀ b ∈ (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).atoms,
    fixCap (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)) J pat t s
      (a.prime.data.coreBranch a.prime.prime.1 b) = none)

include hGeoA hrepUP in
/-- **The representative's lower bounds at the old names of the `G_sb` atoms are the piece's `lbGenAtLow`.** -/
theorem rep_lbS_brLow (c : GBranch (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.tree) :
    MkSlotsB.lbS a.prime.data a.prime.prime.1
        (fixCap (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)) J pat
          t s) s ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).br c) =
      lbGenAtLow J pat t s a (mk a.prime) c := by
  have hcapA : ∀ j ∈ J, (a.prime.data.garden a.prime.prime.1).tree j = TTree.leaf := hGeoA.cap_leaf
  have hfix := fixAt_eq_fixCoreLow a mk J pat t s c
  have hpin : (∃ u, PinTopBelowAtLow J pat t s a (mk a.prime) c u) ↔
      ∃ u : GBranch (a.prime.data.forest a.prime.prime.1),
        (fixCap (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)) J pat
          t s u).isSome ∧
        u.IsChildOf (a.prime.data.coreBranch a.prime.prime.1
          ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).br c)) ∧
        ∀ c', a.prime.data.coreBranch a.prime.prime.1
          ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).br c') ≠ u :=
    pinChild_decoded a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J pat t s a.layered
      (sourceLayer_reconstructsLow a) a.prime.decodes
      (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).br _
  have hch := fun hfree => pinChild_iff a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J
    hcapA pat t s (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).br
    (rep_core_none_of_not_brLow a mk J pat t s hrepUP)
    ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).br c) hfree
  rw [lbS_eq_leaf a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J hcapA pat t s]
  unfold lbGenAtLow
  by_cases h : MkSlots.fixCore a.prime.data a.prime.prime.1
      (fixCap (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)) J pat
        t s) ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).br c) = none ∧
      LeafPinBelow a.prime.data a.prime.prime.1
        (fixCap (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)) J
          pat t s) ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).br c)
  · rw [ite_eq_left h, ite_eq_left]
    refine ⟨?_, hfix.trans h.1, hpin.mpr ((hch h.1).mpr h.2)⟩
    have hs : (MkSlotsB.lbS a.prime.data a.prime.prime.1
        (fixCap (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)) J pat
          t s) s ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).br c)).isSome := by
      rw [lbS_eq_leaf a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J hcapA pat t s,
        ite_eq_left h]
      rfl
    have hd := MkSlotsB.lbS_dParent a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J hcapA
      pat t s _ hs
    rwa [IntCore.br_fst] at hd
  · rw [ite_eq_right h, ite_eq_right]
    rintro ⟨-, h1, h2⟩
    have hfree := hfix.symm.trans h1
    exact h ⟨hfree, (hch hfree).mp (hpin.mp h2)⟩

include hy hG hGeoA hGeoY hrepUP in

end

