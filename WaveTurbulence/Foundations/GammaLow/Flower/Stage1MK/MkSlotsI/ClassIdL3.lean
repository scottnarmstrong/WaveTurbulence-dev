/-- The cores of the skeleton branches of `a` outside the image of `Φ_a` (unit atoms) are unpinned. -/
theorem rep_core_none_of_not_brLow (b' : GBranch a.prime.skeleton.tree)
    (hb : ∀ c', (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).br c' ≠ b') :
    fixCap (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)) J pat t s
      (a.prime.data.coreBranch a.prime.prime.1 b') = none := by
  rcases ret_or_interior (blk := Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime))
      b'.toNode with h | ⟨j, hj, -⟩
  · obtain ⟨c', hc'⟩ := (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).exists_br h
    exact absurd hc' (hb c')
  · exact hrepUP j b' ((branch_real_iff _ _).mp hj)

end

