open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w : ℕ}
variable {R : ℕ} (J : Finset (Fin (2 * R))) (L : ℝ) (σ kSel : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ)
  (mkF : Fama.Stage1Mk.MarkFn γF (2 * R)) (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R))

/-- **No filter at a hinge** (a hinge is never a residual selected atom). -/
theorem filtW_filtGen_hingeLow (pat : Fin (2 * R) → FixPat) (t s : ℝ)
    (hsub : ∀ {LG : LayeredGarden (2 * R)} (B : PrimeData LG), markILow (γF := γF) J pat t s kSel B ⊆ mkF B)
    {c : GBranch (stALow mkF a).G.tree} (hh : c ∈ (stALow mkF a).hinges) (x : ℝ) :
    MkSlotsT.filtW (filtGenLow J L σ kSel Rs mkF a c) x = 1 := by
  have hc : c ∉ selRGenLow J kSel mkF a := fun h => selROf_not_hingeLow pat t s hsub h hh
  have hh' : c ∈ (shapeRepLow mkF a).hinges (unitsRep_disjLow mkF a) := by
    rw [shapeRep_hingesLow]; exact hh
  rw [filtGen_not_selLow hc, MkSlotsT.filtStem_hinge _ _ _ _ _ _ _ _ _ c hh']
  rfl

end

section
open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkSlotsI
open scoped Classical
open WaveTurbulence WaveTurbulence.LGSpine Finset
open WaveTurbulence.Reg WaveTurbulence.Reg.Skeleton WaveTurbulence.RegRed
open WaveTurbulence.Flower.MkDefs WaveTurbulence.Flower.Stage1MKGate
open WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden
open WaveTurbulence.RedSplice (stSt)
open WaveTurbulence.Flower.MkSlots (stA coreOf sibIndOf recLG)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w : ℕ}

/-- **The atom weight of `G_sb` is the general piece's atom weight** (up to `chiDNorm ^ #selR`): on a decoration `z`
of `G_sb = (stALow mkF a).G`, `zatomGLow z` times the dagger sibling indicator of the piece at the coset decoration is
`chiDNorm ^ #(selRGen …)` times the piece's atom weight `pieceAtomW (pieceGen …)` (filters `filtGen`: `(Rs, chiDNS)` at
a residual selected atom — `chiD = chiDNorm · chiDN` —, γ's `filtStem` with `radGen = radRaw` elsewhere, nothing at a
hinge; σ's filter at the residual selected atoms inside the indicator `indGen`). -/
theorem zatomG_mul_sibIndLow (P : WTParams) [Fact (P.γ ≤ 1 / 2)] {R : ℕ} (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat) (t s : ℝ)
    (kSel σ : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ) (mkF : Fama.Stage1Mk.MarkFn P.γ (2 * R))
    (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R)) (dag : Option (Fin (2 * R) → Fin 3 → Mom P.d))
    (hsub : ∀ {LG : LayeredGarden (2 * R)} (B : PrimeData LG), markILow (γF := P.γ) J pat t s kSel B ⊆ mkF B)
    (hL : 1 ≤ P.L) (hRs : ∀ j, P.L ≤ Rs j) {roots : Fin (2 * R) → (Fin P.d → ℤ)}
    (z : GenDecoration (stALow mkF a).G P.d roots 0) :
    zatomGLow J P.L σ kSel Rs a (classMkLow mkF a) z *
        ((sibIndOfLow J mkF a dag (flwGenLow J mkF a) (cosetDecoration (stALow mkF a).G P.L 0 z.1) : ℝ) : ℂ) =
      (chiDNorm : ℂ) ^ (selRGenLow J kSel mkF a).card *
        pieceAtomWLow (pieceGenLow P J pat t s kSel σ Rs mkF a dag)
          (cosetDecoration (stALow mkF a).G P.L 0 z.1) := by
  set k := cosetDecoration (stALow mkF a).G P.L 0 z.1
  set selR := selRGenLow J kSel mkF a
  set H := (stALow mkF a).hinges
  set F : GBranch (stALow mkF a).G.tree → ℂ := fun c =>
    MkSlotsT.filtW (filtGenLow J P.L σ kSel Rs mkF a c) (omegaNode (stALow mkF a).G k c)
  set Rr : GBranch (stALow mkF a).G.tree → ℂ := fun c =>
    (MkSlotsT.radProd (MkSlotsT.radSigma P.L σ c) (omegaNode (stALow mkF a).G k c) : ℂ)
  have hselH : ∀ c ∈ selR, c ∉ H := fun c hc => selROf_not_hingeLow pat t s hsub hc
  -- the atom weight, atom by atom
  have hg : ∀ c ∈ univ.filter (fun c => c ∉ H),
      genNW (recLGLow a) J P.L σ kSel Rs (coreRecLow a (classMkLow mkF a) c).toNode (omegaNode (stALow mkF a).G k c) =
        F c * (if c ∈ selR then (chiDNorm : ℂ) * Rr c else 1) := by
    intro c hc
    have hcH : c ∉ H := (mem_filter.1 hc).2
    by_cases hs : c ∈ selR
    · rw [genNW_coreRec_selLow J P.L σ kSel Rs mkF a hs, ite_eq_left hs]
      have hF : F c = MkSlotsS.chiDNS (omegaNode (stALow mkF a).G k c / Rs c.1.1) := by
        show MkSlotsT.filtW (filtGenLow J P.L σ kSel Rs mkF a c) _ = _
        rw [filtGen_selLow hs]
        rfl
      rw [hF]
      ring
    · rw [genNW_coreRec_not_selLow J P.L σ kSel Rs mkF a hL hRs hcH hs, ite_eq_right hs, mul_one]
  have hz : zatomGLow J P.L σ kSel Rs a (classMkLow mkF a) z =
      (∏ c, F c) * ((chiDNorm : ℂ) ^ selR.card * ∏ c ∈ selR, Rr c) := by
    rw [zatomG_eqLow, Finset.prod_congr rfl hg, Finset.prod_mul_distrib]
    congr 1
    · refine Finset.prod_filter_of_ne fun c _ hne => ?_
      intro hcH
      exact hne (filtW_filtGen_hingeLow J P.L σ kSel Rs mkF a pat t s hsub hcH _)
    · rw [Finset.prod_ite_mem, Finset.inter_eq_right.2 fun c hc => mem_filter.2 ⟨mem_univ _, hselH c hc⟩,
        Finset.prod_mul_distrib, Finset.prod_const]
  have hp : pieceAtomWLow (pieceGenLow P J pat t s kSel σ Rs mkF a dag) k =
      (∏ c, F c) * (((sibIndOfLow J mkF a dag (flwGenLow J mkF a) k : ℝ) : ℂ) * ∏ c ∈ selR, Rr c) := by
    unfold pieceAtomWLow
    rw [pieceGen_indLow]
    unfold indGenLow
    push_cast
    rfl
  rw [hz, hp]
  ring

end

