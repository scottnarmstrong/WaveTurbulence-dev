theorem zatomG_eqLow {d : ℕ} (J : Finset (Fin w)) (L : ℝ) (σ kSel : Fin w → Option ℕ) (Rs : Fin w → ℝ)
    (a : Fama.VineA.PrescribedPrimeGarden γF w) (Mk : Set (Fama.CLVineG γF a.prime.skeleton)) {roots : Fin w → (Fin d → ℤ)}
    (z : GenDecoration (Fama.stSt γF a.prime.skeleton a.totalSigma Mk).G d roots 0) :
    zatomGLow J L σ kSel Rs a Mk z =
      ∏ c ∈ univ.filter (fun c => c ∉ (Fama.stSt γF a.prime.skeleton a.totalSigma Mk).hinges),
        genNW (recLGLow a) J L σ kSel Rs (coreRecLow a Mk c).toNode
          (omegaNode (Fama.stSt γF a.prime.skeleton a.totalSigma Mk).G
            (cosetDecoration (Fama.stSt γF a.prime.skeleton a.totalSigma Mk).G L 0 z.1) c) := rfl

end

