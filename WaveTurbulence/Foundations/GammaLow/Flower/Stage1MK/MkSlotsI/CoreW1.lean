open WaveTurbulence WaveTurbulence.LGSpine Finset
open WaveTurbulence.Reg WaveTurbulence.Reg.Skeleton WaveTurbulence.RegRed
open WaveTurbulence.Flower.MkDefs WaveTurbulence.Flower.Stage1MKGate
open WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden
open WaveTurbulence.RedSplice (stSt)
open WaveTurbulence.Flower.MkSlots (stA coreOf sibIndOf recLG)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w : ℕ}
variable {R : ℕ} (J : Finset (Fin (2 * R))) (L : ℝ) (σ kSel : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ)
  (mkF : Fama.Stage1Mk.MarkFn γF (2 * R)) (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R))

/-- **At a residual selected atom**: σ's filters and the selected filter `chiDNorm · chiDNS (Ω/Rs)` (no shell). -/
theorem genNW_coreRec_selLow {c : GBranch (stALow mkF a).G.tree} (hc : c ∈ selRGenLow J kSel mkF a) (x : ℝ) :
    genNW (recLGLow a) J L σ kSel Rs (coreRecLow a (classMkLow mkF a) c).toNode x =
      (MkSlotsT.radProd (MkSlotsT.radSigma L σ c) x : ℂ) *
        ((chiDNorm : ℂ) * MkSlotsS.chiDNS (x / Rs c.1.1)) := by
  set b := coreRecLow a (classMkLow mkF a) c
  have hb : b ∈ selSetCap (recLGLow a) J kSel := (coreRec_mem_selSetCap_iffLow J kSel mkF a c).2 hc
  have hcap : selCap (recLGLow a) J kSel b.1.1 = some b := MkSlotsS.selCap_of_mem_selSetCap hb
  have hst : b ∈ stemSetCap (recLGLow a) J b.1.1 := (MkSlotsS.selCap_spec hcap).2
  have hfst : b.1.1 = c.1.1 := coreRec_fstLow mkF a c
  have hshell : MkSlotsG.shellRad (recLGLow a) J kSel Rs b = [] := by
    unfold MkSlotsG.shellRad
    rw [ite_eq_right]
    rintro ⟨v, hv, hne⟩
    rw [hcap] at hv
    exact hne (Option.some.inj hv).symm
  have hrad : MkSlotsG.radRaw (recLGLow a) J L σ kSel Rs b = MkSlotsT.radSigma L σ c := by
    unfold MkSlotsG.radRaw
    rw [hshell, List.append_nil]
    unfold MkSlotsT.radSigma
    rw [hfst]
  rw [genNW_toNode, ite_eq_left ⟨_, hst⟩, ite_eq_left hb, hrad, chiD_abs_div_eq, hfst]

end

