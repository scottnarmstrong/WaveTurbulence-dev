/-- **The atom weight of `G_sb` on a decoration** `z` (coset decoration, base `0`). -/
def zatomGLow {d : ℕ} (J : Finset (Fin w)) (L : ℝ) (σ kSel : Fin w → Option ℕ) (Rs : Fin w → ℝ)
    (a : Fama.VineA.PrescribedPrimeGarden γF w) (Mk : Set (Fama.CLVineG γF a.prime.skeleton)) {roots : Fin w → (Fin d → ℤ)}
    (z : GenDecoration (Fama.stSt γF a.prime.skeleton a.totalSigma Mk).G d roots 0) : ℂ :=
  zatomKLow J L σ kSel Rs a Mk (cosetDecoration (Fama.stSt γF a.prime.skeleton a.totalSigma Mk).G L 0 z.1)

end

