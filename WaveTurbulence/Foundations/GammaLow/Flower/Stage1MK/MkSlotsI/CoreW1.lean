/-- The selected test at the core in the reconstruction is the residual selected set of the piece. -/
theorem coreRec_mem_selSetCap_iffLow (c : GBranch (stALow mkF a).G.tree) :
    coreRecLow a (classMkLow mkF a) c ∈ selSetCap (recLGLow a) J kSel ↔ c ∈ selRGenLow J kSel mkF a := by
  rw [mem_selROfLow]
  exact mem_selSetCap_congr (sourceLayer_reconstructsLow a) J kSel rfl

end

