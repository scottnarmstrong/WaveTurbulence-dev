open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w : ℕ}

/-- **The atom weight of `G_sb`** at a momentum assignment `k`: over the non-hinge atoms `c`, the general stem node
weight at the core of `c` in the reconstruction of `a`, read at the `G_sb` resonance factor `Ω_c(k)`. -/
def zatomKLow {d : ℕ} (J : Finset (Fin w)) (L : ℝ) (σ kSel : Fin w → Option ℕ) (Rs : Fin w → ℝ)
    (a : Fama.VineA.PrescribedPrimeGarden γF w) (Mk : Set (Fama.CLVineG γF a.prime.skeleton))
    (k : GNode (Fama.stSt γF a.prime.skeleton a.totalSigma Mk).G.tree → Mom d) : ℂ :=
  ∏ c ∈ univ.filter (fun c => c ∉ (Fama.stSt γF a.prime.skeleton a.totalSigma Mk).hinges),
    genNW (recLGLow a) J L σ kSel Rs (coreRecLow a Mk c).toNode (omegaNode (Fama.stSt γF a.prime.skeleton a.totalSigma Mk).G k c)

end

