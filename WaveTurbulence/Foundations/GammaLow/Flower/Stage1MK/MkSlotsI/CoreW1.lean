open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkSlotsI
open scoped Classical
open WaveTurbulence WaveTurbulence.LGSpine Finset
open WaveTurbulence.Reg WaveTurbulence.Reg.Skeleton WaveTurbulence.RegRed
open WaveTurbulence.Flower.MkDefs WaveTurbulence.Flower.Stage1MKGate
open WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden
open WaveTurbulence.RedSplice (stSt)
open WaveTurbulence.Flower.MkSlots (stA coreOf sibIndOf recLG)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w : ℕ}
variable {R : ℕ} (J : Finset (Fin (2 * R))) (L : ℝ) (σ kSel : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ)
  (mkF : Fama.Stage1Mk.MarkFn γF (2 * R)) (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R))

/-- **At a non-hinge atom that is not a residual selected atom**: the engine's filter weight of `filtGen`. -/
theorem genNW_coreRec_not_selLow (hL : 1 ≤ L) (hRs : ∀ j, L ≤ Rs j) {c : GBranch (stALow mkF a).G.tree}
    (hh : c ∉ (stALow mkF a).hinges) (hc : c ∉ selRGenLow J kSel mkF a) (x : ℝ) :
    genNW (recLGLow a) J L σ kSel Rs (coreRecLow a (classMkLow mkF a) c).toNode x =
      MkSlotsT.filtW (filtGenLow J L σ kSel Rs mkF a c) x := by
  set b := coreRecLow a (classMkLow mkF a) c
  have hb : b ∉ selSetCap (recLGLow a) J kSel := fun h => hc ((coreRec_mem_selSetCap_iffLow J kSel mkF a c).1 h)
  have hh' : c ∉ (shapeRepLow mkF a).hinges (unitsRep_disjLow mkF a) := by
    rw [shapeRep_hingesLow]; exact hh
  rw [filtGen_not_selLow hc, genNW_toNode]
  unfold MkSlotsT.filtStem
  by_cases hst : MkSlotsT.StemB a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a) J
      (MkSlotsT.coreLG a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)
        ((shapeRepLow mkF a).br c))
  · have hst' : ∃ j, b ∈ stemSetCap (recLGLow a) J j := hst
    rw [ite_eq_left hst', ite_eq_right hb, mul_one, ite_eq_left ⟨hh', hst⟩, MkSlotsT.filtW_filtOfRad,
      MkSlotsG.radGen_eq_raw hL (fun j => hL.trans (hRs j))]
    rfl
  · have hst' : ¬ ∃ j, b ∈ stemSetCap (recLGLow a) J j := hst
    rw [ite_eq_right hst', ite_eq_right (fun h => hst h.2)]
    rfl

end

