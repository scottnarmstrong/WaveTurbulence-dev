/-- The core branch, in the reconstruction `recLGLow a` of `a`, of a branch `c` of the spliced garden at the marked set
`Mk`. -/
abbrev coreRecLow (a : Fama.VineA.PrescribedPrimeGarden γF w) (Mk : Set (Fama.CLVineG γF a.prime.skeleton))
    (c : GBranch (Fama.stSt γF a.prime.skeleton a.totalSigma Mk).G.tree) : GBranch (recLGLow a).garden.tree :=
  a.prime.data.coreBranch a.prime.prime.1 ((Fama.stSt γF a.prime.skeleton a.totalSigma Mk).M.ob c)

end

