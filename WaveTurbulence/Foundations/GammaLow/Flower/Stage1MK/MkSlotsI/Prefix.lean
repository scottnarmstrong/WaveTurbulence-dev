/-- **`ClassRepGen 452` at one parameter record** (the class identity is `classCentreIdentityLow`). -/
theorem classRepGen_atLow (Pg : WTParams) [Fact (Pg.γ ≤ 1 / 2)] (C : ℝ) (E : GateEnv Pg)
    (hη : 0 < Pg.η) (hη4 : Pg.η ≤ 1 / 4) (hδ : 0 < Pg.δ) (hL2 : 2 ≤ Pg.L) (hC2 : 1 ≤ Pg.C₂) (hM9 : Famb.NormalChartSupply Pg.γ)
    (Kg : ℕ → ℝ → ℝ) (hC : CgenLow Pg.d Pg.η Pg.C₁ Kg ≤ C)
    (hV : V5FrontierClassBoundAtLLow (PB Pg C)) (htop : TopIncoherentDecayAtR (PB Pg C))
    (hslot : GenSlotObligationAtLow Kg (PB Pg C)) :
    ClassRepGenLow 452 (withC₁ (PB Pg C) (liftGen Pg.d)) :=
  classRepGen_at_ofLow selNativeBoundLow Pg C E hη hη4 hδ hL2 hC2 hM9 Kg hC hV htop hslot
    (classCentreIdentityLow Kg (PB Pg C))

end

