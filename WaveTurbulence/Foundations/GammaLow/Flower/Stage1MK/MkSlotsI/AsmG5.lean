/-- **The leaf factor of an outer slot**: `b⁻¹` on the cap slots of `G_sb`, times B3's `slotLeaf`. -/
theorem genLeaf_iotaLow {R : ℕ} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (J : Finset (Fin (2 * R))) (b : ℝ)
    (Mk : Set (Fama.CLVineG γF a.prime.skeleton)) (sl : ReplacementSlot (Fama.stSt γF a.prime.skeleton a.totalSigma Mk).G) :
    genLeafLow a J b (iotaAtLow a Mk sl) =
      (if MkSlots.IntMember.IsCapSlot ((Fama.stSt γF a.prime.skeleton a.totalSigma Mk).plain a.prime.prime.1) J sl
        then b⁻¹ else 1) *
      slotLeaf a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) (fun _ => b.toNNReal)
        (iotaAtLow a Mk sl) := by
  rcases sl with q | c
  · show (if IsCapPair a.prime.skeleton a.prime.prime.1 J _ then b⁻¹ else 1) * _ = _
    congr 1
    refine if_congr ?_ rfl rfl
    rw [isCapPair_iota_iff]
    constructor
    · intro h; exact ⟨q, rfl, h⟩
    · rintro ⟨q', hq', h⟩
      cases hq'
      exact h
  · rw [if_neg (by rintro ⟨q, hq, -⟩; cases hq), one_mul]
    rfl

end

