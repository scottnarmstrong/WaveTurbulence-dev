/-- **Conversely, a `SelAdj` outer slot has a non-routed residual selected clock** (a unit lower joint carries no
selection, δ's `coreBranch_unit_not_sel`). -/
theorem adjS_of_selAdj_iotaLow {J : Finset (Fin w)} (pat : Fin w → FixPat) (t s : ℝ) (kSel : Fin w → Option ℕ)
    (mkF : Fama.Stage1Mk.MarkFn γF w) (hsub : ∀ {LG : LayeredGarden w} (B : PrimeData LG), markILow (γF := γF) J pat t s kSel B ⊆ mkF B)
    (a : Fama.VineA.PrescribedPrimeGarden γF w) (Mk : Set (Fama.CLVineG γF a.prime.skeleton)) (hMk : Mk = classMkLow mkF a)
    (sl : ReplacementSlot (Fama.stSt γF a.prime.skeleton a.totalSigma Mk).G)
    (h : SelAdj a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J kSel (iotaAtLow a Mk sl)) :
    MkSlotsS.AdjS ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma Mk).route
      a.prime.prime.1 ((Fama.stSt γF a.prime.skeleton a.totalSigma Mk).plain a.prime.prime.1)) (selRAtLow J kSel a Mk) sl := by
  subst hMk
  set Φ := Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (classMkLow mkF a)
  set hSb := (Fama.stSt γF a.prime.skeleton a.totalSigma (classMkLow mkF a)).plain a.prime.prime.1
  obtain ⟨i, β, harg, v, hv, hvβ⟩ := h
  have hβsel : a.prime.data.decodedCoreBranch a.prime.prime.1 a.prime.decodes β ∈ selSetCap a.layered J kSel := by
    obtain ⟨v', hv', he⟩ := exists_selSetCap_congr (sourceLayer_reconstructsLow a) J kSel ⟨v, hv, hvβ⟩
    have hveq : v' = a.prime.data.decodedCoreBranch a.prime.prime.1 a.prime.decodes β := Subtype.ext he
    rw [← hveq]
    exact hv'
  rcases Φ.route_natural a.prime.prime.1 hSb sl i with hr | ⟨j, hr⟩
  · have h2 := Φ.route_inl a.prime.prime.1 hSb hr
    rw [harg] at h2
    rcases hsrc : argSrc hSb sl i with k | c
    · rw [hsrc] at h2
      exact absurd h2 (by simp [VineB.SpliceShape.srcMap])
    · rw [hsrc] at h2
      have hβ : β = Φ.br c := Sum.inr_injective h2
      refine ⟨i, c, ?_, by rw [hr, hsrc]⟩
      refine Finset.mem_filter.2 ⟨Finset.mem_univ _, ?_⟩
      rw [hβ] at hβsel
      exact hβsel
  · have h2 := Φ.route_inr a.prime.prime.1 hSb hr
    rw [harg] at h2
    have hβ : β = (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (classMkLow mkF a) j).lower :=
      Sum.inr_injective h2
    rw [hβ] at hβsel
    exact absurd hβsel (coreBranch_unit_not_selLow pat t s kSel mkF hsub a (List.get_mem _ _)
      (VineB.lower_mem _))

end

