/-- `hfilt` of the engine for the general piece at `Mk = classMkLow mkF a` (`filtGen_okLow`). -/
theorem pieceGenAt_filt_leLow (hsub : ∀ {LG : LayeredGarden (2 * R)} (B : PrimeData LG), markILow (γF := P.γ) J pat t s kSel B ⊆ mkF B)
    (hL : 1 ≤ P.L) (hRs : ∀ j, P.L ≤ Rs j) (Mk : Set (Fama.CLVineG P.γ a.prime.skeleton)) (hMk : Mk = classMkLow mkF a) :
    ∀ c q, (pieceGenAtLow P J pat t s kSel σ Rs a Mk dag).filt c = some q → ∀ u, ‖q.2 u‖ ≤ 1 := by
  subst hMk
  intro c q hq
  exact (filtGen_okLow P J pat t s kSel σ Rs mkF a dag hsub hL hRs MkSlotsG.cθGen le_rfl c q hq).2.2.1

