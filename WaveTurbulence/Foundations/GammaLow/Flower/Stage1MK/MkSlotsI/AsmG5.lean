/-- **A slot of `G_sb` with a non-routed residual selected clock is `SelAdj` on the skeleton.** -/
theorem selAdj_iota_of_adjSLow (J : Finset (Fin w)) (kSel : Fin w → Option ℕ) (a : Fama.VineA.PrescribedPrimeGarden γF w)
    (Mk : Set (Fama.CLVineG γF a.prime.skeleton)) (sl : ReplacementSlot (Fama.stSt γF a.prime.skeleton a.totalSigma Mk).G)
    (h : MkSlotsS.AdjS ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma Mk).route
      a.prime.prime.1 ((Fama.stSt γF a.prime.skeleton a.totalSigma Mk).plain a.prime.prime.1)) (selRAtLow J kSel a Mk) sl) :
    SelAdj a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J kSel (iotaAtLow a Mk sl) := by
  obtain ⟨i, v, hv, hr⟩ := h
  have harg := (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma Mk).route_inl
    a.prime.prime.1 _ hr
  refine ⟨i, (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma Mk).br v, harg, ?_⟩
  have hmem : coreAtLow a Mk v ∈ selSetCap a.layered J kSel := (Finset.mem_filter.1 hv).2
  exact exists_selSetCap_congr (sourceLayer_reconstructsLow a).symm J kSel ⟨coreAtLow a Mk v, hmem, rfl⟩

end

