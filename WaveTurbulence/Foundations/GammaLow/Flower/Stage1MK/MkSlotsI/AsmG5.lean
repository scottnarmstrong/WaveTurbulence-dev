variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w : ℕ}

/-- **The selection-adjacent losses**: `∏_{s'} (SelAdj (ι s') ? c : 1) ≤ c^{4 |selR|}`. -/
theorem prod_selAdj_leLow {J : Finset (Fin w)} (pat : Fin w → FixPat) (t s : ℝ) (kSel : Fin w → Option ℕ)
    (mkF : Fama.Stage1Mk.MarkFn γF w) (hsub : ∀ {LG : LayeredGarden w} (B : PrimeData LG), markILow (γF := γF) J pat t s kSel B ⊆ mkF B)
    (a : Fama.VineA.PrescribedPrimeGarden γF w) (Mk : Set (Fama.CLVineG γF a.prime.skeleton)) (hMk : Mk = classMkLow mkF a)
    {c : ℝ} (hc : 1 ≤ c) :
    ∏ sl : ReplacementSlot (Fama.stSt γF a.prime.skeleton a.totalSigma Mk).G,
      (if SelAdj a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J kSel (iotaAtLow a Mk sl)
        then c else 1) ≤ c ^ (4 * (selRAtLow J kSel a Mk).card) := by
  have e : ∀ sl : ReplacementSlot (Fama.stSt γF a.prime.skeleton a.totalSigma Mk).G,
      (if SelAdj a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J kSel (iotaAtLow a Mk sl)
        then c else 1) =
      (if MkSlotsS.AdjS ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma Mk).route
        a.prime.prime.1 ((Fama.stSt γF a.prime.skeleton a.totalSigma Mk).plain a.prime.prime.1)) (selRAtLow J kSel a Mk) sl
        then c else 1) := by
    intro sl
    by_cases h : SelAdj a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J kSel
      (iotaAtLow a Mk sl)
    · rw [if_pos h, if_pos (adjS_of_selAdj_iotaLow pat t s kSel mkF hsub a Mk hMk sl h)]
    · rw [if_neg h, if_neg (fun h' => h (selAdj_iota_of_adjSLow J kSel a Mk sl h'))]
  rw [Finset.prod_congr rfl fun sl _ => e sl]
  exact prod_adjS_le ((Fama.stSt γF a.prime.skeleton a.totalSigma Mk).plain a.prime.prime.1) _ _
    (fun sl i => (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma Mk).route_natural
      a.prime.prime.1 _ sl i) hc

end

