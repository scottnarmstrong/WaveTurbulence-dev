  (kSel σ : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ) (mkF : Fama.Stage1Mk.MarkFn P.γ (2 * R))
  (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R)) (dag : Option (Fin (2 * R) → Fin 3 → Mom P.d))

/-- At most `nProt` residual selected atoms. -/
theorem selRAt_card_leLow (Mk : Set (Fama.CLVineG P.γ a.prime.skeleton)) (hMk : Mk = classMkLow mkF a) :
    (selRAtLow J kSel a Mk).card ≤ (pieceGenAtLow P J pat t s kSel σ Rs a Mk dag).nProt := by
  subst hMk
  exact selROf_card_leLow pat t s

end

