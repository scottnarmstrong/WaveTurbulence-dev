variable (P : WTParams) [Fact (P.γ ≤ 1 / 2)] {R : ℕ} (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat) (t s : ℝ)
  (kSel σ : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ) (mkF : Fama.Stage1Mk.MarkFn γF (2 * R))
  (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (dag : Option (Fin (2 * R) → Fin 3 → Mom P.d))

/-- `hselclk` of the engine: no unit clock is a residual selected atom (δ's `selROf_not_unitClock` at a stem-clean
point; no selected atom without selections). -/
theorem selRAt_not_unitClockLow (hsub : ∀ {LG : LayeredGarden (2 * R)} (B : PrimeData LG), markILow (γF := γF) J pat t s kSel B ⊆ mkF B)
    (hstem : ¬ StemDep σ kSel ∨ CleanPtLow J a) (Mk : Set (Fama.CLVineG γF a.prime.skeleton)) (hMk : Mk = classMkLow mkF a) :
    ∀ v ∈ selRAtLow J kSel a Mk, ∀ j i,
      (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma Mk).hclk
        (Fama.unitBlkMk_disj (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma Mk) j i ≠ Sum.inr v := by
  subst hMk
  rcases hstem with hnd | hcl
  · intro v hv
    exfalso
    have hk := selROf_kSelLow (mkF := mkF) hv
    apply hnd
    right
    exact ⟨v.1.1, fun h0 => by rw [h0] at hk; exact absurd hk (by simp)⟩
  · exact selROf_not_unitClockLow pat t s kSel mkF hsub hcl

end

