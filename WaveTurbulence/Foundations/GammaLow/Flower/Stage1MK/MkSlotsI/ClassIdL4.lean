/-- **The lower joint of a chain assembly is a non-upper atom of one of its pieces** (the last appended one). -/
theorem exists_piece_lowerLow {w : ℕ} {G : Garden w} {U : Finset (GBranch G.tree)} {a b : GBranch G.tree}
    {R : CLRegionData G U a b} {n : ℕ} (B : Famb.VineEstS2.CLChainAssemblyΓ γF G R n) :
    ∃ i : Fin n, b ∈ (Famb.VineEstS2.assemblyPieceAtΓ B i).atoms ∧ b ≠ (Famb.VineEstS2.assemblyPieceAtΓ B i).upper := by
  cases B with
  | single hV R => exact ⟨0, (Src.isBlock_of_isSomeVine hV).2.2.1, fun h => (Src.isBlock_of_isSomeVine hV).2.2.2.1 h.symm⟩
  | append B hT hi hU R => exact ⟨0, (Src.isBlock_of_isSomeVine hT).2.2.1, fun h => (Src.isBlock_of_isSomeVine hT).2.2.2.1 h.symm⟩

end

