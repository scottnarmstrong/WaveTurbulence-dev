variable {R p : ℕ} {kind : Bool} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R))
  (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (hy : y ∈ Fama.sourceClass γF a p kind mk)
  (hG : (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.IsPlain)
  (J : Finset (Fin (2 * R)))
  (hGeoA : CapGeo (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)) J p)
  (hGeoY : CapGeo (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J p)
  (pat : Fin (2 * R) → FixPat) (t s : ℝ)
  (hrepUP : ∀ j, ∀ b ∈ (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).atoms,
    fixCap (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)) J pat t s
      (a.prime.data.coreBranch a.prime.prime.1 b) = none)

include hGeoA hrepUP in
/-- **No lower bound at the unit lowers of the representative** (`hMk`: the marked vines of `𝒱₀` are marked). -/
theorem rep_lbS_lowerLow (kSel : Fin (2 * R) → Option ℕ)
    (hMk : ∀ c ∈ markILow (γF := γF) J pat t s kSel a.prime, c ∈ Fama.vinesV0 γF a.prime.skeleton a.totalSigma → c ∈ mk a.prime)
    (j : Fin (Fama.unitBlocks γF a.prime.skeleton a.totalSigma (mk a.prime)).length) :
    MkSlotsB.lbS a.prime.data a.prime.prime.1
        (fixCap (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)) J pat
          t s) s (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).lower = none := by
  have hcapA : ∀ j ∈ J, (a.prime.data.garden a.prime.prime.1).tree j = TTree.leaf := hGeoA.cap_leaf
  set b := (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).lower with hb
  have hfa : MkSlots.fixCore a.prime.data a.prime.prime.1
      (fixCap (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)) J pat
        t s) b = none :=
    hrepUP j _ (lower_mem _)
  rw [lbS_eq_leaf a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J hcapA pat t s]
  refine ite_eq_right fun h => ?_
  obtain ⟨u, hu, hch, hne⟩ := (pinChild_iff a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)
    J hcapA pat t s id (fun b' hb' => absurd rfl (hb' b')) b hfa).mpr h.2
  obtain ⟨u', hu', hch', -⟩ := (pinChild_decoded a.prime.data a.prime.prime.1 (sourceLayerLow a)
    (sourceLayer_isLayeringLow a) J pat t s a.layered (sourceLayer_reconstructsLow a) a.prime.decodes id b).mpr
    ⟨u, hu, hch, hne⟩
  have hprot : (a.prime.data.decodedCoreBranch a.prime.prime.1 a.prime.decodes b).toNode ∈
      protI a.layered J pat t s kSel := MkSlotsB.parent_mem_protI kSel hch' hu'
  obtain ⟨k, hk1, hk2⟩ := exists_piece_lowerLow
    (Fama.alignedAssemblyMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j)
  obtain ⟨c, hc, hca⟩ := alignedPiece_mem_vinesV0Low a.totalSigma (mk a.prime) j k
  have hne' := ne_upper_of_pieceLow _ k c hca hk1 hk2
  rw [Fama.mem_vinesV0] at hc
  obtain ⟨hc0, hcMk⟩ := hc
  have hbc : b ∈ c.atoms := by rw [hca]; exact hk1
  have hm : c ∈ markILow (γF := γF) J pat t s kSel a.prime :=
    ⟨Fama.vinesV0_subset _ _ hc0, b, hbc, hne',
      (a.prime.data.decodedCoreBranch a.prime.prime.1 a.prime.decodes b).toNode, hprot,
      ProtGeo.mem_nearRegion_own (ProtGeo.skelAddr_mem_ownRegion _ _ b)⟩
  exact hcMk (hMk c hm hc0)

include hy hG hGeoA hGeoY hrepUP in

