/-- **The unit clocks of the piece at branches are free** (`hclk0` of β's `hHkPropD_of_hHkPropLow`): the hinge
clock (`fixOf_hingeLow`) and the lower crown clocks `u21, u22` (`fixCap_lowerChild_unitLow`) of every unit carry
no pin, for every pattern. -/
theorem fixOf_unitClockLow {J : Finset (Fin w)} (pat : Fin w → FixPat) (t s : ℝ) (kSel : Fin w → Option ℕ)
    (mkF : Fama.Stage1Mk.MarkFn γF w) (hsub : ∀ {LG : LayeredGarden w} (B : PrimeData LG), markILow (γF := γF) J pat t s kSel B ⊆ mkF B)
    (a : Fama.VineA.PrescribedPrimeGarden γF w) (j : Fin (Fama.unitBlocks γF a.prime.skeleton a.totalSigma (classMkLow mkF a)).length)
    (i : Fin 3) (c : GBranch (stALow mkF a).G.tree)
    (h : (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (classMkLow mkF a)).hclk
      (Fama.unitBlkMk_disj (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (classMkLow mkF a)) j i =
        Sum.inr c) :
    fixOfLow J pat t s mkF a c = none := by
  set Φ := Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (classMkLow mkF a)
  set hd := Fama.unitBlkMk_disj (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (classMkLow mkF a)
  have hmem : Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (classMkLow mkF a) j ∈
      Fama.unitBlocks γF a.prime.skeleton a.totalSigma (classMkLow mkF a) := List.get_mem _ _
  fin_cases i
  · change Sum.inr (Φ.hinge hd j) = Sum.inr c at h
    have hc : c = Φ.hinge hd j := (Sum.inr_injective h).symm
    have hh : c ∈ (stALow mkF a).hinges := by
      rw [← Fama.stShape_hingesMk (Mole.garden_isMolecule a.prime.skeleton), hc]
      exact Finset.mem_image.2 ⟨j, Finset.mem_univ _, rfl⟩
    exact fixOf_hingeLow J pat t s mkF a kSel hsub c hh
  · change VineB.nodeClk _ (Φ.hmom hd j 2) = Sum.inr c at h
    have hn := MkSlotsS.nodeClk_eq_inr h
    have h2 := Φ.node_hmom hd j 2
    rw [hn] at h2
    have h2' : Φ.node c.toNode =
        (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (classMkLow mkF a) j).lower.child
          (VineB.regionOf (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma
            (classMkLow mkF a) j)).positive := h2
    exact fixCap_lowerChild_unitLow pat t s kSel mkF hsub a hmem _ ((Φ.br_node c).trans h2')
  · change VineB.nodeClk _ (Φ.hmom hd j 3) = Sum.inr c at h
    have hn := MkSlotsS.nodeClk_eq_inr h
    have h2 := Φ.node_hmom hd j 3
    rw [hn] at h2
    have h2' : Φ.node c.toNode =
        (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (classMkLow mkF a) j).lower.child
          (VineB.regionOf (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma
            (classMkLow mkF a) j)).negative := h2
    exact fixCap_lowerChild_unitLow pat t s kSel mkF hsub a hmem _ ((Φ.br_node c).trans h2')

end

