/-- **The hinge data of the general piece on the engine's domain** (`hhinge` of the engine with
`Dom := domOfLow π tt ∩ MkSlotsB.pinSet π.fix`, `π = pieceGenAtLow … a Mk dag`, `Mk = classMkLow mkF a`): main's unpinned
`HHkPropLow` of the normalized piece gives δ's `mkSlotsS_HHkPropDLow` on `Dom`, by β's shift method
`hHkPropD_of_hHkPropLow` (pins `fixOf_val`, `fixOf_mono_child`; free unit clocks `fixOf_unitClockLow`). -/
theorem hHkPropD_pieceGenAtLow (P : WTParams) [Fact (P.γ ≤ 1 / 2)] {R : ℕ} {p : ℕ} (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat)
    (t s : ℝ) (kSel σ : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ) (mkF : Fama.Stage1Mk.MarkFn P.γ (2 * R))
    (hsub : ∀ {LG : LayeredGarden (2 * R)} (B : PrimeData LG), markILow (γF := P.γ) J pat t s kSel B ⊆ mkF B)
    (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R)) (hG : CapGeo a.layered J p) (hpat : CapPatValid a.layered J pat p)
    (hroot : ∀ j ∉ J, ∃ ℓ : GLeaf a.layered.garden.tree, IsCapFlower a.layered J ℓ ∧ ℓ.1.1 = j)
    (hs : s ∈ Ioo (p : ℝ) t) (ht : t < p + 1) (dag : Option (Fin (2 * R) → Fin 3 → Mom P.d))
    (Mk : Set (Fama.CLVineG P.γ a.prime.skeleton)) (hMk : Mk = classMkLow mkF a)
    (roots : Fin (2 * R) → (Fin P.d → ℤ))
    (selSk : GenDecoration (Fama.stSt P.γ a.prime.skeleton a.totalSigma Mk).G P.d roots 0 → Prop)
    (Hk : Fin (Fama.unitBlocks P.γ a.prime.skeleton a.totalSigma Mk).length → (Fin 3 → ℝ) → (Fin 4 → Mom P.d) → ℂ)
    (H : HingeFam (Fin (Fama.unitBlocks P.γ a.prime.skeleton a.totalSigma Mk).length) P.d)
    (hHk : HHkPropLow (a.normalizedPiece P.d Mk) (fun _ => t) 0 roots selSk
      ((Fama.stShape P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma Mk).hclk
        (Fama.unitBlkMk_disj (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma Mk))
      ((Fama.stShape P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma Mk).hmom
        (Fama.unitBlkMk_disj (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma Mk)) Hk H) :
    mkSlotsS_HHkPropDLow (pieceGenAtLow P J pat t s kSel σ Rs a Mk dag).toStage1PieceGD (fun _ => t) 0 roots selSk
      (domOfLow (pieceGenAtLow P J pat t s kSel σ Rs a Mk dag) (fun _ => t) ∩
        MkSlotsB.pinSet (pieceGenAtLow P J pat t s kSel σ Rs a Mk dag).fix)
      ((Fama.stShape P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma Mk).hclk
        (Fama.unitBlkMk_disj (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma Mk))
      ((Fama.stShape P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma Mk).hmom
        (Fama.unitBlkMk_disj (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma Mk)) Hk H := by
  subst hMk
  intro κ hsel τ hτ j c hc
  refine hHkPropD_of_hHkPropLow (pieceGenAtLow P J pat t s kSel σ Rs a (classMkLow mkF a) dag) (fun _ => t) 0 roots
    selSk _ _ Hk H ?_ ?_ ?_ hHk κ hsel τ hτ.1.1 hτ.2 j c hc
  · intro b v hb
    exact fixOf_valLow J pat t s mkF a hG hpat hroot hs ht b v hb
  · intro b b' v v' hb hb' hcc
    exact fixOf_mono_childLow J pat t s mkF a hs.2.le hcc hb hb'
  · intro j' i c' h
    exact fixOf_unitClockLow pat t s kSel mkF hsub a j' i c' h

end

