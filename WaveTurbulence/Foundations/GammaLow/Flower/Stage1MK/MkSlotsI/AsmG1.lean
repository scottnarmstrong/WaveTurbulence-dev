/-- **No lower crown child of a unit of the piece carries a pin.** `a` is a prescribed point, `mkF` a fine marking
containing `markILow (γF := γF)`; `u` is a unit of `Fama.unitBlocks γF` at `classMkLow mkF a` and `y` the skeleton branch at a child
`u.lower.child i` of its lower joint. -/
theorem fixCap_lowerChild_unitLow {J : Finset (Fin w)} (pat : Fin w → FixPat) (t s : ℝ) (kSel : Fin w → Option ℕ)
    (mkF : Fama.Stage1Mk.MarkFn γF w) (hsub : ∀ {LG : LayeredGarden w} (B : PrimeData LG), markILow (γF := γF) J pat t s kSel B ⊆ mkF B)
    (a : Fama.VineA.PrescribedPrimeGarden γF w) {u : RedSplice.CLBlock a.prime.skeleton}
    (hu : u ∈ Fama.unitBlocks γF a.prime.skeleton a.totalSigma (classMkLow mkF a)) {y : GBranch a.prime.skeleton.tree}
    (i : Fin 3) (hy : y.toNode = u.lower.child i) :
    fixCap a.layered J pat t s (a.prime.data.decodedCoreBranch a.prime.prime.1 a.prime.decodes y) = none := by
  obtain ⟨c, hc, hlc, hcu⟩ := Fama.unitBlocks_soundMk hu u.lower u.isBlock.2.2.1
  rw [Fama.mem_vinesV0] at hc
  obtain ⟨hc0, hcMk⟩ := hc
  by_contra hpin
  have hpin' := Option.ne_none_iff_isSome.1 hpin
  have hm : c ∈ markILow (γF := γF) J pat t s kSel a.prime := by
    refine ⟨Fama.vinesV0_subset _ _ hc0, u.lower, hlc, fun h => clVine_upper_ne_lowerLow u c hcu h.symm, _,
      MkSlots.mem_protI_of_fixCap hpin', ?_⟩
    apply ProtGeo.mem_nearRegion_child i
    rw [← hy]
    exact ProtGeo.skelAddr_mem_ownRegion _ _ y
  exact hcMk ⟨hsub a.prime hm, hc0⟩

end

