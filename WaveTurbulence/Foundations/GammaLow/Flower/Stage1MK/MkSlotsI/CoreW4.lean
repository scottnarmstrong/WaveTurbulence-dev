/-- The root depths of the flower sides of the native couples are common to the run class. -/
theorem cwDp_memberLow (q : SourcePair (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G) (c : Fin 2)
    (hJ : (cwSide hG q c).1.1 ∉ J)
    (hJ' : ((Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.pair (cwSide hG q c)).1.1 ∈ J) :
    cwDp (memShapeLow a mk y hy) y.1.data y.1.plain hG q c =
      cwDp (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)) a.prime.data
        a.prime.prime.1 hG q c := by
  have hRy := stemRet_memberLow a mk y hy J hcapA hcapY hc
  have hRa := MkSlotsT.stemRet_congr (sourceLayer_reconstructsLow a).symm (stemRet_repMkLow hc (mk a.prime))
  rw [cwDp_eq, cwDp_eq]
  by_cases h : (cwSide hG q c).1.2 = []
  · rw [attach_depth_root _ _ _ h, attach_depth_root _ _ _ h]
  · obtain ⟨-, hy'⟩ := attach_depth (memShapeLow a mk y hy) y.1.data y.1.plain (stateLayer y.1)
      (stateLayer_isLayering y.1) hcapY hRy (cwSide hG q c) hJ hJ' h
    obtain ⟨hstA, ha'⟩ := attach_depth (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime))
      a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) hcapA hRa (cwSide hG q c) hJ hJ' h
    rw [hy', ha', stemCore_length_memberLow a mk y hy J hcapA hcapY hG hc _ hstA]

include hy hcapA hcapY hG hc honeA honeY in

end

