/-- **The selected vertex of a tree exists at a member iff it exists at the representative.** -/
theorem selCap_isSome_member_iffLow (kSel : Fin (2 * R) → Option ℕ) (j : Fin (2 * R)) :
    (selCap (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J kSel j).isSome ↔
      (selCap (recLGLow a) J kSel j).isSome := by
  rw [selCap_isSome_iff honeY, selCap_isSome_iff honeA]
  refine exists_congr fun k => and_congr_right fun _ => ?_
  rw [exists_capFlower_iff (memShapeLow a mk y hy) y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) hG
      hcapY j k,
    exists_capFlower_iff (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)) a.prime.data
      a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) hG hcapA j k]
  refine exists_congr fun q => flowerAtDepth_congr (memShape_nativeCoupleLow a mk y hy hG q) ?_ ?_ j k
  · funext c
    rw [cwTr_eq, cwTr_eq]
  · intro l hl
    obtain ⟨h1, h2⟩ := hl
    rw [cwTr_eq] at h1 h2
    have hne : l.1.1 ≠ ((cwN (memShapeLow a mk y hy) y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)
        hG q).garden.pair l).1.1 := fun he => h1 (he ▸ h2)
    rw [cwSide_pair hG q _ _ hne] at h2
    exact cwDp_memberLow a mk y hy J hcapA hcapY hG hc q l.1.1 h1 h2

include hy hcapA hcapY hG hc honeA honeY in

end

