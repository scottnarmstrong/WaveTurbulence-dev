/-- The representative's unit tops are not selected vertices (from the fine marking). -/
theorem rep_tops_not_selLow {R : ℕ} (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat) (t s : ℝ)
    (kSel : Fin (2 * R) → Option ℕ) (mkF : Fama.Stage1Mk.MarkFn γF (2 * R))
    (hsub : ∀ {LG : LayeredGarden (2 * R)} (B : PrimeData LG), markILow (γF := γF) J pat t s kSel B ⊆ mkF B)
    (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R)) (hset : mk a.prime = classMkLow mkF a)
    (j : Fin (Fama.unitBlocks γF a.prime.skeleton a.totalSigma (mk a.prime)).length) :
    a.prime.data.coreBranch a.prime.prime.1
      (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).upper ∉
        selSetCap (recLGLow a) J kSel :=
  rep_units_not_selLow J pat t s kSel mkF hsub a mk hset j _ (upper_mem _)

end

