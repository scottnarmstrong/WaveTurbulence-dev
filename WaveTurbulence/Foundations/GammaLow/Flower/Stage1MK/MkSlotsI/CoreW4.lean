        genNW (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J L σ kSel Rs
          (y.1.data.coreBranch y.1.plain ((memShapeLow a mk y hy).br c)).toNode
          (omegaNode y.1.skeleton (cosetDecoration y.1.skeleton L 0 κ.1) ((memShapeLow a mk y hy).br c)) =
      zatomGLow J L σ kSel Rs a (mk a.prime) ((memShapeLow a mk y hy).resDec y.1.plain (Fama.source_disjMk a mk y hy) κ) :=
  zatom_memberLow a mk y hy J hcapA hcapY hG hrepU hc honeA honeY kSel L σ Rs
