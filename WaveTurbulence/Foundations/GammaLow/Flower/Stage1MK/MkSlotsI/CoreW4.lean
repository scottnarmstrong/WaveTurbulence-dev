/-- **Item 2: the member transfer of the atom part** (no extra hypothesis). -/
theorem zatom_member'Low (L : ℝ) (σ kSel : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ) {d : ℕ}
    {roots : Fin (2 * R) → (Fin d → ℤ)} (κ : GenDecoration y.1.skeleton d roots 0) :
