/-- **The large constant of the general assembly.** -/
def CgenLow (d : ℕ) (η c₁ : ℝ) (Kg : ℕ → ℝ → ℝ) : ℝ :=
  max (max 1 c₁) (Represents.Cchi d * (RepAnalytic.nodeBallCard d : ℝ) * (9 * max 1 (Kg d η)) ^ 2 *
    ChFWLLow d η)

end

