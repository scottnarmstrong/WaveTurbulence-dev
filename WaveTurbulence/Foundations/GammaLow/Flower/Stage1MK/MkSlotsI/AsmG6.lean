/-- **The absorbed-selection bound** (proved as `prod_selNative_leLow`, W:MkSlotsI/AsmG3.lean): over the outer slots, the
gains `Rs^{-1/18}` of the selected native vertices dominate those of the absorbed selected trees. -/
def SelNativeBoundLow : Prop :=
  ∀ {γF : ℝ} [Fact (γF ≤ 1 / 2)] {R : ℕ} (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat) (t s : ℝ)
    (kSel : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ) (mkF : Fama.Stage1Mk.MarkFn γF (2 * R)),
    (∀ {LG : LayeredGarden (2 * R)} (B : PrimeData LG), markILow (γF := γF) J pat t s kSel B ⊆ mkF B) →
    ∀ (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (Mk : Set (Fama.CLVineG γF a.prime.skeleton)), Mk = classMkLow mkF a →
    (∀ j, 1 ≤ Rs j) → (∀ j, (kSel j).isSome → (selCap (recLGLow a) J kSel j).isSome) →
    ∏ s' : ReplacementSlot (Fama.stSt γF a.prime.skeleton a.totalSigma Mk).G,
      ∏ v ∈ MkSlotsS.selNative a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J kSel
        (iotaAtLow a Mk s'), Rs v.1.1 ^ (-(1 / 18 : ℝ)) ≤
      ∏ j : Fin (2 * R), (if (kSel j).isSome ∧ j ∉ (selRAtLow J kSel a Mk).image (fun v => v.1.1) then
        Rs j ^ (-(1 / 18 : ℝ)) else 1)

end

