open WaveTurbulence.RedSplice (stSt unitBlocks)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]

theorem genLeaf_nonnegLow {R : ℕ} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (J : Finset (Fin (2 * R))) {b : ℝ} (hb : 0 ≤ b)
    (sl : ReplacementSlot a.prime.skeleton) : 0 ≤ genLeafLow a J b sl := by
  rcases sl with q | β
  · refine mul_nonneg ?_ (slotLeaf_nonneg _ _ _ _ _ _)
    split_ifs
    · exact inv_nonneg.2 hb
    · exact zero_le_one
  · simp only [genLeafLow]
    exact slotLeaf_nonneg _ _ _ _ _ _

end

