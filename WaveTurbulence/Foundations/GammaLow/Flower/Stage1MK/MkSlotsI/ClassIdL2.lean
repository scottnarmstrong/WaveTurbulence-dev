/-- **The leaf pins at the images of a `G_sb` leaf are common to the run class.** -/
theorem member_leafPin_iffLow (m : GLeaf (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.tree) :
    LeafPin y.1.data y.1.plain
        (fixCap (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J pat t s)
        ((memShapeLow a mk y hy).leaf m) ↔
      LeafPin a.prime.data a.prime.prime.1
        (fixCap (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)) J pat t s)
        ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).leaf m) := by
  have hry : (nativeCoupleForest y.1.data y.1.plain (pairOfLeaf y.1.skeleton y.1.plain
      ((memShapeLow a mk y hy).leaf ((pairOfLeaf _ hG m).firstLeaf hG)))).root (sideOf hG m) =
        attachedNode y.1.data y.1.plain ((memShapeLow a mk y hy).leaf m).toNode := by
    rw [cpl_root_attached (memShapeLow a mk y hy) y.1.data y.1.plain hG _ _, sel_sideOf hG m,
      (memShapeLow a mk y hy).leaf_node]
  have hra : (nativeCoupleForest a.prime.data a.prime.prime.1 (pairOfLeaf a.prime.skeleton a.prime.prime.1
      ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).leaf
        ((pairOfLeaf _ hG m).firstLeaf hG)))).root (sideOf hG m) =
        attachedNode a.prime.data a.prime.prime.1
          ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).leaf m).toNode := by
    rw [cpl_root_attached (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime))
      a.prime.data a.prime.prime.1 hG _ _, sel_sideOf hG m,
      (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).leaf_node]
  refine (leafPin_iff_cpl _ _ _ _ _ (sideOf hG m) hry).trans
    (Iff.trans ?_ (leafPin_iff_cpl _ _ _ _ _ (sideOf hG m) hra).symm)
  set q := pairOfLeaf _ hG m with hq
  set k : Fin 2 := sideOf hG m with hk
  set Φy := memShapeLow a mk y hy with hΦy
  set Φa := Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) with hΦa
  have hN := memShape_nativeCoupleLow a mk y hy hG q
  have hbr : ∀ x : Fin 2 × Path,
      x.2 ∈ ((nativeCoupleLayered y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)
        (pairOfLeaf y.1.skeleton y.1.plain (Φy.leaf (q.firstLeaf hG)))).garden.tree x.1).branching ↔
      x.2 ∈ ((nativeCoupleLayered a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)
        (pairOfLeaf a.prime.skeleton a.prime.prime.1 (Φa.leaf (q.firstLeaf hG)))).garden.tree x.1).branching := by
    intro x
    rw [hN]
  constructor
  · rintro ⟨h₁, hpin⟩
    have h₂ := (hbr (k, [])).mp h₁
    refine ⟨h₂, ?_⟩
    have e := member_cplPinLow a mk y hy hG J hGeoA hGeoY pat t s hrepUP q (k, []) h₁ h₂
    exact (congrArg Option.isSome e).symm.trans hpin
  · rintro ⟨h₂, hpin⟩
    have h₁ := (hbr (k, [])).mpr h₂
    refine ⟨h₁, ?_⟩
    have e := member_cplPinLow a mk y hy hG J hGeoA hGeoY pat t s hrepUP q (k, []) h₁ h₂
    exact (congrArg Option.isSome e).trans hpin

end

