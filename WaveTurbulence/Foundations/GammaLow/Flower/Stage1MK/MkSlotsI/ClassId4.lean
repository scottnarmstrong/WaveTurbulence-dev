variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w : ℕ}
variable {R p : ℕ} {kind : Bool} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R))
  (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (hy : y ∈ Fama.sourceClass γF a p kind mk)
  (hG : (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.IsPlain) (J : Finset (Fin (2 * R)))

include hy hG in
/-- **Every skeleton decoration of a member consumes its outer slot momenta in `ConsGLow`.** -/
theorem member_hconsLow {d : ℕ} (L : ℝ) (roots : Fin (2 * R) → (Fin d → ℤ))
    (hcapS : ∀ j ∈ J, y.1.skeleton.tree j = TTree.leaf)
    (κ : GenDecoration y.1.skeleton d roots 0)
    (s' : ReplacementSlot (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G) :
    ConsGLow L a J roots (mk a.prime) s'
      (0 + latticePoint L (κ.1 (slotNode y.1.plain ((memShapeLow a mk y hy).iota y.1.plain hG s')))) := by
  refine ⟨_, rfl, ?_, ?_⟩
  · intro q' hq' hcap
    cases s' with
    | inl q =>
      have e : q' = pairOfLeaf a.prime.skeleton a.prime.prime.1
          ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).leaf (q.firstLeaf hG)) :=
        (Sum.inl_injective hq').symm
      subst e
      have hqG := (MkSlots.IntMember.isCapPair_iota
        (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)) a.prime.prime.1 hG J q).mp hcap
      have hqy := (MkSlots.IntMember.isCapPair_iota (memShapeLow a mk y hy) y.1.plain hG J q).mpr hqG
      show κ.1 ((pairOfLeaf y.1.skeleton y.1.plain ((memShapeLow a mk y hy).leaf (q.firstLeaf hG))).firstLeaf
        y.1.plain).toNode = _
      rw [genDec_capPair y.1.skeleton y.1.plain J hcapS κ _ hqy,
        MkSlots.IntMember.capTreeOf_iota (memShapeLow a mk y hy) y.1.plain hG J q,
        MkSlots.IntMember.capTreeOf_iota
          (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)) a.prime.prime.1 hG J q]
    | inr c => cases hq'
  · intro β hβ hβr
    cases s' with
    | inl q => cases hβ
    | inr c =>
      have e : β = (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).br c :=
        (Sum.inr_injective hβ).symm
      subst e
      have hc := (MkSlotsB.br_root_iff _ c).mp hβr
      have hy0 := (MkSlotsB.br_root_iff (memShapeLow a mk y hy) c).mpr hc
      show κ.1 ((memShapeLow a mk y hy).br c).toNode = _
      have hn : ((memShapeLow a mk y hy).br c).toNode = GNode.root y.1.skeleton.tree ((memShapeLow a mk y hy).br c).1.1 :=
        Subtype.ext (Prod.ext rfl hy0)
      rw [hn, κ.2.2.1, MkSlots.IntCore.br_fst, MkSlots.IntCore.br_fst]

end

