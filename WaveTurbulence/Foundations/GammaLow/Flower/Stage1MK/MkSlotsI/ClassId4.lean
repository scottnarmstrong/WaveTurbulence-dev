variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {P : WTParams} [Fact (P.γ ≤ 1 / 2)]
variable {w : ℕ}
variable {R p : ℕ} {kind : Bool} (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R)) (mk : Fama.Stage1Mk.MarkFn P.γ (2 * R))
  (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk P.γ a mk))) (hy : y ∈ Fama.sourceClass P.γ a p kind mk)
  (hG : (Fama.stSt P.γ a.prime.skeleton a.totalSigma (mk a.prime)).G.IsPlain) (J : Finset (Fin (2 * R)))
variable (hGeoA : CapGeo (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a))
    J p)
  (hGeoY : CapGeo (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J p)
  (pat : Fin (2 * R) → FixPat) (t s : ℝ)
  (hrepUP : ∀ j, ∀ b ∈ (Fama.unitBlkMk P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).atoms,
    fixCap (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)) J pat t s
      (a.prime.data.coreBranch a.prime.prime.1 b) = none)

include hy hG hGeoA hGeoY hrepUP in
/-- **VBC4's `hexp₀`** for the leaf-pair / root-chain family `fam₀Of sd _` of `SlotDataOKLow`. -/
theorem member_hexp₀Low {Kg : ℕ → ℝ → ℝ} {C : ℝ} (kSel σ : Fin (2 * R) → Option ℕ)
    (Rs : Fin (2 * R) → ℝ) (roots : Fin (2 * R) → (Fin P.d → ℤ)) (h : ℕ → Fin (2 * R) → Fin (2 * R) → Mom P.d → ℝ)
    (b : ℝ) (Rf : Fin (2 * R) → Option ℝ) (dag : Option (Fin (2 * R) → Fin 3 → Mom P.d))
    (hstem : StemDep σ kSel → CleanPtLow J a)
    (sd : ReplacementSlot (Fama.stSt P.γ a.prime.skeleton a.totalSigma (mk a.prime)).G → (Fin P.d → ℤ) → SlotDatum P.d)
    (hsd : SlotDataOKLow Kg P C p a J pat t s kSel σ Rs roots h b Rf dag (mk a.prime) sd)
    (s' : ReplacementSlot (Fama.stSt P.γ a.prime.skeleton a.totalSigma (mk a.prime)).G) (hnc : ¬ IsCentred s')
    (ts : Fin 2 → ℝ) (hts : ts ∈ boxGLow p a J pat t s (mk a.prime) s') (x : Mom P.d)
    (hx : ConsGLow P.L a J roots (mk a.prime) s' x) :
    HasSum (fun l => ((fam₀Of sd hsd.supp).w s' l : ℂ) * (fam₀Of sd hsd.supp).a s' l x *
        fsPhase ((fam₀Of sd hsd.supp).m s' l) ts)
      (MkSlotsB.slotFnGWFRL y.1.data y.1.plain P.L P.γ P.δ
        (anchProfiles J (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) h P.L
          roots)
        (chainW y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) P.L P.γ P.δ p s J Rf dag)
        (genΘs y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) J P.L σ kSel Rs)
        (stateLayer y.1) (stateLayer_isLayering y.1)
        (fixCap (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J pat t s)
        ((memShapeLow a mk y hy).iota y.1.plain hG s') ts x) := by
  obtain ⟨n, rfl, hcap, hroot⟩ := hx
  rw [member_genSlotLow a mk y hy hG J hGeoA hGeoY pat t s hrepUP P.L P.γ P.δ σ kSel Rs h roots Rf dag hstem s',
    zero_add]
  refine hsd.hasSum s' 0 ts hts.1 hts.2 n hcap hroot ?_
  intro β hβ hβne
  exfalso
  cases s' with
  | inl q => cases hβ
  | inr c =>
    have e : β = (Fama.stShape P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).br c :=
      (Sum.inr_injective hβ).symm
    subst e
    have hc : c.1.2 = [] := by
      by_contra hc
      exact hnc hc
    exact hβne ((MkSlotsB.br_root_iff _ c).mpr hc)

include hy hG hGeoA hGeoY hrepUP in

end

