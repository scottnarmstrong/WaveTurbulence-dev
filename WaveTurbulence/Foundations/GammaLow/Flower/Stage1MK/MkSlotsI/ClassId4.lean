variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w : ℕ}

/-- **The consumed momenta of a non-centred outer slot**: lattice points at base `0`, the cap momentum on a cap pair,
the root label on a root chain slot (the clauses of `SlotDataOKLow.hasSum`). -/
def ConsGLow {d : ℕ} (L : ℝ) (a : Fama.VineA.PrescribedPrimeGarden γF w) (J : Finset (Fin w)) (roots : Fin w → (Fin d → ℤ))
    (Mk : Set (Fama.CLVineG γF a.prime.skeleton)) (s' : ReplacementSlot (Fama.stSt γF a.prime.skeleton a.totalSigma Mk).G)
    (x : Mom d) : Prop :=
  ∃ n : Fin d → ℤ, x = 0 + latticePoint L n ∧
    (∀ q, iotaAtLow a Mk s' = .inl q → IsCapPair a.prime.skeleton a.prime.prime.1 J q →
      n = roots (capTreeOf a.prime.skeleton a.prime.prime.1 J q)) ∧
    (∀ β : GBranch a.prime.skeleton.tree, iotaAtLow a Mk s' = .inr β → β.1.2 = [] → n = roots β.1.1)

end

