/-- **VBC4's `hbox`** for the box `boxGLow = genBoxAtLow … ∩ TopCutLow …`: on the pinned relaxed core domain of a member with
the lower bounds `lbS`, the slot times of every outer slot lie in the representative's general box and satisfy its
top-pin cut. -/
theorem member_hboxLow (hcapA : ∀ j ∈ J, (a.prime.data.garden a.prime.prime.1).tree j = TTree.leaf)
    (hcapY : ∀ j ∈ J, (y.1.data.garden y.1.plain).tree j = TTree.leaf) (hst : s < t)
    (htt : t ∈ Set.Icc (p : ℝ) (p + 1))
    (hRP : MkSlotsB.RelaxPins
      (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)).layer (fun _ => t)
      (fixCap (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J pat t s))
    (hlbclk : ∀ (s' : ReplacementSlot (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G) (i : Fin 2)
      (by' : GBranch y.1.skeleton.tree) (ba : GBranch a.prime.skeleton.tree),
      argSrc y.1.plain ((memShapeLow a mk y hy).iota y.1.plain hG s') i = .inr by' →
      argSrc a.prime.prime.1
        ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).iota a.prime.prime.1 hG s') i
        = .inr ba →
      MkSlotsB.lbS y.1.data y.1.plain
          (fixCap (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J pat t s) s
          by' =
        MkSlotsB.lbS a.prime.data a.prime.prime.1 (fixCap (recLGLow a) J pat t s) s ba) :
    ∀ τ, MkSlotsB.PinnedAt (fixCore y.1.data y.1.plain
        (fixCap (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J pat t s)) τ →
      τ ∈ MkSlotsB.coreTimeDomainWR (fun b => stateLayer y.1 (y.1.data.coreBranch y.1.plain b).toNode) (fun _ => t)
          (fixCore y.1.data y.1.plain
            (fixCap (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J pat t s)) ∩
        MkSlotsB.lbDomR (MkSlotsB.lbS y.1.data y.1.plain
          (fixCap (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J pat t s) s) →
      ∀ s', slotTs y.1.plain (fun _ => t) τ ((memShapeLow a mk y hy).iota y.1.plain hG s') ∈
        boxGLow p a J pat t s (mk a.prime) s' := by
  intro τ hpin hτ s'
  refine ⟨?_, member_topCutLow a mk y hy hG J hcapA hcapY pat t s hrepUP hst hlbclk τ hpin hτ.2 s'⟩
  show _ ∈ genSlotBox p (fun b => sourceLayerLow a (a.prime.data.coreBranch a.prime.prime.1 b).toNode) a.prime.prime.1
    (fun _ => t) (fixCore a.prime.data a.prime.prime.1 (fixCap (recLGLow a) J pat t s))
    ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).iota a.prime.prime.1 hG s')
  rw [← genSlotBox_memberLow a mk y hy hG J hcapA hcapY pat t s hrepUP (fun _ => t) s']
  exact slotTs_mem_genSlotBox p _ y.1.plain (fun _ => t) (fun _ => htt) _
    (fun b v hv => ⟨(hRP.val _ v hv).1, (hRP.val _ v hv).2.1⟩) τ hpin.pin hτ.1 _

end

end WaveTurbulence.GammaLow.Flower
