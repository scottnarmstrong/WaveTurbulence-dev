/-- The slot box of VBC4 for the slot obligation: `genBoxAtLow` and the top-pin cut of the representative's slot. -/
def boxGLow (p : ℕ) (a : Fama.VineA.PrescribedPrimeGarden γF w) (J : Finset (Fin w)) (pat : Fin w → FixPat) (t s : ℝ)
    (Mk : Set (Fama.CLVineG γF a.prime.skeleton)) (s' : ReplacementSlot (Fama.stSt γF a.prime.skeleton a.totalSigma Mk).G) :
    Set (Fin 2 → ℝ) :=
  genBoxAtLow p a J pat t s (iotaAtLow a Mk s') ∩ {ts | TopCutLow a J pat t s (iotaAtLow a Mk s') ts}

end

