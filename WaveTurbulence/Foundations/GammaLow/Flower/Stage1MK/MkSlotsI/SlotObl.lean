/-- **The general slot kernel** of a slot of the reconstruction of `a`. -/
def genSlotKerLow (L γ δ : ℝ) (p : ℕ) (a : Fama.VineA.PrescribedPrimeGarden γF w) (J : Finset (Fin w)) (pat : Fin w → FixPat)
    (t s : ℝ) (σ kSel : Fin w → Option ℕ) (Rs : Fin w → ℝ)
    (h : ℕ → Fin w → Fin w → Mom d → ℝ) (roots : Fin w → (Fin d → ℤ)) (Rf : Fin w → Option ℝ)
    (dag : Option (Fin w → Fin 3 → Mom d)) :
    ReplacementSlot a.prime.skeleton → (Fin 2 → ℝ) → Mom d → ℂ :=
  MkSlotsB.slotFnGWFRL a.prime.data a.prime.prime.1 L γ δ (anchProfiles J (recLGLow a) h L roots)
    (MkSlots.chainW a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) L γ δ p s J Rf dag)
    (genΘs a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J L σ kSel Rs)
    (sourceLayerLow a) (sourceLayer_isLayeringLow a) (fixCap (recLGLow a) J pat t s)

end

