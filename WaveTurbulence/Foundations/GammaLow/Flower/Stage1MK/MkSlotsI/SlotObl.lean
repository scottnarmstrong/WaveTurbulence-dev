/-- The box of a slot of the reconstruction of `a` (top time `t`, core pins of `fixCap … pat`). -/
def genBoxAtLow (p : ℕ) (a : Fama.VineA.PrescribedPrimeGarden γF w) (J : Finset (Fin w)) (pat : Fin w → FixPat) (t s : ℝ)
    (sl : ReplacementSlot a.prime.skeleton) : Set (Fin 2 → ℝ) :=
  genSlotBox p (fun b => sourceLayerLow a (a.prime.data.coreBranch a.prime.prime.1 b).toNode) a.prime.prime.1
    (fun _ => t) (fixCore a.prime.data a.prime.prime.1 (fixCap (recLGLow a) J pat t s)) sl

end

