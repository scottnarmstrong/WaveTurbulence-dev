open WaveTurbulence.Flower.MkSlots (anchProfiles recLG IsCapPair capTreeOf stA fixCore)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w d : ℕ}

/-- **The mass of a slot** (without the constant `Kg`). -/
def genSlotMassLow (P : WTParams) [Fact (P.γ ≤ 1 / 2)] (C b : ℝ) {R : ℕ} (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R)) (J : Finset (Fin (2 * R)))
    (pat : Fin (2 * R) → FixPat) (t s : ℝ) (kSel : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ)
    (sl : ReplacementSlot a.prime.skeleton) : ℝ :=
  (C * Real.sqrt P.δ) ^ slotSize a.prime.data sl *
    P.L ^ (-(P.η ^ 8) * (slotIncoh a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)
      sl : ℝ)) *
    (frontierConst P.d ^ slotNr a.prime.data a.prime.prime.1 sl * genLeafLow a J b sl) *
    P.L ^ (if HasProtNative a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)
      (protI (recLGLow a) J pat t s kSel) sl then genLossExp P.d else 0) *
    ∏ v ∈ MkSlotsS.selNative a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J kSel sl,
      Rs v.1.1 ^ (-(1 / 18 : ℝ))

end

