variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {R p : ℕ} {kind : Bool} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R))
  (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (hy : y ∈ Fama.sourceClass γF a p kind mk)
  (hG : (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.IsPlain)
  (J : Finset (Fin (2 * R)))
  (hcapA : ∀ j ∈ J, (a.prime.data.garden a.prime.prime.1).tree j = TTree.leaf)
  (hcapY : ∀ j ∈ J, (y.1.data.garden y.1.plain).tree j = TTree.leaf)
  (hrepU : ∀ j, ∀ b ∈ (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).atoms,
    ¬ IsCapFlowerParent (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a)) J (a.prime.data.coreBranch a.prime.prime.1 b))

include hG hcapA hcapY hrepU in
/-- **The capped-flower-parent letter above the attached node of a `G_sb` node is common to the run class.** -/
theorem member_rcOfLow (z : GNode (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.tree) :
    rcOf (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J
        (attachedNode y.1.data y.1.plain ((memShapeLow a mk y hy).node z)) =
      rcOf (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)) J
        (attachedNode a.prime.data a.prime.prime.1
          ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).node z)) := by
  set Φy := memShapeLow a mk y hy
  set Φa := Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)
  rw [rcOf_attached y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) J,
    rcOf_attached a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J]
  by_cases hz : z.1.2 = []
  · have hy' : ¬ ((Φy.node z).1.2 ≠ []) := fun h => h ((Φy.root_iff z).mpr hz)
    have ha' : ¬ ((Φa.node z).1.2 ≠ []) := fun h => h ((Φa.root_iff z).mpr hz)
    rw [dite_eq_right hy', dite_eq_right ha']
  · obtain ⟨hνy, hy1, hy2⟩ := node_parent_cases Φy z hz
    obtain ⟨hνa, ha1, ha2⟩ := node_parent_cases Φa z hz
    rw [dite_eq_left hνy, dite_eq_left hνa]
    by_cases hh : ∃ j, Φa.br (z.parent hz) =
        (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).upper
    · obtain ⟨j, hj⟩ := hh
      obtain ⟨j', hj'⟩ := (member_hinge_iffLow a mk y hy (z.parent hz)).mpr ⟨j, hj⟩
      rw [ite_eq_right (member_unit_not_cfpLow a mk y hy hG J hcapA hcapY hrepU j' _ (hy2 j' hj')),
        ite_eq_right (hrepU j _ (ha2 j hj))]
    · have h0a : ∀ j, Φa.br (z.parent hz) ≠
          (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).upper :=
        fun j e => hh ⟨j, e⟩
      have h0y : ∀ j, Φy.br (z.parent hz) ≠ (unitClBlock (y.2 j)).upper := fun j e =>
        hh ((member_hinge_iffLow a mk y hy _).mp ⟨j, e⟩)
      obtain ⟨py, ly⟩ := hy1 h0y
      obtain ⟨pa, la⟩ := ha1 h0a
      rw [py, pa, ly, la]
      by_cases hc : IsCapFlowerParent (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a)
          (sourceLayer_isLayeringLow a)) J (a.prime.data.coreBranch a.prime.prime.1 (Φa.br (z.parent hz)))
      · rw [ite_eq_left hc, ite_eq_left ((member_cfp_iffLow a mk y hy hG J hcapA hcapY hrepU _).mpr hc)]
      · rw [ite_eq_right hc, ite_eq_right (fun h => hc ((member_cfp_iffLow a mk y hy hG J hcapA hcapY hrepU _).mp h))]

include hy hG hcapA hcapY in

end

