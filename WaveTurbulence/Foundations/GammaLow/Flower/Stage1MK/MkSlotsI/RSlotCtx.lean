/-- **The depth of a chain top on the capped stem is common to the run class.** -/
theorem member_chainTop_depthLow (hc : CleanPtLow J a)
    (c : GBranch (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.tree)
    (hst : OnCapStem (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a)) J (a.prime.data.coreBranch a.prime.prime.1
        ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).br c)).toNode) :
    (inflatedPosition y.1.skeleton y.1.data.tree ((memShapeLow a mk y hy).br c).toNode).2.length =
      (inflatedPosition a.prime.skeleton a.prime.data.tree
        ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).br c).toNode).2.length := by
  have hl := stemCore_length_memberLow a mk y hy J hcapA hcapY hG hc c ((MkMark.onCapStem_iff _ J _).mp hst)
  have hch := memShape_chain_eqLow a mk y hy hG c
  unfold ReconstructionData.corePosition at hl
  simp only [addrExt, List.length_append] at hl
  rw [hch] at hl
  omega

end

