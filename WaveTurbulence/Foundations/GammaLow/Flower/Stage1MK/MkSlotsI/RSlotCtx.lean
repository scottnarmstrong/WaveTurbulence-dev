/-- **The depth of an attached node on the capped stem is common to the run class** (stem-clean representative). -/
theorem member_attached_depthLow (hc : CleanPtLow J a)
    (z : GNode (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.tree)
    (hstA : MkSlotsT.OnStemAddr (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a)) J (attachedNode a.prime.data a.prime.prime.1
        ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).node z)).1)
    (hstY : MkSlotsT.OnStemAddr (layeredReconstruction y.1.data y.1.plain (stateLayer y.1)
      (stateLayer_isLayering y.1)) J (attachedNode y.1.data y.1.plain ((memShapeLow a mk y hy).node z)).1) :
    (attachedNode y.1.data y.1.plain ((memShapeLow a mk y hy).node z)).1.2.length =
      (attachedNode a.prime.data a.prime.prime.1
        ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).node z)).1.2.length := by
  by_cases hz : z.1.2 = []
  · rw [(attached_root_iff (memShapeLow a mk y hy) y.1.data y.1.plain z).mpr hz,
      (attached_root_iff (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime))
        a.prime.data a.prime.prime.1 z).mpr hz]
  · have hR₁ := MkSlotsT.stemRet_congr (sourceLayer_reconstructsLow a).symm
      (stemRet_repMkLow hc (mk a.prime))
    have hR₂ := stemRet_memberLow a mk y hy J hcapA hcapY hc
    obtain ⟨la, sa⟩ := attached_stem_depth (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma
      (mk a.prime)) a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J hR₁ z hz hstA
    obtain ⟨ly, -⟩ := attached_stem_depth (memShapeLow a mk y hy) y.1.data y.1.plain (stateLayer y.1)
      (stateLayer_isLayering y.1) J hR₂ z hz hstY
    rw [la, ly, stemCore_length_memberLow a mk y hy J hcapA hcapY hG hc (z.parent hz) sa]

include hcapA hcapY in

end

