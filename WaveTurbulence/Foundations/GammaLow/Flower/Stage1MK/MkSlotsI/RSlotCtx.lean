/-- **The core stem test at a `G_sb` atom is common to the run class** (γ's `onStem_core_iff`). -/
theorem member_coreStemLow (c : GBranch (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.tree) :
    OnCapStem (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J
        (y.1.data.coreBranch y.1.plain ((memShapeLow a mk y hy).br c)).toNode ↔
      OnCapStem (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)) J
        (a.prime.data.coreBranch a.prime.prime.1
          ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).br c)).toNode := by
  have h1 : OnCapStem (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J
      (y.1.data.coreBranch y.1.plain ((memShapeLow a mk y hy).br c)).toNode ↔
      MkSlotsT.OnStemAddr (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J
        (y.1.data.corePosition ((memShapeLow a mk y hy).br c)) := MkMark.onCapStem_iff _ J _
  have h2 : OnCapStem (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)) J
      (a.prime.data.coreBranch a.prime.prime.1
        ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).br c)).toNode ↔
      MkSlotsT.OnStemAddr (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a)
        (sourceLayer_isLayeringLow a)) J
        (a.prime.data.corePosition ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma
          (mk a.prime)).br c)) := MkMark.onCapStem_iff _ J _
  exact h1.trans ((MkSlotsT.onStem_core_iff (memShapeLow a mk y hy) y.1.data y.1.plain
    (stateLayer y.1) (stateLayer_isLayering y.1) hcapY c).trans
    ((MkSlotsT.onStem_core_iff (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime))
      a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) hcapA c).symm.trans h2.symm))

