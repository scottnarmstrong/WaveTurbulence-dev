/-- **The selection of the general member identity is α's `G_sb` weight**: the indicator of the common gap selection
at the restricted decoration and the dagger sibling indicator `restIndO` is `ZwGLow` at the restricted decoration. -/
theorem member_selAnd_ZwGLow (P : WTParams) [Fact (P.γ ≤ 1 / 2)] (hL1 : 1 ≤ P.L) {R p : ℕ} {kind : Bool}
    (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R)) (mk : Fama.Stage1Mk.MarkFn P.γ (2 * R))
    (hG : (Fama.stSt P.γ a.prime.skeleton a.totalSigma (mk a.prime)).G.IsPlain)
    (J : Finset (Fin (2 * R))) (roots : Fin (2 * R) → (Fin P.d → ℤ))
    (dag : Option (Fin (2 * R) → Fin 3 → Mom P.d))
    (hcapA : ∀ j ∈ J, (a.prime.data.garden a.prime.prime.1).tree j = TTree.leaf)
    (hrepU : ∀ j, ∀ b ∈ (Fama.unitBlkMk P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).atoms,
      ¬ IsCapFlowerParent (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a)
        (sourceLayer_isLayeringLow a)) J (a.prime.data.coreBranch a.prime.prime.1 b))
    (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk P.γ a mk))) (hy : y ∈ Fama.sourceClass P.γ a p kind mk)
    (hGeoY : CapGeo y.1.layered J p) (κ : GenDecoration y.1.skeleton P.d roots 0) :
    (if selAnd
        (fun κS => selSkCMkLow a mk P.L P.γ P.η (lt_of_lt_of_le zero_lt_one hL1).ne' 0 roots
          ((memShapeLow a mk y hy).resDec y.1.plain (Fama.source_disjMk a mk y hy) κS))
        (restIndO y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) P.L J dag) κ then (1 : ℝ)
      else 0) =
      ZwGLow a mk J P.L P.γ P.η (lt_of_lt_of_le zero_lt_one hL1).ne' roots dag
        ((memShapeLow a mk y hy).resDec y.1.plain (Fama.source_disjMk a mk y hy) κ) := by
  have hspec := stateLayer_spec y.1
  have hGeoR : CapGeo (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J p := by
    rw [hspec]; exact hGeoY
  have hcapY : ∀ j ∈ J, (y.1.data.garden y.1.plain).tree j = TTree.leaf := hGeoR.cap_leaf
  have hZ2 : sibIndAtLow J a (mk a.prime) dag (flwAtLow J a (mk a.prime))
      (cosetDecoration (Fama.stSt P.γ a.prime.skeleton a.totalSigma (mk a.prime)).G P.L 0
        ((memShapeLow a mk y hy).resDec y.1.plain (Fama.source_disjMk a mk y hy) κ).1) =
      if restIndO y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) P.L J dag κ then 1 else 0 := by
    cases dag with
    | none => simp [sibIndAtLow, restIndO]
    | some cc =>
      exact member_sibIndLow a mk y hy hG J hcapA hcapY hrepU hGeoR P.L cc κ
  unfold ZwGLow
  rw [hZ2]
  unfold selAnd
  by_cases h1 : selSkCMkLow a mk P.L P.γ P.η (lt_of_lt_of_le zero_lt_one hL1).ne' 0 roots
      ((memShapeLow a mk y hy).resDec y.1.plain (Fama.source_disjMk a mk y hy) κ) <;>
    by_cases h2 : restIndO y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) P.L J dag κ <;>
    simp [h1, h2]

end

