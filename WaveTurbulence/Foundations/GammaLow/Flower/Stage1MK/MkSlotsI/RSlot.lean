  (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (hy : y ∈ Fama.sourceClass γF a p kind mk)
  (hG : (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.IsPlain)
  (J : Finset (Fin (2 * R)))
  (hGeoA : CapGeo (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)) J p)
  (hGeoY : CapGeo (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J p)
  (pat : Fin (2 * R) → FixPat) (t s : ℝ)
  (hrepUP : ∀ j, ∀ b ∈ (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).atoms,
    fixCap (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)) J pat t s
      (a.prime.data.coreBranch a.prime.prime.1 b) = none)

include hy hG hGeoA hGeoY hrepUP in
/-- **R-slot: the general slot kernels of a member of the run class are the representative's.** For every slot `s'`
of `G_sb`, the member's general kernel at `Φ_y.iota s'` is `genSlotKerLow … (Φ_a.iota s')`. -/
theorem member_genSlotLow {d : ℕ} (L γ δ : ℝ) (σ kSel : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ)
    (h : ℕ → Fin (2 * R) → Fin (2 * R) → Mom d → ℝ) (roots : Fin (2 * R) → (Fin d → ℤ))
    (Rf : Fin (2 * R) → Option ℝ) (dag : Option (Fin (2 * R) → Fin 3 → Mom d))
    (hstem : Stage1MKGate.StemDep σ kSel → CleanPtLow J a)
    (s' : ReplacementSlot (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G) :
    MkSlotsB.slotFnGWFRL y.1.data y.1.plain L γ δ
        (anchProfiles J (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) h L
          roots)
        (chainW y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) L γ δ p s J Rf dag)
        (genΘs y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) J L σ kSel Rs)
        (stateLayer y.1) (stateLayer_isLayering y.1)
        (fixCap (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J pat t s)
        ((memShapeLow a mk y hy).iota y.1.plain hG s') =
      genSlotKerLow L γ δ p a J pat t s σ kSel Rs h roots Rf dag
        ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).iota a.prime.prime.1 hG s') := by
  have hex : Stage1MKGate.StemDep σ kSel → ∀ j,
      (selCap (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J kSel j).isSome =
        (selCap (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)) J kSel
          j).isSome := fun hsd j =>
    member_selExLow a mk y hy hG J hGeoA hGeoY (hrepU_of_patLow a mk J pat t s hrepUP) (hstem hsd) kSel j
  funext ts k
  cases s' with
  | inl q =>
    exact member_genSlot_inlLow a mk y hy hG J hGeoA hGeoY pat t s hrepUP L γ δ σ kSel Rs h roots Rf dag hstem
      hex q ts k
  | inr c =>
    exact member_genSlot_inrLow a mk y hy hG J hGeoA hGeoY pat t s hrepUP L γ δ σ kSel Rs h roots Rf dag hstem
      hex c ts k

end

