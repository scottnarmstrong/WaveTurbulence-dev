open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w : ℕ}

/-- **The lower bounds at a marked set `Mk`** (`lbGenLow`, ruling R187). -/
def lbGenAtLow (J : Finset (Fin w)) (pat : Fin w → FixPat) (t s : ℝ) (a : Fama.VineA.PrescribedPrimeGarden γF w)
    (Mk : Set (Fama.CLVineG γF a.prime.skeleton)) (c : GBranch (Fama.stSt γF a.prime.skeleton a.totalSigma Mk).G.tree) :
    Option ℝ :=
  if pat c.1.1 = FixPat.dParent ∧ fixAtLow J pat t s a Mk c = none ∧ ∃ u, PinTopBelowAtLow J pat t s a Mk c u
  then some s else none

end

