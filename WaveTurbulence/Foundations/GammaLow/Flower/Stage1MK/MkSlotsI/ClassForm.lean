/-- The skeleton slot of an outer slot `s'` of the spliced garden at `Mk` (main's splice shape `stShape … Mk`; at
`Mk = classMkLow mkF a` the slot `(shapeRepLow mkF a).iota … s'` of `GenSlotObligationAtLow`). -/
abbrev iotaAtLow (a : Fama.VineA.PrescribedPrimeGarden γF w) (Mk : Set (Fama.CLVineG γF a.prime.skeleton))
    (s' : ReplacementSlot (Fama.stSt γF a.prime.skeleton a.totalSigma Mk).G) : ReplacementSlot a.prime.skeleton :=
  (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma Mk).iota a.prime.prime.1
    ((Fama.stSt γF a.prime.skeleton a.totalSigma Mk).plain a.prime.prime.1) s'

end

section
open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkSlotsI
open scoped Classical ENNReal
open WaveTurbulence WaveTurbulence.LGSpine WaveTurbulence.Induct Set Finset MeasureTheory
open WaveTurbulence.Reg WaveTurbulence.Reg.Skeleton WaveTurbulence.RegRed WaveTurbulence.Represents
open WaveTurbulence.LGSpine.SourceVine WaveTurbulence.Flower.MkDefs WaveTurbulence.Flower.FinalMKDefs
open WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden WaveTurbulence.VineEstS3 WaveTurbulence.VineEstS3.FS WaveTurbulence.RepAnalytic WaveTurbulence.VineAlign
open WaveTurbulence.Flower.Stage1W WaveTurbulence.Flower.Stage1MKGate
open WaveTurbulence.RedSplice (stSt unitBlocks)
open WaveTurbulence.Flower.MkSlots (IsCapPair capTreeOf outerValMμD fixMeasure coreAt protAt fixAt flwAt sibIndAt recLG)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w : ℕ}

/-- **The conclusions of `GenSlotObligationAtLow Kg P` at the point `a`, for the slot data `sd`** (at every outer slot
`s'` of the spliced garden at the marked set `Mk` and every node centre `x`; revision 4 of W:MkSlotsI/SlotObl.lean,
the existential data of `∃ Λ … amp` being `sd s' x`):
* `supp`: the amplitudes of the leaf-pair slots are localized within distance `1` of their centres;
* `hasSum`: on the box `genBoxAtLow`, at the lattice momenta `latticePoint L n` consumed by the chain (the cap momentum on
  a cap pair, the root label on a root chain slot, the node ball of `x` on a non-root chain slot), the general slot
  kernel `genSlotKerLow` is the superposition `Σ_l w_l · a_l(k) · e(m_l · ts)`;
* `massEta`: off `SelAdj`, the `η`-moment mass is at most `Kg · genSlotMassLow`;
* `massSel`: on `SelAdj`, the `1/4`-moment mass is at most `Kg · L^{47d+2} · genSlotMassLow`. -/
structure SlotDataOKLow (Kg : ℕ → ℝ → ℝ) (P : WTParams) [Fact (P.γ ≤ 1 / 2)] (C : ℝ) {R : ℕ} (p : ℕ) (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R))
    (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat) (t s : ℝ) (kSel σ : Fin (2 * R) → Option ℕ)
    (Rs : Fin (2 * R) → ℝ) (roots : Fin (2 * R) → (Fin P.d → ℤ)) (h : ℕ → Fin (2 * R) → Fin (2 * R) → Mom P.d → ℝ)
    (b : ℝ) (Rf : Fin (2 * R) → Option ℝ) (dag : Option (Fin (2 * R) → Fin 3 → Mom P.d))
    (Mk : Set (Fama.CLVineG P.γ a.prime.skeleton))
    (sd : ReplacementSlot (Fama.stSt P.γ a.prime.skeleton a.totalSigma Mk).G → (Fin P.d → ℤ) → SlotDatum P.d) : Prop where
  supp : ∀ q x l k, (sd (Sum.inl q) x).a l k ≠ 0 → ‖k - latPt P.d ((sd (Sum.inl q) x).n l)‖ ≤ 1
  hasSum : ∀ s' x, ∀ ts ∈ genBoxAtLow p a J pat t s (iotaAtLow a Mk s'), TopCutLow a J pat t s (iotaAtLow a Mk s') ts → ∀ n : Fin P.d → ℤ,
    (∀ q, iotaAtLow a Mk s' = .inl q → IsCapPair a.prime.skeleton a.prime.prime.1 J q →
      n = roots (capTreeOf a.prime.skeleton a.prime.prime.1 J q)) →
    (∀ β : GBranch a.prime.skeleton.tree, iotaAtLow a Mk s' = .inr β → β.1.2 = [] → n = roots β.1.1) →
    (∀ β : GBranch a.prime.skeleton.tree, iotaAtLow a Mk s' = .inr β → β.1.2 ≠ [] →
      ‖latticePoint P.L n - latPt P.d x‖ ≤ 1) →
    HasSum (fun l => ((sd s' x).w l : ℂ) * (sd s' x).a l (latticePoint P.L n) * fsPhase ((sd s' x).m l) ts)
      (genSlotKerLow P.L P.γ P.δ p a J pat t s σ kSel Rs h roots Rf dag (iotaAtLow a Mk s') ts (latticePoint P.L n))
  massEta : ∀ s' x,
    ¬ SelAdj a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J kSel (iotaAtLow a Mk s') →
    ∑' l, maxBracketPow P.η (half ((sd s' x).m l)) * ENNReal.ofReal ((sd s' x).w l) ≤
      ENNReal.ofReal (Kg P.d P.η * genSlotMassLow P C b a J pat t s kSel Rs (iotaAtLow a Mk s'))
  massSel : ∀ s' x,
    SelAdj a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J kSel (iotaAtLow a Mk s') →
    ∑' l, maxBracketPow (1 / 4) (half ((sd s' x).m l)) * ENNReal.ofReal ((sd s' x).w l) ≤
      ENNReal.ofReal (Kg P.d P.η * P.L ^ (47 * (P.d : ℝ) + 2) *
        genSlotMassLow P C b a J pat t s kSel Rs (iotaAtLow a Mk s'))

end

section
open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkSlotsI
open scoped Classical ENNReal
open WaveTurbulence WaveTurbulence.LGSpine WaveTurbulence.Induct Set Finset MeasureTheory
open WaveTurbulence.Reg WaveTurbulence.Reg.Skeleton WaveTurbulence.RegRed WaveTurbulence.Represents
open WaveTurbulence.LGSpine.SourceVine WaveTurbulence.Flower.MkDefs WaveTurbulence.Flower.FinalMKDefs
open WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden WaveTurbulence.VineEstS3 WaveTurbulence.VineEstS3.FS WaveTurbulence.RepAnalytic WaveTurbulence.VineAlign
open WaveTurbulence.Flower.Stage1W WaveTurbulence.Flower.Stage1MKGate
open WaveTurbulence.RedSplice (stSt unitBlocks)
open WaveTurbulence.Flower.MkSlots (IsCapPair capTreeOf outerValMμD fixMeasure coreAt protAt fixAt flwAt sibIndAt recLG)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w : ℕ}

/-- **The obligation provides the slot data at every marked set equal to the class marking** (in particular at the
unit marking `mkU a.prime`, `hset`): `GenSlotObligationAtLow` + `exists_slotData`. -/
theorem exists_slotDataOKLow {Kg : ℕ → ℝ → ℝ} {P : WTParams} [Fact (P.γ ≤ 1 / 2)] (hobl : GenSlotObligationAtLow Kg P) (C : ℝ)
    (hC : P.C₁ ≤ C) {R p : ℕ} (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R)) (J : Finset (Fin (2 * R)))
    (pat : Fin (2 * R) → FixPat) (t s : ℝ) (hp : p < P.D) (hcan : IsCanonGC (p + 1) a.layered)
    (hsz : a.prime.data.size ≤ P.N (p + 1) ^ 4) (hJ : J.card = R) (hGeo : CapGeo a.layered J p)
    (hpat : CapPatValid a.layered J pat p) (hirr : a.layered.garden.Irreducible) (ht : t ∈ Ioo (p : ℝ) (p + 1))
    (hs : s ∈ Ioo (p : ℝ) t) (kSel : Fin (2 * R) → Option ℕ) (hpl : ∀ j, (kSel j).isSome → pat j = FixPat.plain)
    (σ : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ) (hRs : ∀ j, P.L ≤ Rs j) (mkF : Fama.Stage1Mk.MarkFn P.γ (2 * R))
    (hmk : FineMarkingLow J pat t s kSel σ mkF) (hstem : ¬ StemDep σ kSel ∨ CleanPtLow J a)
    (roots : Fin (2 * R) → (Fin P.d → ℤ)) (h : ℕ → Fin (2 * R) → Fin (2 * R) → Mom P.d → ℝ) (b : ℝ) (hb : 1 ≤ b)
    (hsn : ∀ q ≤ p, ∀ j j', SNormR (40 * P.d) (40 * P.d) (h q j j') ≤ ENNReal.ofReal b)
    (Rf : Fin (2 * R) → Option ℝ) (hRf : ∀ j r, Rf j = some r → P.L / 2 ≤ r)
    (hhigh : ((∃ i, σ i ≠ none) ∨ ∃ i, kSel i ≠ none) → ∀ j, j ∉ J → ∃ r, Rf j = some r ∧
      (∀ j' x, ‖x‖ ≥ r → h p j j' x = 0 ∧ h p j' j x = 0) ∧ r ^ 10 ≤ ‖latticePoint P.L (roots j)‖)
    (dag : Option (Fin (2 * R) → Fin 3 → Mom P.d)) (Mk : Set (Fama.CLVineG P.γ a.prime.skeleton))
    (hMk : Mk = classMkLow mkF a) :
    ∃ sd, SlotDataOKLow Kg P C p a J pat t s kSel σ Rs roots h b Rf dag Mk sd := by
  subst hMk
  obtain ⟨sd, hsd⟩ := exists_slotData (G := (Fama.stSt P.γ a.prime.skeleton a.totalSigma (classMkLow mkF a)).G) (d := P.d)
    (fun s' x Λ wt m c amp =>
      (∀ q, iotaAtLow a (classMkLow mkF a) s' = .inl q → ∀ l k, amp l k ≠ 0 → ‖k - latPt P.d (c l)‖ ≤ 1) ∧
      (∀ ts ∈ genBoxAtLow p a J pat t s (iotaAtLow a (classMkLow mkF a) s'), TopCutLow a J pat t s (iotaAtLow a (classMkLow mkF a) s') ts → ∀ n : Fin P.d → ℤ,
        (∀ q, iotaAtLow a (classMkLow mkF a) s' = .inl q → IsCapPair a.prime.skeleton a.prime.prime.1 J q →
          n = roots (capTreeOf a.prime.skeleton a.prime.prime.1 J q)) →
        (∀ β : GBranch a.prime.skeleton.tree, iotaAtLow a (classMkLow mkF a) s' = .inr β → β.1.2 = [] →
          n = roots β.1.1) →
        (∀ β : GBranch a.prime.skeleton.tree, iotaAtLow a (classMkLow mkF a) s' = .inr β → β.1.2 ≠ [] →
          ‖latticePoint P.L n - latPt P.d x‖ ≤ 1) →
        HasSum (fun l => (wt l : ℂ) * amp l (latticePoint P.L n) * fsPhase (m l) ts)
          (genSlotKerLow P.L P.γ P.δ p a J pat t s σ kSel Rs h roots Rf dag (iotaAtLow a (classMkLow mkF a) s') ts
            (latticePoint P.L n))) ∧
      (¬ SelAdj a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J kSel
          (iotaAtLow a (classMkLow mkF a) s') →
        ∑' l, maxBracketPow P.η (half (m l)) * ENNReal.ofReal (wt l) ≤
          ENNReal.ofReal (Kg P.d P.η * genSlotMassLow P C b a J pat t s kSel Rs (iotaAtLow a (classMkLow mkF a) s'))) ∧
      (SelAdj a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J kSel
          (iotaAtLow a (classMkLow mkF a) s') →
        ∑' l, maxBracketPow (1 / 4) (half (m l)) * ENNReal.ofReal (wt l) ≤
          ENNReal.ofReal (Kg P.d P.η * P.L ^ (47 * (P.d : ℝ) + 2) *
            genSlotMassLow P C b a J pat t s kSel Rs (iotaAtLow a (classMkLow mkF a) s'))))
    (fun s' x => hobl C hC a J pat t s hp hcan hsz hJ hGeo hpat hirr ht hs kSel hpl σ Rs hRs mkF hmk hstem roots h b
      hb hsn Rf hRf hhigh dag s' _ rfl x)
  exact ⟨sd, ⟨fun q x l k hk => (hsd (.inl q) x).1 _ rfl l k hk, fun s' x => (hsd s' x).2.1,
    fun s' x => (hsd s' x).2.2.1, fun s' x => (hsd s' x).2.2.2⟩⟩

end

