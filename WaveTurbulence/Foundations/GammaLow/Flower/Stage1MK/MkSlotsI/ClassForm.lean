theorem selRAt_image_congrLow {Mk Mk' : Set (Fama.CLVineG γF a.prime.skeleton)} (hMk : Mk = Mk') :
    (selRAtLow J kSel a Mk).image (fun v => v.1.1) = (selRAtLow J kSel a Mk').image (fun v => v.1.1) := by
