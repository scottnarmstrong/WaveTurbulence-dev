/-- **The general piece at a marked set `Mk`** (`pieceGenLow` with the marked set explicit). -/
def pieceGenAtLow (P : WTParams) [Fact (P.γ ≤ 1 / 2)] {R : ℕ} (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat) (t s : ℝ)
    (kSel σ : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ) (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R))
    (Mk : Set (Fama.CLVineG P.γ a.prime.skeleton)) (dag : Option (Fin (2 * R) → Fin 3 → Mom P.d)) :
    Stage1PieceMKG P R :=
  stage1PieceMKOfLow P a.prime.prime.1 a.layered a.prime.decodes a.totalSigma Mk
    (protAtLow J pat t s kSel a Mk) (protI a.layered J pat t s kSel).card (fixAtLow J pat t s a Mk)
    (filtGenAtLow J P.L σ kSel Rs a Mk) (indGenAtLow J P.L σ kSel a Mk dag) (lbGenAtLow J pat t s a Mk)

end

