/-- **The class kernels** at the unit marking `mk`: B3-2's weighted class kernel `unitHkFWLLow` of unit `j`
(`twistedRecenteredFWL` of the canonical class of the unit) with the per-unit top filters
`SURep a mk J (radTGen L σ kSel Rs) j` (CoreW's `top_member`, γ's `unitTopFilters_gen`), the frontier weights
`frontierG ∘ Rf` (RSlot's `unitSlot_plainLow`: the unit-internal slots carry B3's `slotFW … (frontierG ∘ Rf)`), the unit
Fama.VineA.PrescribedPrimeGarden.profile P.γ `unitProfile … h j` and the coset base `0`; the form of `unit_hinge_dataWMkLLow`'s kernels. -/
def unitKerGenLow (P : WTParams) [Fact (P.γ ≤ 1 / 2)] (p : ℕ) (J : Finset (Fin (2 * R))) (σ kSel : Fin (2 * R) → Option ℕ)
    (Rs : Fin (2 * R) → ℝ) (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R)) (mk : Fama.Stage1Mk.MarkFn P.γ (2 * R))
    (h : ℕ → Fin (2 * R) → Fin (2 * R) → Mom P.d → ℝ) (Rf : Fin (2 * R) → Option ℝ)
    (j : Fin (Fama.unitBlocks P.γ a.prime.skeleton a.totalSigma (mk a.prime)).length) :
    ℤ → (Fin 3 → ℝ) → (Fin 4 → Mom P.d) → ℂ :=
  unitHkFWLLow P p (SURepLow a mk J (radTGen P.L σ kSel Rs) j) (Fama.sourceAssemblyMk P.γ a mk j) a.prime.data
    a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) (fun j => frontierG (Rf j))
    (VineB.unitProfile (Fama.unitBlkMk P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)) h j) 0

end

section
open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkSlotsI
open scoped Classical ENNReal
open WaveTurbulence WaveTurbulence.LGSpine WaveTurbulence.Induct Set Finset MeasureTheory
open WaveTurbulence.Reg WaveTurbulence.Reg.Skeleton WaveTurbulence.RegRed WaveTurbulence.Represents
open WaveTurbulence.LGSpine.SourceVine WaveTurbulence.Flower.MkDefs WaveTurbulence.Flower.FinalMKDefs
open WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden WaveTurbulence.VineEstS3 WaveTurbulence.VineEstS3.FS WaveTurbulence.RepAnalytic WaveTurbulence.VineAlign
open WaveTurbulence.Flower.Stage1W WaveTurbulence.Flower.Stage1MKGate
open WaveTurbulence.RedSplice (stSt unitBlocks)
open WaveTurbulence.Flower.MkSlots (IsCapPair capTreeOf outerValMμD fixMeasure coreAt protAt fixAt flwAt sibIndAt recLG)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w : ℕ}
variable {R : ℕ}

/-- **The centre-indexed form of a class value** at the representative `a` and the unit marking `mk`: `centreFormLow` with
* the piece `pieceGenAtLow … a (mk a.prime) dag` (`G_sb = (Fama.stSt P.γ a.prime.skeleton a.totalSigma (mk a.prime)).G`, plain),
  top times `t`, coset base `0`;
* the common gap selection `selSkCMk a mk L γ η _ 0 roots`;
* the domain `domOfLow` of the piece;
* main's routes, hinge clocks and hinge momenta of `stShape … (mk a.prime)`;
* one class term (`I = Unit`): the constant `sgnGenLow`, the slot families `fam₀Of sd hsupp` and `famCOfData sd`, the
  class kernels `unitKerGenLow`. -/
def classCentreRHSLow (P : WTParams) [Fact (P.γ ≤ 1 / 2)] (p : ℕ) (hL1 : 1 ≤ P.L) (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat)
    (t s : ℝ) (kSel σ : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ) (roots : Fin (2 * R) → (Fin P.d → ℤ))
    (h : ℕ → Fin (2 * R) → Fin (2 * R) → Mom P.d → ℝ) (Rf : Fin (2 * R) → Option ℝ)
    (dag : Option (Fin (2 * R) → Fin 3 → Mom P.d)) (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R)) (mk : Fama.Stage1Mk.MarkFn P.γ (2 * R))
    (sd : ReplacementSlot (Fama.stSt P.γ a.prime.skeleton a.totalSigma (mk a.prime)).G → (Fin P.d → ℤ) → SlotDatum P.d)
    (hsupp : ∀ q x l k, (sd (Sum.inl q) x).a l k ≠ 0 → ‖k - latPt P.d ((sd (Sum.inl q) x).n l)‖ ≤ 1) : ℂ :=
  centreFormLow (pieceGenAtLow P J pat t s kSel σ Rs a (mk a.prime) dag)
    ((Fama.stSt P.γ a.prime.skeleton a.totalSigma (mk a.prime)).plain a.prime.prime.1) (fun _ => t) 0 roots
    (selSkCMkLow a mk P.L P.γ P.η (lt_of_lt_of_le zero_lt_one hL1).ne' 0 roots)
    (domOfLow (pieceGenAtLow P J pat t s kSel σ Rs a (mk a.prime) dag) (fun _ => t))
    ((Fama.stShape P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).route a.prime.prime.1
      ((Fama.stSt P.γ a.prime.skeleton a.totalSigma (mk a.prime)).plain a.prime.prime.1))
    ((Fama.stShape P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).hclk
      (Fama.unitBlkMk_disj (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)))
    ((Fama.stShape P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).hmom
      (Fama.unitBlkMk_disj (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)))
    (fun _ : Unit => sgnGenLow J P.L P.γ P.δ s kSel Rs a mk roots dag)
    (fun _ => fam₀Of sd hsupp) (fun _ => famCOfData sd)
    (fun _ => unitKerGenLow P p J σ kSel Rs a mk h Rf)

end

section
open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkSlotsI
open scoped Classical ENNReal
open WaveTurbulence WaveTurbulence.LGSpine WaveTurbulence.Induct Set Finset MeasureTheory
open WaveTurbulence.Reg WaveTurbulence.Reg.Skeleton WaveTurbulence.RegRed WaveTurbulence.Represents
open WaveTurbulence.LGSpine.SourceVine WaveTurbulence.Flower.MkDefs WaveTurbulence.Flower.FinalMKDefs
open WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden WaveTurbulence.VineEstS3 WaveTurbulence.VineEstS3.FS WaveTurbulence.RepAnalytic WaveTurbulence.VineAlign
open WaveTurbulence.Flower.Stage1W WaveTurbulence.Flower.Stage1MKGate
open WaveTurbulence.RedSplice (stSt unitBlocks)
open WaveTurbulence.Flower.MkSlots (IsCapPair capTreeOf outerValMμD fixMeasure coreAt protAt fixAt flwAt sibIndAt recLG)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w : ℕ}

/-- **`ClassCentreIdentityAtLow Kg P`** — the class value in the centre-indexed outer mode form consumed by
`CentreEngine`'s `hval`. For every class (the binders of `ClassRepGenLow` up to `π` and its hypotheses), every
unit marking `mkU` with `mkU (Fama.Represents.repPt P.γ π).prime = classMkLow mkF (Fama.Represents.repPt P.γ π)` and the same Fama.VineA.PrescribedPrimeGarden.outputsLow (α's IntAsm4
`obtain ⟨mkU, hset, hout⟩`), every constant `C` and every choice of slot data `sd` with the conclusions of
`GenSlotObligationAtLow Kg P` at the representative and the marked set `mkU (Fama.Represents.repPt P.γ π).prime` (`SlotDataOKLow`; provided by
`exists_slotDataOKLow` from the obligation and `hset`):
`classValueLow … = classCentreRHSLow …`, i.e.
`Σ_{i : Unit} sgnGenLow · Σ'_X Σ'_ξ (∏_t w) · outerValMμD G_sb … (domOfLow πM) πM.Cs.hinges
  (fun z => pieceAtomW πM (coset z) · [selSkCMk … z] · chiX L 0 X z) … (fixMeasure πM.fix) … route hclk hmom
  (unitKerGenLow …)` with `πM = pieceGenAtLow … (mkU (Fama.Represents.repPt P.γ π).prime) dag`, the families `famX (fam₀Of sd _) (famCOfData sd) X`.

The record hypotheses `1 ≤ d`, `1 ≤ L` (the member identity `member_skelValGLow`, VBC), `0 ≤ η` (the uniform chain-piece
weight bound `hMC` of VBC from `massEta`/`massSel`, `maxBracketPow ≥ 1`) come first. To be proved (next phase) for every
`Kg` and `P` from the member chain; the assembly consumes it as the engine's `hval` (`classCentreRHSLow` and `centreFormLow`
unfold to the engine's expression; checked against `representsIntMKSel_of_centreModesLow`).

Where each engine quantity comes from (`a = Fama.Represents.repPt P.γ π`, `G_sb = (Fama.stSt P.γ a.prime.skeleton a.totalSigma (mkU a.prime)).G`,
the target of the members' shapes `memShape a mkU y hy`):
* `π := pieceGenAtLow … (mkU a.prime) dag`: B4's `pieceGen` (`pieceGenAt_classMk`), back by
  `representsIntMKSel_pieceGenAt_congrLow`/`representsIntMK_pieceGenAt_congrLow`/`selRAt_image_congrLow` along `hset`;
* `selSk := selSkCMk a mkU L γ η _ 0 roots`: the selection of `member_skelValGLow` (B3's `hZ_commonMkLow`); `hgsp` is α's
  `normalizedPiece_gapIndicatorMk`;
* `Zw z = pieceAtomW π (coset z) · [selSk z]`, `sgn = sgnGenLow`: the member weight `[selSk ∧ restIndO] · genZa`
  (`member_skelValGLow`) is, at `z = resDec κ`, `selOK(a) · selConst(a) · zatomGLow z · sibIndAtLow (coset z) · [selSk z]`
  (CoreW's `zatom_member'Low`, `selOK_memberLow`, `selConst_memberLow`, `member_selAnd_ZwGLow`), and
  `zatomGLow · sibIndAtLow = chiDNorm^{#selR} · pieceAtomW π` (`zatomG_mul_sibIndAtLow` with `hset`); the dagger constant is
  `capConstO a mkU …` (`member_skelValGLow`); `‖Zw‖ ≤ 1` (filters, `indGenAtLow ∈ [0,1]`); mass `norm_sgnGen_leLow`;
* `Dom := domOfLow π (fun _ => t)`, `μ = fixMeasure π.fix`, hinges `π.Cs.hinges`: VBC's `splicedTimeDomainFix G_sb
  (layer_y ∘ core ∘ br) tt (fixS_y ∘ br) ∩ lbDomR (lbS_y ∘ br)` with the class-common layers (B3), pins (β's
  `member_fixCap_pat`) and lower bounds — the prover must identify `lbS_y ∘ br_y` with `lbGenAtLow … (mkU a.prime)` on the
  pinned slice (β's `lbAt`, `lbS_dParent`: lower bounds only on `dParent` trees); `hsliceD` is `domOf_eq_fixLB`;
* `route`, `hclk`, `hmom`: main's `stShape … (mkU a.prime)` (members: B3's shape equalities, e.g. `memShape_hmom`);
* `fam₀ = fam₀Of sd hsd.supp`, `famC = famCOfData sd`: VBC's `hexp₀` (cap momenta, root labels: `hsd.hasSum` at `x = 0`)
  and `hexpC` (centre `y`: `hsd.hasSum` at `x = y`), after RSlot (`member_genSlot_*`: member kernel = `genSlotKerLow` of
  `a`) and Box (`slotTs_mem_genSlotBox`); NOTE: `hsd.hasSum` holds at the lattice momenta `latticePoint L n` only, and
  its root/non-root case split is on the skeleton branch `br c` (the prover needs `(br c).1.2 = [] ↔ c.1.2 = []` and a
  lattice-momentum version of VBC's `hexpC`, the chain reading the slot kernels only at `0 + latticePoint L (z _)`);
* `HkM = unitKerGenLow`: T4D's `weightedClassFactorizationμDLZ` (class kernels `twistedRecenteredFWL`, = B3-2's
  `unitHkFWL`), unit kernels via B3-2's `unitKernelMG_slotFWW_eq` with RSlot's `unitSlot_plainLow` and CoreW's
  `top_member`; the hinge data is `unit_hinge_dataWMkLLow` (same kernels) + β's `hHkPropD_of_hHkProp`. -/
def ClassCentreIdentityAtLow (Kg : ℕ → ℝ → ℝ) (P : WTParams) [Fact (P.γ ≤ 1 / 2)] : Prop :=
  1 ≤ P.d → ∀ hL1 : 1 ≤ P.L, 0 ≤ P.η → ∀ C : ℝ,
  ∀ p, p < P.D → ∀ R, 1 ≤ R → R ≤ 10 * P.R (p + 1) → ∀ N, 1 ≤ N → N ≤ P.N (p + 1) ^ 4 →
  ∀ (J : Finset (Fin (2 * R))), J.card = R → ∀ (pat : Fin (2 * R) → FixPat) (kSel : Fin (2 * R) → Option ℕ),
  ∀ t ∈ Ioo (p : ℝ) (p + 1), ∀ s ∈ Ioo (p : ℝ) t,
  ∀ A : Finset (LayeredGarden (2 * R)),
    (∀ LG ∈ A, MkCarries P p N LG ∧ (∀ h : 2 * R = 2, ¬ IsRegularCouple (h ▸ LG.garden : Garden 2)) ∧
      LG.garden.Irreducible ∧ (∀ j ∈ J, LG.garden.tree j = TTree.leaf) ∧ CapGeo LG J p ∧ CapPatValid LG J pat p) →
    (∀ j, (kSel j).isSome → pat j = FixPat.plain) →
    MarkedTwistClosed p A (protSkOf R J (fun LG => fixCap LG J pat t s) (fun LG => selSetCap LG J kSel)) →
  ∀ (roots : Fin (2 * R) → (Fin P.d → ℤ))
    (h : ℕ → Fin (2 * R) → Fin (2 * R) → Mom P.d → ℝ) (b : ℝ) (Rf : Fin (2 * R) → Option ℝ)
    (σ : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ) (dag : Option (Fin (2 * R) → Fin 3 → Mom P.d)),
    1 ≤ b → (∀ q ≤ p, ∀ j j', SNormR (40 * P.d) (40 * P.d) (h q j j') ≤ ENNReal.ofReal b) →
    (∀ j r, Rf j = some r → P.L / 2 ≤ r) → (∀ j, P.L ≤ Rs j) →
    (((∃ i, σ i ≠ none) ∨ ∃ i, kSel i ≠ none) → ∀ j, j ∉ J → ∃ r, Rf j = some r ∧
      (∀ j' x, ‖x‖ ≥ r → h p j j' x = 0 ∧ h p j' j x = 0) ∧ r ^ 10 ≤ ‖latticePoint P.L (roots j)‖) →
  ∀ (mkF : Fama.Stage1Mk.MarkFn P.γ (2 * R)), FineMarkingLow J pat t s kSel σ mkF →
  ∀ π : Fama.Represents.PcA P.γ R p (objKind (2 * R)) A mkF,
    (¬ StemDep σ kSel ∨ ∀ a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R),
      Fama.VineA.PrescribedPrimeGarden.Related P.γ (p := p) (kind := objKind (2 * R)) (Fama.Represents.repPt P.γ π) a mkF → CleanPtLow J a) →
  ∀ mkU : Fama.Stage1Mk.MarkFn P.γ (2 * R), mkU (Fama.Represents.repPt P.γ π).prime = classMkLow mkF (Fama.Represents.repPt P.γ π) →
    (Fama.Represents.repPt P.γ π).outputsLow (p := p) (kind := objKind (2 * R)) mkU =
      (Fama.Represents.repPt P.γ π).outputsLow (p := p) (kind := objKind (2 * R)) mkF →
  ∀ (sd : ReplacementSlot (Fama.stSt P.γ (Fama.Represents.repPt P.γ π).prime.skeleton (Fama.Represents.repPt P.γ π).totalSigma (mkU (Fama.Represents.repPt P.γ π).prime)).G →
      (Fin P.d → ℤ) → SlotDatum P.d)
    (hsd : SlotDataOKLow Kg P C p (Fama.Represents.repPt P.γ π) J pat t s kSel σ Rs roots h b Rf dag (mkU (Fama.Represents.repPt P.γ π).prime) sd),
  classValueLow P p J pat kSel t s A roots h Rf σ Rs dag mkF π =
    classCentreRHSLow P p hL1 J pat t s kSel σ Rs roots h Rf dag (Fama.Represents.repPt P.γ π) mkU sd hsd.supp

end

