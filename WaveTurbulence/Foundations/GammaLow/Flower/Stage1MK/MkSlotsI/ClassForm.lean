variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w : ℕ}
variable (P : WTParams) [Fact (P.γ ≤ 1 / 2)] {R : ℕ} (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat) (t s : ℝ)
  (kSel σ : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ) (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R))
  (dag : Option (Fin (2 * R) → Fin 3 → Mom P.d))

/-- **The atom weight of `G_sb` at a marked set `Mk = classMkLow mkF a`** (CoreW's `zatomG_mul_sibIndLow`, transported):
`zatomGLow z · sibIndAtLow (coset z) = chiDNorm ^ #selRAtLow · pieceAtomW (pieceGenAtLow …) (coset z)`. -/
theorem zatomG_mul_sibIndAtLow (mkF : Fama.Stage1Mk.MarkFn P.γ (2 * R))
    (hsub : ∀ {LG : LayeredGarden (2 * R)} (B : PrimeData LG), markILow (γF := P.γ) J pat t s kSel B ⊆ mkF B)
    (hL : 1 ≤ P.L) (hRs : ∀ j, P.L ≤ Rs j) (Mk : Set (Fama.CLVineG P.γ a.prime.skeleton)) (hMk : Mk = classMkLow mkF a)
    {roots : Fin (2 * R) → (Fin P.d → ℤ)} (z : GenDecoration (Fama.stSt P.γ a.prime.skeleton a.totalSigma Mk).G P.d roots 0) :
    zatomGLow J P.L σ kSel Rs a Mk z *
        ((sibIndAtLow J a Mk dag (flwAtLow J a Mk) (cosetDecoration (Fama.stSt P.γ a.prime.skeleton a.totalSigma Mk).G P.L 0 z.1) :
          ℝ) : ℂ) =
      (chiDNorm : ℂ) ^ (selRAtLow J kSel a Mk).card *
        pieceAtomWLow (pieceGenAtLow P J pat t s kSel σ Rs a Mk dag)
          (cosetDecoration (Fama.stSt P.γ a.prime.skeleton a.totalSigma Mk).G P.L 0 z.1) := by
  subst hMk
  exact zatomG_mul_sibIndLow P J pat t s kSel σ Rs mkF a dag hsub hL hRs z

end

