/-- **A selected representation by the piece at `Mk` is one at every equal marked set** (α's
`representsIntMK_pieceAt_congr` for `RepresentsIntMKSelG`, the residual selected atoms transported along). -/
theorem representsIntMKSel_pieceGenAt_congrLow {Mk Mk' : Set (Fama.CLVineG P.γ a.prime.skeleton)} (hMk : Mk = Mk')
    {n : ℕ} {cP : ℝ} {tt : Fin (2 * R) → ℝ} {base : Mom P.d} {roots : Fin (2 * R) → (Fin P.d → ℤ)} {m : ℝ}
    {val : ℂ}
    (h : RepresentsIntMKSelG (pieceGenAtLow P J pat t s kSel σ Rs a Mk dag) (selRAtLow J kSel a Mk) n cP tt base roots m
      val) :
    RepresentsIntMKSelG (pieceGenAtLow P J pat t s kSel σ Rs a Mk' dag) (selRAtLow J kSel a Mk') n cP tt base roots m
      val := by
  subst hMk
  exact h

end

