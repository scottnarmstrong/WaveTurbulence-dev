variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w : ℕ}

/-- The pinned object tops below an atom `c` at a marked set `Mk` (`PinTopBelowLow`). -/
def PinTopBelowAtLow (J : Finset (Fin w)) (pat : Fin w → FixPat) (t s : ℝ) (a : Fama.VineA.PrescribedPrimeGarden γF w)
    (Mk : Set (Fama.CLVineG γF a.prime.skeleton)) (c : GBranch (Fama.stSt γF a.prime.skeleton a.totalSigma Mk).G.tree)
    (u : GBranch a.layered.garden.tree) : Prop :=
  (fixCap a.layered J pat t s u).isSome ∧ u.IsChildOf (coreAtLow a Mk c) ∧
    ∀ c' : GBranch (Fama.stSt γF a.prime.skeleton a.totalSigma Mk).G.tree, coreAtLow a Mk c' ≠ u

end

