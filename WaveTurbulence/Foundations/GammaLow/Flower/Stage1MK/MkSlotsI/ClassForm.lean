variable {w : ℕ}

/-- **The residual selected atoms at a marked set `Mk`** (δ's `selROfLow` with the marked set explicit): the
atoms of `G_sb = (Fama.stSt γF a.prime.skeleton a.totalSigma Mk).G` whose core branch is a selected vertex. -/
def selRAtLow (J : Finset (Fin w)) (kSel : Fin w → Option ℕ) (a : Fama.VineA.PrescribedPrimeGarden γF w)
    (Mk : Set (Fama.CLVineG γF a.prime.skeleton)) : Finset (GBranch (Fama.stSt γF a.prime.skeleton a.totalSigma Mk).G.tree) :=
  univ.filter fun c => coreAtLow a Mk c ∈ selSetCap a.layered J kSel

end

