open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w : ℕ}

/-- **The indicator at a marked set `Mk`** (`indGenLow`): α's dagger sibling indicator `sibIndAtLow` times σ's
filter at the residual selected atoms. -/
def indGenAtLow {d : ℕ} (J : Finset (Fin w)) (L : ℝ) (σ kSel : Fin w → Option ℕ) (a : Fama.VineA.PrescribedPrimeGarden γF w)
    (Mk : Set (Fama.CLVineG γF a.prime.skeleton)) (dag : Option (Fin w → Fin 3 → Mom d))
    (k : GNode (Fama.stSt γF a.prime.skeleton a.totalSigma Mk).G.tree → Mom d) : ℝ :=
  sibIndAtLow J a Mk dag (flwAtLow J a Mk) k *
    ∏ v ∈ selRAtLow J kSel a Mk,
      MkSlotsT.radProd (MkSlotsT.radSigma L σ v) (omegaNode (Fama.stSt γF a.prime.skeleton a.totalSigma Mk).G k v)

end

