open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w : ℕ}

/-- **The atom filters at a marked set `Mk`** (`filtGenLow` with the marked set explicit; main's splice shape
`stShape … Mk`). -/
def filtGenAtLow (J : Finset (Fin w)) (L : ℝ) (σ kSel : Fin w → Option ℕ) (Rs : Fin w → ℝ)
    (a : Fama.VineA.PrescribedPrimeGarden γF w) (Mk : Set (Fama.CLVineG γF a.prime.skeleton))
    (c : GBranch (Fama.stSt γF a.prime.skeleton a.totalSigma Mk).G.tree) : Option (ℝ × SchwartzMap ℝ ℂ) :=
  if c ∈ selRAtLow J kSel a Mk then some (Rs c.1.1, MkSlotsS.chiDNS)
  else MkSlotsT.filtStem a.prime.data a.prime.prime.1
    (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma Mk)
    (Fama.unitBlkMk_disj (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma Mk)
    (sourceLayerLow a) (sourceLayer_isLayeringLow a) J (MkSlotsG.radGen (recALow a) J L σ kSel Rs)
    (MkSlotsG.one_le_radGen (recALow a) J L σ kSel Rs) c

end

