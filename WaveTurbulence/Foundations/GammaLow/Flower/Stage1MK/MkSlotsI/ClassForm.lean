section
open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkSlotsI
open scoped Classical ENNReal
open WaveTurbulence WaveTurbulence.LGSpine WaveTurbulence.Induct Set Finset MeasureTheory
open WaveTurbulence.Reg WaveTurbulence.Reg.Skeleton WaveTurbulence.RegRed WaveTurbulence.Represents
open WaveTurbulence.LGSpine.SourceVine WaveTurbulence.Flower.MkDefs WaveTurbulence.Flower.FinalMKDefs
open WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden WaveTurbulence.VineEstS3 WaveTurbulence.VineEstS3.FS WaveTurbulence.RepAnalytic WaveTurbulence.VineAlign
open WaveTurbulence.Flower.Stage1W WaveTurbulence.Flower.Stage1MKGate
open WaveTurbulence.RedSplice (stSt unitBlocks)
open WaveTurbulence.Flower.MkSlots (IsCapPair capTreeOf outerValMμD fixMeasure coreAt protAt fixAt flwAt sibIndAt recLG)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w : ℕ}
variable {R : ℕ}

/-- **The class constant** of a fine′ class at the unit marking `mk`: the `G_sb` dagger constant `capConstO a mk …`
(`member_skelValGLow`; = `restConstO` of every member, α's `member_restConst`), the selection test `selOK` and the
selection constant `∏_j [v_j] Rs_j⁻¹` of the representative (CoreW's `selOK_mul_genCoreW_member_gen`: common to the
run class), and `chiDNorm ^ #selR` (`zatomG_mul_sibIndAtLow`: the selected filter `chiD = chiDNorm · chiDN` at the
residual selected atoms). -/
def sgnGenLow {d : ℕ} (J : Finset (Fin (2 * R))) (L γ δ s : ℝ) (kSel : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ)
    (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R)) (roots : Fin (2 * R) → (Fin d → ℤ))
    (dag : Option (Fin (2 * R) → Fin 3 → Mom d)) : ℂ :=
  capConstOLow a mk J L γ δ s roots dag *
    ((selOK (recLGLow a) J kSel : ℂ) *
      ((∏ j, (selCap (recLGLow a) J kSel j).elim 1 (fun _ => (((Rs j)⁻¹ : ℝ) : ℂ))) *
        (chiDNorm : ℂ) ^ (selRAtLow J kSel a (mk a.prime)).card))

end

section
open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkSlotsI
open scoped Classical ENNReal
open WaveTurbulence WaveTurbulence.LGSpine WaveTurbulence.Induct Set Finset MeasureTheory
open WaveTurbulence.Reg WaveTurbulence.Reg.Skeleton WaveTurbulence.RegRed WaveTurbulence.Represents
open WaveTurbulence.LGSpine.SourceVine WaveTurbulence.Flower.MkDefs WaveTurbulence.Flower.FinalMKDefs
open WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden WaveTurbulence.VineEstS3 WaveTurbulence.VineEstS3.FS WaveTurbulence.RepAnalytic WaveTurbulence.VineAlign
open WaveTurbulence.Flower.Stage1W WaveTurbulence.Flower.Stage1MKGate
open WaveTurbulence.RedSplice (stSt unitBlocks)
open WaveTurbulence.Flower.MkSlots (IsCapPair capTreeOf outerValMμD fixMeasure coreAt protAt fixAt flwAt sibIndAt recLG)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w : ℕ}
variable {R : ℕ}

/-- **The mass of the class constant**: `‖sgnGenLow‖ ≤ (∏_{kSel j ≠ none} Rs_j⁻¹) · chiDNorm ^ #selR` (the first factor
is the main factor of `selMassMK`; `chiDNorm ^ #selR` is paid by the `C₁` lift or by `L^{7(47d+2)#sel}`). -/
theorem norm_sgnGen_leLow {d : ℕ} (J : Finset (Fin (2 * R))) (L γ δ s : ℝ) (kSel : Fin (2 * R) → Option ℕ)
    (Rs : Fin (2 * R) → ℝ) (hRs : ∀ j, 0 < Rs j) (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R))
    (mk : Fama.Stage1Mk.MarkFn γF (2 * R)) (roots : Fin (2 * R) → (Fin d → ℤ)) (dag : Option (Fin (2 * R) → Fin 3 → Mom d)) :
    ‖sgnGenLow J L γ δ s kSel Rs a mk roots dag‖ ≤
      (∏ j, if (kSel j).isSome then (Rs j)⁻¹ else 1) * chiDNorm ^ (selRAtLow J kSel a (mk a.prime)).card := by
  have hP0 : 0 ≤ ∏ j, (if (kSel j).isSome then (Rs j)⁻¹ else 1 : ℝ) :=
    Finset.prod_nonneg fun j _ => by
      split_ifs
      · exact (inv_pos.2 (hRs j)).le
      · exact zero_le_one
  have hC0 : 0 ≤ chiDNorm ^ (selRAtLow J kSel a (mk a.prime)).card := pow_nonneg chiDNorm_pos.le _
  have hCn : ‖(chiDNorm : ℂ) ^ (selRAtLow J kSel a (mk a.prime)).card‖ =
      chiDNorm ^ (selRAtLow J kSel a (mk a.prime)).card := by
    rw [norm_pow, Complex.norm_real, Real.norm_of_nonneg chiDNorm_pos.le]
  unfold sgnGenLow
  rw [norm_mul, norm_capConstOLow, one_mul, norm_mul, norm_mul, hCn]
  by_cases hok : ∀ j, (kSel j).isSome → (selCap (recLGLow a) J kSel j).isSome
  · have h1 : selOK (recLGLow a) J kSel = 1 := (selOK_eq_one_iff _ _ _).2 hok
    rw [h1, Complex.ofReal_one, norm_one, one_mul, norm_prod]
    refine mul_le_mul_of_nonneg_right (le_of_eq (Finset.prod_congr rfl fun j _ => ?_)) hC0
    by_cases hk : (kSel j).isSome
    · obtain ⟨v, hv⟩ := Option.isSome_iff_exists.1 (hok j hk)
      rw [hv]
      simp only [Option.elim, hk, ↓reduceIte, Complex.norm_real, Real.norm_of_nonneg (inv_pos.2 (hRs j)).le]
    · have hn : selCap (recLGLow a) J kSel j = none := by
        unfold selCap
        rw [Option.not_isSome_iff_eq_none.1 hk]
        rfl
      rw [hn]
      simp only [Option.elim, hk, Bool.false_eq_true, ↓reduceIte, norm_one]
  · have h0 : selOK (recLGLow a) J kSel = 0 := by
      unfold selOK
      exact ite_eq_right_iff.2 fun h => absurd h hok
    rw [h0, Complex.ofReal_zero, norm_zero, zero_mul]
    exact mul_nonneg hP0 hC0

end

