  (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk P.γ a mk))) (hy : y ∈ Fama.sourceClass P.γ a p kind mk)
  (hG : (Fama.stSt P.γ a.prime.skeleton a.totalSigma (mk a.prime)).G.IsPlain) (J : Finset (Fin (2 * R)))

include hy hG in
/-- **The top weight of a member at a unit top is B3-2's top filter** (stem-free, or stem-clean with the
representative's selection present). -/
theorem genTw_top_memberLow (pat : Fin (2 * R) → FixPat) (t s : ℝ) (kSel σ : Fin (2 * R) → Option ℕ)
    (Rs : Fin (2 * R) → ℝ) (mkF : Fama.Stage1Mk.MarkFn P.γ (2 * R))
    (hsub : ∀ {LG : LayeredGarden (2 * R)} (B : PrimeData LG), markILow (γF := P.γ) J pat t s kSel B ⊆ mkF B)
    (hset : mk a.prime = classMkLow mkF a)
    (hcapA : ∀ j ∈ J, (a.prime.data.garden a.prime.prime.1).tree j = TTree.leaf)
    (hrepU : ∀ j, ∀ b ∈ (Fama.unitBlkMk P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).atoms,
      ¬ IsCapFlowerParent (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a)
        (sourceLayer_isLayeringLow a)) J (a.prime.data.coreBranch a.prime.prime.1 b))
    (hGeoA : CapGeo (recLGLow a) J p) (hGeoY : CapGeo y.1.layered J p) (hstem : ¬ StemDep σ kSel ∨ CleanPtLow J a)
    (hok : selOK (recLGLow a) J kSel = 1)
    (j : Fin (Fama.unitBlocks P.γ a.prime.skeleton a.totalSigma (mk a.prime)).length) :
    genTw (d := P.d) y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) J P.L σ kSel Rs
        (unitClBlock (y.2 j)).upper =
      V5W2L.topFilterWeightL (SURepLow a mk J (radTGen P.L σ kSel Rs) j) := by
  have hspec := stateLayer_spec y.1
  have hGeoR : CapGeo (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J p := by
    rw [hspec]; exact hGeoY
  have hcapY : ∀ j ∈ J, (y.1.data.garden y.1.plain).tree j = TTree.leaf := hGeoR.cap_leaf
  funext q
  rcases hstem with hns | hc
  · obtain ⟨rfl, rfl⟩ := eq_none_of_not_stemDep hns
    have hSU : SURepLow a mk J (radTGen P.L (fun _ => none) (fun _ => none) Rs) j = [] := by
      rw [radTGen_stemFree]
      unfold SURepLow MkSlotsT.SUStem
      split_ifs <;> rfl
    rw [hSU]
    unfold genTw
    exact (genNW_stemFree _ J P.L Rs _ _).trans (by simp [V5W2L.topFilterWeightL])
  · have hselA := (selOK_eq_one_iff _ J kSel).1 hok
    have hselY : ∀ j, (kSel j).isSome → (selCap (layeredReconstruction y.1.data y.1.plain (stateLayer y.1)
        (stateLayer_isLayering y.1)) J kSel j).isSome :=
      (selOK_eq_one_iff _ J kSel).1 ((selOK_memberLow a mk y hy J hcapA hcapY hG hc hGeoA.one_flower hGeoR.one_flower
        kSel).trans hok)
    unfold genTw
    rw [genNW_top_memberLow a mk y hy hG J hcapA hcapY hrepU hc hGeoA.one_flower hGeoR.one_flower kSel P.L σ Rs hselY
      (fun j => rep_tops_not_selLow J pat t s kSel mkF hsub a mk hset j) j]
    rfl

end

