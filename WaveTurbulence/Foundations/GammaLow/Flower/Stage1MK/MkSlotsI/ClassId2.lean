        (SURepLow a mk J (radTGen P.L σ kSel Rs) j) y.1 (y.2 j) P.L P.γ P.δ
        (unitProfile (Fama.unitBlkMk P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)) h j) 0
        (modW lam) (t' 0) (t' 1) (t' 2) (k 0) (k 1) (k 2) (k 3) :=
  (unitKernelMGW_agree (member_regAgreeLow P a mk y hy hG J pat t s kSel σ Rs mkF hsub hset h roots Rf dag hGeoA hGeoY
    hrepUP hstem hok) y.1.data P.L P.γ P.δ (stateLayer y.1) 0).trans
    (member_ker_eqWMkLLow a mk y hy P.L P.γ P.δ h 0 (fun j => frontierG (Rf j)) hcanY hlay
      (SURepLow a mk J (radTGen P.L σ kSel Rs)))

end

