variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable (P : WTParams) [Fact (P.γ ≤ 1 / 2)] {R : ℕ} (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat) (t s : ℝ)
  (kSel σ : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ) (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R))
  (dag : Option (Fin (2 * R) → Fin 3 → Mom P.d))

/-- **The `G_sb` decoration weight of the class**: the piece's atom weight at the coset decoration times the common
gap selection (`centreFormLow`'s weight without `chiX`). -/
def ZwCLow (hL1 : 1 ≤ P.L) (mk : Fama.Stage1Mk.MarkFn P.γ (2 * R)) (roots : Fin (2 * R) → (Fin P.d → ℤ))
    (z : GenDecoration (Fama.stSt P.γ a.prime.skeleton a.totalSigma (mk a.prime)).G P.d roots 0) : ℂ :=
  pieceAtomWLow (pieceGenAtLow P J pat t s kSel σ Rs a (mk a.prime) dag)
      (cosetDecoration (Fama.stSt P.γ a.prime.skeleton a.totalSigma (mk a.prime)).G P.L 0 z.1) *
    (if selSkCMkLow a mk P.L P.γ P.η (lt_of_lt_of_le zero_lt_one hL1).ne' 0 roots z then 1 else 0)

end

