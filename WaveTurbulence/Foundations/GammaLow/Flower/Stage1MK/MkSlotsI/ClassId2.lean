  (dag : Option (Fin (2 * R) → Fin 3 → Mom P.d))

/-- The class constant without the dagger constant: `selOK(a) · selConst(a) · chiDNorm ^ #selR`. -/
def cGenLow (mk : Fama.Stage1Mk.MarkFn γF (2 * R)) : ℂ :=
  (selOK (recLGLow a) J kSel : ℂ) *
    ((∏ j, (selCap (recLGLow a) J kSel j).elim 1 (fun _ => (((Rs j)⁻¹ : ℝ) : ℂ))) *
      (chiDNorm : ℂ) ^ (selRAtLow J kSel a (mk a.prime)).card)

end

