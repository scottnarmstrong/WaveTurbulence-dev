  (honeY : MkSlotsS.OneFlower (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J)
  (kSel : Fin (2 * R) → Option ℕ) (L : ℝ) (σ : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ)

include hy hcapA hcapY hG hrepU hc honeA honeY in
/-- **The stem node weight at the core of a unit top of a member is B3-2's top filter**, unit by unit and at every
argument (CoreW's `top_member` before the product). -/
theorem genNW_top_memberLow
    (hselY : ∀ j, (kSel j).isSome → (selCap (layeredReconstruction y.1.data y.1.plain (stateLayer y.1)
      (stateLayer_isLayering y.1)) J kSel j).isSome)
    (hrepS : ∀ j, a.prime.data.coreBranch a.prime.prime.1
      (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).upper ∉
        selSetCap (recLGLow a) J kSel)
    (j : Fin (Fama.unitBlocks γF a.prime.skeleton a.totalSigma (mk a.prime)).length) (x : ℝ) :
    genNW (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J L σ kSel Rs
        (y.1.data.coreBranch y.1.plain (unitClBlock (y.2 j)).upper).toNode x =
      (MkSlotsT.radProd (SURepLow a mk J (radTGen L σ kSel Rs) j) x : ℂ) := by
  set Φ₁ := Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)
  set hd₁ := Fama.unitBlkMk_disj (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)
  set c := Φ₁.hinge hd₁ j
  have hh : (memShapeLow a mk y hy).hinge (Fama.source_disjMk a mk y hy) j = c :=
    MkSlotsT.hinge_eq_of_hmom Φ₁ (memShapeLow a mk y hy) hd₁ (Fama.source_disjMk a mk y hy)
      (fun j i => congrFun (congrFun (memShape_hmomLow a mk y hy) j) i) j
  have hu₂ : (unitClBlock (y.2 j)).upper = (memShapeLow a mk y hy).br c := by
    rw [← hh, (memShapeLow a mk y hy).br_hinge]
  have hu₁ : (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).upper = Φ₁.br c :=
    (Φ₁.br_hinge hd₁ j).symm
  have hSU : SURepLow a mk J (radTGen L σ kSel Rs) j =
      MkSlotsT.SUStem y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) J
        (fun b => radTGen L σ kSel Rs b.1.1) (blk := fun j => unitClBlock (y.2 j)) j :=
    (SUStem_member_eqLow a mk y hy J hcapA hcapY hG hrepU (radTGen L σ kSel Rs) j).symm
  rw [hSU]
  have hnsY : (y.1.data.coreBranch y.1.plain (unitClBlock (y.2 j)).upper : GBranch (layeredReconstruction y.1.data
      y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)).garden.tree) ∉ selSetCap (layeredReconstruction
        y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J kSel := by
    intro h
    have h' : y.1.data.coreBranch y.1.plain ((memShapeLow a mk y hy).br c) ∈ selSetCap (layeredReconstruction
        y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J kSel := by
      rw [← hu₂]; exact h
    have hA := (coreY_mem_selSetCap_iffLow a mk y hy J hcapA hcapY hG hrepU hc honeA honeY kSel c).1 h'
    apply hrepS j
    have he : coreRecLow a (mk a.prime) c = a.prime.data.coreBranch a.prime.prime.1
        (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).upper := by
      rw [hu₁]; rfl
    rwa [he] at hA
  refine (genNW_top_aux hselY _ hnsY _).trans ?_
  unfold MkSlotsT.SUStem
  exact congrArg (fun rs => ((MkSlotsT.radProd rs _ : ℝ) : ℂ)) (ite_congr rfl (fun _ => rfl) (fun _ => rfl))

end

