/-- **The member's general slot family agrees with B3's frontier-weighted family on the regional slots and the tops.** -/
theorem member_regAgreeLow (pat : Fin (2 * R) → FixPat) (t s : ℝ) (kSel σ : Fin (2 * R) → Option ℕ)
    (Rs : Fin (2 * R) → ℝ) (mkF : Fama.Stage1Mk.MarkFn P.γ (2 * R))
    (hsub : ∀ {LG : LayeredGarden (2 * R)} (B : PrimeData LG), markILow (γF := P.γ) J pat t s kSel B ⊆ mkF B)
    (hset : mk a.prime = classMkLow mkF a) (h : ℕ → Fin (2 * R) → Fin (2 * R) → Mom P.d → ℝ)
    (roots : Fin (2 * R) → (Fin P.d → ℤ)) (Rf : Fin (2 * R) → Option ℝ)
    (dag : Option (Fin (2 * R) → Fin 3 → Mom P.d))
    (hGeoA : CapGeo (recLGLow a) J p) (hGeoY : CapGeo y.1.layered J p)
    (hrepUP : ∀ j, ∀ b ∈ (Fama.unitBlkMk P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).atoms,
      fixCap (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)) J pat t s
        (a.prime.data.coreBranch a.prime.prime.1 b) = none)
    (hstem : ¬ StemDep σ kSel ∨ CleanPtLow J a) (hok : selOK (recLGLow a) J kSel = 1) :
    RegAgree (fun j => unitClBlock (y.2 j)) y.1.plain
      ⟨MkSlotsB.slotFnGWFRL y.1.data y.1.plain P.L P.γ P.δ
          (anchProfiles J (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1))
            h P.L roots)
          (chainW y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) P.L P.γ P.δ p s J Rf dag)
          (genΘs y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) J P.L σ kSel Rs)
          (stateLayer y.1) (stateLayer_isLayering y.1)
          (fixCap (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J pat t s),
        genTw y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) J P.L σ kSel Rs⟩
      (slotFWW y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) P.L P.γ P.δ h p
        (fun j => frontierG (Rf j)) (memberTopWLow y (SURepLow a mk J (radTGen P.L σ kSel Rs)))) := by
  have hspec := stateLayer_spec y.1
  have hGeoR : CapGeo (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J p := by
    rw [hspec]; exact hGeoY
  have hGeoA' : CapGeo (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a))
      J p := hGeoA
  have hcapA : ∀ j ∈ J, (a.prime.data.garden a.prime.prime.1).tree j = TTree.leaf := hGeoA'.cap_leaf
  have hrepU := hrepU_of_patLow a mk J pat t s hrepUP
  have hstem' : StemDep σ kSel → CleanPtLow J a := fun hsd => hstem.resolve_left (not_not.mpr hsd)
  intro j
  refine ⟨fun q hq => ?_, fun v hv => ?_, ?_⟩
  · exact unitSlot_plainLow a mk y hy hG J hGeoA' hGeoR pat t s hrepUP P.L P.γ P.δ σ kSel Rs h roots Rf dag hstem'
      (.inl q) (iota_ne_regPair (memShapeLow a mk y hy) hG j hq)
  · exact unitSlot_plainLow a mk y hy hG J hGeoA' hGeoR pat t s hrepUP P.L P.γ P.δ σ kSel Rs h roots Rf dag hstem'
      (.inr v) (iota_ne_regChain (memShapeLow a mk y hy) hG j hv)
  · show genTw y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) J P.L σ kSel Rs
        (unitClBlock (y.2 j)).upper = memberTopWLow y (SURepLow a mk J (radTGen P.L σ kSel Rs)) (y.2 j).blk.a
    rw [memberTopW_applyLow a mk y hy]
    exact genTw_top_memberLow P a mk y hy hG J pat t s kSel σ Rs mkF hsub hset hcapA hrepU hGeoA hGeoY hstem hok j

