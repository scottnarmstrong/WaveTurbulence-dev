open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable (P : WTParams) [Fact (P.γ ≤ 1 / 2)] {R : ℕ} (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat) (t s : ℝ)
  (kSel σ : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ) (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R))
  (dag : Option (Fin (2 * R) → Fin 3 → Mom P.d))

theorem norm_ZwC_leLow (hL1 : 1 ≤ P.L) (mkF : Fama.Stage1Mk.MarkFn P.γ (2 * R))
    (hsub : ∀ {LG : LayeredGarden (2 * R)} (B : PrimeData LG), markILow (γF := P.γ) J pat t s kSel B ⊆ mkF B)
    (hRs : ∀ j, P.L ≤ Rs j) (mk : Fama.Stage1Mk.MarkFn P.γ (2 * R)) (hset : mk a.prime = classMkLow mkF a)
    (roots : Fin (2 * R) → (Fin P.d → ℤ))
    (z : GenDecoration (Fama.stSt P.γ a.prime.skeleton a.totalSigma (mk a.prime)).G P.d roots 0) :
    ‖ZwCLow P J pat t s kSel σ Rs a dag hL1 mk roots z‖ ≤ 1 := by
  unfold ZwCLow
  rw [norm_mul]
  have h2 : ‖(if selSkCMkLow a mk P.L P.γ P.η (lt_of_lt_of_le zero_lt_one hL1).ne' 0 roots z then (1 : ℂ)
      else 0)‖ ≤ 1 := by split_ifs <;> simp
  calc _ ≤ 1 * 1 := mul_le_mul (norm_pieceAtomWAt_leLow P J pat t s kSel σ Rs a dag mkF hsub hL1 hRs _ hset _) h2
        (norm_nonneg _) zero_le_one
    _ = 1 := one_mul 1

end

