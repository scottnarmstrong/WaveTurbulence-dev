open WaveTurbulence.Reg WaveTurbulence.Reg.Skeleton WaveTurbulence.RegRed WaveTurbulence.LFTwist
open WaveTurbulence.Flower.MkDefs WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden
open WaveTurbulence.RedSplice WaveTurbulence.VineB WaveTurbulence.VineC WaveTurbulence.Flower.MkUnits
open WaveTurbulence.Represents WaveTurbulence.VineEstS4 WaveTurbulence.Flower.Stage1W WaveTurbulence.VineAlign WaveTurbulence.Stage1 WaveTurbulence.Twist WaveTurbulence.Flower.Stage1WVine WaveTurbulence.Flower.Stage1WNoVine
open WaveTurbulence.Flower.Stage1MKGate
open WaveTurbulence.Flower.MkSlots (anchProfiles chainW fixCore recLG sibIndAt flwAt)
open WaveTurbulence.Flower.MkSlots.IntMember (restIndO capConstO ZwG)
open WaveTurbulence.Flower.MkUnitsL (SlotFamW RegBoundW unitKernelMGW slotFWW regBoundFWW memberTopW memberTopW_apply member_ker_eqWMkL norm_topWeightOf_le)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable (P : WTParams) [Fact (P.γ ≤ 1 / 2)]
variable {R p : ℕ} {kind : Bool} (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R)) (mk : Fama.Stage1Mk.MarkFn P.γ (2 * R))
  (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk P.γ a mk))) (hy : y ∈ Fama.sourceClass P.γ a p kind mk)
  (hG : (Fama.stSt P.γ a.prime.skeleton a.totalSigma (mk a.prime)).G.IsPlain) (J : Finset (Fin (2 * R)))

include hG in
/-- **The member weight is the class constant times the `G_sb` weight at the restricted decoration.** -/
theorem member_Zs_eqLow (hL1 : 1 ≤ P.L) (pat : Fin (2 * R) → FixPat) (t s : ℝ)
    (kSel σ : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ) (mkF : Fama.Stage1Mk.MarkFn P.γ (2 * R))
    (hsub : ∀ {LG : LayeredGarden (2 * R)} (B : PrimeData LG), markILow (γF := P.γ) J pat t s kSel B ⊆ mkF B)
    (hRs : ∀ j, P.L ≤ Rs j) (hset : mk a.prime = classMkLow mkF a) (roots : Fin (2 * R) → (Fin P.d → ℤ))
    (dag : Option (Fin (2 * R) → Fin 3 → Mom P.d))
    (hcapA : ∀ j ∈ J, (a.prime.data.garden a.prime.prime.1).tree j = TTree.leaf)
    (hrepU : ∀ j, ∀ b ∈ (Fama.unitBlkMk P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).atoms,
      ¬ IsCapFlowerParent (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a)
        (sourceLayer_isLayeringLow a)) J (a.prime.data.coreBranch a.prime.prime.1 b))
    (hGeoA : CapGeo (recLGLow a) J p) (hGeoY : CapGeo y.1.layered J p) (hstem : ¬ StemDep σ kSel ∨ CleanPtLow J a)
    (κ : GenDecoration y.1.skeleton P.d roots 0) :
    (if selAnd
        (fun κS => selSkCMkLow a mk P.L P.γ P.η (lt_of_lt_of_le zero_lt_one hL1).ne' 0 roots
          ((memShapeLow a mk y hy).resDec y.1.plain (Fama.source_disjMk a mk y hy) κS))
        (restIndO y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) P.L J dag) κ then
      genZa y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) (memShapeLow a mk y hy)
        (Fama.source_disjMk a mk y hy) J P.L σ kSel Rs 0 κ else 0) =
      cGenLow J kSel Rs a mk *
        ZwCLow P J pat t s kSel σ Rs a dag hL1 mk roots
          ((memShapeLow a mk y hy).resDec y.1.plain (Fama.source_disjMk a mk y hy) κ) := by
  set z := (memShapeLow a mk y hy).resDec y.1.plain (Fama.source_disjMk a mk y hy) κ with hz
  have hspec := stateLayer_spec y.1
  have hGeoR : CapGeo (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J p := by
    rw [hspec]; exact hGeoY
  have hcapY : ∀ j ∈ J, (y.1.data.garden y.1.plain).tree j = TTree.leaf := hGeoR.cap_leaf
  -- the indicator
  have h1 : (if selAnd
        (fun κS => selSkCMkLow a mk P.L P.γ P.η (lt_of_lt_of_le zero_lt_one hL1).ne' 0 roots
          ((memShapeLow a mk y hy).resDec y.1.plain (Fama.source_disjMk a mk y hy) κS))
        (restIndO y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) P.L J dag) κ then
      genZa y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) (memShapeLow a mk y hy)
        (Fama.source_disjMk a mk y hy) J P.L σ kSel Rs 0 κ else 0) =
      ((ZwGLow a mk J P.L P.γ P.η (lt_of_lt_of_le zero_lt_one hL1).ne' roots dag z : ℝ) : ℂ) *
        genZa y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) (memShapeLow a mk y hy)
          (Fama.source_disjMk a mk y hy) J P.L σ kSel Rs 0 κ := by
    rw [← member_selAnd_ZwGLow P hL1 a mk hG J roots dag hcapA hrepU y hy hGeoY κ]
    split_ifs <;> simp
  -- the atom weight
  have h2 : genZa y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) (memShapeLow a mk y hy)
      (Fama.source_disjMk a mk y hy) J P.L σ kSel Rs 0 κ =
      (selOK (recLGLow a) J kSel : ℂ) *
        ((∏ j, (selCap (recLGLow a) J kSel j).elim 1 (fun _ => (((Rs j)⁻¹ : ℝ) : ℂ))) *
          zatomGLow J P.L σ kSel Rs a (mk a.prime) z) := by
    rcases hstem with hns | hc
    · obtain ⟨rfl, rfl⟩ := eq_none_of_not_stemDep hns
      unfold genZa
      rw [selOK_stemFree, selOK_stemFree, selConst_stemFree, selConst_stemFree, zatomG_stemFreeLow]
      simp only [Complex.ofReal_one, one_mul]
      exact Finset.prod_eq_one fun c _ => genNW_stemFree _ J P.L Rs _ _
    · unfold genZa
      rw [selOK_memberLow a mk y hy J hcapA hcapY hG hc hGeoA.one_flower hGeoR.one_flower kSel,
        selConst_memberLow a mk y hy J hcapA hcapY hG hc hGeoA.one_flower hGeoR.one_flower kSel Rs,
        zatom_member'Low a mk y hy J hcapA hcapY hG hc hGeoA.one_flower hGeoR.one_flower hrepU P.L σ kSel Rs κ]
  -- the sibling indicator and the atom weight
  have h3 := zatomG_mul_sibIndAtLow P J pat t s kSel σ Rs a dag mkF hsub hL1 hRs (mk a.prime) hset z
  have e : (((if selSkCMkLow a mk P.L P.γ P.η (lt_of_lt_of_le zero_lt_one hL1).ne' 0 roots z then (1 : ℝ) else 0) : ℝ) :
      ℂ) = if selSkCMkLow a mk P.L P.γ P.η (lt_of_lt_of_le zero_lt_one hL1).ne' 0 roots z then (1 : ℂ) else 0 := by
    split_ifs <;> simp
  rw [h1, h2]
  unfold ZwGLow cGenLow ZwCLow
  rw [Complex.ofReal_mul, e]
  calc _ = (selOK (recLGLow a) J kSel : ℂ) *
        ((∏ j, (selCap (recLGLow a) J kSel j).elim 1 (fun _ => (((Rs j)⁻¹ : ℝ) : ℂ))) *
          (zatomGLow J P.L σ kSel Rs a (mk a.prime) z *
            ((sibIndAtLow J a (mk a.prime) dag (flwAtLow J a (mk a.prime))
              (cosetDecoration (Fama.stSt P.γ a.prime.skeleton a.totalSigma (mk a.prime)).G P.L 0 z.1) : ℝ) : ℂ))) *
        (if selSkCMkLow a mk P.L P.γ P.η (lt_of_lt_of_le zero_lt_one hL1).ne' 0 roots z then (1 : ℂ) else 0) := by ring
    _ = _ := by rw [h3]; ring

