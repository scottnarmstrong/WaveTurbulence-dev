      P.L P.γ P.δ (stateLayer y.1) 0 =
    fun (j : Fin (Fama.unitBlocks P.γ a.prime.skeleton a.totalSigma (mk a.prime)).length) (lam : ℤ) (t' : Fin 3 → ℝ)
