variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable (P : WTParams) [Fact (P.γ ≤ 1 / 2)] {R : ℕ} (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat) (t s : ℝ)
  (kSel σ : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ) (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R))
  (dag : Option (Fin (2 * R) → Fin 3 → Mom P.d))

/-- The atom weight of the piece at a marked set equal to the class marking is bounded by `1`. -/
theorem norm_pieceAtomWAt_leLow (mkF : Fama.Stage1Mk.MarkFn P.γ (2 * R))
    (hsub : ∀ {LG : LayeredGarden (2 * R)} (B : PrimeData LG), markILow (γF := P.γ) J pat t s kSel B ⊆ mkF B)
    (hL : 1 ≤ P.L) (hRs : ∀ j, P.L ≤ Rs j) (Mk : Set (Fama.CLVineG P.γ a.prime.skeleton)) (hMk : Mk = classMkLow mkF a)
    (k : GNode (Fama.stSt P.γ a.prime.skeleton a.totalSigma Mk).G.tree → Mom P.d) :
    ‖pieceAtomWLow (pieceGenAtLow P J pat t s kSel σ Rs a Mk dag) k‖ ≤ 1 := by
  subst hMk
  exact MkSlotsS.norm_atomWF_le _ _
    (fun c q hq u => (filtGen_okLow P J pat t s kSel σ Rs mkF a dag hsub hL hRs MkSlotsG.cθGen le_rfl c q
      hq).2.2.1 u)
    (fun k => indGen_memLow J P.L σ kSel mkF a dag k) k

end

