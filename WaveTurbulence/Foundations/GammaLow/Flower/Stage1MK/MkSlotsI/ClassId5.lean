        (ZwCLow P J pat t s kSel σ Rs a dag hL1 mk roots z * chiX P.L 0 X z) *
        ∫ τ, outerIntegrandMD (Fama.stSt P.γ a.prime.skeleton a.totalSigma (mk a.prime)).G P.L P.γ P.δ 0 roots (fun _ => t) (domOfLow (pieceGenAtLow P J pat t s kSel σ Rs a (mk a.prime) dag) (fun _ => t)) hG
        (fun s' => (famX (fam₀Of sd hsd.supp) (famCOfData sd) X).a s' (ξ s')) (fun s' => (famX (fam₀Of sd hsd.supp) (famCOfData sd) X).m s' (ξ s'))
        ((Fama.stShape P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).route a.prime.prime.1 hG) ((Fama.stShape P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).hclk (Fama.unitBlkMk_disj (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime))) ((Fama.stShape P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).hmom (Fama.unitBlkMk_disj (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)))
