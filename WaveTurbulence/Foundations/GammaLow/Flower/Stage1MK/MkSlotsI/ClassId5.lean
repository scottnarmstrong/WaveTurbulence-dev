  have hlbf : (fun c => (MkSlotsB.lbS y.1.data y.1.plain (fixCap (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J pat t s) s) ((memShapeLow a mk y hy).br c)) = lbGenAtLow J pat t s a (mk a.prime) := funext hlbbr
  have hker := member_unitKernelLow P a mk y hy hG J pat t s kSel σ Rs mkF hsub hset h roots Rf dag hGeoA hGeoY hrepUP
    hstem hok hcanY hlay
  have RB := memberRBGLow P a mk y J hL1 hd1 pat t s kSel σ Rs h b hb0 hB roots Rf dag hlay
