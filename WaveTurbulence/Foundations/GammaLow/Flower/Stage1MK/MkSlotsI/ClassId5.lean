  have hsm := summable_outer_decorationsGWD_modesR (memShapeLow a mk y hy) RB (Fama.source_disjMk a mk y hy)
    y.1.data hG hL0 P.γ P.δ (stateLayer y.1) (fun _ => t) (famX (fam₀Of sd hsd.supp) (famCOfData sd) X) ξ
    (fun z => ZwCLow P J pat t s kSel σ Rs a dag hL1 mk roots z * chiX P.L 0 X z)
    (norm_mul_chiX_le_one P.L 0 X _ hZw) (fixCore y.1.data y.1.plain (fixCap (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J pat t s)) (MkSlotsB.lbS y.1.data y.1.plain (fixCap (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J pat t s) s)
  rw [memShape_lay_eqLow a mk y hy, hfix, hlbf, memShape_hingesLow a mk y hy, memShape_routeLow a mk y hy hG,
    memShape_hclkLow a mk y hy, memShape_hmomLow a mk y hy, hker, domOf_pieceGenAtLow P J pat t s kSel σ Rs a (mk a.prime) dag]
