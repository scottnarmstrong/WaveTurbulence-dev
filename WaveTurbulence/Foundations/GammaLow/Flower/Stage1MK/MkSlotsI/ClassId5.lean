  have hbox := member_hboxLow a mk y hy hG J pat t s hrepUP hcapA hcapY hst htt hRP hlbclk
  have hexp₀ := member_hexp₀Low a mk y hy hG J hGeoA' hGeoR pat t s hrepUP kSel σ Rs roots h b Rf dag hstem' sd hsd
