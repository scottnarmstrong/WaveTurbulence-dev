/-- The decoration summability of a member's per-mode outer value. -/
theorem member_hsmLow (X : CentredSlot (Fama.stSt P.γ a.prime.skeleton a.totalSigma (mk a.prime)).G → (Fin P.d → ℤ)) (ξ : ∀ t', (famX (fam₀Of sd hsd.supp) (famCOfData sd) X).Λ t') :
