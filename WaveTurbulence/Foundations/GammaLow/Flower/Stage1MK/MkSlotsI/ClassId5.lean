/-- The integrability of a member's per-mode outer integrand. -/
theorem member_integLow (X : CentredSlot (Fama.stSt P.γ a.prime.skeleton a.totalSigma (mk a.prime)).G → (Fin P.d → ℤ)) (ξ : ∀ t', (famX (fam₀Of sd hsd.supp) (famCOfData sd) X).Λ t') (z : GenDecoration (Fama.stSt P.γ a.prime.skeleton a.totalSigma (mk a.prime)).G P.d roots 0) :
    Integrable (outerIntegrandMD (Fama.stSt P.γ a.prime.skeleton a.totalSigma (mk a.prime)).G P.L P.γ P.δ 0 roots (fun _ => t) (domOfLow (pieceGenAtLow P J pat t s kSel σ Rs a (mk a.prime) dag) (fun _ => t)) hG
        (fun s' => (famX (fam₀Of sd hsd.supp) (famCOfData sd) X).a s' (ξ s')) (fun s' => (famX (fam₀Of sd hsd.supp) (famCOfData sd) X).m s' (ξ s'))
        ((Fama.stShape P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).route a.prime.prime.1 hG) ((Fama.stShape P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).hclk (Fama.unitBlkMk_disj (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime))) ((Fama.stShape P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).hmom (Fama.unitBlkMk_disj (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)))
        (fun j lam t' k => unitRecenteredFWL p
          (frontierG (Rf (Fama.unitBlkMk P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)
            j).upper.1.1))
          (SURepLow a mk J (radTGen P.L σ kSel Rs) j) y.1 (y.2 j) P.L P.γ P.δ
          (unitProfile (Fama.unitBlkMk P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)) h j)
          0 (modW lam) (t' 0) (t' 1) (t' 2) (k 0) (k 1) (k 2) (k 3)) z)
      (fixMeasure (fixAtLow J pat t s a (mk a.prime))) := by
  have hL0 : 0 < P.L := lt_of_lt_of_le zero_lt_one hL1
  have hst : s < t := hs.2
  have htt : t ∈ Set.Icc (p : ℝ) (p + 1) := ⟨(hs.1.trans hs.2).le, ht⟩
  have hspec := stateLayer_spec y.1
  have hGeoR : CapGeo (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J p := by rw [hspec]; exact hGeoY
  have hPatR : CapPatValid (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J pat p := by rw [hspec]; exact hPatY
  have hrootR : ∀ j ∉ J, ∃ ℓ : GLeaf (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)).garden.tree, IsCapFlower (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J ℓ ∧ ℓ.1.1 = j := by
    rw [hspec]; exact hrootY
  have hGeoA' : CapGeo (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a))
      J p := hGeoA
  have hcapA : ∀ j ∈ J, (a.prime.data.garden a.prime.prime.1).tree j = TTree.leaf := hGeoA'.cap_leaf
  have hcapY : ∀ j ∈ J, (y.1.data.garden y.1.plain).tree j = TTree.leaf := hGeoR.cap_leaf
  have hcapS : ∀ j ∈ J, y.1.skeleton.tree j = TTree.leaf := fun j hj =>
    MkSlots.IntAsm.skel_tree_leaf y.1.data y.1.plain (hcapY j hj)
  have hlay : ∀ x, stateLayer y.1 x ≤ p := hGeoR.layer_le
  have hstem' : StemDep σ kSel → CleanPtLow J a := fun hsd' => hstem.resolve_left (not_not.mpr hsd')
  have hRP := relaxPins_fixCap hGeoR hPatR hrootR hs ht
  have hP := relaxPinsS_fixCore y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) J pat hst.le hRP
  have hfix : (fun c => (fixCore y.1.data y.1.plain (fixCap (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J pat t s)) ((memShapeLow a mk y hy).br c)) = fixAtLow J pat t s a (mk a.prime) :=
    funext fun c => member_fixCap_patLow a mk y hy hG J hcapA hcapY pat t s hrepUP c
  have hlbf : (fun c => (MkSlotsB.lbS y.1.data y.1.plain (fixCap (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J pat t s) s) ((memShapeLow a mk y hy).br c)) = lbGenAtLow J pat t s a (mk a.prime) := funext hlbbr
  have hker := member_unitKernelLow P a mk y hy hG J pat t s kSel σ Rs mkF hsub hset h roots Rf dag hGeoA hGeoY hrepUP
    hstem hok hcanY hlay
  have RB := memberRBGLow P a mk y J hL1 hd1 pat t s kSel σ Rs h b hb0 hB roots Rf dag hlay
    (member_regAgreeLow P a mk y hy hG J pat t s kSel σ Rs mkF hsub hset h roots Rf dag hGeoA hGeoY hrepUP hstem hok)
  have hZw : ∀ z, ‖ZwCLow P J pat t s kSel σ Rs a dag hL1 mk roots z‖ ≤ 1 :=
    norm_ZwC_leLow P J pat t s kSel σ Rs a dag hL1 mkF hsub hRs mk hset roots
  have hbox := member_hboxLow a mk y hy hG J pat t s hrepUP hcapA hcapY hst htt hRP hlbclk
  have hexp₀ := member_hexp₀Low a mk y hy hG J hGeoA' hGeoR pat t s hrepUP kSel σ Rs roots h b Rf dag hstem' sd hsd
  have hexpC := member_hexpCLow a mk y hy hG J hGeoA' hGeoR pat t s hrepUP kSel σ Rs roots h b Rf dag hstem' sd hsd
  have hcons := member_hconsLow a mk y hy hG J P.L roots hcapS
  have hU := hU_member_patLow a mk y hy hG J hcapA hcapY pat t s hrepUP
  have hint := integrable_outerIntegrandMDGW_modesR (memShapeLow a mk y hy) RB (Fama.source_disjMk a mk y hy)
    y.1.data hG P.γ P.δ (stateLayer y.1) (fun _ => t) (famX (fam₀Of sd hsd.supp) (famCOfData sd) X) ξ (fixCore y.1.data y.1.plain (fixCap (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J pat t s)) (MkSlotsB.lbS y.1.data y.1.plain (fixCap (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J pat t s) s) (roots := roots) z
  rw [memShape_lay_eqLow a mk y hy, hfix, hlbf, memShape_routeLow a mk y hy hG,
    memShape_hclkLow a mk y hy, memShape_hmomLow a mk y hy, hker, domOf_pieceGenAtLow P J pat t s kSel σ Rs a (mk a.prime) dag]
    at hint
  exact hint

