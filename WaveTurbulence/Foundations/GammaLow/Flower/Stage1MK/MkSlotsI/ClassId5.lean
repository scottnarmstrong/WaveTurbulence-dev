/-- The domain of the general piece at a marked set, written out. -/
theorem domOf_pieceGenAtLow (P : WTParams) [Fact (P.γ ≤ 1 / 2)] {R : ℕ} (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat) (t s : ℝ)
    (kSel σ : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ) (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R))
    (Mk : Set (Fama.CLVineG P.γ a.prime.skeleton)) (dag : Option (Fin (2 * R) → Fin 3 → Mom P.d))
    (tt : Fin (2 * R) → ℝ) :
    splicedTimeDomainFix (Fama.stSt P.γ a.prime.skeleton a.totalSigma Mk).G (a.normalizedPiece 0 Mk).layer tt
        (fixAtLow J pat t s a Mk) ∩ MkSlotsB.lbDomR (lbGenAtLow J pat t s a Mk) =
      domOfLow (pieceGenAtLow P J pat t s kSel σ Rs a Mk dag) tt := rfl

end

