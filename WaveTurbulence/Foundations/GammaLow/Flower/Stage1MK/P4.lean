/-- Every entry of `Fama.VineA.NormalizedSplice.gapSpecificationMk γF` belongs to a group: an unmarked group's designated atom or the upper joint of
a survivor. -/
theorem gapSpecificationMk_isSomeLow {v : GBranch (Fama.stSt γF G σ Mk).G.tree} (h : (Fama.VineA.NormalizedSplice.gapSpecificationMk γF G σ Mk v).isSome) :
    (∃ S ∈ Fama.maximalGroupsG γF G.molecule, Fama.VineA.NormalizedSplice.groupAtom γF G σ S Mk = some v) ∨
      ∃ S t, S ∈ Fama.maximalGroupsG γF G.molecule ∧ Fama.VineA.NormalizedSplice.MarkedEntryAt γF G σ S t v := by
  classical
  by_contra hne
  push Not at hne
  unfold Fama.VineA.NormalizedSplice.gapSpecificationMk at h
  rw [dite_eq_right (fun ⟨S, hS, h1⟩ => hne.1 S hS h1),
    dite_eq_right (fun ⟨St, hS, h1⟩ => hne.2 St.1 St.2 hS h1)] at h
  simp at h

end

