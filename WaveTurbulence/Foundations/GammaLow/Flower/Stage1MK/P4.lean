/-- No atom of a group of a kind other than SG is classified by the splice state. -/
theorem cls_none_of_not_SGLow (hM : G.molecule.IsMolecule) (σ : Prescription G) {Mk : Set (Fama.CLVineG γF G)}
    {S : Finset (GBranch G.tree)} (hS : S ∈ Fama.maximalGroupsG γF G.molecule) (hσ : σ S ≠ Molecule.GapKind.SG)
    {z : GBranch G.tree} (hz : z ∈ S) : (Fama.stSt γF G σ Mk).cls z = none := by
  apply Fama.stSt_cls_noneMk hM σ Mk
  intro u hu hzu
  obtain ⟨S', hS', hσ', hmem⟩ := (Fama.mem_unitBlocksMk (Mk := Mk)).mp hu
  have hsub := Fama.groupUnitsMk_sub hmem hzu
  by_cases hSS : S = S'
  · exact hσ (hSS ▸ hσ')
  · exact Finset.disjoint_left.mp (Fama.VineA.NormalizedSplice.groups_disjoint hM hS hS' hSS) hz hsub

end

