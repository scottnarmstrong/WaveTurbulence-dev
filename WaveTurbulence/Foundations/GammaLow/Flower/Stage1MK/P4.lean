/-- A vine has an out/in pair of darts inside it at its upper joint. -/
theorem exists_survPairSpecLow {T : Finset (GBranch G.tree)} {j l : GBranch G.tree}
    (hT : Src.IsSomeVine γF G.molecule T j l) : ∃ p, SurvPairSpec G T j p := by
  have hX := hT
  let O : Src.Object γF G.molecule := ⟨T, j, l, .vc ⟨(Src.isBlock_of_isSomeVine hX), 1, Src.Chain.single hX⟩⟩
  obtain ⟨x, y, hxy, hx, hy⟩ := Fama.VineA.NormalizedSplice.objectJoint_pair O (Or.inl rfl)
  exact ⟨(x, y), hxy, hx, hy⟩

end

