/-- The group of a survivor. -/
theorem survivorsMk_groupLow {σ : Prescription G} {Mk : Set (Fama.CLVineG γF G)}
    {t : Finset (GBranch G.tree) × GBranch G.tree × GBranch G.tree} (ht : t ∈ Fama.survivorsMk γF G σ Mk) :
    ∃ S, S ∈ Fama.maximalGroupsG γF G.molecule ∧ σ S = Molecule.GapKind.SG ∧ ∃ h : Fama.markedGroup γF G Mk S,
      t ∈ (markedUnitsOfMKLow h).surv ∧ t.1 ⊆ S :=
  by
  obtain ⟨S, hS, hσ, h, htm⟩ := mem_survivorsMk_iffMKLow.mp ht
  obtain ⟨-, hI, -⟩ := (markedUnitsOfMKLow h).surv_spec t htm
  exact ⟨S, hS, hσ, h, htm, isIngredient_subsetLow hI⟩

end

