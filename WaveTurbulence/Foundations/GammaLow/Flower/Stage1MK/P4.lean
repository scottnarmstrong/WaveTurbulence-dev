variable {w : ℕ} {G : Garden w}

/-- `Fama.VineA.NormalizedSplice.survJointAt γF` finds the first survivor with a joint image at `v`. -/
theorem survJointAt_firstLow {σ : Prescription G} {Mk : Set (Fama.CLVineG γF G)} {i : ℕ} (hi : i < (Fama.survivorsMk γF G σ Mk).length)
    {v : GBranch (Fama.stSt γF G σ Mk).G.tree}
    (hv : (Fama.stSt γF G σ Mk).M.pi (Fama.stSt γF G σ Mk).hcls (Fama.survivorsMk γF G σ Mk)[i].2.1 = v ∨
      (Fama.stSt γF G σ Mk).M.pi (Fama.stSt γF G σ Mk).hcls (Fama.survivorsMk γF G σ Mk)[i].2.2 = v)
    (hfirst : ∀ j (hj : j < i), ¬ ((Fama.stSt γF G σ Mk).M.pi (Fama.stSt γF G σ Mk).hcls (Fama.survivorsMk γF G σ Mk)[j].2.1 = v ∨
      (Fama.stSt γF G σ Mk).M.pi (Fama.stSt γF G σ Mk).hcls (Fama.survivorsMk γF G σ Mk)[j].2.2 = v)) :
    ∃ j, Fama.VineA.NormalizedSplice.survJointAt γF G σ v = some ((Fama.survivorsMk γF G σ Mk)[i].1, j) ∧
      (j = (Fama.survivorsMk γF G σ Mk)[i].2.1 ∨ j = (Fama.survivorsMk γF G σ Mk)[i].2.2) ∧
      (Fama.stSt γF G σ Mk).M.pi (Fama.stSt γF G σ Mk).hcls j = v := by
  classical
  have key : ∀ p : Finset (GBranch G.tree) × GBranch G.tree × GBranch G.tree → Bool,
      (∀ t, p t = true ↔ ((Fama.stSt γF G σ Mk).M.pi (Fama.stSt γF G σ Mk).hcls t.2.2 = v ∨
        (Fama.stSt γF G σ Mk).M.pi (Fama.stSt γF G σ Mk).hcls t.2.1 = v)) →
      (Fama.survivorsMk γF G σ Mk).find? p = some (Fama.survivorsMk γF G σ Mk)[i] := by
    intro p hp
    rw [List.find?_eq_some_iff_getElem]
    refine ⟨(hp _).mpr hv.symm, i, hi, rfl, fun j hj => ?_⟩
    have := hfirst j (by omega)
    rw [Bool.not_eq_true']
    by_contra hc
    exact this ((hp _).mp (Bool.not_eq_false _ ▸ hc)).symm
  unfold Fama.VineA.NormalizedSplice.survJointAt
  rw [key _ (fun t => by simp)]
  by_cases h2 : (Fama.stSt γF G σ Mk).M.pi (Fama.stSt γF G σ Mk).hcls (Fama.survivorsMk γF G σ Mk)[i].2.2 = v
  · exact ⟨_, by simp [h2], Or.inr rfl, h2⟩
  · exact ⟨_, by simp [h2], Or.inl rfl, hv.resolve_right h2⟩

end

