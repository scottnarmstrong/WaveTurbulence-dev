theorem od_mem_tripleDartsMkLow (σ : Prescription G) {Mk : Set (Fama.CLVineG γF G)} {v c : GBranch (Fama.stSt γF G σ Mk).G.tree}
    {x : GardenDart (Fama.stSt γF G σ Mk).G} (h : (Fama.stSt γF G σ Mk).M.od x ∈ tripleDartsMkLow G σ Mk v c) :
    (Fama.stSt γF G σ Mk).G.molecule.atom x = v ∧ (Fama.stSt γF G σ Mk).G.molecule.atom ((Fama.stSt γF G σ Mk).G.molecule.mate x) = c := by
  unfold tripleDartsMkLow at h
  obtain ⟨y, hy, hyx⟩ := Finset.mem_image.mp h
  have := (Fama.stSt γF G σ Mk).M.od_inj hyx
  subst this
  rw [Finset.mem_filter, Mole.mem_dartsAt] at hy
  exact hy

