open WaveTurbulence.Induct
open WaveTurbulence.Subpro WaveTurbulence.VineA.NormalizedSplice
open WaveTurbulence WaveTurbulence.LGSpine WaveTurbulence.LGSpine.SourceVine Finset WaveTurbulence.RedSplice WaveTurbulence.Stage1 WaveTurbulence.Mole
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {R : ℕ} {G : Garden (2 * R)}

/-- `ContainsDart` is closed under `mate`. -/
theorem containsDart_mateMkLow {w : ℕ} {G' : Garden w} (O : Src.Object γF G'.molecule) {z : GardenDart G'}
    (h : O.ContainsDart z) : O.ContainsDart (G'.molecule.mate z) := by
  unfold Src.Object.ContainsDart at h ⊢
  rcases hs : O.shape with c | R
  · rw [hs] at h
    exact ⟨by simpa [G'.molecule.mate_mate] using h.2, by simpa [G'.molecule.mate_mate] using h.1⟩
  · rw [hs] at h
    obtain ⟨a1, a2, a3⟩ := h
    refine ⟨fun e => a2 (by rw [← G'.molecule.mate_mate z, e]), fun e => a1 (by
      have := congrArg G'.molecule.mate e
      rwa [G'.molecule.mate_mate, G'.molecule.mate_mate] at this),
      ⟨by simpa [G'.molecule.mate_mate] using a3.2, by simpa [G'.molecule.mate_mate] using a3.1⟩⟩

end

section
open WaveTurbulence.VineA
open WaveTurbulence.VineA.NormalizedSplice
open WaveTurbulence.VineA.NormalizedSplice.Subpro
open WaveTurbulence.Induct
open WaveTurbulence.Subpro WaveTurbulence.VineA.NormalizedSplice
open WaveTurbulence WaveTurbulence.LGSpine WaveTurbulence.LGSpine.SourceVine Finset WaveTurbulence.RedSplice WaveTurbulence.Stage1
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]

/-- The exceptional joints `B` of a family of survivor Fama.VineA.NormalizedSplice.objects γF (the world's `SurvivorData.joints`). -/
noncomputable def survJointsOfLow {w : ℕ} {G : Garden w} {m : ℕ} (surv : Fin m → Src.Object γF G.molecule) :
    Finset (GBranch G.tree) :=
  Finset.univ.biUnion fun i => {(surv i).upper, (surv i).lower}

end

section
open WaveTurbulence.VineA
open WaveTurbulence.VineA.NormalizedSplice
open WaveTurbulence.VineA.NormalizedSplice.Subpro
open WaveTurbulence.Induct
open WaveTurbulence.Subpro WaveTurbulence.VineA.NormalizedSplice
open WaveTurbulence WaveTurbulence.LGSpine WaveTurbulence.LGSpine.SourceVine Finset WaveTurbulence.RedSplice WaveTurbulence.Stage1
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]

theorem mem_survJointsOfLow {w : ℕ} {G : Garden w} {m : ℕ} {surv : Fin m → Src.Object γF G.molecule}
    {v : GBranch G.tree} : v ∈ survJointsOfLow surv ↔ ∃ i, v = (surv i).upper ∨ v = (surv i).lower := by
  simp [survJointsOfLow]

end

section
open WaveTurbulence.VineA
open WaveTurbulence.VineA.NormalizedSplice
open WaveTurbulence.VineA.NormalizedSplice.Subpro
open WaveTurbulence.Induct
open WaveTurbulence.Subpro WaveTurbulence.VineA.NormalizedSplice
open WaveTurbulence WaveTurbulence.LGSpine WaveTurbulence.LGSpine.SourceVine Finset WaveTurbulence.RedSplice WaveTurbulence.Stage1
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {R : ℕ} {G : Garden (2 * R)}

/-- Disjointness from the survivors gives disjointness from their joints. -/
theorem disjoint_survJointsOfLow {w : ℕ} {G' : Garden w} {m : ℕ} {surv : Fin m → Src.Object γF G'.molecule}
    {X : Finset (GBranch G'.tree)} (h : ∀ i, Disjoint X (surv i).atoms) : Disjoint X (survJointsOfLow surv) := by
  rw [Finset.disjoint_left]
  intro v hvX hv
  obtain ⟨i, hi⟩ := mem_survJointsOfLow.mp hv
  rcases hi with rfl | rfl
  · exact Finset.disjoint_left.mp (h i) hvX (Fama.VineA.NormalizedSplice.Object.upper_mem _)
  · exact Finset.disjoint_left.mp (h i) hvX (Fama.VineA.NormalizedSplice.Object.lower_mem _)

end

end WaveTurbulence.GammaLow.Flower
