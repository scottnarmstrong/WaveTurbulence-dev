/-- Main's `KData` at every marking. -/
def KDataMkLow (σ : Prescription G) {Mk : Set (Fama.CLVineG γF G)} (P : Src.Object γF (Fama.stSt γF G σ Mk).G.molecule)
    (jf : GBranch (Fama.stSt γF G σ Mk).G.tree → GBranch G.tree) : Prop :=
  ∀ w ∈ P.atoms, w ∈ (Fama.stSt γF G σ Mk).hinges → (w = P.upper ∨ w = P.lower) ∧
    ∃ u ∈ Fama.unitBlocks γF G σ Mk, (Fama.stSt γF G σ Mk).M.ob w = u.upper ∧ (jf w = u.upper ∨ jf w = u.lower) ∧
      ∀ x, (Fama.stSt γF G σ Mk).G.molecule.atom x = w → P.ContainsDart x → G.molecule.atom ((Fama.stSt γF G σ Mk).M.od x) = jf w

end

