  rw [← (Fama.stSt γF G σ Mk).M.ob_pi (Fama.stSt γF G σ Mk).hcls a, ← (Fama.stSt γF G σ Mk).M.ob_pi (Fama.stSt γF G σ Mk).hcls a', h]

