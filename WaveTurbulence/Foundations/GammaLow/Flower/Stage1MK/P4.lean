/-- A lifted bond of `G_sb` is not a bond inside a unit (units are collapsed). -/
theorem od_not_internalLow (hM : G.molecule.IsMolecule) (σ : Prescription G) {Mk : Set (Fama.CLVineG γF G)} {u : CLBlock G}
    (hu : u ∈ Fama.unitBlocks γF G σ Mk) (x : GardenDart (Fama.stSt γF G σ Mk).G) :
    ¬ G.molecule.InGroup u.atoms ((Fama.stSt γF G σ Mk).M.od x) := by
