theorem objOf_not_markedLow {σ : Prescription G} {S : Finset (GBranch G.tree)} {Mk : Set (Fama.CLVineG γF G)}
    {O : Src.Object γF (Fama.stSt γF G σ Mk).G.molecule} (h : O ∈ Fama.VineA.NormalizedSplice.objOf γF G σ S Mk) : ¬ Fama.markedGroup γF G Mk S := by
