theorem repC_eq_of_pi_eqLow {a a' : GBranch G.tree}
    (h : (Fama.stSt γF G σ Mk).M.pi (Fama.stSt γF G σ Mk).hcls a = (Fama.stSt γF G σ Mk).M.pi (Fama.stSt γF G σ Mk).hcls a') :
