/-- The original darts underlying the bonds of `G_sb` from `v` to `c`, seen at `v`. -/
@[expose] noncomputable def tripleDartsMkLow (G : Garden w) (σ : Prescription G) (Mk : Set (Fama.CLVineG γF G))
    (v c : GBranch (Fama.stSt γF G σ Mk).G.tree) :
    Finset (GardenDart G) :=
