/-- The first survivor of a marked group. -/
theorem groupSurvMk_headLow {Mk : Set (Fama.CLVineG γF G)} {S : Finset (GBranch G.tree)} (hmk : Fama.markedGroup γF G Mk S) :
    ∃ t, (Fama.groupSurvMk γF G Mk S).head? = some t ∧ t ∈ (markedUnitsOfMKLow hmk).surv := by
  have hg : Fama.groupSurvMk γF G Mk S = (markedUnitsOfMKLow hmk).surv :=
    Fama.groupSurvMk_of_marked hmk (Fama.exists_markedGroupUnits hmk)
  obtain ⟨c, hcMk, hcV, hcI⟩ := hmk
  obtain ⟨t, ht, -⟩ := (markedUnitsOfMKLow ⟨c, hcMk, hcV, hcI⟩).surv_cover c hcMk hcV hcI
  rw [hg]
  cases hs : (markedUnitsOfMKLow ⟨c, hcMk, hcV, hcI⟩).surv with
  | nil => rw [hs] at ht; cases ht
  | cons t0 l => exact ⟨t0, rfl, List.mem_cons_self⟩

end

