/-- An ingredient of a group lies in the group. -/
theorem isIngredient_subsetLow {S T : Finset (GBranch G.tree)} (h : Fama.IsIngredientG γF G.molecule S T) : T ⊆ S := by
  rcases h with ⟨_, _, _, _, _, _, hCI⟩ | ⟨_, _, _, _, _, _, _, _, _, hCI⟩
  · exact (Fama.chainIngredientG_spec hCI).2.2
  · exact (Fama.chainIngredientG_spec hCI).2.2

end

