variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {V D : Type} [DecidableEq V] [Fintype D] [DecidableEq D]

/-- An ingredient of a chain of at least two vines does not contain both outer joints of the chain. -/
theorem chainIngredient_not_bothLow {M : Molecule V D} {U A : Finset V} {a b x y : V} {n : ℕ}
    (h : Fama.ChainIngredientG γF M U a b n A x y) (hn : 2 ≤ n) : ¬ (a ∈ A ∧ b ∈ A) := by
  revert hn
  induction h with
  | single _ => intro hn; omega
  | append_left hI hT hST _ _ =>
    intro _ hab
    have hX := hT
    have hcS := (Fama.chainIngredientG_spec hI).2.2 hab.2
    have hcST : _ ∈ _ ∩ _ := Finset.mem_inter.mpr ⟨hcS, (Src.isBlock_of_isSomeVine hX).2.2.1⟩
    rw [hST, Finset.mem_singleton] at hcST
    exact (Src.isBlock_of_isSomeVine hX).2.2.2.1 hcST.symm
  | append_last hC hT hST _ =>
    intro _ hab
    have haS := (Fama.chain_joints_mem hC).1
    have haST : _ ∈ _ ∩ _ := Finset.mem_inter.mpr ⟨haS, hab.1⟩
    rw [hST, Finset.mem_singleton] at haST
    exact Fama.chain_joints_ne hC haST

end

