  have := ((Fama.stSt γF G σ Mk).M.od_range ((Fama.stSt γF G σ Mk).M.od x)).mp ⟨x, rfl⟩
  exact this ⟨u.upper, Fama.stSt_cls_memMk (Mk := Mk) hM σ hu hin.1, Fama.stSt_cls_memMk (Mk := Mk) hM σ hu hin.2⟩

