open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkMarkX
open scoped Classical
open WaveTurbulence WaveTurbulence.Flower.MkDefs WaveTurbulence.Flower.MkMark WaveTurbulence.Reg WaveTurbulence.Reg.Skeleton WaveTurbulence.Twist WaveTurbulence.LFTwist WaveTurbulence.Stage1
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}
variable {S : Garden w} (hS : S.IsPlain) (Z : Fama.TwistGroupSite γF S) (D : ReconstructionData S)
  (X : RegChain) (Q : RegCpl) (hX : X.wf = true) (hQ : Q.wf = true)

/-- The active node sets of a `𝒱` vine and of its image correspond under the step's node map, off the replaced
nodes. -/
theorem activeNodes_stepLow (hsame : (S.pair Z.P.retained).1.1 = Z.P.lower.1.1) (ε : Bool) (c : Fama.CLVineG γF S)
    (hc : c ∈ Fama.vinesVG γF S) (c' : Fama.CLVineG γF (chosenSkeleton S Z.P ε))
    (hc' : c'.atoms = (VineA.chosenMolIso S Z.P ε).img c.atoms) (o : GNode S.tree) (ho : o ∉ replacedNodes Z.P) :
    (lfCoord hS Z.P D X Q hX hQ hsame ε).ν o ∈ activeNodes (chosenSkeleton S Z.P ε) c'.atoms c'.upper ↔
      o ∈ activeNodes S c.atoms c.upper := by
  cases ε with
  | false =>
    have hcc : c' = c := by
      apply Fama.VineA.clVine_eq_of_atoms
      rw [hc']
      exact Finset.image_id
    subst hcc
    exact Iff.rfl
  | true =>
    obtain ⟨c'', -, hc''a, hc''u, -⟩ := Z.vinesV_image hc
    have e : c'' = c' := Fama.VineA.clVine_eq_of_atoms (hc''a.trans hc'.symm)
    subst e
    show naiveNodeEquiv S Z.P o ∈ RegRed.clRealizationNodes (unitTwistGarden S Z.P) c''.atoms ∧
        naiveNodeEquiv S Z.P o ≠ c''.upper.toNode ↔ o ∈ RegRed.clRealizationNodes S c.atoms ∧ o ≠ c.upper.toNode
    have hu : c''.upper.toNode = naiveNodeEquiv S Z.P c.upper.toNode := by
      rw [hc''u]
      exact (naiveNodeEquiv_branch S Z.P c.upper).symm
    rw [hc''a, hu]
    exact and_congr (twist_real_iff Z.P c.atoms o ho) (not_congr (naiveNodeEquiv S Z.P).injective.eq_iff)

end

