open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}

theorem transported_transLow {S S' S'' : Garden w} (F : MolIso S.molecule S'.molecule)
    (G : MolIso S'.molecule S''.molecule) {M : Set (Fama.CLVineG γF S)} {M' : Set (Fama.CLVineG γF S')} {M'' : Set (Fama.CLVineG γF S'')}
    (hM : M ⊆ Fama.vinesVG γF S) (hM'' : M'' ⊆ Fama.vinesVG γF S'') (hF : Fama.Stage1Mk.MarkTransported γF F M M') (hG : Fama.Stage1Mk.MarkTransported γF G M' M'')
    (himF : ∀ c ∈ Fama.vinesVG γF S, ∃ c' ∈ Fama.vinesVG γF S', c'.atoms = F.img c.atoms)
    (hpreG : ∀ c'' ∈ Fama.vinesVG γF S'', ∃ c' ∈ Fama.vinesVG γF S', G.img c'.atoms = c''.atoms) :
    Fama.Stage1Mk.MarkTransported γF (VineA.molIsoTrans F G) M M'' := by
  intro c c'' hc''
  rw [img_trans] at hc''
  constructor
  · intro hc
    obtain ⟨c', -, hc'⟩ := himF c (hM hc)
    exact (hG c' c'' (by rw [hc'', hc'])).mp ((hF c c' hc').mp hc)
  · intro hc2
    obtain ⟨c', -, hc'⟩ := hpreG c'' (hM'' hc2)
    have ha : c'.atoms = F.img c.atoms := G.img_injective (hc'.trans hc'')
    exact (hF c c' ha).mpr ((hG c' c'' hc'.symm).mpr hc2)

end

