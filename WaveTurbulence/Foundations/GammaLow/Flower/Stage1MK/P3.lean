theorem spine_length_posLow {L : List (Finset V × V × V)} {U : Finset V} {a c : V}
    (h : Fama.Spine γF M L U a c) : 0 < L.length := by
  cases h with
  | one _ => simp
  | snoc _ _ _ _ => simp

