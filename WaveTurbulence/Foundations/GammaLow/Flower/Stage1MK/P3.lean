theorem vines_choiceLow {S : Garden w} (Z : Fama.TwistGroupSite γF S) (ε : Bool) :
    (∀ c ∈ Fama.vinesVG γF S, ∃ c' ∈ Fama.vinesVG γF (chosenSkeleton S Z.P ε), c'.atoms = (VineA.chosenMolIso S Z.P ε).img c.atoms) ∧
    (∀ c' ∈ Fama.vinesVG γF (chosenSkeleton S Z.P ε), ∃ c ∈ Fama.vinesVG γF S, (VineA.chosenMolIso S Z.P ε).img c.atoms = c'.atoms) := by
  cases ε with
  | false => exact ⟨fun c hc => ⟨c, hc, Finset.image_id.symm⟩, fun c' hc' => ⟨c', hc', Finset.image_id⟩⟩
  | true =>
    refine ⟨fun c hc => ?_, fun c' hc' => ?_⟩
    · obtain ⟨c', h1, h2, -⟩ := Z.vinesV_image hc
      exact ⟨c', h1, h2⟩
    · obtain ⟨c, h1, h2, -⟩ := Z.vinesV_preimage hc'
      exact ⟨c, h1, h2⟩

end

