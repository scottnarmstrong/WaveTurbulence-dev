variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {V D : Type} [DecidableEq V] [Fintype D] [DecidableEq D] {M : Molecule V D}

/-- An ingredient of a chain of at least two vines does not contain both end joints. -/
theorem ingredient_not_bothLow {U A : Finset V} {a b x y : V} {n : ℕ}
    (h : Fama.ChainIngredientG γF M U a b n A x y) (hn : 2 ≤ n) : ¬ (a ∈ A ∧ b ∈ A) := by
  cases h with
  | single _ => omega
  | append_left h' hT hi hne =>
    obtain ⟨L, hL, hm⟩ := Fama.Spine.mem_of_ingredient h'
    have h1 := spine_length_posLow hL
    exact Fama.Spine.not_both (Fama.Spine.snoc hL hT hi hne)
      (by rw [List.length_append, List.length_singleton]; omega) (List.mem_append_left _ hm)
  | append_last hS hT hi hne =>
    obtain ⟨L, hL⟩ := Fama.Spine.of_chain hS
    have h1 := spine_length_posLow hL
    exact Fama.Spine.not_both (Fama.Spine.snoc hL hT hi hne)
      (by rw [List.length_append, List.length_singleton]; omega)
      (List.mem_append_right _ (List.mem_singleton_self _))

end

