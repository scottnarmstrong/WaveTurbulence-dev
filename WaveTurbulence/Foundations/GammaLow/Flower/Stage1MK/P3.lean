variable {V D : Type} [DecidableEq V] [Fintype D] [DecidableEq D] {M : Molecule V D}

/-- **(D).** An ingredient certificate makes its group a VC (case 1) or an HVC (case 2). -/
theorem isIngredient_vc_or_hvcLow {S T : Finset V} (h : Fama.IsIngredientG γF M S T) :
    (∃ a b, Src.IsVC γF M S a b) ∨ (∃ a b, Src.IsHVC γF M S a b) := by
  rcases h with ⟨a, b, n, x, y, hB, hI⟩ | ⟨a, b, e, n, x, y, he, hn, hB, hI⟩
  · exact Or.inl ⟨a, b, hB, n, Fama.VineA.NormalizedSplice.chain_ofVine (Fama.chainIngredientG_spec hI).1⟩
  · exact Or.inr ⟨a, b, e, he, hB, n, hn, Fama.VineA.NormalizedSplice.chain_ofVine (Fama.chainIngredientG_spec hI).1⟩

end

