variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}

/-- The marked vines of `𝒱` for a skeleton `S` with tree data `X` and a protected set `Pi` of the inflated garden. -/
def markedVinesRawLow (S : Garden w) (X : GBranch S.tree → RegChain) {T : Fin w → TTree}
    (Pi : Finset (GNode T)) : Set (Fama.CLVineG γF S) :=
  {c | c ∈ Fama.vinesVG γF S ∧ ∃ b ∈ c.atoms, b ≠ c.upper ∧ ∃ a ∈ Pi, a.1 ∈ nearRegion S X b}

end

