open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkMarkX
open scoped Classical
open WaveTurbulence WaveTurbulence.Flower.MkDefs WaveTurbulence.Flower.MkMark WaveTurbulence.Reg WaveTurbulence.Reg.Skeleton WaveTurbulence.Twist WaveTurbulence.LFTwist WaveTurbulence.Stage1
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}

/-- A stem-clean member avoids its replaced region (the step in B2b's `markInvariantBatchV_markI`). -/
theorem stemFam_of_cleanLow (J : Finset (Fin w)) {ι : Type} (A : FamilyReconstruction w ι)
    (hA : Reg.Skeleton.IsPrimeGarden A.skeleton)
    (h : ∀ i, ∃ c ∈ Fama.vinesVG γF A.skeleton, c.atoms = A.family.atoms i ∧
      StemCleanAt J (⟨A.skeleton, hA, A.data, A.decodes⟩ : VineA.PrimeData A.layered) c.atoms c.upper) :
    StemFam J A := by
  intro i
  obtain ⟨c, -, he, hcl⟩ := h i
  have h0 := (stemCleanAt_iff J _ _ _).mp hcl
  have hne : (A.family.placement i).lower ≠ c.upper := by
    intro heq
    obtain ⟨h1, h2⟩ := (A.family.core i).2.1.2
    apply c.notParentUpper
    refine ⟨heq ▸ h1, ?_⟩
    rw [he]
    have e : GNode.parent c.upper.toNode (heq ▸ h1) = GNode.parent (A.family.placement i).lower.toNode h1 := by
      congr 1
      rw [heq]
    rw [e]
    exact h2
  have hsub := replaced_sub_activeSet' (A.family.placement i) A.data.tree (A.family.core i).1.1
    (A.family.designated i) hne
  rw [← he] at hsub
  exact stemAvoid_mono hsub h0

end

