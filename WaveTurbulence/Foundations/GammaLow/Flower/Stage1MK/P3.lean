open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkMark
open scoped Classical
open WaveTurbulence WaveTurbulence.Flower.MkDefs WaveTurbulence.Reg.Skeleton WaveTurbulence.Stage1
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}

/-- **A skeleton branch is a non-upper atom of at most one vine of `𝒱`.** Two vines of `𝒱` are atom-disjoint
or share exactly one atom, which is the upper joint of one of them (o75 §4.1, T1433, T1936). -/
theorem vinesV_eq_of_nonupperLow {G : Garden w} {c c' : Fama.CLVineG γF G} (hc : c ∈ Fama.vinesVG γF G) (hc' : c' ∈ Fama.vinesVG γF G)
    {b : GBranch G.tree} (hb : b ∈ c.atoms) (hbu : b ≠ c.upper) (hb' : b ∈ c'.atoms) (hbu' : b ≠ c'.upper) :
    c = c' := by
  by_contra hne
  have hsep := Fama.VineA.vinesV_separated hc hc' hne
  obtain ⟨S, hS, hi, _⟩ := hc
  obtain ⟨T, hT, hi', _⟩ := hc'
  by_cases he : S = T
  · subst T
    have hat : c.atoms ≠ c'.atoms := fun h => hne (Fama.VineA.clVine_eq_of_atoms h)
    have hdeg := (Fama.ing_pair (Mole.garden_isMolecule G) hi hi' hat).2 b (Finset.mem_inter.mpr ⟨hb, hb'⟩)
    have hX := c.isVine
    have hX' := c'.isVine
    have hl : b = c.lower :=
      (Vine.block_degree_two_joint G.molecule (Src.isBlock_of_isSomeVine hX) hb hdeg.1).resolve_left hbu
    have hl' : b = c'.lower :=
      (Vine.block_degree_two_joint G.molecule (Src.isBlock_of_isSomeVine hX') hb' hdeg.2).resolve_left hbu'
    obtain ⟨hn, hp⟩ := c.parentLower
    obtain ⟨hn', hp'⟩ := c'.parentLower
    have hn0 : b.1.2 ≠ [] := hl ▸ hn
    have hpar : GNode.parent b.toNode hn0 ∈ c.atoms := by
      have e : ∀ (x : GBranch G.tree) (hx : x = c.lower) (hxn : x.1.2 ≠ []), GNode.parent x.toNode hxn ∈ c.atoms := by
        intro x hx hxn
        subst hx
        exact hp
      exact e b hl hn0
    have hpar' : GNode.parent b.toNode hn0 ∈ c'.atoms := by
      have e : ∀ (x : GBranch G.tree) (hx : x = c'.lower) (hxn : x.1.2 ≠ []), GNode.parent x.toNode hxn ∈ c'.atoms := by
        intro x hx hxn
        subst hx
        exact hp'
      exact e b hl' hn0
    exact Twist.branch_ne_parent G b hn0 (hsep b hb hb' _ hpar hpar')
  · exact Finset.disjoint_left.mp (Fama.maximalGroups_disjoint (Mole.garden_isMolecule G) hS hT he)
      (Fama.ing_subset hi hb) (Fama.ing_subset hi' hb')

end

