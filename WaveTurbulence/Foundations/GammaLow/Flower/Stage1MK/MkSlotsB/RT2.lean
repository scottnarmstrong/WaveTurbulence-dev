    have hm : (inflatedPosition a.prime.skeleton a.prime.data.tree (q'.firstLeaf a.prime.prime.1).toNode).2 ∈
        ((recLGLow a).garden.tree (inflatedPosition a.prime.skeleton a.prime.data.tree
          (q'.firstLeaf a.prime.prime.1).toNode).1).nodes :=
      (attachedNode a.prime.data a.prime.prime.1 (q'.firstLeaf a.prime.prime.1).toNode).2
    simp only [hm, ↓reduceDIte]
    exact parentLayer_inflated a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) p _ _ rfl
  · unfold Links.parAt
    have hm : (inflatedPosition a.prime.skeleton a.prime.data.tree (q'.secondLeaf a.prime.prime.1).toNode).2 ∈
        ((recLGLow a).garden.tree (inflatedPosition a.prime.skeleton a.prime.data.tree
          (q'.secondLeaf a.prime.prime.1).toNode).1).nodes :=
      (attachedNode a.prime.data a.prime.prime.1 (q'.secondLeaf a.prime.prime.1).toNode).2
    simp only [hm, ↓reduceDIte]
    exact parentLayer_inflated a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) p _ _ rfl
  · intro z
    show (recLGLow a).layer ((nativeCoupleForest a.prime.data a.prime.prime.1 q').nodeEmbedding z) = _
    have e := (Links.layerAt_node (recLGLow a) ((nativeCoupleForest a.prime.data a.prime.prime.1 q').nodeEmbedding z)).symm
    refine e.trans (congrArg (Links.layerAt (recLGLow a)) ?_)
    obtain ⟨⟨j, r⟩, hz⟩ := z
    fin_cases j <;> rfl


