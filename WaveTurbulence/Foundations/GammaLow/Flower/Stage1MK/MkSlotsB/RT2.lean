      (cbrLow a q' ⟨(j, []), hb⟩).toNode := Subtype.ext rfl
  rw [he]
  obtain ⟨v, hv⟩ := Option.isSome_iff_exists.mp hpin
  exact fixCap_layer hR.geo hR.patv hR.root hv

