variable {R p : ℕ} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat)
  (t s : ℝ) (hR : RTRecLow (p := p) a J pat) (q' : SourcePair a.prime.skeleton)
  (hnc : ¬ IsCapPair a.prime.skeleton a.prime.prime.1 J q')

include hR hnc in
/-- A pinned native couple branch is a root, pinned at `s`. -/
theorem rcp_pinned_rootLow (q : GBranch (decodedCouple (a.prime.data.couple q')).tree)
    (hq : (fixCap (recLGLow a) J pat t s (cbrLow a q' q)).isSome) :
    q.1.2 = [] ∧ fixCap (recLGLow a) J pat t s (cbrLow a q' q) = some s := by
  have he := pinned_below_eq (rcp_noFlowerLow a J q' hnc q.1.1) (root_isDesc_emb _ _ q' q) hq
  have h0 : q.1.2 = [] := by
    have h := congrArg (fun z : GNode (a.prime.data.forest a.prime.prime.1) => z.1.2) he
    change ((nativeCoupleForest a.prime.data a.prime.prime.1 q').root q.1.1).1.2 ++ q.1.2 =
      ((nativeCoupleForest a.prime.data a.prime.prime.1 q').root q.1.1).1.2 at h
    exact List.append_right_eq_self.mp h
  refine ⟨h0, ?_⟩
  obtain ⟨v, hv⟩ := Option.isSome_iff_exists.mp hq
  rcases fixCap_value hv with h | ⟨-, hr, -⟩
  · rw [hv, h]
  · exfalso
    apply rcp_nonrootLow a J pat hR q' hnc q.1.1
    have h := congrArg (fun z : GNode (a.prime.data.forest a.prime.prime.1) => z.1.2) he
    change (cbrLow a q' q).1.2 = _ at h
    rw [← h]; exact hr


end

