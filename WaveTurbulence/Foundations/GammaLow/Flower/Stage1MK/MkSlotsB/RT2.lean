  have hroot := rcp_root_eqLow a q' j
  rw [← hTn] at hroot
  obtain ⟨β, hβ, hcβ⟩ := clock_of_parent a.prime.data a.prime.prime.1 _ c
    ⟨by rw [← hroot]; exact h1, k, by rw [← hroot]; exact h2⟩
  refine ⟨β, by rw [rcp_argSrcLow]; exact hβ, hcβ ▸ hc⟩


end

