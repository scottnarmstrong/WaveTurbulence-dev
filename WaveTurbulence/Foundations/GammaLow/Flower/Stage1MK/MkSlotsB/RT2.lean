theorem rcp_root_pinnedLow : ∀ j, rtRootsLow a J pat t s q' j →
    ([] : Path) ∈ ((nativeCoupleLayered a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a) q').garden.tree j).branching ∧
    (nativeCoupleLayered a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) q').layer
