open WaveTurbulence.Flower.Stage1WNoVine WaveTurbulence.Flower.Stage1W
open WaveTurbulence.Flower.MkSlots WaveTurbulence.Flower.MkSlots.IntRest
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {R p : ℕ} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat)
  (t s : ℝ) (hR : RTRecLow (p := p) a J pat) (q' : SourcePair a.prime.skeleton)
  (hnc : ¬ IsCapPair a.prime.skeleton a.prime.prime.1 J q')

include hR hnc in
theorem rcp_pinsLow : ∀ q : GBranch (nativeCoupleLayered a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a) q').garden.tree,
    MkSlots.fixNative a.prime.data a.prime.prime.1 (fixCap (recLGLow a) J pat t s) (.inl q') q =
      MkSlotsO.rootPins (rtRootsLow a J pat t s q') s q := by
  intro q
  show fixCap (recLGLow a) J pat t s (cbrLow a q' q) = _
  unfold MkSlotsO.rootPins
  by_cases hq : q.1.2 = [] ∧ rtRootsLow a J pat t s q' q.1.1
  · simp only [hq, and_self, ↓reduceIte]
    obtain ⟨h0, hb, hpin⟩ := hq
    have heq : q = ⟨(q.1.1, []), hb⟩ := Subtype.ext (Prod.ext rfl h0)
    have hpin' : (fixCap (recLGLow a) J pat t s (cbrLow a q' q)).isSome := by rw [heq]; exact hpin
    exact (rcp_pinned_rootLow a J pat t s hR q' hnc q hpin').2
  · simp only [hq, ↓reduceIte]
    cases hc : fixCap (recLGLow a) J pat t s (cbrLow a q' q) with
    | none => rfl
    | some v =>
      exfalso
      have hpin : (fixCap (recLGLow a) J pat t s (cbrLow a q' q)).isSome := by rw [hc]; rfl
      have h0 := (rcp_pinned_rootLow a J pat t s hR q' hnc q hpin).1
      refine hq ⟨h0, ?_, ?_⟩
      · rw [← h0]; exact q.2
      · have heq : (⟨(q.1.1, []), by rw [← h0]; exact q.2⟩ : GBranch (decodedCouple (a.prime.data.couple q')).tree) =
            q := Subtype.ext (Prod.ext rfl h0.symm)
        show (fixCap (recLGLow a) J pat t s (cbrLow a q' _)).isSome
        rw [heq]; exact hpin

end

