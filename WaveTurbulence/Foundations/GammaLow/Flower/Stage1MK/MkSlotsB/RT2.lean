/-- **The clock of a pinned root is the core of a capped flower parent**, pinned at `s`. -/
theorem rcp_clockLow (j : Fin 2) (hj : rtRootsLow a J pat t s q' j) :
    ∃ β : GBranch a.prime.skeleton.tree, argSrc a.prime.prime.1 (.inl q') j = .inr β ∧
      IsCapFlowerParent (recLGLow a) J (a.prime.data.coreBranch a.prime.prime.1 β) := by
  obtain ⟨hb, hpin⟩ := hj
