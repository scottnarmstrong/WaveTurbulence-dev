  refine ⟨?_, fun j hj => ?_⟩
  · by_cases hex : ∃ i : Fin 2, MkSlotsI.clkPin (fun _ => t)
        (fixCore a.prime.data a.prime.prime.1 (fixCap (recLGLow a) J pat t s)) (argSrc a.prime.prime.1 (.inl q') i) = none
    · exact hfree hex
    · push Not at hex
      have hmem : ∀ i : Fin 2, ts i ∈ Icc (clkLayer p (fun b => sourceLayerLow a
          (a.prime.data.coreBranch a.prime.prime.1 b).toNode) (argSrc a.prime.prime.1 (.inl q') i) : ℝ)
          (clkLayer p (fun b => sourceLayerLow a (a.prime.data.coreBranch a.prime.prime.1 b).toNode)
            (argSrc a.prime.prime.1 (.inl q') i) + 1) := by
        intro i
        obtain ⟨v, hv⟩ := Option.ne_none_iff_exists'.mp (hex i)
        rw [hpin i v hv]
        exact clkPin_mem_Icc a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) hR.geo
          hR.patv hR.root hs ht _ v hv
      exact ⟨hmem 0, hmem 1⟩
  · obtain ⟨β, hβ, hcf⟩ := rcp_clockLow a J pat t s hR q' hnc j hj
    have hv : MkSlotsI.clkPin (fun _ => t) (fixCore a.prime.data a.prime.prime.1 (fixCap (recLGLow a) J pat t s))
        (argSrc a.prime.prime.1 (.inl q') j) = some s := by
      rw [hβ]
      show fixCap (recLGLow a) J pat t s (a.prime.data.coreBranch a.prime.prime.1 β) = some s
      unfold fixCap
      simp only [hcf, ↓reduceIte]
    rw [hpin j s hv]

end

section
open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkSlotsB
open scoped Classical ENNReal
open Set
open WaveTurbulence WaveTurbulence.LGSpine TTree
open WaveTurbulence.Reg WaveTurbulence.Reg.Skeleton WaveTurbulence.RegRed WaveTurbulence.Represents
open WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden WaveTurbulence.VineAlign
open WaveTurbulence.Flower.MkDefs WaveTurbulence.Flower.MkSlots WaveTurbulence.Flower.MkSlots.IntRest
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w : ℕ}

/-- **(1) A chain slot with a pinned native branch and no native stem node is a root-trace chain slot.** -/
theorem rtChain_of_predLow {R p : ℕ} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (J : Finset (Fin (2 * R)))
    (pat : Fin (2 * R) → FixPat) (t s : ℝ) (kSel σ : Fin (2 * R) → Option ℕ)
    (hcan : IsCanonGC (p + 1) a.layered) (hJ : J.card = R) (hG : CapGeo a.layered J p)
    (hpat : CapPatValid a.layered J pat p) (hirr : a.layered.garden.Irreducible)
    (sl : ReplacementSlot a.prime.skeleton) (hsl : ∃ β, sl = .inr β)
    (hpin : HasPinNativeLow a J pat t s kSel σ sl) (hst : ¬ HasStemNativeLow a J pat t s kSel σ sl) :
    ∃ γ', sl = .inr γ' ∧ RTChainLow a J pat t s p γ' := by
  have hR := rtRec_ofLow (p := p) a J pat hcan hJ hG hpat hirr
  obtain ⟨γ', rfl⟩ := hsl
  obtain ⟨qb, hqb⟩ := hpin
  have hqb' : (fixCap (recLGLow a) J pat t s (nativeBr a.prime.data a.prime.prime.1 (.inr γ') qb)).isSome := hqb
  -- no native chain branch is on a capped stem
  have hstem : ∀ y : GBranch (decodedTree (a.prime.data.tree γ') (nodeSign a.prime.skeleton.sig γ'.1)).tree,
      ¬ OnCapStem (recLGLow a) J (nativeBr a.prime.data a.prime.prime.1 (.inr γ') y).toNode := by
    intro y hy
    refine hst ⟨GBranch.toNode (tree := (decodedTree (a.prime.data.tree γ')
      (nodeSign a.prime.skeleton.sig γ'.1)).tree) y, fun β' he => ?_, _, hy, rfl⟩
    exact chainBr_ne_core a.prime.data a.prime.prime.1 γ' y β' (he.symm.trans (Subtype.ext rfl))
  -- the chain is nontrivial
  have h0 : (a.prime.data.tree γ').lonePath ≠ [] := by
    intro h0
    have hq2 := qb.2
    rw [show ((decodedTree (a.prime.data.tree γ') (nodeSign a.prime.skeleton.sig γ'.1)).tree qb.1.1) =
      (a.prime.data.tree γ').plug (nodeSign a.prime.skeleton.sig γ'.1) TTree.leaf from rfl,
      (lonePath_nil_iff _ _).mp h0] at hq2
    simp [TTree.branching] at hq2
  set b := nativeBr a.prime.data a.prime.prime.1 (.inr γ') qb with hbdef
  have hbaddr : b.1 = addrExt (inflatedPosition a.prime.skeleton a.prime.data.tree γ'.toNode) qb.1.2 := rfl
  obtain ⟨v, hv⟩ := Option.isSome_iff_exists.mp hqb'
  rcases fixCap_cases hv with ⟨hc, -⟩ | ⟨-, -, hb0, -⟩ | ⟨-, -, ⟨C, hC, hCb⟩, -⟩ | ⟨i, -, hpi, ⟨c, hc, h1, h2⟩, -⟩
  · exfalso
    obtain ⟨ℓ, hℓ, hd⟩ := cfp_isDesc_flower hc
    exact hstem qb ⟨ℓ, hℓ, hd⟩
  · exfalso
    obtain ⟨ℓ, hℓ, hℓj⟩ := hR.root _ (branch_not_cap hR.geo b)
    refine hstem qb ⟨ℓ, hℓ, hℓj.symm, ?_⟩
    show b.1.2 <+: ℓ.1.2
    rw [hb0]; exact List.nil_prefix
  · exfalso
    obtain ⟨ℓ, hℓ, hd⟩ := cfp_isDesc_flower hC
    obtain ⟨g1, k, g2⟩ := hCb
    have hbC : b.toNode.IsDesc C.toNode := ⟨g1.symm, ⟨[k], g2.symm⟩⟩
    exact hstem qb ⟨ℓ, hℓ, isDesc_trans hbC hd⟩
  · -- `dChild i`: the pinned branch is the chain top, child `i` of a core capped flower parent
    have hcaddr : c.1 = (b.1.1, b.1.2.dropLast) := by
      rw [h2, List.dropLast_concat, h1]
    have hq0 : qb.1.2 = [] := by
      by_contra hne
      let y := GNode.parent (tree := (decodedTree (a.prime.data.tree γ')
        (nodeSign a.prime.skeleton.sig γ'.1)).tree) qb.toNode hne
      have hyc : nativeBr a.prime.data a.prime.prime.1 (.inr γ') y = c := by
        apply Subtype.ext
        rw [hcaddr]
        show addrExt (inflatedPosition a.prime.skeleton a.prime.data.tree γ'.toNode) qb.1.2.dropLast = _
        rw [hbaddr]
        simp only [addrExt]
        rw [List.dropLast_append_of_ne_nil hne]
      obtain ⟨ℓ, hℓ, hd⟩ := cfp_isDesc_flower hc
      exact hstem y (hyc ▸ ⟨ℓ, hℓ, hd⟩)
    have hr1 : b.1 = inflatedPosition a.prime.skeleton a.prime.data.tree γ'.toNode := by
      rw [hbaddr, hq0]; simp [addrExt]
    have hγnr : γ'.1.2 ≠ [] := by
      intro hr
      have hb2 : b.1.2 = [] := by
        rw [hr1]
        have : inflatedPosition a.prime.skeleton a.prime.data.tree γ'.toNode = γ'.toNode.1 := by
          rw [inflatedPosition]; simp only [show γ'.toNode.1.2 = [] from hr, ↓reduceDIte]
        rw [this]; exact hr
      rw [h2] at hb2; simp at hb2
    let β := γ'.toNode.parent hγnr
    let k := γ'.1.2.getLast hγnr
    have hγ : γ'.toNode = β.child k := (Skeleton.child_parent γ'.toNode hγnr).symm
    have hbat : b.toNode = (a.prime.data.coreBranch a.prime.prime.1 β).child k := by
      have ha := IntGeo.attachedNode_nonroot a.prime.data a.prime.prime.1 γ'.toNode hγnr
      exact (Subtype.ext hr1).trans ha
    have hv' := congrArg Subtype.val hbat
    have e1 : b.1.1 = (a.prime.data.coreBranch a.prime.prime.1 β).1.1 := by
      have h := congrArg Prod.fst hv'; exact h
    have e2 : b.1.2 = (a.prime.data.coreBranch a.prime.prime.1 β).1.2 ++ [k] := by
      have h := congrArg Prod.snd hv'; exact h
    have hcβ : c = a.prime.data.coreBranch a.prime.prime.1 β := by
      apply Subtype.ext
      rw [hcaddr, e2, List.dropLast_concat, e1]
    have hik : i = k := by
      have := h2.symm.trans e2
      rw [hcβ] at this
      exact (List.singleton_inj.mp (List.append_inj' this rfl).2)
    subst hik
    have hF : IsCapFlowerParent (recLGLow a) J (a.prime.data.coreBranch a.prime.prime.1 β) := hcβ ▸ hc
    have hpatβ : pat β.1.1 = FixPat.dChild k := by
      rw [← hpi, e1]
      exact (congrArg pat (inflatedPosition_index a.prime.skeleton a.prime.data.tree β.toNode)).symm
    have hnc : ∀ β' : GBranch a.prime.skeleton.tree,
        (a.prime.data.coreBranch a.prime.prime.1 β').toNode ≠ b.toNode :=
      chainBr_ne_core a.prime.data a.prime.prime.1 γ' qb
    refine ⟨γ', rfl, ?_⟩
    exact
      { two_le := rtc_two_leLow a γ' h0
        wf := rtc_wfLow a γ'
        pins := rtc_pinsLow a J pat t s hR β γ' k b hF hpatβ hbat hr1
        layer_le := rtc_layer_leLow a J pat hR γ'
        layer_root := rtc_layer_rootLow a J pat hR β γ' k b hF hpatβ hbat hr1
        layer_lone := rtc_layer_loneLow a γ'
        amb := rtc_ambLow a J pat hR γ'
        genΘs_one := rtc_genΘs_oneLow a J pat hR β γ' k b hF hbat hr1
        selNative_empty := rtc_selNative_emptyLow a J pat hR β γ' k b hF hbat hr1
        chainW_eq := rtc_chainW_eqLow a J pat hR γ'
        clk0 := rtc_clk0Low a J pat t s β γ' k hF hγ
        clkLayer0 := rtc_clkLayer0Low a J pat hR β γ' k hF hγ
        free := rtc_freeLow a J pat t s hR β γ' k b hF hbat hnc hr1
        nonroot := rtc_nonrootLow a β γ' k hγ
        notSelAdj := rtc_notSelAdjLow a J pat β γ' k hpatβ hγ
        prot := rtc_protLow a J pat t s hR β γ' k b hF hpatβ hbat hnc hr1
        leafwise := rtc_leafwiseLow a J pat hR β γ' k b hF hbat hr1
        front_card := rtc_front_cardLow a γ' }

end

section
open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkSlotsB
open scoped Classical ENNReal
open Set
open WaveTurbulence WaveTurbulence.LGSpine TTree
open WaveTurbulence.Reg WaveTurbulence.Reg.Skeleton WaveTurbulence.RegRed WaveTurbulence.Represents
open WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden WaveTurbulence.VineAlign
open WaveTurbulence.Flower.MkDefs WaveTurbulence.Flower.MkSlots WaveTurbulence.Flower.MkSlots.IntRest
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w : ℕ}

/-- **(2) A non-cap leaf-pair slot with a pinned native branch is a root-trace couple slot** (the pinned roots
`Rt = rtRootsLow`). -/
theorem rtCouple_of_predLow {R p : ℕ} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (J : Finset (Fin (2 * R)))
    (pat : Fin (2 * R) → FixPat) (t s : ℝ) (kSel σ : Fin (2 * R) → Option ℕ)
    (hcan : IsCanonGC (p + 1) a.layered) (hJ : J.card = R) (hG : CapGeo a.layered J p)
    (hpat : CapPatValid a.layered J pat p) (hirr : a.layered.garden.Irreducible)
    (ht : t ∈ Ioo (p : ℝ) (p + 1)) (hs : s ∈ Ioo (p : ℝ) t)
    (sl : ReplacementSlot a.prime.skeleton) (hcpl : IsCplSlotLow a J pat t s kSel σ sl)
    (hpin : HasPinNativeLow a J pat t s kSel σ sl) :
    ∃ (q' : SourcePair a.prime.skeleton) (Rt : Fin 2 → Prop), sl = .inl q' ∧ RTCoupleLow a J pat t s p q' Rt := by
  have hR := rtRec_ofLow (p := p) a J pat hcan hJ hG hpat hirr
  obtain ⟨q', rfl, hnc⟩ := hcpl
  obtain ⟨qb, hqb⟩ := hpin
  have hqb' : (fixCap (recLGLow a) J pat t s (cbrLow a q' qb)).isSome := hqb
  obtain ⟨h0, -⟩ := rcp_pinned_rootLow a J pat t s hR q' hnc qb hqb'
  have hj : rtRootsLow a J pat t s q' qb.1.1 := by
    refine ⟨by rw [← h0]; exact qb.2, ?_⟩
    have heq : (⟨(qb.1.1, []), by rw [← h0]; exact qb.2⟩ : GBranch (decodedCouple (a.prime.data.couple q')).tree) =
        qb := Subtype.ext (Prod.ext rfl h0.symm)
    show (fixCap (recLGLow a) J pat t s (cbrLow a q' _)).isSome
    rw [heq]; exact hqb'
  refine ⟨q', rtRootsLow a J pat t s q', rfl, ?_⟩
  exact
    { rt := ⟨qb.1.1, hj⟩
      notCap := hnc
      wf := rcp_wfLow a q'
      pins := rcp_pinsLow a J pat t s hR q' hnc
      layer_le := rcp_layer_leLow a J pat hR q'
      root_pinned := rcp_root_pinnedLow a J pat t s hR q'
      root_le := rcp_root_leLow a J pat hR q'
      amb := rcp_ambLow a J pat hR q'
      genΘs_one := rcp_genΘs_oneLow a J q' hnc
      selNative_empty := rcp_selNative_emptyLow a J q' hnc
      chainW_eq := rcp_chainW_eqLow a J pat hR q' hnc
      notSelAdj := rcp_notSelAdjLow a J pat t s hR q' hnc
      prot := rcp_protLow a J pat t s q' qb.1.1 hj
      leafwise := rcp_leafwiseLow a J pat hR q' hnc
      front_card := rcp_front_cardLow a q'
      box := rcp_boxLow a J pat t s hR q' hnc ht hs }

end

