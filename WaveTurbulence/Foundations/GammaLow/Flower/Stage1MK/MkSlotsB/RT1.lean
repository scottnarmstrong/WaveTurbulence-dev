variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w : ℕ}

/-- The frontier nodes of a native object (for the star weights of the frontier cutoffs). -/
def frontNatLow (a : Fama.VineA.PrescribedPrimeGarden γF w) {T : Fin 1 → TTree} (e : GNode T → GNode (recLGLow a).garden.tree) (p : ℕ) :
    Finset (GNode T) :=
  Finset.univ.filter fun z => (e z).1.2 ≠ [] ∧ (recLGLow a).layer (e z) < p ∧
    (recLGLow a).parentLayer p (e z) = p

end

