variable {w : ℕ}

/-- **The geometric data of a root-trace CHAIN slot `.inr γ'`** (tree variant): `X = D.tree γ'` nontrivial
(`2 ≤ |lonePath|`), only the root pinned (at `s`), layers `≤ p` with the root in layer `p` and the lone node in the
layer of the core of `γ'`, canonical ambient; off the capped stems (`genΘs ≡ 1`, no selected native vertex, node
weight = frontier weight); upper clock pinned at `s` in layer `p`, lower clock `γ'` free, `γ'` not a skeleton root;
never `SelAdj` (the tree is a `dChild` tree); a protected native node (the root); leafwise control. -/
structure RTChainLow (a : Fama.VineA.PrescribedPrimeGarden γF w) (J : Finset (Fin w)) (pat : Fin w → FixPat) (t s : ℝ) (p : ℕ)
    (γ' : GBranch a.prime.skeleton.tree) : Prop where
  two_le : 2 ≤ (a.prime.data.tree γ').lonePath.length
  wf : (a.prime.data.tree γ').wf = true
  pins : ∀ q : GBranch (nativeChainLayered a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a) γ').garden.tree,
    MkSlots.fixNative a.prime.data a.prime.prime.1 (fixCap (recLGLow a) J pat t s) (.inr γ') q =
      MkSlotsO.rootPins (fun _ => True) s q
  layer_le : ∀ z, (nativeChainLayered a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a) γ').layer z ≤ p
  layer_root : (nativeChainLayered a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a) γ').layer (GNode.root _ 0) = p
  layer_lone : ∀ z : GNode (nativeChainLayered a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a) γ').garden.tree, z.1.2 = (a.prime.data.tree γ').lonePath →
    (nativeChainLayered a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) γ').layer z =
      sourceLayerLow a (a.prime.data.coreBranch a.prime.prime.1 γ').toNode
  amb : ProtAmbient p (a.prime.data.tree γ')
    (nativeChainLayered a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) γ')
  genΘs_one : ∀ {d : ℕ} (L : ℝ) (σ kSel : Fin w → Option ℕ) (Rs : Fin w → ℝ) (k : Mom d)
    (κ : NativeRelativeDecoration a.prime.data a.prime.prime.1 d (.inr γ')),
    MkSlotsI.genΘs a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J L σ kSel Rs (.inr γ')
      k κ = 1
  selNative_empty : ∀ kSel : Fin w → Option ℕ,
    MkSlotsS.selNative a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J kSel (.inr γ') = ∅
  chainW_eq : ∀ {d : ℕ} (L γ δ s' : ℝ) (Rf : Fin w → Option ℝ) (dag : Option (Fin w → Fin 3 → Mom d))
    (z : GNode (decodedTree (a.prime.data.tree γ') (nodeSign a.prime.skeleton.sig γ'.1)).tree) (x : Mom d),
    MkSlots.chainW a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) L γ δ p s' J Rf dag
        (chainContextNode a.prime.data a.prime.prime.1 γ' z) x =
      fwNode (recLGLow a) p (fun j => frontierG (Rf j)) (chainContextNode a.prime.data a.prime.prime.1 γ' z) x
  clk0 : MkSlotsI.clkPin (fun _ => t) (MkSlots.fixCore a.prime.data a.prime.prime.1 (fixCap (recLGLow a) J pat t s))
    (argSrc a.prime.prime.1 (.inr γ') 0) = some s
  clkLayer0 : clkLayer p (fun b => sourceLayerLow a (a.prime.data.coreBranch a.prime.prime.1 b).toNode)
    (argSrc a.prime.prime.1 (.inr γ') 0) = p
  free : MkSlots.fixCore a.prime.data a.prime.prime.1 (fixCap (recLGLow a) J pat t s) γ' = none
  nonroot : γ'.1.2 ≠ []
  notSelAdj : ∀ kSel : Fin w → Option ℕ, (∀ j, (kSel j).isSome → pat j = FixPat.plain) →
    ¬ MkSlotsI.SelAdj a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J kSel (.inr γ')
  prot : ∀ kSel : Fin w → Option ℕ, MkSlotsI.HasProtNative a.prime.data a.prime.prime.1 (sourceLayerLow a)
    (sourceLayer_isLayeringLow a) (protI (recLGLow a) J pat t s kSel) (.inr γ')
  leafwise : ∀ {d : ℕ} (h : ℕ → Fin w → Fin w → Mom d → ℝ) (L : ℝ) (roots : Fin w → (Fin d → ℤ)) (b : ℝ), 0 ≤ b →
    (∀ q ≤ p, ∀ j j', SNormR (40 * d) (40 * d) (h q j j') ≤ ENNReal.ofReal b) →
    LeafwiseControlled (nativeChainLayered a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) γ')
      (MkSlots.capProfiles (nativeChainLayered a.prime.data a.prime.prime.1 (sourceLayerLow a)
        (sourceLayer_isLayeringLow a) γ')
        (fun z => MkSlots.anchProfiles J (recLGLow a) h L roots (chainContextNode a.prime.data a.prime.prime.1 γ' z).1))
      (nativeChainB a.prime.data a.prime.prime.1 (fun _ => b.toNNReal) γ')
  front_card : (frontNatLow a (chainContextNode a.prime.data a.prime.prime.1 γ') p).card ≤
    slotNr a.prime.data a.prime.prime.1 (.inr γ')

end

