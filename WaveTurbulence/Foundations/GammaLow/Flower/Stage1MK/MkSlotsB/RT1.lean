/-- The hypotheses of `GenSlotObligationAt` used here, on the reconstruction `recLGLow a`. -/
structure RTRecLow : Prop where
  can : IsCanonGC (p + 1) (recLGLow a)
  geo : CapGeo (recLGLow a) J p
  patv : CapPatValid (recLGLow a) J pat p
  root : ∀ j ∉ J, ∃ ℓ : GLeaf (recLGLow a).garden.tree, IsCapFlower (recLGLow a) J ℓ ∧ ℓ.1.1 = j
  cap : ∀ j ∈ J, (a.prime.data.garden a.prime.prime.1).tree j = TTree.leaf

end

