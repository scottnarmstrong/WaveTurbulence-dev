variable {w : ℕ}

/-- **The geometric data of a root-trace COUPLE slot `.inl q'`** (couple variant), with the set `Rt ≠ ∅` of trees
whose root is pinned (at `s`): not a cap pair; only the roots in `Rt` pinned; layers `≤ p`, the pinned roots
branching in layer `p`, the roots below their clock windows; canonical signed ambient with the clock windows as root parent layers (F-RT-3); off the capped stems; never
`SelAdj` when both roots are pinned; a protected native node; leafwise control; the box inside the gate's box `timeBox q q' ∩ {s ≤ ts j, j ∈ Rt}`. -/
structure RTCoupleLow (a : Fama.VineA.PrescribedPrimeGarden γF w) (J : Finset (Fin w)) (pat : Fin w → FixPat) (t s : ℝ) (p : ℕ)
    (q' : SourcePair a.prime.skeleton) (Rt : Fin 2 → Prop) : Prop where
  rt : ∃ j, Rt j
  notCap : ¬ MkSlots.IsCapPair a.prime.skeleton a.prime.prime.1 J q'
  wf : (a.prime.data.couple q').wf = true
  pins : ∀ q : GBranch (nativeCoupleLayered a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a) q').garden.tree,
    MkSlots.fixNative a.prime.data a.prime.prime.1 (fixCap (recLGLow a) J pat t s) (.inl q') q =
      MkSlotsO.rootPins Rt s q
  layer_le : ∀ z, (nativeCoupleLayered a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a) q').layer z ≤ p
  root_pinned : ∀ j, Rt j → ([] : Path) ∈ ((nativeCoupleLayered a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a) q').garden.tree j).branching ∧
    (nativeCoupleLayered a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) q').layer
      (GNode.root _ j) = p
  root_le : ∀ j, (nativeCoupleLayered a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a) q').layer (GNode.root _ j) ≤
    clkLayer p (fun b => sourceLayerLow a (a.prime.data.coreBranch a.prime.prime.1 b).toNode)
      (argSrc a.prime.prime.1 (.inl q') j)
  amb : MkSlotsO.CplAmbient p
    (clkLayer p (fun b => sourceLayerLow a (a.prime.data.coreBranch a.prime.prime.1 b).toNode)
      (argSrc a.prime.prime.1 (.inl q') 0))
    (clkLayer p (fun b => sourceLayerLow a (a.prime.data.coreBranch a.prime.prime.1 b).toNode)
      (argSrc a.prime.prime.1 (.inl q') 1))
    (a.prime.data.couple q')
    (nativeCoupleLayered a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) q')
  genΘs_one : ∀ {d : ℕ} (L : ℝ) (σ kSel : Fin w → Option ℕ) (Rs : Fin w → ℝ) (k : Mom d)
    (κ : NativeRelativeDecoration a.prime.data a.prime.prime.1 d (.inl q')),
    MkSlotsI.genΘs a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J L σ kSel Rs (.inl q')
      k κ = 1
  selNative_empty : ∀ kSel : Fin w → Option ℕ,
    MkSlotsS.selNative a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J kSel (.inl q') = ∅
  chainW_eq : ∀ {d : ℕ} (L γ δ s' : ℝ) (Rf : Fin w → Option ℝ) (dag : Option (Fin w → Fin 3 → Mom d))
    (z : GNode (nativeCoupleGarden a.prime.data a.prime.prime.1 q').tree) (x : Mom d),
    MkSlots.chainW a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) L γ δ p s' J Rf dag
        ((nativeCoupleForest a.prime.data a.prime.prime.1 q').nodeEmbedding z) x =
      fwNode (recLGLow a) p (fun j => frontierG (Rf j))
        ((nativeCoupleForest a.prime.data a.prime.prime.1 q').nodeEmbedding z) x
  notSelAdj : Rt 0 ∧ Rt 1 → ∀ kSel : Fin w → Option ℕ,
    ¬ MkSlotsI.SelAdj a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J kSel (.inl q')
  prot : ∀ kSel : Fin w → Option ℕ, MkSlotsI.HasProtNative a.prime.data a.prime.prime.1 (sourceLayerLow a)
    (sourceLayer_isLayeringLow a) (protI (recLGLow a) J pat t s kSel) (.inl q')
  leafwise : ∀ {d : ℕ} (h : ℕ → Fin w → Fin w → Mom d → ℝ) (L : ℝ) (roots : Fin w → (Fin d → ℤ)) (b : ℝ), 0 ≤ b →
    (∀ q ≤ p, ∀ j j', SNormR (40 * d) (40 * d) (h q j j') ≤ ENNReal.ofReal b) →
    LeafwiseControlled (nativeCoupleLayered a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) q')
      (MkSlots.capProfiles (nativeCoupleLayered a.prime.data a.prime.prime.1 (sourceLayerLow a)
        (sourceLayer_isLayeringLow a) q')
        (fun z => MkSlots.anchProfiles J (recLGLow a) h L roots
          ((nativeCoupleForest a.prime.data a.prime.prime.1 q').nodeEmbedding z).1))
      (nativeCoupleB a.prime.data a.prime.prime.1 (fun _ => b.toNNReal) q')
  front_card : (frontNat2Low a ((nativeCoupleForest a.prime.data a.prime.prime.1 q').nodeEmbedding) p).card ≤
    slotNr a.prime.data a.prime.prime.1 (.inl q')
  box : genBoxAtLow p a J pat t s (.inl q') ⊆
    timeBox (clkLayer p (fun b => sourceLayerLow a (a.prime.data.coreBranch a.prime.prime.1 b).toNode)
        (argSrc a.prime.prime.1 (.inl q') 0))
      (clkLayer p (fun b => sourceLayerLow a (a.prime.data.coreBranch a.prime.prime.1 b).toNode)
        (argSrc a.prime.prime.1 (.inl q') 1)) ∩ {ts | ∀ j, Rt j → s ≤ ts j}

end

