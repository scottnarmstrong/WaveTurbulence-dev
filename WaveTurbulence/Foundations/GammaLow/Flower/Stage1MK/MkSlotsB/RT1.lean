open WaveTurbulence.Flower.MkDefs WaveTurbulence.Flower.MkSlots WaveTurbulence.Flower.MkSlots.IntGeo
open WaveTurbulence.Flower.MkSlots.IntRest
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {R p : ℕ} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat)

theorem rtRec_ofLow (hcan : IsCanonGC (p + 1) a.layered) (hJ : J.card = R) (hG : CapGeo a.layered J p)
    (hpat : CapPatValid a.layered J pat p) (hirr : a.layered.garden.Irreducible) : RTRecLow (p := p) a J pat := by
  have hrec : recLGLow a = a.layered := sourceLayer_reconstructsLow a
  have hpl : a.layered.garden.IsPlain := hcan.1
  have hroot := exists_capFlower_of_capGeo hG hpl hirr (by rw [hJ])
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · rw [hrec]; exact hcan
  · rw [hrec]; exact hG
  · rw [hrec]; exact hpat
  · rw [hrec]; exact hroot
  · intro j hj
    have h := congrArg (fun LG : LayeredGarden (2 * R) => LG.garden.tree j) hrec
    exact h.trans (hG.cap_leaf j hj)

end

