/-- **The native chain of an outer chain slot is common to the run class** (at a marking). -/
theorem memShape_nativeChainLow {R p : ℕ} {kind : Bool} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R))
    (mk : Fama.Stage1Mk.MarkFn γF (2 * R))
    (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (hy : y ∈ Fama.sourceClass γF a p kind mk)
    (hG : (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.IsPlain)
    (c : GBranch (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.tree) :
    nativeChainLayered y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) ((memShapeLow a mk y hy).br c) =
      nativeChainLayered a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)
        ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).br c) :=
  Option.some.inj (memShape_slotNTLLow a mk y hy hG (.inr c))

end

