/-- **The native chain R-SLOT at a marking**: the native chain family of the outer slots of a run-class member is the
representative's. -/
theorem memShape_slotNTLLow {R p : ℕ} {kind : Bool} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R))
    (mk : Fama.Stage1Mk.MarkFn γF (2 * R))
    (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (hy : y ∈ Fama.sourceClass γF a p kind mk)
    (hG : (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.IsPlain)
    (s : ReplacementSlot (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G) :
    slotNTL y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)
        ((memShapeLow a mk y hy).iota y.1.plain hG s) =
      slotNTL a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)
        ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).iota a.prime.prime.1 hG s) :=
  commonShape_NTLMkLow (Mole.garden_isMolecule _) a.totalSigma a.prime.data a.prime.prime.1
    (sourceLayerLow a) (sourceLayer_isLayeringLow a)
    (Fama.class_member_traceMk (Mole.garden_isMolecule _) a.totalSigma a.prime.data a.prime.prime.1
      (sourceLayerLow a) (sourceLayer_isLayeringLow a) a.prime.prime y hy).choose_spec.2
    (Fama.class_member_traceMk (Mole.garden_isMolecule _) a.totalSigma a.prime.data a.prime.prime.1
      (sourceLayerLow a) (sourceLayer_isLayeringLow a) a.prime.prime y hy).choose_spec.1
    (markTransported_imageMarkLow _ (mk a.prime)) hG s

end

