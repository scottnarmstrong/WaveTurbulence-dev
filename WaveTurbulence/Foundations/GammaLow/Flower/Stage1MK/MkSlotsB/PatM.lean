/-- **The chain at a `G_sb` atom is trivial for a run-class member iff it is for the representative.** -/
theorem memShape_lonePath_nil_iffLow {R p : ℕ} {kind : Bool} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R))
    (mk : Fama.Stage1Mk.MarkFn γF (2 * R))
    (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (hy : y ∈ Fama.sourceClass γF a p kind mk)
    (hG : (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.IsPlain)
    (c : GBranch (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.tree) :
    (y.1.data.tree ((memShapeLow a mk y hy).br c)).lonePath = [] ↔
      (a.prime.data.tree ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).br c)).lonePath
        = [] := by
  rw [lonePath_nil_iff_native y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1),
    lonePath_nil_iff_native a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a),
    memShape_nativeChainLow a mk y hy hG c]

end

