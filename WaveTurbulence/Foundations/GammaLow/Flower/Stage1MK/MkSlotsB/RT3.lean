/-- The general box of a root-trace chain slot lies in the gate's box. -/
theorem genBoxAt_chain_subsetLow (G : RTChainLow a J pat t s p γ') :
    genBoxAtLow p a J pat t s (.inr γ') ⊆
      timeBoxGt (p : ℝ) (sourceLayerLow a (a.prime.data.coreBranch a.prime.prime.1 γ').toNode : ℝ) ∩
        {ts | ts 1 < s ∧ s ≤ ts 0} := by
  intro ts hts
  obtain ⟨h1, h2⟩ := hts
  have h0 : ts 0 = s := h1 0 s G.clk0
  have harg1 : argSrc a.prime.prime.1 (.inr γ') 1 = .inr γ' := rfl
  have hnone : MkSlotsI.clkPin (fun _ => t) (MkSlots.fixCore a.prime.data a.prime.prime.1
      (fixCap (recLGLow a) J pat t s)) (argSrc a.prime.prime.1 (.inr γ') 1) = none := by
    rw [harg1]
    exact G.free
  have hsb := h2 ⟨1, hnone⟩
  have hsb' : ts ∈ timeBoxGt ((clkLayer p (fun b => sourceLayerLow a (a.prime.data.coreBranch a.prime.prime.1 b).toNode)
      (argSrc a.prime.prime.1 (.inr γ') 0) : ℕ) : ℝ)
      ((clkLayer p (fun b => sourceLayerLow a (a.prime.data.coreBranch a.prime.prime.1 b).toNode)
        (argSrc a.prime.prime.1 (.inr γ') 1) : ℕ) : ℝ) := hsb
  rw [G.clkLayer0, harg1] at hsb'
  refine ⟨hsb', ?_, h0.ge⟩
  show ts 1 < s
  rw [← h0]
  exact hsb'.2

end

