    {R p : ℕ} {a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R)} {J : Finset (Fin (2 * R))} {pat : Fin (2 * R) → FixPat} {t s : ℝ} {q' : SourcePair a.prime.skeleton} {Rt : Fin 2 → Prop} (hRT : MkSlotsO.RootTraceBoundAt P) (hd : 1 ≤ P.d) (hL : 1 ≤ P.L)
    (hηγ : P.η ^ 8 ≤ P.gamma1 - Real.sqrt P.η) (hC1 : 1 ≤ P.C₁) (hδ : 0 ≤ P.δ)
    (C : ℝ) (hC : P.C₁ ≤ C) (hp : p < P.D) (hsz : a.prime.data.size ≤ P.N (p + 1) ^ 4) (hps : (p : ℝ) < s)
    (hsp : s < p + 1) (hlay : ∀ z, (recLGLow a).layer z ≤ p) (G : RTCoupleLow a J pat t s p q' Rt)
    (θ : ℝ) (hθ0 : 0 ≤ θ) (hθ : θ = P.η ∨ (θ = 1 / 4 ∧ ¬ (Rt 0 ∧ Rt 1)))
    (σ kSel : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ) (h : ℕ → Fin (2 * R) → Fin (2 * R) → Mom P.d → ℝ)
    (roots : Fin (2 * R) → (Fin P.d → ℤ)) (b : ℝ) (hb1 : 1 ≤ b)
