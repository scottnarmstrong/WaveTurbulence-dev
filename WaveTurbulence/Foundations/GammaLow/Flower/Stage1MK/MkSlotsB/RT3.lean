/-- **The general slot kernel of a root-trace couple slot is RT (ii′)'s kernel.** -/
theorem genSlotKer_cplLow (G : RTCoupleLow a J pat t s p q' Rt) {d : ℕ} (L γ δ : ℝ) (σ kSel : Fin (2 * R) → Option ℕ)
    (Rs : Fin (2 * R) → ℝ) (h : ℕ → Fin (2 * R) → Fin (2 * R) → Mom d → ℝ) (roots : Fin (2 * R) → (Fin d → ℤ))
    (Rf : Fin (2 * R) → Option ℝ) (dag : Option (Fin (2 * R) → Fin 3 → Mom d)) (ts : Fin 2 → ℝ) (k : Mom d) :
    genSlotKerLow L γ δ p a J pat t s σ kSel Rs h roots Rf dag (.inl q') ts k =
      kernelProt L γ δ (nativeCoupleLayered a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) q')
        (MkSlots.capProfiles (nativeCoupleLayered a.prime.data a.prime.prime.1 (sourceLayerLow a)
          (sourceLayer_isLayeringLow a) q')
          (fun z => MkSlots.anchProfiles J (recLGLow a) h L roots
            ((nativeCoupleForest a.prime.data a.prime.prime.1 q').nodeEmbedding z).1))
        (fun κ => IncTop.starWeight (frontNat2Low a (nativeCoupleForest a.prime.data a.prime.prime.1 q').nodeEmbedding p)
          (fun z y => frontierG (Rf ((nativeCoupleForest a.prime.data a.prime.prime.1 q').nodeEmbedding z).1.1)
            (y 0)) κ)
        (fun b => if b.1.1 = 0 then ts 0 else ts 1) 0 (MkSlotsO.rootPins Rt s) k (fun _ => 0) 0 := by
  unfold genSlotKerLow
  dsimp only [slotFnGWFRL]
  have hΘ : MkSlotsI.genΘs a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J L σ kSel Rs
      (.inl q') k = fun _ => 1 := funext fun κ => G.genΘs_one L σ kSel Rs k κ
  have hfix : MkSlots.fixNative a.prime.data a.prime.prime.1 (fixCap (recLGLow a) J pat t s) (.inl q') =
      MkSlotsO.rootPins Rt s := funext fun q => G.pins q
  have hm : (fun k' => ∏ z, MkSlots.chainW a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)
      L γ δ p s J Rf dag ((nativeCoupleForest a.prime.data a.prime.prime.1 q').nodeEmbedding z) (k' z)) =
      fun κ => IncTop.starWeight (frontNat2Low a (nativeCoupleForest a.prime.data a.prime.prime.1 q').nodeEmbedding p)
        (fun z y => frontierG (Rf ((nativeCoupleForest a.prime.data a.prime.prime.1 q').nodeEmbedding z).1.1)
          (y 0)) κ := by
    funext K'
    refine (Finset.prod_congr rfl fun z _ => ?_).trans (prod_fwNode_eq_starWeight (recLGLow a) p
      (fun j => frontierG (Rf j)) (nativeCoupleForest a.prime.data a.prime.prime.1 q').nodeEmbedding K')
    exact G.chainW_eq L γ δ s Rf dag z (K' z)
  rw [hΘ, hfix]
  refine (kernelNodeWR_kDomainR_eq_kernelProt L γ δ _ _ _ _ _ _ k _ _ _ (fun hf _ _ => hf.elim)).trans ?_
  exact congrArg (fun m' => kernelProt L γ δ _ _ m' (fun b => if b.1.1 = 0 then ts 0 else ts 1) 0
    (MkSlotsO.rootPins Rt s) k (fun _ => 0) 0) hm

end

