open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]

/-- **The root-trace chain kind at one parameter record**, from RT at that record. -/
theorem rtChainKindAtLow {P : WTParams} [Fact (P.γ ≤ 1 / 2)] (hRT : MkSlotsO.RootTraceBoundAt P) (hd : 3 ≤ P.d) (hη : 0 < P.η)
    (hηγ : P.η ^ 8 ≤ P.gamma1 - Real.sqrt P.η) (hL : 2 ≤ P.L) (hC1 : 1 ≤ P.C₁) (hδ : 0 ≤ P.δ) :
    GenSlotOnAtLow IsRTChainSlotLow rtKc P := by
  intro C hC R p a J pat t s hp hcan hsz hJ hgeo hpat hirr ht hs kSel hkSel σ Rs hRs mkF hfine hclean roots h b
    hb1 hb Rf hRf hRf' dag s' sl hsl hQ x
  have hRf1 : ∀ j r, Rf j = some r → 1 ≤ r := fun j r hr => by have := hRf j r hr; linarith
  obtain ⟨γ', rfl, G⟩ := rtChain_of_predLow a J pat t s kSel σ hcan hJ hgeo hpat hirr _ hQ.1 hQ.2.1 hQ.2.2
  refine slotConcl_of_fam1Low P C rtKc a J pat t s σ kSel Rs h roots Rf dag b (.inr γ') x (fun _ => ?_)
    (fun hsa => absurd hsa (G.notSelAdj kSel hkSel))
  exact slotFam1_chainLow hRT (by omega) hη.le (by linarith) hηγ hC1 hδ C hC hp hsz hs.1 (hs.2.trans ht.2)
    (layer_le_of_canonLow a hcan) G σ kSel Rs h roots b hb1 hb Rf hRf1 dag x

end

