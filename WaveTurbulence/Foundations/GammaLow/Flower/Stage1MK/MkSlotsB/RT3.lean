open scoped Classical ENNReal
open Set
open WaveTurbulence TTree WaveTurbulence.Reg WaveTurbulence.Reg.Skeleton WaveTurbulence.RegRed WaveTurbulence.LGSpine WaveTurbulence.Represents WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden WaveTurbulence.VineAlign WaveTurbulence.Flower.MkDefs WaveTurbulence.Flower.ProtDefs
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]

/-- **The root-trace couple kind at one parameter record**, from RT at that record. -/
theorem protCplKindAtLow {P : WTParams} [Fact (P.γ ≤ 1 / 2)] (hRT : MkSlotsO.RootTraceBoundAt P) (hd : 3 ≤ P.d) (hη : 0 < P.η)
    (hη4 : P.η ≤ 1 / 4) (hηγ : P.η ^ 8 ≤ P.gamma1 - Real.sqrt P.η) (hL : 2 ≤ P.L) (hC1 : 1 ≤ P.C₁)
    (hδ : 0 ≤ P.δ) :
    GenSlotOnAtLow IsProtCplSlotLow rtKcpl P := by
  intro C hC R p a J pat t s hp hcan hsz hJ hgeo hpat hirr ht hs kSel hkSel σ Rs hRs mkF hfine hclean roots h b
    hb1 hb Rf hRf hRf' dag s' sl hsl hQ x
  have hRf1 : ∀ j r, Rf j = some r → 1 ≤ r := fun j r hr => by have := hRf j r hr; linarith
  rcases hQ.2 with hpin | hsel
  · obtain ⟨q', Rt, rfl, G⟩ := rtCouple_of_predLow a J pat t s kSel σ hcan hJ hgeo hpat hirr ht hs _ hQ.1 hpin
    have hgsm := genSlotMass_nonnegLow P (le_trans (le_trans zero_le_one hC1) hC) hb1 (by linarith) a J pat t
      s kSel Rs (fun j => by have := hRs j; linarith) (.inl q')
    refine slotConcl_of_fam1Low P C rtKcpl a J pat t s σ kSel Rs h roots Rf dag b (.inl q') x
      (fun _ => ?_) (fun hsa => ?_)
    · refine slotFam1_cplLow hRT (by omega) (by linarith) hηγ hC1 hδ C hC hp hsz hs.1 (hs.2.trans ht.2)
        (layer_le_of_canonLow a hcan) G P.η hη.le (Or.inl rfl) σ kSel Rs h roots b hb1 hb Rf hRf1 dag x (rtKcpl P.d P.η)
        ?_ _ le_rfl
      have := rtKq_nonneg P.d (1 / 4)
      unfold rtKcpl rtKq at *
      linarith
    · refine slotFam1_cplLow hRT (by omega) (by linarith) hηγ hC1 hδ C hC hp hsz hs.1 (hs.2.trans ht.2)
        (layer_le_of_canonLow a hcan) G (1 / 4) (by norm_num) (Or.inr ⟨rfl, fun hb2 => G.notSelAdj hb2 kSel hsa⟩)
        σ kSel Rs h roots b hb1 hb Rf hRf1 dag x (rtKcpl P.d P.η) ?_ _ ?_
      · have := rtKq_nonneg P.d P.η
        unfold rtKcpl rtKq at *
        linarith
      · refine ENNReal.ofReal_le_ofReal ?_
        have hK : 0 ≤ rtKcpl P.d P.η := le_trans zero_le_one (one_le_rtKcpl P.d P.η)
        have hLp : 1 ≤ P.L ^ (47 * (P.d : ℝ) + 2) := Real.one_le_rpow (by linarith) (by positivity)
        calc rtKcpl P.d P.η * genSlotMassLow P C b a J pat t s kSel Rs (.inl q')
            = rtKcpl P.d P.η * 1 * genSlotMassLow P C b a J pat t s kSel Rs (.inl q') := by ring
          _ ≤ _ := by gcongr
  · exact absurd hsel (not_selNat_cplLow a J pat t s kSel σ _ hQ.1)

end

