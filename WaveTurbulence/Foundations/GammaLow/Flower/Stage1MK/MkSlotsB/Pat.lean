def spliceNTLMkLow (A : FamilyReconstruction w ι) (σ : Prescription A.skeleton) (Mk : Set (Fama.CLVineG γF A.skeleton))
    (s : ReplacementSlot (Fama.stSt γF A.skeleton σ Mk).G) : Option (LayeredGarden 1) :=
