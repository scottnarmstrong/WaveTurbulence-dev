  (hMk : ∀ c ∈ markILow J pat t s kSel a.prime, c ∈ Fama.vinesV0 γF a.prime.skeleton a.totalSigma → c ∈ Mk)

include hMk in
/-- **No core branch of an atom of a unit of the representative is pinned** (every pattern, any marked set `Mk`
containing the marked vines of `𝒱₀(σ)`). -/
theorem hU_rep_patLow (j : Fin (Fama.unitBlocks γF a.prime.skeleton a.totalSigma Mk).length) (y : GBranch a.prime.skeleton.tree)
    (hy : y ∈ (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma Mk j).atoms) :
    fixCap a.layered J pat t s (a.prime.data.decodedCoreBranch a.prime.prime.1 a.prime.decodes y) = none := by
  have hu : Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma Mk j ∈
      Fama.unitBlocks γF a.prime.skeleton a.totalSigma Mk := List.get_mem _ _
  obtain ⟨c, hc, hyc, -⟩ := Fama.unitBlocks_soundMk hu y hy
  rw [Fama.mem_vinesV0] at hc
  obtain ⟨hc0, hcMk⟩ := hc
  by_contra hpin
  have hpin' := Option.ne_none_iff_isSome.1 hpin
  have hm : c ∈ markILow J pat t s kSel a.prime :=
    marked_of_fix_atomLow a.prime pat t s kSel c (Fama.vinesV0_subset _ _ hc0) y hyc hpin' rfl
  exact hcMk (hMk c hm hc0)


end

