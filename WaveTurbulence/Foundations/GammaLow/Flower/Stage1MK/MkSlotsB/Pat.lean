variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w : ℕ}
variable (J : Finset (Fin w)) (pat : Fin w → FixPat) (t s : ℝ) (mkF : Fama.Stage1Mk.MarkFn γF w)
  (a : Fama.VineA.PrescribedPrimeGarden γF w)

/-- The old name of a non-root `G_sb` branch is a non-root skeleton branch. -/
theorem ob_path_ne_nilLow {c : GBranch (stALow mkF a).G.tree} (hc : c.1.2 ≠ []) : ((stALow mkF a).M.ob c).1.2 ≠ [] := by
  intro h0
  apply hc
  have hn : (shapeOfLow mkF a).node c.toNode = (shapeOfLow mkF a).node (GNode.root (stALow mkF a).G.tree c.1.1) := by
    rw [(shapeOfLow mkF a).root, ← (shapeOfLow mkF a).br_node]
    apply Subtype.ext
    exact Prod.ext (ob_fstLow mkF a c) h0
  have he := (shapeOfLow mkF a).inj hn
  exact congrArg (fun x : GNode (stALow mkF a).G.tree => x.1.2) he

end

