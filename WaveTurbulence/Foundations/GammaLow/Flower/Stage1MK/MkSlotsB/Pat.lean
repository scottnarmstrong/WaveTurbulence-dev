open WaveTurbulence.Represents WaveTurbulence.VineEstS4 WaveTurbulence.Flower.Stage1W WaveTurbulence.VineAlign WaveTurbulence.Stage1 WaveTurbulence.Twist WaveTurbulence.Flower.Stage1WVine
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w p : ℕ} {kind : Bool} {ι : Type*}

/-- The native chain R-SLOT along a batch carrying the marking. -/
theorem batch_spliceNTLMkLow {A B : FamilyReconstruction w ι} {xs : List ι}
    {F : MolIso A.skeleton.molecule B.skeleton.molecule} (h : BatchIso p kind xs A B F)
    (σ : Prescription A.skeleton) {Mk : Set (Fama.CLVineG γF A.skeleton)} {Mk' : Set (Fama.CLVineG γF B.skeleton)}
    (hT : Fama.Stage1Mk.MarkTransported γF F Mk Mk') (hA : Fama.VineA.IsV0Fam γF A.family σ Mk)
    (s : ReplacementSlot (Fama.stSt γF A.skeleton σ Mk).G) :
    spliceNTLMkLow B (transportPrescription F σ) Mk' (slotCast (Fama.VineA.BatchIso.splice_garden_eqMk h σ hT hA).symm s) =
      spliceNTLMkLow A σ Mk s := by
  induction h with
  | nil A =>
    obtain rfl := Fama.Stage1Mk.markTransported_refl_eq hT
    exact spliceNTL_congrMkLow A Mk (transportPrescription_refl σ) _ rfl s
  | skip _ _ ih => exact ih σ hT hA s
  | @apply xs A B i op F h ih =>
    obtain ⟨h1, h2⟩ := Fama.Stage1Mk.markTransported_split (operationMolIso op) F hT
    let τ := transportPrescription (operationMolIso op) σ
    let hB := Fama.VineA.isV0Fam_operationMk hA op h1
    let e0 := (Fama.VineA.operation_splice_garden_eqMk hA op h1).symm
    let e1 := (Fama.VineA.BatchIso.splice_garden_eqMk h τ h2 hB).symm
    calc
      _ = spliceNTLMkLow B (transportPrescription F τ) Mk' (slotCast (e0.trans e1) s) :=
        spliceNTL_congrMkLow B Mk' (transportPrescription_trans _ _ σ).symm _ _ s
      _ = spliceNTLMkLow B (transportPrescription F τ) Mk' (slotCast e1 (slotCast e0 s)) :=
        congrArg _ (slotCast_trans e0 e1 s).symm
      _ = spliceNTLMkLow op.output τ _ (slotCast e0 s) := ih τ h2 hB (slotCast e0 s)
      _ = _ := operation_spliceNTLMkLow hA op h1 s

end

