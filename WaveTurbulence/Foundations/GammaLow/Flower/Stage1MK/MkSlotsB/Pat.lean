  (a : Fama.VineA.PrescribedPrimeGarden γF w)

/-- The core branch of a non-root `G_sb` branch is not a root. -/
theorem coreOf_path_ne_nilLow {c : GBranch (stALow mkF a).G.tree} (hc : c.1.2 ≠ []) : (coreOfLow mkF a c).1.2 ≠ [] := by
  show (a.prime.data.corePosition ((stALow mkF a).M.ob c)).2 ≠ []
  unfold Reg.Skeleton.ReconstructionData.corePosition
  have h := inflatedPosition_path_ne_nil a.prime.data.tree ((stALow mkF a).M.ob c).toNode (ob_path_ne_nilLow mkF a hc)
  simp only [addrExt]
  intro h0
  exact h (List.append_eq_nil_iff.mp h0).1

end

