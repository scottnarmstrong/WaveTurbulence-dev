/-- Every outer slot at a marking is ordinary along an operation carrying the marking. -/
theorem operation_spliceNTLMkLow {A : FamilyReconstruction w ι} {i : ι} {σ : Prescription A.skeleton}
    {Mk : Set (Fama.CLVineG γF A.skeleton)} (hA : Fama.VineA.IsV0Fam γF A.family σ Mk) (op : FamilyOperation (p := p) (kind := kind) A i)
    {Mk' : Set (Fama.CLVineG γF op.output.skeleton)} (hT : Fama.Stage1Mk.MarkTransported γF (operationMolIso op) Mk Mk')
    (s : ReplacementSlot (Fama.stSt γF A.skeleton σ Mk).G) :
    spliceNTLMkLow op.output (transportPrescription (operationMolIso op) σ) Mk'
      (slotCast (Fama.VineA.operation_splice_garden_eqMk hA op hT).symm s) = spliceNTLMkLow A σ Mk s := by
  unfold spliceNTLMkLow
  rw [Fama.operation_iotaMk hA op hT]
  apply operation_stateNTL
  cases s with
  | inl q =>
    exact Fama.surviving_pair_neMk (Fama.VineA.selectedMemberSite γF hA i) σ
      ⟨Fama.VineA.familyVine γF A.family i, hA.1 i, rfl⟩ A.plain (q.firstLeaf ((Fama.stSt γF _ _ Mk).plain A.plain))
  | inr b =>
    exact fun he => Fama.VineA.active_lower_not_survivingMk (Fama.VineA.selectedMemberSite γF hA i) σ
      ⟨Fama.VineA.familyVine γF A.family i, hA.1 i, rfl⟩ ⟨b, he⟩

end

