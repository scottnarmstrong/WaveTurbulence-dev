open WaveTurbulence.Flower.MkSlots WaveTurbulence.Flower.MkSlots.IntCore WaveTurbulence.Flower.MkSlots.IntRest
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {R p : ℕ} {kind : Bool} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R))
  (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (hy : y ∈ Fama.sourceClass γF a p kind mk)
  (hG : (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.IsPlain)
  (J : Finset (Fin (2 * R)))
  (hcapA : ∀ j ∈ J, (a.prime.data.garden a.prime.prime.1).tree j = TTree.leaf)
  (hcapY : ∀ j ∈ J, (y.1.data.garden y.1.plain).tree j = TTree.leaf)
  (pat : Fin (2 * R) → FixPat) (t s : ℝ)
  (hrepUP : ∀ j, ∀ b ∈ (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).atoms,
    fixCap (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)) J pat t s
      (a.prime.data.coreBranch a.prime.prime.1 b) = none)

include hrepUP in
/-- The representative's pattern `hU` implies B3s's `hrepU`. -/
theorem hrepU_of_patLow : ∀ j, ∀ b ∈ (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).atoms,
    ¬ IsCapFlowerParent (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a)) J (a.prime.data.coreBranch a.prime.prime.1 b) :=
  fun j b hb => (preds_of_fixCap_none (hrepUP j b hb)).1


end

