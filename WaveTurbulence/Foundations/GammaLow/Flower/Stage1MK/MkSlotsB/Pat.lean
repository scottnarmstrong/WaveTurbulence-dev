/-- `val` on `G_sb` (layers of the core branches, root time `t`). -/
theorem fixOf_valLow {p : ℕ} (hG : CapGeo a.layered J p) (hpat : CapPatValid a.layered J pat p)
    (hroot : ∀ j ∉ J, ∃ ℓ : GLeaf a.layered.garden.tree, IsCapFlower a.layered J ℓ ∧ ℓ.1.1 = j)
    (hs : s ∈ Ioo (p : ℝ) t) (ht : t < p + 1) (c : GBranch (stALow mkF a).G.tree) (v : ℝ)
    (h : fixOfLow J pat t s mkF a c = some v) :
    (a.layered.layer (coreOfLow mkF a c).toNode : ℝ) < v ∧ v ≤ a.layered.layer (coreOfLow mkF a c).toNode + 1 ∧ v ≤ t :=
  fixCap_val hG hpat hroot hs ht h

end

