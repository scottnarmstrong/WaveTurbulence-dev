  (a : Fama.VineA.PrescribedPrimeGarden γF w)

/-- **Hinge clocks are free**: no hinge of `G_sb` (the upper atom of a unit) is pinned, for every pattern
(`Geo.fixCap_coreBranch_unit`). -/
theorem fixOf_hingeLow (kSel : Fin w → Option ℕ)
    (hsub : ∀ {LG : LayeredGarden w} (B : PrimeData LG), markILow J pat t s kSel B ⊆ mkF B)
    (c : GBranch (stALow mkF a).G.tree) (hc : c ∈ (stALow mkF a).hinges) : fixOfLow J pat t s mkF a c = none := by
  rw [← Fama.stShape_hingesMk, VineB.SpliceShape.mem_hinges] at hc
  obtain ⟨j, hj⟩ := hc
  have hmem : Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (classMkLow mkF a) j ∈
      Fama.unitBlocks γF a.prime.skeleton a.totalSigma (classMkLow mkF a) := List.get_mem _ _
  have hy : (stALow mkF a).M.ob c ∈
      (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (classMkLow mkF a) j).atoms := by
    rw [← shapeOf_brLow, hj]
    exact VineB.upper_mem _
  exact fixCap_coreBranch_unitLow pat t s kSel mkF hsub a hmem hy

end

