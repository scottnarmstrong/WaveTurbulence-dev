variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w : ℕ}
variable (J : Finset (Fin w)) (pat : Fin w → FixPat) (t s : ℝ) (mkF : Fama.Stage1Mk.MarkFn γF w)
  (a : Fama.VineA.PrescribedPrimeGarden γF w)

/-- **`mono` on `G_sb`, adjacent version**: a pinned child atom of a pinned atom carries a pin `≤` the parent's. -/
theorem fixOf_mono_childLow (hst : s ≤ t) {c c' : GBranch (stALow mkF a).G.tree} (hcc : c'.IsChildOf c) {v v' : ℝ}
    (h : fixOfLow J pat t s mkF a c = some v) (h' : fixOfLow J pat t s mkF a c' = some v') : v' ≤ v := by
  have hnr : c'.1.2 ≠ [] := by
    obtain ⟨-, i, hi⟩ := hcc
    rw [hi]; simp
  have hv' : v' = s := by
    rcases fixCap_value h' with hv | ⟨-, h0, -⟩
    · exact hv
    · exact absurd h0 (coreOf_path_ne_nilLow mkF a hnr)
  rcases fixCap_value h with hv | ⟨hv, -, -⟩
  · rw [hv', hv]
  · rw [hv', hv]; exact hst

end

