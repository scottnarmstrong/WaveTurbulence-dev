open WaveTurbulence.Represents WaveTurbulence.VineEstS4 WaveTurbulence.Flower.Stage1W WaveTurbulence.VineAlign WaveTurbulence.Stage1 WaveTurbulence.Twist WaveTurbulence.Flower.Stage1WVine
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w p : ℕ} {kind : Bool} {ι : Type*}

theorem spliceNTL_congrMkLow (A : FamilyReconstruction w ι) {σ τ : Prescription A.skeleton}
    (Mk : Set (Fama.CLVineG γF A.skeleton)) (h : σ = τ) {G : Garden w} (e : G = (Fama.stSt γF A.skeleton σ Mk).G)
    (e' : G = (Fama.stSt γF A.skeleton τ Mk).G) (s : ReplacementSlot G) :
    spliceNTLMkLow A σ Mk (slotCast e s) = spliceNTLMkLow A τ Mk (slotCast e' s) := by
  subst τ
  rfl

end

