/-- **Combining two kinds on the prefix.** -/
theorem prefix_genSlotOnAt_orLow {Q Q₁ Q₂ : SlotPredLow} {K₁ K₂ : ℕ → ℝ → ℝ}
    (hcov : ∀ {γV : ℝ} [Fact (γV ≤ 1 / 2)] {R : ℕ} (a : Fama.VineA.PrescribedPrimeGarden γV (2 * R)) (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat)
      (t s : ℝ) (kSel σ : Fin (2 * R) → Option ℕ) (sl : ReplacementSlot a.prime.skeleton),
      Q a J pat t s kSel σ sl → Q₁ a J pat t s kSel σ sl ∨ Q₂ a J pat t s kSel σ sl)
    (h₁ : WTPrefix (fun P => ∀ hγP : P.γ ≤ 1 / 2, haveI := Fact.mk hγP; GenSlotOnAtLow Q₁ K₁ P)) (h₂ : WTPrefix (fun P => ∀ hγP : P.γ ≤ 1 / 2, haveI := Fact.mk hγP; GenSlotOnAtLow Q₂ K₂ P)) :
    WTPrefix (fun P => ∀ hγP : P.γ ≤ 1 / 2, haveI := Fact.mk hγP; GenSlotOnAtLow Q (fun d η => max (K₁ d η) (K₂ d η)) P) :=
  prefix_guard (prefix_and h₁ h₂ (genSlotOnAt_monoLow Q₁ K₁) (genSlotOnAt_monoLow Q₂ K₂))
    fun _ hC₁ _ hL H hγ => haveI := Fact.mk hγ; genSlotOnAt_orLow hC₁ hL hcov (H.1 hγ) (H.2 hγ)

end

