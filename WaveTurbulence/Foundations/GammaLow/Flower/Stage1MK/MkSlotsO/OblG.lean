/-- The protected chain kind from its two parts. -/
theorem protChainKind_ofLow {K₁ K₂ : ℕ → ℝ → ℝ} (h₁ : WTPrefix (fun P => ∀ hγP : P.γ ≤ 1 / 2, haveI := Fact.mk hγP; GenSlotOnAtLow IsRTChainSlotLow K₁ P))
    (h₂ : WTPrefix (fun P => ∀ hγP : P.γ ≤ 1 / 2, haveI := Fact.mk hγP; GenSlotOnAtLow IsStemProtChainSlotLow K₂ P)) :
    WTPrefix (fun P => ∀ hγP : P.γ ≤ 1 / 2, haveI := Fact.mk hγP; GenSlotOnAtLow IsProtChainSlotLow (fun d η => max (K₁ d η) (K₂ d η)) P) :=
  prefix_genSlotOnAt_orLow (fun a J pat t s kSel σ sl h => protChain_splitLow a J pat t s kSel σ sl h) h₁ h₂

