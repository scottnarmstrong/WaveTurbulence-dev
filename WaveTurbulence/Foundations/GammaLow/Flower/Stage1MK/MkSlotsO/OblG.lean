/-- **The obligation from the four work kinds.** -/
theorem genSlotObligation_of_splitLow {K₁ K₂ K₃ K₄ : ℕ → ℝ → ℝ} (hK₁ : ∀ d η, 1 ≤ K₁ d η)
    (hcap : WTPrefix (fun P => ∀ hγP : P.γ ≤ 1 / 2, haveI := Fact.mk hγP; GenSlotOnAtLow IsCapSlotLow K₁ P)) (hun : WTPrefix (fun P => ∀ hγP : P.γ ≤ 1 / 2, haveI := Fact.mk hγP; GenSlotOnAtLow IsUnpinSlotLow K₂ P))
    (hpc : WTPrefix (fun P => ∀ hγP : P.γ ≤ 1 / 2, haveI := Fact.mk hγP; GenSlotOnAtLow IsProtChainSlotLow K₃ P)) (hpq : WTPrefix (fun P => ∀ hγP : P.γ ≤ 1 / 2, haveI := Fact.mk hγP; GenSlotOnAtLow IsProtCplSlotLow K₄ P)) :
    GenSlotObligationLow := by
  refine ⟨fun d η => max (max (K₁ d η) (K₂ d η)) (max (K₃ d η) (K₄ d η)),
    fun d η => (hK₁ d η).trans ((le_max_left _ _).trans (le_max_left _ _)), ?_⟩
  have h12 := prefix_genSlotOnAt_orLow (Q := fun a J pat t s kSel σ sl =>
    IsCapSlotLow a J pat t s kSel σ sl ∨ IsUnpinSlotLow a J pat t s kSel σ sl) (fun _ _ _ _ _ _ _ _ h => h) hcap hun
  have h34 := prefix_genSlotOnAt_orLow (Q := fun a J pat t s kSel σ sl =>
    IsProtChainSlotLow a J pat t s kSel σ sl ∨ IsProtCplSlotLow a J pat t s kSel σ sl) (fun _ _ _ _ _ _ _ _ h => h)
    hpc hpq
  have hall := prefix_genSlotOnAt_orLow (Q := fun _ _ _ _ _ _ _ _ => True)
    (fun a J pat t s kSel σ sl _ => slot_splitLow a J pat t s kSel σ sl) h12 h34
  exact prefix_guard hall fun P _ _ _ H hγ => haveI := Fact.mk hγ; (genSlotObligationAt_iff_onLow _ P).2 (H hγ)

end

