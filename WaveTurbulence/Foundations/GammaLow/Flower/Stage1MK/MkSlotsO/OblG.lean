/-- Large-constant monotonicity of the restricted obligation (for `prefix_and`). -/
theorem genSlotOnAt_monoLow (Q : SlotPredLow) (Kg : ℕ → ℝ → ℝ) : LargeConstantMonotone (fun P => ∀ hγP : P.γ ≤ 1 / 2, haveI := Fact.mk hγP; GenSlotOnAtLow Q Kg P) := by
  intro P c₁ c₂ _ _ _ _ h₁ _ h hγ C hC R p a J pat t s hp hcan hsz
  exact h hγ C (h₁.trans hC) (R := R) (p := p) a J pat t s hp hcan (by rw [← vineEstHalfMK_N P c₁ c₂ (p + 1)]; exact hsz)

end

