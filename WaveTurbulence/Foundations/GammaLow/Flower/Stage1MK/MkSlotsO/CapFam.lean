/-- The slot mass of a cap pair carrying a protected native node. -/
theorem genSlotMass_capLow (P : WTParams) [Fact (P.γ ≤ 1 / 2)] (C b : ℝ) {R : ℕ} (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R))
    (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat) (t s : ℝ) (kSel : Fin (2 * R) → Option ℕ)
    (Rs : Fin (2 * R) → ℝ) (q : SourcePair a.prime.skeleton) (hq : IsCapPair a.prime.skeleton a.prime.prime.1 J q)
    (hprot : HasProtNative a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)
      (protI (recLGLow a) J pat t s kSel) (.inl q)) :
    genSlotMassLow P C b a J pat t s kSel Rs (.inl q) =
      (C * Real.sqrt P.δ) ^ slotSize a.prime.data (.inl q) *
        P.L ^ (-(P.η ^ 8) * (slotIncoh a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)
          (.inl q) : ℝ)) *
        (frontierConst P.d ^ slotNr a.prime.data a.prime.prime.1 (.inl q) *
          (b⁻¹ * slotLeaf a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)
            (fun _ => b.toNNReal) (.inl q))) *
        P.L ^ genLossExp P.d *
        ∏ v ∈ MkSlotsS.selNative a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J kSel
          (.inl q), Rs v.1.1 ^ (-(1 / 18 : ℝ)) := by
  unfold genSlotMassLow genLeafLow
  simp only [hq, hprot, ↓reduceIte]

end

