/-- **A trivial cap slot.** -/
theorem capT_conclLow :
    SlotConclLow P C capKg (p := p) a J pat t s σ kSel Rs h roots Rf dag b (.inl q) x := by
  have hL1 : 1 ≤ P.L := by linarith
  have hV := norm_Vt_leLow a J s hGeo roots h Rf dag hq ht (P := P) (p := p)
  have hM := one_le_genSlotMass_trivLow hL C a J pat t s kSel Rs b hb1 hq ht
  have hK := capKcen_le_capKg P.d P.η
  have hK0 : 0 ≤ capKcen P.d := le_trans zero_le_one (one_le_capKcen P.d)
  have hmu : ENNReal.ofReal (capKcen P.d) * ‖VtLow (P := P) (p := p) (q := q) a J s roots h Rf dag‖ₑ ≤
      ENNReal.ofReal (capKg P.d P.η * genSlotMassLow P C b a J pat t s kSel Rs (.inl q)) := by
    rw [← ofReal_norm, ← ENNReal.ofReal_mul hK0]
    refine ENNReal.ofReal_le_ofReal ?_
    calc capKcen P.d * ‖VtLow (P := P) (p := p) (q := q) a J s roots h Rf dag‖ ≤ capKcen P.d * 1 :=
          mul_le_mul_of_nonneg_left hV hK0
      _ ≤ capKg P.d P.η * 1 := by linarith
      _ ≤ _ := mul_le_mul_of_nonneg_left hM (by linarith)
  have hLq : 1 ≤ P.L ^ (47 * (P.d : ℝ) + 2) := Real.one_le_rpow hL1 (by positivity)
  have hm0 : 0 ≤ genSlotMassLow P C b a J pat t s kSel Rs (.inl q) := by linarith
  have hKg0 : 0 ≤ capKg P.d P.η := le_trans zero_le_one (one_le_capKg P.d P.η)
  refine slotConcl_of_fam1Low P C capKg a J pat t s σ kSel Rs h roots Rf dag b (.inl q) x
    (fun _ => slotFam1_of_constLow P a J pat t s σ kSel Rs h roots Rf dag q x hq P.η _
      (fun ts _ => genSlotKer_trivLow a J pat t s σ kSel Rs roots h Rf dag hq ht ts) _ hmu)
    (fun _ => slotFam1_of_constLow P a J pat t s σ kSel Rs h roots Rf dag q x hq (1 / 4) _
      (fun ts _ => genSlotKer_trivLow a J pat t s σ kSel Rs roots h Rf dag hq ht ts) _ (hmu.trans ?_))
  refine ENNReal.ofReal_le_ofReal ?_
  calc capKg P.d P.η * genSlotMassLow P C b a J pat t s kSel Rs (.inl q)
      = capKg P.d P.η * 1 * genSlotMassLow P C b a J pat t s kSel Rs (.inl q) := by ring
    _ ≤ _ := by gcongr

