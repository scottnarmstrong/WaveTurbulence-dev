theorem one_le_genSlotMass_trivLow :
    1 ≤ genSlotMassLow P C b a J pat t s kSel Rs (.inl q) := by
  have hL1 : 1 ≤ P.L := by linarith
  unfold genSlotMassLow
  rw [triv_size a.prime.data q ht, triv_incoh a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) q ht,
    triv_selNative a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) q ht J kSel,
    Finset.prod_empty]
  simp only [pow_zero, Nat.cast_zero, mul_zero, Real.rpow_zero, one_mul, mul_one]
  have hcF : 1 ≤ frontierConst P.d ^ slotNr a.prime.data a.prime.prime.1 (.inl q) :=
    one_le_pow₀ (one_le_frontierConst P.d)
  have hLSb := triv_leaf a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) q ht b hb1
  have hleaf : genLeafLow a J b (.inl q) = b⁻¹ * slotLeaf a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a) (fun _ => b.toNNReal) (.inl q) := by
    unfold genLeafLow; simp only [hq, ↓reduceIte]
  rw [hleaf]
  have hLe : 1 ≤ P.L ^ (if HasProtNative a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)
      (protI (recLGLow a) J pat t s kSel) (.inl q) then genLossExp P.d else 0) := by
    split_ifs
    · exact Real.one_le_rpow hL1 (by unfold genLossExp; positivity)
    · rw [Real.rpow_zero]
  calc (1 : ℝ) = 1 * 1 * 1 := by norm_num
    _ ≤ _ := by gcongr

