    funext k'
    refine Finset.prod_congr rfl fun z _ => ?_
    have hin := IntGeo.inCapNative_nativeNodeAt a.prime.data a.prime.prime.1 J q hq z
    unfold chainW capNodeW
    simp only [show InCapNative a.prime.data a.prime.prime.1 J
      ((nativeCoupleForest a.prime.data a.prime.prime.1 q).nodeEmbedding z) from hin, ↓reduceIte]
  unfold genSlotKerLow
  dsimp only [slotFnGWFRL]
  rw [hW, CapK.genΘs_inl]
  refine (kernelNodeWR_fold P.L P.γ P.δ (nativeCoupleLayered a.prime.data a.prime.prime.1 (sourceLayerLow a)
    (sourceLayer_isLayeringLow a) q) _ _ _ (latticePoint P.L (roots (capTreeOf a.prime.skeleton a.prime.prime.1 J q)))
    _ _ _ _).trans ?_
  have hΘ : (fun k' : GNode (nativeCoupleLayered a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a) q).garden.tree → Mom P.d =>
      (∏ z, capNodeW P.L P.γ P.δ p s (recLGLow a) J Rf dag
