open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {R : ℕ} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat)
  (t s : ℝ) (p : ℕ)

/-- **A pinned clock value lies in the closed window of its clock layer.** -/
theorem clkPin_windowLow (hG : CapGeo (recLGLow a) J p) (hpat : CapPatValid (recLGLow a) J pat p)
    (hroot : ∀ j ∉ J, ∃ ℓ : GLeaf (recLGLow a).garden.tree, IsCapFlower (recLGLow a) J ℓ ∧ ℓ.1.1 = j)
    (ht : t ∈ Ioo (p : ℝ) (p + 1)) (hs : s ∈ Ioo (p : ℝ) t) (y : ClkSrc a.prime.skeleton) (v : ℝ)
    (hv : clkPin (fun _ => t) (MkSlots.fixCore a.prime.data a.prime.prime.1 (fixCap (recLGLow a) J pat t s)) y =
      some v) :
    (clkLayer p (fun b => sourceLayerLow a (a.prime.data.coreBranch a.prime.prime.1 b).toNode) y : ℝ) ≤ v ∧
      v ≤ clkLayer p (fun b => sourceLayerLow a (a.prime.data.coreBranch a.prime.prime.1 b).toNode) y + 1 := by
  rcases y with j | b
  · simp only [clkPin, Option.some.injEq] at hv
    subst hv
    exact ⟨ht.1.le, ht.2.le⟩
  · have h := MkSlotsG.fixCap_val hG hpat hroot hs ht.2 hv
    exact ⟨h.1.le, h.2.1⟩

end

