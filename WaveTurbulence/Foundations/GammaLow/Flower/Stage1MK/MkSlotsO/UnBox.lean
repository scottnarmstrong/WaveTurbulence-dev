/-- The clock layers of the slot `sl`. -/
abbrev clkLLow (sl : ReplacementSlot a.prime.skeleton) (i : Fin 2) : ℕ :=
  clkLayer p (fun b => sourceLayerLow a (a.prime.data.coreBranch a.prime.prime.1 b).toNode)
    (argSrc a.prime.prime.1 sl i)

end

