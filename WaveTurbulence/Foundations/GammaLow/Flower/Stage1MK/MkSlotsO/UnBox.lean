variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {R : ℕ} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat)
  (t s : ℝ) (p : ℕ)

/-- **On a couple slot the general box lies in `timeBox q₀ q₁`.** -/
theorem genBoxAt_cpl_subLow (hG : CapGeo (recLGLow a) J p) (hpat : CapPatValid (recLGLow a) J pat p)
    (hroot : ∀ j ∉ J, ∃ ℓ : GLeaf (recLGLow a).garden.tree, IsCapFlower (recLGLow a) J ℓ ∧ ℓ.1.1 = j)
    (ht : t ∈ Ioo (p : ℝ) (p + 1)) (hs : s ∈ Ioo (p : ℝ) t) (q : SourcePair a.prime.skeleton) :
    genBoxAtLow p a J pat t s (.inl q) ⊆ timeBox (clkLLow a p (.inl q) 0 : ℝ) (clkLLow a p (.inl q) 1) := by
  intro ts hts
  obtain ⟨hpin, hfree⟩ := hts
  by_cases hf : ∃ i : Fin 2, clkPin (fun _ => t)
      (MkSlots.fixCore a.prime.data a.prime.prime.1 (fixCap (recLGLow a) J pat t s))
      (argSrc a.prime.prime.1 (.inl q) i) = none
  · exact hfree hf
  · simp only [not_exists] at hf
    have hw : ∀ i : Fin 2, (clkLLow a p (.inl q) i : ℝ) ≤ ts i ∧ ts i ≤ clkLLow a p (.inl q) i + 1 := by
      intro i
      obtain ⟨v, hv⟩ := Option.ne_none_iff_exists'.mp (hf i)
      rw [hpin i v hv]
      exact clkPin_windowLow a J pat t s p hG hpat hroot ht hs _ v hv
    exact ⟨hw 0, hw 1⟩

end

