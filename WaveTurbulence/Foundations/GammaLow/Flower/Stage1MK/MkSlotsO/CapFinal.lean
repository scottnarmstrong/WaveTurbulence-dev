/-- **A cap slot in the configuration `CapPenFree`** (rev 5: HasSum on the `TopCutLow` box). -/
theorem capPF_conclLow (hpf : CapK.CapPenFree K (sourceLayerLow a) (sourceLayer_isLayeringLow a) pat t s) :
    SlotConclLow P C capKg (p := p) a J pat t s σ kSel Rs h roots Rf dag b (.inl q) x := by
  have hL1 : 1 ≤ P.L := by linarith
  have hq := isCapPair_of_capSide K
  have hspec := CapK.capPenFree_spec K (sourceLayerLow a) (sourceLayer_isLayeringLow a) pat t s hpf
  obtain ⟨V, hV, hVk⟩ := penFree_constLow (hD3 := hD3) (hd := hd) (hη := hη) (hηγ := hηγ) (hL := hL) (hC1 := hC1)
    (hδ := hδ) (C := C) (hC := hC) (a := a) (J := J) (pat := pat) (t := t) (s := s) (hp := hp) (hcan := hcan)
    (hsz := hsz) (hGeo := hGeo) (hpat := hpat) (hps := hps) (hst := hst) (htp := htp) (σ := σ) (kSel := kSel)
    (hplain := hplain) (Rs := Rs) (hRs := hRs) (roots := roots) (h := h) (b := b) (hb1 := hb1) (hb := hb) (Rf := Rf)
    (hRf1 := hRf1) (dag := dag) (hq := hq) (K := K) (hpf := hpf)
  have hker : ∀ ts ∈ genBoxAtLow p a J pat t s (.inl q), TopCutLow a J pat t s (.inl q) ts →
      genSlotKerLow P.L P.γ P.δ p a J pat t s σ kSel Rs h roots Rf dag (.inl q) ts
        (latticePoint P.L (roots (capTreeOf a.prime.skeleton a.prime.prime.1 J q))) = V := by
    intro ts _ hcut
    refine hVk ts ?_
    have h1 := topCut_rootPinLow a J pat t s K hGeo hpf.1 hst.le ts hcut
    rw [hspec.1] at h1
    simpa [rootPinVal] using h1
  have hm0 : 0 ≤ genSlotMassLow P C b a J pat t s kSel Rs (.inl q) :=
    genSlotMass_nonnegLow P (by linarith) hb1 (by linarith) a J pat t s kSel Rs
      (fun j => lt_of_lt_of_le (by linarith) (hRs j)) (.inl q)
  have hKg0 : 0 ≤ capKg P.d P.η := le_trans zero_le_one (one_le_capKg P.d P.η)
  have hLq : 1 ≤ P.L ^ (47 * (P.d : ℝ) + 2) := Real.one_le_rpow hL1 (by positivity)
  have hηq : ENNReal.ofReal (capKg P.d P.η * genSlotMassLow P C b a J pat t s kSel Rs (.inl q)) ≤
      ENNReal.ofReal (capKg P.d P.η * P.L ^ (47 * (P.d : ℝ) + 2) *
        genSlotMassLow P C b a J pat t s kSel Rs (.inl q)) := by
    refine ENNReal.ofReal_le_ofReal ?_
    calc capKg P.d P.η * genSlotMassLow P C b a J pat t s kSel Rs (.inl q)
        = capKg P.d P.η * 1 * genSlotMassLow P C b a J pat t s kSel Rs (.inl q) := by ring
      _ ≤ _ := by gcongr
  exact slotConcl_of_fam1CLow P C capKg a J pat t s σ kSel Rs h roots Rf dag b (.inl q) x
    (fun _ => slotFam1C_of_constLow P a J pat t s σ kSel Rs h roots Rf dag q x hq P.η V hker _ hV)
