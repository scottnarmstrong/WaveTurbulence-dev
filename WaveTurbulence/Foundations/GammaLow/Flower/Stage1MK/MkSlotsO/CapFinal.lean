/-- **`TopCutLow` at the chain's root**: on a root-pinning configuration the chain clock is at least the root pin. -/
theorem topCut_rootPinLow {R p : ℕ} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (J : Finset (Fin (2 * R)))
    (pat : Fin (2 * R) → FixPat) (t s : ℝ) {q : SourcePair a.prime.skeleton}
    (K : CapSide a.prime.data a.prime.prime.1 J q) (hGeo : CapGeo (recLGLow a) J p)
    (hroot : (CapP.cfgPat K (sourceLayerLow a) (sourceLayer_isLayeringLow a) pat).pinsRoot K.X = true) (hst : s ≤ t)
    (ts : Fin 2 → ℝ) (hts : TopCutLow a J pat t s (.inl q) ts) :
    rootPinVal (CapP.cfgPat K (sourceLayerLow a) (sourceLayer_isLayeringLow a) pat) s t ≤ ts K.j0 := by
  set Dq := K.Dq (sourceLayerLow a) (sourceLayer_isLayeringLow a)
  set r1 := CapP.rootT1 K (sourceLayerLow a) (sourceLayer_isLayeringLow a)
  have hfix := CapP.capFixPat K (sourceLayerLow a) (sourceLayer_isLayeringLow a) hGeo pat t s 0 r1
  rw [(pinsRoot_fix hroot s t 0 hst).1 r1 rfl] at hfix
  exact hts (Dq.βc r1) _ rfl hfix

end

