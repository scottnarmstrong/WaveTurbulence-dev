/-- **Without selected native vertex the general slot mass dominates the B3 slot mass.** -/
theorem genSlotMass_ge_baseLow (P : WTParams) [Fact (P.γ ≤ 1 / 2)] {C b : ℝ} (hC : 0 ≤ C) (hb : 1 ≤ b) (hL : 1 ≤ P.L) {R : ℕ}
    (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R)) (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat) (t s : ℝ)
    (kSel : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ) (sl : ReplacementSlot a.prime.skeleton)
    (hsel : MkSlotsS.selNative a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J kSel sl = ∅) :
    (C * Real.sqrt P.δ) ^ slotSize a.prime.data sl *
      P.L ^ (-(P.η ^ 8) * (slotIncoh a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)
        sl : ℝ)) * (frontierConst P.d ^ slotNr a.prime.data a.prime.prime.1 sl * genLeafLow a J b sl) ≤
      genSlotMassLow P C b a J pat t s kSel Rs sl := by
  have hL0 : 0 < P.L := lt_of_lt_of_le one_pos hL
  have hcF : 0 ≤ frontierConst P.d := le_trans zero_le_one (one_le_frontierConst P.d)
  have hleaf : 0 ≤ genLeafLow a J b sl := by
    have hsl : ∀ sl', 0 ≤ slotLeaf a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)
        (fun _ => b.toNNReal) sl' := fun sl' => by
      unfold slotLeaf
      cases sl' <;> exact Finset.prod_nonneg fun _ _ => NNReal.coe_nonneg _
    cases sl with
    | inl q =>
      simp only [genLeafLow]
      refine mul_nonneg ?_ (hsl _)
      split_ifs
      · exact inv_nonneg.2 (by linarith)
      · exact zero_le_one
    | inr β => simp only [genLeafLow]; exact hsl _
  unfold genSlotMassLow
  rw [hsel, Finset.prod_empty, mul_one]
  refine le_mul_of_one_le_right (by positivity) (Real.one_le_rpow hL ?_)
  split_ifs
  · unfold genLossExp
    have : (0 : ℝ) ≤ P.d := Nat.cast_nonneg _
    positivity
  · exact le_rfl

end

