/-- **The absorbed-selection stem chain slot family**, from D6 at `θ = η`. -/
theorem pc_d6_famLow {P : WTParams} [Fact (P.γ ≤ 1 / 2)] (hD6 : ProtAnnBoundAt P) (hη : 0 ≤ P.η)
    (hηγ : P.η ^ 8 ≤ P.gamma1 - Real.sqrt P.η) (hL : 2 ≤ P.L) (hC1 : 1 ≤ P.C₁) (hδ : 0 < P.δ) (C : ℝ)
    (hC : P.C₁ ≤ C) {R p : ℕ} (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R)) (J : Finset (Fin (2 * R)))
    (pat : Fin (2 * R) → FixPat) (t s : ℝ) (hp : p < P.D) (hcan : IsCanonGC (p + 1) (recLGLow a))
    (hsz : a.prime.data.size ≤ P.N (p + 1) ^ 4) (hG : CapGeo (recLGLow a) J p) (hpat : CapPatValid (recLGLow a) J pat p)
    (hroot : ∀ j ∉ J, ∃ ℓ : GLeaf (recLGLow a).garden.tree, IsCapFlower (recLGLow a) J ℓ ∧ ℓ.1.1 = j)
    (ht : t ∈ Ioo (p : ℝ) (p + 1)) (hs : s ∈ Ioo (p : ℝ) t)
    (kSel : Fin (2 * R) → Option ℕ) (σ : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ) (hRs : ∀ j, P.L ≤ Rs j)
    (roots : Fin (2 * R) → (Fin P.d → ℤ)) (h : ℕ → Fin (2 * R) → Fin (2 * R) → Mom P.d → ℝ) (b : ℝ) (hb1 : 1 ≤ b)
    (hb : ∀ q ≤ p, ∀ j j', SNormR (40 * P.d) (40 * P.d) (h q j j') ≤ ENNReal.ofReal b)
    (Rf : Fin (2 * R) → Option ℝ) (hRf : ∀ j r, Rf j = some r → 1 ≤ r)
    (dag : Option (Fin (2 * R) → Fin 3 → Mom P.d)) (β : GBranch a.prime.skeleton.tree) (x : Fin P.d → ℤ)
    (hne : a.prime.data.tree β ≠ .nil)
    (hcs : OnCapStem (recLGLow a) J (a.prime.data.coreBranch a.prime.prime.1 β).toNode)
    (hpn : HasProtNative a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)
      (protI (recLGLow a) J pat t s kSel) (.inr β))
    (hcfg : objCfg (recLGLow a) J pat (a.prime.data.tree β) (pcu a.prime.data β) = .none)
    (y : GNode (decodedTree (a.prime.data.tree β) (nodeSign a.prime.skeleton.sig β.1)).tree)
    (hy : ∀ β' : GBranch a.prime.skeleton.tree, chainContextNode a.prime.data a.prime.prime.1 β y ≠
      (a.prime.data.coreBranch a.prime.prime.1 β').toNode)
    (v : GBranch (recLGLow a).garden.tree) (hv : v ∈ selSetCap (recLGLow a) J kSel)
    (hvy : v.1 = (chainContextNode a.prime.data a.prime.prime.1 β y).1)
    (Kg : ℝ) (hKg : 2 * (capCsup P.d P.η).toReal ≤ Kg) :
    SlotFam1Low P (p := p) a J pat t s σ kSel Rs h roots Rf dag (.inr β) x P.η
      (ENNReal.ofReal (Kg * genSlotMassLow P C b a J pat t s kSel Rs (.inr β))) := by
  obtain ⟨bv, hbv⟩ := pc_selBranch a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) β y hy v hvy
  have hFsel := pc_Fsel_single a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) β J kSel hv hbv
  have hnFsh := pc_not_Fsh a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) β J kSel hv hbv Rs
  have hsn := pc_selNative_single a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) β J kSel hv hbv y hy hvy
  set S := pc_frontS a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) β p
  set ω := pc_ω (d := P.d) a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) β Rf
  set F := pcFσ a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) β J σ
  set Fu := pcFsh a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) β J kSel Rs
  set q' := pcqLow a β
  set j := pcj a.prime.data β
  have hL1 : 1 ≤ P.L := by linarith
  set F₆ := F.filter (· ≠ bv)
  set Fu₆ := Fu ∪ F.filter (· = bv)
  set Mu₆ : GBranch (pcNLow a β).garden.tree → ℝ := fun c => if c = bv then pcRad P.L σ j else Rs j
  set mD : (GNode (pcNLow a β).garden.tree → Mom P.d) → ℂ := fun κ => IncTop.starWeight S ω κ *
    filtWeight (F₆ ∪ {bv}) (fun c => decide (c ∈ ({bv} : Finset (GBranch (pcNLow a β).garden.tree))))
      (fun c => if c ∈ ({bv} : Finset (GBranch (pcNLow a β).garden.tree)) then Rs j else (fun _ => pcRad P.L σ j) c) κ *
    filtWeight Fu₆ (fun _ => false) Mu₆ κ * (((fun _ => (1 : ℝ)) κ : ℝ) : ℂ) with hmD
  set F' : (Fin 2 → ℝ) → Mom P.d → ℂ := fun ts k => kernelProt P.L P.γ P.δ (pcNLow a β) (pcHpLow a β (J := J) P.L h roots) mD
    (fun _ => ts 0) (ts 1) (fun _ => none) k (fun _ => 0) 0 with hF'
  have hfixN : ((objCfg (recLGLow a) J pat (a.prime.data.tree β) (pcu a.prime.data β)).fix (a.prime.data.tree β) s t 0 : GBranch (pcNLow a β).garden.tree → Option ℝ) =
      fun _ => none := by
    funext c
    rw [hcfg, pc_none_fix]
  have hker : ∀ ts k, genSlotKerLow P.L P.γ P.δ p a J pat t s σ kSel Rs h roots Rf dag (.inr β) ts k = F' ts k := by
    intro ts k
    rw [pc_kerLow a β hG hne hcs P.L P.γ P.δ pat t s σ kSel Rs h roots Rf dag ts k, hfixN]
    congr 1
    funext K
    rw [pcΘ_eq a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) β J P.L σ kSel Rs K, hFsel,
      pc_split6 K F Fu bv hnFsh (pcRad P.L σ j) (Rs j), hmD]
    push_cast
    ring
  have hm : ∀ K, ‖mD K‖ ≤ 1 * chiDNorm ^ (F₆ ∪ {bv}).card * chiDNorm ^ Fu₆.card * 1 := by
    intro K
    rw [hmD]
    simp only [norm_mul, Complex.ofReal_one, norm_one]
    refine mul_le_mul (mul_le_mul (mul_le_mul (pc_norm_starWeight_le _ _ _ _ β p Rf K)
      (pc_norm_filtWeight_le _ _ _ _) (norm_nonneg _) zero_le_one) (pc_norm_filtWeight_le _ _ _ _) (norm_nonneg _)
      (mul_nonneg zero_le_one (pow_nonneg chiDNorm_pos.le _))) le_rfl zero_le_one
      (mul_nonneg (mul_nonneg zero_le_one (pow_nonneg chiDNorm_pos.le _)) (pow_nonneg chiDNorm_pos.le _))
  have hF'c : ∀ k, Continuous fun ts => F' ts k := fun k =>
    ProtWhole.continuous_kernelProt_joint P.L P.γ P.δ (pcNLow a β) _ mD _ hm _ k
      (PL234.card_lone_le_of_decodesTree (decodedTree_decodes (a.prime.data.tree β) _))
      (ProtPin.summable_coset_piece (pc_LCLow a β hG P.L h roots hb1 hb) hL1 k)
  -- D6
  obtain ⟨n, hn2, hn1, hnN⟩ := pc_sizeLow a β hsz hne
  have hSt := pc_stemChain a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) β J hne hcs
  have hSelc : ∀ c ∈ ({bv} : Finset (GBranch (pcNLow a β).garden.tree)), c.1.1.val = 0 ∧ c.1.2 <+: (a.prime.data.tree β).lonePath ∧
      c.1.2 ≠ (a.prime.data.tree β).lonePath ∧ (false = true → c.1.2 ≠ (a.prime.data.tree β).lonePath.dropLast) := by
    intro c hc
    rw [Finset.mem_singleton] at hc
    subst hc
    have hv' : pcB a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) β c ∈ selSetCap (recLGLow a) J kSel := hbv ▸ hv
    obtain ⟨h1, h2, -⟩ := sel_on_chain hG hSt hv' (q := c.1.2) c.2 rfl
    exact ⟨Fin.val_eq_zero _, h1, h2, fun h => absurd h (by decide)⟩
  have hq'p : q' ≤ p := hG.layer_le _
  have key := hD6 p hp n hnN 1 (pcNLow a β) (a.prime.data.tree β) (pc_shapeLow a β hG hne hcs) hn2 false {bv} (fun h => absurd h (by decide)) hSelc
    (by simp) (by simp) (pc_ambLow a β hcan) (Rs j) (hRs j) s hs.1 (hs.2.trans ht.2) q' hq'p
    (fun _ z hz => pc_lone_layerLow a β z hz) S ω (fun _ => frontierConst P.d) (pc_presLow a β P.d Rf hRf) F₆
    (fun _ => pcRad P.L σ j) (fun _ _ => pcRad_ge (by linarith) σ _) Fu₆ Mu₆
    (fun c _ => by
      show P.L ≤ (if c = bv then pcRad P.L σ j else Rs j)
      split_ifs
      · exact pcRad_ge (by linarith) σ _
      · exact hRs _)
    (fun _ => 1) ⟨fun _ => ⟨zero_le_one, le_rfl⟩, fun _ _ _ => rfl⟩ (fun _ _ => rfl)
    (pcHpLow a β (J := J) P.L h roots) (fun _ => b.toNNReal) (pc_LCLow a β hG P.L h roots hb1 hb) 0 (pcC0Low P.L a roots β x)
  have hfun : (fun ts k => kernelProt P.L P.γ P.δ (pcNLow a β) (pcHpLow a β (J := J) P.L h roots)
      (fun κ => IncTop.starWeight S ω κ *
        filtWeight (F₆ ∪ {bv}) (fun c => decide (c ∈ ({bv} : Finset (GBranch (pcNLow a β).garden.tree))))
          (fun c => if c ∈ ({bv} : Finset (GBranch (pcNLow a β).garden.tree)) then Rs j else (fun _ => pcRad P.L σ j) c) κ *
        filtWeight Fu₆ (fun _ => false) Mu₆ κ * (((fun _ => (1 : ℝ)) κ : ℝ) : ℂ))
      (fun _ => ts 0) (ts 1) ((if false = true then ProtCfg.term else ProtCfg.none).fix (a.prime.data.tree β) s s (ts 0)) k
      (fun _ => 0) 0) = F' := by
    funext ts k
    rw [hF']
    congr 1
    funext c
    simp only [Bool.false_eq_true, ↓reduceIte]
    exact pc_none_fix (a.prime.data.tree β) s s (ts 0) c
  -- the mass
  have hM := pc_genSlotMass_posLow P (hC1.trans hC) hδ (by linarith) hb1 a J pat t s kSel Rs
    (fun j => lt_of_lt_of_le (by linarith) (hRs j)) β
  have hLS0 : 0 ≤ genLeafLow a J b (.inr β) := by rw [pc_genLeaf_eqLow]; exact (pc_leaf_pos _ hb1).le
  have hvj : v.1.1 = j := by rw [← hbv]; rfl
  have hRj : 0 < Rs j := lt_of_lt_of_le (by linarith) (hRs j)
  have hmass : (∏ _z ∈ S, ENNReal.ofReal (frontierConst P.d)) *
      ENNReal.ofReal (P.L ^ ((47 * P.d + 5) * ((if false = true then 1 else 0) +
        ({bv} : Finset (GBranch (pcNLow a β).garden.tree)).card : ℕ)) *
        Rs j ^ (-((({bv} : Finset (GBranch (pcNLow a β).garden.tree)).card : ℝ) / 18))) *
      regBound P n (protIncoh (a.prime.data.tree β) (pcNLow a β)) * ENNReal.ofReal (leafSizeProduct (pcNLow a β) (fun _ => b.toNNReal)) ≤
      ENNReal.ofReal (genSlotMassLow P C b a J pat t s kSel Rs (.inr β)) := by
    rw [Finset.prod_const, ← pc_genLeaf_eqLow]
    refine pc_mass_leLow P hC hC1 hδ.le hL1 hηγ a J pat t s kSel Rs (.inr β) hpn
      (pc_frontS_card_le a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) β p) hn1 hn2
      (mul_nonneg (pow_nonneg (by linarith) _) (Real.rpow_nonneg hRj.le _)) hLS0 ?_
    rw [hsn, Finset.prod_singleton, hvj]
    simp only [Bool.false_eq_true, ↓reduceIte, Finset.card_singleton, zero_add, Nat.cast_one]
    exact mul_le_mul_of_nonneg_right (pc_Lpow47 P hL1) (Real.rpow_nonneg hRj.le _)
  -- the box
  have hq'p' : (q' : ℝ) ≤ p := by exact_mod_cast hq'p
  have hbox : ∀ ts ∈ genBoxAtLow p a J pat t s (.inr β), ts ∈ pcBoxC p (p + 1) q' := fun ts hts =>
    (pc_genBoxLow a J pat t s hG hpat hroot ht hs β hne hcs ts hts).1
  refine pc_fam1Low P hη a J pat t s σ kSel Rs h roots Rf dag β x p q' hq'p' le_rfl (by linarith) _ hF'c hker
    hbox _ hM ?_ _ (ENNReal.ofReal_le_ofReal ?_)
  · rw [timeBoxGt_eq_pcBox] at key
    rw [hfun] at key
    exact key.trans hmass
  · have hM0 := hM.le
    nlinarith

end

