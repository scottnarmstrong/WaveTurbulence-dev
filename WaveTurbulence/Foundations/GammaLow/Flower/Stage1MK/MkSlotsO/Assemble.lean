theorem genSlotObligation_of_threeLow (hRT : RootTraceGate) {K₁ K₂ K₃ : ℕ → ℝ → ℝ} (hK₁ : ∀ d η, 1 ≤ K₁ d η)
    (hcap : WTPrefix (fun P => ∀ hγP : P.γ ≤ 1 / 2, haveI := Fact.mk hγP; GenSlotOnAtLow IsCapSlotLow K₁ P)) (hun : WTPrefix (fun P => ∀ hγP : P.γ ≤ 1 / 2, haveI := Fact.mk hγP; GenSlotOnAtLow IsUnpinSlotLow K₂ P))
    (hstem : WTPrefix (fun P => ∀ hγP : P.γ ≤ 1 / 2, haveI := Fact.mk hγP; GenSlotOnAtLow IsStemProtChainSlotLow K₃ P)) : GenSlotObligationLow := by
  obtain ⟨K₄, -, h₄⟩ := rtChainKindLow hRT
  obtain ⟨K₅, -, h₅⟩ := protCplKindLow hRT
  exact genSlotObligation_of_splitLow hK₁ hcap hun (protChainKind_ofLow h₄ hstem) h₅

end

