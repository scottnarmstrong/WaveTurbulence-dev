/-- **The mass comparison.** -/
theorem pc_mass_leLow (P : WTParams) [Fact (P.γ ≤ 1 / 2)] {C b : ℝ} (hC : P.C₁ ≤ C) (hC1 : 1 ≤ P.C₁) (hδ : 0 ≤ P.δ) (hL : 1 ≤ P.L)
    (hηγ : P.η ^ 8 ≤ P.gamma1 - Real.sqrt P.η) {R : ℕ} (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R))
    (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat) (t s : ℝ) (kSel : Fin (2 * R) → Option ℕ)
    (Rs : Fin (2 * R) → ℝ) (sl : ReplacementSlot a.prime.skeleton)
    (hpn : HasProtNative a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)
      (protI (recLGLow a) J pat t s kSel) sl)
    {ns n : ℕ} (hns : ns ≤ slotNr a.prime.data a.prime.prime.1 sl) (hn : 1 ≤ n)
    (hsz : slotSize a.prime.data sl = 2 * n) {Lc : ℝ} (hLc0 : 0 ≤ Lc) (hLS0 : 0 ≤ genLeafLow a J b sl)
    (hLc : Lc ≤ P.L ^ genLossExp P.d *
      ∏ v ∈ MkSlotsS.selNative a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J kSel sl,
        Rs v.1.1 ^ (-(1 / 18 : ℝ))) :
    ENNReal.ofReal (frontierConst P.d) ^ ns * ENNReal.ofReal Lc *
        regBound P n (slotIncoh a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) sl) *
        ENNReal.ofReal (genLeafLow a J b sl) ≤
      ENNReal.ofReal (genSlotMassLow P C b a J pat t s kSel Rs sl) := by
  have hcF := one_le_frontierConst P.d
  have hcF0 : 0 ≤ frontierConst P.d := le_trans zero_le_one hcF
  set g := slotIncoh a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) sl
  set Rg := P.C₁ * (P.C₁ * P.δ) ^ n * P.L ^ (-(P.gamma1 - Real.sqrt P.η) * (g : ℝ)) with hRg
  have hR0 : 0 ≤ Rg := by
    have : 0 ≤ P.C₁ := le_trans zero_le_one hC1
    positivity
  have hreg : regBound P n g = ENNReal.ofReal Rg := rfl
  rw [hreg, ← ENNReal.ofReal_pow hcF0, ← ENNReal.ofReal_mul (pow_nonneg hcF0 _),
    ← ENNReal.ofReal_mul (mul_nonneg (pow_nonneg hcF0 _) hLc0), ← ENNReal.ofReal_mul (by positivity)]
  refine ENNReal.ofReal_le_ofReal ?_
  have hR' := capRegBound_le P C hC hC1 hδ hL hηγ n g hn
  have hpow : frontierConst P.d ^ ns ≤ frontierConst P.d ^ slotNr a.prime.data a.prime.prime.1 sl :=
    pow_le_pow_right₀ hcF hns
  have hA : 0 ≤ (C * Real.sqrt P.δ) ^ (2 * n) * P.L ^ (-(P.η ^ 8) * (g : ℝ)) := by
    have : 0 ≤ C * Real.sqrt P.δ := mul_nonneg (by linarith) (Real.sqrt_nonneg _)
    positivity
  have hG0 : 0 ≤ P.L ^ genLossExp P.d *
      ∏ v ∈ MkSlotsS.selNative a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J kSel sl,
        Rs v.1.1 ^ (-(1 / 18 : ℝ)) := le_trans hLc0 hLc
  unfold genSlotMassLow
  rw [hsz]
  simp only [hpn, ↓reduceIte]
  calc frontierConst P.d ^ ns * Lc * Rg * genLeafLow a J b sl
      ≤ frontierConst P.d ^ slotNr a.prime.data a.prime.prime.1 sl *
          (P.L ^ genLossExp P.d * ∏ v ∈ MkSlotsS.selNative a.prime.data a.prime.prime.1 (sourceLayerLow a)
            (sourceLayer_isLayeringLow a) J kSel sl, Rs v.1.1 ^ (-(1 / 18 : ℝ))) *
          ((C * Real.sqrt P.δ) ^ (2 * n) * P.L ^ (-(P.η ^ 8) * (g : ℝ))) * genLeafLow a J b sl := by
        gcongr
    _ = _ := by ring

end

