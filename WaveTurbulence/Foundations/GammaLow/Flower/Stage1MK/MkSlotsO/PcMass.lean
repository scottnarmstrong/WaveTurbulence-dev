theorem pc_genLeaf_eqLow {R : ℕ} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (J : Finset (Fin (2 * R))) (b : ℝ)
    (β : GBranch a.prime.skeleton.tree) :
    genLeafLow a J b (.inr β) = leafSizeProduct
      (nativeChainLayered a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) β)
      (fun _ => b.toNNReal) :=
  (pc_leaf_eq a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) β b.toNNReal).symm

