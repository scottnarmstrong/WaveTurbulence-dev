/-- **The target, from the obligation on the STOP configuration**: with any constant `K'` for the slots
`IsCapPenFreeLow`, the cap kind holds with `max capKg K'`. -/
theorem capKind_of_penFreeLow {K' : ℕ → ℝ → ℝ} (hpf : WTPrefix (fun P => ∀ hγP : P.γ ≤ 1 / 2, haveI := Fact.mk hγP; GenSlotOnAtLow IsCapPenFreeLow K' P)) :
    ∃ K : ℕ → ℝ → ℝ, (∀ d η, 1 ≤ K d η) ∧ WTPrefix (fun P => ∀ hγP : P.γ ≤ 1 / 2, haveI := Fact.mk hγP; GenSlotOnAtLow IsCapSlotLow K P) := by
  obtain ⟨K₁, hK₁, h₁⟩ := capKind_offLow
  refine ⟨fun d η => max (K₁ d η) (K' d η), fun d η => (hK₁ d η).trans (le_max_left _ _), ?_⟩
  refine prefix_genSlotOnAt_orLow (fun a J pat t s kSel σ sl hcap => ?_) h₁ hpf
  by_cases h : IsCapPenFreeLow a J pat t s kSel σ sl
  · exact Or.inr h
  · exact Or.inl ⟨hcap, h⟩

end

