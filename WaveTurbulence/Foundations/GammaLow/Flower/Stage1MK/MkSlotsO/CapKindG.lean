      (hsz := hsz) (hGeo := hGeo) (hpat := hpat) (hps := hs.1) (hst := hs.2) (htp := ht.2) (σ := σ) (kSel := kSel)
      (hplain := hplain) (Rs := Rs) (hRs := hRs) (roots := roots) (h := h) (b := b) (hb1 := hb1) (hb := hb)
