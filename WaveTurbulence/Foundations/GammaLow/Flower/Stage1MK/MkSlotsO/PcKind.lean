/-- A protected chain slot carries a protected native node. -/
theorem pc_hasProtNativeLow
    (h : HasPinNativeLow a J pat t s kSel σ (.inr β) ∨ HasSelNatLow a J pat t s kSel σ (.inr β)) :
    HasProtNative a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)
      (protI (recLGLow a) J pat t s kSel) (.inr β) := by
  rcases h with ⟨qb, hqb⟩ | ⟨y, hy, v, hv, hvy⟩
  · refine ⟨GBranch.toNode (tree := (decodedTree (a.prime.data.tree β) (nodeSign a.prime.skeleton.sig β.1)).tree) qb,
      fun β' he => ?_, (pcB a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) β qb).toNode,
      ?_, rfl⟩
    · exact pc_lone_not_branch _ _ (sourceLayerLow a) (sourceLayer_isLayeringLow a) β qb
        ((pc_chain_core_iff _ _ (sourceLayerLow a) (sourceLayer_isLayeringLow a) β _).mp ⟨β', he⟩)
    · refine Finset.mem_filter.2 ⟨Finset.mem_univ _, _, ⟨rfl, Or.inl rfl⟩, Or.inr ⟨_, rfl, Or.inl hqb⟩⟩
  · exact ⟨y, hy, v.toNode, Finset.mem_filter.2 ⟨Finset.mem_univ _, _, ⟨rfl, Or.inl rfl⟩, Or.inr ⟨v, rfl, Or.inr hv⟩⟩,
      hvy⟩

