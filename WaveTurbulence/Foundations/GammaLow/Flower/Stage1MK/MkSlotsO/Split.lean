def IsProtChainSlotLow : SlotPredLow := fun a J pat t s kSel σ sl =>
  (∃ β, sl = .inr β) ∧ (HasPinNativeLow a J pat t s kSel σ sl ∨ HasSelNatLow a J pat t s kSel σ sl)

