def IsStemProtChainSlotLow : SlotPredLow := fun a J pat t s kSel σ sl =>
  IsProtChainSlotLow a J pat t s kSel σ sl ∧ ¬ IsRTChainSlotLow a J pat t s kSel σ sl

end

