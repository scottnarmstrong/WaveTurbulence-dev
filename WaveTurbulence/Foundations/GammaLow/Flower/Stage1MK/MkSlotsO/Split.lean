variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]

/-- The protected chain slots split into root traces and stem-protected ones. -/
theorem protChain_splitLow {R : ℕ} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (J : Finset (Fin (2 * R)))
    (pat : Fin (2 * R) → FixPat) (t s : ℝ) (kSel σ : Fin (2 * R) → Option ℕ) (sl : ReplacementSlot a.prime.skeleton)
    (h : IsProtChainSlotLow a J pat t s kSel σ sl) :
    IsRTChainSlotLow a J pat t s kSel σ sl ∨ IsStemProtChainSlotLow a J pat t s kSel σ sl := by
  by_cases hr : IsRTChainSlotLow a J pat t s kSel σ sl
  · exact Or.inl hr
  · exact Or.inr ⟨h, hr⟩

end

