def HasSelNatLow : SlotPredLow := fun a J _ _ _ kSel _ sl =>
  MkSlotsS.HasSelNative a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J kSel sl

