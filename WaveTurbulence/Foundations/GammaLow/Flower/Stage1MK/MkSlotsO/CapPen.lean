  have h1 := CapK.capSel_plain K (sourceLayerLow a) (sourceLayer_isLayeringLow a) pat kSel hplain v1 hv1
  rw [(CapK.capPenFree_spec K (sourceLayerLow a) (sourceLayer_isLayeringLow a) pat t s hpf).2.1] at h1
  cases h1

