/-- On the STOP configuration there is no selected branch on the paired tree (the pattern is `dParent`). -/
theorem penFree_noSelLow (hpf : CapK.CapPenFree K (sourceLayerLow a) (sourceLayer_isLayeringLow a) pat t s) :
    CapK.capSelT K (sourceLayerLow a) (sourceLayer_isLayeringLow a) kSel = ∅ := by
