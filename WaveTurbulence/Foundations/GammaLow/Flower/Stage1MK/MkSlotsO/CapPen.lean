/-- **The STOP configuration on the cut box**: on `genBoxAtLow ∩ {s ≤ ts j0}` the general slot kernel is a constant
obeying the slot mass bound (so the one-mode family of `slotFam1_of_constLow` works there, at every moment weight). -/
theorem penFree_constLow (hpf : CapK.CapPenFree K (sourceLayerLow a) (sourceLayer_isLayeringLow a) pat t s) :
    ∃ V : ℂ, ENNReal.ofReal (capKcen P.d) * ‖V‖ₑ ≤
        ENNReal.ofReal (capKg P.d P.η * genSlotMassLow P C b a J pat t s kSel Rs (.inl q)) ∧
      ∀ ts : Fin 2 → ℝ, s ≤ ts K.j0 →
        genSlotKerLow P.L P.γ P.δ p a J pat t s σ kSel Rs h roots Rf dag (.inl q) ts
          (latticePoint P.L (roots (capTreeOf a.prime.skeleton a.prime.prime.1 J q))) = V := by
  have hspec := CapK.capPenFree_spec K (sourceLayerLow a) (sourceLayer_isLayeringLow a) pat t s hpf
  obtain ⟨V, hV, hVk⟩ := constNLow (hD3 := hD3) (hd := hd) (hη := hη) (hηγ := hηγ) (hL := hL) (hC1 := hC1)
    (hδ := hδ) (C := C) (hC := hC) (a := a) (J := J) (pat := pat) (t := t) (s := s) (hp := hp) (hcan := hcan)
    (hsz := hsz) (hGeo := hGeo) (hpat := hpat) (hps := hps) (hst := hst) (htp := htp) (σ := σ) (kSel := kSel)
    (Rs := Rs) (hRs := hRs) (roots := roots) (h := h) (b := b) (hb1 := hb1) (hb := hb) (Rf := Rf) (hRf1 := hRf1)
    (dag := dag) (hq := hq) (K := K)
    (hSel := penFree_noSelLow (a := a) (J := J) (pat := pat) (t := t) (s := s) (kSel := kSel) (hplain := hplain) (K := K) hpf)
    (hroot := hpf.1)
  refine ⟨V, hV, fun ts hts => hVk ts ?_⟩
  rw [hspec.1]
  unfold rootPinVal
  simpa using hts

end

