variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {R : ℕ} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (β : GBranch a.prime.skeleton.tree)
variable {J : Finset (Fin (2 * R))} {p : ℕ}

/-- **The general slot kernel of a stem chain slot** (pins of `objCfg`, multiplier `starWeight · pcΘ`). -/
theorem pc_kerLow {d : ℕ} (hG : CapGeo (recLGLow a) J p) (hne : a.prime.data.tree β ≠ .nil)
    (hcs : OnCapStem (recLGLow a) J (a.prime.data.coreBranch a.prime.prime.1 β).toNode)
    (L γ δ : ℝ) (pat : Fin (2 * R) → FixPat) (t s : ℝ) (σ kSel : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ)
    (h : ℕ → Fin (2 * R) → Fin (2 * R) → Mom d → ℝ) (roots : Fin (2 * R) → (Fin d → ℤ))
    (Rf : Fin (2 * R) → Option ℝ) (dag : Option (Fin (2 * R) → Fin 3 → Mom d)) (ts : Fin 2 → ℝ) (k : Mom d) :
    genSlotKerLow L γ δ p a J pat t s σ kSel Rs h roots Rf dag (.inr β) ts k =
      kernelProt L γ δ (pcNLow a β) (pcHpLow a β (J := J) L h roots)
        (fun K => IncTop.starWeight (pc_frontS a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)
            β p) (pc_ω a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) β Rf) K *
          pcΘ a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) β J L σ kSel Rs K)
        (fun _ => ts 0) (ts 1)
        ((objCfg (recLGLow a) J pat (a.prime.data.tree β) (pcu a.prime.data β)).fix (a.prime.data.tree β) s t 0)
        k (fun _ => 0) 0 := by
  set D := a.prime.data
  set hS := a.prime.prime.1
  have hSt := pc_stemChain D hS (sourceLayerLow a) (sourceLayer_isLayeringLow a) β J hne hcs
  unfold genSlotKerLow
  rw [pc_slotFn_eq_kernelProt D hS (sourceLayerLow a) (sourceLayer_isLayeringLow a) β L γ δ _ _ _ _
    (pcΘ D hS (sourceLayerLow a) (sourceLayer_isLayeringLow a) β J L σ kSel Rs) ts k (fun κ => rfl)
    (pc_hlp D hS (sourceLayerLow a) (sourceLayer_isLayeringLow a) β J hG hne hSt pat t s)]
  have hfix : fixNative D hS (fixCap (recLGLow a) J pat t s) (.inr β) =
      (objCfg (recLGLow a) J pat (D.tree β) (pcu D β)).fix (D.tree β) s t 0 :=
    funext fun b => pc_fixN D hS (sourceLayerLow a) (sourceLayer_isLayeringLow a) β J hG hSt pat t s 0 b
  rw [hfix]
  congr 1
  funext K
  congr 1
  refine (Finset.prod_congr rfl fun z _ => ?_).trans
    (pc_fw_prod D hS (sourceLayerLow a) (sourceLayer_isLayeringLow a) β p Rf K)
  exact IntGeo.chainW_eq_fwNode D hS (sourceLayerLow a) (sourceLayer_isLayeringLow a) J hG.cap_leaf L γ δ p s Rf dag _ _
    (IntGeo.not_inCapNative_of_slot D hS J (.inr β) (fun q h => by cases h) z)

end

