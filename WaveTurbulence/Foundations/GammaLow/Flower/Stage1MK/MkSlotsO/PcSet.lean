theorem pc_LCLow {d : ℕ} (hG : CapGeo (recLGLow a) J p) (L : ℝ) (h : ℕ → Fin (2 * R) → Fin (2 * R) → Mom d → ℝ)
    (roots : Fin (2 * R) → (Fin d → ℤ)) {b : ℝ} (hb1 : 1 ≤ b)
    (hb : ∀ q ≤ p, ∀ j j', SNormR (40 * d) (40 * d) (h q j j') ≤ ENNReal.ofReal b) :
    LeafwiseControlled (pcNLow a β) (pcHpLow a β (J := J) L h roots) (fun _ => b.toNNReal) := by
  intro ℓ _
  have e : pcHpLow a β (J := J) L h roots ℓ.1 =
