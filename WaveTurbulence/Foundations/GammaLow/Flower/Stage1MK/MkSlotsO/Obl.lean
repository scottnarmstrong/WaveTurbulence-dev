variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]

/-- The slot mass is nonnegative (`C ≥ 0`, `δ ≥ 0`, `L > 0`, `b ≥ 1`, `Rs > 0`). -/
theorem genSlotMass_nonnegLow (P : WTParams) [Fact (P.γ ≤ 1 / 2)] {C b : ℝ} (hC : 0 ≤ C) (hb : 1 ≤ b) (hL : 0 < P.L) {R : ℕ}
    (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R)) (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat) (t s : ℝ)
    (kSel : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ) (hRs : ∀ j, 0 < Rs j)
    (sl : ReplacementSlot a.prime.skeleton) : 0 ≤ genSlotMassLow P C b a J pat t s kSel Rs sl := by
  have hcF : 0 ≤ frontierConst P.d := le_trans zero_le_one (one_le_frontierConst P.d)
  have hleaf : 0 ≤ genLeafLow a J b sl := by
    have hsl : ∀ sl', 0 ≤ slotLeaf a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)
        (fun _ => b.toNNReal) sl' := fun sl' => by
      unfold slotLeaf
      cases sl' <;> exact Finset.prod_nonneg fun _ _ => NNReal.coe_nonneg _
    cases sl with
    | inl q =>
      simp only [genLeafLow]
      refine mul_nonneg ?_ (hsl _)
      split_ifs
      · exact inv_nonneg.2 (by linarith)
      · exact zero_le_one
    | inr β => simp only [genLeafLow]; exact hsl _
  unfold genSlotMassLow
  refine mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg (pow_nonneg (mul_nonneg hC (Real.sqrt_nonneg _)) _)
    (Real.rpow_nonneg hL.le _)) (mul_nonneg (pow_nonneg hcF _) hleaf)) (Real.rpow_nonneg hL.le _))
    (Finset.prod_nonneg fun v _ => Real.rpow_nonneg (hRs _).le _)

end

