/-- **The conclusion from one family at the slot's weight**: `θ = η` off `SelAdj`, `θ = 1/4` with the loss
`L^{47d+2}` on `SelAdj` (SlotObl rev 4). -/
theorem slotConcl_of_fam1Low (P : WTParams) [Fact (P.γ ≤ 1 / 2)] (C : ℝ) (Kg : ℕ → ℝ → ℝ) {R p : ℕ} (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R))
    (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat) (t s : ℝ) (σ kSel : Fin (2 * R) → Option ℕ)
    (Rs : Fin (2 * R) → ℝ) (h : ℕ → Fin (2 * R) → Fin (2 * R) → Mom P.d → ℝ) (roots : Fin (2 * R) → (Fin P.d → ℤ))
    (Rf : Fin (2 * R) → Option ℝ) (dag : Option (Fin (2 * R) → Fin 3 → Mom P.d)) (b : ℝ)
    (sl : ReplacementSlot a.prime.skeleton) (x : Fin P.d → ℤ)
    (hη : ¬ SelAdj a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J kSel sl →
      SlotFam1Low P (p := p) a J pat t s σ kSel Rs h roots Rf dag sl x P.η
        (ENNReal.ofReal (Kg P.d P.η * genSlotMassLow P C b a J pat t s kSel Rs sl)))
    (hq : SelAdj a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J kSel sl →
      SlotFam1Low P (p := p) a J pat t s σ kSel Rs h roots Rf dag sl x (1 / 4)
        (ENNReal.ofReal (Kg P.d P.η * P.L ^ (47 * (P.d : ℝ) + 2) * genSlotMassLow P C b a J pat t s kSel Rs sl))) :
    SlotConclLow P C Kg (p := p) a J pat t s σ kSel Rs h roots Rf dag b sl x :=
  slotConcl_of_fam1CLow P C Kg a J pat t s σ kSel Rs h roots Rf dag b sl x (fun hs => (hη hs).toC)
    (fun hs => (hq hs).toC)

end

