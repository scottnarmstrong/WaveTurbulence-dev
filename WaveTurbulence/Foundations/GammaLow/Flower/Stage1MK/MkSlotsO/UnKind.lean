/-- **The unpinned kind at one parameter record.** -/
theorem genSlotOnAt_unpin_ofLow {P : WTParams} [Fact (P.γ ≤ 1 / 2)] (hI : ProtDefs.FiltIncoherentDecayAt P)
    (hC : ProtDefs.FiltCoherentBoundAt P) (hd : 1 ≤ P.d) (hL : 2 ≤ P.L) (hη0 : 0 ≤ P.η) (hη4 : P.η ≤ 1 / 4)
    (hc1 : 1 ≤ P.C₁) (hδ : 0 ≤ P.δ) (hκ : P.η ^ 8 ≤ P.gamma1 - Real.sqrt P.η) :
    GenSlotOnAtLow IsUnpinSlotLow Kunp P := by
  intro C hCC R p a J pat t s hp hcan hsz hJ hgeo hpat hirr ht hs kSel hkSel σ Rs hRs mkF hfine hclean roots h b
    hb hh Rf hRf hRf' dag s' sl hsl hQ x
  obtain ⟨hncap, hpin, hselN⟩ := hQ
  have hL0 : 0 < P.L := by linarith
  have hL1 : 1 ≤ P.L := by linarith
  have hM0 : 0 ≤ genSlotMassLow P C b a J pat t s kSel Rs sl :=
    genSlotMass_nonnegLow P (by linarith) hb hL0 a J pat t s kSel Rs (fun j => lt_of_lt_of_le hL0 (hRs j)) sl
  have hfam : ∀ {θ c : ℝ}, ThetaC P θ c →
      SlotFam1Low P (p := p) a J pat t s σ kSel Rs h roots Rf dag sl x θ
        (ENNReal.ofReal (Kun P.d θ * P.L ^ c * genSlotMassLow P C b a J pat t s kSel Rs sl)) := by
    intro θ c hθ
    cases sl with
    | inl q =>
      exact unSlot_cplLow hI hC hd hL hη0 hη4 hc1 hδ hκ hθ C hCC a J pat t s hp hcan hsz hJ hgeo hpat hirr ht hs σ kSel
        Rs roots h b hb hh Rf hRf dag q (fun hq => hncap ⟨q, rfl, hq⟩) hpin hselN x
    | inr β =>
      exact unSlot_chainLow hI hC hd hL hη0 hη4 hc1 hδ hκ hθ C hCC a J pat t s hp hcan hsz hJ hgeo hpat hirr ht hs σ kSel
        Rs hRs roots h b hb hh Rf hRf dag β hpin hselN x
  refine slotConcl_of_fam1Low P C Kunp (p := p) a J pat t s σ kSel Rs h roots Rf dag b sl x (fun _ => ?_) (fun _ => ?_)
  · refine slotFam1_monoLow P (hfam (Or.inl ⟨rfl, rfl⟩)) (ENNReal.ofReal_le_ofReal ?_)
    rw [Real.rpow_zero, mul_one]
    exact mul_le_mul_of_nonneg_right ((le_max_left _ _).trans (le_max_right _ _)) hM0
  · refine slotFam1_monoLow P (hfam (Or.inr ⟨rfl, rfl⟩)) (ENNReal.ofReal_le_ofReal ?_)
    have hK : Kun P.d (1 / 4) ≤ Kunp P.d P.η := (le_max_right _ _).trans (le_max_right _ _)
    have hpow : P.L ^ (4 * (P.d : ℝ)) ≤ P.L ^ (47 * (P.d : ℝ) + 2) := by
      refine Real.rpow_le_rpow_of_exponent_le hL1 ?_
      have : (0 : ℝ) ≤ P.d := Nat.cast_nonneg _
      linarith
    have hK0 : 0 ≤ Kun P.d (1 / 4) := Kun_nonneg _ _
    have hpow0 : 0 ≤ P.L ^ (4 * (P.d : ℝ)) := Real.rpow_nonneg hL0.le _
    calc Kun P.d (1 / 4) * P.L ^ (4 * (P.d : ℝ)) * genSlotMassLow P C b a J pat t s kSel Rs sl
        ≤ Kunp P.d P.η * P.L ^ (47 * (P.d : ℝ) + 2) * genSlotMassLow P C b a J pat t s kSel Rs sl := by
          gcongr
          exact le_trans zero_le_one (one_le_Kunp _ _)

end

