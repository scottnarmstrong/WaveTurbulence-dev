    (hLayer : IsLayering (D.garden hG) layer)
    (hq : W.q = Famb.VineEstS2.assemblyTimeQΓ hM9 B (fun v => layer (D.coreBranch hG v).toNode))
    (hok : Famb.VineEstS3.ConstraintsOKΓ hM9 B W) (base : Mom d) (m : (GNode G.tree → Fin d → ℤ) → ℂ) (lam : ℝ)
    (β : Fin 4 → (Fin d → ℤ)) (hβ : ((G.sign a.toNode : ℤ) • (β 0 - β 1)) = β 2 - β 3) (t : Fin 3 → ℝ)
    (hp : (b.child R.positive).1.2 ∈ (G.tree (b.child R.positive).1.1).branching ∨
      t 1 ≤ Famb.VineEstS2.assemblyTimeQΓ hM9 B (fun v => layer (D.coreBranch hG v).toNode)
        (.inl ⟨⟨0, Famb.VineEstS2.assemblyShape_I_posΓ hM9 B⟩, 0⟩))
    (hn : (b.child R.negative).1.2 ∈ (G.tree (b.child R.negative).1.1).branching ∨
      t 2 ≤ Famb.VineEstS2.assemblyTimeQΓ hM9 B (fun v => layer (D.coreBranch hG v).toNode)
        (.inl ⟨⟨0, Famb.VineEstS2.assemblyShape_I_posΓ hM9 B⟩, 0⟩)) :
    recPhase (G.sign a.toNode) L γ δ (t 0) (base + latticePoint L (β 0)) (base + latticePoint L (β 1))
        (base + latticePoint L (β 2)) (base + latticePoint L (β 3)) *
      clLocalKernelFW pw g D hG R L γ δ F layer hLayer base m (modW lam) (t 0) (t 1) (t 2)
        (base + latticePoint L (β 0)) (base + latticePoint L (β 1))
        (base + latticePoint L (β 2)) (base + latticePoint L (β 3)) =
    (coupling d L γ δ : ℂ) ^ clLocalOrder1 R * clLocalZeta R *
      ∑' x : (Famb.VineEstS2.assemblyShapeΓ hM9 B).VIdx → (Fin d → ℤ),
        (clRegionalEpsilon G U (clExtendIndices R ((Famb.VineEstS2.clNormalizedChainEquivΓ hL B base β hβ hM9).symm x).1) : ℂ) *
        m (clExtendIndices R ((Famb.VineEstS2.clNormalizedChainEquivΓ hL B base β hβ hM9).symm x).1) *
        ∫ τ in (Famb.VineEstS2.sourceSumintDatumΓ hM9 B hG W).timeDom (Famb.VineEstS2.assemblyShape_I_posΓ hM9 B) (t 0) (t 1) (t 2),
          Complex.exp (((Real.pi * lam * τ (.inl ⟨⟨0, Famb.VineEstS2.assemblyShape_I_posΓ hM9 B⟩, 0⟩) : ℝ) : ℂ) * Complex.I) *
          (signedPhase (Famb.VineEstS2.sourceSumintDatumΓ hM9 B hG W)
              (Famb.VineEstS2.assemblyCoreFirstSignΓ hM9 B) (Famb.VineEstS2.assemblyCoreSignΓ hM9 B) L γ (2 * δ) η x
