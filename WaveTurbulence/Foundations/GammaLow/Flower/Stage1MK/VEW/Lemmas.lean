theorem assemblyClockedFW_inr_incohLow (hq : W.q = Famb.VineEstS2.assemblyTimeQΓ hM9 B (fun v => layer (RD.coreBranch hG v).toNode))
    (hqo : W.qOut 0 = layer (RD.coreBranch hG a).toNode) (v : (Famb.VineEstS2.assemblyShapeΓ hM9 B).VIdx)
    (hc : treeIncoh RD hG layer hLayer (Famb.VineEstS2.assemblyBranchOfΓ hM9 B v).1 ≠ 0) :
    (assemblyClockedFWLow hM9 B RD hG W pw g L γ δ F layer hLayer).W (Sum.inr v) =
      fun ts k => treeLeavesTop L γ δ pw g (Famb.VineEstS3.rowQΓ hM9 B RD hG W L γ δ F layer hLayer (Sum.inr v)).1
        (Famb.VineEstS3.rowTreeLGΓ hM9 B RD hG layer hLayer v) (layerProfiles (Famb.VineEstS3.rowTreeLGΓ hM9 B RD hG layer hLayer v) F)
        (ts 0) (ts 1) k := by
  have e0 := treeRootParent_rowQΓ hM9 B RD hG layer hLayer W hq hqo L γ δ F pw v
  funext c k
  show treeRowFW pw g RD hG L γ δ F layer hLayer (Famb.VineEstS2.assemblyBranchOfΓ hM9 B v).1 (c 0) (c 1) k = _
  unfold treeRowFW
  rw [if_neg hc, e0]
  rfl

end

