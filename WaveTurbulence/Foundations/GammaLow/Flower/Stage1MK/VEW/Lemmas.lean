    (hn : (b.child R.negative).1.2 ∈ (G.tree (b.child R.negative).1.1).branching ∨
      tt 2 ≤ Famb.VineEstS2.assemblyTimeQΓ hM9 B (fun v => layer (RD.coreBranch hG v).toNode)
