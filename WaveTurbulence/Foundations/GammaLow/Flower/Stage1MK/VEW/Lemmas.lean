    fun κ τ => m (clExtendIndices R κ.1) * (modW lam (clLocalClock R t τ b) * H κ τ) with hHm
  have hs : (∑' κ, ∫ τ, Hm κ τ) =
      ∑' x, ∫ τ, Hm ((Famb.VineEstS2.clNormalizedChainEquivΓ hL B base β hβ hM9).symm x) τ :=
    ((Famb.VineEstS2.clNormalizedChainEquivΓ hL B base β hβ hM9).symm.tsum_eq (fun κ => ∫ τ, Hm κ τ)).symm
  refine congrArg (fun z : ℂ => (coupling d L γ δ : ℂ) ^ clLocalOrder1 R * clLocalZeta R * z) (hs.trans ?_)
  refine tsum_congr fun x => ?_
  rw [Famb.VineEstS2.assemblyClock_integralΓ hM9 B (Hm ((Famb.VineEstS2.clNormalizedChainEquivΓ hL B base β hβ hM9).symm x))]
  have hpt : ∀ τ : (Famb.VineEstS2.assemblyShapeΓ hM9 B).TVar → ℝ,
      Hm ((Famb.VineEstS2.clNormalizedChainEquivΓ hL B base β hβ hM9).symm x) (Famb.VineEstS2.assemblyClockEquivΓ hM9 B τ) =
        ((clRegionalEpsilon G U (clExtendIndices R ((Famb.VineEstS2.clNormalizedChainEquivΓ hL B base β hβ hM9).symm x).1) : ℂ) *
          m (clExtendIndices R ((Famb.VineEstS2.clNormalizedChainEquivΓ hL B base β hβ hM9).symm x).1)) *
        ((Famb.VineEstS2.assemblyClockEquivΓ hM9 B ⁻¹' clLocalTimeDomain R (fun v => layer (D.coreBranch hG v).toNode) t).indicator
          (fun τ => Complex.exp (((Real.pi * lam * τ (.inl ⟨⟨0, Famb.VineEstS2.assemblyShape_I_posΓ hM9 B⟩, 0⟩) : ℝ) : ℂ) *
              Complex.I) *
            (signedPhase (Famb.VineEstS2.sourceSumintDatumΓ hM9 B hG W)
              (Famb.VineEstS2.assemblyCoreFirstSignΓ hM9 B) (Famb.VineEstS2.assemblyCoreSignΓ hM9 B) L γ (2 * δ) η x
              (sumintBoundary (G.sign a.toNode) (fun j => base + latticePoint L (β j)) 0 -
                sumintBoundary (G.sign a.toNode) (fun j => base + latticePoint L (β j)) 1) (t 0) τ *
            ∏ v, (assemblyWKFWLow hM9 B pw g D hG L γ δ F layer hLayer t (Famb.VineEstS2.assemblyClockEquivΓ hM9 B τ) v
                ((Famb.VineEstS2.sourceSumintDatumΓ hM9 B hG W).kVec L x
                  (sumintBoundary (G.sign a.toNode) (fun j => base + latticePoint L (β j))) v) *
              assemblyWLFWLow hM9 B pw g D hG L γ δ F layer hLayer t (Famb.VineEstS2.assemblyClockEquivΓ hM9 B τ) v
                ((Famb.VineEstS2.sourceSumintDatumΓ hM9 B hG W).ℓVec L x
                  (sumintBoundary (G.sign a.toNode) (fun j => base + latticePoint L (β j))) v)))) τ) := by
    intro τ
    have hs := clLocalRecenteredSummandFW_sumintLow hM9 B pw g D hG W hpar hbad hL γ δ η F layer hLayer base β hβ x t τ
    have hbclock : clLocalClock R t (Famb.VineEstS2.assemblyClockEquivΓ hM9 B τ) b =
        τ (.inl ⟨⟨0, Famb.VineEstS2.assemblyShape_I_posΓ hM9 B⟩, 0⟩) := by
      have := Famb.VineEstS2.clLocalClock_slotΓ hM9 B t τ (.inl ⟨⟨0, Famb.VineEstS2.assemblyShape_I_posΓ hM9 B⟩, 0⟩)
      rwa [Famb.VineEstS2.assemblyClockAtom_firstΓ hM9 B (Famb.VineEstS2.assemblyShape_I_posΓ hM9 B)] at this
    simp only [hHm]
    change m (clExtendIndices R ((Famb.VineEstS2.clNormalizedChainEquivΓ hL B base β hβ hM9).symm x).1) *
        (modW lam (clLocalClock R t (Famb.VineEstS2.assemblyClockEquivΓ hM9 B τ) b) *
          clLocalRecenteredSummandFW pw g D hG R L γ δ F layer hLayer base (fun j => base + latticePoint L (β j)) t _
            (Famb.VineEstS2.assemblyClockEquivΓ hM9 B τ)) = _
