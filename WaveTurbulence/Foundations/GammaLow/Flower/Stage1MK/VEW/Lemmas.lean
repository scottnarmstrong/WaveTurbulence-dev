theorem clLocalStarProductFW_eq_weightsLow (hM9 : Famb.NormalChartSupply γF) (B : Famb.VineEstS2.CLChainAssemblyΓ γF G R n) (pw : ℕ) (g : Mom d → ℂ)
    (D : ReconstructionData G) (hG : G.IsPlain) (L γ δ : ℝ) (F : ℕ → Mom d → ℝ)
    (layer : GNode (D.forest hG) → ℕ) (hLayer : IsLayering (D.garden hG) layer) (base : Mom d)
    (κ : GNode G.tree → (Fin d → ℤ)) (t : Fin 3 → ℝ) (τ : CLInternalTime R) :
    clLocalStarProductFW pw g D hG R L γ δ F layer hLayer base κ t τ =
      ∏ v : (Famb.VineEstS2.assemblyShapeΓ hM9 B).VIdx,
        (assemblyWKFWLow hM9 B pw g D hG L γ δ F layer hLayer t τ v
            (cosetDecoration G L base κ ((Famb.VineEstS2.assemblyPairOfΓ hM9 B hG v).1.firstLeaf hG).toNode) *
          assemblyWLFWLow hM9 B pw g D hG L γ δ F layer hLayer t τ v
            (cosetDecoration G L base κ (Famb.VineEstS2.assemblyBranchOfΓ hM9 B v).1.toNode)) := by
  rw [Finset.prod_mul_distrib]
  simp only [clLocalStarProductFW]
  refine congrArg₂ (· * ·) ?_ ?_
  · rw [← Finset.prod_coe_sort]
    exact (Equiv.prod_comp ((Famb.VineEstS2.assemblyRowEquivΓ hM9 B).symm.trans (Famb.VineEstS3.assemblyPairOrderΓ hG B hM9).symm)
      (fun p : ↥(clRegionalPairs hG U) => coupleRowFW pw g D hG L γ δ F layer hLayer p.1
        (parentClock (t 0) (clLocalClock R t τ) (p.1.firstLeaf hG).toNode)
        (parentClock (t 0) (clLocalClock R t τ) (p.1.secondLeaf hG).toNode)
        (cosetDecoration G L base κ (p.1.firstLeaf hG).toNode))).symm
  · rw [← Finset.prod_coe_sort]
    exact (Equiv.prod_comp ((Famb.VineEstS2.assemblyRowEquivΓ hM9 B).symm.trans (Famb.VineEstS3.assemblyIntOrderΓ hM9 B).e.symm)
      (fun z : ↥(clInteriorBranches R) => treeRowFW pw g D hG L γ δ F layer hLayer z.1
        (parentClock (t 0) (clLocalClock R t τ) z.1.toNode) (clLocalClock R t τ z.1)
        (cosetDecoration G L base κ z.1.toNode))).symm

end

