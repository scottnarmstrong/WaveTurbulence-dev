/-- One summand of the recentered weighted kernel in `sumint` form (copy of `Famb.VineEstS2.clLocalRecenteredSummand_sumintΓ`). -/
theorem clLocalRecenteredSummandFW_sumintLow (hM9 : Famb.NormalChartSupply γF) (B : Famb.VineEstS2.CLChainAssemblyΓ γF G R n) (pw : ℕ) (g : Mom d → ℂ)
    (D : ReconstructionData G) (hG : G.IsPlain) (W : SumintWeightClockData (Famb.VineEstS2.assemblyShapeΓ hM9 B) d)
    (hpar : ∀ v, W.param v = 0) (hbad : ∀ i, W.badKind i ≠ 2)
    {L : ℝ} (hL : L ≠ 0) (γ δ η : ℝ) (F : ℕ → Mom d → ℝ) (layer : GNode (D.forest hG) → ℕ)
    (hLayer : IsLayering (D.garden hG) layer) (base : Mom d) (β : Fin 4 → (Fin d → ℤ))
    (hβ : ((G.sign a.toNode : ℤ) • (β 0 - β 1)) = β 2 - β 3)
    (x : (Famb.VineEstS2.assemblyShapeΓ hM9 B).VIdx → (Fin d → ℤ)) (t : Fin 3 → ℝ)
    (τ : (Famb.VineEstS2.assemblyShapeΓ hM9 B).TVar → ℝ) :
    clLocalRecenteredSummandFW pw g D hG R L γ δ F layer hLayer base (fun j => base + latticePoint L (β j)) t
        ((Famb.VineEstS2.clNormalizedChainEquivΓ hL B base β hβ hM9).symm x) (Famb.VineEstS2.assemblyClockEquivΓ hM9 B τ) =
      (clRegionalEpsilon G U (clExtendIndices R ((Famb.VineEstS2.clNormalizedChainEquivΓ hL B base β hβ hM9).symm x).1) : ℂ) *
        ((Famb.VineEstS2.assemblyClockEquivΓ hM9 B ⁻¹' clLocalTimeDomain R
            (fun v => layer (D.coreBranch hG v).toNode) t).indicator
          (fun τ => signedPhase (Famb.VineEstS2.sourceSumintDatumΓ hM9 B hG W)
              (Famb.VineEstS2.assemblyCoreFirstSignΓ hM9 B) (Famb.VineEstS2.assemblyCoreSignΓ hM9 B) L γ (2 * δ) η x
              (sumintBoundary (G.sign a.toNode) (fun j => base + latticePoint L (β j)) 0 -
                sumintBoundary (G.sign a.toNode) (fun j => base + latticePoint L (β j)) 1) (t 0) τ *
            ∏ v, (assemblyWKFWLow hM9 B pw g D hG L γ δ F layer hLayer t (Famb.VineEstS2.assemblyClockEquivΓ hM9 B τ) v
                ((Famb.VineEstS2.sourceSumintDatumΓ hM9 B hG W).kVec L x
                  (sumintBoundary (G.sign a.toNode) (fun j => base + latticePoint L (β j))) v) *
              assemblyWLFWLow hM9 B pw g D hG L γ δ F layer hLayer t (Famb.VineEstS2.assemblyClockEquivΓ hM9 B τ) v
                ((Famb.VineEstS2.sourceSumintDatumΓ hM9 B hG W).ℓVec L x
                  (sumintBoundary (G.sign a.toNode) (fun j => base + latticePoint L (β j))) v))) τ) := by
  unfold clLocalRecenteredSummandFW
  congr 1
  by_cases h : Famb.VineEstS2.assemblyClockEquivΓ hM9 B τ ∈ clLocalTimeDomain R
      (fun v => layer (D.coreBranch hG v).toNode) t
  · have h' : τ ∈ Famb.VineEstS2.assemblyClockEquivΓ hM9 B ⁻¹' clLocalTimeDomain R
        (fun v => layer (D.coreBranch hG v).toNode) t := h
    rw [Set.indicator_of_mem h, Set.indicator_of_mem h']
    rw [sumintBoundary_gap_physical (L := L) (G.sign a.toNode) base β hβ,
      ← Famb.VineEstS2.assembly_regionalPhase_eq_signedPhaseΓ hM9 B hG W hpar hbad hL base β hβ γ δ η x t τ,
      clLocalStarProductFW_eq_weightsLow hM9 B pw g D hG L γ δ F layer hLayer base]
    refine congrArg (HMul.hMul _) (Finset.prod_congr rfl (fun v _ => ?_))
    rw [← Famb.VineEstS2.assembly_pair_momentumΓ hM9 B hG W hL base β hβ x v,
      ← Famb.VineEstS2.assembly_branch_momentumΓ hM9 B hG W hL base β hβ x v]
  · have h' : τ ∉ Famb.VineEstS2.assemblyClockEquivΓ hM9 B ⁻¹' clLocalTimeDomain R
        (fun v => layer (D.coreBranch hG v).toNode) t := h
    rw [Set.indicator_of_notMem h, Set.indicator_of_notMem h']

end

