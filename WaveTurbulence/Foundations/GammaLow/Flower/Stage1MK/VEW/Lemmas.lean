open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w d : ℕ} {G : Garden w} {U : Finset (GBranch G.tree)} {a b : GBranch G.tree}

/-- **Product of two output-dependent engine pullbacks** (masses multiply). -/
theorem enginePullbackOut_mul₂Low (R : CLRegionData G U a b) (L : ℝ) (base : Mom d)
    {m₁ m₂ : (GNode G.tree → Fin d → ℤ) → ℂ} {mass₁ mass₂ : ℝ}
    (h₁ : EnginePullbackOutΓ (γF := γF) R L base m₁ mass₁) (h₂ : EnginePullbackOutΓ (γF := γF) R L base m₂ mass₂) :
    EnginePullbackOutΓ (γF := γF) R L base (fun z => m₁ z * m₂ z) (mass₁ * mass₂) := by
  intro n hM9 B hL
  obtain ⟨N₁, hN₁, he₁⟩ := h₁ n hM9 B hL
  obtain ⟨N₂, hN₂, he₂⟩ := h₂ n hM9 B hL
  refine ⟨outMul N₁ N₂, ?_, ?_⟩
  · rw [outMul_mass]
    exact mul_le_mul hN₁ hN₂ N₂.mass_nonneg (N₁.mass_nonneg.trans hN₁)
  · intro β hβ x
    beta_reduce
    rw [outMul_val, he₁ β hβ x, he₂ β hβ x]

end

