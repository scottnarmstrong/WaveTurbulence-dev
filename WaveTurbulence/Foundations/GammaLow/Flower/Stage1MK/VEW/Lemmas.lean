/-- The integrand of `clockedExpr` for `assemblyClockedFWLow` is the integrand of the weighted endpoint. -/
theorem clockedIntegrand_assemblyFWLow (hM9 : Famb.NormalChartSupply γF) (B : Famb.VineEstS2.CLChainAssemblyΓ γF G R n) (RD : ReconstructionData G)
    (hG : G.IsPlain) (W : SumintWeightClockData (Famb.VineEstS2.assemblyShapeΓ hM9 B) d) (pw : ℕ) (g : Mom d → ℂ) (L γ δ : ℝ)
    (F : ℕ → Mom d → ℝ) (layer : GNode (RD.forest hG) → ℕ) (hLayer : IsLayering (RD.garden hG) layer)
    (cfs cs : Fin (Famb.VineEstS2.assemblyShapeΓ hM9 B).I → ℤˣ) (γ' δ' η : ℝ) (x : (Famb.VineEstS2.assemblyShapeΓ hM9 B).VIdx → (Fin d → ℤ))
    (E : Fin 4 → Mom d) (t : Fin 3 → ℝ) (τ : (Famb.VineEstS2.assemblyShapeΓ hM9 B).TVar → ℝ) :
    clockedIntegrand (assemblyClockedFWLow hM9 B RD hG W pw g L γ δ F layer hLayer) cfs cs L γ' δ' η x E t τ =
      signedPhase (Famb.VineEstS2.sourceSumintDatumΓ hM9 B hG W) cfs cs L γ' δ' η x (E 0 - E 1) (t 0) τ *
        ∏ v, (assemblyWKFWLow hM9 B pw g RD hG L γ δ F layer hLayer t (Famb.VineEstS2.assemblyClockEquivΓ hM9 B τ) v
            ((Famb.VineEstS2.sourceSumintDatumΓ hM9 B hG W).kVec L x E v) *
          assemblyWLFWLow hM9 B pw g RD hG L γ δ F layer hLayer t (Famb.VineEstS2.assemblyClockEquivΓ hM9 B τ) v
            ((Famb.VineEstS2.sourceSumintDatumΓ hM9 B hG W).ℓVec L x E v)) := by
  unfold clockedIntegrand
  congr 1
  rw [Fintype.prod_sum_type, ← Finset.prod_mul_distrib]
  refine Finset.prod_congr rfl fun v _ => ?_
  have hp := pairLeaf_ne (a := a) hG (Famb.VineEstS2.assemblyPairOfΓ hM9 B hG v)
  have h1 := Famb.VineEstS3.nodeSlot_specΓ hM9 B _ (clRegionalPair_realization hG _ (Famb.VineEstS2.assemblyPairOfΓ hM9 B hG v).2).1 hp.1 t τ
  have h2 := Famb.VineEstS3.nodeSlot_specΓ hM9 B _ (clRegionalPair_realization hG _ (Famb.VineEstS2.assemblyPairOfΓ hM9 B hG v).2).2 hp.2 t τ
  have hbr := (branch_mem_clRealizationNodes (Famb.VineEstS2.assemblyBranchOfΓ hM9 B v).1).mpr
    (Finset.mem_erase.mp (Famb.VineEstS2.assemblyBranchOfΓ hM9 B v).2).2
  have h3 := Famb.VineEstS3.nodeSlot_specΓ hM9 B _ hbr (interior_ne (Famb.VineEstS2.assemblyBranchOfΓ hM9 B v)) t τ
  have h4 := Famb.VineEstS3.branchSlot_specΓ hM9 B (Famb.VineEstS2.assemblyBranchOfΓ hM9 B v) t τ
  simp only [ClockedRows.clock, assemblyClockedFWLow, Famb.VineEstS3.assemblyClockedΓ, rowMom, Sum.elim_inl, Sum.elim_inr, slotVal]
  unfold assemblyWKFWLow assemblyWLFWLow
  simp only [h1, h2, h3, h4, if_true, Fin.isValue]
  rfl

end

