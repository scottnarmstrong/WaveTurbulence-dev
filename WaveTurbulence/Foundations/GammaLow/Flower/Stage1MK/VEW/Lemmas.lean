def assemblyClockedFWLow (hM9 : Famb.NormalChartSupply γF) (B : Famb.VineEstS2.CLChainAssemblyΓ γF G R n) (RD : ReconstructionData G)
    (hG : G.IsPlain) (W : SumintWeightClockData (Famb.VineEstS2.assemblyShapeΓ hM9 B) d) (pw : ℕ) (g : Mom d → ℂ) (L γ δ : ℝ)
    (F : ℕ → Mom d → ℝ) (layer : GNode (RD.forest hG) → ℕ) (hLayer : IsLayering (RD.garden hG) layer) :
    ClockedRows (Famb.VineEstS2.sourceSumintDatumΓ hM9 B hG W) where
  W := fun ρ c k => match ρ with
    | Sum.inl v => coupleRowFW pw g RD hG L γ δ F layer hLayer (Famb.VineEstS2.assemblyPairOfΓ hM9 B hG v).1 (c 0) (c 1) k
    | Sum.inr v => treeRowFW pw g RD hG L γ δ F layer hLayer (Famb.VineEstS2.assemblyBranchOfΓ hM9 B v).1 (c 0) (c 1) k
  slot := (Famb.VineEstS3.assemblyClockedΓ hM9 B RD hG W L γ δ F layer hLayer).slot

