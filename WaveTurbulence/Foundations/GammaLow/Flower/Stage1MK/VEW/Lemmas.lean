        (W.wBar + latticePoint L (β 2)) (W.wBar + latticePoint L (β 3)) =
      (coupling d L γ δ : ℂ) ^ clLocalOrder1 R * clLocalZeta R *
        clockedExprEpsMX (fun v : ↥U => Famb.VineEstS3.childLabelΓ hM9 B hG v.1 0) (fun v : ↥U => Famb.VineEstS3.childLabelΓ hM9 B hG v.1 1)
          (fun v : ↥U => Famb.VineEstS3.childLabelΓ hM9 B hG v.1 2) (assemblyClockedFWLow hM9 B RD hG W pw g L γ δ F layer hLayer)
          (Famb.VineEstS2.assemblyCoreFirstSignΓ hM9 B) (Famb.VineEstS2.assemblyCoreSignΓ hM9 B) (Famb.VineEstS2.assemblyShape_I_posΓ hM9 B) L γ (2 * δ) η
          (fun x => m (clExtendIndices R ((Famb.VineEstS2.clNormalizedChainEquivΓ hL B W.wBar β hβ hM9).symm x).1))
          (fun (_ : Fin 3 → ℝ) (τ : (Famb.VineEstS2.sourceSumintDatumΓ hM9 B hG W).S.TVar → ℝ) =>
            Complex.exp (((Real.pi * lam * τ (.inl ⟨⟨0, Famb.VineEstS2.assemblyShape_I_posΓ hM9 B⟩, 0⟩) : ℝ) : ℂ) * Complex.I)) tt
          (sumintBoundary (G.sign a.toNode) (fun j => W.wBar + latticePoint L (β j))) := by
  rw [vineChainFW_eq_sumintForm'Low hM9 B pw g RD hG W hpar hbad hL γ δ η F layer hLayer hq hok W.wBar m lam β hβ tt
    hp hn]
  unfold clockedExprEpsMX
  congr 1
  refine tsum_congr fun x => ?_
  rw [Famb.VineEstS3.clRegionalEpsilon_eq_epsOfΓ hM9 B hG W hL W.wBar β hβ x]
  congr 1
  refine integral_congr_ae (Filter.Eventually.of_forall fun τ => ?_)
  beta_reduce
  congr 1
  exact (clockedIntegrand_assemblyFWLow hM9 B RD hG W pw g L γ δ F layer hLayer _ _ γ (2 * δ) η x _ tt τ).symm

