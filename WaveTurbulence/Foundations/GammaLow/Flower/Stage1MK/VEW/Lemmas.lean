theorem kernelFW_eq_clockedExprEpsMXLow (hM9 : Famb.NormalChartSupply γF) (B : Famb.VineEstS2.CLChainAssemblyΓ γF G R n) (pw : ℕ) (g : Mom d → ℂ)
    (RD : ReconstructionData G) (hG : G.IsPlain) (W : SumintWeightClockData (Famb.VineEstS2.assemblyShapeΓ hM9 B) d)
    (hpar : ∀ v, W.param v = 0) (hbad : ∀ i, W.badKind i ≠ 2)
    {L : ℝ} (hL : L ≠ 0) (γ δ η lam : ℝ) (F : ℕ → Mom d → ℝ) (layer : GNode (RD.forest hG) → ℕ)
    (hLayer : IsLayering (RD.garden hG) layer)
