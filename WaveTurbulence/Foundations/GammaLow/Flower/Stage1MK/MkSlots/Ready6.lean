variable {R : ℕ} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R))

theorem norm_capConstOLow {d : ℕ} (J : Finset (Fin (2 * R))) (L γ δ s : ℝ) (roots : Fin (2 * R) → (Fin d → ℤ))
    (dag : Option (Fin (2 * R) → Fin 3 → Mom d)) : ‖capConstOLow a mk J L γ δ s roots dag‖ = 1 := by
  cases dag with
  | none => simp [capConstOLow]
  | some cc => exact norm_capConstGLow a mk J L γ δ s roots cc

