open WaveTurbulence.Flower.MkDefs WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden
open WaveTurbulence.RedSplice WaveTurbulence.VineB WaveTurbulence.VineC WaveTurbulence.Flower.MkUnits
open WaveTurbulence.Represents WaveTurbulence.VineEstS4 WaveTurbulence.Flower.Stage1W WaveTurbulence.VineAlign WaveTurbulence.Stage1 WaveTurbulence.Twist WaveTurbulence.Flower.Stage1WVine
open WaveTurbulence.Flower.Stage1MKGate (CleanPt)
open WaveTurbulence.Flower.MkDefs (IsCapFlowerParent)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {R p : ℕ} {kind : Bool} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R))
  (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (hy : y ∈ Fama.sourceClass γF a p kind mk)
  (J : Finset (Fin (2 * R)))
  (hcapA : ∀ j ∈ J, (a.prime.data.garden a.prime.prime.1).tree j = TTree.leaf)
  (hcapY : ∀ j ∈ J, (y.1.data.garden y.1.plain).tree j = TTree.leaf)
variable (hG : (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.IsPlain)
  (hrepU : ∀ j, ∀ b ∈ (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).atoms,
    ¬ IsCapFlowerParent (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a)) J (a.prime.data.coreBranch a.prime.prime.1 b))

include hG hcapA hcapY hrepU in
/-- **The stem test at a `G_sb` atom is common to the run class.** -/
theorem stemB_member_iffLow (c : GBranch (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.tree) :
    StemB y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) J
        (coreLG y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) ((memShapeLow a mk y hy).br c)) ↔
      StemB a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J
        (coreLG a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)
          ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).br c)) := by
  rw [stemB_core_iff, stemB_core_iff,
    onStem_core_iff (memShapeLow a mk y hy) y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) hcapY,
    onStem_core_iff (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)) a.prime.data
      a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) hcapA]
  have hc := member_cfp_iffLow a mk y hy hG J hcapA hcapY hrepU c
  exact and_congr Iff.rfl (not_congr hc)

include hG hcapA hcapY hrepU in

end

section
open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkSlotsT
open scoped Classical
open WaveTurbulence WaveTurbulence.LGSpine WaveTurbulence.Induct Finset TTree
open WaveTurbulence.Reg WaveTurbulence.Reg.Skeleton WaveTurbulence.RegRed WaveTurbulence.LFTwist
open WaveTurbulence.Flower.MkDefs WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden
open WaveTurbulence.RedSplice WaveTurbulence.VineB WaveTurbulence.VineC WaveTurbulence.Flower.MkUnits
open WaveTurbulence.Represents WaveTurbulence.VineEstS4 WaveTurbulence.Flower.Stage1W WaveTurbulence.VineAlign WaveTurbulence.Stage1 WaveTurbulence.Twist WaveTurbulence.Flower.Stage1WVine
open WaveTurbulence.Flower.Stage1MKGate (CleanPt)
open WaveTurbulence.Flower.MkDefs (IsCapFlowerParent)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {R p : ℕ} {kind : Bool} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R))
  (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (hy : y ∈ Fama.sourceClass γF a p kind mk)
  (J : Finset (Fin (2 * R)))
  (hcapA : ∀ j ∈ J, (a.prime.data.garden a.prime.prime.1).tree j = TTree.leaf)
  (hcapY : ∀ j ∈ J, (y.1.data.garden y.1.plain).tree j = TTree.leaf)
variable (hG : (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.IsPlain)
  (hrepU : ∀ j, ∀ b ∈ (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).atoms,
    ¬ IsCapFlowerParent (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a)) J (a.prime.data.coreBranch a.prime.prime.1 b))

include hy hG hcapA hcapY hrepU in
/-- **The unit radius lists (T2) are common to the run class** (tree-indexed radii). -/
theorem SUStem_member_eqLow (radT : Fin (2 * R) → List ℝ)
    (j : Fin (Fama.unitBlocks γF a.prime.skeleton a.totalSigma (mk a.prime)).length) :
    SUStem y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) J (fun b => radT b.1.1)
        (blk := fun j => unitClBlock (y.2 j)) j =
      SUStem a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J (fun b => radT b.1.1)
        (blk := Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)) j := by
  set Φ₁ := Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)
  set hd₁ := Fama.unitBlkMk_disj (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)
  set c := Φ₁.hinge hd₁ j
  have hh : (memShapeLow a mk y hy).hinge (Fama.source_disjMk a mk y hy) j = c :=
    hinge_eq_of_hmom Φ₁ (memShapeLow a mk y hy) hd₁ (Fama.source_disjMk a mk y hy)
      (fun j i => congrFun (congrFun (memShape_hmomLow a mk y hy) j) i) j
  have hu₂ : (unitClBlock (y.2 j)).upper = (memShapeLow a mk y hy).br c := by
    rw [← hh, (memShapeLow a mk y hy).br_hinge]
  have hu₁ : (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).upper = Φ₁.br c :=
    (Φ₁.br_hinge hd₁ j).symm
  have hs := stemB_member_iffLow a mk y hy J hcapA hcapY hG hrepU c
  have ht₁ : (coreLG y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)
      ((memShapeLow a mk y hy).br c)).1.1 = c.1.1 :=
    (MkSlots.IntRest.coreBranch_fst y.1.data y.1.plain _).trans (shape_br_fst (memShapeLow a mk y hy) c)
  have ht₂ : (coreLG a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) (Φ₁.br c)).1.1 =
      c.1.1 :=
    (MkSlots.IntRest.coreBranch_fst a.prime.data a.prime.prime.1 _).trans (shape_br_fst Φ₁ c)
  unfold SUStem
  rw [hu₂, hu₁]
  by_cases h1 : StemB y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) J
      (coreLG y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) ((memShapeLow a mk y hy).br c))
  · rw [if_pos h1, if_pos (hs.mp h1)]
    simp only [ht₁, ht₂]
  · rw [if_neg h1, if_neg (fun h => h1 (hs.mpr h))]

end

