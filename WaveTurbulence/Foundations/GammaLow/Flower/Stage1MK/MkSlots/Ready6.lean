variable {R p : ℕ} {kind : Bool} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R))
  (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (hy : y ∈ Fama.sourceClass γF a p kind mk)
  (hG : (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.IsPlain)
  (J : Finset (Fin (2 * R)))
  (hcapA : ∀ j ∈ J, (a.prime.data.garden a.prime.prime.1).tree j = TTree.leaf)
  (hcapY : ∀ j ∈ J, (y.1.data.garden y.1.plain).tree j = TTree.leaf)
  (hrepU : ∀ j, ∀ b ∈ (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).atoms,
    ¬ IsCapFlowerParent (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a)) J (a.prime.data.coreBranch a.prime.prime.1 b))

include hG hcapA hcapY hrepU in
/-- **The dagger sibling indicator of the piece on a member's decoration** is the indicator of `RestInd`. -/
theorem member_sibIndLow {d : ℕ}
    (hGeoY : CapGeo (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J p)
    (L : ℝ) (cc : Fin (2 * R) → Fin 3 → Mom d) {roots : Fin (2 * R) → (Fin d → ℤ)}
    (κ : GenDecoration y.1.skeleton d roots 0) :
    sibIndAtLow J a (mk a.prime) (some cc) (flwAtLow J a (mk a.prime))
        (cosetDecoration (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G L 0
          ((memShapeLow a mk y hy).resDec y.1.plain (Fama.source_disjMk a mk y hy) κ).1) =
      if RestInd y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) L J cc κ then 1 else 0 := by
  have hP := prod_ind_eq (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G
    (fun c => IsCapFlowerParent a.layered J (coreAtLow a (mk a.prime) c)) (flwAtLow J a (mk a.prime))
    (cosetDecoration (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G L 0
      ((memShapeLow a mk y hy).resDec y.1.plain (Fama.source_disjMk a mk y hy) κ).1) cc
  unfold sibIndAtLow
  refine hP.trans ?_
  congr 1
  rw [restInd_shape (memShapeLow a mk y hy) y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) J hGeoY
    L cc (Fama.source_disjMk a mk y hy) (member_hrangeLow a mk y hy hG J hcapA hcapY hrepU)
    (member_hnhLow a mk y hy hG J hcapA hcapY hrepU) κ]
  refine propext (forall_congr' fun c => ?_)
  rw [member_cfp_iffLow a mk y hy hG J hcapA hcapY hrepU c, cfp_coreAt_iffLow a mk J c]
  rfl

end

