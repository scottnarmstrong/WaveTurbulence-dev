open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkSlotsT
open scoped Classical
open WaveTurbulence WaveTurbulence.LGSpine WaveTurbulence.Induct Finset TTree
open WaveTurbulence.Reg WaveTurbulence.Reg.Skeleton WaveTurbulence.RegRed WaveTurbulence.LFTwist
open WaveTurbulence.Flower.MkDefs WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden
open WaveTurbulence.RedSplice WaveTurbulence.VineB WaveTurbulence.VineC WaveTurbulence.Flower.MkUnits
open WaveTurbulence.Represents WaveTurbulence.VineEstS4 WaveTurbulence.Flower.Stage1W WaveTurbulence.VineAlign WaveTurbulence.Stage1 WaveTurbulence.Twist WaveTurbulence.Flower.Stage1WVine
open WaveTurbulence.Flower.Stage1MKGate (CleanPt)
open WaveTurbulence.Flower.MkDefs (IsCapFlowerParent)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {R p : ℕ} {kind : Bool} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R))
  (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (hy : y ∈ Fama.sourceClass γF a p kind mk)
  (J : Finset (Fin (2 * R)))
  (hcapA : ∀ j ∈ J, (a.prime.data.garden a.prime.prime.1).tree j = TTree.leaf)
  (hcapY : ∀ j ∈ J, (y.1.data.garden y.1.plain).tree j = TTree.leaf)

include hcapA hcapY in
/-- **T1 at every member of the run class**: the classification `kindOf` of the member's reconstruction through its
shape `memShapeLow a mk y hy` onto the representative's `G_sb`. -/
theorem kindMember_specLow (hc : CleanPtLow J a) {z : GNode (y.1.data.forest y.1.plain)}
    (hz : OnStemAddr (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J z.1) :
    (∀ c : GBranch (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.tree,
      (kindOf y.1.data y.1.plain (memShapeLow a mk y hy) z = StemKind.atom c) ↔
        (z = (y.1.data.coreBranch y.1.plain ((memShapeLow a mk y hy).br c)).toNode ∧
          c ∉ (memShapeLow a mk y hy).hinges (Fama.source_disjMk a mk y hy))) ∧
    (∀ j, (kindOf y.1.data y.1.plain (memShapeLow a mk y hy) z = StemKind.top j) ↔
      z = (y.1.data.coreBranch y.1.plain (unitClBlock (y.2 j)).upper).toNode) ∧
    (∀ s : ReplacementSlot y.1.skeleton, (kindOf y.1.data y.1.plain (memShapeLow a mk y hy) z = StemKind.slot s) ↔
      (MkSlots.slotOf y.1.data y.1.plain z = s ∧
        ∀ β : GBranch y.1.skeleton.tree, z ≠ (y.1.data.coreBranch y.1.plain β).toNode)) ∧
    SlotRet y.1.plain (blk := fun j => unitClBlock (y.2 j)) (MkSlots.slotOf y.1.data y.1.plain z) :=
  kindOf_spec y.1.data y.1.plain (memShapeLow a mk y hy) (Fama.source_disjMk a mk y hy)
    (stemRet_memberLow a mk y hy J hcapA hcapY hc) hz

end

