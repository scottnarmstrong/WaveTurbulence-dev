/-- **The top bridge**: B4's hypothesis `MarkedClassRepresentsMKLow cP cθ P` from the analytic core `ClassRepGenLow cP P`,
for `1 ≤ L` and `cθ ≥ cθGen`, with the data `prot = protOfLow`, `fix = fixOfLow`, `filt = filtGenLow`, `ind = indGenLow`,
`lb = lbGenLow`, `selR = selRGenLow` at the representative. -/
theorem markedClassRepresentsMK_of_repGenLow {cP cθ : ℝ} {P : WTParams} [Fact (P.γ ≤ 1 / 2)] (hL : 1 ≤ P.L) (hθ : cθGen ≤ cθ)
    (hrep : ClassRepGenLow cP P) : MarkedClassRepresentsMKLow cP cθ P := by
  intro p hp R h1 h2 N hN1 hN2 J hJ pat kSel t ht s hs A hA hpl hTC roots hh b Rf σ Rs dag hb hsn hRf hRs hhigh
    mkF hmk π hπ
  obtain ⟨hrep1, hrep2⟩ := hrep p hp R h1 h2 N hN1 hN2 J hJ pat kSel t ht s hs A hA hpl hTC roots hh b Rf σ Rs dag
    hb hsn hRf hRs hhigh mkF hmk π hπ
  have hmem := hA _ (Fama.Represents.repPt_layered_memMk π)
  refine ⟨protOfLow J pat t s kSel mkF (Fama.Represents.repPt P.γ π), fixOfLow J pat t s mkF (Fama.Represents.repPt P.γ π), filtGenLow J P.L σ kSel Rs mkF (Fama.Represents.repPt P.γ π),
    indGenLow J P.L σ kSel mkF (Fama.Represents.repPt P.γ π) dag, lbGenLow J pat t s mkF (Fama.Represents.repPt P.γ π), selRGenLow J kSel mkF (Fama.Represents.repPt P.γ π), ?_⟩
  exact ⟨hrep1,
    pieceRestGenLow P J pat t s kSel σ Rs mkF (Fama.Represents.repPt P.γ π) dag hJ p hmem.2.2.2.2.1 hmem.2.2.2.2.2 hmem.2.2.1 hs ht.2
      hmk.sub hL hRs cθ hθ,
    selSpecGenLow P J pat t s kSel σ Rs mkF (Fama.Represents.repPt P.γ π) dag hpl,
    classPiece_sel_injLow J kSel mkF (Fama.Represents.repPt P.γ π),
    selCardGenLow P J pat t s kSel σ Rs mkF (Fama.Represents.repPt P.γ π) dag,
    hrep2,
    selLbGenLow P J pat t s kSel σ Rs mkF (Fama.Represents.repPt P.γ π) dag hpl⟩

end

