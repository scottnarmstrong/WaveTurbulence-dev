/-- **`sel_spec`** for the general piece (plain patterns on the selected trees). -/
theorem selSpecGenLow (hplain : ∀ j, (kSel j).isSome → pat j = FixPat.plain) :
    ∀ v ∈ selRGenLow J kSel mkF a, (kSel v.1.1).isSome ∧ (pieceGenLow P J pat t s kSel σ Rs mkF a dag).fix v = none ∧
      ∃ ψ : SchwartzMap ℝ ℂ, (pieceGenLow P J pat t s kSel σ Rs mkF a dag).filt v = some (Rs v.1.1, ψ) ∧
        ∀ u, ψ u = (chiDN u : ℂ) :=
