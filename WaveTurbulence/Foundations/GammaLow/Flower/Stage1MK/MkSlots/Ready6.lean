/-- **`ClassPieceOKLow.sel_spec`** for the residual selected atoms. -/
theorem classPiece_sel_specLow (hplain : ∀ j, (kSel j).isSome → pat j = FixPat.plain)
    (hfilt : ∀ c ∈ selROfLow J kSel mkF a, filt c = some (Rs c.1.1, chiDNS)) :
    ∀ v ∈ selROfLow J kSel mkF a, (kSel v.1.1).isSome ∧
      (classPieceLow P mkF a prot (protI a.layered J pat t s kSel).card (fixOfLow J pat t s mkF a) filt ind
        lb).fix v = none ∧
      ∃ ψ : SchwartzMap ℝ ℂ,
        (classPieceLow P mkF a prot (protI a.layered J pat t s kSel).card (fixOfLow J pat t s mkF a) filt ind
        lb).filt v =
          some (Rs v.1.1, ψ) ∧ ∀ u, ψ u = (chiDN u : ℂ) :=
  fun v hv => ⟨selROf_kSelLow hv, selROf_fixOfLow hplain hv, chiDNS, hfilt v hv, chiDNS_apply⟩

