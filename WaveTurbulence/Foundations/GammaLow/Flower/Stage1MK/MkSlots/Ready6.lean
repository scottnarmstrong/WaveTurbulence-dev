variable (P : WTParams) [Fact (P.γ ≤ 1 / 2)] {R : ℕ} (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat) (t s : ℝ)
  (kSel σ : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ) (mkF : Fama.Stage1Mk.MarkFn P.γ (2 * R))
  (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R)) (dag : Option (Fin (2 * R) → Fin 3 → Mom P.d))

/-- **`filt_ok`** for the general piece. -/
theorem filtGen_okLow (hsub : ∀ {LG : LayeredGarden (2 * R)} (B : PrimeData LG), markILow J pat t s kSel B ⊆ mkF B)
    (hL : 1 ≤ P.L) (hRs : ∀ j, P.L ≤ Rs j) (cθ : ℝ) (hθ : cθGen ≤ cθ) :
    ∀ c q, (pieceGenLow P J pat t s kSel σ Rs mkF a dag).filt c = some q →
      c ∉ (pieceGenLow P J pat t s kSel σ Rs mkF a dag).Cs.hinges ∧ 1 ≤ q.1 ∧ (∀ u, ‖q.2 u‖ ≤ 1) ∧
        filterB ⇑q.2 ≤ cθ := by
  intro c q hq
  rw [pieceGen_filtLow] at hq
  by_cases hc : c ∈ selRGenLow J kSel mkF a
  · rw [filtGen_selLow hc] at hq
    obtain rfl := Option.some.inj hq
    exact classPiece_selFilt_okLow P J pat t s kSel mkF a (protOfLow J pat t s kSel mkF a)
      (filtGenLow J P.L σ kSel Rs mkF a) (indGenLow J P.L σ kSel mkF a dag) (lbGenLow J pat t s mkF a) Rs hsub hL hRs cθ
      (filterB_chiDNS_le_cθGen.trans hθ) hc
  · rw [filtGen_not_selLow hc] at hq
    have hok := MkSlotsT.filtStem_ok _ _ _ _ _ _ _ _ _ c q hq
    have hh : c ∉ (stALow mkF a).hinges := by
      rw [← shapeRep_hingesLow]
      exact hok.1
    refine ⟨hh, hok.2.1, hok.2.2, ?_⟩
    unfold MkSlotsT.filtStem at hq
    split_ifs at hq
    exact (filterB_filtOfRad_le _ _ (radGen_length_le _ _ _ _ _ _ _) q hq).trans (twoLayerB_le_cθGen.trans hθ)

end

