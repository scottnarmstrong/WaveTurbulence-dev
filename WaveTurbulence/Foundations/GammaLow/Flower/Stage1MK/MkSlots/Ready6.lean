/-- **The top bridge, prefix form** (`L ≥ L₀ ≥ 2` gives `1 ≤ L`). -/
theorem markedClassRepresentsMK_prefix_of_repGenLow {cP cθ : ℝ} (hθ : cθGen ≤ cθ)
    (h : WTPrefix fun P => ∀ hγh : P.γ ≤ 1 / 2, haveI : Fact (P.γ ≤ 1 / 2) := ⟨hγh⟩; ClassRepGenLow cP P) :
    MarkedClassRepresentsGateLow cP cθ := by
  intro d hd γ hγ
  obtain ⟨η₀, hη₀, H⟩ := h d hd γ hγ
  refine ⟨η₀, hη₀, fun η hη φin hφin τ hτ φ hφ => ?_⟩
  obtain ⟨C₁, hC₁, ν₀, hν₀, H2⟩ := H η hη φin hφin τ hτ φ hφ
  refine ⟨C₁, hC₁, ν₀, hν₀, fun ν hν => ?_⟩
  obtain ⟨δ₀, hδ₀, H3⟩ := H2 ν hν
  refine ⟨δ₀, hδ₀, fun δ hδ D hD hτD => ?_⟩
  obtain ⟨C₂, hC₂, L₀, hL₀, H4⟩ := H3 δ hδ D hD hτD
  refine ⟨C₂, hC₂, L₀, hL₀, fun L hL hγh => ?_⟩
  haveI : Fact (γ ≤ 1 / 2) := ⟨hγh⟩
  exact markedClassRepresentsMK_of_repGenLow (show (1 : ℝ) ≤ L by linarith) hθ (H4 L hL hγh)

end

