/-- **The `G_sb` dagger constant** of a dagger datum (`1` without dagger). -/
def capConstOLow {d : ℕ} (J : Finset (Fin (2 * R))) (L γ δ s : ℝ) (roots : Fin (2 * R) → (Fin d → ℤ))
    (dag : Option (Fin (2 * R) → Fin 3 → Mom d)) : ℂ :=
  dag.elim 1 fun cc => capConstGLow a mk J L γ δ s roots cc

end

