variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable (P : WTParams) [Fact (P.γ ≤ 1 / 2)] {R : ℕ} (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat) (t s : ℝ)
  (kSel σ : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ) (mkF : Fama.Stage1Mk.MarkFn P.γ (2 * R))
  (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R)) (dag : Option (Fin (2 * R) → Fin 3 → Mom P.d))

/-- **The six B3s fields of `MkPieceRest` for the general piece** (`PieceRestB3sLow`). -/
theorem pieceRestGenLow (hJ : J.card = R) (p : ℕ) (hG : CapGeo a.layered J p) (hpat : CapPatValid a.layered J pat p)
    (hirr : a.layered.garden.Irreducible) (hs : s ∈ Ioo (p : ℝ) t) (ht : t < p + 1)
    (hsub : ∀ {LG : LayeredGarden (2 * R)} (B : PrimeData LG), markILow J pat t s kSel B ⊆ mkF B)
    (hL : 1 ≤ P.L) (hRs : ∀ j, P.L ≤ Rs j) (cθ : ℝ) (hθ : cθGen ≤ cθ) :
    PieceRestB3sLow (pieceGenLow P J pat t s kSel σ Rs mkF a dag) cθ where
  prot_card := (card_protOf_leLow J pat t s kSel mkF a).trans (Nat.le_mul_of_pos_left _ (by norm_num))
  fix_prot b hb := fixOf_protLow b hb
  fix_layer b x hb := by
    have hb' : fixOfLow J pat t s mkF a b = some x := hb
    have hroot := exists_capFlower_of_capGeo hG (layered_isPlainLow P a) hirr (by rw [hJ])
    have := fixCap_val hG hpat hroot hs ht hb'
    exact ⟨this.1.le, this.2.1⟩
  filt_ok := filtGen_okLow P J pat t s kSel σ Rs mkF a dag hsub hL hRs cθ hθ
  ind_ok k := indGen_memLow J P.L σ kSel mkF a dag k
  ind_local k k' h := indGen_localLow J pat t s P.L σ kSel mkF a dag k k'
    fun c hc i => h c (Finset.mem_union_right _ hc) i
  lb_free b hb := (lbGen_isSomeLow (J := J) (pat := pat) (t := t) (s := s) (mkF := mkF) (a := a) hb).2.1
  lb_prot b hb := by
    obtain ⟨-, -, u, hu, huπ, -⟩ := lbGen_isSomeLow (J := J) (pat := pat) (t := t) (s := s) (mkF := mkF) (a := a) hb
    exact Finset.mem_filter.2 ⟨Finset.mem_univ _, mem_protI_of_child_pinned hu huπ⟩
  lb_layer b x hb := by
    have hb' : lbGenLow J pat t s mkF a b = some x := hb
    obtain ⟨hx, hpd, hfree, u, hu, huπ, -⟩ := lbGen_specLow hb'
    have hpd' : pat (coreOfLow mkF a b).1.1 = FixPat.dParent := by
      have e : (coreOfLow mkF a b).1.1 = b.1.1 := coreOf_fstLow mkF a b
      rw [e]
      exact hpd
    have hl : a.layered.layer (coreOfLow mkF a b).toNode = p :=
      layer_parent_of_pinned_dParent hG hpd' hfree hu huπ
    show (a.layered.layer (coreOfLow mkF a b).toNode : ℝ) ≤ x ∧ x ≤ a.layered.layer (coreOfLow mkF a b).toNode + 1
    rw [hl, hx]
    exact ⟨hs.1.le, by linarith [hs.2]⟩

end

