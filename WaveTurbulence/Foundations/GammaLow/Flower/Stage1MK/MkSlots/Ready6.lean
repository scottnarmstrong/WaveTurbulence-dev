/-- **The general class piece** at a prescribed point `a`. -/
def pieceGenLow (P : WTParams) [Fact (P.γ ≤ 1 / 2)] {R : ℕ} (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat) (t s : ℝ)
    (kSel σ : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ) (mkF : Fama.Stage1Mk.MarkFn P.γ (2 * R))
    (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R)) (dag : Option (Fin (2 * R) → Fin 3 → Mom P.d)) : Stage1PieceMKG P R :=
  classPieceLow P mkF a (protOfLow J pat t s kSel mkF a) (protI a.layered J pat t s kSel).card (fixOfLow J pat t s mkF a)
    (filtGenLow J P.L σ kSel Rs mkF a) (indGenLow J P.L σ kSel mkF a dag) (lbGenLow J pat t s mkF a)

end

