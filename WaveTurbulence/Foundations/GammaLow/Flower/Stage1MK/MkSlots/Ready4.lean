open WaveTurbulence.RedSplice (Prescription stSt vinesV0 unitBlocks)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}

/-- **`hselclk` for the piece**: at a stem-clean point (with `markILow ⊆ mkF`), no unit clock of the piece is a residual
selected atom. -/
theorem selROf_not_unitClockLow {J : Finset (Fin w)} (pat : Fin w → FixPat) (t s : ℝ) (kSel : Fin w → Option ℕ)
    (mkF : Fama.Stage1Mk.MarkFn γF w) (hsub : ∀ {LG : LayeredGarden w} (B : PrimeData LG), markILow J pat t s kSel B ⊆ mkF B)
    {a : Fama.VineA.PrescribedPrimeGarden γF w} (hcl : CleanPtLow J a) :
    ∀ c ∈ selROfLow J kSel mkF a, ∀ (j : Fin (nUnitsLow mkF a)) (i : Fin 3),
      (shapeRepLow mkF a).hclk (unitsRep_disjLow mkF a) j i ≠ Sum.inr c := by
  intro c hcs j i h
  set Φ := shapeRepLow mkF a
  set hd := unitsRep_disjLow mkF a
  fin_cases i
  · change Sum.inr (Φ.hinge hd j) = Sum.inr c at h
    have hc : c = Φ.hinge hd j := (Sum.inr_injective h).symm
    have hh : c ∈ (stALow mkF a).hinges := by
      rw [← shapeRep_hingesLow, hc]
      exact Finset.mem_image.2 ⟨j, Finset.mem_univ _, rfl⟩
    exact selROf_not_hingeLow pat t s hsub hcs hh
  · change VineB.nodeClk _ (Φ.hmom hd j 2) = Sum.inr c at h
    have hn := nodeClk_eq_inr h
    have h2 := Φ.node_hmom hd j 2
    rw [hn] at h2
    have h2' : Φ.node c.toNode = (unitsRepLow mkF a j).lower.child (VineB.regionOf (unitsRepLow mkF a j)).positive := h2
    have hob : ((stALow mkF a).M.ob c).toNode = (unitsRepLow mkF a j).lower.child
        (VineB.regionOf (unitsRepLow mkF a j)).positive := (Φ.br_node c).trans h2'
    exact selROf_not_lowerCrownLow mkF hcl hcs j _ hob
  · change VineB.nodeClk _ (Φ.hmom hd j 3) = Sum.inr c at h
    have hn := nodeClk_eq_inr h
    have h2 := Φ.node_hmom hd j 3
    rw [hn] at h2
    have h2' : Φ.node c.toNode = (unitsRepLow mkF a j).lower.child (VineB.regionOf (unitsRepLow mkF a j)).negative := h2
    have hob : ((stALow mkF a).M.ob c).toNode = (unitsRepLow mkF a j).lower.child
        (VineB.regionOf (unitsRepLow mkF a j)).negative := (Φ.br_node c).trans h2'
    exact selROf_not_lowerCrownLow mkF hcl hcs j _ hob

end

