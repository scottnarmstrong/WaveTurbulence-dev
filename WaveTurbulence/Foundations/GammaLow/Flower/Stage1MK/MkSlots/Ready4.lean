variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}

/-- **Every piece of the aligned assembly of a unit has the atoms of a vine of `𝒱₀ \ Mk`.** The unit's spine of
`𝒱₀ \ Mk` vines (`Famc.VineA.unitBlocks_selected_spineMk`) is the spine of the assembly (`Fama.Spine.unique`). -/
theorem alignedPiece_mem_vinesV0Low {G : Garden w} (σ : Prescription G) (Mk : Set (Fama.CLVineG γF G))
    (j : Fin (Fama.unitBlocks γF G σ Mk).length) (i : Fin (Fama.Represents.unitN σ j)) :
    ∃ c ∈ Fama.vinesV0 γF G σ Mk, c.atoms =
      (Famb.VineEstS2.assemblyPieceAtΓ (Fama.alignedAssemblyMk γF (Mole.garden_isMolecule G) σ Mk j) i).atoms := by
  obtain ⟨L, hL, hmem⟩ := assembly_exists_spineLow (Fama.alignedAssemblyMk γF (Mole.garden_isMolecule G) σ Mk j)
  have hu : Fama.unitBlkMk γF (Mole.garden_isMolecule G) σ Mk j ∈ Fama.unitBlocks γF G σ Mk := List.get_mem _ _
  obtain ⟨L', hL', hsel⟩ := Famc.VineA.unitBlocks_selected_spineMk hu
  have hLL : L = L' :=
    Fama.Spine.unique (Mole.garden_isMolecule G) hL hL' (Fama.unitBlkMk γF (Mole.garden_isMolecule G) σ Mk j).isBlock
  subst hLL
  obtain ⟨c, hc, he⟩ := hsel _ (hmem i)
  exact ⟨c, hc, he⟩

end

