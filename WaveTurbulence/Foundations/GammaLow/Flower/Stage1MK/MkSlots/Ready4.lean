/-- **Retention at the representative for the units at any marked set.** -/
theorem stemRet_repMkLow {w : ℕ} {J : Finset (Fin w)} {a : Fama.VineA.PrescribedPrimeGarden γF w} (hc : CleanPtLow J a)
    (Mk : Set (Fama.CLVineG γF a.prime.skeleton)) :
    StemRet a.prime.skeleton a.prime.data.tree (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma Mk)
      a.layered J :=
  stemRet_of_cleanLow a.prime.data.tree _ (Fama.vinesV0 γF a.prime.skeleton a.totalSigma Mk)
    (stemAvoid_of_cleanPtLow hc Mk) (fun j => Fama.Represents.unitN a.totalSigma j)
    (fun j => Fama.alignedAssemblyMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma Mk j)
    (fun j i => alignedPiece_mem_vinesV0Low a.totalSigma Mk j i)

end

