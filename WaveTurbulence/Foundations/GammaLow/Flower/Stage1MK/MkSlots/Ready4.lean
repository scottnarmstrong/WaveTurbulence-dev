open WaveTurbulence.RedSplice (Prescription stSt vinesV0 unitBlocks)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}

/-- A lower crown child of a unit is not the old name of a residual selected atom (stem-clean point). -/
theorem selROf_not_lowerCrownLow {J : Finset (Fin w)} {kSel : Fin w → Option ℕ} (mkF : Fama.Stage1Mk.MarkFn γF w)
    {a : Fama.VineA.PrescribedPrimeGarden γF w} (hcl : CleanPtLow J a) {c : GBranch (stALow mkF a).G.tree}
    (hcs : c ∈ selROfLow J kSel mkF a) (j : Fin (nUnitsLow mkF a)) (i : Fin 3)
    (hy : ((stALow mkF a).M.ob c).toNode = (unitsRepLow mkF a j).lower.child i) : False := by
  set u := unitsRepLow mkF a j
  have hR := stemRet_repLow mkF hcl
  -- the selected vertex is on a capped stem
  have hv := mem_selROfLow.1 hcs
  have hst : OnStemAddr a.layered J (coreOfLow mkF a c).1 :=
    onStemAddr_of_mem_stemSetCap (MkSlotsS.selCap_spec (selCap_of_mem_selSetCap hv)).2
  have hcore : (coreOfLow mkF a c).1 = a.prime.data.corePosition ((stALow mkF a).M.ob c) := rfl
  -- so is the core vertex of the lower atom
  have hbelow := addrBelow_corePosition_of_child a.prime.data u.lower ((stALow mkF a).M.ob c) i hy
  have hlow : OnStemAddr a.layered J (a.prime.data.corePosition u.lower) :=
    onStemAddr_of_addrBelow (hcore ▸ hst) hbelow
  have heq := hR.upper j _ hlow u.lower (owner_corePosition a.prime.data u.lower) u.isBlock.2.2.1
  exact u.isBlock.2.2.2.1 heq.symm

end

