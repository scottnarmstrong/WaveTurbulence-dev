/-- **T1 (retention at the representative).** On a stem-clean point the capped stem meets no interior of a unit of
the piece. -/
theorem stemRet_repLow {J : Finset (Fin w)} (mkF : Fama.Stage1Mk.MarkFn γF w) {a : Fama.VineA.PrescribedPrimeGarden γF w}
    (hc : CleanPtLow J a) : StemRet a.prime.skeleton a.prime.data.tree (unitsRepLow mkF a) a.layered J :=
  stemRet_of_cleanLow a.prime.data.tree (unitsRepLow mkF a) (Fama.vinesV0 γF a.prime.skeleton a.totalSigma (classMkLow mkF a))
    (stemAvoid_of_cleanPtLow hc (classMkLow mkF a)) (fun j => Fama.Represents.unitN a.totalSigma j)
    (fun j => Fama.alignedAssemblyMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (classMkLow mkF a) j)
    (fun j i => alignedPiece_mem_vinesV0Low a.totalSigma (classMkLow mkF a) j i)

end

