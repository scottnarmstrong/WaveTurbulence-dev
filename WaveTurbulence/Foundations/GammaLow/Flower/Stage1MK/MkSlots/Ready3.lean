variable {w : ℕ}

theorem lbGen_specLow {J : Finset (Fin w)} {pat : Fin w → FixPat} {t s : ℝ} {mkF : Fama.Stage1Mk.MarkFn γF w}
    {a : Fama.VineA.PrescribedPrimeGarden γF w} {c : GBranch (stALow mkF a).G.tree} {x : ℝ} (h : lbGenLow J pat t s mkF a c = some x) :
    x = s ∧ pat c.1.1 = FixPat.dParent ∧ fixOfLow J pat t s mkF a c = none ∧ ∃ u, PinTopBelowLow J pat t s mkF a c u := by
  unfold lbGenLow at h
  split_ifs at h with hc
  · exact ⟨(Option.some.inj h).symm, hc⟩

end

