theorem stemAvoid_of_cleanPtLow {J : Finset (Fin w)} {a : Fama.VineA.PrescribedPrimeGarden γF w} (hc : CleanPtLow J a)
    (Mk : Set (Fama.CLVineG γF a.prime.skeleton)) :
