/-- `sel_inj`: at most one residual selected atom per tree. -/
theorem selROf_injLow {c c' : GBranch (stALow mkF a).G.tree} (hc : c ∈ selROfLow J kSel mkF a)
    (hc' : c' ∈ selROfLow J kSel mkF a) (h : c.1.1 = c'.1.1) : c = c' := by
  have h1 := selCap_coreOfLow hc
  have h2 := selCap_coreOfLow hc'
  rw [h, h2] at h1
