open scoped Classical ENNReal
open WaveTurbulence WaveTurbulence.LGSpine WaveTurbulence.Induct Set Finset MeasureTheory
open WaveTurbulence.LGSpine.SourceVine WaveTurbulence.Flower.MkDefs WaveTurbulence.Flower.FinalMKDefs
open WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden WaveTurbulence.Represents
open WaveTurbulence.RedSplice (Prescription stSt vinesV0)
open WaveTurbulence.Flower.Stage1MKGate
open WaveTurbulence.Flower.MkSlots (stA coreOf protOf fixOf sibIndOf sibIndOf_mem)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}

/-- The selected product of the indicator lies in `[0,1]`. -/
theorem selProd_memLow {d : ℕ} (J : Finset (Fin w)) (L : ℝ) (σ kSel : Fin w → Option ℕ) (mkF : Fama.Stage1Mk.MarkFn γF w)
    (a : Fama.VineA.PrescribedPrimeGarden γF w) (k : GNode (stALow mkF a).G.tree → Mom d) :
    0 ≤ ∏ v ∈ selRGenLow J kSel mkF a, MkSlotsT.radProd (MkSlotsT.radSigma L σ v) (omegaNode (stALow mkF a).G k v) ∧
      ∏ v ∈ selRGenLow J kSel mkF a, MkSlotsT.radProd (MkSlotsT.radSigma L σ v) (omegaNode (stALow mkF a).G k v) ≤ 1 :=
  ⟨Finset.prod_nonneg fun _ _ => (MkSlotsT.radProd_mem_Icc _ _).1,
    Finset.prod_le_one₀ (fun _ _ => (MkSlotsT.radProd_mem_Icc _ _).1) fun _ _ => (MkSlotsT.radProd_mem_Icc _ _).2⟩

end

section
open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkSlotsG
open scoped Classical ENNReal
open WaveTurbulence WaveTurbulence.LGSpine WaveTurbulence.Induct Set Finset MeasureTheory
open WaveTurbulence.LGSpine.SourceVine WaveTurbulence.Flower.MkDefs WaveTurbulence.Flower.FinalMKDefs
open WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden WaveTurbulence.Represents
open WaveTurbulence.RedSplice (Prescription stSt vinesV0)
open WaveTurbulence.Flower.Stage1MKGate
open WaveTurbulence.Flower.MkSlots (stA coreOf protOf fixOf sibIndOf sibIndOf_mem)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}

/-- **`ind_ok`**: the indicator of the piece takes values in `[0,1]`. -/
theorem indGen_memLow {d : ℕ} (J : Finset (Fin w)) (L : ℝ) (σ kSel : Fin w → Option ℕ) (mkF : Fama.Stage1Mk.MarkFn γF w)
    (a : Fama.VineA.PrescribedPrimeGarden γF w) (dag : Option (Fin w → Fin 3 → Mom d)) (k : GNode (stALow mkF a).G.tree → Mom d) :
    0 ≤ indGenLow J L σ kSel mkF a dag k ∧ indGenLow J L σ kSel mkF a dag k ≤ 1 := by
  have h1 := sibIndOf_memLow J mkF a dag (flwGenLow J mkF a) k
  have h2 := selProd_memLow J L σ kSel mkF a k
  refine ⟨mul_nonneg h1.1 h2.1, ?_⟩
  calc _ ≤ 1 * 1 := mul_le_mul h1.2 h2.2 h2.1 zero_le_one
    _ = 1 := one_mul 1

end

section
open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkSlotsG
open scoped Classical ENNReal
open WaveTurbulence WaveTurbulence.LGSpine WaveTurbulence.Induct Set Finset MeasureTheory
open WaveTurbulence.LGSpine.SourceVine WaveTurbulence.Flower.MkDefs WaveTurbulence.Flower.FinalMKDefs
open WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden WaveTurbulence.Represents
open WaveTurbulence.RedSplice (Prescription stSt vinesV0)
open WaveTurbulence.Flower.Stage1MKGate
open WaveTurbulence.Flower.MkSlots (stA coreOf protOf fixOf sibIndOf sibIndOf_mem)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}

/-- **`ind_local`**: the indicator reads only the momenta at protected atoms and their children (the dagger
indicator at capped flower parents, σ's filter at residual selected atoms, both seeds of `Π`). -/
theorem indGen_localLow {d : ℕ} (J : Finset (Fin w)) (pat : Fin w → FixPat) (t s : ℝ) (L : ℝ)
    (σ kSel : Fin w → Option ℕ) (mkF : Fama.Stage1Mk.MarkFn γF w) (a : Fama.VineA.PrescribedPrimeGarden γF w)
    (dag : Option (Fin w → Fin 3 → Mom d)) (k k' : GNode (stALow mkF a).G.tree → Mom d)
    (h : ∀ c ∈ protOfLow J pat t s kSel mkF a, ∀ i : Fin 3, k (c.child i) = k' (c.child i) ∧ k c.toNode = k' c.toNode) :
    indGenLow J L σ kSel mkF a dag k = indGenLow J L σ kSel mkF a dag k' := by
  unfold indGenLow
  rw [sibIndOf_localLow J pat t s kSel mkF a dag (flwGenLow J mkF a) k k' fun c hc i => (h c hc i).1]
  congr 1
  refine Finset.prod_congr rfl fun v hv => ?_
  rw [omegaNode_congr (h v (selROf_sub_protOfLow pat t s hv))]

end

