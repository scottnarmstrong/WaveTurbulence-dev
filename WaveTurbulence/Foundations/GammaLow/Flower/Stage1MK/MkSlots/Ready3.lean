variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ} {LG : LayeredGarden w} {J : Finset (Fin w)}

/-- **No atom of a unit of the piece carries a pin.** `a` is a prescribed point, `mkF` a fine marking containing
`markILow`; the units are those of `Fama.unitBlocks γF` at the marked set `classMkLow mkF a`. -/
theorem fixCap_coreBranch_unitLow (pat : Fin w → FixPat) (t s : ℝ) (kSel : Fin w → Option ℕ)
    (mkF : Fama.Stage1Mk.MarkFn γF w) (hsub : ∀ {LG : LayeredGarden w} (B : PrimeData LG), markILow J pat t s kSel B ⊆ mkF B)
    (a : Fama.VineA.PrescribedPrimeGarden γF w) {u : RedSplice.CLBlock a.prime.skeleton}
    (hu : u ∈ Fama.unitBlocks γF a.prime.skeleton a.totalSigma (classMkLow mkF a)) {y : GBranch a.prime.skeleton.tree}
    (hy : y ∈ u.atoms) :
    fixCap a.layered J pat t s (a.prime.data.decodedCoreBranch a.prime.prime.1 a.prime.decodes y) = none := by
  obtain ⟨c, hc, hyc, -⟩ := Fama.unitBlocks_soundMk hu y hy
  rw [Fama.mem_vinesV0] at hc
  obtain ⟨hc0, hcMk⟩ := hc
  by_contra hpin
  have hpin' := Option.ne_none_iff_isSome.1 hpin
  have hm : c ∈ markILow J pat t s kSel a.prime :=
    marked_of_fix_atomLow a.prime pat t s kSel c (Fama.vinesV0_subset _ _ hc0) y hyc hpin' rfl
  exact hcMk ⟨hsub a.prime hm, hc0⟩

end

