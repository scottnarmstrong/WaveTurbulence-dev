/-- No lower bound outside the `dParent` trees. -/
theorem lbGen_not_dParentLow {J : Finset (Fin w)} {pat : Fin w → FixPat} {t s : ℝ} {mkF : Fama.Stage1Mk.MarkFn γF w}
    {a : Fama.VineA.PrescribedPrimeGarden γF w} {c : GBranch (stALow mkF a).G.tree} (h : pat c.1.1 ≠ FixPat.dParent) :
