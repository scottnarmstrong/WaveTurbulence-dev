variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}

/-- The dagger sibling indicator of the piece: at every atom whose core branch is a capped flower parent, the
children that are not the capped flower carry the prescribed momenta `cc`. -/
def sibIndOfLow {d : ℕ} (J : Finset (Fin w)) (mkF : Fama.Stage1Mk.MarkFn γF w) (a : Fama.VineA.PrescribedPrimeGarden γF w)
    (dag : Option (Fin w → Fin 3 → Mom d)) (flw : GBranch (stALow mkF a).G.tree → Fin 3 → Prop)
    (k : GNode (stALow mkF a).G.tree → Mom d) : ℝ :=
  dag.elim 1 fun cc => ∏ c : GBranch (stALow mkF a).G.tree,
    if IsCapFlowerParent a.layered J (coreOfLow mkF a c) then
      ∏ i : Fin 3, (if flw c i then 1 else if k (c.child i) = cc c.1.1 i then 1 else 0) else 1

end

