/-- The core branch, in the layered garden of `a`, of a branch of `G_sb`. -/
def coreOfLow (mkF : Fama.Stage1Mk.MarkFn γF w) (a : Fama.VineA.PrescribedPrimeGarden γF w) (c : GBranch (stALow mkF a).G.tree) :
    GBranch a.layered.garden.tree :=
  a.prime.data.decodedCoreBranch a.prime.prime.1 a.prime.decodes ((stALow mkF a).M.ob c)

end

