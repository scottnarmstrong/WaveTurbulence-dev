open WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden
open WaveTurbulence.RedSplice (Prescription stSt vinesV0)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}

theorem sibIndOf_memLow {d : ℕ} (J : Finset (Fin w)) (mkF : Fama.Stage1Mk.MarkFn γF w) (a : Fama.VineA.PrescribedPrimeGarden γF w)
    (dag : Option (Fin w → Fin 3 → Mom d)) (flw : GBranch (stALow mkF a).G.tree → Fin 3 → Prop)
    (k : GNode (stALow mkF a).G.tree → Mom d) :
    0 ≤ sibIndOfLow J mkF a dag flw k ∧ sibIndOfLow J mkF a dag flw k ≤ 1 := by
  unfold sibIndOfLow
  cases dag with
  | none => simp
  | some cc =>
    simp only [Option.elim]
    constructor
    · refine Finset.prod_nonneg fun c _ => ?_
      split_ifs
      · exact Finset.prod_nonneg fun i _ => by split_ifs <;> norm_num
      · norm_num
    · refine Finset.prod_le_one₀ (fun c _ => ?_) fun c _ => ?_
      · split_ifs
        · exact Finset.prod_nonneg fun i _ => by split_ifs <;> norm_num
        · norm_num
      · split_ifs
        · exact Finset.prod_le_one₀ (fun i _ => by split_ifs <;> norm_num) fun i _ => by split_ifs <;> norm_num
        · exact le_rfl

end

