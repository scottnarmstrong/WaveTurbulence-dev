theorem fixOf_protLow {J : Finset (Fin w)} {pat : Fin w → FixPat} {t s : ℝ} {kSel : Fin w → Option ℕ}
    {mkF : Fama.Stage1Mk.MarkFn γF w} {a : Fama.VineA.PrescribedPrimeGarden γF w} (c : GBranch (stALow mkF a).G.tree)
    (h : (fixOfLow J pat t s mkF a c).isSome) : c ∈ protOfLow J pat t s kSel mkF a :=
  Finset.mem_filter.2 ⟨Finset.mem_univ _, mem_protI_of_fixCap h⟩

end

