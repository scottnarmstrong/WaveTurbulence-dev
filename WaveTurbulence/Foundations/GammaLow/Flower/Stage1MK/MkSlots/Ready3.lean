variable {w : ℕ}

/-- **The atom filters of the piece**: `(Rs j, chiDN)` at a residual selected atom, else γ's atom filter (radii
`radGen` at the representative's reconstruction). -/
def filtGenLow (J : Finset (Fin w)) (L : ℝ) (σ kSel : Fin w → Option ℕ) (Rs : Fin w → ℝ) (mkF : Fama.Stage1Mk.MarkFn γF w)
    (a : Fama.VineA.PrescribedPrimeGarden γF w) (c : GBranch (stALow mkF a).G.tree) : Option (ℝ × SchwartzMap ℝ ℂ) :=
  if c ∈ selRGenLow J kSel mkF a then some (Rs c.1.1, MkSlotsS.chiDNS)
  else MkSlotsT.filtStem a.prime.data a.prime.prime.1 (shapeRepLow mkF a) (unitsRep_disjLow mkF a)
    (sourceLayerLow a) (sourceLayer_isLayeringLow a) J (radGen (recALow a) J L σ kSel Rs)
    (one_le_radGen (recALow a) J L σ kSel Rs) c

end

