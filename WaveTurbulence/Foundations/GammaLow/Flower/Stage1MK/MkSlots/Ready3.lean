variable {w : ℕ}

/-- A branch of `G_sb` and its old name lie in the same tree. -/
theorem ob_fstLow (mkF : Fama.Stage1Mk.MarkFn γF w) (a : Fama.VineA.PrescribedPrimeGarden γF w) (c : GBranch (stALow mkF a).G.tree) :
    ((stALow mkF a).M.ob c).1.1 = c.1.1 := by
  have hF := VineB.spliceFoldInv a.prime.skeleton (Fama.unitBlocks γF a.prime.skeleton a.totalSigma (classMkLow mkF a))
    (Fama.unitBlocks_pairwiseMk (Mole.garden_isMolecule _) _ _)
  have h1 := congrArg (fun x : GNode a.prime.skeleton.tree => x.1.1) (hF.br_node c)
  exact h1.trans (hF.tree_eq c.toNode)

end

