open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}

/-- **No atom of a unit of the piece has a selected core vertex** (B3s's `fixCap_coreBranch_unitLow` for selections). -/
theorem coreBranch_unit_not_selLow {J : Finset (Fin w)} (pat : Fin w → FixPat) (t s : ℝ) (kSel : Fin w → Option ℕ)
    (mkF : Fama.Stage1Mk.MarkFn γF w) (hsub : ∀ {LG : LayeredGarden w} (B : PrimeData LG), markILow J pat t s kSel B ⊆ mkF B)
    (a : Fama.VineA.PrescribedPrimeGarden γF w) {u : RedSplice.CLBlock a.prime.skeleton}
    (hu : u ∈ Fama.unitBlocks γF a.prime.skeleton a.totalSigma (classMkLow mkF a)) {y : GBranch a.prime.skeleton.tree}
    (hy : y ∈ u.atoms) :
    a.prime.data.decodedCoreBranch a.prime.prime.1 a.prime.decodes y ∉ selSetCap a.layered J kSel := by
  intro hsel
  obtain ⟨c, hc, hyc, -⟩ := Fama.unitBlocks_soundMk hu y hy
  rw [Fama.mem_vinesV0] at hc
  obtain ⟨hc0, hcMk⟩ := hc
  have hm : c ∈ markILow J pat t s kSel a.prime :=
    marked_of_sel_atomLow a.prime pat t s kSel c (Fama.vinesV0_subset _ _ hc0) y hyc hsel rfl
  exact hcMk ⟨hsub a.prime hm, hc0⟩

end

