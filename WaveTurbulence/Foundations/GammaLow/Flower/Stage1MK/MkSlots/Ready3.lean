    {mkF : Fama.Stage1Mk.MarkFn γF w} {a : Fama.VineA.PrescribedPrimeGarden γF w} {c : GBranch (stALow mkF a).G.tree}
    (hc : c ∉ selRGenLow J kSel mkF a) :
    filtGenLow J L σ kSel Rs mkF a c =
      MkSlotsT.filtStem a.prime.data a.prime.prime.1 (shapeRepLow mkF a) (unitsRep_disjLow mkF a)
        (sourceLayerLow a) (sourceLayer_isLayeringLow a) J (radGen (recALow a) J L σ kSel Rs)
        (one_le_radGen (recALow a) J L σ kSel Rs) c := by
  unfold filtGenLow
  simp only [hc, ↓reduceIte]

end

