variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}

/-- The pinned object tops below an atom `c`: pinned branches `u` of `a.layered` that are children of the core branch
of `c` and the core branch of no atom of `G_sb` (they lie inside a slot). -/
def PinTopBelowLow (J : Finset (Fin w)) (pat : Fin w → FixPat) (t s : ℝ) (mkF : Fama.Stage1Mk.MarkFn γF w)
    (a : Fama.VineA.PrescribedPrimeGarden γF w) (c : GBranch (stALow mkF a).G.tree) (u : GBranch a.layered.garden.tree) : Prop :=
  (fixCap a.layered J pat t s u).isSome ∧ u.IsChildOf (coreOfLow mkF a c) ∧ ∀ c' : GBranch (stALow mkF a).G.tree,
    coreOfLow mkF a c' ≠ u

end

