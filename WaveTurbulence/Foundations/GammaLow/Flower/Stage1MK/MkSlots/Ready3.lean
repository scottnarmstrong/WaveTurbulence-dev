theorem lbGen_isSomeLow {J : Finset (Fin w)} {pat : Fin w → FixPat} {t s : ℝ} {mkF : Fama.Stage1Mk.MarkFn γF w}
    {a : Fama.VineA.PrescribedPrimeGarden γF w} {c : GBranch (stALow mkF a).G.tree} (h : (lbGenLow J pat t s mkF a c).isSome) :
    pat c.1.1 = FixPat.dParent ∧ fixOfLow J pat t s mkF a c = none ∧ ∃ u, PinTopBelowLow J pat t s mkF a c u := by
  obtain ⟨x, hx⟩ := Option.isSome_iff_exists.mp h
