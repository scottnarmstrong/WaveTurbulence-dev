variable {w : ℕ}

/-- The protected atoms `Π_sb` of the piece: atoms whose core node is protected. -/
def protOfLow (J : Finset (Fin w)) (pat : Fin w → FixPat) (t s : ℝ) (kSel : Fin w → Option ℕ)
    (mkF : Fama.Stage1Mk.MarkFn γF w) (a : Fama.VineA.PrescribedPrimeGarden γF w) : Finset (GBranch (stALow mkF a).G.tree) :=
  univ.filter fun c => (coreOfLow mkF a c).toNode ∈ protI a.layered J pat t s kSel

end

