/-- The splice Fama.VineA.PrescribedPrimeGarden.state γF of the piece of `a` at the fine marking `mkF` (marked set `classMkLow mkF a`). -/
abbrev stALow (mkF : Fama.Stage1Mk.MarkFn γF w) (a : Fama.VineA.PrescribedPrimeGarden γF w) :=
  Fama.stSt γF a.prime.skeleton a.totalSigma (classMkLow mkF a)

