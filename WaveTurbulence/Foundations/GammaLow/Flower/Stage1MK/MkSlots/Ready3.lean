/-- The pins of the piece: the intrinsic pins of the core branch. -/
def fixOfLow (J : Finset (Fin w)) (pat : Fin w → FixPat) (t s : ℝ) (mkF : Fama.Stage1Mk.MarkFn γF w)
    (a : Fama.VineA.PrescribedPrimeGarden γF w) (c : GBranch (stALow mkF a).G.tree) : Option ℝ :=
  fixCap a.layered J pat t s (coreOfLow mkF a c)

end

