section
open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkSlotsS
open scoped Classical
open WaveTurbulence WaveTurbulence.LGSpine Set Finset
open WaveTurbulence.Reg.Skeleton WaveTurbulence.Flower.MkDefs WaveTurbulence.Flower.ProtGeo
open WaveTurbulence.Flower.Stage1MKGate WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden
open WaveTurbulence.Flower.MkSlots
open WaveTurbulence.RedSplice (Prescription stSt vinesV0 unitBlocks)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}
variable {J : Finset (Fin w)} {kSel : Fin w → Option ℕ} {mkF : Fama.Stage1Mk.MarkFn γF w} {a : Fama.VineA.PrescribedPrimeGarden γF w}

/-- **Residual selected atoms are not hinges** (the hinges of `G_sb` are the upper atoms of the units). -/
theorem selROf_not_hingeLow (pat : Fin w → FixPat) (t s : ℝ)
    (hsub : ∀ {LG : LayeredGarden w} (B : PrimeData LG), markILow J pat t s kSel B ⊆ mkF B)
    {c : GBranch (stALow mkF a).G.tree} (hc : c ∈ selROfLow J kSel mkF a) : c ∉ (stALow mkF a).hinges := by
  intro hh
  have hM := Mole.garden_isMolecule a.prime.skeleton
  rw [← Fama.stShape_hingesMk hM a.totalSigma (classMkLow mkF a),
    (Fama.stShape γF hM a.totalSigma (classMkLow mkF a)).mem_hinges (Fama.unitBlkMk_disj hM _ _)] at hh
  obtain ⟨j, hj⟩ := hh
  have hu : Fama.unitBlkMk γF hM a.totalSigma (classMkLow mkF a) j ∈
      Fama.unitBlocks γF a.prime.skeleton a.totalSigma (classMkLow mkF a) := List.get_mem _ _
  have hy : (stALow mkF a).M.ob c ∈ (Fama.unitBlkMk γF hM a.totalSigma (classMkLow mkF a) j).atoms := by
    have : (Fama.stShape γF hM a.totalSigma (classMkLow mkF a)).br c = (stALow mkF a).M.ob c := rfl
    rw [← this, hj]
    exact VineB.upper_mem _
  exact coreBranch_unit_not_selLow pat t s kSel mkF hsub a hu hy (mem_selROfLow.1 hc)

end

section
open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkSlotsS
open scoped Classical
open WaveTurbulence WaveTurbulence.LGSpine Set Finset
open WaveTurbulence.Reg.Skeleton WaveTurbulence.Flower.MkDefs WaveTurbulence.Flower.ProtGeo
open WaveTurbulence.Flower.Stage1MKGate WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden
open WaveTurbulence.Flower.MkSlots
open WaveTurbulence.RedSplice (Prescription stSt vinesV0 unitBlocks)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}

/-- **Case (a): a selected core vertex is the core branch of a residual selected atom.** If the selected vertex `b` is
the core branch of the skeleton branch `y`, then `y` is retained in `G_sb` (no unit atom has a selected core vertex):
`y = M.ob c` with `c ∈ selROfLow`. -/
theorem exists_selROf_of_coreLow {J : Finset (Fin w)} (pat : Fin w → FixPat) (t s : ℝ) (kSel : Fin w → Option ℕ)
    (mkF : Fama.Stage1Mk.MarkFn γF w) (hsub : ∀ {LG : LayeredGarden w} (B : PrimeData LG), markILow J pat t s kSel B ⊆ mkF B)
    (a : Fama.VineA.PrescribedPrimeGarden γF w) {y : GBranch a.prime.skeleton.tree}
    (hy : a.prime.data.decodedCoreBranch a.prime.prime.1 a.prime.decodes y ∈ selSetCap a.layered J kSel) :
    ∃ c ∈ selROfLow J kSel mkF a, (stALow mkF a).M.ob c = y ∧
      coreOfLow mkF a c = a.prime.data.decodedCoreBranch a.prime.prime.1 a.prime.decodes y := by
  have hM := Mole.garden_isMolecule a.prime.skeleton
  set Φ := Fama.stShape γF hM a.totalSigma (classMkLow mkF a)
  have hret : VineB.Ret (Fama.unitBlkMk γF hM a.totalSigma (classMkLow mkF a)) y.toNode := by
    intro j
    left
    rw [RegRed.branch_mem_clRealizationNodes]
    intro hyj
    exact coreBranch_unit_not_selLow pat t s kSel mkF hsub a (List.get_mem _ _) hyj hy
  obtain ⟨c, hc⟩ := Φ.exists_br hret
  have hob : (stALow mkF a).M.ob c = y := hc
  have hcore : coreOfLow mkF a c = a.prime.data.decodedCoreBranch a.prime.prime.1 a.prime.decodes y := by
    unfold coreOfLow; rw [hob]
  exact ⟨c, mem_selROfLow.2 (hcore ▸ hy), hob, hcore⟩

end

section
open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkSlotsS
open scoped Classical
open WaveTurbulence WaveTurbulence.LGSpine Set Finset
open WaveTurbulence.Reg.Skeleton WaveTurbulence.Flower.MkDefs WaveTurbulence.Flower.ProtGeo
open WaveTurbulence.Flower.Stage1MKGate WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden
open WaveTurbulence.Flower.MkSlots
open WaveTurbulence.RedSplice (Prescription stSt vinesV0 unitBlocks)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}

/-- **S2: the selected vertex in the piece.** The selected vertex `v` of tree `j` of a prescribed point `a` (with
`markILow ⊆ mkF`) is either
* (a) the core branch of a residual selected atom `c ∈ selROfLow` (an atom of `G_sb`, not a hinge; unpinned for plain
  patterns, `selROf_fixOfLow`), or
* (b) a native clock branch of a slot of the reconstruction (inside the native object of that slot), and then it is the
  core branch of no atom of `G_sb`.
The two cases exclude each other. -/
theorem selVertex_dichotomyLow {J : Finset (Fin w)} (pat : Fin w → FixPat) (t s : ℝ) (kSel : Fin w → Option ℕ)
    (mkF : Fama.Stage1Mk.MarkFn γF w) (hsub : ∀ {LG : LayeredGarden w} (B : PrimeData LG), markILow J pat t s kSel B ⊆ mkF B)
    (a : Fama.VineA.PrescribedPrimeGarden γF w) {j : Fin w} {v : GBranch a.layered.garden.tree}
    (hv : selCap a.layered J kSel j = some v) :
    (∃ c ∈ selROfLow J kSel mkF a, coreOfLow mkF a c = v ∧ c ∉ (stALow mkF a).hinges) ∨
    ((∃ r : RegRed.ReplacementBranchIndex a.prime.data,
      (RegRed.sourceBranchEquiv a.prime.data a.prime.prime.1 (.inr r)).1 = v.1) ∧
      ∀ c : GBranch (stALow mkF a).G.tree, coreOfLow mkF a c ≠ v) := by
  have hvs : v ∈ selSetCap a.layered J kSel := Finset.mem_filter.2 ⟨Finset.mem_univ _, j, hv⟩
  rcases core_or_nativeLow a v with ⟨y, hy⟩ | ⟨r, hr⟩
  · left
    obtain ⟨c, hc, -, hcore⟩ := exists_selROf_of_coreLow pat t s kSel mkF hsub a (hy ▸ hvs)
    exact ⟨c, hc, hcore.trans hy, selROf_not_hingeLow pat t s hsub hc⟩
  · right
    refine ⟨⟨r, hr⟩, fun c hc => ?_⟩
    have := native_ne_coreLow a r ((stALow mkF a).M.ob c)
    apply this
    rw [hr, ← hc]
    rfl

end

