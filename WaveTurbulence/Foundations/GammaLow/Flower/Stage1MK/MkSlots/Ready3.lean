open scoped Classical
open WaveTurbulence WaveTurbulence.LGSpine Set Finset
open WaveTurbulence.Flower.MkDefs WaveTurbulence.Flower.FinalMKDefs WaveTurbulence.Flower.Stage1MKGate
open WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden
open WaveTurbulence.RedSplice (Prescription stSt vinesV0)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}

/-- The indicator reads only the momenta at the children of protected atoms (capped flower parents are seeds). -/
theorem sibIndOf_localLow {d : ℕ} (J : Finset (Fin w)) (pat : Fin w → FixPat) (t s : ℝ)
    (kSel : Fin w → Option ℕ) (mkF : Fama.Stage1Mk.MarkFn γF w) (a : Fama.VineA.PrescribedPrimeGarden γF w)
    (dag : Option (Fin w → Fin 3 → Mom d)) (flw : GBranch (stALow mkF a).G.tree → Fin 3 → Prop)
    (k k' : GNode (stALow mkF a).G.tree → Mom d)
    (h : ∀ c ∈ protOfLow J pat t s kSel mkF a, ∀ i : Fin 3, k (c.child i) = k' (c.child i)) :
    sibIndOfLow J mkF a dag flw k = sibIndOfLow J mkF a dag flw k' := by
  unfold sibIndOfLow
  cases dag with
  | none => rfl
  | some cc =>
    simp only [Option.elim]
    refine Finset.prod_congr rfl fun c _ => ?_
    by_cases hc : IsCapFlowerParent a.layered J (coreOfLow mkF a c)
    · have hp : c ∈ protOfLow J pat t s kSel mkF a := fixOf_protLow c (by
        simp [fixOfLow, fixCap, hc])
      simp only [hc, ite_true]
      exact Finset.prod_congr rfl fun i _ => by rw [h c hp i]
    · simp only [hc, ite_false]

end

