variable {w : ℕ}

/-- **The indicator of the piece**: the dagger sibling indicator times σ's filter at the residual selected atoms. -/
def indGenLow {d : ℕ} (J : Finset (Fin w)) (L : ℝ) (σ kSel : Fin w → Option ℕ) (mkF : Fama.Stage1Mk.MarkFn γF w)
    (a : Fama.VineA.PrescribedPrimeGarden γF w) (dag : Option (Fin w → Fin 3 → Mom d)) (k : GNode (stALow mkF a).G.tree → Mom d) :
    ℝ :=
  sibIndOfLow J mkF a dag (flwGenLow J mkF a) k *
    ∏ v ∈ selRGenLow J kSel mkF a, MkSlotsT.radProd (MkSlotsT.radSigma L σ v) (omegaNode (stALow mkF a).G k v)

end

