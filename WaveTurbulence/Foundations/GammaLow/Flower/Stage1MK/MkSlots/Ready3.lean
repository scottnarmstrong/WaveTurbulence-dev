/-- **The residual selected atoms** of the piece of `a`: the atoms of `G_sb` whose core branch is a selected vertex. -/
def selROfLow (J : Finset (Fin w)) (kSel : Fin w → Option ℕ) (mkF : Fama.Stage1Mk.MarkFn γF w) (a : Fama.VineA.PrescribedPrimeGarden γF w) :
    Finset (GBranch (stALow mkF a).G.tree) :=
  univ.filter fun c => coreOfLow mkF a c ∈ selSetCap a.layered J kSel

