open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}

/-- A branch of `G_sb` and its core branch lie in the same tree. -/
theorem coreOf_fstLow (mkF : Fama.Stage1Mk.MarkFn γF w) (a : Fama.VineA.PrescribedPrimeGarden γF w) (c : GBranch (stALow mkF a).G.tree) :
    (coreOfLow mkF a c).1.1 = c.1.1 := by
  show (a.prime.data.corePosition ((stALow mkF a).M.ob c)).1 = c.1.1
  unfold ReconstructionData.corePosition
  show (inflatedPosition a.prime.skeleton a.prime.data.tree ((stALow mkF a).M.ob c).toNode).1 = c.1.1
  rw [MkMark.inflatedPosition_fst]
  exact ob_fstLow mkF a c

end

