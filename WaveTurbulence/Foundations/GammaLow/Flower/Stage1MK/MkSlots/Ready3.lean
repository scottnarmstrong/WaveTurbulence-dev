/-- The flower children of a `G_sb` branch: leaves paired with a cap root (α's `MkSlots.flwOf`, same body). -/
def flwGenLow (J : Finset (Fin w)) (mkF : Fama.Stage1Mk.MarkFn γF w) (a : Fama.VineA.PrescribedPrimeGarden γF w) :
    GBranch (stALow mkF a).G.tree → Fin 3 → Prop :=
