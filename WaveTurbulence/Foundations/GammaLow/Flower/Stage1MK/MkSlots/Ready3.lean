variable {w : ℕ}

theorem card_protOf_leLow (J : Finset (Fin w)) (pat : Fin w → FixPat) (t s : ℝ) (kSel : Fin w → Option ℕ)
    (mkF : Fama.Stage1Mk.MarkFn γF w) (a : Fama.VineA.PrescribedPrimeGarden γF w) :
    (protOfLow J pat t s kSel mkF a).card ≤ (protI a.layered J pat t s kSel).card := by
  refine Finset.card_le_card_of_injOn (fun c => (coreOfLow mkF a c).toNode) (fun c hc => ?_)
    (fun c _ c' _ h => coreOf_toNode_injectiveLow mkF a h)
  exact (Finset.mem_filter.1 hc).2

end

