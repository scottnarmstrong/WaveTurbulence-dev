variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}

/-- **The constant lower bounds of the piece** (ruling R187): `lb c = some s` at a free atom `c` of a `dParent` tree
with a pinned object top below it (F-H3-1: the frozen kernel keeps `s < τ_c`), `none` elsewhere. -/
def lbGenLow (J : Finset (Fin w)) (pat : Fin w → FixPat) (t s : ℝ) (mkF : Fama.Stage1Mk.MarkFn γF w)
    (a : Fama.VineA.PrescribedPrimeGarden γF w) (c : GBranch (stALow mkF a).G.tree) : Option ℝ :=
  if pat c.1.1 = FixPat.dParent ∧ fixOfLow J pat t s mkF a c = none ∧ ∃ u, PinTopBelowLow J pat t s mkF a c u
  then some s else none

end

