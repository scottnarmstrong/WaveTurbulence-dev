variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}
variable {G : Garden w}

/-- Every piece of a chain assembly lies in its region. -/
theorem piece_atoms_subLow {U : Finset (GBranch G.tree)} {a b : GBranch G.tree} {R : CLRegionData G U a b} {n : ℕ}
    (B : Famb.VineEstS2.CLChainAssemblyΓ γF G R n) (i : Fin n) : (Famb.VineEstS2.assemblyPieceAtΓ B i).atoms ⊆ U := by
  induction B with
  | single hV R => exact fun x hx => hx
  | append B hT hi hU R ih =>
    rcases Fin.eq_zero_or_eq_succ i with rfl | ⟨k, rfl⟩
    · exact Finset.subset_union_right
    · exact (ih k).trans Finset.subset_union_left

end

