open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}

/-- A native clock branch is not a core branch. -/
theorem native_ne_coreLow (a : Fama.VineA.PrescribedPrimeGarden γF w) (r : RegRed.ReplacementBranchIndex a.prime.data)
    (y : GBranch a.prime.skeleton.tree) :
    (RegRed.sourceBranchEquiv a.prime.data a.prime.prime.1 (.inr r)).1 ≠
      (a.prime.data.decodedCoreBranch a.prime.prime.1 a.prime.decodes y).1 := by
  intro h
  rw [decodedCoreBranch_valLow, ← RegRed.sourceBranchEquiv_core] at h
  have := (RegRed.sourceBranchEquiv a.prime.data a.prime.prime.1).injective (Subtype.ext h)
  exact absurd this (by simp)

end

