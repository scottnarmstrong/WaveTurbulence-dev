/-- Protected atoms at `Mk`. -/
def protAtLow (J : Finset (Fin w)) (pat : Fin w → FixPat) (t s : ℝ) (kSel : Fin w → Option ℕ)
    (a : Fama.VineA.PrescribedPrimeGarden γF w) (Mk : Set (Fama.CLVineG γF a.prime.skeleton)) :
    Finset (GBranch (stMLow a Mk).G.tree) :=
  univ.filter fun c => (coreAtLow a Mk c).toNode ∈ protI a.layered J pat t s kSel

end

