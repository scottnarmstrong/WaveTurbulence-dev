/-- The core branch of a branch of the spliced garden at `Mk`. -/
def coreAtLow (a : Fama.VineA.PrescribedPrimeGarden γF w) (Mk : Set (Fama.CLVineG γF a.prime.skeleton))
    (c : GBranch (stMLow a Mk).G.tree) : GBranch a.layered.garden.tree :=
  a.prime.data.decodedCoreBranch a.prime.prime.1 a.prime.decodes ((stMLow a Mk).M.ob c)

