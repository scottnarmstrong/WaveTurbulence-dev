variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}

/-- The dagger sibling indicator at `Mk`. -/
def sibIndAtLow {d : ℕ} (J : Finset (Fin w)) (a : Fama.VineA.PrescribedPrimeGarden γF w) (Mk : Set (Fama.CLVineG γF a.prime.skeleton))
    (dag : Option (Fin w → Fin 3 → Mom d)) (flw : GBranch (stMLow a Mk).G.tree → Fin 3 → Prop)
    (k : GNode (stMLow a Mk).G.tree → Mom d) : ℝ :=
  dag.elim 1 fun cc => ∏ c : GBranch (stMLow a Mk).G.tree,
    if IsCapFlowerParent a.layered J (coreAtLow a Mk c) then
      ∏ i : Fin 3, (if flw c i then 1 else if k (c.child i) = cc c.1.1 i then 1 else 0) else 1

end

