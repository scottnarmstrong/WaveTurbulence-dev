variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}

/-- **A non-upper atom of a piece is a non-upper atom of every CL vine with the atoms of the piece** (parent flow: an
interior atom of the piece and its lower joint have their parent inside it, the upper joint of a CL vine does not). -/
theorem ne_upper_of_pieceLow {G : Garden w} {U : Finset (GBranch G.tree)} {a b : GBranch G.tree}
    {R : RegRed.CLRegionData G U a b} {n : ℕ} (B : Famb.VineEstS2.CLChainAssemblyΓ γF G R n) (i : Fin n) (c : Fama.CLVineG γF G)
    (hc : c.atoms = (Famb.VineEstS2.assemblyPieceAtΓ B i).atoms) {v : GBranch G.tree} (hv : v ∈ (Famb.VineEstS2.assemblyPieceAtΓ B i).atoms)
    (hne : v ≠ (Famb.VineEstS2.assemblyPieceAtΓ B i).upper) : v ≠ c.upper := by
  rintro rfl
  apply c.notParentUpper
  rw [hc]
  by_cases hl : c.upper = (Famb.VineEstS2.assemblyPieceAtΓ B i).lower
  · rw [hl]
    exact (Famb.VineEstS3.assemblyPiece_clΓ B i).2
  · exact Mole.block_interior_has_parent G (Src.isBlock_of_isSomeVine (Famb.VineEstS2.assemblyPieceAtΓ B i).vine) hv hne hl

end

