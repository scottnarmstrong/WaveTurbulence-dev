variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}

/-- **The pieces of a chain assembly are the members of a spine of its region.** -/
theorem assembly_exists_spineLow {G : Garden w} {U : Finset (GBranch G.tree)} {a b : GBranch G.tree}
    {R : RegRed.CLRegionData G U a b} {n : ℕ} (B : Famb.VineEstS2.CLChainAssemblyΓ γF G R n) :
    ∃ L, Fama.Spine γF G.molecule L U a b ∧ ∀ i, ((Famb.VineEstS2.assemblyPieceAtΓ B i).atoms, (Famb.VineEstS2.assemblyPieceAtΓ B i).upper,
      (Famb.VineEstS2.assemblyPieceAtΓ B i).lower) ∈ L := by
  induction B with
  | single hV R => exact ⟨_, Fama.Spine.one hV, fun _ => List.mem_singleton_self _⟩
  | @append S T a' b' c' n' RP B hT hi hU R ih =>
    obtain ⟨L, hL, hmem⟩ := ih
    refine ⟨L ++ [(T, b', c')], Fama.Spine.snoc hL hT hi hU.2.2.2.1, fun i => ?_⟩
    refine Fin.cases ?_ (fun j => ?_) i
    · exact List.mem_append_right _ (List.mem_singleton_self _)
    · exact List.mem_append_left _ (hmem j)

end

