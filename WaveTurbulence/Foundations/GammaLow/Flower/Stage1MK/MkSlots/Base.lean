variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}
variable {G : Garden w}

/-- The upper joint of the region is the upper joint of a piece. -/
theorem exists_piece_upperLow {U : Finset (GBranch G.tree)} {a b : GBranch G.tree} {R : CLRegionData G U a b} {n : ℕ}
    (B : Famb.VineEstS2.CLChainAssemblyΓ γF G R n) : ∃ i, (Famb.VineEstS2.assemblyPieceAtΓ B i).upper = a := by
  induction B with
  | single hV R => exact ⟨0, rfl⟩
  | append B hT hi hU R ih =>
    obtain ⟨k, hk⟩ := ih
    exact ⟨k.succ, hk⟩

end

