open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkSlotsS
open MeasureTheory Set
open WaveTurbulence WaveTurbulence.Induct WaveTurbulence.LGSpine WaveTurbulence.Represents WaveTurbulence.RepAnalytic WaveTurbulence.VineEstS3 WaveTurbulence.VineEstS3.FS
open WaveTurbulence.Reg WaveTurbulence.Reg.Skeleton TTree
open WaveTurbulence.Flower.MkDefs WaveTurbulence.Flower.FinalMKDefs WaveTurbulence.Flower.MkSlots
open scoped ENNReal
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]

/-- The order/gain part of the `RepresentsIntMK` bound. -/
def repCoreMKLow (P : WTParams) [Fact (P.γ ≤ 1 / 2)] {R : ℕ} (π : Stage1PieceMKG P R) (n : ℕ) : ℝ :=
  (P.C₁ * Real.sqrt P.δ) ^ (n - π.Gsb.order) * P.C₁ ^ (π.Gsb.order + 2 * R) *
    P.L ^ (-P.η ^ 8 * (π.gsk : ℝ) - P.η ^ 2 / 2 * (π.bsk : ℝ) + P.η ^ 7 * (π.Cs.hinges.card : ℝ))

end

section
open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkSlotsS
open MeasureTheory Set
open WaveTurbulence WaveTurbulence.Induct WaveTurbulence.LGSpine WaveTurbulence.Represents WaveTurbulence.RepAnalytic WaveTurbulence.VineEstS3 WaveTurbulence.VineEstS3.FS
open WaveTurbulence.Reg WaveTurbulence.Reg.Skeleton TTree
open WaveTurbulence.Flower.MkDefs WaveTurbulence.Flower.FinalMKDefs WaveTurbulence.Flower.MkSlots
open scoped ENNReal
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]

/-- The selected bound in the form of `RepresentsIntMKSelG`. -/
theorem repCoreMK_le_repBoundSelLow (P : WTParams) [Fact (P.γ ≤ 1 / 2)] {R : ℕ} (π : Stage1PieceMKG P R) (a n : ℕ) (cP s : ℝ)
    (hL1 : 1 ≤ P.L) (hcP : 0 ≤ cP) (hT0 : 0 ≤ repCoreMKLow P π n)
    (hs0 : 0 ≤ P.L ^ (7 * (47 * P.d + 2) * (a : ℝ)) * s) :
    repCoreMKLow P π n * (P.L ^ (7 * (47 * P.d + 2) * (a : ℝ)) * s) ≤ repBoundSelLow P π a n cP s := by
  have hLc : 1 ≤ P.L ^ (cP * P.d * (π.nProt : ℝ)) := Real.one_le_rpow hL1 (by positivity)
  calc repCoreMKLow P π n * (P.L ^ (7 * (47 * P.d + 2) * (a : ℝ)) * s)
      ≤ repCoreMKLow P π n * P.L ^ (cP * P.d * (π.nProt : ℝ)) * (P.L ^ (7 * (47 * P.d + 2) * (a : ℝ)) * s) :=
        mul_le_mul_of_nonneg_right (le_mul_of_one_le_right hT0 hLc) hs0
    _ = repBoundSelLow P π a n cP s := by simp only [repCoreMKLow, repBoundSelLow]; ring

end

