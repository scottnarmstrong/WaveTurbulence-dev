open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkSlotsT
open scoped Classical
open WaveTurbulence WaveTurbulence.LGSpine Set Finset
open WaveTurbulence.Reg WaveTurbulence.Reg.Skeleton WaveTurbulence.RegRed
open WaveTurbulence.Flower.MkDefs
open WaveTurbulence.VineEstS2 (CLChainAssembly assemblyPieceAt)
open WaveTurbulence.Flower.MkMark (owner activeSet StemAvoid CapFlowerAt mem_ownRegion_iff owner_eq_leaf owner_eq_branch)
open WaveTurbulence.Flower.MkSlots (slotOf)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}
variable {G : Garden w}

/-- Every atom of the region other than its upper joint is a non-upper atom of a piece. -/
theorem exists_piece_nonUpperLow {U : Finset (GBranch G.tree)} {a b : GBranch G.tree} {R : CLRegionData G U a b}
    {n : ℕ} (B : Famb.VineEstS2.CLChainAssemblyΓ γF G R n) :
    ∀ v ∈ U, v ≠ a → ∃ i, v ∈ (Famb.VineEstS2.assemblyPieceAtΓ B i).atoms ∧ v ≠ (Famb.VineEstS2.assemblyPieceAtΓ B i).upper := by
  induction B with
  | single hV R => exact fun v hv hva => ⟨0, hv, hva⟩
  | @append S T a' b' c' n' RP B hT hi hU R ih =>
    intro v hv hva
    by_cases hS : v ∈ S
    · obtain ⟨k, hk⟩ := ih v hS hva
      exact ⟨k.succ, hk⟩
    · have hvT : v ∈ T := (Finset.mem_union.mp hv).resolve_left hS
      refine ⟨0, hvT, ?_⟩
      intro hvb
      apply hS
      have hb : b' ∈ S ∩ T := by rw [hi]; exact Finset.mem_singleton_self _
      rw [hvb]
      exact (Finset.mem_inter.mp hb).1

end

