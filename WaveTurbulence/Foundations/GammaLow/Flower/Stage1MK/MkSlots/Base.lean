variable {w : ℕ}

/-- Flower children at `Mk`. -/
def flwAtLow (J : Finset (Fin w)) (a : Fama.VineA.PrescribedPrimeGarden γF w) (Mk : Set (Fama.CLVineG γF a.prime.skeleton)) :
    GBranch (stMLow a Mk).G.tree → Fin 3 → Prop :=
  fun c i => ∃ ℓ : GLeaf (stMLow a Mk).G.tree, ℓ.toNode = c.child i ∧ ((stMLow a Mk).G.pair ℓ).1.1 ∈ J

end

