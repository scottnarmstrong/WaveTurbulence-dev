open WaveTurbulence.Flower.MkMark (owner activeSet StemAvoid CapFlowerAt mem_ownRegion_iff)
open WaveTurbulence.Flower.MkSlots (slotOf slotOf_nativeNodeAt)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}

/-- `StemRet` for units carrying chain assemblies of stem-clean vines. -/
theorem stemRet_of_cleanLow {S : Garden w} (X : GBranch S.tree → RegChain) {ι : Type} (blk : ι → CLBlock S)
    {LG : LayeredGarden w} {J : Finset (Fin w)} (V : Set (Fama.CLVineG γF S))
    (hclean : ∀ c ∈ V, StemAvoid LG J (activeSet S X c.atoms c.upper)) (nn : ι → ℕ)
    (B : ∀ j, Famb.VineEstS2.CLChainAssemblyΓ γF S (VineB.regionOf (blk j)) (nn j))
    (hB : ∀ j i, ∃ c ∈ V, c.atoms = (Famb.VineEstS2.assemblyPieceAtΓ (B j) i).atoms) : StemRet S X blk LG J where
  upper := fun j _ hz _ hβ hβU => owner_eq_upper_of_stemLow X V hclean (B j) (hB j) hz hβ hβU
  leaf := fun j _ hz _ hℓ => not_internalLeaf_of_stemLow X V hclean (B j) (hB j) hz hℓ

end

