variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w p : ℕ} {kind : Bool} {ι : Type*}

/-- The native couple of a slot of the spliced garden at the marking `Mk`. -/
def spliceNCLMkLow (A : FamilyReconstruction w ι) (σ : Prescription A.skeleton) (Mk : Set (Fama.CLVineG γF A.skeleton))
    (s : ReplacementSlot (Fama.stSt γF A.skeleton σ Mk).G) : Option (LayeredGarden 2) :=
  stateNCL A ((Fama.stShape γF (Mole.garden_isMolecule A.skeleton) σ Mk).iota
    A.plain ((Fama.stSt γF _ _ Mk).plain A.plain) s)

end

