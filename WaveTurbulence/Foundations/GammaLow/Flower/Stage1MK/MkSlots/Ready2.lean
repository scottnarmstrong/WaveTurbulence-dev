variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {R : ℕ} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R))

/-- **The decoration weight of `G_sb`**: the piece's dagger sibling indicator times the common gap selection. -/
def ZwGLow {d : ℕ} (J : Finset (Fin (2 * R))) (L γ η : ℝ) (hL : L ≠ 0) (roots : Fin (2 * R) → (Fin d → ℤ))
    (dag : Option (Fin (2 * R) → Fin 3 → Mom d))
    (z : GenDecoration (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G d roots 0) : ℝ :=
  sibIndAtLow J a (mk a.prime) dag (flwAtLow J a (mk a.prime))
      (cosetDecoration (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G L 0 z.1) *
    (if selSkCMkLow a mk L γ η hL 0 roots z then 1 else 0)

end

