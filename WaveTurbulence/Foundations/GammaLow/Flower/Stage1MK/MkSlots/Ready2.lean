/-- The representative's unit radius lists for tree-indexed radii. -/
abbrev SURepLow (radT : Fin (2 * R) → List ℝ) :
    Fin (Fama.unitBlocks γF a.prime.skeleton a.totalSigma (mk a.prime)).length → List ℝ :=
  SUStem a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J (fun b => radT b.1.1)
