variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w p : ℕ} {kind : Bool} {ι : Type*}

theorem spliceNCL_congrMkLow (A : FamilyReconstruction w ι) {σ τ : Prescription A.skeleton}
    (Mk : Set (Fama.CLVineG γF A.skeleton)) (h : σ = τ) {G : Garden w} (e : G = (Fama.stSt γF A.skeleton σ Mk).G)
    (e' : G = (Fama.stSt γF A.skeleton τ Mk).G) (s : ReplacementSlot G) :
    spliceNCLMkLow A σ Mk (slotCast e s) = spliceNCLMkLow A τ Mk (slotCast e' s) := by
  subst τ
  rfl

end

