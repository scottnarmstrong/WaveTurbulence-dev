open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkSlotsS
open scoped Classical
open WaveTurbulence WaveTurbulence.LGSpine Set Finset
open WaveTurbulence.Reg WaveTurbulence.Reg.Skeleton WaveTurbulence.RegRed WaveTurbulence.Flower.MkDefs
open WaveTurbulence.VineB WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden
open WaveTurbulence.Flower.MkSlotsT (StemRet OnStemAddr onStemAddr_of_addrBelow owner_corePosition onStem_core_iff coreLG StemB)
open WaveTurbulence.LFTwist WaveTurbulence.RedSplice WaveTurbulence.VineC WaveTurbulence.Flower.MkUnits WaveTurbulence.Represents WaveTurbulence.VineEstS4 WaveTurbulence.Flower.Stage1W WaveTurbulence.VineAlign WaveTurbulence.Stage1 WaveTurbulence.Twist WaveTurbulence.Flower.Stage1WVine
open WaveTurbulence.Flower.Stage1MKGate (CleanPt)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}
variable {R p : ℕ} {kind : Bool} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R))
  (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (hy : y ∈ Fama.sourceClass γF a p kind mk)
  (J : Finset (Fin (2 * R)))
  (hcapA : ∀ j ∈ J, (a.prime.data.garden a.prime.prime.1).tree j = TTree.leaf)
  (hcapY : ∀ j ∈ J, (y.1.data.garden y.1.plain).tree j = TTree.leaf)
  (hG : (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.IsPlain)
variable (hrepU : ∀ j, ∀ b ∈ (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).atoms,
    ¬ IsCapFlowerParent (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a)) J (a.prime.data.coreBranch a.prime.prime.1 b))

include hy hcapA hcapY hG hrepU in
/-- **S2, class-common**: for a member `y` of the run class of the representative `a`, the selected vertex of tree `j`
of `y` is the core of the `G_sb` atom `c` iff the representative's is (both reconstructions with one capped flower
per tree, `a` stem-clean). -/
theorem selCap_member_core_iffLow (hc : CleanPtLow J a)
    (honeA : OneFlower (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)) J)
    (honeY : OneFlower (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J)
    (kSel : Fin (2 * R) → Option ℕ) (j : Fin (2 * R))
    (c : GBranch (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.tree) :
    selCap (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J kSel j =
        some (coreLG y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) ((memShapeLow a mk y hy).br c)) ↔
      selCap (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)) J kSel j =
        some (coreLG a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)
          ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).br c)) := by
  set bY := coreLG y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) ((memShapeLow a mk y hy).br c)
  set bA := coreLG a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)
    ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).br c)
  have htY : bY.1.1 = c.1.1 :=
    (MkSlots.IntRest.coreBranch_fst y.1.data y.1.plain _).trans (MkSlotsT.shape_br_fst (memShapeLow a mk y hy) c)
  have htA : bA.1.1 = c.1.1 :=
    (MkSlots.IntRest.coreBranch_fst a.prime.data a.prime.prime.1 _).trans
      (MkSlotsT.shape_br_fst (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)) c)
  have hsB := stemB_member_iffLow a mk y hy J hcapA hcapY hG hrepU c
  -- stem membership in tree `j`
  have hmem : bY ∈ stemSetCap (layeredReconstruction y.1.data y.1.plain (stateLayer y.1)
      (stateLayer_isLayering y.1)) J j ↔
      bA ∈ stemSetCap (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a)
        (sourceLayer_isLayeringLow a)) J j := by
    constructor
    · intro h
      obtain ⟨j', hj'⟩ := hsB.1 ⟨j, h⟩
      have h1 := (mem_stemSetCap_iff'.1 hj').1
      have h2 := (mem_stemSetCap_iff'.1 h).1
      rwa [show j = j' by rw [← h1, ← h2, htY, htA]]
    · intro h
      obtain ⟨j', hj'⟩ := hsB.2 ⟨j, h⟩
      have h1 := (mem_stemSetCap_iff'.1 hj').1
      have h2 := (mem_stemSetCap_iff'.1 h).1
      rwa [show j = j' by rw [← h1, ← h2, htY, htA]]
  -- equal depths for stem cores
  have hlen : bA ∈ stemSetCap (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a)) J j → bA.1.2.length = bY.1.2.length := fun h =>
    stemCore_length_memberLow a mk y hy J hcapA hcapY hG hc c
      (MkSlotsT.onStemAddr_of_mem_stemSetCap h)
  rw [selCap_eq_some_iff honeY, selCap_eq_some_iff honeA]
  constructor
  · rintro ⟨h, hk⟩
    have hA := hmem.1 h
    exact ⟨hA, by rw [hk, hlen hA]⟩
  · rintro ⟨h, hk⟩
    exact ⟨hmem.2 h, by rw [hk, hlen h]⟩

end

