open scoped Classical
open WaveTurbulence WaveTurbulence.LGSpine Set Finset
open WaveTurbulence.Reg WaveTurbulence.Reg.Skeleton WaveTurbulence.RegRed WaveTurbulence.Flower.MkDefs
open WaveTurbulence.VineB WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden
open WaveTurbulence.Flower.MkSlotsT (StemRet OnStemAddr onStemAddr_of_addrBelow owner_corePosition onStem_core_iff coreLG StemB)
open WaveTurbulence.LFTwist WaveTurbulence.RedSplice WaveTurbulence.VineC WaveTurbulence.Flower.MkUnits WaveTurbulence.Represents WaveTurbulence.VineEstS4 WaveTurbulence.Flower.Stage1W WaveTurbulence.VineAlign WaveTurbulence.Stage1 WaveTurbulence.Twist WaveTurbulence.Flower.Stage1WVine
open WaveTurbulence.Flower.Stage1MKGate (CleanPt)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}
variable {R p : ℕ} {kind : Bool} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R))
  (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (hy : y ∈ Fama.sourceClass γF a p kind mk)
  (J : Finset (Fin (2 * R)))
  (hcapA : ∀ j ∈ J, (a.prime.data.garden a.prime.prime.1).tree j = TTree.leaf)
  (hcapY : ∀ j ∈ J, (y.1.data.garden y.1.plain).tree j = TTree.leaf)
  (hG : (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.IsPlain)

include hy hcapA hcapY hG in
/-- **The depth of a stem core is common to the run class.** -/
theorem stemCore_length_memberLow (hc : CleanPtLow J a)
    (c : GBranch (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.tree)
    (hst : OnStemAddr (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a))
      J (a.prime.data.corePosition
        ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).br c))) :
    (a.prime.data.corePosition
        ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).br c)).2.length =
      (y.1.data.corePosition ((memShapeLow a mk y hy).br c)).2.length := by
  have hR₁ := MkSlotsT.stemRet_congr (sourceLayer_reconstructsLow a).symm
    (stemRet_repMkLow hc (mk a.prime))
  have hR₂ := stemRet_memberLow a mk y hy J hcapA hcapY hc
  refine stemCore_length_eq (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime))
    (memShapeLow a mk y hy) a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)
    y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) hcapA hcapY hR₁ hR₂ (fun c' => ?_) c hst
  rw [memShape_chain_eqLow a mk y hy hG c']

end

