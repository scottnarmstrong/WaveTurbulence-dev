/-- **The chains at the `G_sb` atoms are common to the run class.** -/
theorem memShape_chain_eqLow {R p : ℕ} {kind : Bool} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R))
    (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (hy : y ∈ Fama.sourceClass γF a p kind mk)
    (hG : (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.IsPlain)
    (c : GBranch (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.tree) :
    y.1.data.tree ((memShapeLow a mk y hy).br c) =
      a.prime.data.tree ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).br c) := by
  have h := memShape_nativeChainLow a mk y hy hG c
  have hg : decodedTree (y.1.data.tree ((memShapeLow a mk y hy).br c))
        (nodeSign y.1.skeleton.sig ((memShapeLow a mk y hy).br c).1) =
      decodedTree (a.prime.data.tree ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma
          (mk a.prime)).br c))
        (nodeSign a.prime.skeleton.sig ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma
          (mk a.prime)).br c).1) :=
    congrArg LayeredGarden.garden h
  have hs := congrArg (fun G : Garden 1 => G.sig 0) hg
  simp only [decodedTree_sign] at hs
  rw [hs] at hg
  exact congrArg Subtype.val (decodedTree_wf_injective _ (a₁ := ⟨_, y.1.data.tree_wf _⟩)
    (a₂ := ⟨_, a.prime.data.tree_wf _⟩) hg)

end

