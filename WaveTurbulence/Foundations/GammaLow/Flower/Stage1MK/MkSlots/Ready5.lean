  (hcapY : ∀ j ∈ J, (y.1.data.garden y.1.plain).tree j = TTree.leaf)
  (hrepU : ∀ j, ∀ b ∈ (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).atoms,
    ¬ IsCapFlowerParent (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a)) J (a.prime.data.coreBranch a.prime.prime.1 b))

include hy hG hcapA hcapY hrepU in
/-- **The dagger constant of a member is the `G_sb` constant.** -/
theorem member_restConstLow {d : ℕ}
    (hGeoY : CapGeo (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J p)
    (L γ δ s : ℝ) (roots : Fin (2 * R) → (Fin d → ℤ)) (cc : Fin (2 * R) → Fin 3 → Mom d) :
    restConst y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) L γ δ s J roots cc =
      capConstGLow a mk J L γ δ s roots cc := by
  rw [restConst_shape (memShapeLow a mk y hy) y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) J hGeoY
    L γ δ s roots cc (member_hrangeLow a mk y hy hG J hcapA hcapY hrepU)
    (member_hnhLow a mk y hy hG J hcapA hcapY hrepU)]
  unfold capConstGLow
  congr 1
  ext c
  simp only [mem_filter, mem_univ, true_and]
  rw [member_cfp_iffLow a mk y hy hG J hcapA hcapY hrepU c, cfp_coreAt_iffLow a mk J c]

include hG hcapA hcapY hrepU in

