/-- **The native couple of an outer couple slot is common to the run class** (at a marking): `memShape_slotNCLLow` at
`s = .inl q`, with `SpliceShape.iota` unfolded. -/
theorem memShape_nativeCoupleLow {R p : ℕ} {kind : Bool} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R))
    (mk : Fama.Stage1Mk.MarkFn γF (2 * R))
    (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (hy : y ∈ Fama.sourceClass γF a p kind mk)
    (hG : (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.IsPlain)
    (q : SourcePair (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G) :
    nativeCoupleLayered y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)
        (pairOfLeaf y.1.skeleton y.1.plain ((memShapeLow a mk y hy).leaf (q.firstLeaf hG))) =
      nativeCoupleLayered a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)
        (pairOfLeaf a.prime.skeleton a.prime.prime.1
          ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).leaf (q.firstLeaf hG))) :=
  Option.some.inj (memShape_slotNCLLow a mk y hy hG (.inl q))

end

