open WaveTurbulence.VineParamContract
open Finset TTree Reg Reg.Skeleton WaveTurbulence WaveTurbulence.RegRed WaveTurbulence.RedSplice WaveTurbulence.VineB WaveTurbulence.LGSpine WaveTurbulence.VineEstS2 WaveTurbulence.Stage1 WaveTurbulence.Vine WaveTurbulence.VineA WaveTurbulence.VineEstS4 WaveTurbulence.VineC WaveTurbulence.LFTwist WaveTurbulence.VineAlign WaveTurbulence.RegRedLeaf WaveTurbulence.VineEstS3.FS WaveTurbulence.RepAnalytic WaveTurbulence.Represents WaveTurbulence.Flower.Stage1W WaveTurbulence.Flower.Stage1WVine WaveTurbulence.Flower.MkDefs WaveTurbulence.Flower.Stage1MKGate WaveTurbulence.Flower.MkUnits WaveTurbulence.Flower.V5W MeasureTheory
open scoped ENNReal
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {p : ℕ}

open scoped Classical in
open Fama.VineA.PrescribedPrimeGarden in
/-- **The coarse′ class sum is the fine′ output sum** for any summand vanishing at the empty selection. -/
theorem sum_members_eq_genLow {R : ℕ} {A : Finset (LayeredGarden (2 * R))}
    {Adm : ∀ {ι : Type}, LFTwist.FamilyReconstruction (2 * R) ι → Prop} (hcl : TwistClosedAdm p A Adm)
    {mkF mkC mkU : Fama.Stage1Mk.MarkFn γF (2 * R)} (hFT : ∀ c : Fama.VineA.PrescribedPrimeGarden γF (2 * R), c.FineTransportedAt γF mkF)
    (hsub : ∀ {LG : LayeredGarden (2 * R)} (B : PrimeData LG), mkC B ⊆ mkF B)
    (π : Fama.Represents.PcA γF R p (objKind (2 * R)) A mkF)
    (hout : (Fama.Represents.repPt γF π).outputsLow (p := p) (kind := objKind (2 * R)) mkU =
      (Fama.Represents.repPt γF π).outputsLow (p := p) (kind := objKind (2 * R)) mkF)
    (hadm : Adm (Fama.sourceStart γF (Fama.Represents.repPt γF π) mkU))
    (hcan : IsCanonGC (p + 1) (Fama.Represents.repPt γF π).layered) (P : WTParams) (base : Mom P.d)
    (roots : Fin (2 * R) → (Fin P.d → ℤ))
    (Ψ : ∀ LG : LayeredGarden (2 * R), (GenDecoration LG.garden P.d roots 0 → Prop) → ℂ)
    (hΨ : ∀ LG, Ψ LG (fun _ => False) = 0)
    (T : Finset (LayeredGarden (2 * R)))
    (hT : (T : Set (LayeredGarden (2 * R))) = (Fama.Represents.repPt γF π).outputsLow (p := p) (kind := objKind (2 * R)) mkF) :
    ∑ LG ∈ Fama.Represents.membersP γF (Fama.Represents.clsPMk γF mkC π), Ψ LG (Fama.Represents.selPMk γF p (objKind (2 * R)) A P base roots mkF π LG) =
      ∑ LG ∈ T, Ψ LG (Fama.Represents.selPMk γF p (objKind (2 * R)) A P base roots mkF π LG) := by
  have hzero : ∀ LG, LG ∉ T → Ψ LG (Fama.Represents.selPMk γF p (objKind (2 * R)) A P base roots mkF π LG) = 0 := by
    intro LG hLG
    have hf : Fama.Represents.selPMk γF p (objKind (2 * R)) A P base roots mkF π LG = fun _ => False := by
      funext κ
      apply propext
      constructor
      · rintro ⟨b, hb, hrel, -⟩
        refine absurd ?_ hLG
        rw [← Finset.mem_coe, hT, ← hb]
        rw [← Fama.VineA.PrescribedPrimeGarden.tauClass_imageMkLow hFT (Fama.Represents.repPt γF π)]
        exact ⟨b, hrel, rfl⟩
      · exact False.elim
    rw [hf]
    exact hΨ LG
  have hsub' : T ⊆ Fama.Represents.membersP γF (Fama.Represents.clsPMk γF mkC π) := by
    intro LG hLG
    have hout' : LG ∈ (Fama.Represents.repPt γF π).outputsLow (p := p) (kind := objKind (2 * R)) mkF := by
      rw [← hT]; exact hLG
    unfold Fama.Represents.membersP
    rw [Finset.mem_filter]
    refine ⟨?_, ?_⟩
    · have h := Fama.prescribed_outputs_eq_unitsStartMk (p := p) (kind := objKind (2 * R)) (Fama.Represents.repPt γF π) mkU
        (sourceLayerLow (Fama.Represents.repPt γF π)) (sourceLayer_isLayeringLow (Fama.Represents.repPt γF π)) (sourceLayer_reconstructsLow (Fama.Represents.repPt γF π))
      have houtU := hout'
      rw [← hout] at houtU
      -- L5a-G's `outputs` and L8's `outputsLow` have the same body: cast `h` definitionally
      have h' : (Fama.Represents.repPt γF π).outputsLow (p := p) (kind := objKind (2 * R)) mkU = _ := h
      rw [h'] at houtU
      obtain ⟨M, B', hM, hB, hLB⟩ := houtU
      have hB0 : (Fama.sourceStart γF (Fama.Represents.repPt γF π) mkU).layered = (Fama.Represents.repPt γF π).layered := sourceLayer_reconstructsLow (Fama.Represents.repPt γF π)
      exact hcl (objKind (2 * R)) (Famb.VineC.UnitsIndexΓ (Fama.sourceAssemblyMk γF (Fama.Represents.repPt γF π) mkU)) (Fama.sourceStart γF (Fama.Represents.repPt γF π) mkU)
        (Finset.univ.toList) (Fama.Represents.repPt γF π).prime.prime
        (canonicalObject_of_isCanonGC (by rw [hB0]; exact hcan)) (by rw [hB0]; exact Fama.Represents.repPt_layered_memMk π) hadm LG
        ⟨M, B', hM, hB, hLB⟩
    · show LG ∈ Fama.Represents.coarseOf γF p (objKind (2 * R)) (Fama.Represents.repPt γF π) mkC
      exact Fama.VineA.PrimeData.fine_outputs_subset_coarseMk (Fama.Represents.repPt γF π).prime (Fama.Represents.repPt γF π).totalSigma (hsub (Fama.Represents.repPt γF π).prime) hout'
  exact (Finset.sum_subset hsub' (fun LG _ hLG => hzero LG hLG)).symm

end

