  let Φ := memShapeLow a mk y hy
  have hd := Fama.source_disjMk a mk y hy
  obtain ⟨k, ℓ, hℓ, hpJ, hatt⟩ := cfp_unit_atom Φ y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)
