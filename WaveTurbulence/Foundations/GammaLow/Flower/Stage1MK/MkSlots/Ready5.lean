/-- **The start Fama.VineA.PrescribedPrimeGarden.state γF of the run assembly at `mkAt mkF a` is admissible** for every fine marking `mkF ⊇ markILow`. -/
theorem startAt_admPLow {R : ℕ} (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat) (t s : ℝ)
    (kSel : Fin (2 * R) → Option ℕ) (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mkF : Fama.Stage1Mk.MarkFn γF (2 * R))
    (hsub : ∀ {LG : LayeredGarden (2 * R)} (B : PrimeData LG), markILow J pat t s kSel B ⊆ mkF B) :
    AdmP R J pat t s kSel (startAtLow a (mkAtLow mkF a)) :=
  startAt_admP_of_subLow J pat t s kSel a _ fun _ hm h0 => ⟨hsub a.prime hm, h0⟩

end

