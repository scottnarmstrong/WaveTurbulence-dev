variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {p : ℕ}

open scoped Classical in
/-- **B4's class value is the fine′ output sum** of the frozen class summands (α hypotheses not needed). -/
theorem classValue_eq_outputsLow (P : WTParams) [Fact (P.γ ≤ 1 / 2)] {R : ℕ} (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat)
    (kSel : Fin (2 * R) → Option ℕ) (t s : ℝ) (A : Finset (LayeredGarden (2 * R)))
    (hTC : MarkedTwistClosed p A (protSkOf R J (fun LG => fixCap LG J pat t s) (fun LG => selSetCap LG J kSel)))
    (roots : Fin (2 * R) → (Fin P.d → ℤ)) (h : ℕ → Fin (2 * R) → Fin (2 * R) → Mom P.d → ℝ)
    (Rf : Fin (2 * R) → Option ℝ) (σ : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ)
    (dag : Option (Fin (2 * R) → Fin 3 → Mom P.d)) (mkF : Fama.Stage1Mk.MarkFn P.γ (2 * R))
    (hmk : FineMarkingLow J pat t s kSel σ mkF) (π : Fama.Represents.PcA P.γ R p (objKind (2 * R)) A mkF)
    (hcan : IsCanonGC (p + 1) (Fama.Represents.repPt P.γ π).layered) (T : Finset (LayeredGarden (2 * R)))
    (hT : (T : Set (LayeredGarden (2 * R))) = (Fama.Represents.repPt P.γ π).outputsLow (p := p) (kind := objKind (2 * R)) mkF) :
    classValueLow P p J pat kSel t s A roots h Rf σ Rs dag mkF π =
      ∑ LG ∈ T, kernelKgenSel P.L P.γ P.δ LG (fixCap LG J pat t s) (offCap LG J dag.isSome)
        (markedWt P J p kSel h Rf σ Rs dag LG) (fun _ => t) 0 roots
        (Fama.Represents.selPMk P.γ p (objKind (2 * R)) A P 0 roots mkF π LG) := by
  have hsub : ∀ {LG : LayeredGarden (2 * R)} (B : PrimeData LG), markI0Low J pat t s B ⊆ mkF B :=
    fun B => (markI0_sub_markILow J pat t s kSel B).trans (hmk.sub B)
  obtain ⟨mkU, hset, hout⟩ : ∃ mkU : Fama.Stage1Mk.MarkFn P.γ (2 * R), mkU (Fama.Represents.repPt P.γ π).prime = mkAtLow mkF (Fama.Represents.repPt P.γ π) ∧
      (Fama.Represents.repPt P.γ π).outputsLow (p := p) (kind := objKind (2 * R)) mkU =
        (Fama.Represents.repPt P.γ π).outputsLow (p := p) (kind := objKind (2 * R)) mkF :=
    ⟨fixMarkLow (Fama.Represents.repPt P.γ π) (mkAtLow mkF (Fama.Represents.repPt P.γ π)), fixMark_selfLow (Fama.Represents.repPt P.γ π) (mkAtLow mkF (Fama.Represents.repPt P.γ π)),
      outputs_fixMark_mkAtLow mkF (Fama.Represents.repPt P.γ π)⟩
  have hadm : AdmP R J pat t s kSel (Fama.sourceStart P.γ (Fama.Represents.repPt P.γ π) mkU) := by
    show AdmP R J pat t s kSel (startAtLow (Fama.Represents.repPt P.γ π) (mkU (Fama.Represents.repPt P.γ π).prime))
    rw [hset]
    exact startAt_admPLow J pat t s kSel (Fama.Represents.repPt P.γ π) mkF hmk.sub
  unfold classValueLow
  exact sum_members_eq_genLow (twistClosedAdm_of_marked hTC) hmk.fine hsub π hout hadm hcan P 0 roots
    (fun LG sel => kernelKgenSel P.L P.γ P.δ LG (fixCap LG J pat t s) (offCap LG J dag.isSome)
      (markedWt P J p kSel h Rf σ Rs dag LG) (fun _ => t) 0 roots sel)
    (fun LG => kernelKgenSel_false _ _ _ LG _ _ _ _ _ _) T hT

end

