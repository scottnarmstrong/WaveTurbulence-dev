/-- **The dagger constant of `G_sb`** (over the atoms whose representative core is a capped flower parent). -/
def capConstGLow {d : ℕ} (L γ δ s : ℝ) (roots : Fin (2 * R) → (Fin d → ℤ)) (cc : Fin (2 * R) → Fin 3 → Mom d) : ℂ :=
  ∏ c ∈ univ.filter (fun c : GBranch (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.tree =>
      IsCapFlowerParent a.layered J (coreAtLow a (mk a.prime) c)),
    capFactorG (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G J L γ δ s roots cc c

end

