open WaveTurbulence.Represents WaveTurbulence.VineEstS4 WaveTurbulence.Flower.Stage1W WaveTurbulence.VineAlign WaveTurbulence.Stage1 WaveTurbulence.Twist WaveTurbulence.Flower.Stage1WVine
open WaveTurbulence.Flower.MkSlots.IntRest
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {R p : ℕ} {kind : Bool} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R))
  (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (hy : y ∈ Fama.sourceClass γF a p kind mk)
  (hG : (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.IsPlain)
  (J : Finset (Fin (2 * R)))
variable (hcapA : ∀ j ∈ J, (a.prime.data.garden a.prime.prime.1).tree j = TTree.leaf)
  (hcapY : ∀ j ∈ J, (y.1.data.garden y.1.plain).tree j = TTree.leaf)
  (hrepU : ∀ j, ∀ b ∈ (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).atoms,
    ¬ IsCapFlowerParent (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a)) J (a.prime.data.coreBranch a.prime.prime.1 b))

include hG hcapA hcapY hrepU in
/-- **The capped flower parents at the `G_sb` atoms are common to the run class.** -/
theorem member_cfp_iffLow (c : GBranch (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.tree) :
    IsCapFlowerParent (layeredReconstruction y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1)) J
        (y.1.data.coreBranch y.1.plain ((memShapeLow a mk y hy).br c)) ↔
      IsCapFlowerParent (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a)
        (sourceLayer_isLayeringLow a)) J
        (a.prime.data.coreBranch a.prime.prime.1
          ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).br c)) := by
  by_cases hc : ∃ j, (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).br c =
      (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).upper
  · obtain ⟨j, hj⟩ := hc
    obtain ⟨j', hj'⟩ := (member_hinge_iffLow a mk y hy c).mpr ⟨j, hj⟩
    constructor
    · intro h
      exact absurd h (member_unit_not_cfpLow a mk y hy hG J hcapA hcapY hrepU j' _ (hj' ▸ upper_mem _))
    · intro h
      exact absurd h (hrepU j _ (hj ▸ upper_mem _))
  · have hcy : ¬ ∃ j, (memShapeLow a mk y hy).br c = (unitClBlock (y.2 j)).upper :=
      fun h => hc ((member_hinge_iffLow a mk y hy c).mp h)
    push_neg at hc hcy
    rw [cfp_br_iff (memShapeLow a mk y hy) y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) J hcapY c
        hcy,
      cfp_br_iff (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)) a.prime.data
        a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) J hcapA c hc]
    simp only [attLeaf_member_iffLow a mk y hy hG]

include hG hcapA hcapY hrepU in

end

