variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w p : ℕ} {kind : Bool} {ι : Type*}
variable {S : Garden w} (hM : S.molecule.IsMolecule) (σ : Prescription S) {Mk : Set (Fama.CLVineG γF S)}
  (D : ReconstructionData S) (hS : S.IsPlain)
  (layer : GNode (D.forest hS) → ℕ) (hLayer : IsLayering (D.garden hS) layer)
  {Y : FamilyReconstruction w (Famb.VineC.UnitsIndexΓ (Fama.alignedAssemblyMk γF hM σ Mk))}
  {vs : ∀ j, UnitAt Y.skeleton Y.family ((Famb.VineC.unitsSplitΓ (Fama.alignedAssemblyMk γF hM σ Mk)).Q j)}
  {xs : List (Famb.VineC.UnitsIndexΓ (Fama.alignedAssemblyMk γF hM σ Mk))}
  (hr : ReachU p kind (Famb.VineC.unitsSplitΓ (Fama.alignedAssemblyMk γF hM σ Mk)).Q xs
    (Famb.VineC.unitsStartΓ (Fama.alignedAssemblyMk γF hM σ Mk) (Fama.unitBlkMk_disj hM σ Mk) D hS layer hLayer)
    (Famb.VineC.unitsRegionΓ (Fama.alignedAssemblyMk γF hM σ Mk) (Fama.unitBlkMk_disj hM σ Mk)) Y vs)
  (hn : xs.Nodup)
  {Mk' : Set (Fama.CLVineG γF Y.skeleton)} (hT : Fama.Stage1Mk.MarkTransported γF (batchMolIso hr.batch) Mk Mk')

/-- The native couples of every carried member agree on the literal common garden at the marking. -/
theorem commonShape_NCLMkLow (hG : (Fama.stSt γF S σ Mk).G.IsPlain) (s : ReplacementSlot (Fama.stSt γF S σ Mk).G) :
    slotNCL Y.data Y.plain (stateLayer Y) (stateLayer_isLayering Y)
      ((Fama.commonShapeMk hM σ D hS layer hLayer hr hn hT).iota Y.plain hG s) =
    slotNCL D hS layer hLayer ((Fama.stShape γF hM σ Mk).iota hS hG s) := by
  let A := Famb.VineC.unitsStartΓ (Fama.alignedAssemblyMk γF hM σ Mk) (Fama.unitBlkMk_disj hM σ Mk) D hS layer hLayer
  let h := batchMolIso_spec hr.batch
  change stateNCL Y _ = _
  unfold Fama.commonShapeMk
  erw [cast_iota _ _ Y.plain ((Fama.stSt γF _ _ Mk').plain Y.plain), Fama.endpointShape_iotaMk]
  change spliceNCLMkLow Y (transportPrescription (batchMolIso hr.batch) σ) Mk' _ = _
  erw [batch_spliceNCLMkLow h σ hT (Fama.unitsFamily_isV0FamMk hM σ)]
  unfold spliceNCLMkLow
  erw [stateNCL_eq A layer hLayer rfl]
  rfl

end

