/-- The representative: no leaf child of a hinge paired with a cap root is attached at a leaf. -/
theorem rep_hinge_not_attLeafLow (c : GBranch (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.tree)
    (hc : ∃ j, (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).br c =
      (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).upper)
    (k : Fin 3) (ℓ : GLeaf (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.tree) (hℓ : ℓ.toNode = c.child k)
    (hpJ : ((Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.pair ℓ).1.1 ∈ J) :
    ¬ AttLeaf a.prime.data a.prime.prime.1
      ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).leaf ℓ) := by
  intro hatt
  obtain ⟨j, hj⟩ := hc
  let Φ := Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)
  have hd := Fama.unitBlkMk_disj (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)
  have hcj : c = Φ.hinge hd j := Φ.br_inj (hj.trans (Φ.br_hinge hd j).symm)
  rw [hcj] at hℓ
  obtain ⟨v, hv, hcfp⟩ := cfp_of_hinge_leaf Φ a.prime.data a.prime.prime.1 (sourceLayerLow a)
    (sourceLayer_isLayeringLow a) J hcapA hd j k ℓ hℓ hpJ hatt
  exact hrepU j v hv hcfp

include hy hG hcapA hcapY hrepU in

