/-- **The start Fama.VineA.PrescribedPrimeGarden.state γF of the run assembly is admissible** at every marked set `Mk` containing the marked `𝒱₀`
vines (`markILow ∩ 𝒱₀ ⊆ Mk`). -/
theorem startAt_admP_of_subLow {R : ℕ} (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat) (t s : ℝ)
    (kSel : Fin (2 * R) → Option ℕ) (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (Mk : Set (Fama.CLVineG γF a.prime.skeleton))
    (hMk : ∀ c ∈ markILow J pat t s kSel a.prime, c ∈ Fama.vinesV0 γF a.prime.skeleton a.totalSigma → c ∈ Mk) :
    AdmP R J pat t s kSel (startAtLow a Mk) := by
  intro i b hb hbne hprot
  obtain ⟨c, hc, hbc, hbu⟩ := startAt_nonUpper_vinesV0Low a Mk i hb hbne
  obtain ⟨x, hx, hxn⟩ := hprot
  have hpx := exists_protI_of_layered_eq (sourceLayer_reconstructsLow a) J pat t s kSel _ ⟨x, hx, hxn⟩
  have hm : c ∈ markILow J pat t s kSel a.prime :=
    ⟨Fama.vinesV0_subsetMk _ _ _ hc, b, hbc, hbu, hpx⟩
  exact (Fama.mem_vinesV0.mp hc).2 (hMk c hm (Fama.mem_vinesV0.mp hc).1)

end

