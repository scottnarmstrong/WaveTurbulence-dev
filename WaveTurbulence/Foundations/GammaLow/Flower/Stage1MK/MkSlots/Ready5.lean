variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}

/-- **Every non-upper atom of a member of the start family is a non-upper atom of a vine of `𝒱₀ \ Mk`.** -/
theorem startAt_nonUpper_vinesV0Low (a : Fama.VineA.PrescribedPrimeGarden γF w) (Mk : Set (Fama.CLVineG γF a.prime.skeleton))
    (i : Famb.VineC.UnitsIndexΓ (Fama.alignedAssemblyMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma Mk))
    {b : GBranch a.prime.skeleton.tree} (hb : b ∈ (startAtLow a Mk).family.atoms i)
    (hbne : b ≠ (startAtLow a Mk).family.upper i) :
    ∃ c ∈ Fama.vinesV0 γF a.prime.skeleton a.totalSigma Mk, b ∈ c.atoms ∧ b ≠ c.upper := by
  obtain ⟨j, k⟩ := i
  obtain ⟨c, hc, hca⟩ := alignedPiece_mem_vinesV0Low a.totalSigma Mk j k.1
  refine ⟨c, hc, ?_, ne_upper_of_pieceLow _ k.1 c hca hb hbne⟩
  rw [hca]
  exact hb

end

