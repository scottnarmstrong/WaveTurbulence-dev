open WaveTurbulence.RedSplice
open Finset WaveTurbulence WaveTurbulence.Mole TTree WaveTurbulence.Stage1 WaveTurbulence.LGSpine.SourceVine
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ} {G : Garden w}
variable {D' : Type} [Fintype D'] [DecidableEq D'] {N : Molecule (GBranch G.tree) D'}
  {S A L0 R0 : Finset (GBranch G.tree)} {a b x y : GBranch G.tree}
  {cls : GBranch G.tree → Option (GBranch G.tree)}

/-- **The vine residual** of a vine decomposed in the garden molecule, in any splice state. -/
theorem vine_objectStMKLow (st : SpState G) (H : SDecomp G.molecule st.cls S A L0 R0 a b x y)
    (hv : Src.IsSomeVine γF G.molecule A x y) :
    ∃ O : Src.Object γF st.G.molecule, O.atoms = A.image (st.M.pi st.hcls) ∧ O.upper = st.M.pi st.hcls x ∧
      O.lower = st.M.pi st.hcls y ∧ Src.IsSomeVine γF st.G.molecule O.atoms O.upper O.lower ∧
      ∃ h, O.shape = Src.VineLikeObject.vc h := by
  let I := H.inducedIso (st.M.toMol st.hcls)
  have hX := hv
  have hv' : Src.IsSomeVine γF st.G.molecule (A.image (st.M.pi st.hcls)) (st.M.pi st.hcls x)
      (st.M.pi st.hcls y) := Fama.isSomeVine_iso I hX
  exact ⟨⟨_, _, _, .vc ⟨(Src.isBlock_of_isSomeVine hv'), 1, Src.Chain.single hv'⟩⟩, rfl, rfl, rfl, hv', _, rfl⟩

end

