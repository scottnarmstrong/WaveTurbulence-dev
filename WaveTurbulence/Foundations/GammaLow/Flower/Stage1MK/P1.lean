/-- The runs and survivors chosen for a marked group (those of `Fama.groupUnitsMk γF` and `Fama.survivorsMk γF`). -/
noncomputable def markedUnitsOfMKLow {Mk : Set (Fama.CLVineG γF G)} {S : Finset (GBranch G.tree)} (h : Fama.markedGroup γF G Mk S) :
    Fama.MarkedGroupUnits γF G S Mk :=
  Classical.choice (Fama.exists_markedGroupUnits h)

end

