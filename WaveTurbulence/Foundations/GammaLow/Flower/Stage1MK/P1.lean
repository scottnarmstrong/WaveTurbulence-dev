variable {w : ℕ} {G : Garden w}
variable {σ : Prescription G} {Mk : Set (Fama.CLVineG γF G)}

/-- A unit meeting a group of `𝒞` is a unit of that group. -/
theorem unit_in_groupMKLow {S : Finset (GBranch G.tree)} (hS : S ∈ Fama.maximalGroupsG γF G.molecule) {u : CLBlock G}
    (hu : u ∈ Fama.unitBlocks γF G σ Mk) {v : GBranch G.tree} (hvu : v ∈ u.atoms) (hvS : v ∈ S) :
    u ∈ Fama.groupUnitsMk γF G Mk S := by
  obtain ⟨S', hS', -, hu'⟩ := Fama.mem_unitBlocksMk.mp hu
  by_cases hSS : S' = S
  · exact hSS ▸ hu'
  · exact absurd hvS (Finset.disjoint_left.mp (Fama.groups_disjoint' (Mole.garden_isMolecule G) hS' hS hSS)
      (Fama.groupUnitsMk_sub hu' hvu))

end

