/-- The units of a marked group are the chosen runs. -/
theorem groupUnitsMk_of_markedMKLow {Mk : Set (Fama.CLVineG γF G)} {S : Finset (GBranch G.tree)} (h : Fama.markedGroup γF G Mk S) :
    Fama.groupUnitsMk γF G Mk S = (markedUnitsOfMKLow h).runs := by
  classical
  unfold Fama.groupUnitsMk
  simp only [h, Fama.exists_markedGroupUnits h, ↓reduceIte, ↓reduceDIte]
  rfl

