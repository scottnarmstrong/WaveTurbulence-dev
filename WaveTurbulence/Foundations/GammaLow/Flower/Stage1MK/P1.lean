open WaveTurbulence.RedSplice
open Finset WaveTurbulence WaveTurbulence.Vine WaveTurbulence.Mole TTree WaveTurbulence.Stage1
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ} {G : Garden w}
variable {σ : Prescription G} {Mk : Set (Fama.CLVineG γF G)}

/-- The class of an atom of a unit lies in the unit (`Fama.class_in_unit` for every marked set). -/
theorem class_in_unitMKLow {u : CLBlock G} (hu : u ∈ Fama.unitBlocks γF G σ Mk) {v p : GBranch G.tree}
    (hv : v ∈ u.atoms) (h : ((Fama.stSt γF G σ Mk).cls p).getD p = ((Fama.stSt γF G σ Mk).cls v).getD v) : p ∈ u.atoms := by
  have hM := Mole.garden_isMolecule G
  rw [Fama.stSt_cls_memMk hM σ Mk hu hv, Option.getD_some] at h
  by_cases hp : ∃ u' ∈ Fama.unitBlocks γF G σ Mk, p ∈ u'.atoms
  · obtain ⟨u', hu', hpu'⟩ := hp
    rw [Fama.stSt_cls_memMk hM σ Mk hu' hpu', Option.getD_some] at h
    by_cases huu : u' = u
    · exact huu ▸ hpu'
    · exfalso
      have hdj := pairwise_symm_forallMK (fun x y h => Disjoint.symm h) (Fama.unitBlocks_pairwiseMk hM σ Mk)
        hu' hu huu
      exact Finset.disjoint_left.mp hdj u'.isBlock.2.1 (h ▸ u.isBlock.2.1)
  · push Not at hp
    rw [Fama.stSt_cls_noneMk hM σ Mk hp, Option.getD_none] at h
    exact h ▸ u.isBlock.2.1

end

