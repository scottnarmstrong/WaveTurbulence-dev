open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ} {G : Garden w}

/-- The survivors are the chosen survivors of the marked SG groups. -/
theorem mem_survivorsMk_iffMKLow {σ : Prescription G} {Mk : Set (Fama.CLVineG γF G)}
    {t : Finset (GBranch G.tree) × GBranch G.tree × GBranch G.tree} :
    t ∈ Fama.survivorsMk γF G σ Mk ↔ ∃ S, S ∈ Fama.maximalGroupsG γF G.molecule ∧ σ S = Molecule.GapKind.SG ∧
      ∃ h : Fama.markedGroup γF G Mk S, t ∈ (markedUnitsOfMKLow h).surv := by
  classical
  unfold Fama.survivorsMk
  rw [List.mem_flatMap]
  constructor
  · rintro ⟨S, hS, ht⟩
    obtain ⟨hSm, hσ⟩ := Fama.mem_sgGroups.mp hS
    by_cases h : Fama.markedGroup γF G Mk S
    · simp only [h, Fama.exists_markedGroupUnits h, ↓reduceIte, ↓reduceDIte] at ht
      exact ⟨S, hSm, hσ, h, ht⟩
    · simp [h] at ht
  · rintro ⟨S, hSm, hσ, h, ht⟩
    refine ⟨S, Fama.mem_sgGroups.mpr ⟨hSm, hσ⟩, ?_⟩
    simp only [h, Fama.exists_markedGroupUnits h, ↓reduceIte, ↓reduceDIte]
    exact ht

end

