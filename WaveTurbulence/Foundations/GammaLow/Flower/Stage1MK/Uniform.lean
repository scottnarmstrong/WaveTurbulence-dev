  have hBle : B ≤ ((2 ^ 5 * Kn ^ 4 : ℕ) : ℝ) ^ N * P.C₂ ^ (g + r) := by
    refine le_trans ?_ hfin
    have : (1 : ℝ) ≤ 2 ^ N := one_le_pow₀ (by norm_num)
    nlinarith
  have hfact : ((5 * r).factorial : ℝ) ≤ (((2 ^ 5 * Kn ^ 4 * 3 ^ 12) * r).factorial : ℝ) := by
    have : 5 ≤ 2 ^ 5 * Kn ^ 4 * 3 ^ 12 := by
