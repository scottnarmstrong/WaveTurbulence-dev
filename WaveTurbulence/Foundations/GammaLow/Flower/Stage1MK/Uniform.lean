/-- **The piece count at admissibility `True`, uniform** (I-ORPHANS' `pieceCount_of_repMkLow`). -/
theorem pieceCount_of_repMkULow (hcc : ClassCountMkULow) :
    ∃ C₀ K : ℕ, 2 ≤ C₀ ∧ ∀ (γF : ℝ) [Fact (γF ≤ 1 / 2)], PieceCountAtLow (γF := γF) C₀ K := by
  obtain ⟨C₀, K, hC₀, hmain⟩ := hcc
  refine ⟨C₀, K, hC₀, ?_⟩
  intro γF _ P hK p hp R hR N hN S rep M hrep hfib g r
  letI := S.fin
  set PS := (univ : Finset S.Pc).filter fun π => (S.piece π).gbar = g ∧ (S.piece π).rbar = r with hPS
  set A := PS.image rep with hA
  have hAc : (A.card : ℝ) ≤ (C₀ : ℝ) ^ N * (((C₀ * r).factorial : ℕ) : ℝ) * (((C₀ * R).factorial : ℕ) : ℝ) *
      P.C₂ ^ (g + r) := by
    refine hmain γF P hK p hp R hR N hN g r A fun LG hLG => ?_
    obtain ⟨π, hπ, hLGe⟩ := Finset.mem_image.1 hLG
    have hgr := (Finset.mem_filter.1 hπ).2
    obtain ⟨h1, h2⟩ := hrep π
    rw [← hLGe]
    refine ⟨h1, ?_⟩
    rw [← hgr.1, ← hgr.2]
    exact h2
  have hcard : PS.card ≤ M * A.card := by
    have := Finset.card_le_mul_card_image PS M fun LG _ => by
      refine le_trans (Finset.card_le_card ?_) (hfib LG)
      intro π hπ
      simp only [Finset.mem_filter] at hπ ⊢
      exact ⟨Finset.mem_univ _, hπ.2⟩
    simpa [hA, mul_comm] using this
  have hcardR : (PS.card : ℝ) ≤ (M : ℝ) * (A.card : ℝ) := by exact_mod_cast hcard
  exact hcardR.trans (mul_le_mul_of_nonneg_left hAc (Nat.cast_nonneg _))

/-- **The piece count, uniform in the family**: one pair of constants `C₀ ≥ 2`, `K` for every `𝒱_γ`, `γ ≤ 1/2`. -/
theorem exists_pieceCountAtULow :
    ∃ C₀ K : ℕ, 2 ≤ C₀ ∧ ∀ (γF : ℝ) [Fact (γF ≤ 1 / 2)], PieceCountAtLow (γF := γF) C₀ K :=
  pieceCount_of_repMkULow (classCount_of_legsMkULow decodeSizeLeg
    (skeletonLegMk_of_codeLegMkLow skeletonCodeLegMkLow) layeringLegMkULow)

end WaveTurbulence.GammaLow.Flower
