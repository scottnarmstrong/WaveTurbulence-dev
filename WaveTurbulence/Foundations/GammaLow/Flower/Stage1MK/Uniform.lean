  set U : LayeredGarden (2 * R) → List (CLBlock S) := fun LG => Fama.unitBlocks γF S (σf LG) (Mkf LG) with hU
  have hfib : A'.card = ∑ U0 ∈ A'.image U, (A'.filter (fun LG => U LG = U0)).card :=
