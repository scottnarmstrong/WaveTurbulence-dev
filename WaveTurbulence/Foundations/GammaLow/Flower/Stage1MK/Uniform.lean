      refine ⟨hcan LG hLA, hdf LG hLA, ?_⟩
      rw [← gbar_eq_gbarRHSMk (γ := γF) P.d hSpl LG (hdf LG hLA) (σf LGs) (Mkf LGs)]
      exact (gbar_rbar_eq_of_unitBlocks_eqMk (γ := γF) P.d hSpl LG (hdf LG hLA) (σf LG) (σf LGs) (Mkf LG) (Mkf LGs)
