  (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (hy : y ∈ Fama.sourceClass γF a p kind mk)
include hy

/-- **The shape of a run-class member**: B1b-3's common shape of the chosen full trace, the marking carried by its
image (`markTransported_imageMark`).  Unlike `sourceShapeMk`, it needs no member marking along every trace. -/
noncomputable def memShapeLow :
    SpliceShape (fun j => unitClBlock (y.2 j)) (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G :=
  Fama.commonShapeMk (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma a.prime.data a.prime.prime.1
    (sourceLayerLow a) (sourceLayer_isLayeringLow a)
    (Fama.class_member_traceMk (Mole.garden_isMolecule _) a.totalSigma a.prime.data a.prime.prime.1
      (sourceLayerLow a) (sourceLayer_isLayeringLow a) a.prime.prime y hy).choose_spec.2
    (Fama.class_member_traceMk (Mole.garden_isMolecule _) a.totalSigma a.prime.data a.prime.prime.1
      (sourceLayerLow a) (sourceLayer_isLayeringLow a) a.prime.prime y hy).choose_spec.1
    (markTransported_imageMarkLow _ (mk a.prime))

end

