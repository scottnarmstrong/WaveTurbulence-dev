open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w p : ℕ} {kind : Bool}
variable {R : ℕ} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R))
  (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (hy : y ∈ Fama.sourceClass γF a p kind mk)
include hy

/-- The trace data of a member's shape (main's `sourceShape_trace` at a marking). -/
theorem memShape_traceLow :
    ∃ (M : List (Famb.VineC.UnitsIndexΓ (Fama.sourceAssemblyMk γF a mk)))
      (hr : ReachU p kind (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk)).Q M (Fama.sourceStart γF a mk) (Fama.sourceUnitsMk γF a mk) y.1 y.2),
      (∀ c : GBranch (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.tree,
        (memShapeLow a mk y hy).br c =
          (batchMolIso hr.batch).e ((Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).M.ob c)) ∧
      ∀ j : Fin (Fama.unitBlocks γF a.prime.skeleton a.totalSigma (mk a.prime)).length,
        (y.2 j).blk.b = (batchMolIso hr.batch).e
          (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).lower := by
  obtain ⟨hn, hr⟩ := (Fama.class_member_traceMk (Mole.garden_isMolecule _) a.totalSigma a.prime.data a.prime.prime.1
    (sourceLayerLow a) (sourceLayer_isLayeringLow a) a.prime.prime y hy).choose_spec
  refine ⟨_, hr, fun c => Fama.commonShape_brMk _ _ _ _ _ _ hr hn _ c, fun j => ?_⟩
  exact (reachU_coordinates hr hn (batchMolIso_spec hr.batch) j).2.2

end

