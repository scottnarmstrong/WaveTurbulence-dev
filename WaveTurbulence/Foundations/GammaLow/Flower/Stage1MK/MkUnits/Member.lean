variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w p : ℕ} {kind : Bool}
variable {R : ℕ} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R))
  (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (hy : y ∈ Fama.sourceClass γF a p kind mk)
include hy

/-- The clock layers of the outer slots are common to the class (main's `sourceShape_clkLayer` at a marking). -/
theorem memShape_clkLayerLow (hG : (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.IsPlain)
    (s : ReplacementSlot (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G) (i : Fin 2) :
    clkLayer p (fun b => stateLayer y.1 (y.1.data.coreBranch y.1.plain b).toNode)
        (argSrc y.1.plain ((memShapeLow a mk y hy).iota y.1.plain hG s) i) =
      clkLayer p (fun b => sourceLayerLow a (a.prime.data.coreBranch a.prime.prime.1 b).toNode)
        (argSrc a.prime.prime.1
          ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).iota a.prime.prime.1 hG s)
          i) := by
  obtain ⟨M, hr, hbr, hlow⟩ := memShape_traceLow a mk y hy
  have hroute := congrFun (congrFun (memShape_routeLow a mk y hy hG) s) i
  rcases hr' : (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).route
      a.prime.prime.1 hG s i with y' | j
  · rw [hr'] at hroute
    rw [(memShapeLow a mk y hy).route_inl _ hG hroute,
      (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).route_inl _ hG hr']
    rcases y' with r | c
    · rfl
    · show stateLayer y.1 (y.1.data.coreBranch y.1.plain ((memShapeLow a mk y hy).br c)).toNode =
        sourceLayerLow a (a.prime.data.coreBranch a.prime.prime.1
          ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).br c)).toNode
      rw [memShape_core_layerLow, shape_core_layerMkLow]
  · rw [hr'] at hroute
    rw [(memShapeLow a mk y hy).route_inr _ hG hroute,
      (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).route_inr _ hG hr']
    show stateLayer y.1 (y.1.data.coreBranch y.1.plain (y.2 j).blk.b).toNode =
      sourceLayerLow a (a.prime.data.coreBranch a.prime.prime.1
        (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).lower).toNode
    rw [hlow j]
    exact member_core_layerMkLow a mk y M hr _

end

section
open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkUnits
open Finset TTree Reg Reg.Skeleton WaveTurbulence WaveTurbulence.RegRed WaveTurbulence.RedSplice WaveTurbulence.VineB WaveTurbulence.LGSpine WaveTurbulence.VineEstS2 WaveTurbulence.Stage1 WaveTurbulence.Vine WaveTurbulence.VineA WaveTurbulence.VineEstS4 WaveTurbulence.VineC WaveTurbulence.LFTwist WaveTurbulence.VineAlign WaveTurbulence.RegRedLeaf WaveTurbulence.Represents WaveTurbulence.VineA.PrescribedPrimeGarden
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w p : ℕ} {kind : Bool}
variable {R : ℕ} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R))
  (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (hy : y ∈ Fama.sourceClass γF a p kind mk)
include hy

/-- Main's `sourceShape_slotBox` at a marking. -/
theorem memShape_slotBoxLow (hG : (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.IsPlain)
    (s : ReplacementSlot (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G) :
    slotBox p (fun b => stateLayer y.1 (y.1.data.coreBranch y.1.plain b).toNode) y.1.plain
        ((memShapeLow a mk y hy).iota y.1.plain hG s) =
      slotBox p (fun b => sourceLayerLow a (a.prime.data.coreBranch a.prime.prime.1 b).toNode) a.prime.prime.1
        ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).iota a.prime.prime.1 hG s) := by
  rcases s with q | c
  · have h0 := memShape_clkLayerLow a mk y hy hG (Sum.inl q) 0
    have h1 := memShape_clkLayerLow a mk y hy hG (Sum.inl q) 1
    simp only [SpliceShape.iota] at h0 h1 ⊢
    simp only [slotBox, h0, h1]
  · have h0 := memShape_clkLayerLow a mk y hy hG (Sum.inr c) 0
    have h1 := memShape_clkLayerLow a mk y hy hG (Sum.inr c) 1
    simp only [SpliceShape.iota] at h0 h1 ⊢
    simp only [slotBox, h0, h1]

end

