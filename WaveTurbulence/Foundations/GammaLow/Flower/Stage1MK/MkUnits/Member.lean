open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w p d : ℕ} {kind : Bool} {ι : Type*}

/-- The weight layers of the arguments of the outer slots are common to the class (at a marking). -/
theorem memShape_wLayLow {R : ℕ} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R))
    (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (hy : y ∈ Fama.sourceClass γF a p kind mk)
    (hG : (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.IsPlain)
    (s : ReplacementSlot (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G) (i : Fin 2) (pw : ℕ) :
    wLay pw (fun b => stateLayer y.1 (y.1.data.coreBranch y.1.plain b).toNode)
        (argSrc y.1.plain ((memShapeLow a mk y hy).iota y.1.plain hG s) i) =
      wLay pw (fun b => sourceLayerLow a (a.prime.data.coreBranch a.prime.prime.1 b).toNode)
        (argSrc a.prime.prime.1
          ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).iota a.prime.prime.1 hG s)
          i) := by
  obtain ⟨M, hr, hbr, hlow⟩ := memShape_traceLow a mk y hy
  have hroute := congrFun (congrFun (memShape_routeLow a mk y hy hG) s) i
  rcases hr' : (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).route
      a.prime.prime.1 hG s i with y' | j
  · rw [hr'] at hroute
    rw [(memShapeLow a mk y hy).route_inl _ hG hroute,
      (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).route_inl _ hG hr']
    rcases y' with r | c
    · rfl
    · show stateLayer y.1 (y.1.data.coreBranch y.1.plain ((memShapeLow a mk y hy).br c)).toNode =
        sourceLayerLow a (a.prime.data.coreBranch a.prime.prime.1
          ((Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).br c)).toNode
      rw [memShape_core_layerLow, shape_core_layerMkLow]
  · rw [hr'] at hroute
    rw [(memShapeLow a mk y hy).route_inr _ hG hroute,
      (Fama.stShape γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).route_inr _ hG hr']
    show stateLayer y.1 (y.1.data.coreBranch y.1.plain (y.2 j).blk.b).toNode =
      sourceLayerLow a (a.prime.data.coreBranch a.prime.prime.1
        (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).lower).toNode
    rw [hlow j]
    exact member_core_layerMkLow a mk y M hr _

end

