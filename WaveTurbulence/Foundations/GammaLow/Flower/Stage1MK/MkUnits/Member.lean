open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w p : ℕ} {kind : Bool}

theorem member_core_layerMkLow (a : Fama.VineA.PrescribedPrimeGarden γF w) (mk : Fama.Stage1Mk.MarkFn γF w)
    (y : UState w (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (M : List (Famb.VineC.UnitsIndexΓ (Fama.sourceAssemblyMk γF a mk)))
    (hr : ReachU p kind (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk)).Q M (Fama.sourceStart γF a mk) (Fama.sourceUnitsMk γF a mk) y.1 y.2)
    (b : GBranch a.prime.skeleton.tree) :
    stateLayer y.1 (y.1.data.coreBranch y.1.plain ((batchMolIso hr.batch).e b)).toNode =
      sourceLayerLow a (a.prime.data.coreBranch a.prime.prime.1 b).toNode := by
  have h := BatchIso.coreLayer (batchMolIso_spec hr.batch) b
  rw [coreLayer_of_spec y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) y.1.layered
    (stateLayer_spec y.1)] at h
  rw [h]
  exact coreLayer_of_spec a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a)
    (Fama.sourceStart γF a mk).layered rfl _ b

end

