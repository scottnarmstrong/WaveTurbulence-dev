/-- The hinge-data constant of `hinge_units_constWL`, as a function of `(d, η)`. -/
def ChinFWLLow (d : ℕ) (η : ℝ) : ℝ :=
  if h : 0 ≤ η then (hinge_units_constWLLow d η h).choose else 0

end

