/-- The X-norm bound of a weighted unit class kernel, from the staged **`V5FrontierClassBoundAt`**. -/
theorem unit_vineest_boundWLLow {P : WTParams} [Fact (P.γ ≤ 1 / 2)] (hV : V5FrontierClassBoundAtLLow P) {p : ℕ} (hp : p < P.D)
    (h : ℕ → Mom P.d → ℝ) (B₀ : ℝ) (hB₀ : 0 ≤ B₀)
    (hh : ∀ r ≤ p, SNormR (40 * P.d) (40 * P.d) (h r) ≤ ENNReal.ofReal B₀)
    {w : ℕ} {G : Garden w} {U : Finset (GBranch G.tree)} {a b : GBranch G.tree} {R : CLRegionData G U a b}
    {n : ℕ} (hprime : IsPrimeGarden G) (hM9 : Famb.NormalChartSupply P.γ) (B : Famb.VineEstS2.CLChainAssemblyΓ P.γ G R n) (RD : ReconstructionData G)
    (hG : G.IsPlain) (layer : GNode (RD.forest hG) → ℕ) (hLayer : IsLayering (RD.garden hG) layer)
    (hcan : IsCanonGC (p + 1) (layeredReconstruction RD hG layer hLayer))
    (hord : (RD.garden hG).order ≤ P.N (p + 1) ^ 4) (hcl : clLocalOrder1 R ≤ P.N 1 ^ 4)
    (g : Fin w → Mom P.d → ℂ) (cψ : ℝ) (hc : 1 ≤ cψ) (hgp : ∀ j, GPresented (32 * P.d) (g j) cψ)
    (hre : ∀ j x, (g j x).im = 0) (S : List ℝ) (hS : ∀ s ∈ S, 0 < s) (centre : Fin 4 → Mom P.d) (wBar : Mom P.d)
    (lam : ℤ) :
    XNorm00Restr (2 * P.η ^ 8) (outBox (unitDLow hM9 B RD hG layer hLayer centre wBar))
      (outSet (unitDLow hM9 B RD hG layer hLayer centre wBar) P.L P.γ P.η)
      (fun t E => unitHkFWLLow P p S B RD hG layer hLayer g h wBar lam t (sumintBoundary (G.sign a.toNode) E)) ≤
    ENNReal.ofReal ((1 + |(lam : ℝ)|) ^ (6 * P.η ^ 6) * unitMassFWLLow P S hM9 B RD hG layer hLayer cψ B₀) := by
  have hb := hV hp h B₀ hB₀ hh hprime hM9 B RD hG layer hLayer (objKind w) (canonicalObject_of_isCanonGC hcan)
    (fun x => WaveTurbulence.Canon.layer_le_of_isCanonGC hcan x) hord hcl centre wBar (lam : ℝ) g cψ hc hgp hre S hS (Fama.Represents.rowCoherent_of_canonical hM9 B RD hG layer hLayer p hcan centre wBar P.L P.γ P.δ h)
  refine le_of_le_of_eq hb ?_
  have hA : 0 ≤ cψ ^ (9 * U.card + 4 * clLocalOrder2 RD hG R) * topFilterMass ^ S.length :=
    mul_nonneg (pow_nonneg (by linarith) _) (pow_nonneg topFilterMass_nonneg _)
  rw [← ENNReal.ofReal_mul hA]
  congr 1
  unfold unitMassFWLLow unitMassLow
  rw [step3D_M₁_constLow hM9 B RD hG layer hLayer centre (fun _ => (0 : Mom P.d)) wBar 0]
  ring

end

