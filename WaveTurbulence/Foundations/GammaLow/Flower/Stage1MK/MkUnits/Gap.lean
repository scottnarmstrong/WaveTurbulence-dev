open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkUnits
open Finset TTree Reg Reg.Skeleton WaveTurbulence WaveTurbulence.RegRed WaveTurbulence.RedSplice WaveTurbulence.VineB WaveTurbulence.LGSpine WaveTurbulence.VineEstS2 WaveTurbulence.Stage1 WaveTurbulence.Vine WaveTurbulence.VineA WaveTurbulence.VineEstS4 WaveTurbulence.VineC WaveTurbulence.LFTwist WaveTurbulence.VineAlign WaveTurbulence.RegRedLeaf WaveTurbulence.Represents WaveTurbulence.VineA.PrescribedPrimeGarden
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w p : ℕ} {kind : Bool}
variable {R : ℕ}

open scoped Classical in
/-- The literal gap indicator of the marked piece is the common selection (the `hgsp` hypothesis of main's
`representsIntA_of_vineModes`). -/
theorem normalizedPiece_gapIndicatorMkLow (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R)) {d : ℕ}
    (D : SplicedKernelData (a.normalizedPiece d (mk a.prime)).Gsb d)
    (hD : D.gapSpecification = (a.normalizedPiece d (mk a.prime)).gapSpecification)
    {L : ℝ} (hL : L ≠ 0) (γ η : ℝ) (base : Mom d) (roots : Fin (2 * R) → (Fin d → ℤ))
    (z : GenDecoration (a.normalizedPiece d (mk a.prime)).Gsb d roots 0) :
    splicedGapIndicator (a.normalizedPiece d (mk a.prime)).Gsb D L γ η base z.1 =
      if selSkCMkLow a mk L γ η hL base roots z then 1 else 0 := by
  rw [← gapValueMk_iteLow a mk L γ η hL base roots z]
  exact (gapValue_eq_indicatorMkLow a.totalSigma D hD L γ η base z.1).symm

end

