section
open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkUnits
open Finset TTree Reg Reg.Skeleton WaveTurbulence WaveTurbulence.RegRed WaveTurbulence.RedSplice WaveTurbulence.VineB WaveTurbulence.LGSpine WaveTurbulence.VineEstS2 WaveTurbulence.Stage1 WaveTurbulence.Vine WaveTurbulence.VineA WaveTurbulence.VineEstS4 WaveTurbulence.VineC WaveTurbulence.LFTwist WaveTurbulence.VineAlign WaveTurbulence.RegRedLeaf WaveTurbulence.Represents WaveTurbulence.VineA.PrescribedPrimeGarden
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w p : ℕ} {kind : Bool}
variable {R : ℕ}

/-- The common selection of `G_sb` at the marking: the gap functional of the fine′ class is `1`. -/
def selSkCMkLow (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R)) {d : ℕ} (L γ η : ℝ) (_hL : L ≠ 0)
    (base : Mom d) (roots : Fin (2 * R) → (Fin d → ℤ))
    (z : GenDecoration (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G d roots 0) : Prop :=
  gapValueMkLow a.prime.skeleton a.totalSigma (mk a.prime) L γ η base z.1 = 1

end

section
open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkUnits
open Finset TTree Reg Reg.Skeleton WaveTurbulence WaveTurbulence.RegRed WaveTurbulence.RedSplice WaveTurbulence.VineB WaveTurbulence.LGSpine WaveTurbulence.VineEstS2 WaveTurbulence.Stage1 WaveTurbulence.Vine WaveTurbulence.VineA WaveTurbulence.VineEstS4 WaveTurbulence.VineC WaveTurbulence.LFTwist WaveTurbulence.VineAlign WaveTurbulence.RegRedLeaf WaveTurbulence.Represents WaveTurbulence.VineA.PrescribedPrimeGarden
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w p : ℕ} {kind : Bool}
variable {R : ℕ}

open scoped Classical in
theorem gapValueMk_01Low (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R)) {d : ℕ} (L γ η : ℝ)
    (base : Mom d) (z : GNode (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G.tree → (Fin d → ℤ)) :
    gapValueMkLow a.prime.skeleton a.totalSigma (mk a.prime) L γ η base z = 0 ∨
      gapValueMkLow a.prime.skeleton a.totalSigma (mk a.prime) L γ η base z = 1 := by
  let D' : SplicedKernelData (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G d :=
    ⟨fun _ => 0, ∅, fun _ => 0, fun _ _ => 0, fun _ => 0,
      Fama.VineA.NormalizedSplice.gapSpecificationMk γF a.prime.skeleton a.totalSigma (mk a.prime), fun _ => 0, fun _ => 0⟩
  rw [gapValue_eq_indicatorMkLow a.totalSigma D' rfl L γ η base z]
  exact splicedGapIndicator_01 _ D' L γ η base z

end

section
open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkUnits
open Finset TTree Reg Reg.Skeleton WaveTurbulence WaveTurbulence.RegRed WaveTurbulence.RedSplice WaveTurbulence.VineB WaveTurbulence.LGSpine WaveTurbulence.VineEstS2 WaveTurbulence.Stage1 WaveTurbulence.Vine WaveTurbulence.VineA WaveTurbulence.VineEstS4 WaveTurbulence.VineC WaveTurbulence.LFTwist WaveTurbulence.VineAlign WaveTurbulence.RegRedLeaf WaveTurbulence.Represents WaveTurbulence.VineA.PrescribedPrimeGarden
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w p : ℕ} {kind : Bool}
variable {R : ℕ}

open scoped Classical in
theorem gapValueMk_iteLow (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R)) {d : ℕ} (L γ η : ℝ)
    (hL : L ≠ 0) (base : Mom d) (roots : Fin (2 * R) → (Fin d → ℤ))
    (z : GenDecoration (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G d roots 0) :
    gapValueMkLow a.prime.skeleton a.totalSigma (mk a.prime) L γ η base z.1 =
      if selSkCMkLow a mk L γ η hL base roots z then 1 else 0 := by
  rcases gapValueMk_01Low a mk L γ η base z.1 with h | h
  · rw [if_neg (by unfold selSkCMkLow; rw [h]; norm_num), h]
  · rw [if_pos (by unfold selSkCMkLow; exact h), h]

end

