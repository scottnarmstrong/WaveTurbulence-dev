open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkMark
open scoped Classical
open WaveTurbulence WaveTurbulence.Stage1 WaveTurbulence.LGSpine.SourceVine
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w : ℕ} {G : Garden w}

/-- **(B)+(C), group level.** If a group `S` of `𝒞` has gap kind `kind` (its designated object, main's
`groupGapKind`), then every block presentation `(T, p, q)` of an ingredient `T` of `S` has a gap of kind `kind` at `p`.
-/
theorem ingredient_blockGap_of_groupGapKindLow (hM : G.molecule.IsMolecule) {d : ℕ} (L γ η : ℝ) (base : Mom d)
    (c : GBranch G.tree → Mom d) (κ : GardenDart G → (Fin d → ℤ)) (hκ : G.molecule.IsDecoration L base c κ)
    (hc0 : ∀ v ∈ G.molecule.atoms, G.molecule.deg v = 4 → c v = 0)
    {S T : Finset (GBranch G.tree)} (hS : S ∈ Fama.maximalGroupsG γF G.molecule) {kind : Molecule.GapKind}
    (hk : Fama.VineA.NormalizedSplice.groupGapKind γF G L γ η base κ S = kind) (hI : Fama.IsIngredientG γF G.molecule S T)
    {p q : GBranch G.tree} (hT : G.molecule.IsBlock T p q) :
    ∃ r, G.molecule.IsBlockGap L base κ T p r ∧ Molecule.gapKind L γ η r = kind := by
  obtain ⟨a, O, hdes, hO⟩ := designated_hasGapKindLow L γ η base κ hS
  rw [hk] at hO
  have hvl : ∃ a b, Src.IsHV γF G.molecule S a b ∨ Src.IsVC γF G.molecule S a b ∨ Src.IsHVC γF G.molecule S a b := by
    rcases isIngredient_vc_or_hvcLow hI with ⟨a, b, h⟩ | ⟨a, b, h⟩
    · exact ⟨a, b, Or.inr (Or.inl h)⟩
    · exact ⟨a, b, Or.inr (Or.inr h)⟩
  exact ingredient_blockGap_kindLow hM L γ η base c κ hκ hc0 O (desig_atoms_eqLow hdes hvl) hO hI hT

end

