section
open WaveTurbulence.Stage1
open Finset
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {V D : Type} [DecidableEq V] [Fintype D] [DecidableEq D] {M : Molecule V D} {d : ℕ}

/-- TARGET L1939: if `B` is concatenated by blocks `B_j`, every ingredient `A` has the gap of `B`
(up to the sign recorded by its two joints). -/
theorem ingredient_gap_eqLow (hM : M.IsMolecule) {U A : Finset V} {a b x y : V} {n : ℕ}
    (h : Fama.ChainIngredientG γF M U a b n A x y) (hU : M.IsBlock U a b) {L : ℝ} {w : Mom d}
    {c : V → Mom d} {κ : D → (Fin d → ℤ)} (hκ : M.IsDecoration L w c κ)
    (hc : ∀ v ∈ M.atoms, M.deg v = 4 → c v = 0) {rU rx ry : Mom d}
    (hrU : M.IsBlockGap L w κ U a rU) (hrx : M.IsBlockGap L w κ A x rx)
    (hry : M.IsBlockGap L w κ A y ry) : rx = rU ∧ ry = -rU := by
  have hk (z : D) : Molecule.kvec L w κ (M.mate z) = Molecule.kvec L w κ z := by
    simp only [Molecule.kvec, hκ.1 z]
  have hcc : ∀ v ∈ M.atoms, M.deg v = 4 →
      ∑ z ∈ M.dartsAt v, M.dartSign z • Molecule.kvec L w κ z = 0 :=
    fun v hv hd => (hκ.2 v hv).trans (hc v hv hd)
  obtain ⟨h1, h2⟩ := Fama.chainIngredient_flow_eq M hM (Molecule.kvec L w κ) hk hcc h hU
  obtain ⟨hAB, _, _⟩ := Fama.chainIngredientG_spec h
  have hAblock : M.IsBlock A x y := by
    obtain ⟨_, hY, _⟩ := Fama.chainIngredientG_spec h
    exact Src.isBlock_of_isSomeVine hY
  have e1 := Vine.groupGap_eq_flow M (Mole.block_joint_degrees M hAblock).1 hrx
  have e2 := Vine.groupGap_eq_flow M (Mole.block_joint_degrees M hAblock).2 hry
  have e3 := Vine.groupGap_eq_flow M (Mole.block_joint_degrees M hU).1 hrU
  exact ⟨by rw [e1, e3, h1], by rw [e2, e3, h2]⟩

end

section
open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkMark
open scoped Classical
open WaveTurbulence WaveTurbulence.Stage1 WaveTurbulence.LGSpine.SourceVine
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {V D : Type} [DecidableEq V] [Fintype D] [DecidableEq D] {M : Molecule V D}

/-- **(B)+(C), molecule level.** Let `O` be an object on the atoms of a group `S` whose gap has kind `kind`. Then every
block presentation `(T, p, q)` of an ingredient `T` of `S` has a gap of kind `kind` at `p`. -/
theorem ingredient_blockGap_kindLow (hM : M.IsMolecule) {d : ℕ} (L γ η : ℝ) (base : Mom d) (c : V → Mom d)
    (κ : D → (Fin d → ℤ)) (hκ : M.IsDecoration L base c κ) (hc0 : ∀ v ∈ M.atoms, M.deg v = 4 → c v = 0)
    {S T : Finset V} (O : Src.Object γF M) (hOS : O.atoms = S) {kind : Molecule.GapKind}
    (hO : O.HasGapKind L γ η base κ kind) (hI : Fama.IsIngredientG γF M S T) {p q : V} (hT : M.IsBlock T p q) :
    ∃ r, M.IsBlockGap L base κ T p r ∧ Molecule.gapKind L γ η r = kind := by
  rcases hI with ⟨a, b, n, x, y, hB, hI⟩ | ⟨a, b, e, n, x, y, he, hn, hB, hI⟩
  · -- VC: the designated object is the ordinary block `S`
    obtain ⟨_, hX, _⟩ := Fama.chainIngredientG_spec hI
    have hTxy : M.IsBlock T x y := (Src.isBlock_of_isSomeVine hX)
    obtain ⟨r, hr, hk⟩ := hO
    unfold Src.VineLikeObject.IsGap at hr
    rcases O with ⟨OA, Ou, Ol, Osh⟩
    change OA = S at hOS
    subst hOS
    cases Osh with
    | hyper R => exact (VineA.block_not_hyper hB R.added R.ends_eq R.adjoint.1).elim
    | vc hv =>
      obtain ⟨rU, hrU, hkU⟩ :=
        (VineA.block_gapKind_joint_iff hM hv.1 hB L γ η base c κ hκ hc0 kind).mp ⟨r, hr, hk⟩
      obtain ⟨rx, hrx⟩ := LGSpine.source_block_joint_gap_exists M hTxy (Or.inl rfl) L base κ
      obtain ⟨ry, hry⟩ := LGSpine.source_block_joint_gap_exists M hTxy (Or.inr rfl) L base κ
      obtain ⟨hx, -⟩ := ingredient_gap_eqLow hM hI hB hκ hc0 hrU hrx hry
      exact (VineA.block_gapKind_joint_iff hM hTxy hT L γ η base c κ hκ hc0 kind).mp ⟨rx, hrx, hx ▸ hkU⟩
  · -- HVC: the designated object is the hyper object with the same deleted bond up to mates
    obtain ⟨_, hX, _⟩ := Fama.chainIngredientG_spec hI
    have hch := Fama.VineA.NormalizedSplice.chain_ofVine (Fama.chainIngredientG_spec hI).1
    have hHVC : Src.IsHVC γF M S a b := ⟨e, he, hB, n, hn, hch⟩
    let Q : Src.Object γF M := ⟨S, a, b, .hyper ⟨e, he, ⟨hB, n, hch⟩⟩⟩
    have hQ : Q.HasGapKind L γ η base κ kind :=
      (Fama.VineA.objects_gapKind_iff_of_HVC hM O Q hOS (hOS ▸ hHVC) L γ η base c κ hκ hc0 kind).mp hO
    obtain ⟨rU, hrU, hkU⟩ := hQ
    have hne := atom_ne_of_ends he hB.2.2.2.1
    have hN := Vine.eraseBond_isMolecule M hM e hne
    obtain ⟨cN, hκN, hcN⟩ := Vine.eraseBond_decoration_exists M hM e hne L base c κ hκ hc0
    obtain ⟨rx, hrx⟩ := LGSpine.source_block_joint_gap_exists _ (Src.isBlock_of_isSomeVine hX) (Or.inl rfl) L base (fun z => κ z.1)
    obtain ⟨ry, hry⟩ := LGSpine.source_block_joint_gap_exists _ (Src.isBlock_of_isSomeVine hX) (Or.inr rfl) L base (fun z => κ z.1)
    obtain ⟨hx, -⟩ := ingredient_gap_eqLow hN hI hB hκN hcN hrU hrx hry
    have hnot : ¬ M.InGroup T e := RedSplice.not_inGroup_of_ends M he (ingredient_not_bothLow hI hn)
    let F := Vine.eraseBond_local_embedding M e T hnot
    have hTxyM : M.IsBlock T x y := (F.isBlock_iff T (subset_refl T) x y).mp (Src.isBlock_of_isSomeVine hX)
    have hrxM : M.IsBlockGap L base κ T x rx := (F.blockGap_iff T (subset_refl T) L base κ x rx).mp hrx
    exact (VineA.block_gapKind_joint_iff hM hTxyM hT L γ η base c κ hκ hc0 kind).mp ⟨rx, hrxM, hx ▸ hkU⟩

end

