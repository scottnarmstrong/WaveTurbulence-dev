theorem memberTopW_applyLow {R d : ℕ} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R))
    (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (hy : y ∈ Fama.sourceClass γF a p kind mk)
    (SU : Fin (Fama.unitBlocks γF a.prime.skeleton a.totalSigma (mk a.prime)).length → List ℝ) (j) :
    memberTopWLow (d := d) y SU (y.2 j).blk.a = topFilterWeightL (SU j) :=
  topWeightOf_apply (top := fun j => (y.2 j).blk.a) (upper_injective (Fama.source_disjMk a mk y hy)) SU j

