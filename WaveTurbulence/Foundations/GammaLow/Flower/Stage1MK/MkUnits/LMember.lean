/-- The top weight of a run-class member: `topFilterWeightL (SU j)` at the top of its unit `j`. -/
abbrev memberTopWLow {R d : ℕ} {a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)} {mk : Fama.Stage1Mk.MarkFn γF (2 * R)}
    (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk)))
    (SU : Fin (Fama.unitBlocks γF a.prime.skeleton a.totalSigma (mk a.prime)).length → List ℝ) :
    GBranch y.1.skeleton.tree → (Fin 4 → Mom d) → ℂ :=
  topWeightOf (fun j => (y.2 j).blk.a) SU

end

