/-- For a run-class member, the generic unit factor of the weighted slot family with the member's top filters is
V5W-2L's pinned `unitRecenteredFWL` (B3's `member_ker_eqWMk` with `SU`). -/
theorem member_ker_eqWMkLLow {R d : ℕ} (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R))
    (y : UState (2 * R) (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (hy : y ∈ Fama.sourceClass γF a p kind mk) (L γ δ : ℝ)
    (h : ℕ → Fin (2 * R) → Fin (2 * R) → Mom d → ℝ) (base : Mom d) (g : Fin (2 * R) → Mom d → ℂ)
    (hcan : IsCanonGC (p + 1) y.1.layered) (hlay : ∀ x, stateLayer y.1 x ≤ p)
    (SU : Fin (Fama.unitBlocks γF a.prime.skeleton a.totalSigma (mk a.prime)).length → List ℝ) :
    unitKernelMGW (fun j => unitClBlock (y.2 j)) y.1.data y.1.plain
        (slotFWW y.1.data y.1.plain (stateLayer y.1) (stateLayer_isLayering y.1) L γ δ h p g (memberTopWLow y SU))
        L γ δ (stateLayer y.1) base =
      fun (j : Fin (Fama.unitBlocks γF a.prime.skeleton a.totalSigma (mk a.prime)).length) (lam : ℤ) (t : Fin 3 → ℝ)
          (k : Fin 4 → Mom d) =>
        unitRecenteredFWL p
          (g (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).upper.1.1) (SU j)
          y.1 (y.2 j) L γ δ
          (unitProfile (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)) h j) base
          (modW lam) (t 0) (t 1) (t 2) (k 0) (k 1) (k 2) (k 3) := by
  funext j lam t k
  rw [unitKernelMG_slotFWW_eq y.1 y.2 (stateLayer y.1) (stateLayer_isLayering y.1) (stateLayer_spec y.1) L γ δ h p g
    base hcan hlay (memberTopWLow y SU) SU (fun j => memberTopW_applyLow a mk y hy SU j) j lam t k]
  have hidx := Fama.source_upper_tree_indexMk a mk y hy j
  have h1 : unitProfile (fun j => unitClBlock (y.2 j)) h j =
      unitProfile (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)) h j := by
    funext q
    unfold unitProfile
    exact congrArg₂ (fun u v => h q u v) hidx hidx
  have h2 : g (y.2 j).blk.a.1.1 =
      g (Fama.unitBlkMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime) j).upper.1.1 :=
    congrArg g hidx
  rw [h1, h2]

end

