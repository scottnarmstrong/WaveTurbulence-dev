/-- **The class level, generic in the member set** (weighted copy of `Cont.classSumMod_continuousOn`). -/
theorem classSumFWL_continuousOnLow {P : WTParams} [Fact (P.γ ≤ 1 / 2)] (lam : ℝ)
    (hgate : CoherentGateH P) (hinc : IncoherentGateH P) (htop : TopIncoherentDecayAtR P)
    (hd : 1 ≤ P.d) (hη0 : 0 < P.η) (hη6 : 6 * P.η ^ 6 ≤ P.η) (hη2 : P.η ≤ 1 / 2)
    (hC : 1 ≤ P.C₁) (hδ : 0 < P.δ) (hL : 1 ≤ P.L) (hw : 0 ≤ P.gamma1 - Real.sqrt P.η)
    {p : ℕ} (hp : p < P.D) {h : ℕ → Mom P.d → ℝ} {Bh : ℕ → ℝ}
    (hB : ProfileBound P h Bh p) (hBpos : ∀ r ≤ p, 0 < Bh r)
    {kind : Bool} {A : FamilyReconstruction w ι} {c : ChainAt A.skeleton A.family} {n : ℕ}
    {R0 : CLRegionData A.skeleton c.U c.a c.b} (hM9 : Famb.NormalChartSupply P.γ) (B0 : Famb.VineEstS2.CLChainAssemblyΓ P.γ A.skeleton R0 n)
    (lA : GNode (A.data.forest A.plain) → ℕ) (hLA : IsLayering (A.data.garden A.plain) lA) (hlA : stateLayer A = lA)
    (hAlay : ∀ x, lA x ≤ p) (hAord : A.layered.garden.order ≤ P.N (p + 1) ^ 4)
    (bk0 : Fin (Famb.VineEstS2.assemblyShapeΓ hM9 B0).I → Fin 4) (q0 : Fin 3 → ℕ) (centre : Fin 4 → Mom P.d) (wBar : Mom P.d)
    (hq0 : q0 0 = lA (A.data.coreBranch A.plain c.a).toNode)
    (hqle1 : (q0 1 : ℝ) ≤ Famb.VineEstS2.assemblyTimeQΓ hM9 B0 (fun v => lA (A.data.coreBranch A.plain v).toNode)
        (.inl ⟨⟨0, Famb.VineEstS2.assemblyShape_I_posΓ hM9 B0⟩, 0⟩))
    (hqle2 : (q0 2 : ℝ) ≤ Famb.VineEstS2.assemblyTimeQΓ hM9 B0 (fun v => lA (A.data.coreBranch A.plain v).toNode)
        (.inl ⟨⟨0, Famb.VineEstS2.assemblyShape_I_posΓ hM9 B0⟩, 0⟩))
    (H : Famb.VineEstS3.RowCoherentΓ hM9 B0 A.data A.plain lA hLA
      (Famb.VineEstS3.step3WΓ hM9 B0 A.data A.plain lA hLA bk0 q0 centre wBar) P.L P.γ P.δ h p)
    (g : Mom P.d → ℂ) (cψ : ℝ) (hcψ : 1 ≤ cψ) (hgP : GPresented (32 * P.d) g cψ) (S : List ℝ)
    (Z : Finset (Σ Bs : FamilyReconstruction w ι, ChainAt Bs.skeleton Bs.family))
    (hZ : ∀ x ∈ Z, ∃ M : List ι, Reach p kind M A c x.1 x.2) :
    ∀ E ∈ outSet (Famb.VineEstS3.step3DΓ hM9 B0 A.data A.plain lA hLA bk0 q0 centre wBar) P.L P.γ P.η,
      ContinuousOn (fun tt : Fin 3 → ℝ => twistedRecenteredFWL p g S A.skeleton c.a Z P.L P.γ P.δ h wBar (modW lam)
          (tt 0) (tt 1) (tt 2) (sumintBoundary (A.skeleton.sign c.a.toNode) E 0)
          (sumintBoundary (A.skeleton.sign c.a.toNode) E 1) (sumintBoundary (A.skeleton.sign c.a.toNode) E 2)
          (sumintBoundary (A.skeleton.sign c.a.toNode) E 3)) (cubeSet q0) := by
  intro E hE
  have hsum : (fun tt : Fin 3 → ℝ => twistedRecenteredFWL p g S A.skeleton c.a Z P.L P.γ P.δ h wBar (modW lam)
          (tt 0) (tt 1) (tt 2) (sumintBoundary (A.skeleton.sign c.a.toNode) E 0)
          (sumintBoundary (A.skeleton.sign c.a.toNode) E 1) (sumintBoundary (A.skeleton.sign c.a.toNode) E 2)
          (sumintBoundary (A.skeleton.sign c.a.toNode) E 3)) =
      fun tt => ∑ x ∈ Z, recPhase (A.skeleton.sign c.a.toNode) P.L P.γ P.δ (tt 0)
          (sumintBoundary (A.skeleton.sign c.a.toNode) E 0) (sumintBoundary (A.skeleton.sign c.a.toNode) E 1)
          (sumintBoundary (A.skeleton.sign c.a.toNode) E 2) (sumintBoundary (A.skeleton.sign c.a.toNode) E 3) *
        twistedLocalKernelFWL p g S x.1 x.2 P.L P.γ P.δ h wBar (modW lam) (tt 0) (tt 1) (tt 2)
          (sumintBoundary (A.skeleton.sign c.a.toNode) E 0) (sumintBoundary (A.skeleton.sign c.a.toNode) E 1)
          (sumintBoundary (A.skeleton.sign c.a.toNode) E 2) (sumintBoundary (A.skeleton.sign c.a.toNode) E 3) :=
    funext fun tt => twistedRecenteredFWL_eq_sum p g S A.skeleton c.a Z _ _ _ _ _ _ _ _ _ _ _ _ _
  rw [hsum]
  exact continuousOn_finsetSum _ fun x hx => by
    obtain ⟨M, hM⟩ := hZ x hx
    exact memberFWL_continuousOnLow lam hgate hinc htop hd hη0 hη6 hη2 hC hδ hL hw hp hB hBpos hM hM9 B0 lA hLA hlA
      hAlay hAord bk0 q0 centre wBar hq0 hqle1 hqle2 H g cψ hcψ hgP S E hE

end

