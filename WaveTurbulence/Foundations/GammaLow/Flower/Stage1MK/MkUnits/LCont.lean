/-- **One member of the class** (weighted copy of `Cont.memberMod_continuousOn`). -/
theorem memberFWL_continuousOnLow {P : WTParams} [Fact (P.γ ≤ 1 / 2)] (lam : ℝ)
    (hgate : CoherentGateH P) (hinc : IncoherentGateH P) (htop : TopIncoherentDecayAtR P)
    (hd : 1 ≤ P.d) (hη0 : 0 < P.η) (hη6 : 6 * P.η ^ 6 ≤ P.η) (hη2 : P.η ≤ 1 / 2)
    (hC : 1 ≤ P.C₁) (hδ : 0 < P.δ) (hL : 1 ≤ P.L) (hw : 0 ≤ P.gamma1 - Real.sqrt P.η)
    {p : ℕ} (hp : p < P.D) {h : ℕ → Mom P.d → ℝ} {Bh : ℕ → ℝ}
    (hB : ProfileBound P h Bh p) (hBpos : ∀ r ≤ p, 0 < Bh r)
    {kind : Bool} {M : List ι} {A Bs : FamilyReconstruction w ι}
    {c : ChainAt A.skeleton A.family} {c' : ChainAt Bs.skeleton Bs.family} (hr : Reach p kind M A c Bs c') {n : ℕ}
    {R0 : CLRegionData A.skeleton c.U c.a c.b} (hM9 : Famb.NormalChartSupply P.γ) (B0 : Famb.VineEstS2.CLChainAssemblyΓ P.γ A.skeleton R0 n)
    (lA : GNode (A.data.forest A.plain) → ℕ) (hLA : IsLayering (A.data.garden A.plain) lA) (hlA : stateLayer A = lA)
    (hAlay : ∀ x, lA x ≤ p) (hAord : A.layered.garden.order ≤ P.N (p + 1) ^ 4)
    (bk0 : Fin (Famb.VineEstS2.assemblyShapeΓ hM9 B0).I → Fin 4) (q0 : Fin 3 → ℕ) (centre : Fin 4 → Mom P.d) (wBar : Mom P.d)
    (hq0 : q0 0 = lA (A.data.coreBranch A.plain c.a).toNode)
    (hqle1 : (q0 1 : ℝ) ≤ Famb.VineEstS2.assemblyTimeQΓ hM9 B0 (fun v => lA (A.data.coreBranch A.plain v).toNode)
        (.inl ⟨⟨0, Famb.VineEstS2.assemblyShape_I_posΓ hM9 B0⟩, 0⟩))
    (hqle2 : (q0 2 : ℝ) ≤ Famb.VineEstS2.assemblyTimeQΓ hM9 B0 (fun v => lA (A.data.coreBranch A.plain v).toNode)
        (.inl ⟨⟨0, Famb.VineEstS2.assemblyShape_I_posΓ hM9 B0⟩, 0⟩))
    (H : Famb.VineEstS3.RowCoherentΓ hM9 B0 A.data A.plain lA hLA
      (Famb.VineEstS3.step3WΓ hM9 B0 A.data A.plain lA hLA bk0 q0 centre wBar) P.L P.γ P.δ h p)
    (g : Mom P.d → ℂ) (cψ : ℝ) (hcψ : 1 ≤ cψ) (hgP : GPresented (32 * P.d) g cψ) (S : List ℝ) :
    ∀ E ∈ outSet (Famb.VineEstS3.step3DΓ hM9 B0 A.data A.plain lA hLA bk0 q0 centre wBar) P.L P.γ P.η,
      ContinuousOn (fun tt : Fin 3 → ℝ => recPhase (A.skeleton.sign c.a.toNode) P.L P.γ P.δ (tt 0)
          (sumintBoundary (A.skeleton.sign c.a.toNode) E 0) (sumintBoundary (A.skeleton.sign c.a.toNode) E 1)
          (sumintBoundary (A.skeleton.sign c.a.toNode) E 2) (sumintBoundary (A.skeleton.sign c.a.toNode) E 3) *
        twistedLocalKernelFWL p g S Bs c' P.L P.γ P.δ h wBar (modW lam)
          (tt 0) (tt 1) (tt 2) (sumintBoundary (A.skeleton.sign c.a.toNode) E 0)
          (sumintBoundary (A.skeleton.sign c.a.toNode) E 1) (sumintBoundary (A.skeleton.sign c.a.toNode) E 2)
          (sumintBoundary (A.skeleton.sign c.a.toNode) E 3))
        (cubeSet q0) := by
  classical
  subst hlA
  obtain rfl := regionData_subsingleton R0 (clRegionData A.skeleton c.block c.cl)
  obtain ⟨e, B1, hc, ha, hb, hU, hl⟩ := Famb.VineEstS4.Reach.exists_asmΓ hr B0
  have hlayB : ∀ x, stateLayer Bs x ≤ p := reach_stateLayer_le hr hAlay
  have hI1 := Famb.VineEstS2.assemblyShape_I_posΓ hM9 B1
  set bk1 : Fin (Famb.VineEstS2.assemblyShapeΓ hM9 B1).I → Fin 4 := Famb.VineEstS3.canonBadKindΓ hM9 B1 Bs.data Bs.plain (stateLayer Bs) with hbk1
  have hbad2 : ∀ i, bk1 i ≠ 2 := fun i => by
    rcases Famb.VineEstS3.canonBadKind_casesΓ hM9 B1 Bs.data Bs.plain (stateLayer Bs) i with h0 | h0 <;> rw [hbk1, h0] <;> decide
  have hq1 : q0 0 = stateLayer Bs (Bs.data.coreBranch Bs.plain c'.a).toNode := by
    rw [hq0, ← ha]
    exact (hl c.a).symm
  have hrc := Famb.VineEstS4.Reach.rowCoherentΓ hM9 hr B0 B1 bk0 q0 bk1 q0 centre wBar hq0 hq1 P.L P.γ P.δ h H
  have hsz : Famb.VineEstS3.RowSizesΓ hM9 B1 Bs.data Bs.plain (P.N (p + 1) ^ 4) :=
    Famb.VineEstS4.rowSizes_of_stateΓ hM9 Bs B1 (by rw [hr.order_eq]; exact hAord)
  have hel := fun v => Famb.VineEstS3.eligible_ofΓ hM9 B1 Bs.data Bs.plain (stateLayer Bs) (stateLayer_isLayering Bs)
    (Famb.VineEstS3.step3WΓ hM9 B1 Bs.data Bs.plain (stateLayer Bs) (stateLayer_isLayering Bs) bk1 q0 centre wBar) rfl hq1 P.L P.γ P.δ
    h (P.N (p + 1) ^ 4) p hlayB hsz hrc v
  have hfirst : Famb.VineEstS2.assemblyTimeQΓ hM9 B1 (fun v => stateLayer Bs (Bs.data.coreBranch Bs.plain v).toNode)
        (.inl ⟨⟨0, hI1⟩, 0⟩) =
      Famb.VineEstS2.assemblyTimeQΓ hM9 B0 (fun v => stateLayer A (A.data.coreBranch A.plain v).toNode)
        (.inl ⟨⟨0, Famb.VineEstS2.assemblyShape_I_posΓ hM9 B0⟩, 0⟩) := by
    rw [Famb.VineEstS3.assemblyTimeQ_firstΓ hM9 B1 Bs.data Bs.plain (stateLayer Bs) hI1,
      Famb.VineEstS3.assemblyTimeQ_firstΓ hM9 B0 A.data A.plain (stateLayer A) (Famb.VineEstS2.assemblyShape_I_posΓ hM9 B0)]
    have := hl c.b
    rw [hb] at this
    exact_mod_cast this
  have hgn : ∀ x, ‖g x‖ ≤ cψ := fun x => GPresented.norm_le hgP (by linarith) x
  have key := clRecenteredFW_continuousOnLow lam hgate hinc htop hd hη0 hη6 hη2 hC hδ hL hw hp hB hBpos hM9 B1 Bs.data
    Bs.plain (stateLayer Bs) (stateLayer_isLayering Bs) hlayB q0 hq1 centre wBar bk1 hbad2 hel
    (Or.inr (hfirst ▸ hqle1)) (Or.inr (hfirst ▸ hqle2)) g cψ hcψ hgP
    (regionWeightFWL p g S P.L wBar Bs c'.U c'.a) _ (pow_nonneg (by linarith) _)
    (fun z => norm_regionWeightFWL_le p g S P.L wBar Bs c'.U c'.a cψ hcψ hgn z)
  intro E hE
  have hsign : Bs.skeleton.sign c'.a.toNode = A.skeleton.sign c.a.toNode := hr.sign_a
  have := key E hE
  rw [hsign] at this
  exact this

end

