open WaveTurbulence.VineEstS5C WaveTurbulence.VineEstS5C.Cont WaveTurbulence.VineC WaveTurbulence.VineSpaceK WaveTurbulence.Flower.Stage1W WaveTurbulence.Flower.V5W
open WaveTurbulence.Flower.V5W2L (topFilterWeightL regionWeightFWL twistedLocalKernelFWL twistedRecenteredFWL)
open scoped ENNReal
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w : ℕ} {ι : Type*}

/-- **T5: continuity of the weighted class kernel** (weighted `Cont.twistedRecenteredModC_continuousOn`). -/
theorem weightedClassContinuityLLow : WeightedClassContinuityLLow := by
  intro w kind P _ lam hgate hinc htop hd hη0 hη6 hη2 hC hδ hL hw p hp h Bh hB hBpos G U a b R n hprime hM9 B RD hG
    layer hLayer hlay hord centre wBar g cψ hcψ hgP _hreal S _hS H
  have hZ : ∀ x ∈ canonFinsetK p kind (Famb.VineEstS4.startStateΓ B RD hG layer hLayer) (Famb.VineEstS4.chainStartΓ B),
      ∃ M : List _, Reach p kind M (Famb.VineEstS4.startStateΓ B RD hG layer hLayer) (Famb.VineEstS4.chainStartΓ B) x.1 x.2 := fun x hx => by
    obtain ⟨M, _, hM⟩ := (mem_canonFinset hprime).1 hx
    exact ⟨M, hM⟩
  have hI := Famb.VineEstS2.assemblyShape_I_posΓ hM9 B
  exact classSumFWL_continuousOnLow lam (A := Famb.VineEstS4.startStateΓ B RD hG layer hLayer) (c := Famb.VineEstS4.chainStartΓ B) hgate hinc htop hd
    hη0 hη6 hη2 hC hδ hL hw hp hB hBpos hM9 B layer hLayer (Famb.VineEstS5C.Cont.stateLayer_startΓ B RD hG layer hLayer) hlay hord
    (Famb.VineEstS3.canonBadKindΓ hM9 B RD hG layer) (qOutOf RD hG layer a b R) centre wBar rfl
    (Famb.VineEstS3.qOutOf_one_leΓ hM9 B RD hG layer hLayer hI) (Famb.VineEstS3.qOutOf_two_leΓ hM9 B RD hG layer hLayer hI)
    H g cψ hcψ hgP S _ hZ

end

