/-- **`hind`** for the weighted unit kernel (main's `unitHk_hind`). -/
theorem unitHkFWL_hindLow (P : WTParams) [Fact (P.γ ≤ 1 / 2)] (p : ℕ) (S : List ℝ) {G : Garden w} {U : Finset (GBranch G.tree)}
    {a b : GBranch G.tree} {R : CLRegionData G U a b} {n : ℕ} (B : Famb.VineEstS2.CLChainAssemblyΓ P.γ G R n)
    (RD : ReconstructionData G) (hG : G.IsPlain) (layer : GNode (RD.forest hG) → ℕ)
    (hLayer : IsLayering (RD.garden hG) layer) (g : Fin w → Mom P.d → ℂ) (h : ℕ → Mom P.d → ℝ) (wBar : Mom P.d)
    (leaf : Fin 3 → Prop) (hl0 : ¬ leaf 0)
    (hleaf1 : leaf 1 → ∀ x ∈ canonFinsetK p (objKind w) (Famb.VineEstS4.startStateΓ B RD hG layer hLayer) (Famb.VineEstS4.chainStartΓ B),
      (x.2.b.child (clRegionData x.1.skeleton x.2.block x.2.cl).positive).1.2 ∉
        (x.1.skeleton.tree (x.2.b.child (clRegionData x.1.skeleton x.2.block x.2.cl).positive).1.1).branching)
    (hleaf2 : leaf 2 → ∀ x ∈ canonFinsetK p (objKind w) (Famb.VineEstS4.startStateΓ B RD hG layer hLayer) (Famb.VineEstS4.chainStartΓ B),
      (x.2.b.child (clRegionData x.1.skeleton x.2.block x.2.cl).negative).1.2 ∉
        (x.1.skeleton.tree (x.2.b.child (clRegionData x.1.skeleton x.2.block x.2.cl).negative).1.1).branching)
    (lam : ℤ) (t t' : Fin 3 → ℝ) (k : Fin 4 → Mom P.d) (ht : ∀ i, ¬ leaf i → t i = t' i) :
    unitHkFWLLow P p S B RD hG layer hLayer g h wBar lam t k = unitHkFWLLow P p S B RD hG layer hLayer g h wBar lam t' k := by
  have h0 : t 0 = t' 0 := ht 0 hl0
  unfold unitHkFWLLow
  rw [h0]
  apply twistedRecenteredFWL_congr_leaf (A := Famb.VineEstS4.startStateΓ B RD hG layer hLayer) (c := Famb.VineEstS4.chainStartΓ B)
  · intro x hx
    by_cases h1 : leaf 1
    · exact Or.inl (hleaf1 h1 x hx)
    · exact Or.inr (ht 1 h1)
  · intro x hx
    by_cases h2 : leaf 2
    · exact Or.inl (hleaf2 h2 x hx)
    · exact Or.inr (ht 2 h2)

end

