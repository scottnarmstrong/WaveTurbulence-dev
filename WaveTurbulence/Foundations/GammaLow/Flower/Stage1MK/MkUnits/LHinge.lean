/-- The weighted VINEEST mass of a unit with a product of top filters `S`:
`cψ^(9|U| + 4 n₂) · topFilterMass^{|S|}` times main's `unitMass`. -/
def unitMassFWLLow (P : WTParams) [Fact (P.γ ≤ 1 / 2)] (S : List ℝ) {w : ℕ} {G : Garden w} {U : Finset (GBranch G.tree)}
    {a b : GBranch G.tree} {R : CLRegionData G U a b} {n : ℕ} (hM9 : Famb.NormalChartSupply P.γ) (B : Famb.VineEstS2.CLChainAssemblyΓ P.γ G R n)
    (RD : ReconstructionData G) (hG : G.IsPlain) (layer : GNode (RD.forest hG) → ℕ)
    (hLayer : IsLayering (RD.garden hG) layer) (cψ B₀ : ℝ) : ℝ :=
  cψ ^ (9 * U.card + 4 * clLocalOrder2 RD hG R) * topFilterMass ^ S.length * unitMassLow P hM9 B RD hG layer hLayer B₀

end

