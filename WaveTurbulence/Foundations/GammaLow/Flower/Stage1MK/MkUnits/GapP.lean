/-! # FLOWER-LOW (L8 helper L8-I-UNITS), item I-UNITS: gap values through the marked profile

Main's `Flower.MkUnits.Member0.{profileMk_gap_value,selSkCMk_ite}`.
Copied by source (sha256 in `MkUnits/COPIED-SHA256SUMS`) onto L5a's `𝒱_γ` API (`Fama`), L6's carrier `Src` and the
other item-I sub-areas' ports; statements are main's over `𝒱_{γF}` at `γF ≤ 1/2`. Generated by the helper's
`itool/gen_u_spec.py` (L8's `gen_i_spec.py` naming). -/

@[expose] public section
set_option autoImplicit false
noncomputable section
set_option linter.unusedSectionVars false

namespace WaveTurbulence.GammaLow.Flower

section
open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkUnits
open Finset TTree Reg Reg.Skeleton WaveTurbulence WaveTurbulence.RegRed WaveTurbulence.RedSplice WaveTurbulence.VineB WaveTurbulence.LGSpine WaveTurbulence.VineEstS2 WaveTurbulence.Stage1 WaveTurbulence.Vine WaveTurbulence.VineA WaveTurbulence.VineEstS4 WaveTurbulence.VineC WaveTurbulence.LFTwist WaveTurbulence.VineAlign WaveTurbulence.RegRedLeaf WaveTurbulence.Represents WaveTurbulence.VineA.PrescribedPrimeGarden
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w p : ℕ} {kind : Bool}
variable {R : ℕ}

/-- The fine′ class gap functional at the marking is B1b-3's `gapValueMk` of the representative. -/
theorem profileMk_gap_valueLow (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R)) {d : ℕ}
    (L γ η : ℝ) (hL : L ≠ 0) (base : Mom d) (roots : Fin (2 * R) → (Fin d → ℤ))
    (z : GenDecoration (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G d roots 0) :
    (a.profileMkLow mk).gap.value d L γ η hL base roots z =
      gapValueMkLow a.prime.skeleton a.totalSigma (mk a.prime) L γ η base z.1 := rfl

end

section
open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkUnits
open Finset TTree Reg Reg.Skeleton WaveTurbulence WaveTurbulence.RegRed WaveTurbulence.RedSplice WaveTurbulence.VineB WaveTurbulence.LGSpine WaveTurbulence.VineEstS2 WaveTurbulence.Stage1 WaveTurbulence.Vine WaveTurbulence.VineA WaveTurbulence.VineEstS4 WaveTurbulence.VineC WaveTurbulence.LFTwist WaveTurbulence.VineAlign WaveTurbulence.RegRedLeaf WaveTurbulence.Represents WaveTurbulence.VineA.PrescribedPrimeGarden
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w p : ℕ} {kind : Bool}
variable {R : ℕ}

open scoped Classical in
theorem selSkCMk_iteLow (a : Fama.VineA.PrescribedPrimeGarden γF (2 * R)) (mk : Fama.Stage1Mk.MarkFn γF (2 * R)) {d : ℕ} (L γ η : ℝ)
    (hL : L ≠ 0) (base : Mom d) (roots : Fin (2 * R) → (Fin d → ℤ))
    (z : GenDecoration (Fama.stSt γF a.prime.skeleton a.totalSigma (mk a.prime)).G d roots 0) :
    (a.profileMkLow mk).gap.value d L γ η hL base roots z = if selSkCMkLow a mk L γ η hL base roots z then 1 else 0 := by
  rw [profileMk_gap_valueLow]
  exact gapValueMk_iteLow a mk L γ η hL base roots z

end

end WaveTurbulence.GammaLow.Flower
