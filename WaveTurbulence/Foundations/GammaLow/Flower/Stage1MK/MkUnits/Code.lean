/-- The prescribed point carried by a member of the run class at `mk` along a full batch. -/
noncomputable def memberPointMkLow (a : Fama.VineA.PrescribedPrimeGarden γF w) (mk : Fama.Stage1Mk.MarkFn γF w)
    (y : UState w (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (M : List (Famb.VineC.UnitsIndexΓ (Fama.sourceAssemblyMk γF a mk)))
    (hr : ReachU p kind (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk)).Q M (Fama.sourceStart γF a mk) (Fama.sourceUnitsMk γF a mk) y.1 y.2) :
    Fama.VineA.PrescribedPrimeGarden γF w :=
  ⟨y.1.layered, ⟨y.1.skeleton, VineA.batch_prime hr.batch a.prime.prime, y.1.data, y.1.decodes⟩,
    Fama.VineA.transportGroupPrescription γF (batchMolIso hr.batch) a.sigma⟩

end

