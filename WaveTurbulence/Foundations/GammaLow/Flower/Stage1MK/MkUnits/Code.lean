open WaveTurbulence WaveTurbulence.Stage1 WaveTurbulence.RedSplice WaveTurbulence.LFTwist WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden WaveTurbulence.VineAlign WaveTurbulence.VineC WaveTurbulence.Represents WaveTurbulence.LGSpine
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w p : ℕ} {kind : Bool} {ι : Type*}

theorem sourceClass_mem_outputsMkLow (a : Fama.VineA.PrescribedPrimeGarden γF w) (mk : Fama.Stage1Mk.MarkFn γF w)
    (y : UState w (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (hy : y ∈ Fama.sourceClass γF a p kind mk) :
    y.1.layered ∈ a.outputsLow (p := p) (kind := kind) mk := by
  obtain ⟨M, hM, hr⟩ := Fama.Represents.member_traceMk a mk y hy
  rw [mkUnits_outputsLow_eq_outputs, Fama.prescribed_outputs_eq_unitsStartMk a mk (sourceLayerLow a) (sourceLayer_isLayeringLow a)
    (sourceLayer_reconstructsLow a)]
  exact ⟨M, y.1, hM, hr.batch, rfl⟩

end

section
open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkUnits
open WaveTurbulence WaveTurbulence.Stage1 WaveTurbulence.RedSplice WaveTurbulence.LFTwist WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden WaveTurbulence.VineAlign WaveTurbulence.VineC WaveTurbulence.Represents WaveTurbulence.LGSpine
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w p : ℕ} {kind : Bool} {ι : Type*}

/-- The member's prescribed point is fine′-related to the representative (main's `memberPoint_related'` at a
marking).  The run class is at the units marking `mkU`, the fine′ relation at the class marking `mkF`; they have the
same fine′ outputs (`hout`), and the fine transport `hFT` of `mkF` gives the tau-class image. -/
theorem memberPoint_relatedMkLow {mkF mkU : Fama.Stage1Mk.MarkFn γF w}
    (hFT : ∀ c : Fama.VineA.PrescribedPrimeGarden γF w, c.FineTransportedAt γF mkF) (a : Fama.VineA.PrescribedPrimeGarden γF w)
    (hout : a.outputsLow (p := p) (kind := kind) mkU = a.outputsLow (p := p) (kind := kind) mkF)
    (y : UState w (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mkU))) (hy : y ∈ Fama.sourceClass γF a p kind mkU)
    (M : List (Famb.VineC.UnitsIndexΓ (Fama.sourceAssemblyMk γF a mkU)))
    (hr : ReachU p kind (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mkU)).Q M (Fama.sourceStart γF a mkU) (Fama.sourceUnitsMk γF a mkU) y.1 y.2) :
    Fama.VineA.PrescribedPrimeGarden.Related γF (p := p) (kind := kind) a (memberPointMkLow a mkU y M hr) mkF := by
  have hmem := sourceClass_mem_outputsMkLow a mkU y hy
  rw [hout] at hmem
  obtain ⟨c, hc, hce⟩ := (Set.ext_iff.mp (Fama.VineA.PrescribedPrimeGarden.tauClass_imageMkLow hFT a) y.1.layered).mpr hmem
  have hcode : c.codeLow = (memberPointMkLow a mkU y M hr).codeLow :=
    (related_code_eqMkLow hc).symm.trans (memberPoint_codeMkLow a mkU y M hr).symm
  have he : c = memberPointMkLow a mkU y M hr := Fama.VineA.PrescribedPrimeGarden.eq_of_layered_code hce hcode
  rw [← he]
  exact hc

end

