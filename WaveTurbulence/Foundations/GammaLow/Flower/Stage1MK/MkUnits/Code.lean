open WaveTurbulence WaveTurbulence.Stage1 WaveTurbulence.RedSplice WaveTurbulence.LFTwist WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden WaveTurbulence.VineAlign WaveTurbulence.VineC WaveTurbulence.Represents WaveTurbulence.LGSpine
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w p : ℕ} {kind : Bool} {ι : Type*}

/-- Fine operations of an unmarked selected family preserve every coarse atom word (main's
`operation_fine_coarseAtomWord`, verbatim proof, at a marking). -/
theorem operation_fine_coarseAtomWordMkLow {A : FamilyReconstruction w ι} {i : ι}
    {σ : Prescription A.skeleton} {Mk : Set (Fama.CLVineG γF A.skeleton)} (hF : Fama.VineA.IsV0Fam γF A.family σ Mk)
    (op : FamilyOperation (p := p) (kind := kind) A i) (v : GBranch A.skeleton.tree) :
    Fama.VineA.coarseAtomWord γF op.output.skeleton ((operationMolIso op).e v) = Fama.VineA.coarseAtomWord γF A.skeleton v := by
  cases op with
  | mk hc he ht hq ε C =>
    cases ε
    · rfl
    · exact Fama.VineA.coarseAtomWord_twist (Fama.VineA.selectedMemberSite γF hF i)
        ⟨Fama.VineA.familyVine γF A.family i, mem_allSGLow (hF.1 i).1, rfl⟩ v

end

