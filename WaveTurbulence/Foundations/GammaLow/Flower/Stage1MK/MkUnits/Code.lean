open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w p : ℕ} {kind : Bool} {ι : Type*}

/-- Fine′ batch edges preserve the whole color graph. -/
theorem batchReach_code_eqMkLow {mk : Fama.Stage1Mk.MarkFn γF w} {a b : Fama.VineA.PrescribedPrimeGarden γF w}
    (h : Fama.VineA.PrescribedPrimeGarden.BatchReach γF (p := p) (kind := kind) a b mk) : a.codeLow = b.codeLow := by
  obtain ⟨L, B, hb, _, rfl⟩ := h
  exact (Fama.VineA.codedPrescription_map (batchMolIso hb)
    (fine_coarseAtomWordMkLow (batchMolIso_spec hb) a.totalSigma (mk a.prime)
      (Fama.VineA.fineState_isV0FamMk a.prime a.totalSigma)) a.sigma).symm

end

