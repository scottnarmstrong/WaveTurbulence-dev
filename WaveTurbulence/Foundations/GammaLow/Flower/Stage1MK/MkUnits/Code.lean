open WaveTurbulence WaveTurbulence.Stage1 WaveTurbulence.RedSplice WaveTurbulence.LFTwist WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden WaveTurbulence.VineAlign WaveTurbulence.VineC WaveTurbulence.Represents WaveTurbulence.LGSpine
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w p : ℕ} {kind : Bool} {ι : Type*}

theorem memberPoint_codeMkLow (a : Fama.VineA.PrescribedPrimeGarden γF w) (mk : Fama.Stage1Mk.MarkFn γF w)
    (y : UState w (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk))) (M : List (Famb.VineC.UnitsIndexΓ (Fama.sourceAssemblyMk γF a mk)))
    (hr : ReachU p kind (Famb.VineC.unitsSplitΓ (Fama.sourceAssemblyMk γF a mk)).Q M (Fama.sourceStart γF a mk) (Fama.sourceUnitsMk γF a mk) y.1 y.2) :
    (memberPointMkLow a mk y M hr).codeLow = a.codeLow :=
  Fama.VineA.codedPrescription_map (batchMolIso hr.batch)
    (fine_coarseAtomWordMkLow (batchMolIso_spec hr.batch) a.totalSigma (mk a.prime)
      (Fama.unitsFamily_isV0FamMk (Mole.garden_isMolecule _) a.totalSigma)) a.sigma

end

