open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkUnits
open WaveTurbulence WaveTurbulence.Stage1 WaveTurbulence.RedSplice WaveTurbulence.LFTwist WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden WaveTurbulence.VineAlign WaveTurbulence.VineC WaveTurbulence.Represents WaveTurbulence.LGSpine
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w p : ℕ} {kind : Bool} {ι : Type*}

/-- The selection of a fine′ piece at `LG` is the selection of any related prescribed point over `LG` (main's
`selP_iff_related` at a marking). -/
theorem selPMk_iff_relatedLow {R : ℕ} {A : Finset (LayeredGarden (2 * R))} (P : WTParams) [Fact (P.γ ≤ 1 / 2)]
    {mk : Fama.Stage1Mk.MarkFn P.γ (2 * R)} (base : Mom P.d) (roots : Fin (2 * R) → (Fin P.d → ℤ)) (π : Fama.Represents.PcA P.γ R p kind A mk)
    (b : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R)) (hb : Fama.VineA.PrescribedPrimeGarden.Related P.γ (p := p) (kind := kind) (Fama.Represents.repPt P.γ π) b mk)
    (LG : LayeredGarden (2 * R)) (hLG : b.layered = LG) (κ : GenDecoration LG.garden P.d roots 0) :
    Fama.Represents.selPMk P.γ p kind A P base roots mk π LG κ ↔ Fama.Represents.selAt P.γ P base b.prime b.sigma (hLG ▸ κ) := by
  constructor
  · rintro ⟨b', h', hrel', hs'⟩
    have hcode : b'.codeLow = b.codeLow := (related_code_eqMkLow hrel').symm.trans (related_code_eqMkLow hb)
    have he : b' = b := Fama.VineA.PrescribedPrimeGarden.eq_of_layered_code (h'.trans hLG.symm) hcode
    subst he
    subst hLG
    exact hs'
  · intro hs
    exact ⟨b, hLG, hb, hs⟩

end

