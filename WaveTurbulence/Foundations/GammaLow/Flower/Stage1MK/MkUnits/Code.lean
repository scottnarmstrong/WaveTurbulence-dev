open WaveTurbulence WaveTurbulence.Stage1 WaveTurbulence.RedSplice WaveTurbulence.LFTwist WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden WaveTurbulence.VineAlign WaveTurbulence.VineC WaveTurbulence.Represents WaveTurbulence.LGSpine
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w p : ℕ} {kind : Bool} {ι : Type*}

/-- Fold the fine operation maps of an unmarked selected family (main's `BatchIso.fine_coarseAtomWord` at a
marking; the marking is carried by its image). -/
theorem fine_coarseAtomWordMkLow {A B : FamilyReconstruction w ι} {L : List ι}
    {F : MolIso A.skeleton.molecule B.skeleton.molecule} (h : BatchIso p kind L A B F) :
    ∀ (σ : Prescription A.skeleton) (Mk : Set (Fama.CLVineG γF A.skeleton)), Fama.VineA.IsV0Fam γF A.family σ Mk →
      ∀ v : GBranch A.skeleton.tree, Fama.VineA.coarseAtomWord γF B.skeleton (F.e v) = Fama.VineA.coarseAtomWord γF A.skeleton v := by
  induction h with
  | nil => intro _ _ _ _; rfl
  | skip _ _ ih => exact ih
  | apply op _ ih =>
    intro σ Mk hA v
    exact (ih _ _ (Fama.VineA.isV0Fam_operationMk hA op (markTransported_imageMarkLow _ Mk)) ((operationMolIso op).e v)).trans
      (operation_fine_coarseAtomWordMkLow hA op v)

end

