open WaveTurbulence WaveTurbulence.Stage1 WaveTurbulence.RedSplice WaveTurbulence.LFTwist WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden WaveTurbulence.VineAlign WaveTurbulence.VineC WaveTurbulence.Represents WaveTurbulence.LGSpine
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w p : ℕ} {kind : Bool} {ι : Type*}

/-- Fine′ relatedness preserves the code. -/
theorem related_code_eqMkLow {mk : Fama.Stage1Mk.MarkFn γF w} {a b : Fama.VineA.PrescribedPrimeGarden γF w}
    (h : Fama.VineA.PrescribedPrimeGarden.Related γF (p := p) (kind := kind) a b mk) : a.codeLow = b.codeLow := by
  induction h with
  | rel _ _ h => exact batchReach_code_eqMkLow h
  | refl _ => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih hj => exact ih.trans hj

end

