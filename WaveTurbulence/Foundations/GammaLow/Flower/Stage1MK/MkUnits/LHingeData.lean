/-- **The hinge data of the weighted units of the representative at a marking with per-unit top filters** (B3's
`unit_hinge_dataWMk` with `SU`, the unit bound V5W-2L's `V5FrontierClassBoundAtL`). -/
theorem unit_hinge_dataWMkLLow (P : WTParams) [Fact (P.γ ≤ 1 / 2)] (hV : V5FrontierClassBoundAtLLow P) (hM9 : Famb.NormalChartSupply P.γ)
    (hgate : CoherentGateH P) (hinc : IncoherentGateH P) (htop : TopIncoherentDecayAtR P)
    (hd1 : 1 ≤ P.d) (hη0 : 0 < P.η) (hη6 : 6 * P.η ^ 6 ≤ P.η)
    (hη2 : P.η ≤ 1 / 2) (hC1 : 1 ≤ P.C₁) (hδ : 0 < P.δ) (hL1 : 1 ≤ P.L) (hw : 0 ≤ P.gamma1 - Real.sqrt P.η)
    {p : ℕ} (hp : p < P.D) {R : ℕ} (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R)) (mk : Fama.Stage1Mk.MarkFn P.γ (2 * R))
    (hcan : IsCanonGC (p + 1) a.layered)
    (hord : (a.prime.data.garden a.prime.prime.1).order ≤ P.N (p + 1) ^ 4)
    (tt : Fin (2 * R) → ℝ) (base : Mom P.d) (roots : Fin (2 * R) → (Fin P.d → ℤ))
    (g : Fin (2 * R) → Mom P.d → ℂ) (cψ : ℝ) (hc : 1 ≤ cψ) (hgp : ∀ j, GPresented (32 * P.d) (g j) cψ)
    (hre : ∀ j x, (g j x).im = 0)
    (SU : Fin (Fama.unitBlocks P.γ a.prime.skeleton a.totalSigma (mk a.prime)).length → List ℝ)
    (hSU : ∀ j, ∀ s ∈ SU j, 0 < s)
    (hp' : ℕ → Fin (2 * R) → Fin (2 * R) → Mom P.d → ℝ) (bb : ℝ) (hbb : 0 ≤ bb)
    (hB : ∀ q j j', q ≤ p → SNormR (40 * P.d) (40 * P.d) (hp' q j j') ≤ ENNReal.ofReal bb)
    (lam : Fin (Fama.unitBlocks P.γ a.prime.skeleton a.totalSigma (mk a.prime)).length → ℤ) :
    ∃ (H : HingeFam (Fin (Fama.unitBlocks P.γ a.prime.skeleton a.totalSigma (mk a.prime)).length) P.d)
      (Mh : Fin (Fama.unitBlocks P.γ a.prime.skeleton a.totalSigma (mk a.prime)).length → ℝ),
      (∀ j c', ∑' l, H.w j c' l ≤ Mh j) ∧
      HHkPropLow (a.normalizedPiece P.d (mk a.prime)) tt base roots
        (selSkCMkLow a mk P.L P.γ P.η (lt_of_lt_of_le zero_lt_one hL1).ne' base roots)
        ((Fama.stShape P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).hclk
          (Fama.unitBlkMk_disj (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)))
        ((Fama.stShape P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)).hmom
          (Fama.unitBlkMk_disj (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)))
        (fun j => unitHkFWLLow P p (SU j) (Fama.sourceAssemblyMk P.γ a mk j) a.prime.data a.prime.prime.1 (sourceLayerLow a)
          (sourceLayer_isLayeringLow a) g
          (unitProfile (Fama.unitBlkMk P.γ (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma (mk a.prime)) hp' j) base
          (lam j)) H ∧
      ∏ j, Mh j = ChinFWLLow P.d P.η ^ Fintype.card (Fin (Fama.unitBlocks P.γ a.prime.skeleton a.totalSigma (mk a.prime)).length) *
        (∏ j, unitMassFWLLow P (SU j) hM9 (Fama.sourceAssemblyMk P.γ a mk j) a.prime.data a.prime.prime.1 (sourceLayerLow a)
          (sourceLayer_isLayeringLow a) cψ bb) *
        ∏ j, (1 + |((lam j : ℤ) : ℝ)|) ^ (6 * P.η ^ 6) := by
  have hL0 : 0 < P.L := lt_of_lt_of_le zero_lt_one hL1
  have hMa := Mole.garden_isMolecule a.prime.skeleton
  have hspec := (hinge_units_constWLLow P.d P.η hη0.le).choose_spec
  have hChin : ChinFWLLow P.d P.η = (hinge_units_constWLLow P.d P.η hη0.le).choose := by
    unfold ChinFWLLow; rw [dif_pos hη0.le]
  rw [hChin]
  have hcan' : IsCanonGC (p + 1) (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a)) := by rw [sourceLayer_reconstructsLow]; exact hcan
  have hordS : a.prime.skeleton.order ≤ P.N (p + 1) ^ 4 := by
    have := a.prime.data.decoded_order a.prime.prime.1 (a.prime.data.garden_decodes a.prime.prime.1)
    omega
  have hcl : ∀ j : Fin (Fama.unitBlocks P.γ a.prime.skeleton a.totalSigma (mk a.prime)).length,
      clLocalOrder1 (regionOf (Fama.unitBlkMk P.γ hMa a.totalSigma (mk a.prime) j)) ≤ P.N 1 ^ 4 := fun j =>
    clLocalOrder1_le_N1 P _ hordS
  have hh' : ∀ j : Fin (Fama.unitBlocks P.γ a.prime.skeleton a.totalSigma (mk a.prime)).length, ∀ r ≤ p,
      SNormR (40 * P.d) (40 * P.d) (unitProfile (Fama.unitBlkMk P.γ hMa a.totalSigma (mk a.prime)) hp' j r) ≤
        ENNReal.ofReal bb :=
    fun j r hr => hB r _ _ hr
  have hLay : (a.normalizedPiece P.d (mk a.prime)).layer = (Fama.stSt P.γ a.prime.skeleton a.totalSigma (mk a.prime)).layer
      (RegRed.coreLayer (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a))
        a.prime.data a.prime.prime.1 (a.prime.data.garden_decodes a.prime.prime.1)) := by
    funext c
    show RegRed.coreLayer a.layered a.prime.data a.prime.prime.1 a.prime.decodes
      ((Fama.stSt P.γ a.prime.skeleton a.totalSigma (mk a.prime)).M.ob c) = _
    rw [coreLayer_of_spec a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) a.layered
      (sourceLayer_reconstructsLow a) a.prime.decodes]
    exact (coreLayer_of_spec a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) _ rfl _ _).symm
  have hG1 := Fama.Represents.g1_unitsMk P hMa a.totalSigma hM9 (Mk := mk a.prime) (B₀ := Fama.sourceAssemblyMk P.γ a mk) a.prime.data
    a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) base tt roots
    (selSkCMkLow a mk P.L P.γ P.η hL0.ne' base roots)
    (fun j c => sumintBoundary (a.prime.skeleton.sign (Fama.unitBlkMk P.γ hMa a.totalSigma (mk a.prime) j).upper.toNode)
      (fun i => latPt P.d (c i)))
    (fun j c hc => Fama.Represents.qOut_one_eq_layMk hMa a.totalSigma j a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a) c hc)
    (fun j c hc => Fama.Represents.qOut_two_eq_layMk hMa a.totalSigma j a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a) c hc)
    (fun j => Fama.Represents.hqle_unitsMk hMa a.totalSigma j a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a))
  let D' : SplicedKernelData (Fama.stSt P.γ a.prime.skeleton a.totalSigma (mk a.prime)).G P.d :=
    ⟨fun _ => 0, ∅, fun _ => 0, fun _ _ => 0, fun _ => 0,
      Fama.VineA.NormalizedSplice.gapSpecificationMk P.γ a.prime.skeleton a.totalSigma (mk a.prime), fun _ => 0, fun _ => 0⟩
  have hG2 : ∀ κ : GenDecoration (Fama.stSt P.γ a.prime.skeleton a.totalSigma (mk a.prime)).G P.d roots 0,
      selSkCMkLow a mk P.L P.γ P.η hL0.ne' base roots κ →
      ∀ (j : Fin (Fama.unitBlocks P.γ a.prime.skeleton a.totalSigma (mk a.prime)).length) (c : Fin 4 → Fin P.d → ℤ),
      (∀ i, ‖(base + latticePoint P.L (κ.1 ((Fama.stShape P.γ hMa a.totalSigma (mk a.prime)).hmom
          (Fama.unitBlkMk_disj hMa a.totalSigma (mk a.prime)) j i))) - latPt P.d (c i)‖ ≤ 1) →
        sumintBoundary (a.prime.skeleton.sign (Fama.unitBlkMk P.γ hMa a.totalSigma (mk a.prime) j).upper.toNode)
            (fun i => base + latticePoint P.L (κ.1 ((Fama.stShape P.γ hMa a.totalSigma (mk a.prime)).hmom
              (Fama.unitBlkMk_disj hMa a.totalSigma (mk a.prime)) j i))) ∈
          outSet (unitDLow hM9 (Fama.sourceAssemblyMk P.γ a mk j) a.prime.data a.prime.prime.1 (sourceLayerLow a)
            (sourceLayer_isLayeringLow a)
            (sumintBoundary (a.prime.skeleton.sign (Fama.unitBlkMk P.γ hMa a.totalSigma (mk a.prime) j).upper.toNode)
              (fun i => latPt P.d (c i))) base) P.L P.γ P.η := by
    intro κ hκ j c hball
    refine mem_outSet_of_gsbNMkLow hMa a.prime.prime.1 a.totalSigma hL0.ne' P.γ P.η base roots κ D' rfl ?_ j c hball _
      rfl rfl
    have h1 := gapValue_eq_indicatorMkLow a.totalSigma D' rfl P.L P.γ P.η base κ.1
    rw [← h1]
    rw [show gapValueMkLow a.prime.skeleton a.totalSigma (mk a.prime) P.L P.γ P.η base κ.1 = 1 from hκ]
    exact one_ne_zero
  have hcont : ∀ (j : Fin (Fama.unitBlocks P.γ a.prime.skeleton a.totalSigma (mk a.prime)).length)
      (c : Fin 4 → Fin P.d → ℤ) (lam : ℤ),
      ∀ E ∈ outSet (unitDLow hM9 (Fama.sourceAssemblyMk P.γ a mk j) a.prime.data a.prime.prime.1 (sourceLayerLow a)
        (sourceLayer_isLayeringLow a)
        (sumintBoundary (a.prime.skeleton.sign (Fama.unitBlkMk P.γ hMa a.totalSigma (mk a.prime) j).upper.toNode)
          (fun i => latPt P.d (c i))) base) P.L P.γ P.η,
        ContinuousOn (fun t => unitHkFWLLow P p (SU j) (Fama.sourceAssemblyMk P.γ a mk j) a.prime.data a.prime.prime.1 (sourceLayerLow a)
          (sourceLayer_isLayeringLow a) g (unitProfile (Fama.unitBlkMk P.γ hMa a.totalSigma (mk a.prime)) hp' j) base lam t
          (sumintBoundary (a.prime.skeleton.sign (Fama.unitBlkMk P.γ hMa a.totalSigma (mk a.prime) j).upper.toNode) E))
          (cubeSet (unitDLow hM9 (Fama.sourceAssemblyMk P.γ a mk j) a.prime.data a.prime.prime.1 (sourceLayerLow a)
            (sourceLayer_isLayeringLow a)
            (sumintBoundary (a.prime.skeleton.sign (Fama.unitBlkMk P.γ hMa a.totalSigma (mk a.prime) j).upper.toNode)
              (fun i => latPt P.d (c i))) base).qOut) :=
    fun j c lam => unit_hcontWLLow hgate hinc htop hd1 hη0 hη6 hη2 hC1 hδ hL1 hw hp
      (unitProfile (Fama.unitBlkMk P.γ hMa a.totalSigma (mk a.prime)) hp' j) bb (hh' j) a.prime.prime hM9
      (Fama.sourceAssemblyMk P.γ a mk j) a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) hcan' hord g cψ
      hc hgp hre (SU j) (hSU j) _ base lam
  have hind : ∀ (j : Fin (Fama.unitBlocks P.γ a.prime.skeleton a.totalSigma (mk a.prime)).length) (lam : ℤ)
      (t t' : Fin 3 → ℝ) (k : Fin 4 → Mom P.d), (∀ i, ¬ Fama.Represents.leafFlag P.γ hMa a.totalSigma j i → t i = t' i) →
      unitHkFWLLow P p (SU j) (Fama.sourceAssemblyMk P.γ a mk j) a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) g
        (unitProfile (Fama.unitBlkMk P.γ hMa a.totalSigma (mk a.prime)) hp' j) base lam t k =
      unitHkFWLLow P p (SU j) (Fama.sourceAssemblyMk P.γ a mk j) a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) g
        (unitProfile (Fama.unitBlkMk P.γ hMa a.totalSigma (mk a.prime)) hp' j) base lam t' k :=
    fun j lam t t' k ht => unitHkFWL_hindLow P p (SU j) (Fama.sourceAssemblyMk P.γ a mk j) a.prime.data a.prime.prime.1 (sourceLayerLow a)
      (sourceLayer_isLayeringLow a) g _ base (Fama.Represents.leafFlag P.γ hMa a.totalSigma j) (Fama.Represents.leafFlag_zeroMk hMa a.totalSigma j)
      (unit_hleaf1MkLow hMa a.totalSigma (mk a.prime) a.prime.data a.prime.prime.1 (sourceLayerLow a)
        (sourceLayer_isLayeringLow a) a.prime.prime j)
      (unit_hleaf2MkLow hMa a.totalSigma (mk a.prime) a.prime.data a.prime.prime.1 (sourceLayerLow a)
        (sourceLayer_isLayeringLow a) a.prime.prime j) lam t t' k ht
  obtain ⟨H, Mh, hsum, hHk, hprod⟩ := hspec.2 P rfl rfl hV (zero_le_one.trans hC1) hL0 hp a.prime.prime hM9 a.prime.data
    a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a) hcan' hord (B₀ := Fama.sourceAssemblyMk P.γ a mk) hcl g cψ hc
    hgp hre SU hSU (fun j => unitProfile (Fama.unitBlkMk P.γ hMa a.totalSigma (mk a.prime)) hp' j) (fun _ => bb) (fun _ => hbb) hh'
    (fun j c => sumintBoundary (a.prime.skeleton.sign (Fama.unitBlkMk P.γ hMa a.totalSigma (mk a.prime) j).upper.toNode)
      (fun i => latPt P.d (c i))) base (fun j => Fama.Represents.hqle_unitsMk hMa a.totalSigma j a.prime.data a.prime.prime.1
        (sourceLayerLow a) (sourceLayer_isLayeringLow a)) hcont (Fama.stSt P.γ a.prime.skeleton a.totalSigma (mk a.prime)).G tt roots
    (selSkCMkLow a mk P.L P.γ P.η hL0.ne' base roots)
    ((Fama.stSt P.γ a.prime.skeleton a.totalSigma (mk a.prime)).layer
      (RegRed.coreLayer (layeredReconstruction a.prime.data a.prime.prime.1 (sourceLayerLow a) (sourceLayer_isLayeringLow a))
        a.prime.data a.prime.prime.1 (a.prime.data.garden_decodes a.prime.prime.1)))
    ((Fama.stShape P.γ hMa a.totalSigma (mk a.prime)).hmom (Fama.unitBlkMk_disj hMa a.totalSigma (mk a.prime)))
    ((Fama.stShape P.γ hMa a.totalSigma (mk a.prime)).hclk (Fama.unitBlkMk_disj hMa a.totalSigma (mk a.prime)))
    (Fama.Represents.leafFlag P.γ hMa a.totalSigma)
    (fun j i => ((qOutOf a.prime.data a.prime.prime.1 (sourceLayerLow a) (Fama.unitBlkMk P.γ hMa a.totalSigma (mk a.prime) j).upper
      (Fama.unitBlkMk P.γ hMa a.totalSigma (mk a.prime) j).lower (regionOf (Fama.unitBlkMk P.γ hMa a.totalSigma (mk a.prime) j)) i : ℕ) :
        ℝ)) hind hG1 hG2 lam
  refine ⟨H, Mh, hsum, ?_, hprod⟩
  intro κ hκ τ hτ j c hball
  rw [hLay] at hτ
  exact hHk κ hκ τ hτ j c hball

end

