variable {S : Garden w}

/-- **G2 (`outSet` membership) at a marking** (main's `mem_outSet_of_gsbN`). -/
theorem mem_outSet_of_gsbNMkLow (hM : S.molecule.IsMolecule) (hS : S.IsPlain) (σ : Prescription S)
    {Mk : Set (Fama.CLVineG γF S)} {L : ℝ} (hL : L ≠ 0) (γ η : ℝ) (base : Mom d) (roots : Fin w → (Fin d → ℤ))
    (z : GenDecoration (Fama.stSt γF S σ Mk).G d roots 0) (D : SplicedKernelData (Fama.stSt γF S σ Mk).G d)
    (hD : D.gapSpecification = Fama.VineA.NormalizedSplice.gapSpecificationMk γF S σ Mk)
    (hz : splicedGapIndicator (Fama.stSt γF S σ Mk).G D L γ η base z.1 ≠ 0) (j : Fin (Fama.unitBlocks γF S σ Mk).length)
    (c : Fin 4 → Fin d → ℤ)
    (hball : ∀ i, ‖(base + latticePoint L (z.1 ((Fama.stShape γF hM σ Mk).hmom (Fama.unitBlkMk_disj hM σ Mk) j i))) -
      latPt d (c i)‖ ≤ 1)
    (DS : SumintDatum d) (hw : DS.wBar = base)
    (hct : DS.centre = sumintBoundary (S.sign (Fama.unitBlkMk γF hM σ Mk j).upper.toNode) (fun i => latPt d (c i))) :
    sumintBoundary (S.sign (Fama.unitBlkMk γF hM σ Mk j).upper.toNode)
        (fun i => base + latticePoint L (z.1 ((Fama.stShape γF hM σ Mk).hmom (Fama.unitBlkMk_disj hM σ Mk) j i))) ∈
      outSet DS L γ η := by
  have hcore := (Fama.stShape γF hM σ Mk).hmom_outSet_core (Fama.unitBlkMk_disj hM σ Mk) j L base z.1 z.2.1
  have hg := (sumintBoundary_gap_iff (S.sign (Fama.unitBlkMk γF hM σ Mk j).upper.toNode) L γ η
    (fun i => base + latticePoint L (z.1 ((Fama.stShape γF hM σ Mk).hmom (Fama.unitBlkMk_disj hM σ Mk) j i)))).mpr
    (unitGap_stStNMkLow hM hS σ hL γ η base roots z D hD hz j)
  refine ⟨fun c' => ⟨?_, ?_⟩, hcore.2, hg.1, hg.2⟩
  · rw [hw]; exact hcore.1 c'
  · rw [hct]
    exact sumintBoundary_close _ _ _ hball c'

end

