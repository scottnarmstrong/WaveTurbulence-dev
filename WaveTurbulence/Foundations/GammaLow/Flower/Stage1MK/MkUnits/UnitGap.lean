variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w : ℕ} {S : Garden w} (hM : S.molecule.IsMolecule) (σ : Prescription S) (Mk : Set (Fama.CLVineG γF S))
  (D : ReconstructionData S) (hS : S.IsPlain)
  (layer : GNode (D.forest hS) → ℕ) (hLayer : IsLayering (D.garden hS) layer)

theorem unit_hleaf_auxMkLow (hp : IsPrimeGarden S) {p : ℕ} {kind : Bool} (j : Fin (Fama.unitBlocks γF S σ Mk).length)
    (k : Fin 4) (r : Fin w)
    (hflag : nodeClk (Fama.stSt γF S σ Mk).G ((Fama.stShape γF hM σ Mk).hmom (Fama.unitBlkMk_disj hM σ Mk) j k) = Sum.inl r)
    (x : Σ X : FamilyReconstruction w (Famb.VineEstS4.assemblySourceFamilyΓ (Fama.alignedAssemblyMk γF hM σ Mk j)).CoreIndex,
      ChainAt X.skeleton X.family)
    (hx : x ∈ canonFinsetK p kind (Famb.VineEstS4.startStateΓ (Fama.alignedAssemblyMk γF hM σ Mk j) D hS layer hLayer)
      (Famb.VineEstS4.chainStartΓ (Fama.alignedAssemblyMk γF hM σ Mk j))) :
    (bnodes (⟨x.2.U, x.2.a, x.2.b, x.2.block, x.2.cl⟩ : CLBlock x.1.skeleton) k).1.2 ∉
      (x.1.skeleton.tree
        (bnodes (⟨x.2.U, x.2.a, x.2.b, x.2.block, x.2.cl⟩ : CLBlock x.1.skeleton) k).1.1).branching := by
  obtain ⟨X, c⟩ := x
  obtain ⟨N, hN, hR⟩ := (mem_canonFinsetK hp).mp hx
  obtain ⟨Z, hZb, hZe⟩ := batch_lift (e := (Famb.VineC.unitsSplitΓ (Fama.alignedAssemblyMk γF hM σ Mk)).emb j)
    ((Famb.VineC.unitsSplitΓ (Fama.alignedAssemblyMk γF hM σ Mk)).inj j) hR.batch
    (X := Famb.VineC.unitsStartΓ (Fama.alignedAssemblyMk γF hM σ Mk) (Fama.unitBlkMk_disj hM σ Mk) D hS layer hLayer) rfl
  obtain ⟨vs, hRZ⟩ := batch_reachU (Qm := (Famb.VineC.unitsSplitΓ (Fama.alignedAssemblyMk γF hM σ Mk)).Q) hZb
    (Famb.VineC.unitsRegionΓ (Fama.alignedAssemblyMk γF hM σ Mk) (Fama.unitBlkMk_disj hM σ Mk))
  have hN' : N.Nodup := perm_univ_nodup hN
  have hproj := ReachU.proj (e := (Famb.VineC.unitsSplitΓ (Fama.alignedAssemblyMk γF hM σ Mk)).emb j)
    (he := (Famb.VineC.unitsSplitΓ (Fama.alignedAssemblyMk γF hM σ Mk)).inj j) j ((Famb.VineC.unitsSplitΓ (Fama.alignedAssemblyMk γF hM σ Mk)).q_emb j) N hRZ
  subst hZe
  have hc := Reach.region_unique hN' hN' hR hproj
  subst hc
  have hn : (N.map ((Famb.VineC.unitsSplitΓ (Fama.alignedAssemblyMk γF hM σ Mk)).emb j)).Nodup :=
    hN'.map ((Famb.VineC.unitsSplitΓ (Fama.alignedAssemblyMk γF hM σ Mk)).inj j)
  have hm := congrFun (congrFun (Fama.commonShape_hmomMk hM σ D hS layer hLayer hRZ hn
    (markTransported_imageMarkLow _ Mk)) j) k
  refine not_branch_of_nodeClk_inl_shape (Fama.commonShapeMk hM σ D hS layer hLayer hRZ hn
    (markTransported_imageMarkLow _ Mk)) (Fama.member_disjMk hM σ D hS layer hLayer hRZ hn) j k r ?_
  rw [hm]
  exact hflag

end

