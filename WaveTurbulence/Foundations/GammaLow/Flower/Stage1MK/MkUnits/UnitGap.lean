variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w d : ℕ} {G : Garden w}

/-- **G2 for a run of a marked SG group.** -/
theorem runGap_of_selOfLow (hM : G.molecule.IsMolecule) (hp : G.IsPlain) (σ : Prescription G) {Mk : Set (Fama.CLVineG γF G)}
    {L : ℝ} (hL : L ≠ 0) (γ η : ℝ) (base : Mom d) (roots : Fin w → (Fin d → ℤ)) (z : GenDecoration G d roots 0)
    (hsel : Fama.VineA.NormalizedSplice.selOf γF (Fama.VineA.NormalizedSplice.GroupPrescription.ofPrescription γF σ) L γ η base z.1)
    {S : Finset (GBranch G.tree)} (hS : S ∈ Fama.maximalGroupsG γF G.molecule) (hσ : σ S = Molecule.GapKind.SG)
    (hmk : Fama.markedGroup γF G Mk S) {u : CLBlock G} (hu : u ∈ (markedUnitsOfMKLow hmk).runs) :
    UnitGap L γ η (fun i => base + latticePoint L (z.1 (bnodes u i))) := by
  obtain ⟨Lsp, hsp, hLsp⟩ := (markedUnitsOfMKLow hmk).spine u hu
  obtain ⟨T, a', hTmem, hTv, hTU⟩ := spine_lastLow hsp
  obtain ⟨c, -, -, hI, hcT⟩ := hLsp _ hTmem
  have hκ := spliced_molecule_decoration G hp hL base roots z
  have hc0 : ∀ v ∈ G.molecule.atoms, G.molecule.deg v = 4 →
      gardenSource G hp (fun i => base + latticePoint L (roots i)) v = 0 :=
    fun v _ hv => gardenSource_eq_zero_of_deg_four G hp _ v hv
  have hk : Fama.VineA.NormalizedSplice.groupGapKind γF G L γ η base (bondIndex G z.1) S = Molecule.GapKind.SG :=
    (hsel ⟨S, hS⟩).trans hσ
  have hX := hTv
  have hI' : Fama.IsIngredientG γF G.molecule S T := by
    rw [show T = c.atoms from hcT.symm]
    exact hI
  obtain ⟨r, hr, hkr⟩ := ingredient_blockGap_of_groupGapKindLow hM L γ η base _ _ hκ hc0 hS hk hI'
    (Flower.MkMark.isBlock_swap (Src.isBlock_of_isSomeVine hX))
  have hrU : G.molecule.IsBlockGap L base (bondIndex G z.1) u.atoms u.lower r := isBlockGap_mono hTU hr
  have hcr := Flower.MkMark.crown_eq_blockGap (regionOf u) L base base z.1 z.2.1 hrU
  refine unitGap_of_cases L γ η _ r hkr ?_ (boundary_diff_cases u L base z.1 z.2.1)
  have e2 : bnodes u 2 = u.lower.child (regionOf u).positive := rfl
  have e3 : bnodes u 3 = u.lower.child (regionOf u).negative := rfl
  simp only [e2, e3]
  simp only [cosetDecoration] at hcr
  rcases hcr with e | e
  · exact Or.inr (Or.inr (Or.inl e.symm))
  · right; right; right
    rw [← neg_sub, e, neg_neg]

end

