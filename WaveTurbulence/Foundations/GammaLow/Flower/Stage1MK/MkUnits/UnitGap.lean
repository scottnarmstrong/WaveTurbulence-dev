/-- **G2, SG clause, for every decoration of `G_sb` at a marking** (main's `unitGap_stStN`). -/
theorem unitGap_stStNMkLow (hM : S.molecule.IsMolecule) (hS : S.IsPlain) (σ : Prescription S) {Mk : Set (Fama.CLVineG γF S)}
    {L : ℝ} (hL : L ≠ 0) (γ η : ℝ) (base : Mom d) (roots : Fin w → (Fin d → ℤ))
    (z : GenDecoration (Fama.stSt γF S σ Mk).G d roots 0) (D : SplicedKernelData (Fama.stSt γF S σ Mk).G d)
    (hD : D.gapSpecification = Fama.VineA.NormalizedSplice.gapSpecificationMk γF S σ Mk)
    (hz : splicedGapIndicator (Fama.stSt γF S σ Mk).G D L γ η base z.1 ≠ 0) (j : Fin (Fama.unitBlocks γF S σ Mk).length) :
    VineB.UnitGap L γ η (fun i => base + latticePoint L (z.1 ((Fama.stShape γF hM σ Mk).hmom (Fama.unitBlkMk_disj hM σ Mk) j i))) := by
  obtain ⟨κ, hκ⟩ := exists_ext_of_shape (Fama.stShape γF hM σ Mk) hS (Fama.unitBlkMk_disj hM σ Mk) hL base roots z
  subst hκ
  have h1 := splicedGapIndicator_eq_selOf_genMkLow hM hS σ hL γ η base roots κ _
    (fun y => Fama.Represents.bondIndex_stSt_odMk hM σ κ.1 y) D hD
  have hsel : Fama.VineA.NormalizedSplice.selOf γF (Fama.VineA.NormalizedSplice.GroupPrescription.ofPrescription γF σ) L γ η base
      κ.1 := by
    by_contra hn
    rw [if_neg hn] at h1
    exact hz h1
  have hu : Fama.unitBlkMk γF hM σ Mk j ∈ Fama.unitBlocks γF S σ Mk := List.get_mem _ _
  have hg := unitGap_of_selOfNMkLow hM hS σ hL γ η base roots κ hsel hu
  have heq : ∀ i, ((Fama.stShape γF hM σ Mk).resDec hS (Fama.unitBlkMk_disj hM σ Mk) κ).1
      ((Fama.stShape γF hM σ Mk).hmom (Fama.unitBlkMk_disj hM σ Mk) j i) = κ.1 (bnodes (Fama.unitBlkMk γF hM σ Mk j) i) := by
    intro i
    rw [SpliceShape.resDec_val]
    exact congrArg κ.1 ((Fama.stShape γF hM σ Mk).node_hmom (Fama.unitBlkMk_disj hM σ Mk) j i)
  simp only [heq]
  exact hg

end

