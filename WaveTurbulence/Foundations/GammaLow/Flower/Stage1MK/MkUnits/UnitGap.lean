theorem unit_hleaf1MkLow (hp : IsPrimeGarden S) {p : ℕ} (j : Fin (Fama.unitBlocks γF S σ Mk).length)
    (h1 : Fama.Represents.leafFlag γF hM σ j 1) :
    ∀ x ∈ canonFinsetK p (objKind w) (Famb.VineEstS4.startStateΓ (Fama.alignedAssemblyMk γF hM σ Mk j) D hS layer hLayer)
      (Famb.VineEstS4.chainStartΓ (Fama.alignedAssemblyMk γF hM σ Mk j)),
      (x.2.b.child (clRegionData x.1.skeleton x.2.block x.2.cl).positive).1.2 ∉
        (x.1.skeleton.tree (x.2.b.child (clRegionData x.1.skeleton x.2.block x.2.cl).positive).1.1).branching := by
  intro x hx
  obtain ⟨r, hr⟩ := (Fama.Represents.leafFlag_oneMk hM σ j).mp h1
  exact unit_hleaf_auxMkLow hM σ Mk D hS layer hLayer hp j 2 r hr x hx

