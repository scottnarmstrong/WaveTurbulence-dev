variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w d : ℕ} {G : Garden w}

/-- **G2 at a marking**: under the σ-restriction every unit of `unitBlocks G σ Mk` (a run of a marked group or a unit
of an unmarked group) has an SG gap (main's `unitGap_of_selOfN` at a marking). -/
theorem unitGap_of_selOfNMkLow (hM : G.molecule.IsMolecule) (hp : G.IsPlain) (σ : Prescription G)
    {Mk : Set (Fama.CLVineG γF G)} {L : ℝ} (hL : L ≠ 0) (γ η : ℝ) (base : Mom d) (roots : Fin w → (Fin d → ℤ))
    (z : GenDecoration G d roots 0)
    (hsel : Fama.VineA.NormalizedSplice.selOf γF (Fama.VineA.NormalizedSplice.GroupPrescription.ofPrescription γF σ) L γ η base z.1)
    {u : CLBlock G} (hu : u ∈ Fama.unitBlocks γF G σ Mk) :
    UnitGap L γ η (fun i => base + latticePoint L (z.1 (bnodes u i))) := by
  obtain ⟨S, hS, hσ, hu'⟩ := Fama.mem_unitBlocksMk.mp hu
  by_cases hmk : Fama.markedGroup γF G Mk S
  · rw [groupUnitsMk_of_markedMKLow hmk] at hu'
    exact runGap_of_selOfLow hM hp σ hL γ η base roots z hsel hS hσ hmk hu'
  · have hu0 : u ∈ Fama.unitBlocks γF G σ := by
      refine Fama.mem_unitBlocksMk.mpr ⟨S, hS, hσ, ?_⟩
      rw [Fama.groupUnitsMk_empty]
      rwa [Fama.groupUnitsMk_of_not_marked hmk] at hu'
    exact Fama.Represents.unitGap_of_selOfN hM hp σ hL γ η base roots z hsel hu0

end

