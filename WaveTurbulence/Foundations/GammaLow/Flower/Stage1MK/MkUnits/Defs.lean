open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]

/-- A marking function taking the value `Mk` at `a.prime` (used internally to run main's `MarkFn`-level run
assembly at a marked set of the representative). -/
def fixMarkLow {w : ℕ} (a : Fama.VineA.PrescribedPrimeGarden γF w) (Mk : Set (Fama.CLVineG γF a.prime.skeleton)) : Fama.Stage1Mk.MarkFn γF w :=
  fun _ => {c | ∃ c₀ ∈ Mk, HEq c₀ c}

end

