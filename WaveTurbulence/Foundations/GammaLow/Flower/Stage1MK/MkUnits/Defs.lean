open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w p : ℕ} {kind : Bool} {ι : Type*}

/-- The image of a marked vine set under a molecule isomorphism. -/
def imageMarkLow {S S' : Garden w} (F : MolIso S.molecule S'.molecule) (M : Set (Fama.CLVineG γF S)) : Set (Fama.CLVineG γF S') :=
  {c' | ∃ c ∈ M, c'.atoms = F.img c.atoms}

end

