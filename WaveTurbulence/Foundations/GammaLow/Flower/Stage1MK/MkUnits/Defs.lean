open WaveTurbulence WaveTurbulence.Stage1 WaveTurbulence.RedSplice WaveTurbulence.LFTwist WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden WaveTurbulence.VineAlign WaveTurbulence.VineC WaveTurbulence.Represents WaveTurbulence.LGSpine
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w p : ℕ} {kind : Bool} {ι : Type*}

/-- An isomorphism carries every marked set to its image marking. -/
theorem markTransported_imageMarkLow {S S' : Garden w} (F : MolIso S.molecule S'.molecule) (M : Set (Fama.CLVineG γF S)) :
    Fama.Stage1Mk.MarkTransported γF F M (imageMarkLow F M) := by
  intro c c' h
  constructor
  · intro hc
    exact ⟨c, hc, h⟩
  · rintro ⟨c0, hc0, h0⟩
    have he : c0.atoms = c.atoms := F.img_injective (h0.symm.trans h)
    rw [← Fama.VineA.clVine_eq_of_atoms he]
    exact hc0

end

