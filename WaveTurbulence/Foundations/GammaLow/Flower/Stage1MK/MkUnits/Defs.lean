variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]
variable {w d : ℕ} {G : Garden w}

/-- The last member of a spine ends at the spine's lower joint. -/
theorem spine_lastLow {V D : Type} [DecidableEq V] [Fintype D] [DecidableEq D] {M : Molecule V D}
    {L : List (Finset V × V × V)} {U : Finset V} {a b : V} (h : Fama.Spine γF M L U a b) :
    ∃ T a', (T, a', b) ∈ L ∧ Src.IsSomeVine γF M T a' b ∧ T ⊆ U := by
  cases h with
  | one hv => exact ⟨_, _, List.mem_singleton_self _, hv, subset_rfl⟩
  | snoc _ hT _ _ => exact ⟨_, _, List.mem_append_right _ (List.mem_singleton_self _), hT, Finset.subset_union_right⟩

end

