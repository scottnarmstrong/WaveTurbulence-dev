open scoped Classical ENNReal
open WaveTurbulence WaveTurbulence.LGSpine WaveTurbulence.Induct Set Finset MeasureTheory WaveTurbulence.Represents WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden WaveTurbulence.VineAlign WaveTurbulence.RedSplice WaveTurbulence.VineC WaveTurbulence.Flower.Stage1W WaveTurbulence.Flower.MkDefs
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]

theorem fixMark_selfLow {w : ℕ} (a : Fama.VineA.PrescribedPrimeGarden γF w) (Mk : Set (Fama.CLVineG γF a.prime.skeleton)) :
    fixMarkLow a Mk a.prime = Mk := by
  ext c
  constructor
  · rintro ⟨c₀, h₀, he⟩
    rw [← eq_of_heq he]
    exact h₀
  · intro hc
    exact ⟨c, hc, HEq.rfl⟩

end

