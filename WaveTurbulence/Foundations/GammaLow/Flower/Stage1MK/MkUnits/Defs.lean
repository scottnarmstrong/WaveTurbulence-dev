open scoped Classical ENNReal
open WaveTurbulence WaveTurbulence.LGSpine WaveTurbulence.Induct Set Finset MeasureTheory WaveTurbulence.Represents WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden WaveTurbulence.VineAlign WaveTurbulence.RedSplice WaveTurbulence.VineC WaveTurbulence.Flower.Stage1W WaveTurbulence.Flower.MkDefs
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]

/-- Restricting the fine marking to `𝒱₀(σ)` does not change the unmarked `𝒱₀`. -/
theorem vinesV0_mkAtLow {w : ℕ} (mkF : Fama.Stage1Mk.MarkFn γF w) (a : Fama.VineA.PrescribedPrimeGarden γF w) :
    Fama.vinesV0 γF a.prime.skeleton a.totalSigma (mkAtLow mkF a) = Fama.vinesV0 γF a.prime.skeleton a.totalSigma (mkF a.prime) := by
  ext c
  rw [Fama.mem_vinesV0 (Mk := mkAtLow mkF a), Fama.mem_vinesV0 (Mk := mkF a.prime)]
  constructor
  · rintro ⟨h0, hn⟩
    exact ⟨h0, fun hm => hn ⟨hm, h0⟩⟩
  · rintro ⟨h0, hn⟩
    exact ⟨h0, fun hm => hn hm.1⟩

end

