/-! # FLOWER-LOW (L8 helper L8-I-UNITS), item I-UNITS: fine′ outputs at a marking and the run-assembly start

Main's `Flower.MkUnits.Defs.{outputs_congr_of_vinesV0,outputs_fixMark_mkAt,startAt}`.
Copied by source (sha256 in `MkUnits/COPIED-SHA256SUMS`) onto L5a's `𝒱_γ` API (`Fama`), L6's carrier `Src` and the
other item-I sub-areas' ports; statements are main's over `𝒱_{γF}` at `γF ≤ 1/2`. Generated by the helper's
`itool/gen_u_spec.py` (L8's `gen_i_spec.py` naming). -/

@[expose] public section
set_option autoImplicit false
noncomputable section
set_option linter.unusedSectionVars false

namespace WaveTurbulence.GammaLow.Flower

section
open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkUnits
open scoped Classical ENNReal
open WaveTurbulence WaveTurbulence.LGSpine WaveTurbulence.Induct Set Finset MeasureTheory WaveTurbulence.Represents WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden WaveTurbulence.VineAlign WaveTurbulence.RedSplice WaveTurbulence.VineC WaveTurbulence.Flower.Stage1W WaveTurbulence.Flower.MkDefs
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]

/-- The start state of the run assembly of `a` at the marked set `Mk` (`sourceStart a mk` is `startAt a (mk a.prime)`
definitionally). -/
noncomputable abbrev startAtLow {w : ℕ} (a : Fama.VineA.PrescribedPrimeGarden γF w) (Mk : Set (Fama.CLVineG γF a.prime.skeleton)) :=
  Famb.VineC.unitsStartΓ (Fama.alignedAssemblyMk γF (Mole.garden_isMolecule a.prime.skeleton) a.totalSigma Mk)
    (Fama.unitBlkMk_disj (Mole.garden_isMolecule _) a.totalSigma Mk) a.prime.data a.prime.prime.1
    (sourceLayerLow a) (sourceLayer_isLayeringLow a)

end

section
open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkUnits
open scoped Classical ENNReal
open WaveTurbulence WaveTurbulence.LGSpine WaveTurbulence.Induct Set Finset MeasureTheory WaveTurbulence.Represents WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden WaveTurbulence.VineAlign WaveTurbulence.RedSplice WaveTurbulence.VineC WaveTurbulence.Flower.Stage1W WaveTurbulence.Flower.MkDefs
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]

/-- Markings with the same unmarked `𝒱₀` have the same fine′ outputs. -/
theorem outputs_congr_of_vinesV0Low {w p : ℕ} {kind : Bool} (a : Fama.VineA.PrescribedPrimeGarden γF w) {mk mk' : Fama.Stage1Mk.MarkFn γF w}
    (h : Fama.vinesV0 γF a.prime.skeleton a.totalSigma (mk a.prime) = Fama.vinesV0 γF a.prime.skeleton a.totalSigma (mk' a.prime)) :
    a.outputsLow (p := p) (kind := kind) mk = a.outputsLow (p := p) (kind := kind) mk' := by
  unfold Fama.VineA.PrescribedPrimeGarden.outputsLow Fama.VineA.PrescribedPrimeGarden.state Fama.VineA.PrimeData.fineState
  exact Fama.VineA.PrimeData.state_allCoreOutputs_congr _ h _ _

end

section
open WaveTurbulence.Flower
open WaveTurbulence.Flower.MkUnits
open scoped Classical ENNReal
open WaveTurbulence WaveTurbulence.LGSpine WaveTurbulence.Induct Set Finset MeasureTheory WaveTurbulence.Represents WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden WaveTurbulence.VineAlign WaveTurbulence.RedSplice WaveTurbulence.VineC WaveTurbulence.Flower.Stage1W WaveTurbulence.Flower.MkDefs
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)]

/-- The internal units marking of the piece of `a` has the fine′ outputs of the fine marking. -/
theorem outputs_fixMark_mkAtLow {w p : ℕ} {kind : Bool} (mkF : Fama.Stage1Mk.MarkFn γF w) (a : Fama.VineA.PrescribedPrimeGarden γF w) :
    a.outputsLow (p := p) (kind := kind) (fixMarkLow a (mkAtLow mkF a)) = a.outputsLow (p := p) (kind := kind) mkF :=
  outputs_congr_of_vinesV0Low a (by rw [fixMark_selfLow]; exact vinesV0_mkAtLow mkF a)

end

/-- **Bridge (hand-written, L8-I-UNITS).** Main's `PrescribedPrimeGarden.outputs` has two ports over `𝒱_γ`: L8's
`Fama.VineA.PrescribedPrimeGarden.outputsLow` (`Stage1MK/P7`, used by item I) and L5a's
`Fama.VineA.PrescribedPrimeGarden.outputs` (`Fama/P/Supp/VinePrescribedPointsSupp`, used in the statements of L5a-G's
`Vine.Align` ports). Both copy main's body `(a.state mk).allCoreOutputs`, so they agree by `rfl`. -/
theorem mkUnits_outputsLow_eq_outputs {γF : ℝ} [Fact (γF ≤ 1 / 2)] {w p : ℕ} {kind : Bool}
    (a : Fama.VineA.PrescribedPrimeGarden γF w) (mk : Fama.Stage1Mk.MarkFn γF w) :
    a.outputsLow (p := p) (kind := kind) mk = Fama.VineA.PrescribedPrimeGarden.outputs (p := p) (kind := kind) a mk :=
  rfl

end WaveTurbulence.GammaLow.Flower
