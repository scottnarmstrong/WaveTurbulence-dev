/-- B2e's fine transport of `markIX` (`fineTransportedAt_markIXLow`). -/
theorem b2eIXLow : B2eIXLow (γF := γF) := fun J pat t s kSel a => fineTransportedAt_markIXLow J pat t s kSel a

