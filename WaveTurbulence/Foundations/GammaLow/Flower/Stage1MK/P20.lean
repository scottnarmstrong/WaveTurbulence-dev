/-- **Stem-free case: `markILow (γF := γF)` is a fine marking.** -/
theorem fineMarking_stemFreeLow (J : Finset (Fin w)) (pat : Fin w → FixPat) (t s : ℝ) {kSel σ : Fin w → Option ℕ}
    (hns : ¬ StemDep σ kSel) : FineMarkingLow J pat t s kSel σ (markILow (γF := γF) J pat t s kSel) := by
  have hk := (not_stemDep_iff.mp hns).2
  refine ⟨fun _ => subset_rfl, fun h => (hns h).elim, fun _ c hc => Or.inl hc, fun a => ?_⟩
  rw [markI_eq_markI0Low J pat t s hk]
  have h0 : Fama.Stage1Mk.MarkInvariantBatchV γF (@markI0Low γF _ w J pat t s) (fun _ => True) :=
    fun hb hA hm hc => markInvariantBatchV_markI0Low J pat t s hb hA hm hc
  exact (Fama.VineA.PrescribedPrimeGarden.fineTransportedAt_of_markInvariantBatchVLow (Clean := fun _ => True) h0 a trivial :
    a.FineTransportedAt γF (@markI0Low γF _ w J pat t s))

