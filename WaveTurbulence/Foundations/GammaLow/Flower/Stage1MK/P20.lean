/-- **`SoundMKFullG` for a piece at a prescribed point** (any marked set inside `𝒱₀(σ)`). -/
theorem pointPiece_soundFullLow (P : WTParams) [Fact (P.γ ≤ 1 / 2)] {R : ℕ} (hR : 1 ≤ R) {p N : ℕ} (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R))
    (hc : Stage1Mk.Stage1CarriesW P p N a.layered) (hNb : N ≤ P.N (p + 1) ^ 4) (hL : P.L ≠ 0)
    (roots : Fin (2 * R) → (Fin P.d → ℤ)) (cθ : ℝ) {Mk : Set (Fama.CLVineG P.γ a.prime.skeleton)}
    (hMk : Mk ⊆ Fama.vinesV0 P.γ a.prime.skeleton a.totalSigma)
    (prot : Finset (GBranch (Fama.stSt P.γ a.prime.skeleton a.totalSigma Mk).G.tree)) (nProt : ℕ)
    (fix : GBranch (Fama.stSt P.γ a.prime.skeleton a.totalSigma Mk).G.tree → Option ℝ)
    (filt : GBranch (Fama.stSt P.γ a.prime.skeleton a.totalSigma Mk).G.tree → Option (ℝ × SchwartzMap ℝ ℂ))
    (ind : (GNode (Fama.stSt P.γ a.prime.skeleton a.totalSigma Mk).G.tree → Mom P.d) → ℝ)
    (lb : GBranch (Fama.stSt P.γ a.prime.skeleton a.totalSigma Mk).G.tree → Option ℝ)
    (hrest : MkPieceRestLow
      (stage1PieceMKOfLow P a.prime.prime.1 a.layered a.prime.decodes a.totalSigma Mk prot nProt fix filt ind
        lb) cθ) :
    SoundMKFullG
      (stage1PieceMKOfLow P a.prime.prime.1 a.layered a.prime.decodes a.totalSigma Mk prot nProt fix filt ind lb)
      p 0 roots cθ := by
  obtain ⟨hI, hbal, hn⟩ := skelFacts_of_carriesW P p N hR hc a.prime
  have hsz := a.prime.data.decoded_order a.prime.prime.1 a.prime.decodes
  have hord : a.layered.garden.order = N := hc.2.1
  exact soundMKFull_markedLow P a.prime.prime.1 a.layered a.prime.decodes a.totalSigma hMk a.prime.prime hI hbal
    hn p (by omega) (fun v => Canon.layer_le_of_isCanonGC hc.1 _) hL 0 roots cθ prot nProt fix filt ind hrest

end

