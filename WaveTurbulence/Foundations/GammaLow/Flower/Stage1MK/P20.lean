/-- The good pieces of the gate data (non-zero classes from B3s, zero classes vanish). -/
theorem gate_goodLow (hB : MarkedClassRepresentsMKLow cP cθ P) (hIX : B2eIXLow (γF := P.γ)) (hZ : ZeroVanishLow P)
    (hC : 0 ≤ P.C₁) (hL : 0 < P.L) {p : ℕ} (hp : p < P.D) {R : ℕ} (hR : 1 ≤ R) (hRmax : R ≤ 10 * P.R (p + 1))
    {N : ℕ} (hN1 : 1 ≤ N) (hNb : N ≤ P.N (p + 1) ^ 4)
    (J : Finset (Fin (2 * R))) (hJ : J.card = R) (pat : Fin (2 * R) → FixPat) (kSel : Fin (2 * R) → Option ℕ)
    {t : ℝ} (ht : t ∈ Ioo (p : ℝ) (p + 1)) {s : ℝ} (hs : s ∈ Ioo (p : ℝ) t) (A : Finset (LayeredGarden (2 * R)))
    (hA : ∀ LG ∈ A, MkCarries P p N LG ∧ (∀ h : 2 * R = 2, ¬ IsRegularCouple (h ▸ LG.garden : Garden 2)) ∧
      LG.garden.Irreducible ∧ (∀ j ∈ J, LG.garden.tree j = TTree.leaf) ∧ CapGeo LG J p ∧ CapPatValid LG J pat p)
    (hpl : ∀ j, (kSel j).isSome → pat j = FixPat.plain)
    (hTC : MarkedTwistClosed p A (protSkOf R J (fun LG => fixCap LG J pat t s) (fun LG => selSetCap LG J kSel)))
    (roots : Fin (2 * R) → (Fin P.d → ℤ)) (h : ℕ → Fin (2 * R) → Fin (2 * R) → Mom P.d → ℝ) (b : ℝ)
    (Rf : Fin (2 * R) → Option ℝ) (σ : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ)
    (dag : Option (Fin (2 * R) → Fin 3 → Mom P.d))
    (hb : 1 ≤ b) (hh : ∀ q ≤ p, ∀ j j', SNormR (40 * P.d) (40 * P.d) (h q j j') ≤ ENNReal.ofReal b)
    (hRf : ∀ j r, Rf j = some r → P.L / 2 ≤ r) (hRs : ∀ j, P.L ≤ Rs j)
    (hhigh : ((∃ i, σ i ≠ none) ∨ ∃ i, kSel i ≠ none) → ∀ j, j ∉ J → ∃ r, Rf j = some r ∧
      (∀ j' x, ‖x‖ ≥ r → h p j j' x = 0 ∧ h p j' j x = 0) ∧ r ^ 10 ≤ ‖latticePoint P.L (roots j)‖)
    (π : Fama.Represents.PcA P.γ R p (objKind (2 * R)) A (fineMkLow (γF := P.γ) J pat t s kSel σ)) :
    Nonempty (GoodPieceLow P p N J pat kSel t s A roots h b Rf σ Rs dag cP cθ (fineMkLow (γF := P.γ) J pat t s kSel σ) π) := by
  have hF := fineMarking_fineMkLow hIX J pat t s kSel σ
  by_cases hnz : ¬ StemDep σ kSel ∨ ∀ a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R),
      Fama.VineA.PrescribedPrimeGarden.Related P.γ (p := p) (kind := objKind (2 * R)) (Fama.Represents.repPt P.γ π) a (fineMkLow (γF := P.γ) J pat t s kSel σ) → CleanPtLow J a
  · exact good_of_nonzeroLow P p N J pat kSel t s A roots h b Rf σ Rs dag cP cθ _ hB hp hR hRmax hN1 hNb hJ ht hs hA
      hpl hTC hb hh hRf hRs hhigh hF hL.ne' π hnz
  · push_neg at hnz
    exact good_of_zeroLow P p N J pat kSel t s A roots h b Rf σ Rs dag cP cθ _ hR hNb hA hb hRs hC hL π
      (hZ p hp R hR hRmax N hN1 hNb J pat kSel t ht s hs A hA roots h b Rf σ Rs dag hRf hhigh π hnz.1 hnz.2)

end

section
open WaveTurbulence.Flower
open WaveTurbulence.Flower.Stage1MKGate
open scoped Classical ENNReal
open WaveTurbulence WaveTurbulence.LGSpine WaveTurbulence.Induct Set Finset MeasureTheory
open WaveTurbulence.LGSpine.SourceVine WaveTurbulence.Flower.MkDefs WaveTurbulence.Flower.FinalMKDefs
open WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden WaveTurbulence.Represents
open WaveTurbulence.ClassCount
open WaveTurbulence.RedSplice (Prescription stSt vinesV0)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable (P : WTParams) [Fact (P.γ ≤ 1 / 2)] {R : ℕ} (p N : ℕ) (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat)
  (kSel : Fin (2 * R) → Option ℕ) (t s : ℝ) (A : Finset (LayeredGarden (2 * R)))
  (roots : Fin (2 * R) → (Fin P.d → ℤ)) (h : ℕ → Fin (2 * R) → Fin (2 * R) → Mom P.d → ℝ) (b : ℝ)
  (Rf : Fin (2 * R) → Option ℝ) (σ : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ)
  (dag : Option (Fin (2 * R) → Fin 3 → Mom P.d)) (cP cθ : ℝ) (mkF : Fama.Stage1Mk.MarkFn P.γ (2 * R))

/-- **Assembly of the gate's conclusion from one good piece per fine′ class.** -/
theorem gate_of_goodLow (C₀ K : ℕ) (hcnt : PieceCountAtLow (γF := P.γ) C₀ K) (hK : (K : ℝ) ^ (P.D + 1) ≤ P.C₂) (hp : p < P.D)
    (hR : 1 ≤ R) (hN1 : 1 ≤ N)
    (hA : ∀ LG ∈ A, MkCarries P p N LG ∧ (∀ h : 2 * R = 2, ¬ IsRegularCouple (h ▸ LG.garden : Garden 2)) ∧
      LG.garden.Irreducible ∧ (∀ j ∈ J, LG.garden.tree j = TTree.leaf) ∧ CapGeo LG J p ∧ CapPatValid LG J pat p)
    (hsub : ∀ {LG : LayeredGarden (2 * R)} (B : PrimeData LG), markI0Low (γF := P.γ) J pat t s B ⊆ mkF B)
    (hG : ∀ π : Fama.Represents.PcA P.γ R p (objKind (2 * R)) A mkF,
      Nonempty (GoodPieceLow P p N J pat kSel t s A roots h b Rf σ Rs dag cP cθ mkF π)) :
    ∃ (S : Stage1DataMKG P R) (Cl : Type) (hCl : Fintype Cl) (cls : S.Pc → Cl)
      (members : Cl → Finset (LayeredGarden (2 * R)))
      (sel : S.Pc → ∀ LG : LayeredGarden (2 * R), GenDecoration LG.garden P.d roots 0 → Prop)
      (selR : ∀ π, Finset (GBranch (S.piece π).Gsb.tree)),
      Stage1Partition roots A members cls sel ∧
      (∀ π, S.val π = ∑ LG ∈ members (cls π),
          kernelKgenSel P.L P.γ P.δ LG (fixCap LG J pat t s) (offCap LG J dag.isSome)
            (fun k => selOK LG J kSel * markedWeight LG J p P.L Rf σ (selCap LG J kSel) Rs h dag k)
            (fun _ => t) 0 roots (sel π LG) ∧
        RepresentsIntMKSelG (S.piece π) (selR π) N cP (fun _ => t) 0 roots
          (selMassMK N b Rs kSel ((selR π).image fun v => v.1.1)) (S.val π) ∧
        (∃ LG ∈ members (cls π), (S.piece π).nProt ≤ (protI LG J pat t s kSel).card) ∧
        (∀ v ∈ selR π, (kSel v.1.1).isSome ∧ (S.piece π).fix v = none ∧
          ∃ ψ : SchwartzMap ℝ ℂ, (S.piece π).filt v = some (Rs v.1.1, ψ) ∧ ∀ u, ψ u = (chiDN u : ℂ)) ∧
        (∀ v ∈ selR π, ∀ v' ∈ selR π, v.1.1 = v'.1.1 → v = v') ∧ (∀ v ∈ selR π, (S.piece π).lb v = none) ∧
        (selR π).card ≤ (S.piece π).nProt) ∧
      (∀ π, SoundMKFullG (S.piece π) p 0 roots cθ) ∧ (∀ π, (S.piece π).Gsb.order ≤ N) ∧
      Fama.Stage1CountsG C₀ P R N S.toData Cl hCl cls ∧
      (∀ π, (S.piece π).RepresentsIntMK N (cP + 343) (fun _ => t) 0 roots (b ^ N) (S.val π)) := by
  set kind := objKind (2 * R) with hkind
  let G : ∀ π : Fama.Represents.PcA P.γ R p kind A mkF, GoodPieceLow P p N J pat kSel t s A roots h b Rf σ Rs dag cP cθ mkF π :=
    fun π => Classical.choice (hG π)
  let S : Stage1DataMKG P R :=
    ⟨Fama.Represents.PcA P.γ R p kind A mkF, inferInstance, fun π => (G π).piece,
      fun π => classValueLow P p J pat kSel t s A roots h Rf σ Rs dag mkF π⟩
  have hplain : ∀ LG ∈ A, LG.garden.IsPlain := fun LG hLG => (hA LG hLG).1.1.1
  have hW : ∀ LG ∈ A, Stage1Mk.Stage1CarriesW P p N LG := fun LG hLG => carriersW_of P (hA LG hLG)
  have hV : Fama.Stage1Mk.MarkInvariantBatchV P.γ (@markI0Low P.γ _ (2 * R) J pat t s) (fun _ => True) :=
    fun hb hA' hm hc => markInvariantBatchV_markI0Low J pat t s hb hA' hm hc
  have hrepW : ∀ π : Fama.Represents.PcA P.γ R p kind A mkF, Stage1Mk.Stage1CarriesW P p N (Fama.Represents.repPt P.γ π).layered :=
    fun π => hW _ (Fama.Represents.repPt_layered_memMk π)
  -- the Stage-1 part of each piece
  have hD : ∀ π : Fama.Represents.PcA P.γ R p kind A mkF, (S.piece π).toStage1PieceGD =
      Fama.VineA.NormalizedSplice.stage1PieceOf P.γ P.d (Fama.Represents.repPt P.γ π).prime.prime.1 (Fama.Represents.repPt P.γ π).layered (Fama.Represents.repPt P.γ π).prime.decodes
        (Fama.Represents.repPt P.γ π).totalSigma (G π).Mk := fun π => (G π).hpiece
  refine ⟨S, Fama.Represents.ClA P.γ R p kind A (markI0Low (γF := P.γ) J pat t s), inferInstance, Fama.Represents.clsPMk P.γ (markI0Low (γF := P.γ) J pat t s), Fama.Represents.membersP P.γ,
    Fama.Represents.selPMk P.γ p kind A P 0 roots mkF, fun π => (G π).selR,
    Fama.Represents.stage1Partition_prodMk p kind A hplain P 0 roots hV hsub, fun π => ?_, fun π => (G π).sound, fun π => ?_, ?_,
    fun π => (G π).ok.repMK⟩
  · -- values, representation, protected count, residual selections
    refine ⟨rfl, (G π).ok.rep, ⟨(Fama.Represents.repPt P.γ π).layered, Finset.mem_filter.2 ⟨Fama.Represents.repPt_layered_memMk π,
      Fama.VineA.PrimeData.mem_coarse_outputs_selfMk (Fama.Represents.repPt P.γ π).prime
        (markI0Low (γF := P.γ) J pat t s (Fama.Represents.repPt P.γ π).prime)⟩, (G π).nprot⟩,
      (G π).ok.sel_spec, (G π).ok.sel_inj, (G π).ok.sel_lb, (G π).ok.sel_card⟩
  · -- orders
    have h1 := Fama.Represents.prod_piece_gsb_orderMk (mk := mkF) P p N kind A hW π
    have h2 := Fama.Represents.order_add_hinges_leMk (Mk := (G π).Mk) (Mole.garden_isMolecule (Fama.Represents.repPt P.γ π).prime.skeleton)
      (Fama.Represents.repPt P.γ π).totalSigma
    have e : (S.piece π).Gsb = (Fama.stSt P.γ (Fama.Represents.repPt P.γ π).prime.skeleton (Fama.Represents.repPt P.γ π).totalSigma (G π).Mk).G := by
      have := congrArg Fama.Stage1PieceGD.Gsb (hD π)
      exact this
    show (S.piece π).Gsb.order ≤ N
    rw [e]
    omega
  · -- counts
    refine ⟨fun π => ?_, fun π => ?_, ?_⟩
    · have hc := hrepW π
      have hn1 : 1 ≤ (Fama.Represents.repPt P.γ π).prime.skeleton.order := (skelFacts_of_carriesW P p N hR hc (Fama.Represents.repPt P.γ π).prime).2.2
      show 1 ≤ (S.piece π).toStage1PieceGD.rbar ∧ (S.piece π).toStage1PieceGD.rbar ≤ N
      rw [hD π]
      exact Fama.Represents.stage1Piece_rbar_boundsMk P.d (Fama.Represents.repPt P.γ π).prime.prime.1 (Fama.Represents.repPt P.γ π).layered (Fama.Represents.repPt P.γ π).prime.decodes
        (Fama.Represents.repPt P.γ π).totalSigma hn1 (Fama.Represents.prod_piece_gsb_orderMk (mk := mkF) P p N kind A hW π)
    · have hsz := (Fama.Represents.repPt P.γ π).prime.data.decoded_order (Fama.Represents.repPt P.γ π).prime.prime.1 (Fama.Represents.repPt P.γ π).prime.decodes
      have hord : (Fama.Represents.repPt P.γ π).layered.garden.order = N := (hrepW π).2.1
      show (S.piece π).toStage1PieceGD.gbar ≤ N
      rw [hD π]
      exact Fama.Represents.stage1Piece_gbar_leMk P.d (Fama.Represents.repPt P.γ π).prime.prime.1 (Fama.Represents.repPt P.γ π).layered (Fama.Represents.repPt P.γ π).prime.decodes
        (Fama.Represents.repPt P.γ π).totalSigma (by omega)
    · intro g r
      have hK' : K ^ (P.D + 1) ≤ P.C₂ := by exact_mod_cast hK
      have := hcnt P hK' p hp R hR N hN1 S.toData (fun π => (Fama.Represents.repPt P.γ π).layered) (3 ^ N)
        (fun π => ⟨hrepW π, ?_⟩) (fun LG => ?_) g r
      · have h2 := this
        push_cast at h2
        calc _ ≤ _ := h2
          _ = _ := by ring
      · show HasPieceDataMkLow (γF := P.γ) (fun _ _ _ => True) P.d (Fama.Represents.repPt P.γ π).layered (S.piece π).toStage1PieceGD.gbar
          (S.piece π).toStage1PieceGD.rbar
        rw [hD π]
        exact ⟨_, (Fama.Represents.repPt P.γ π).prime.data, (Fama.Represents.repPt P.γ π).prime.prime.1, (Fama.Represents.repPt P.γ π).prime.decodes, (Fama.Represents.repPt P.γ π).totalSigma,
          (G π).Mk, trivial, rfl, rfl⟩
      · by_cases hex : ∃ π : Fama.Represents.PcA P.γ R p kind A mkF, (Fama.Represents.repPt P.γ π).layered = LG
        · obtain ⟨π, hπ⟩ := hex
          have hpl : LG.garden.IsPlain := hπ ▸ (Fama.Represents.repPt P.γ π).prime.decodes.1
          exact Fama.Represents.fibre_card_leMk (mk := mkF) p kind A LG hpl (by rw [← hπ]; exact (hrepW π).2.1)
        · refine le_trans (le_of_eq (Finset.card_eq_zero.2 ?_)) (Nat.zero_le _)
          rw [Finset.filter_eq_empty_iff]
          intro π _ hπ
          exact hex ⟨π, hπ⟩

end

section
open WaveTurbulence.Flower
open WaveTurbulence.Flower.Stage1MKGate
open scoped Classical ENNReal
open WaveTurbulence WaveTurbulence.LGSpine WaveTurbulence.Induct Set Finset MeasureTheory
open WaveTurbulence.LGSpine.SourceVine WaveTurbulence.Flower.MkDefs WaveTurbulence.Flower.FinalMKDefs
open WaveTurbulence.VineA WaveTurbulence.VineA.PrescribedPrimeGarden WaveTurbulence.Represents
open WaveTurbulence.RedSplice (Prescription stSt vinesV0)
open WaveTurbulence.GammaLow.FinalCount
variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ}
variable {C₀ K : ℕ} {cP cθ : ℝ} {P : WTParams} [Fact (P.γ ≤ 1 / 2)]

/-- **The marked Stage-1′ gate, Full form, at fixed parameters.** -/
theorem fullAtLow (hcnt : PieceCountAtLow (γF := P.γ) C₀ K) (hK : (K : ℝ) ^ (P.D + 1) ≤ P.C₂) (hC : 0 ≤ P.C₁) (hL : 0 < P.L)
    (hB : MarkedClassRepresentsMKLow cP cθ P) (hIX : B2eIXLow (γF := P.γ)) (hZ : ZeroVanishLow P) :
    Stage1ReductionAtMKFullG C₀ cP cθ P := by
  intro p hp R hR hRmax N hN1 hNb J hJ pat kSel t ht s hs A hA hpl hTC roots h b Rf σ Rs dag hb hh hRf hRs hhigh
  have hF := fineMarking_fineMkLow hIX J pat t s kSel σ
  obtain ⟨S, Cl, hCl, cls, members, sel, selR, h1, h2, h3, h4, h5, -⟩ :=
    gate_of_goodLow P p N J pat kSel t s A roots h b Rf σ Rs dag cP cθ (fineMkLow (γF := P.γ) J pat t s kSel σ) C₀ K hcnt hK hp hR hN1
      hA (fun B => (markI0_sub_markILow J pat t s kSel B).trans (hF.sub B))
      (gate_goodLow hB hIX hZ hC hL hp hR hRmax hN1 hNb J hJ pat kSel ht hs A hA hpl hTC roots h b Rf σ Rs dag hb hh
        hRf hRs hhigh)
  exact ⟨S, Cl, hCl, cls, members, sel, selR, h1, h2, h3, h4, h5⟩

end

