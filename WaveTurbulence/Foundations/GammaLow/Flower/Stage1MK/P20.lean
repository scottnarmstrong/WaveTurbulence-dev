/-- **`SoundMKFullG` for the marked Stage-1′ piece** (F-C0-3): main's hypotheses of `stage1Piece_sound_succ_uncond`,
ruling R173 (`hMkSG`) and the non-geometric fields (`MkPieceRestLow`). -/
theorem soundMKFull_markedLow (P : WTParams) [Fact (P.γ ≤ 1 / 2)] {R : ℕ} {S : Garden (2 * R)} {D : ReconstructionData S}
    (hS : S.IsPlain) (LG : LayeredGarden (2 * R)) (hd : D.Decodes hS LG.garden) (σ : Prescription S)
    {Mk : Set (Fama.CLVineG P.γ S)} (hMkSG : Mk ⊆ Fama.vinesV0 P.γ S σ)
    (hP : IsPrimeGarden S) (hI : S.Irreducible) (hbal : IsBalancedSig S.sig) (hn : 1 ≤ S.order)
    (p : ℕ) (hN : S.order ≤ P.N (p + 1) ^ 4) (hlayer : ∀ v, RegRed.coreLayer LG D hS hd v ≤ p)
    (hL : P.L ≠ 0) (base : Mom P.d) (roots : Fin (2 * R) → (Fin P.d → ℤ)) (cθ : ℝ)
    (prot : Finset (GBranch (Fama.stSt P.γ S σ Mk).G.tree)) (nProt : ℕ)
    (fix : GBranch (Fama.stSt P.γ S σ Mk).G.tree → Option ℝ)
    (filt : GBranch (Fama.stSt P.γ S σ Mk).G.tree → Option (ℝ × SchwartzMap ℝ ℂ))
    (ind : (GNode (Fama.stSt P.γ S σ Mk).G.tree → Mom P.d) → ℝ) {lb : GBranch (Fama.stSt P.γ S σ Mk).G.tree → Option ℝ}
    (hrest : MkPieceRestLow (stage1PieceMKOfLow P hS LG hd σ Mk prot nProt fix filt ind lb) cθ) :
    SoundMKFullG (stage1PieceMKOfLow P hS LG hd σ Mk prot nProt fix filt ind lb) p base roots cθ := by
  obtain ⟨hB, hStr, hHinge⟩ := Fama.VineA.NormalizedSplice.construction_factsMk (Mk := Mk) S hP hI hbal hn σ
    (RegRed.coreLayer LG D hS hd) p (P.N (p + 1) ^ 4) hN hlayer
  exact
    { plain := hB.plain
      irreducible := hB.irreducible
      balanced := hB.balanced
      order_pos := hB.order_pos
      order_le := hB.order_le
      layer_le := hB.layer_le
      survivors := survData_structuralLow S σ Mk prot
      survivors_card := hrest.survivors_card
      prot_card := hrest.prot_card
      molecule := hB.molecule
      connected := hB.connected
      atom_count := hB.atom_count
      bond_count := hB.bond_count
      structural := hStr
      support := fun z h1 h2 =>
        subproSupportMK_survDataLow σ hMkSG _ rfl hB.plain hL P.γ P.η base roots z h1 h2 prot
      hingeOutsideFirst := hHinge
      tripleDesignated := tripleDesignated_collectionChoicesMkLow
        (WaveTurbulence.Mole.garden_isMolecule S) (RedSplice.prime_noTriple S hP) σ
      hingeNoLoop := Fama.VineA.NormalizedSplice.hingeNoLoop_collectionChoicesMk σ
      chainOrder := survData_chainOrderLow S σ Mk prot
      fix_prot := hrest.fix_prot
      fix_layer := hrest.fix_layer
      filt_ok := hrest.filt_ok
      ind_ok := hrest.ind_ok
      ind_local := hrest.ind_local
      lb_free := hrest.lb_free
      lb_prot := hrest.lb_prot
      lb_layer := hrest.lb_layer }

end

