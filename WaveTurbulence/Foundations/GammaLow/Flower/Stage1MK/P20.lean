/-- **`TripleDesignated` for the marked splice** (R37/R48, o75 Theorem 7.5′(2),(5); world `SoundMKFull`). -/
theorem tripleDesignated_collectionChoicesMkLow {R : ℕ} {G : Garden (2 * R)} (hM : G.molecule.IsMolecule)
    (hno : ∀ a b, G.molecule.bondsBetween a b ≠ 3) (σ : Prescription G) {Mk : Set (Fama.CLVineG γF G)} :
    (Fama.VineA.NormalizedSplice.collectionChoices γF G σ Mk).TripleDesignated := by
  intro a b h
  rcases (Fama.stSt γF G σ Mk).triple_hinge hno a b h with ha | hb
  · obtain ⟨x, y, hxy, hT, h1, h2⟩ := triple_in_hingePairMkLow hM σ ha h
    exact ⟨a, ha, b, x, y, Or.inl ⟨rfl, rfl⟩, by simp [Fama.VineA.NormalizedSplice.collectionChoices, hxy], by simp [Fama.VineA.NormalizedSplice.collectionChoices, hxy],
      hT, h1, h2⟩
  · have h' : (Fama.stSt γF G σ Mk).G.molecule.bondsBetween b a = 3 := by
      rw [Mole.bondsBetween_symm]; exact h
    obtain ⟨x, y, hxy, hT, h1, h2⟩ := triple_in_hingePairMkLow hM σ hb h'
    exact ⟨b, hb, a, x, y, Or.inr ⟨rfl, rfl⟩, by simp [Fama.VineA.NormalizedSplice.collectionChoices, hxy], by simp [Fama.VineA.NormalizedSplice.collectionChoices, hxy],
      hT, h1, h2⟩

end

