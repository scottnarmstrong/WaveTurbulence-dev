/-- **A survivor is a vine, or the HV of a one-survivor HVC** (o75 Theorem 7.5′(2), 75-W1; R169). -/
theorem survObj_objVineLow {σ : Prescription G} {Mk : Set (Fama.CLVineG γF G)}
    {t : Finset (GBranch G.tree) × GBranch G.tree × GBranch G.tree} (ht : t ∈ Fama.survivorsMk γF G σ Mk) :
    ObjVineG (Fama.stSt γF G σ Mk).G.molecule (survObjLow ht) := by
  obtain ⟨-, -, -, -, -, -, h⟩ := survObj_specLow ht
  unfold ObjVineG
  rcases h with ⟨hX, hvc, hs⟩ | ⟨hA, R, hs⟩
  · rw [hs]; exact hX
  · rw [hs]
    unfold Src.AllowedCollectionObject at hA
    rw [hs] at hA
    have hX := hA
    exact hX

end

