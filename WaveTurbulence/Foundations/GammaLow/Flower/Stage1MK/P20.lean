variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable (P : WTParams) [Fact (P.γ ≤ 1 / 2)] {R : ℕ} (p N : ℕ) (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat)
  (kSel : Fin (2 * R) → Option ℕ) (t s : ℝ) (A : Finset (LayeredGarden (2 * R)))
  (roots : Fin (2 * R) → (Fin P.d → ℤ)) (h : ℕ → Fin (2 * R) → Fin (2 * R) → Mom P.d → ℝ) (b : ℝ)
  (Rf : Fin (2 * R) → Option ℝ) (σ : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ)
  (dag : Option (Fin (2 * R) → Fin 3 → Mom P.d)) (cP cθ : ℝ) (mkF : Fama.Stage1Mk.MarkFn P.γ (2 * R))

/-- **The good piece of a zero class** (class value `0`). -/
theorem good_of_zeroLow (hR : 1 ≤ R) (hNb : N ≤ P.N (p + 1) ^ 4)
    (hA : ∀ LG ∈ A, MkCarries P p N LG ∧ (∀ h : 2 * R = 2, ¬ IsRegularCouple (h ▸ LG.garden : Garden 2)) ∧
      LG.garden.Irreducible ∧ (∀ j ∈ J, LG.garden.tree j = TTree.leaf) ∧ CapGeo LG J p ∧ CapPatValid LG J pat p)
    (hb : 1 ≤ b) (hRs : ∀ j, P.L ≤ Rs j) (hC : 0 ≤ P.C₁) (hL : 0 < P.L) (π : Fama.Represents.PcA P.γ R p (objKind (2 * R)) A mkF)
    (hval : classValueLow P p J pat kSel t s A roots h Rf σ Rs dag mkF π = 0) :
    Nonempty (GoodPieceLow P p N J pat kSel t s A roots h b Rf σ Rs dag cP cθ mkF π) := by
  have hcW := carriersW_of P (hA _ (Fama.Represents.repPt_layered_memMk π))
  have hRs0 : ∀ j, 0 ≤ Rs j := fun j => hL.le.trans (hRs j)
  have hrest := zeroPiece_restLow P (Fama.Represents.repPt P.γ π) cθ
  refine ⟨⟨zeroPieceLow P (Fama.Represents.repPt P.γ π), ∅, ∅, rfl, ?_, Nat.zero_le _,
    zeroPiece_soundFullLow P hR (Fama.Represents.repPt P.γ π) hcW hNb hL.ne' roots cθ⟩⟩
  refine ⟨?_, ⟨hrest.prot_card, hrest.fix_prot, hrest.fix_layer, hrest.filt_ok, hrest.ind_ok, hrest.ind_local,
    hrest.lb_free, hrest.lb_prot, hrest.lb_layer⟩, by simp, by simp, by simp, ?_, by simp⟩
  · rw [hval]
    exact representsIntMKSel_zeroLow _ _ N cP _ 0 roots _ hC hL.le
      (selMassMK_nonneg N (zero_le_one.trans hb) hRs0 kSel _)
  · rw [hval]
    exact representsIntMK_zeroLow _ N (cP + 343) _ 0 roots _ hC hL.le (pow_nonneg (zero_le_one.trans hb) N)

end

