theorem zeroPiece_soundFullLow (P : WTParams) [Fact (P.γ ≤ 1 / 2)] {R : ℕ} (hR : 1 ≤ R) {p N : ℕ} (a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R))
    (hc : Stage1Mk.Stage1CarriesW P p N a.layered) (hNb : N ≤ P.N (p + 1) ^ 4) (hL : P.L ≠ 0)
    (roots : Fin (2 * R) → (Fin P.d → ℤ)) (cθ : ℝ) : SoundMKFullG (zeroPieceLow P a) p 0 roots cθ :=
  pointPiece_soundFullLow P hR a hc hNb hL roots cθ (Set.empty_subset _) ∅ 0 (fun _ => none) (fun _ => none) (fun _ => 1)
