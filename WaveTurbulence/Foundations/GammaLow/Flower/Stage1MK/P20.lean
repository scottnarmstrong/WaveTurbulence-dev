variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable (P : WTParams) [Fact (P.γ ≤ 1 / 2)] {R : ℕ} (p N : ℕ) (J : Finset (Fin (2 * R))) (pat : Fin (2 * R) → FixPat)
  (kSel : Fin (2 * R) → Option ℕ) (t s : ℝ) (A : Finset (LayeredGarden (2 * R)))
  (roots : Fin (2 * R) → (Fin P.d → ℤ)) (h : ℕ → Fin (2 * R) → Fin (2 * R) → Mom P.d → ℝ) (b : ℝ)
  (Rf : Fin (2 * R) → Option ℝ) (σ : Fin (2 * R) → Option ℕ) (Rs : Fin (2 * R) → ℝ)
  (dag : Option (Fin (2 * R) → Fin 3 → Mom P.d)) (cP cθ : ℝ) (mkF : Fama.Stage1Mk.MarkFn P.γ (2 * R))

/-- **The good piece of a non-zero class** (from B3s's hypothesis). -/
theorem good_of_nonzeroLow (hB : MarkedClassRepresentsMKLow cP cθ P) (hp : p < P.D) (hR : 1 ≤ R)
    (hRmax : R ≤ 10 * P.R (p + 1)) (hN1 : 1 ≤ N) (hNb : N ≤ P.N (p + 1) ^ 4) (hJ : J.card = R)
    (ht : t ∈ Ioo (p : ℝ) (p + 1)) (hs : s ∈ Ioo (p : ℝ) t)
    (hA : ∀ LG ∈ A, MkCarries P p N LG ∧ (∀ h : 2 * R = 2, ¬ IsRegularCouple (h ▸ LG.garden : Garden 2)) ∧
      LG.garden.Irreducible ∧ (∀ j ∈ J, LG.garden.tree j = TTree.leaf) ∧ CapGeo LG J p ∧ CapPatValid LG J pat p)
    (hpl : ∀ j, (kSel j).isSome → pat j = FixPat.plain)
    (hTC : MarkedTwistClosed p A (protSkOf R J (fun LG => fixCap LG J pat t s) (fun LG => selSetCap LG J kSel)))
    (hb : 1 ≤ b) (hh : ∀ q ≤ p, ∀ j j', SNormR (40 * P.d) (40 * P.d) (h q j j') ≤ ENNReal.ofReal b)
    (hRf : ∀ j r, Rf j = some r → P.L / 2 ≤ r) (hRs : ∀ j, P.L ≤ Rs j)
    (hhigh : ((∃ i, σ i ≠ none) ∨ ∃ i, kSel i ≠ none) → ∀ j, j ∉ J → ∃ r, Rf j = some r ∧
      (∀ j' x, ‖x‖ ≥ r → h p j j' x = 0 ∧ h p j' j x = 0) ∧ r ^ 10 ≤ ‖latticePoint P.L (roots j)‖)
    (hF : FineMarkingLow J pat t s kSel σ mkF) (hL : P.L ≠ 0) (π : Fama.Represents.PcA P.γ R p (objKind (2 * R)) A mkF)
    (hnz : ¬ StemDep σ kSel ∨ ∀ a : Fama.VineA.PrescribedPrimeGarden P.γ (2 * R),
      Fama.VineA.PrescribedPrimeGarden.Related P.γ (p := p) (kind := objKind (2 * R)) (Fama.Represents.repPt P.γ π) a mkF → CleanPtLow J a) :
    Nonempty (GoodPieceLow P p N J pat kSel t s A roots h b Rf σ Rs dag cP cθ mkF π) := by
  obtain ⟨prot, fix, filt, ind, lb, selR, hok⟩ := hB p hp R hR hRmax N hN1 hNb J hJ pat kSel t ht s hs A hA hpl hTC
    roots h b Rf σ Rs dag hb hh hRf hRs hhigh mkF hF π hnz
  have hnz' : ¬ StemDep σ kSel ∨ CleanPtLow J (Fama.Represents.repPt P.γ π) :=
    hnz.imp id fun h => h (Fama.Represents.repPt P.γ π) (Relation.EqvGen.refl _)
  have hcW := carriersW_of P (hA _ (Fama.Represents.repPt_layered_memMk π))
  refine ⟨⟨classPieceLow P mkF (Fama.Represents.repPt P.γ π) prot (protI (Fama.Represents.repPt P.γ π).layered J pat t s kSel).card fix filt ind lb,
    selR, classMkLow mkF (Fama.Represents.repPt P.γ π), rfl, hok, le_rfl, ?_⟩⟩
  exact pointPiece_soundFullLow P hR (Fama.Represents.repPt P.γ π) hcW hNb hL roots cθ (classMk_sub_vinesV0Low mkF _) prot _ fix filt ind lb
    ⟨classPiece_surv_leLow P hF (Fama.Represents.repPt P.γ π) hnz' prot fix filt ind lb, hok.rest.prot_card, hok.rest.fix_prot,
      hok.rest.fix_layer, hok.rest.filt_ok, hok.rest.ind_ok, hok.rest.ind_local, hok.rest.lb_free,
      hok.rest.lb_prot, hok.rest.lb_layer⟩

end

