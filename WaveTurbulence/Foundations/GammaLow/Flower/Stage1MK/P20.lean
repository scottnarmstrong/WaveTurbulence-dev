/-- **o75 Theorem 7.5′ (2), (4), (5) with 75-F1, (6), (6′)** for the marked splice, as the world's
`SubproSupportMKG`, on one decoration of the support of the epsilon and gap factors. -/
theorem subproSupportMK_survDataLow {R : ℕ} {G : Garden (2 * R)} (σ : Prescription G) {Mk : Set (Fama.CLVineG γF G)}
    (hMkSG : Mk ⊆ Fama.vinesV0 γF G σ) {d : ℕ} (D : SplicedKernelData (Fama.stSt γF G σ Mk).G d)
    (hD : D.gapSpecification = Fama.VineA.NormalizedSplice.gapSpecificationMk γF G σ Mk)
    (hpl : (Fama.stSt γF G σ Mk).G.IsPlain) {L : ℝ} (hL : L ≠ 0) (γ η : ℝ) (base : Mom d)
    (roots : Fin (2 * R) → (Fin d → ℤ)) (z : GenDecoration (Fama.stSt γF G σ Mk).G d roots 0)
    (hε : splicedEpsilon (Fama.stSt γF G σ Mk).G (Fama.VineA.NormalizedSplice.collectionChoices γF G σ Mk).hinges z.1 ≠ 0)
    (hZ : splicedGapIndicator (Fama.stSt γF G σ Mk).G D L γ η base z.1 ≠ 0)
    (prot : Finset (GBranch (Fama.stSt γF G σ Mk).G.tree)) :
    SubproSupportMKG (Fama.stSt γF G σ Mk).G (Fama.VineA.NormalizedSplice.collectionChoices γF G σ Mk) (survDataLow G σ Mk prot)
      L γ η base (Finset.univ.image (fun i => base + latticePoint L (roots i))) (bondIndex (Fama.stSt γF G σ Mk).G z.1) :=
  have h := subproSupportMKAtLow σ hMkSG D hD hpl hL γ η base roots z hε hZ
  ⟨h.selectedSG, h.survivorSG, h.zeroTame, h.contained, h.hingeSG, h.hingeJoint, h.jointPair, h.crossing,
    h.meetB⟩

end

