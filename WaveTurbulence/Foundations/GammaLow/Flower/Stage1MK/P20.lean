/-- **`fineMkLow (γF := γF)` is a fine marking.** -/
theorem fineMarking_fineMkLow (hIX : B2eIXLow (γF := γF)) (J : Finset (Fin w)) (pat : Fin w → FixPat) (t s : ℝ)
    (kSel σ : Fin w → Option ℕ) : FineMarkingLow J pat t s kSel σ (fineMkLow (γF := γF) J pat t s kSel σ) := by
