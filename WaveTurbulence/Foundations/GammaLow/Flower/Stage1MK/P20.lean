/-- **`SurvivorDataG.Structural`** (R169) for the survivors of the marked splice and `𝒞₁ = Fama.collectionChoices γF G σ Mk`. -/
theorem survData_structuralLow (G : Garden w) (σ : Prescription G) (Mk : Set (Fama.CLVineG γF G))
    (prot : Finset (GBranch (Fama.stSt γF G σ Mk).G.tree)) :
    (survDataLow G σ Mk prot).Structural (Fama.VineA.NormalizedSplice.collectionChoices γF G σ Mk) := by
  have hM : G.molecule.IsMolecule := WaveTurbulence.Mole.garden_isMolecule G
  refine ⟨fun i => ?_, fun i j => ?_, fun i j hij => ?_, fun v hv i => ?_⟩
  · obtain ⟨j, hj, -, hgi⟩ := survObjs_getLow (σ := σ) (Mk := Mk) i
    change ObjVineG _ ((survObjsLow G σ Mk).get i)
    rw [hgi]
    exact survObj_objVineLow hj
  · obtain ⟨j', hj', -, hgj⟩ := survObjs_getLow (σ := σ) (Mk := Mk) j
    change Disjoint ((Fama.VineA.NormalizedSplice.objects γF G σ Mk).get i).atoms
      ((survObjsLow G σ Mk).get j).atoms
    rw [hgj]
    exact objects_disjoint_survObjLow hM σ (List.get_mem _ _) hj'
  · exact survObjs_inter_cardLow hM σ i j hij
  · obtain ⟨j, hj, -, hgi⟩ := survObjs_getLow (σ := σ) (Mk := Mk) i
    change ¬ ((survObjsLow G σ Mk).get i).IsInterior v
    rw [hgi]
    exact survObj_not_interiorLow hj hv

end

