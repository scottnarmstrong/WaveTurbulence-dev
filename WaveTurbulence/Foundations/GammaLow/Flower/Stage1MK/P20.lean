variable {γF : ℝ} [Fact (γF ≤ 1 / 2)] [Fact Fama.TVineF1Input] [Fact Fama.VinechainlemPrimeInput] [Fact Fama.TVineIsoInvariant]
variable {w : ℕ} {G : Garden w}

/-- **R37 with survivors**: if a hinge `v` of `G_sb` has a triple bond to `c`, the hinge pair of `v` consists of two
bonds of that triple bond. -/
theorem triple_in_hingePairMkLow {R : ℕ} {G : Garden (2 * R)} (hM : G.molecule.IsMolecule) (σ : Prescription G)
    {Mk : Set (Fama.CLVineG γF G)} {v c : GBranch (Fama.stSt γF G σ Mk).G.tree} (hv : v ∈ (Fama.stSt γF G σ Mk).hinges)
    (h3 : (Fama.stSt γF G σ Mk).G.molecule.bondsBetween v c = 3) :
    ∃ x y, Fama.VineA.NormalizedSplice.hingePair γF G σ v = some (x, y) ∧ TripleAt (Fama.stSt γF G σ Mk).G v x y ∧
      (Fama.stSt γF G σ Mk).G.molecule.atom ((Fama.stSt γF G σ Mk).G.molecule.mate x) = c ∧
      (Fama.stSt γF G σ Mk).G.molecule.atom ((Fama.stSt γF G σ Mk).G.molecule.mate y) = c := by
  classical
  have hM' := Mole.garden_isMolecule (Fama.stSt γF G σ Mk).G
  obtain ⟨S0, hS0, hσ0, u0, hu0, hcr0⟩ := hinge_groupMkLow hM σ hv
  have hu0B : u0 ∈ Fama.unitBlocks γF G σ Mk := Fama.mem_unitBlocksMk.mpr ⟨S0, hS0, hσ0, hu0⟩
  have hvc : v ≠ c := Fama.VineA.NormalizedSplice.hinge_neMk (Mk := Mk) hM σ hu0B hcr0 h3
  by_cases hmk : Fama.markedGroup γF G Mk S0
  · obtain ⟨q, hq, hT, t, ht, hjv, h1, h2⟩ := hingePair_markedHingeLow hM σ hS0 hσ0 hmk hu0 hcr0
    have hxy : q.1 ≠ q.2 := fun h => hT.2.2.2 (by rw [h])
    obtain ⟨e1, e2⟩ := pair_in_triple_of_objLow hM' (survObjLow ht) hjv hvc h3 hT.1 hT.2.1 hxy
      (inGroup_of_containsDartLow _ h1) (inGroup_of_containsDartLow _ h2)
    exact ⟨q.1, q.2, hq, hT, e1, e2⟩
  have hu0' : u0 ∈ (Fama.groupUnitsOf γF G S0).units := Fama.groupUnitsMk_of_not_marked hmk ▸ hu0
  obtain ⟨x, y, hp, hPP, -, hentry⟩ := hingePair_specMkLow hM σ hS0 hσ0 hmk hu0' hcr0
  have hT := hPP.1
  have hxy : x ≠ y := fun h => hT.2.2.2 (by rw [h])
  refine ⟨x, y, hp, hT, ?_⟩
  by_cases hobj : ∃ O ∈ Fama.VineA.NormalizedSplice.objects γF G σ Mk, O.upper = v ∨ O.lower = v
  · obtain ⟨O, hOm, hj⟩ := hobj
    obtain ⟨hc1, hc2, -⟩ := hingePair_containedMkLow hM σ hv hp hOm hj
    have hj' : v = O.upper ∨ v = O.lower := by rcases hj with h | h; exact Or.inl h.symm; exact Or.inr h.symm
    exact pair_in_triple_of_objLow hM' O hj' hvc h3 hT.1 hT.2.1 hxy (inGroup_of_containsDartLow _ hc1)
      (inGroup_of_containsDartLow _ hc2)
  rcases hsk : (Fama.groupUnitsOf γF G S0).skip with _ | sk
  swap
  · -- a skipped vine: its object has the joint `v`
    exfalso
    apply hobj
    obtain ⟨O, hex, hOm⟩ := objOf_isSomeMkLow hM σ hS0 hσ0 (Or.inr ⟨sk, hsk⟩) hmk
    obtain ⟨-, -, -, hOspec⟩ := Fama.VineA.NormalizedSplice.objOf_specMk (Option.mem_def.mpr hex)
    obtain ⟨A, -, -, -, hsrc⟩ := hOspec.src
    rcases hsrc with ⟨⟨hhv, hnh⟩, -⟩ | ⟨sk', hsk', -, hup, hlo, -, -⟩
    · have := (Fama.groupUnitsOf γF G S0).hv_empty hhv hnh
      rw [this] at hu0'
      cases hu0'
    · rw [hsk] at hsk'
      cases hsk'
      have hsu := (Fama.groupUnitsOf γF G S0).skip_units sk hsk
      refine ⟨O, hOm, ?_⟩
      rcases hsu.1 u0 hu0' with ⟨hL, hl⟩ | ⟨hR, hr⟩
      · have hxu : sk.x ∈ u0.atoms := by
          rcases hl with ⟨_, h2⟩ | ⟨h2, _⟩
          · rw [← h2]; exact u0.isBlock.2.2.1
          · rw [← h2]; exact u0.isBlock.2.1
        exact Or.inl (hup.trans (pi_of_crownLow hM σ hu0B hcr0 hxu))
      · have hxu : sk.y ∈ u0.atoms := by
          rcases hr with ⟨h2, _⟩ | ⟨_, h2⟩
          · rw [← h2]; exact u0.isBlock.2.1
          · rw [← h2]; exact u0.isBlock.2.2.1
        exact Or.inr (hlo.trans (pi_of_crownLow hM σ hu0B hcr0 hxu))
  -- a whole-group unit: main's R37 argument
  obtain ⟨S, hSm, hga, hep⟩ := hentry hobj
  obtain ⟨a, ha, hav⟩ : ∃ a, Fama.VineA.NormalizedSplice.groupJoint γF G S Mk = some a ∧ (Fama.stSt γF G σ Mk).M.pi (Fama.stSt γF G σ Mk).hcls a = v := by
    unfold Fama.VineA.NormalizedSplice.groupAtom at hga
    cases hg : Fama.VineA.NormalizedSplice.groupJoint γF G S Mk with
    | none => rw [hg] at hga; cases hga
    | some a => rw [hg] at hga; exact ⟨a, rfl, Option.some.inj hga⟩
  have hnmS := not_marked_of_groupJointLow ha
  have ha' : Fama.VineA.NormalizedSplice.groupJoint γF G S = some a := (groupJoint_of_not_markedLow hnmS).symm.trans ha
  have haS := (Fama.VineA.NormalizedSplice.groupJoint_kind ha').1
  have hSS : S = S0 := group_eq_of_pi_eqLow hM σ hSm hS0 haS (Fama.groupUnitsMk_sub hu0 u0.isBlock.2.1)
    (hav.trans (pi_of_crownLow hM σ hu0B hcr0 u0.isBlock.2.1).symm)
  subst hSS
  have hUS := (Fama.groupUnitsOf γF G S).noskip_units hsk u0 hu0'
  have hau : a ∈ u0.atoms := hUS ▸ haS
  obtain ⟨p, hp1, hbest⟩ := Fama.VineA.NormalizedSplice.hingeOrigPair_bestMk (Mk := Mk) ha ⟨u0, hu0', hau⟩
  unfold Fama.VineA.NormalizedSplice.hingeEntryPair at hep
  rw [hp1, Option.bind_some] at hep
  obtain ⟨hq1, hq2, -⟩ := Fama.VineA.NormalizedSplice.liftPair_specMk hep
  have hX := whole_pair_in_tripleMkLow hM σ hSm hσ0 hmk hu0' hsk hcr0 hvc h3 hau hbest
  refine ⟨(od_mem_tripleDartsMkLow σ (v := v) ?_).2, (od_mem_tripleDartsMkLow σ (v := v) ?_).2⟩
  · show (Fama.stSt γF G σ Mk).M.od (x, y).1 ∈ _
    rw [hq1]; exact hX.1
  · show (Fama.stSt γF G σ Mk).M.od (x, y).2 ∈ _
    rw [hq2]; exact hX.2

end

