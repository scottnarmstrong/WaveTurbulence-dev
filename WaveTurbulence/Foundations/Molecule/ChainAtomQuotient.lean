module

public import WaveTurbulence.Foundations.Molecule.MarkedGardenChains
public import WaveTurbulence.Foundations.Molecule.MergeQuotientGlue
import Mathlib.Tactic

/-! # Collapsing all CL ingredients leaves exactly the distinguished atom carrier
TARGET `blockchainprop`, splicing assertion. The carrier on the left is
the actual quotient generated by all CL-group atom identifications.
-/

public section
namespace WaveTurbulence.Mole
open TTree Finset
namespace MarkedGardenChain
variable {w : ℕ} {G : Garden w} {focus : GardenBlockSegment G}
variable {X : Finset (GBranch G.tree)} {left right : GBranch G.tree}

/-- Constructed atom equivalence, together with its pointwise fixation
of the distinguished ingredient. This is output data, never a premise. -/
structure AtomEquivalenceData (C : MarkedGardenChain G focus X left right) where
  equiv : MergeQuotient X C.erasedGroups ≃ focus.atoms
  fixesFocus : ∀ v : focus.atoms,
    equiv (mergeClass X C.erasedGroups ⟨v.1,C.focus_subset v.2⟩) = v

@[expose] noncomputable def atomEquivalenceData (C : MarkedGardenChain G focus X left right) : AtomEquivalenceData C := by
  induction C with
  | base =>
    refine ⟨mergeQuotientEmptyEquiv focus.atoms,?_⟩
    intro v
    rfl
  | @append X left right prev A hj hi hU hCL ih =>
    let e := mergeQuotientGlue X A.atoms right prev.erasedGroups prev.block.2.2.1
      (hj ▸ A.block.2.1) hi prev.erasedGroups_subset
    refine ⟨e.trans ih.equiv,?_⟩
    intro v
    let oldv : ↥X := ⟨v.1,prev.focus_subset v.2⟩
    have he : e (mergeClass (X ∪ A.atoms) (A.atoms :: prev.erasedGroups)
        ⟨v.1,(MarkedGardenChain.append prev A hj hi hU hCL).focus_subset v.2⟩) =
        mergeClass X prev.erasedGroups oldv :=
      mergeQuotientGlue_old_class X A.atoms right prev.erasedGroups prev.block.2.2.1
        (hj ▸ A.block.2.1) hi prev.erasedGroups_subset oldv
    exact (congrArg ih.equiv he).trans (ih.fixesFocus v)
  | @prepend X left right prev A hj hi hU hCL ih =>
    let e := mergeQuotientGlue X A.atoms left prev.erasedGroups prev.block.2.1
      (hj ▸ A.block.2.2.1) hi prev.erasedGroups_subset
    refine ⟨e.trans ih.equiv,?_⟩
    intro v
    let oldv : ↥X := ⟨v.1,prev.focus_subset v.2⟩
    have he : e (mergeClass (X ∪ A.atoms) (A.atoms :: prev.erasedGroups)
        ⟨v.1,(MarkedGardenChain.prepend prev A hj hi hU hCL).focus_subset v.2⟩) =
        mergeClass X prev.erasedGroups oldv :=
      mergeQuotientGlue_old_class X A.atoms left prev.erasedGroups prev.block.2.1
        (hj ▸ A.block.2.2.1) hi prev.erasedGroups_subset oldv
    exact (congrArg ih.equiv he).trans (ih.fixesFocus v)

end MarkedGardenChain
end WaveTurbulence.Mole
