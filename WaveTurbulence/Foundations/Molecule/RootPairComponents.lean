module

public import WaveTurbulence.Foundations.Molecule.PairingParity
public import Mathlib.SetTheory.Cardinal.Finite
import Mathlib.Tactic

/-! # Root-component bound from odd leaf fibers
TARGET `cnblock`: completely paired forests whose trees have odd leaf
counts have at most half as many root components as trees.
-/

public section
namespace WaveTurbulence.Mole
open Finset

/-- A finite surjection with no singleton fiber has at most half as many targets. -/
theorem two_mul_card_le_of_fiber_companion {T Q : Type*} [Fintype T] [Fintype Q]
    (q : T → Q) (hsur : Function.Surjective q)
    (hcomp : ∀ a : T, ∃ b, b ≠ a ∧ q b = q a) :
    2*Fintype.card Q ≤ Fintype.card T := by
  classical
  have hlow : ∀ z : Q, 2 ≤ (univ.filter (fun a : T => q a = z)).card := by
    intro z
    obtain ⟨a,rfl⟩ := hsur z
    obtain ⟨b,hba,hbq⟩ := hcomp a
    have hs : ({a,b} : Finset T) ⊆ univ.filter (fun x => q x = q a) := by
      intro x hx
      simp only [mem_insert,mem_singleton] at hx
      rcases hx with rfl | rfl
      · exact mem_filter.mpr ⟨mem_univ _,rfl⟩
      · exact mem_filter.mpr ⟨mem_univ _,hbq⟩
    have hc := Finset.card_le_card hs
    rw [Finset.card_pair hba.symm] at hc
    exact hc
  have hsum := Finset.card_eq_sum_card_fiberwise (s := (univ : Finset T))
    (t := (univ : Finset Q)) (f := q) (fun _ _ => mem_univ _)
  calc
    _ = ∑ _z : Q, 2 := by simp [Nat.mul_comm]
    _ ≤ ∑ z : Q, (univ.filter (fun a : T => q a = z)).card := sum_le_sum (fun z _ => hlow z)
    _ = _ := by simpa only [card_univ] using hsum.symm

/-- Pairing edges between the trees containing their two leaves. -/
@[expose] def RootPairRel {L T : Type*} (root : L → T) (pair : L → L) (a b : T) : Prop :=
  ∃ l, root l = a ∧ root (pair l) = b

/-- The actual component equivalence generated by cross-tree leaf pairings. -/
@[expose] def rootPairSetoid {L T : Type*} (root : L → T) (pair : L → L) : Setoid T where
  r := Relation.EqvGen (RootPairRel root pair)
  iseqv := ⟨fun a => Relation.EqvGen.refl a,fun h => Relation.EqvGen.symm _ _ h,
    fun h1 h2 => Relation.EqvGen.trans _ _ _ h1 h2⟩

/-- Odd leaf counts force every root component to contain at least two trees. -/
theorem root_pair_component_bound {L T : Type*} [Fintype L] [Fintype T] [DecidableEq T]
    (root : L → T) (pair : L → L) (hpair : Function.Involutive pair)
    (hne : ∀ l, pair l ≠ l)
    (hodd : ∀ t, Odd (Fintype.card {l : L // root l = t})) :
    2*Nat.card (Quotient (rootPairSetoid root pair)) ≤ Fintype.card T := by
  classical
  let q : T → Quotient (rootPairSetoid root pair) := Quotient.mk _
  have hs : Function.Surjective q := Quotient.mk_surjective
  have hc : ∀ a : T, ∃ b, b ≠ a ∧ q b = q a := by
    intro a
    obtain ⟨l,hl,hother⟩ := odd_fiber_has_external_pair root pair hpair hne a (hodd a)
    refine ⟨root (pair l),hother,?_⟩
    apply Eq.symm
    apply Quotient.sound
    exact Relation.EqvGen.rel _ _ ⟨l,hl,rfl⟩
  have h := two_mul_card_le_of_fiber_companion q hs hc
  simpa only [Nat.card_eq_fintype_card] using h

end WaveTurbulence.Mole
