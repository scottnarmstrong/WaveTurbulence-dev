module

public import Mathlib.Data.Finset.Basic
public import Mathlib.Logic.Equiv.Defs
import Mathlib.Tactic

/-! # Actual simultaneous atom-identification quotients
Molecular splicing identifies the atoms of each selected group. The
equivalence relation is generated by those identifications, with no
preselected representative and no assumed resulting graph isomorphism.
-/

public section
namespace WaveTurbulence.Mole
open Finset
variable {V : Type*} [DecidableEq V]

@[expose] def MergeGroupRel (groups : List (Finset V)) (u v : V) : Prop :=
  ∃ S ∈ groups, u ∈ S ∧ v ∈ S

@[expose] def mergeGroupSetoid (X : Finset V) (groups : List (Finset V)) : Setoid ↥X where
  r := Relation.EqvGen (fun u v => MergeGroupRel groups u.1 v.1)
  iseqv := ⟨fun u => Relation.EqvGen.refl u,fun h => Relation.EqvGen.symm _ _ h,
    fun h1 h2 => Relation.EqvGen.trans _ _ _ h1 h2⟩

abbrev MergeQuotient (X : Finset V) (groups : List (Finset V)) := Quotient (mergeGroupSetoid X groups)

end WaveTurbulence.Mole
