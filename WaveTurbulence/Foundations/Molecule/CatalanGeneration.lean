module

public import WaveTurbulence.Foundations.Molecule.PartitionEnclosure

/-! # Legal partitions are generated by concatenation and enclosure

The construction retains the actual increasing block embeddings. Labels are
not quotiented by arbitrary permutations.
-/

public section
namespace WaveTurbulence.Reg
open Finset

/-- DH21 Proposition 4.5(2), retaining all actual positions and partner involutions. -/
inductive CatalanGenerated : {n : ℕ} → PairPartition n → Prop
  | empty (P : PairPartition 0) : CatalanGenerated P
  | concat {n : ℕ} (P : PairPartition n) (S : Finset (Fin n))
      (hi : ∀ x ∈ S, ∀ y, y ≤ x → y ∈ S) (hc : ∀ x ∈ S, P.pair x ∈ S)
      (hS : 0 < S.card) (hT : 0 < Sᶜ.card) :
      CatalanGenerated (P.onBlock S hc) →
      CatalanGenerated (P.onBlock Sᶜ (P.complement_closed S hc)) → CatalanGenerated P
  | enclose {n : ℕ} (P : PairPartition n) (a b : Fin n) (hab : P.pair a = b)
      (ha : ∀ x, a ≤ x) (hb : ∀ x, x ≤ b) :
      CatalanGenerated (P.onBlock (PairPartition.remaining a b) (P.remaining_partner_mem hab)) →
      CatalanGenerated P

/-- Every concatenation/enclosure derivation is noncrossing. -/
theorem CatalanGenerated.legal {n : ℕ} {P : PairPartition n} (h : CatalanGenerated P) : P.Legal := by
  induction h with
  | empty P => intro a; exact Fin.elim0 a
  | concat P S hi hc _ _ _ _ ihS ihT => exact (P.legal_iff_blocks S hi hc).mpr ⟨ihS,ihT⟩
  | enclose P a b hab ha hb _ ih => exact (P.legal_iff_enclosure hab ha hb).mpr ih

private theorem card_lt_univ_of_missing {n : ℕ} (S : Finset (Fin n)) (x : Fin n) (hx : x ∉ S) :
    S.card < n := by
  have hs : S ⊂ Finset.univ := Finset.ssubset_iff_subset_ne.mpr
    ⟨Finset.subset_univ _,fun he => hx (he ▸ Finset.mem_univ x)⟩
  simpa only [Finset.card_univ,Fintype.card_fin] using Finset.card_lt_card hs

/-- Every legal partition has a concatenation/enclosure derivation. -/
theorem catalanGenerated_of_legal {n : ℕ} (P : PairPartition n) (hP : P.Legal) :
    CatalanGenerated P := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    by_cases hn : n = 0
    · subst n
      exact .empty P
    have hn : 0 < n := Nat.pos_of_ne_zero hn
    let a : Fin n := ⟨0,hn⟩
    let b := P.pair a
    by_cases hb : ∀ x : Fin n, x ≤ b
    · have hcard := P.remaining_card (a := a) (b := b) rfl
      apply CatalanGenerated.enclose P a b rfl (fun x => by exact Nat.zero_le _) hb
      exact ih _ (by omega) _ ((P.legal_iff_enclosure rfl (fun x => by exact Nat.zero_le _) hb).mp hP)
    · let S := Finset.univ.filter (fun x : Fin n => x ≤ b)
      have hclosed : ∀ x ∈ S, P.pair x ∈ S := P.first_pair_closed hP hn
      have hinit : ∀ x ∈ S, ∀ y, y ≤ x → y ∈ S := by
        intro x hx y hy
        exact Finset.mem_filter.mpr ⟨Finset.mem_univ _,hy.trans (Finset.mem_filter.mp hx).2⟩
      have haS : a ∈ S := Finset.mem_filter.mpr ⟨Finset.mem_univ _,by exact Nat.zero_le _⟩
      obtain ⟨t,ht⟩ := not_forall.mp hb
      have htS : t ∉ S := fun hh => ht (Finset.mem_filter.mp hh).2
      have haT : a ∉ Sᶜ := by simpa only [Finset.mem_compl,not_not] using haS
      have htT : t ∈ Sᶜ := Finset.mem_compl.mpr htS
      exact CatalanGenerated.concat P S hinit hclosed
        (Finset.card_pos.mpr ⟨a,haS⟩) (Finset.card_pos.mpr ⟨t,htT⟩)
        (ih _ (card_lt_univ_of_missing S t htS) _ (P.onBlock_legal hP S hclosed))
        (ih _ (card_lt_univ_of_missing Sᶜ a haT) _
          (P.onBlock_legal hP Sᶜ (P.complement_closed S hclosed)))

/-- DH21 Proposition 4.5(2), with both directions proved. -/
theorem legal_iff_catalanGenerated {n : ℕ} (P : PairPartition n) :
    P.Legal ↔ CatalanGenerated P := ⟨catalanGenerated_of_legal P,CatalanGenerated.legal⟩

end WaveTurbulence.Reg
