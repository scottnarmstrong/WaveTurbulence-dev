module

public import WaveTurbulence.Foundations.Molecule.PartitionDeletion

/-! # Legal partitions are generated by adjacent insertion (DH21 Proposition 4.5(1)) -/

public section

namespace WaveTurbulence.Reg

/-- The paper's adjacent-pair construction, read backwards through increasing deletion.
The endpoints and their positions are part of the construction data. -/
inductive AdjacentGenerated : {n : ℕ} → PairPartition n → Prop
  | empty (P : PairPartition 0) : AdjacentGenerated P
  | insert {n : ℕ} (P : PairPartition n) {a b : Fin n} (hab : P.pair a = b)
      (hadj : b.val = a.val + 1) :
      AdjacentGenerated (P.deletePair hab) → AdjacentGenerated P

/-- Every adjacent-insertion derivation gives a noncrossing partition. -/
theorem AdjacentGenerated.legal {n : ℕ} {P : PairPartition n} (h : AdjacentGenerated P) :
    P.Legal := by
  induction h with
  | empty P => intro a; exact Fin.elim0 a
  | insert P hab hadj _ ih => exact P.legal_of_deletePair hab hadj ih

/-- Every noncrossing partition admits an adjacent-insertion derivation. -/
theorem adjacentGenerated_of_legal {n : ℕ} (P : PairPartition n) (h : P.Legal) :
    AdjacentGenerated P := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    by_cases hn : n = 0
    · subst n
      exact .empty P
    · obtain ⟨a,b,hadj,hab⟩ := P.exists_adjacent h (Nat.pos_of_ne_zero hn)
      have hcard := P.remaining_card hab
      exact .insert P hab hadj (ih _ (by omega) _ (P.deletePair_legal h hab))

/-- DH21 Prop 4.5(1): legality is equivalent to construction by adjacent insertion. -/
theorem legal_iff_adjacentGenerated {n : ℕ} (P : PairPartition n) :
    P.Legal ↔ AdjacentGenerated P := ⟨adjacentGenerated_of_legal P, AdjacentGenerated.legal⟩

end WaveTurbulence.Reg
