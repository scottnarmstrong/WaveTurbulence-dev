namespace WaveTurbulence.Flower.IncTop
open WaveTurbulence.Incoh
open WaveTurbulence.Incoh.MomentumTreeData in
/-- Actual source amplitudes, with the fixed mask generated by each leaf-center array. -/
@[expose] def MomentumTreeData.allCellMaskedSpectralAmplitudeSpatial {d n m w : ℕ}
    (P : MomentumTreeData n m w) (ζ : Circle) (f : Fin m → Mom d → ℂ)
    (S : (Fin m → Fin d → ℤ) → Finset ((Fin n × Fin 2) → Fin d → ℤ)) (k : Mom d)
    (u : SourceCellIndex S × (LocalizedCellIndex n m → Fin d → ℝ)) : ℂ :=
  (MomentumTreeData.maskedSourceSpectralAmplitudeSpatial (P := P)) ζ f u.1.1 u.1.2.val k u.2

open WaveTurbulence.Incoh.MomentumTreeData in
/-- Every actual amplitude has all momentum derivatives, with the source garden sign retained. -/
theorem MomentumTreeData.contDiff_allCellMaskedSpectralAmplitudeSpatial {d n m w : ℕ}
    (P : MomentumTreeData n m w) (ζ : Circle) (f : Fin m → Mom d → ℂ)
    (S : (Fin m → Fin d → ℤ) → Finset ((Fin n × Fin 2) → Fin d → ℤ))
    (u : SourceCellIndex S × (LocalizedCellIndex n m → Fin d → ℝ)) :
    ContDiff ℝ ∞ (fun k => (MomentumTreeData.allCellMaskedSpectralAmplitudeSpatial (P := P)) ζ f S k u) :=
  (MomentumTreeData.contDiff_maskedSourceSpectralAmplitudeSpatial (P := P)) ζ f u.1.1 u.1.2.val u.2

open WaveTurbulence.Incoh.MomentumTreeData in
/-- The actual all-cell amplitude has the proved common full spatial envelope. -/
theorem MomentumTreeData.weighted_norm_allCellMaskedAmplitudeDerivative_leSpatial {d n m w J j W : ℕ}
    (P : MomentumTreeData n m w) (ζ : Circle) (f : Fin m → Mom d → ℂ)
    (S : (Fin m → Fin d → ℤ) → Finset ((Fin n × Fin 2) → Fin d → ℤ))
    (hj : j ≤ J) (k : Mom d) (u : SourceCellIndex S × (LocalizedCellIndex n m → Fin d → ℝ)) :
    Fourier.momentumBracket k ^ W *
      ‖iteratedFDeriv ℝ j (fun k => (MomentumTreeData.allCellMaskedSpectralAmplitudeSpatial (P := P)) ζ f S k u) k‖ ≤
        maskedCellEnvelopeSpatial J W f S u :=
  (MomentumTreeData.weighted_norm_iteratedFDeriv_maskedSourceAmplitude_leSpatial (P := P)) ζ f u.1.1 u.1.2.val u.2 k hj

/-- Actual common derivative envelopes are integrable on the full selected-cell measure. -/
theorem integrable_maskedCellEnvelopeSpatial {d n m K M : ℕ} (J W : ℕ)
    (f : Fin m → Mom d → ℂ)
    (S : (Fin m → Fin d → ℤ) → Finset ((Fin n × Fin 2) → Fin d → ℤ))
    {C : ℝ} (hS : ∀ c, ((S c).card : ℝ) ≤ C ^ n) {B : ℝ}
    (hK : d + 1 + J ≤ K) (hM : W + 2 * d ≤ M) (hB : 0 ≤ B)
    (h : ∀ a, Fourier.spatialNorm K M (f a) ≤ ENNReal.ofReal B) :
    Integrable (maskedCellEnvelopeSpatial J W f S) (sourceCellMeasure S) := by
  refine ⟨(measurable_maskedCellEnvelopeSpatial J W f S (by omega) hB h).aestronglyMeasurable, ?_⟩
  apply (hasFiniteIntegral_iff_ofReal (ae_of_all _ (maskedCellEnvelope_nonnegSpatial J W f S))).mpr
  exact (lintegral_maskedCellEnvelope_leSpatial J W f S hS hK hM hB h).trans_lt
    (ENNReal.mul_lt_top (ENNReal.mul_lt_top ENNReal.ofReal_lt_top ENNReal.ofReal_lt_top)
      (ENNReal.mul_lt_top (ENNReal.pow_lt_top ENNReal.ofReal_lt_top) (ENNReal.pow_lt_top ENNReal.ofReal_lt_top)))

open WaveTurbulence.Incoh.MomentumTreeData in
/-- Actual fixed-momentum masked amplitudes are strongly measurable. -/
theorem MomentumTreeData.stronglyMeasurable_allCellMaskedSpectralAmplitudeSpatial {d n m w K M : ℕ}
    (P : MomentumTreeData n m w) (ζ : Circle) (f : Fin m → Mom d → ℂ)
    (S : (Fin m → Fin d → ℤ) → Finset ((Fin n × Fin 2) → Fin d → ℤ)) {B : ℝ}
    (hK : d + 1 ≤ K) (hB : 0 ≤ B)
    (h : ∀ a, Fourier.spatialNorm K M (f a) ≤ ENNReal.ofReal B) (k : Mom d) :
    StronglyMeasurable ((MomentumTreeData.allCellMaskedSpectralAmplitudeSpatial (P := P)) ζ f S k) := by
  apply Measurable.stronglyMeasurable
  apply measurable_from_prod_countable_right
  intro u
  change Measurable (fun ξ : LocalizedCellIndex n m → Fin d → ℝ =>
    sourceRootMask u.1 k * (MomentumTreeData.sourceSpectralAmplitudeSpatial (P := P)) ζ f u.1 u.2.val k ξ)
  exact (continuous_const.mul ((MomentumTreeData.continuous_sourceSpectralAmplitudeSpatial (P := P)) ζ f u.1 u.2.val hK hB h k)).measurable

open WaveTurbulence.Incoh.MomentumTreeData in
/-- Actual masked amplitudes are integrable using only the order-zero source budget. -/
theorem MomentumTreeData.integrable_allCellMaskedSpectralAmplitudeSpatial {d n m w K M : ℕ}
    (P : MomentumTreeData n m w) (ζ : Circle) (f : Fin m → Mom d → ℂ)
    (S : (Fin m → Fin d → ℤ) → Finset ((Fin n × Fin 2) → Fin d → ℤ))
    {C : ℝ} (hS : ∀ c, ((S c).card : ℝ) ≤ C ^ n) {B : ℝ}
    (hK : d + 1 ≤ K) (hM : 2 * d ≤ M) (hB : 0 ≤ B)
    (h : ∀ a, Fourier.spatialNorm K M (f a) ≤ ENNReal.ofReal B) (k : Mom d) :
    Integrable ((MomentumTreeData.allCellMaskedSpectralAmplitudeSpatial (P := P)) ζ f S k) (sourceCellMeasure S) := by
  have hE := integrable_maskedCellEnvelopeSpatial 0 0 f S hS (by omega) (by omega) hB h
  apply hE.mono' ((MomentumTreeData.stronglyMeasurable_allCellMaskedSpectralAmplitudeSpatial (P := P)) ζ f S hK hB h k).aestronglyMeasurable
  apply ae_of_all
  intro u
  have hh := MomentumTreeData.weighted_norm_allCellMaskedAmplitudeDerivative_leSpatial (P := P) ζ f S
    (J := 0) (j := 0) (W := 0) le_rfl k u
  simpa only [pow_zero, one_mul, norm_iteratedFDeriv_zero] using hh

end WaveTurbulence.Flower.IncTop