  have hcg : ∀ tt ∈ Bx, ∀ τ : D.S.TVar → ℝ, True := fun _ _ _ => trivial
  refine ⟨_, _, _, ?_, hPR.congr (fun tt htt => Filter.Eventually.of_forall fun τ hd r k hr => by
    simp only [bundlePtG, ptP, ptR, Sum.elim_inl, Sum.elim_inr, if_pos hA]
