    simp only [CertSrc.szQ, CertSrc.szT, src.cq_c, src.ct_c, abs_mul, abs_flagSign, abs_neg, abs_one, mul_one, one_mul]
    calc _ = ((2 : ℝ) ^ D.wDec * (P.d : ℝ) ^ (D.wN + 1)) * (|src.cc b| * src.CJq b * src.CMq b * (|src.cT b| * src.CJt b * src.CMt b)) := by ring
      _ ≤ Ksp P.d * (|src.cc b| * src.CJq b * src.CMq b * (|src.cT b| * src.CJt b * src.CMt b)) :=
        mul_le_mul_of_nonneg_right (kF_le hd hwN hwDec) (by positivity)

