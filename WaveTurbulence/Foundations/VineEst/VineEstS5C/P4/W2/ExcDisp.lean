/-! # P4-W2 (session 7, step 3e): the per-summand dispatch (generated by `uni/scratch8/gen_disp.py`)

`disp_*`: for each non-joint summand of a bundle (the pieces A1, A2, KQ, KT in case A and their case-M mirrors, and the ten remainder shapes), the `PieceRep` of
the summand `bundlePtG caseA S bs₁ bs₂ rA rB RQ RT t₀ s₁ t₁ (k + e_x r) (k + e_y r) c` from the order facts and the open windows of the three clocks, together with
the product bound `bK * bL ≤ Kall d K₀ · ofReal (size)` (`CertSrc.szQ`, `CertSrc.szT`, `CRq`, `CRt`) and the factor `FacOK` (`1`, or `‖r‖` for the kind-1 pieces KQ, KT). -/

@[expose] public section
variable {rowSelU : Unit} [rowSel : WaveTurbulence.VineEst.RowSel rowSelU]
set_option autoImplicit false
namespace WaveTurbulence.VineEstS5C.P4.W2
open WaveTurbulence WaveTurbulence.VineEstS3Par.Eng WaveTurbulence.VineEstS3.FS WaveTurbulence.VineEstS5A WaveTurbulence.VineEstS4c
  WaveTurbulence.DegenVine WaveTurbulence.DegenVinePar WaveTurbulence.VineEstS5C.P2 WaveTurbulence.VineEstS5C.P4 MeasureTheory
open scoped ENNReal ComplexConjugate
variable {A : ℝ} {P : WTParams}

open Classical in
theorem disp_A1 (G : AmbP A P) :
    ∃ C : ℝ≥0∞, C ≠ ⊤ ∧
      ∀ (K0 : ℝ≥0∞), C ≤ K0 → 1 ≤ K0 →
      ∀ (D : SumintPar.SumintDatum P.d) (hI : 0 < D.S.I) (hwN : D.wN + 1 = 30 * P.d) (hwDec : D.wDec = 30 * P.d)
      (vp vb : D.S.VIdx) (ε ex ey : ℝ) (hfl : FlagXY ε ex ey) 
      (t0 s1 t1 : WaveTurbulence.VineEstS3Par.Eng.Slot D) (caseA : Prop) (hA : caseA)
      {β : Type*} [DecidableEq β] (S : SepTerms β P.d) (RQ RT : β → ℝ → ℝ → Mom P.d → ℂ) {q2 q4 qh : ℝ}
      (src : Src P S RQ RT q2 q4 qh) (bs1 bs2 rA rB : Finset β) (b : β) (hbm : b ∈ bs1) (hb : src.good b)
      (i : Fin (S.mQ b)) (j : Fin (S.mT b)) (Bx : Set (Fin 3 → ℝ)),
      (∀ tt ∈ Bx, ∀ᵐ τ : D.S.TVar → ℝ, τ ∈ D.timeDom hI (tt 0) (tt 1) (tt 2) →
        (slotVal D τ tt s1 ≤ slotVal D τ tt t0 ∧ slotVal D τ tt t0 < slotVal D τ tt t1) ∧ slotVal D τ tt s1 ∈ Wsel q4 qh (decide caseA) ∧ slotVal D τ tt t1 ∈ Wsel q4 qh (!decide caseA) ∧
          slotVal D τ tt t0 ∈ Set.Ioo q2 (q2 + 1)) →
      ∃ (fac : (D.S.TVar → ℝ) → Mom P.d → ℂ) (bK bL : ℝ≥0∞), FacOK 0 fac ∧
        PieceRep (P := P) hI vp vb ε fac
          (fun τ tt r k => bundlePtG caseA S bs1 bs2 rA rB RQ RT (slotVal D τ tt t0) (slotVal D τ tt s1) (slotVal D τ tt t1)
            (k + ex • r) (k + ey • r) (Sum.inl (Sum.inl ⟨⟨b, hbm⟩, i, j⟩))) bK bL Bx ∧
        bK * bL ≤ Kall P.d K0 * ENNReal.ofReal (src.szQ b * src.szT b) := by
  obtain ⟨C, hC, h⟩ := excw_A1 G
  refine ⟨C, hC, fun K0 hCK hK0 D hI hwN hwDec vp vb ε ex ey hfl t0 s1 t1 caseA hA β _ S RQ RT q2 q4 qh src bs1 bs2 rA rB b hbm hb i j Bx hG => ?_⟩
  have hd := G.hd1
  set sA : Bool := decide caseA with hsA
  have hOne : (1 : ℝ) ≤ Ksp P.d := one_le_Ksp hd
  have hJq : 0 ≤ src.CJq b := (src.cq sA b i).hCJ
  have hMq : 0 ≤ src.CMq b := (src.cq sA b i).hCM
  have hJt : 0 ≤ src.CJt b := (src.ct (!sA) b j).hCJ
  have hMt : 0 ≤ src.CMt b := (src.ct (!sA) b j).hCM
  have hPR := @h D hI hwN hwDec vp vb ε ex ey hfl t0 s1 t1 β S b i j _ _ _ _ _ _ _ _ (src.cq sA b i) (src.ct (!sA) b j) Bx (Wsel q4 qh sA) (Wsel q4 qh (!sA)) (Set.Ioo q2 (q2 + 1)) (src.winq_sel hb i sA) (src.wint_sel hb j (!sA)) hG
  have hcg : ∀ tt ∈ Bx, ∀ τ : D.S.TVar → ℝ, True := fun _ _ _ => trivial
  refine ⟨_, _, _, ?_, hPR.congr (fun tt htt => Filter.Eventually.of_forall fun τ hd r k hr => by
    simp only [bundlePtG, ptP, ptR, Sum.elim_inl, Sum.elim_inr, if_pos hA]
    try ring_nf), ?_⟩
  · exact ⟨1, by simp, fun τ r => by simp⟩
  · refine (bnd_P hd hwN hwDec _ _ K0 hCK hCK _ _ _ _ _ (by first | exact hJq | exact hJt) (by first | exact hJq | exact hJt)
      (by first | exact hMq | exact hMt | positivity) (by first | exact hMq | exact hMt | positivity)).trans
      (Ksp_le_Kall hd K0 _ _ ?_ (mul_nonneg (src.szQ_nonneg hJq hMq) (src.szT_nonneg hJt hMt)))
    simp only [CertSrc.szQ, CertSrc.szT, src.cq_c, src.ct_c, abs_mul, abs_flagSign, abs_neg, abs_one, mul_one, one_mul]
    calc _ = (1) * (|src.cc b| * src.CJq b * src.CMq b * (|src.cT b| * src.CJt b * src.CMt b)) := by ring
      _ ≤ Ksp P.d * (|src.cc b| * src.CJq b * src.CMq b * (|src.cT b| * src.CJt b * src.CMt b)) :=
        mul_le_mul_of_nonneg_right (hOne) (by positivity)

