module

public import WaveTurbulence.Foundations.VineEst.VineEstS5C.P4.W2.ExcDisp3
public import WaveTurbulence.Foundations.VineEst.VineEstS5C.P4.W2.ExcDisp2

/-! # P4-W2 (session 7, step 3h (main dispatch, joint summands)): the per-summand dispatch (generated by `uni/scratch8/gen_disp.py`)

`disp_*`: for each non-joint summand of a bundle (the pieces A1, A2, KQ, KT in case A and their case-M mirrors, and the ten remainder shapes), the `PieceRep` of
the summand `bundlePtG caseA S bs₁ bs₂ rA rB RQ RT t₀ s₁ t₁ (k + e_x r) (k + e_y r) c` from the order facts and the open windows of the three clocks, together with
the product bound `bK * bL ≤ Kall d K₀ · ofReal (size)` (`Src.szQ`, `Src.szT`, `CRq`, `CRt`) and the factor `FacOK` (`1`, or `‖r‖` for the kind-1 pieces KQ, KT). -/

@[expose] public section
variable {rowSelU : Unit} [rowSel : WaveTurbulence.VineEst.RowSel rowSelU]
set_option autoImplicit false
namespace WaveTurbulence.VineEstS5C.P4.W2
open WaveTurbulence WaveTurbulence.VineEstS3Par.Eng WaveTurbulence.VineEstS3.FS WaveTurbulence.VineEstS5A WaveTurbulence.VineEstS4c
  WaveTurbulence.DegenVine WaveTurbulence.DegenVinePar WaveTurbulence.VineEstS5C.P2 WaveTurbulence.VineEstS5C.P4 MeasureTheory
open scoped ENNReal ComplexConjugate
variable {A : ℝ} {P : WTParams}


open Classical in
theorem exc_dispatch_k2 (G : AmbP A P) (Rb : ℝ) :
    ∃ K0 : ℝ≥0∞, K0 ≠ ⊤ ∧ 1 ≤ K0 ∧
      ∀ (D : SumintPar.SumintDatum P.d) (hI : 0 < D.S.I) (hwN : D.wN + 1 = 30 * P.d) (hwDec : D.wDec = 30 * P.d)
      (vp vb : D.S.VIdx) (ε ex ey : ℝ) (hfl : FlagXY ε ex ey)
      (t0 s1 t1 : WaveTurbulence.VineEstS3Par.Eng.Slot D) (sa ta : D.S.TVar) (hsa : s1 = Sum.inl sa) (hsb : t1 = Sum.inl ta)
      (hab : sa ≠ ta) (caseA : Prop)
      {β : Type*} [DecidableEq β] (S : SepTerms β P.d) (RQ RT : β → ℝ → ℝ → Mom P.d → ℂ) {q2 q4 qh : ℝ}
      (src : Src P S RQ RT q2 q4 qh) (hq : qh = q4) (hq4 : 0 ≤ q4) (hq2 : 0 ≤ q2) (hRb : max (q4 + 1) (q2 + 1) ≤ Rb)
      (bs1 bs2 rA rB : Finset β) (hgood : ∀ b, (b ∈ bs1 ∨ b ∈ bs2) → src.good b)
      (c : Ch S bs1 bs2 rA rB) (hk : kindOf c = 2) (Bx : Set (Fin 3 → ℝ)),
      (∀ tt ∈ Bx, ∀ᵐ τ : D.S.TVar → ℝ, τ ∈ D.timeDom hI (tt 0) (tt 1) (tt 2) →
        ExcOrd caseA (slotVal D τ tt t0) (slotVal D τ tt s1) (slotVal D τ tt t1) c ∧
          slotVal D τ tt s1 ∈ Set.Ioo q4 (q4 + 1) ∧ slotVal D τ tt t1 ∈ Set.Ioo q4 (q4 + 1) ∧
          slotVal D τ tt t0 ∈ Set.Ioo q2 (q2 + 1)) →
      ∃ (bK bL : ℝ≥0∞),
        PieceRep (P := P) hI vp vb ε (fun τ _ => ((|τ sa - τ ta| ^ (1 - 3 * P.η) : ℝ) : ℂ))
          (fun τ tt r k => bundlePtG caseA S bs1 bs2 rA rB RQ RT (slotVal D τ tt t0) (slotVal D τ tt s1) (slotVal D τ tt t1)
            (k + ex • r) (k + ey • r) c) bK bL Bx ∧
        bK * bL ≤ Kall P.d K0 * ENNReal.ofReal (src.sz c) := by
  obtain ⟨C_TQ, C'_TQ, hC_TQ, hC'_TQ, h_TQ⟩ := disp_TQ G Rb
  obtain ⟨C_TT, C'_TT, hC_TT, hC'_TT, h_TT⟩ := disp_TT G Rb
  obtain ⟨C_MTQ, C'_MTQ, hC_MTQ, hC'_MTQ, h_MTQ⟩ := disp_MTQ G Rb
  obtain ⟨C_MTT, C'_MTT, hC_MTT, hC'_MTT, h_MTT⟩ := disp_MTT G Rb
  have n_C_TQ := ENNReal.toReal_nonneg (a := C_TQ)
  have n_C_TT := ENNReal.toReal_nonneg (a := C_TT)
  have n_C_MTQ := ENNReal.toReal_nonneg (a := C_MTQ)
  have n_C_MTT := ENNReal.toReal_nonneg (a := C_MTT)
  have n_Cp_TQ := ENNReal.toReal_nonneg (a := C'_TQ)
  have n_Cp_TT := ENNReal.toReal_nonneg (a := C'_TT)
  have n_Cp_MTQ := ENNReal.toReal_nonneg (a := C'_MTQ)
  have n_Cp_MTT := ENNReal.toReal_nonneg (a := C'_MTT)
  set tot : ℝ := 1 + (C_TQ.toReal + C'_TQ.toReal + C_TT.toReal + C'_TT.toReal + C_MTQ.toReal + C'_MTQ.toReal + C_MTT.toReal + C'_MTT.toReal) with htot
  have hle : ∀ (C : ℝ≥0∞), C ≠ ⊤ → C.toReal ≤ tot → C ≤ ENNReal.ofReal tot := fun C hC h => by
    rw [← ENNReal.ofReal_toReal hC]; exact ENNReal.ofReal_le_ofReal h
  refine ⟨ENNReal.ofReal tot, ENNReal.ofReal_ne_top, ?_, ?_⟩
  · rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal (by simp only [htot]; linarith [n_C_TQ, n_C_TT, n_C_MTQ, n_C_MTT, n_Cp_TQ, n_Cp_TT, n_Cp_MTQ, n_Cp_MTT])
  intro D hI hwN hwDec vp vb ε ex ey hfl t0 s1 t1 sa ta hsa hsb hab caseA β _ S RQ RT q2 q4 qh src hq hq4 hq2 hRb bs1 bs2 rA rB hgood c hk Bx hG
  set K0 : ℝ≥0∞ := ENNReal.ofReal tot with hK0def
  have hK0 : 1 ≤ K0 := by rw [hK0def, ← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal (by simp only [htot]; linarith [n_C_TQ, n_C_TT, n_C_MTQ, n_C_MTT, n_Cp_TQ, n_Cp_TT, n_Cp_MTQ, n_Cp_MTT])
  have hcomm : (fun (τ : D.S.TVar → ℝ) (_ : Mom P.d) => ((|τ ta - τ sa| ^ (1 - 3 * P.η) : ℝ) : ℂ)) =
      (fun (τ : D.S.TVar → ℝ) (_ : Mom P.d) => ((|τ sa - τ ta| ^ (1 - 3 * P.η) : ℝ) : ℂ)) := by
    funext τ _; rw [abs_sub_comm]
  rcases c with ((⟨⟨b, hbm⟩, i, j⟩ | ⟨⟨b, hbm⟩, i, j⟩ | ⟨⟨b, hbm⟩, i, j⟩ | ⟨⟨b, hbm⟩, i, j⟩ | ⟨⟨b, hbm⟩, i, j⟩ | ⟨⟨b, hbm⟩, i, j⟩) | (⟨⟨b, hbm⟩, i | j | _⟩ | ⟨⟨b, hbm⟩, i | j | _⟩))
  · simp [kindOf] at hk
  · simp [kindOf] at hk
  · rcases Classical.em caseA with hA | hA
    · exact @h_TQ K0 (hle C_TQ hC_TQ (by linarith [n_C_TQ, n_C_TT, n_C_MTQ, n_C_MTT, n_Cp_TQ, n_Cp_TT, n_Cp_MTQ, n_Cp_MTT])) (hle C'_TQ hC'_TQ (by linarith [n_C_TQ, n_C_TT, n_C_MTQ, n_C_MTT, n_Cp_TQ, n_Cp_TT, n_Cp_MTQ, n_Cp_MTT])) hK0 D hI hwN hwDec vp vb ε ex ey hfl t0 s1 t1 sa ta hsa hsb hab caseA hA β _ S RQ RT q2 q4 qh src hq hq4 hq2 hRb bs1 bs2 rA rB b hbm (hgood b (by simp [hbm])) i j Bx (fun tt htt => by filter_upwards [hG tt htt] with τ hg hd; have hg' := hg hd; simpa [ExcOrd, hA] using hg')
    · obtain ⟨bK, bL, hP, hbd⟩ := @h_MTQ K0 (hle C_MTQ hC_MTQ (by linarith [n_C_TQ, n_C_TT, n_C_MTQ, n_C_MTT, n_Cp_TQ, n_Cp_TT, n_Cp_MTQ, n_Cp_MTT])) (hle C'_MTQ hC'_MTQ (by linarith [n_C_TQ, n_C_TT, n_C_MTQ, n_C_MTT, n_Cp_TQ, n_Cp_TT, n_Cp_MTQ, n_Cp_MTT])) hK0 D hI hwN hwDec vp vb ε ex ey hfl t0 s1 t1 ta sa hsb hsa hab.symm caseA hA β _ S RQ RT q2 q4 qh src hq hq4 hq2 hRb bs1 bs2 rA rB b hbm (hgood b (by simp [hbm])) i j Bx (fun tt htt => by filter_upwards [hG tt htt] with τ hg hd; have hg' := hg hd; simpa [ExcOrd, hA] using hg')
      exact ⟨bK, bL, by rw [hcomm] at hP; exact hP, hbd⟩
  · simp [kindOf] at hk
  · simp [kindOf] at hk
  · rcases Classical.em caseA with hA | hA
    · obtain ⟨bK, bL, hP, hbd⟩ := @h_TT K0 (hle C_TT hC_TT (by linarith [n_C_TQ, n_C_TT, n_C_MTQ, n_C_MTT, n_Cp_TQ, n_Cp_TT, n_Cp_MTQ, n_Cp_MTT])) (hle C'_TT hC'_TT (by linarith [n_C_TQ, n_C_TT, n_C_MTQ, n_C_MTT, n_Cp_TQ, n_Cp_TT, n_Cp_MTQ, n_Cp_MTT])) hK0 D hI hwN hwDec vp vb ε ex ey hfl t0 s1 t1 ta sa hsb hsa hab.symm caseA hA β _ S RQ RT q2 q4 qh src hq hq4 hq2 hRb bs1 bs2 rA rB b hbm (hgood b (by simp [hbm])) i j Bx (fun tt htt => by filter_upwards [hG tt htt] with τ hg hd; have hg' := hg hd; simpa [ExcOrd, hA] using hg')
      exact ⟨bK, bL, by rw [hcomm] at hP; exact hP, hbd⟩
    · exact @h_MTT K0 (hle C_MTT hC_MTT (by linarith [n_C_TQ, n_C_TT, n_C_MTQ, n_C_MTT, n_Cp_TQ, n_Cp_TT, n_Cp_MTQ, n_Cp_MTT])) (hle C'_MTT hC'_MTT (by linarith [n_C_TQ, n_C_TT, n_C_MTQ, n_C_MTT, n_Cp_TQ, n_Cp_TT, n_Cp_MTQ, n_Cp_MTT])) hK0 D hI hwN hwDec vp vb ε ex ey hfl t0 s1 t1 sa ta hsa hsb hab caseA hA β _ S RQ RT q2 q4 qh src hq hq4 hq2 hRb bs1 bs2 rA rB b hbm (hgood b (by simp [hbm])) i j Bx (fun tt htt => by filter_upwards [hG tt htt] with τ hg hd; have hg' := hg hd; simpa [ExcOrd, hA] using hg')
  all_goals simp [kindOf] at hk


end WaveTurbulence.VineEstS5C.P4.W2
