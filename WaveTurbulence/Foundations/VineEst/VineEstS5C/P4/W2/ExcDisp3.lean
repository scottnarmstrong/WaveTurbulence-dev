  obtain ⟨C_rA3_RP, hC_rA3_RP, h_rA3_RP⟩ := disp_rA3_RP G
  obtain ⟨C_rB1_SR, C'_rB1_SR, hC_rB1_SR, hC'_rB1_SR, h_rB1_SR⟩ := disp_rB1_SR G
