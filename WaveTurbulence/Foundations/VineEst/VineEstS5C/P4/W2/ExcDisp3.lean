  obtain ⟨C_A1, hC_A1, h_A1⟩ := disp_A1 G
  obtain ⟨C_KQ, hC_KQ, h_KQ⟩ := disp_KQ G
  obtain ⟨C_PA2, hC_PA2, h_PA2⟩ := disp_PA2 G
  obtain ⟨C_KT, hC_KT, h_KT⟩ := disp_KT G
