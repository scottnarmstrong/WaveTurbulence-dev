  WaveTurbulence.DegenVine WaveTurbulence.DegenVinePar WaveTurbulence.VineEstS5C.P2 WaveTurbulence.VineEstS5C.P4 MeasureTheory
open scoped ENNReal ComplexConjugate
variable {A : ℝ} {P : WTParams}


/-- The kind of a summand: `1` for the kind-1 pieces KQ, KT, `2` for the kind-2 pieces TQ, TT, `0` otherwise. -/
def kindOf {β : Type*} {d : ℕ} {S : SepTerms β d} {bs₁ bs₂ rA rB : Finset β} : Ch S bs₁ bs₂ rA rB → ℕ :=
  Sum.elim (Sum.elim (fun _ => 0) (Sum.elim (fun _ => 1) (Sum.elim (fun _ => 2) (Sum.elim (fun _ => 0)
    (Sum.elim (fun _ => 1) (fun _ => 2)))))) (fun _ => 0)

open Classical in
/-- The order facts of a summand (the indicator of its piece, with the roles of the case-M mirror). -/
def ExcOrd (caseA : Prop) {β : Type*} {d : ℕ} {S : SepTerms β d} {bs₁ bs₂ rA rB : Finset β} (t0 s1 t1 : ℝ) :
    Ch S bs₁ bs₂ rA rB → Prop :=
  Sum.elim (Sum.elim (fun _ => if caseA then (s1 ≤ t0 ∧ t0 < t1) else (t1 ≤ t0 ∧ t0 < s1))
    (Sum.elim (fun _ => if caseA then (t0 < t1 ∧ t0 < s1) else (t0 < s1 ∧ t0 < t1))
    (Sum.elim (fun _ => if caseA then (t0 < t1 ∧ t0 < s1) else (t0 < s1 ∧ t0 < t1))
    (Sum.elim (fun _ => if caseA then (t1 ≤ t0 ∧ t0 < s1) else (s1 ≤ t0 ∧ t0 < t1))
    (Sum.elim (fun _ => if caseA then (t0 < t1 ∧ t0 < s1) else (t0 < s1 ∧ t0 < t1))
    (fun _ => if caseA then (t0 < t1 ∧ t0 < s1) else (t0 < s1 ∧ t0 < t1)))))))
    (Sum.elim (fun _ => t0 < t1) (fun _ => t0 < s1))

open Classical in
theorem exc_dispatch_k01 (G : AmbP A P) :
    ∃ K0 : ℝ≥0∞, K0 ≠ ⊤ ∧ 1 ≤ K0 ∧
      ∀ (D : SumintPar.SumintDatum P.d) (hI : 0 < D.S.I) (hwN : D.wN + 1 = 30 * P.d) (hwDec : D.wDec = 30 * P.d)
