  let Bc3 : Set (Fin 3 → ℝ) := {τ | τ 0 ∈ Set.Ioo q4 (q4 + 1) ∧ τ 1 ∈ Set.Ioo q4 (q4 + 1) ∧ τ 2 ∈ Set.Ioo q2 (q2 + 1) ∧
    τ 0 ≠ τ 1 ∧ τ 2 < τ 0 ∧ τ 2 < τ 1}
  have hop : IsOpen Bc3 := by
    refine (isOpen_Ioo.preimage (continuous_apply 0)).inter ((isOpen_Ioo.preimage (continuous_apply 1)).inter
      ((isOpen_Ioo.preimage (continuous_apply 2)).inter ((isOpen_ne_fun (continuous_apply 0) (continuous_apply 1)).inter
      ((isOpen_lt (continuous_apply 2) (continuous_apply 0)).inter (isOpen_lt (continuous_apply 2) (continuous_apply 1))))))
  have hcl : Bc3 ⊆ closure (interior Bc3) := by rw [hop.interior_eq]; exact subset_closure
  have h1 : Bc3 ⊆ cell ![q4, q4, q2] := by
    intro τ hτ i
    fin_cases i
    · exact ⟨hτ.1.1.le, hτ.1.2.le⟩
    · exact ⟨hτ.2.1.1.le, hτ.2.1.2.le⟩
    · exact ⟨hτ.2.2.1.1.le, hτ.2.2.1.2.le⟩
  have h3 : ∀ τ ∈ Bc3, ‖τ‖ ≤ Rb := by
    intro τ hτ
    have hR0 : (0 : ℝ) ≤ Rb := by linarith [le_max_left (q4 + 1) (q2 + 1)]
    have c0 : ‖τ 0‖ ≤ Rb := by
      rw [Real.norm_eq_abs, abs_of_pos (by linarith [hτ.1.1])]; linarith [hτ.1.2, le_max_left (q4 + 1) (q2 + 1)]
    have c1 : ‖τ 1‖ ≤ Rb := by
      rw [Real.norm_eq_abs, abs_of_pos (by linarith [hτ.2.1.1])]; linarith [hτ.2.1.2, le_max_left (q4 + 1) (q2 + 1)]
    have c2 : ‖τ 2‖ ≤ Rb := by
      rw [Real.norm_eq_abs, abs_of_pos (by linarith [hτ.2.2.1.1])]; linarith [hτ.2.2.1.2, le_max_right (q4 + 1) (q2 + 1)]
    refine (pi_norm_le_iff_of_nonneg hR0).2 fun i => ?_
    fin_cases i
    · exact c0
    · exact c1
    · exact c2
  have hmem : ∀ τ ∈ Bc3, ∀ (V Bc : Set (Fin 2 → ℝ)) (gt : Bool), WinOK V Bc (Set.Ioo q4 (q4 + 1)) (Set.Ioo q2 (q2 + 1)) gt →
      (![τ 0, τ 2] ∈ V ∧ ![τ 0, τ 2] ∈ Bc) ∧ (![τ 1, τ 2] ∈ V ∧ ![τ 1, τ 2] ∈ Bc) := by
    intro τ hτ V Bc gt hw
    exact ⟨hw _ hτ.1 _ hτ.2.2.1 (fun _ => hτ.2.2.2.2.1), hw _ hτ.2.1 _ hτ.2.2.1 (fun _ => hτ.2.2.2.2.2)⟩
  have h4 : ∀ τ ∈ Bc3, ![τ 0, τ 2] ∈ (src.BQ false) ∧ ![τ 1, τ 2] ∈ (src.BQ false) := by
    intro τ hτ
