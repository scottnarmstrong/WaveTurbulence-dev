  have hPR := @h D hI hwN hwDec vp vb ε ex ey hfl t0 s1 t1 a b' hsa hsb β S b i j _ _ _ _ _ _ _ _ (src.cq false b i) (src.ct false b j) ![q4, q4, q2] Bc3 Bc3 h1 h2 h3 h4 h5 h6 h7 h8 Bx (Set.Ioo q4 (q4 + 1)) (Set.Ioo q4 (q4 + 1)) (Set.Ioo q2 (q2 + 1)) (hwqs1) (hwts1) (hwtt1) hG'
