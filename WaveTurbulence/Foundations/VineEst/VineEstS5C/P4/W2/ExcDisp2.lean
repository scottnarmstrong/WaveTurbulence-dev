module

public import WaveTurbulence.Foundations.VineEst.VineEstS5C.P4.W2.ExcBnd
public import WaveTurbulence.Foundations.VineEst.VineEstS3.DomainLayerOrder

/-! # P4-W2 (session 7, step 3f (joint pieces)): the per-summand dispatch (generated by `uni/scratch8/gen_disp.py`)

`disp_*`: for each non-joint summand of a bundle (the pieces A1, A2, KQ, KT in case A and their case-M mirrors, and the ten remainder shapes), the `PieceRep` of
the summand `bundlePtG caseA S bs₁ bs₂ rA rB RQ RT t₀ s₁ t₁ (k + e_x r) (k + e_y r) c` from the order facts and the open windows of the three clocks, together with
the product bound `bK * bL ≤ Kall d K₀ · ofReal (size)` (`CertSrc.szQ`, `CertSrc.szT`, `CRq`, `CRt`) and the factor `FacOK` (`1`, or `‖r‖` for the kind-1 pieces KQ, KT). -/

@[expose] public section
set_option autoImplicit false
namespace WaveTurbulence.VineEstS5C.P4.W2
open WaveTurbulence WaveTurbulence.VineEstS3Par.Eng WaveTurbulence.VineEstS3.FS WaveTurbulence.VineEstS5A WaveTurbulence.VineEstS4c
  WaveTurbulence.DegenVine WaveTurbulence.DegenVinePar WaveTurbulence.VineEstS5C.P2 WaveTurbulence.VineEstS5C.P4 MeasureTheory
open scoped ENNReal ComplexConjugate
variable {A : ℝ} {P : WTParams}

open Classical in
theorem disp_TQ (G : AmbP A P) (Rb : ℝ) :
    ∃ C C' : ℝ≥0∞, C ≠ ⊤ ∧ C' ≠ ⊤ ∧
      ∀ (K0 : ℝ≥0∞), C ≤ K0 → C' ≤ K0 → 1 ≤ K0 →
      ∀ (D : SumintPar.SumintDatum P.d) (hI : 0 < D.S.I) (hwN : D.wN + 1 = 30 * P.d) (hwDec : D.wDec = 30 * P.d)
      (vp vb : D.S.VIdx) (ε ex ey : ℝ) (hfl : FlagXY ε ex ey)
      (t0 s1 t1 : WaveTurbulence.VineEstS3Par.Eng.Slot D) (a b' : D.S.TVar) (hsa : s1 = Sum.inl a) (hsb : t1 = Sum.inl b') (hab : a ≠ b')
      (caseA : Prop) (hA : caseA)
      {β : Type*} [DecidableEq β] (S : SepTerms β P.d) (RQ RT : β → ℝ → ℝ → Mom P.d → ℂ) {q2 q4 qh : ℝ}
      (src : Src P S RQ RT q2 q4 qh) (hq : qh = q4) (hq4 : 0 ≤ q4) (hq2 : 0 ≤ q2) (hRb : max (q4 + 1) (q2 + 1) ≤ Rb)
      (bs1 bs2 rA rB : Finset β) (b : β) (hbm : b ∈ bs1) (hb : src.good b)
      (i : Fin (S.mQ b)) (j : Fin (S.mT b)) (Bx : Set (Fin 3 → ℝ)),
      (∀ tt ∈ Bx, ∀ᵐ τ : D.S.TVar → ℝ, τ ∈ D.timeDom hI (tt 0) (tt 1) (tt 2) →
        (slotVal D τ tt t0 < slotVal D τ tt t1 ∧ slotVal D τ tt t0 < slotVal D τ tt s1) ∧ slotVal D τ tt s1 ∈ Set.Ioo q4 (q4 + 1) ∧ slotVal D τ tt t1 ∈ Set.Ioo q4 (q4 + 1) ∧
          slotVal D τ tt t0 ∈ Set.Ioo q2 (q2 + 1)) →
      ∃ (bK bL : ℝ≥0∞),
        PieceRep (P := P) hI vp vb ε (fun τ _ => ((|τ a - τ b'| ^ (1 - 3 * P.η) : ℝ) : ℂ))
          (fun τ tt r k => bundlePtG caseA S bs1 bs2 rA rB RQ RT (slotVal D τ tt t0) (slotVal D τ tt s1) (slotVal D τ tt t1)
            (k + ex • r) (k + ey • r) (Sum.inl (Sum.inr (Sum.inr (Sum.inl ⟨⟨b, hbm⟩, i, j⟩))))) bK bL Bx ∧
        bK * bL ≤ Kall P.d K0 * ENNReal.ofReal (src.szQ b * src.szT b) := by
  obtain ⟨C, C', hC, hC', h⟩ := excw_TQ G Rb
  refine ⟨C, C', hC, hC', fun K0 hCK hCK' hK0 D hI hwN hwDec vp vb ε ex ey hfl t0 s1 t1 a b' hsa hsb hab caseA hA β _ S RQ RT q2 q4 qh src hq hq4 hq2 hRb bs1 bs2 rA rB b hbm hb i j Bx hG => ?_⟩
  have hd := G.hd1
  have hJq : 0 ≤ src.CJq b := (src.cq false b i).hCJ
  have hMq : 0 ≤ src.CMq b := (src.cq false b i).hCM
  have hJt : 0 ≤ src.CJt b := (src.ct false b j).hCJ
  have hMt : 0 ≤ src.CMt b := (src.ct false b j).hCM
  have hWq : ∀ s : Bool, Wsel q4 qh s = Set.Ioo q4 (q4 + 1) := fun s => by subst hq; cases s <;> simp [Wsel]
  have hwq := src.winq_sel hb i false
  have hwt := src.wint_sel hb j false
  rw [hWq] at hwq hwt
  have hwqs1 := hwq
  have hwqt1 := hwq
  have hwts1 := hwt
  have hwtt1 := hwt
  have hdiag : ∀ᵐ τ : D.S.TVar → ℝ, τ a ≠ τ b' := by
    have h0 := VineEstS3.volume_diag_null (ι := D.S.TVar) hab
    exact (MeasureTheory.measure_eq_zero_iff_ae_notMem.1 h0)
  let Bc3 : Set (Fin 3 → ℝ) := {τ | τ 0 ∈ Set.Ioo q4 (q4 + 1) ∧ τ 1 ∈ Set.Ioo q4 (q4 + 1) ∧ τ 2 ∈ Set.Ioo q2 (q2 + 1) ∧
    τ 0 ≠ τ 1 ∧ τ 2 < τ 0 ∧ τ 2 < τ 1}
  have hop : IsOpen Bc3 := by
    refine (isOpen_Ioo.preimage (continuous_apply 0)).inter ((isOpen_Ioo.preimage (continuous_apply 1)).inter
      ((isOpen_Ioo.preimage (continuous_apply 2)).inter ((isOpen_ne_fun (continuous_apply 0) (continuous_apply 1)).inter
      ((isOpen_lt (continuous_apply 2) (continuous_apply 0)).inter (isOpen_lt (continuous_apply 2) (continuous_apply 1))))))
  have hcl : Bc3 ⊆ closure (interior Bc3) := by rw [hop.interior_eq]; exact subset_closure
  have h1 : Bc3 ⊆ cell ![q4, q4, q2] := by
    intro τ hτ i
    fin_cases i
    · exact ⟨hτ.1.1.le, hτ.1.2.le⟩
    · exact ⟨hτ.2.1.1.le, hτ.2.1.2.le⟩
    · exact ⟨hτ.2.2.1.1.le, hτ.2.2.1.2.le⟩
  have h3 : ∀ τ ∈ Bc3, ‖τ‖ ≤ Rb := by
    intro τ hτ
    have hR0 : (0 : ℝ) ≤ Rb := by linarith [le_max_left (q4 + 1) (q2 + 1)]
    have c0 : ‖τ 0‖ ≤ Rb := by
      rw [Real.norm_eq_abs, abs_of_pos (by linarith [hτ.1.1])]; linarith [hτ.1.2, le_max_left (q4 + 1) (q2 + 1)]
    have c1 : ‖τ 1‖ ≤ Rb := by
      rw [Real.norm_eq_abs, abs_of_pos (by linarith [hτ.2.1.1])]; linarith [hτ.2.1.2, le_max_left (q4 + 1) (q2 + 1)]
    have c2 : ‖τ 2‖ ≤ Rb := by
      rw [Real.norm_eq_abs, abs_of_pos (by linarith [hτ.2.2.1.1])]; linarith [hτ.2.2.1.2, le_max_right (q4 + 1) (q2 + 1)]
    refine (pi_norm_le_iff_of_nonneg hR0).2 fun i => ?_
    fin_cases i
    · exact c0
    · exact c1
    · exact c2
  have hmem : ∀ τ ∈ Bc3, ∀ (V Bc : Set (Fin 2 → ℝ)) (gt : Bool), WinOK V Bc (Set.Ioo q4 (q4 + 1)) (Set.Ioo q2 (q2 + 1)) gt →
      (![τ 0, τ 2] ∈ V ∧ ![τ 0, τ 2] ∈ Bc) ∧ (![τ 1, τ 2] ∈ V ∧ ![τ 1, τ 2] ∈ Bc) := by
    intro τ hτ V Bc gt hw
    exact ⟨hw _ hτ.1 _ hτ.2.2.1 (fun _ => hτ.2.2.2.2.1), hw _ hτ.2.1 _ hτ.2.2.1 (fun _ => hτ.2.2.2.2.2)⟩
  have h4 : ∀ τ ∈ Bc3, ![τ 0, τ 2] ∈ (src.BQ false) ∧ ![τ 1, τ 2] ∈ (src.BQ false) := by
    intro τ hτ
    have := hmem τ hτ _ _ _ hwq
    exact ⟨(src.cq false b i).hBcB this.1.2, (src.cq false b i).hBcB this.2.2⟩
  have h2 := hcl
  have h5 : Bc3 ⊆ Bc3 := subset_rfl
  have h6 := hcl
  have h7 : ∀ τ ∈ Bc3, τ 0 ≠ τ 1 := fun τ hτ => hτ.2.2.2.1
  have h8 : ∀ τ ∈ Bc3, ![τ 0, τ 2] ∈ (src.cq false b i).Bc ∧ ![τ 1, τ 2] ∈ (src.cq false b i).Bc := by
    intro τ hτ
    have := hmem τ hτ _ _ _ hwq
    exact ⟨this.1.2, this.2.2⟩

  have hG' : ∀ tt ∈ Bx, ∀ᵐ τ : D.S.TVar → ℝ, τ ∈ D.timeDom hI (tt 0) (tt 1) (tt 2) →
      (slotVal D τ tt t0 < slotVal D τ tt t1 ∧ slotVal D τ tt t0 < slotVal D τ tt s1) ∧ slotVal D τ tt s1 ∈ Set.Ioo q4 (q4 + 1) ∧ slotVal D τ tt t1 ∈ Set.Ioo q4 (q4 + 1) ∧
        slotVal D τ tt t0 ∈ Set.Ioo q2 (q2 + 1) ∧ ![slotVal D τ tt s1, slotVal D τ tt t1, slotVal D τ tt t0] ∈ Bc3 := by
    intro tt htt
    filter_upwards [hG tt htt, hdiag] with τ hg hne hd
    obtain ⟨hord, hs, ht, h0⟩ := hg hd
    refine ⟨hord, hs, ht, h0, ?_⟩
    have e1 : slotVal D τ tt s1 = τ a := by rw [hsa]; rfl
    have e2 : slotVal D τ tt t1 = τ b' := by rw [hsb]; rfl
    have hne' : slotVal D τ tt s1 ≠ slotVal D τ tt t1 := by rw [e1, e2]; exact hne
    obtain ⟨ho1, ho2⟩ := hord
    simp only [Bc3, Set.mem_setOf_eq, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons]
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;> first | assumption | exact Ne.symm hne'
  have hPR := @h D hI hwN hwDec vp vb ε ex ey hfl t0 s1 t1 a b' hsa hsb β S b i j _ _ _ _ _ _ _ _ (src.cq false b i) (src.ct false b j) ![q4, q4, q2] Bc3 Bc3 h1 h2 h3 h4 h5 h6 h7 h8 Bx (Set.Ioo q4 (q4 + 1)) (Set.Ioo q4 (q4 + 1)) (Set.Ioo q2 (q2 + 1)) (hwqs1) (hwqt1) (hwtt1) hG'
  refine ⟨_, _, hPR.congr (fun tt htt => Filter.Eventually.of_forall fun τ hd r k hr => by
    simp only [bundlePtG, ptP, ptR, Sum.elim_inl, Sum.elim_inr, if_pos hA]
    try ring_nf), ?_⟩
  refine (bnd_P hd hwN hwDec _ _ K0 hCK hCK' _ _ _ _ _ (by first | exact hJq | exact hJt) (by first | exact hJq | exact hJt)
      (by first | exact hMq | exact hMt | positivity) (by first | exact hMq | exact hMt | positivity)).trans
      (Ksp_le_Kall hd K0 _ _ ?_ (mul_nonneg (src.szQ_nonneg hJq hMq) (src.szT_nonneg hJt hMt)))
  simp only [CertSrc.szQ, CertSrc.szT, src.cq_c, src.ct_c, abs_mul, abs_neg, abs_one, mul_one, one_mul]
  calc _ = (1 : ℝ) * (|src.cc b| * src.CJq b * src.CMq b * (|src.cT b| * src.CJt b * src.CMt b)) := by ring
    _ ≤ Ksp P.d * (|src.cc b| * src.CJq b * src.CMq b * (|src.cT b| * src.CJt b * src.CMt b)) :=
      mul_le_mul_of_nonneg_right (one_le_Ksp hd) (by positivity)

open Classical in
theorem disp_TT (G : AmbP A P) (Rb : ℝ) :
    ∃ C C' : ℝ≥0∞, C ≠ ⊤ ∧ C' ≠ ⊤ ∧
      ∀ (K0 : ℝ≥0∞), C ≤ K0 → C' ≤ K0 → 1 ≤ K0 →
      ∀ (D : SumintPar.SumintDatum P.d) (hI : 0 < D.S.I) (hwN : D.wN + 1 = 30 * P.d) (hwDec : D.wDec = 30 * P.d)
      (vp vb : D.S.VIdx) (ε ex ey : ℝ) (hfl : FlagXY ε ex ey)
      (t0 s1 t1 : WaveTurbulence.VineEstS3Par.Eng.Slot D) (a b' : D.S.TVar) (hsa : t1 = Sum.inl a) (hsb : s1 = Sum.inl b') (hab : a ≠ b')
      (caseA : Prop) (hA : caseA)
      {β : Type*} [DecidableEq β] (S : SepTerms β P.d) (RQ RT : β → ℝ → ℝ → Mom P.d → ℂ) {q2 q4 qh : ℝ}
      (src : Src P S RQ RT q2 q4 qh) (hq : qh = q4) (hq4 : 0 ≤ q4) (hq2 : 0 ≤ q2) (hRb : max (q4 + 1) (q2 + 1) ≤ Rb)
      (bs1 bs2 rA rB : Finset β) (b : β) (hbm : b ∈ bs2) (hb : src.good b)
      (i : Fin (S.mQ b)) (j : Fin (S.mT b)) (Bx : Set (Fin 3 → ℝ)),
      (∀ tt ∈ Bx, ∀ᵐ τ : D.S.TVar → ℝ, τ ∈ D.timeDom hI (tt 0) (tt 1) (tt 2) →
        (slotVal D τ tt t0 < slotVal D τ tt t1 ∧ slotVal D τ tt t0 < slotVal D τ tt s1) ∧ slotVal D τ tt s1 ∈ Set.Ioo q4 (q4 + 1) ∧ slotVal D τ tt t1 ∈ Set.Ioo q4 (q4 + 1) ∧
          slotVal D τ tt t0 ∈ Set.Ioo q2 (q2 + 1)) →
      ∃ (bK bL : ℝ≥0∞),
        PieceRep (P := P) hI vp vb ε (fun τ _ => ((|τ a - τ b'| ^ (1 - 3 * P.η) : ℝ) : ℂ))
          (fun τ tt r k => bundlePtG caseA S bs1 bs2 rA rB RQ RT (slotVal D τ tt t0) (slotVal D τ tt s1) (slotVal D τ tt t1)
            (k + ex • r) (k + ey • r) (Sum.inl (Sum.inr (Sum.inr (Sum.inr (Sum.inr (Sum.inr ⟨⟨b, hbm⟩, i, j⟩))))))) bK bL Bx ∧
        bK * bL ≤ Kall P.d K0 * ENNReal.ofReal (src.szQ b * src.szT b) := by
  obtain ⟨C, C', hC, hC', h⟩ := excw_TT G Rb
  refine ⟨C, C', hC, hC', fun K0 hCK hCK' hK0 D hI hwN hwDec vp vb ε ex ey hfl t0 s1 t1 a b' hsa hsb hab caseA hA β _ S RQ RT q2 q4 qh src hq hq4 hq2 hRb bs1 bs2 rA rB b hbm hb i j Bx hG => ?_⟩
  have hd := G.hd1
  have hJq : 0 ≤ src.CJq b := (src.cq false b i).hCJ
  have hMq : 0 ≤ src.CMq b := (src.cq false b i).hCM
  have hJt : 0 ≤ src.CJt b := (src.ct false b j).hCJ
  have hMt : 0 ≤ src.CMt b := (src.ct false b j).hCM
  have hWq : ∀ s : Bool, Wsel q4 qh s = Set.Ioo q4 (q4 + 1) := fun s => by subst hq; cases s <;> simp [Wsel]
  have hwq := src.winq_sel hb i false
  have hwt := src.wint_sel hb j false
  rw [hWq] at hwq hwt
  have hwqs1 := hwq
  have hwqt1 := hwq
  have hwts1 := hwt
  have hwtt1 := hwt
  have hdiag : ∀ᵐ τ : D.S.TVar → ℝ, τ a ≠ τ b' := by
    have h0 := VineEstS3.volume_diag_null (ι := D.S.TVar) hab
    exact (MeasureTheory.measure_eq_zero_iff_ae_notMem.1 h0)
  let Bc3 : Set (Fin 3 → ℝ) := {τ | τ 0 ∈ Set.Ioo q4 (q4 + 1) ∧ τ 1 ∈ Set.Ioo q4 (q4 + 1) ∧ τ 2 ∈ Set.Ioo q2 (q2 + 1) ∧
    τ 0 ≠ τ 1 ∧ τ 2 < τ 0 ∧ τ 2 < τ 1}
  have hop : IsOpen Bc3 := by
    refine (isOpen_Ioo.preimage (continuous_apply 0)).inter ((isOpen_Ioo.preimage (continuous_apply 1)).inter
      ((isOpen_Ioo.preimage (continuous_apply 2)).inter ((isOpen_ne_fun (continuous_apply 0) (continuous_apply 1)).inter
      ((isOpen_lt (continuous_apply 2) (continuous_apply 0)).inter (isOpen_lt (continuous_apply 2) (continuous_apply 1))))))
  have hcl : Bc3 ⊆ closure (interior Bc3) := by rw [hop.interior_eq]; exact subset_closure
  have h1 : Bc3 ⊆ cell ![q4, q4, q2] := by
    intro τ hτ i
    fin_cases i
    · exact ⟨hτ.1.1.le, hτ.1.2.le⟩
    · exact ⟨hτ.2.1.1.le, hτ.2.1.2.le⟩
    · exact ⟨hτ.2.2.1.1.le, hτ.2.2.1.2.le⟩
  have h3 : ∀ τ ∈ Bc3, ‖τ‖ ≤ Rb := by
    intro τ hτ
    have hR0 : (0 : ℝ) ≤ Rb := by linarith [le_max_left (q4 + 1) (q2 + 1)]
    have c0 : ‖τ 0‖ ≤ Rb := by
      rw [Real.norm_eq_abs, abs_of_pos (by linarith [hτ.1.1])]; linarith [hτ.1.2, le_max_left (q4 + 1) (q2 + 1)]
    have c1 : ‖τ 1‖ ≤ Rb := by
      rw [Real.norm_eq_abs, abs_of_pos (by linarith [hτ.2.1.1])]; linarith [hτ.2.1.2, le_max_left (q4 + 1) (q2 + 1)]
    have c2 : ‖τ 2‖ ≤ Rb := by
      rw [Real.norm_eq_abs, abs_of_pos (by linarith [hτ.2.2.1.1])]; linarith [hτ.2.2.1.2, le_max_right (q4 + 1) (q2 + 1)]
    refine (pi_norm_le_iff_of_nonneg hR0).2 fun i => ?_
    fin_cases i
    · exact c0
    · exact c1
    · exact c2
  have hmem : ∀ τ ∈ Bc3, ∀ (V Bc : Set (Fin 2 → ℝ)) (gt : Bool), WinOK V Bc (Set.Ioo q4 (q4 + 1)) (Set.Ioo q2 (q2 + 1)) gt →
      (![τ 0, τ 2] ∈ V ∧ ![τ 0, τ 2] ∈ Bc) ∧ (![τ 1, τ 2] ∈ V ∧ ![τ 1, τ 2] ∈ Bc) := by
    intro τ hτ V Bc gt hw
    exact ⟨hw _ hτ.1 _ hτ.2.2.1 (fun _ => hτ.2.2.2.2.1), hw _ hτ.2.1 _ hτ.2.2.1 (fun _ => hτ.2.2.2.2.2)⟩
  have h4 : ∀ τ ∈ Bc3, ![τ 0, τ 2] ∈ (src.BT false) ∧ ![τ 1, τ 2] ∈ (src.BT false) := by
    intro τ hτ
    have := hmem τ hτ _ _ _ hwt
    exact ⟨(src.ct false b j).hBcB this.1.2, (src.ct false b j).hBcB this.2.2⟩
  have h2 := hcl
  have h5 : Bc3 ⊆ Bc3 := subset_rfl
  have h6 := hcl
  have h7 : ∀ τ ∈ Bc3, τ 0 ≠ τ 1 := fun τ hτ => hτ.2.2.2.1
  have h8 : ∀ τ ∈ Bc3, ![τ 0, τ 2] ∈ (src.ct false b j).Bc ∧ ![τ 1, τ 2] ∈ (src.ct false b j).Bc := by
    intro τ hτ
    have := hmem τ hτ _ _ _ hwt
    exact ⟨this.1.2, this.2.2⟩

  have hG' : ∀ tt ∈ Bx, ∀ᵐ τ : D.S.TVar → ℝ, τ ∈ D.timeDom hI (tt 0) (tt 1) (tt 2) →
      (slotVal D τ tt t0 < slotVal D τ tt t1 ∧ slotVal D τ tt t0 < slotVal D τ tt s1) ∧ slotVal D τ tt s1 ∈ Set.Ioo q4 (q4 + 1) ∧ slotVal D τ tt t1 ∈ Set.Ioo q4 (q4 + 1) ∧
        slotVal D τ tt t0 ∈ Set.Ioo q2 (q2 + 1) ∧ ![slotVal D τ tt t1, slotVal D τ tt s1, slotVal D τ tt t0] ∈ Bc3 := by
    intro tt htt
    filter_upwards [hG tt htt, hdiag] with τ hg hne hd
    obtain ⟨hord, hs, ht, h0⟩ := hg hd
    refine ⟨hord, hs, ht, h0, ?_⟩
    have e1 : slotVal D τ tt t1 = τ a := by rw [hsa]; rfl
    have e2 : slotVal D τ tt s1 = τ b' := by rw [hsb]; rfl
    have hne' : slotVal D τ tt t1 ≠ slotVal D τ tt s1 := by rw [e1, e2]; exact hne
    obtain ⟨ho1, ho2⟩ := hord
    simp only [Bc3, Set.mem_setOf_eq, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons]
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;> first | assumption | exact Ne.symm hne'
  have hPR := @h D hI hwN hwDec vp vb ε ex ey hfl t0 s1 t1 a b' hsa hsb β S b i j _ _ _ _ _ _ _ _ (src.cq false b i) (src.ct false b j) ![q4, q4, q2] Bc3 Bc3 h1 h2 h3 h4 h5 h6 h7 h8 Bx (Set.Ioo q4 (q4 + 1)) (Set.Ioo q4 (q4 + 1)) (Set.Ioo q2 (q2 + 1)) (hwqt1) (hwts1) (hwtt1) hG'
  refine ⟨_, _, hPR.congr (fun tt htt => Filter.Eventually.of_forall fun τ hd r k hr => by
    simp only [bundlePtG, ptP, ptR, Sum.elim_inl, Sum.elim_inr, if_pos hA]
    try ring_nf), ?_⟩
  refine (bnd_P hd hwN hwDec _ _ K0 hCK hCK' _ _ _ _ _ (by first | exact hJq | exact hJt) (by first | exact hJq | exact hJt)
      (by first | exact hMq | exact hMt | positivity) (by first | exact hMq | exact hMt | positivity)).trans
      (Ksp_le_Kall hd K0 _ _ ?_ (mul_nonneg (src.szQ_nonneg hJq hMq) (src.szT_nonneg hJt hMt)))
  simp only [CertSrc.szQ, CertSrc.szT, src.cq_c, src.ct_c, abs_mul, abs_neg, abs_one, mul_one, one_mul]
  calc _ = (1 : ℝ) * (|src.cc b| * src.CJq b * src.CMq b * (|src.cT b| * src.CJt b * src.CMt b)) := by ring
    _ ≤ Ksp P.d * (|src.cc b| * src.CJq b * src.CMq b * (|src.cT b| * src.CJt b * src.CMt b)) :=
      mul_le_mul_of_nonneg_right (one_le_Ksp hd) (by positivity)

open Classical in
theorem disp_MTQ (G : AmbP A P) (Rb : ℝ) :
    ∃ C C' : ℝ≥0∞, C ≠ ⊤ ∧ C' ≠ ⊤ ∧
      ∀ (K0 : ℝ≥0∞), C ≤ K0 → C' ≤ K0 → 1 ≤ K0 →
      ∀ (D : SumintPar.SumintDatum P.d) (hI : 0 < D.S.I) (hwN : D.wN + 1 = 30 * P.d) (hwDec : D.wDec = 30 * P.d)
      (vp vb : D.S.VIdx) (ε ex ey : ℝ) (hfl : FlagXY ε ex ey)
      (t0 s1 t1 : WaveTurbulence.VineEstS3Par.Eng.Slot D) (a b' : D.S.TVar) (hsa : t1 = Sum.inl a) (hsb : s1 = Sum.inl b') (hab : a ≠ b')
      (caseA : Prop) (hA : ¬caseA)
      {β : Type*} [DecidableEq β] (S : SepTerms β P.d) (RQ RT : β → ℝ → ℝ → Mom P.d → ℂ) {q2 q4 qh : ℝ}
      (src : Src P S RQ RT q2 q4 qh) (hq : qh = q4) (hq4 : 0 ≤ q4) (hq2 : 0 ≤ q2) (hRb : max (q4 + 1) (q2 + 1) ≤ Rb)
      (bs1 bs2 rA rB : Finset β) (b : β) (hbm : b ∈ bs1) (hb : src.good b)
      (i : Fin (S.mQ b)) (j : Fin (S.mT b)) (Bx : Set (Fin 3 → ℝ)),
      (∀ tt ∈ Bx, ∀ᵐ τ : D.S.TVar → ℝ, τ ∈ D.timeDom hI (tt 0) (tt 1) (tt 2) →
        (slotVal D τ tt t0 < slotVal D τ tt s1 ∧ slotVal D τ tt t0 < slotVal D τ tt t1) ∧ slotVal D τ tt s1 ∈ Set.Ioo q4 (q4 + 1) ∧ slotVal D τ tt t1 ∈ Set.Ioo q4 (q4 + 1) ∧
          slotVal D τ tt t0 ∈ Set.Ioo q2 (q2 + 1)) →
      ∃ (bK bL : ℝ≥0∞),
        PieceRep (P := P) hI vp vb ε (fun τ _ => ((|τ a - τ b'| ^ (1 - 3 * P.η) : ℝ) : ℂ))
          (fun τ tt r k => bundlePtG caseA S bs1 bs2 rA rB RQ RT (slotVal D τ tt t0) (slotVal D τ tt s1) (slotVal D τ tt t1)
            (k + ex • r) (k + ey • r) (Sum.inl (Sum.inr (Sum.inr (Sum.inl ⟨⟨b, hbm⟩, i, j⟩))))) bK bL Bx ∧
        bK * bL ≤ Kall P.d K0 * ENNReal.ofReal (src.szQ b * src.szT b) := by
  obtain ⟨C, C', hC, hC', h⟩ := excw_MTQ G Rb
  refine ⟨C, C', hC, hC', fun K0 hCK hCK' hK0 D hI hwN hwDec vp vb ε ex ey hfl t0 s1 t1 a b' hsa hsb hab caseA hA β _ S RQ RT q2 q4 qh src hq hq4 hq2 hRb bs1 bs2 rA rB b hbm hb i j Bx hG => ?_⟩
  have hd := G.hd1
  have hJq : 0 ≤ src.CJq b := (src.cq false b i).hCJ
  have hMq : 0 ≤ src.CMq b := (src.cq false b i).hCM
  have hJt : 0 ≤ src.CJt b := (src.ct false b j).hCJ
  have hMt : 0 ≤ src.CMt b := (src.ct false b j).hCM
  have hWq : ∀ s : Bool, Wsel q4 qh s = Set.Ioo q4 (q4 + 1) := fun s => by subst hq; cases s <;> simp [Wsel]
  have hwq := src.winq_sel hb i false
  have hwt := src.wint_sel hb j false
  rw [hWq] at hwq hwt
  have hwqs1 := hwq
  have hwqt1 := hwq
  have hwts1 := hwt
  have hwtt1 := hwt
  have hdiag : ∀ᵐ τ : D.S.TVar → ℝ, τ a ≠ τ b' := by
    have h0 := VineEstS3.volume_diag_null (ι := D.S.TVar) hab
