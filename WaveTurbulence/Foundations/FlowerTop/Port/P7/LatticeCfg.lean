module
public import WaveTurbulence.Foundations.FlowerTop.Port.P7.LatticeSel
/-! FLOWER-P7: the sixteen label-sum configurations (generated by gen_cfg.py): for each shape of the
decapitated components, the sum over the outer labels of the product of bracket weights restricted to the
coupling diagonals is at most `3 · 3^a ⟨k⟩^{-a} M^6`. -/
@[expose] public section
set_option autoImplicit false
namespace WaveTurbulence.FlowerP7
open WaveTurbulence.Induct
open TTree Finset LGSpine

variable {d : ℕ}

theorem cfg_irr6 {L : ℝ} (hL : 1 ≤ L) (k : Mom d) {a : ℝ} (ha : (d : ℝ) + 1 ≤ a)
    (u : Finset (OuterLabels d)) :
    ∑ n ∈ u, (if (True) then ∏ j ∈ ({0, 1, 2, 3, 4, 5} : Finset (Fin 6)), gw L k a (n.1 j) else 0) ≤
      3 * (3 ^ a * jbr k ^ (-a)) * (max 1 (∑' m, gw L k a m)) ^ 6 := by
  classical
  have hmain := cfg_sum hL k ha (fun n : Fin 6 → Fin d → ℤ => True) ({0, 1, 2, 3, 4, 5} : Finset (Fin 6))
    ({(0, ({1, 2, 3, 4, 5} : Finset (Fin 6))), (1, ({0, 2, 3, 4, 5} : Finset (Fin 6))), (2, ({0, 1, 3, 4, 5} : Finset (Fin 6)))} : Finset (Fin 6 × Finset (Fin 6))) ?hz ?inj ?cov u
  · refine hmain.trans ?_
    have hM : (0:ℝ) ≤ 3 ^ a * jbr k ^ (-a) * (max 1 (∑' m, gw L k a m)) ^ 6 := by
      have h1 := Real.rpow_nonneg (by norm_num : (0:ℝ) ≤ 3) a
      have h2 := Real.rpow_nonneg (WaveTurbulence.Induct.jbr_pos k).le (-a)
      positivity
    have hc : (({(0, ({1, 2, 3, 4, 5} : Finset (Fin 6))), (1, ({0, 2, 3, 4, 5} : Finset (Fin 6))), (2, ({0, 1, 3, 4, 5} : Finset (Fin 6)))} : Finset (Fin 6 × Finset (Fin 6))).card : ℝ) ≤ 3 := by
      norm_num
    nlinarith
  · intro c hc; simp only [Finset.mem_insert, Finset.mem_singleton] at hc; rcases hc with rfl | rfl | rfl <;> decide
  · intro c hc n n' hn hn' hF
    simp only [Finset.mem_insert, Finset.mem_singleton] at hc; rcases hc with rfl | rfl | rfl
    · apply Subtype.ext; funext j i
      have o0 := congrFun (OL_rel0 n) i; have o1 := congrFun (OL_rel1 n) i
      have o0' := congrFun (OL_rel0 n') i; have o1' := congrFun (OL_rel1 n') i
      simp only [Pi.add_apply, Pi.sub_apply, Pi.zero_apply] at o0 o1 o0' o1'
      have f1 := congrFun (hF 1 (by decide)) i
      have f2 := congrFun (hF 2 (by decide)) i
      have f3 := congrFun (hF 3 (by decide)) i
      have f4 := congrFun (hF 4 (by decide)) i
      have f5 := congrFun (hF 5 (by decide)) i
      fin_cases j <;> simp <;> omega
    · apply Subtype.ext; funext j i
      have o0 := congrFun (OL_rel0 n) i; have o1 := congrFun (OL_rel1 n) i
      have o0' := congrFun (OL_rel0 n') i; have o1' := congrFun (OL_rel1 n') i
      simp only [Pi.add_apply, Pi.sub_apply, Pi.zero_apply] at o0 o1 o0' o1'
      have f0 := congrFun (hF 0 (by decide)) i
      have f2 := congrFun (hF 2 (by decide)) i
      have f3 := congrFun (hF 3 (by decide)) i
      have f4 := congrFun (hF 4 (by decide)) i
      have f5 := congrFun (hF 5 (by decide)) i
      fin_cases j <;> simp <;> omega
    · apply Subtype.ext; funext j i
      have o0 := congrFun (OL_rel0 n) i; have o1 := congrFun (OL_rel1 n) i
      have o0' := congrFun (OL_rel0 n') i; have o1' := congrFun (OL_rel1 n') i
      simp only [Pi.add_apply, Pi.sub_apply, Pi.zero_apply] at o0 o1 o0' o1'
      have f0 := congrFun (hF 0 (by decide)) i
      have f1 := congrFun (hF 1 (by decide)) i
      have f3 := congrFun (hF 3 (by decide)) i
      have f4 := congrFun (hF 4 (by decide)) i
      have f5 := congrFun (hF 5 (by decide)) i
      fin_cases j <;> simp <;> omega
  · intro n hn
    rcases tri_cases (L := L) k (n.1 0) (n.1 1) (n.1 2) (OL_rel0 n) with h | h | h
    · refine ⟨(0, ({1, 2, 3, 4, 5} : Finset (Fin 6))), by simp, ?_⟩
      exact h
    · refine ⟨(1, ({0, 2, 3, 4, 5} : Finset (Fin 6))), by simp, ?_⟩
      exact h
    · refine ⟨(2, ({0, 1, 3, 4, 5} : Finset (Fin 6))), by simp, ?_⟩
      exact h

theorem cfg_c01 {L : ℝ} (hL : 1 ≤ L) (k : Mom d) {a : ℝ} (ha : (d : ℝ) + 1 ≤ a)
    (u : Finset (OuterLabels d)) :
    ∑ n ∈ u, (if (n.1 0 = n.1 1) then ∏ j ∈ ({0, 2, 3, 4, 5} : Finset (Fin 6)), gw L k a (n.1 j) else 0) ≤
      3 * (3 ^ a * jbr k ^ (-a)) * (max 1 (∑' m, gw L k a m)) ^ 6 := by
  classical
  have hmain := cfg_sum hL k ha (fun n : Fin 6 → Fin d → ℤ => n 0 = n 1) ({0, 2, 3, 4, 5} : Finset (Fin 6))
    ({(2, ({0, 3, 4, 5} : Finset (Fin 6)))} : Finset (Fin 6 × Finset (Fin 6))) ?hz ?inj ?cov u
  · refine hmain.trans ?_
    have hM : (0:ℝ) ≤ 3 ^ a * jbr k ^ (-a) * (max 1 (∑' m, gw L k a m)) ^ 6 := by
      have h1 := Real.rpow_nonneg (by norm_num : (0:ℝ) ≤ 3) a
      have h2 := Real.rpow_nonneg (WaveTurbulence.Induct.jbr_pos k).le (-a)
      positivity
    have hc : (({(2, ({0, 3, 4, 5} : Finset (Fin 6)))} : Finset (Fin 6 × Finset (Fin 6))).card : ℝ) ≤ 3 := by
      norm_num
    nlinarith
  · intro c hc; simp only [Finset.mem_singleton] at hc; subst hc <;> decide
  · intro c hc n n' hn hn' hF
    simp only [Finset.mem_singleton] at hc; subst hc
    · apply Subtype.ext; funext j i
      have o0 := congrFun (OL_rel0 n) i; have o1 := congrFun (OL_rel1 n) i
      have o0' := congrFun (OL_rel0 n') i; have o1' := congrFun (OL_rel1 n') i
      simp only [Pi.add_apply, Pi.sub_apply, Pi.zero_apply] at o0 o1 o0' o1'
      have hn0 := hn
      have hm0 := hn'
      have e0 := congrFun hn0 i
      have e0' := congrFun hm0 i
      have f0 := congrFun (hF 0 (by decide)) i
      have f3 := congrFun (hF 3 (by decide)) i
      have f4 := congrFun (hF 4 (by decide)) i
      have f5 := congrFun (hF 5 (by decide)) i
      fin_cases j <;> simp <;> omega
  · intro n hn
    have hn0 := hn
    refine ⟨(2, ({0, 3, 4, 5} : Finset (Fin 6))), by simp, ?_⟩
    have hz : n.1 2 = 0 := by
      funext i
      have o0 := congrFun (OL_rel0 n) i; have o1 := congrFun (OL_rel1 n) i
      have e0 := congrFun hn0 i
      simp only [Pi.add_apply, Pi.sub_apply, Pi.zero_apply] at o0 o1 ⊢
      omega
    simp only [hz, lat_zero, add_zero]
    linarith [one_le_jbr k]

