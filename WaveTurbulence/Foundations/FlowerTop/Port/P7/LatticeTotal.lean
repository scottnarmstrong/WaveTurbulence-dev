module
public import WaveTurbulence.Foundations.FlowerTop.Port.P7.WtEq
public import WaveTurbulence.Foundations.FlowerTop.Port.P7.LatticeCfg
/-! FLOWER-P7: the total label weight of the sixteen pieces and its sum over the outer labels
(generated by gen_total.py). -/
@[expose] public section
set_option autoImplicit false
namespace WaveTurbulence.FlowerP7
open WaveTurbulence.Induct
open TTree Finset LGSpine

variable {d : ℕ}

/-- The sum of the sixteen label weights. -/
noncomputable def Wtot (L : ℝ) (k : Mom d) (a : ℝ) (n : Fin (2 * 3) → Fin d → ℤ) : ℝ :=
  Wt6 L k a n +
    (Wt42 L k a σ4 n + Wt42 L k a σ5 n + Wt42 L k a σ6 n + Wt42 L k a σ7 n + Wt42 L k a σ8 n + Wt42 L k a σ9 n) +
    ((Wt24m L k a τ1 σ1 n + Wt24m L k a τ2 σ1 n + Wt24irr L k a σ1 n) +
      (Wt24m L k a τ1 σ2 n + Wt24m L k a τ2 σ2 n + Wt24irr L k a σ2 n) +
      (Wt24m L k a τ1 σ3 n + Wt24m L k a τ2 σ3 n + Wt24irr L k a σ3 n))

theorem Wtot_sum_le {L : ℝ} (hL : 1 ≤ L) (k : Mom d) {a : ℝ} (ha : (d : ℝ) + 1 ≤ a)
    (u : Finset (OuterLabels d)) :
    ∑ n ∈ u, Wtot L k a n.1 ≤ 16 * (3 * (3 ^ a * jbr k ^ (-a)) * (max 1 (∑' m, gw L k a m)) ^ 6) := by
  simp only [Wtot, Finset.sum_add_distrib]
  simp only [wt_eq_irr6, wt_eq_c21, wt_eq_c23, wt_eq_c25, wt_eq_c41, wt_eq_c43, wt_eq_c45, wt_eq_c01, wt_eq_c03, wt_eq_c05, wt_eq_m012345, wt_eq_m012543, wt_eq_m032145, wt_eq_m032541, wt_eq_m052143, wt_eq_m052341]
  linarith [cfg_irr6 hL k ha u, cfg_c21 hL k ha u, cfg_c23 hL k ha u, cfg_c25 hL k ha u, cfg_c41 hL k ha u, cfg_c43 hL k ha u, cfg_c45 hL k ha u, cfg_c01 hL k ha u, cfg_c03 hL k ha u, cfg_c05 hL k ha u, cfg_m012345 hL k ha u, cfg_m012543 hL k ha u, cfg_m032145 hL k ha u, cfg_m032541 hL k ha u, cfg_m052143 hL k ha u, cfg_m052341 hL k ha u]

end WaveTurbulence.FlowerP7
