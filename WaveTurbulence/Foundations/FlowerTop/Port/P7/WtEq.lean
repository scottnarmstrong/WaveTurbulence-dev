theorem wt_eq_irr6 (L : ℝ) (k : Mom d) (a : ℝ) (n : Fin (2 * 3) → Fin d → ℤ) :
    Wt6 L k a n =
      (open scoped Classical in if (True) then ∏ j ∈ ({0, 1, 2, 3, 4, 5} : Finset (Fin 6)), gw L k a (n j) else 0) := by
  classical
  simp only [Wt42, Wt24irr, Wt24m, Wt6, Wcp, σ1, σ2, σ3, σ4, σ5, σ6, σ7, σ8, σ9, τ1, τ2, tableEquiv,
    Equiv.ofBijective_apply]
  split_ifs <;> simp_all [Finset.prod_insert, Fin.prod_univ_succ] <;> (first | done | ring1 | (left; ring1))

