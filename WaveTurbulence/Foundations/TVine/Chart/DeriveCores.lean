module

public import WaveTurbulence.Foundations.TVine.Chart.DeriveRung
public import WaveTurbulence.Foundations.TVine.Chart.ConfigsCore

/-!
# Derivation of the cell decomposition, XIII: placing the cores (L4, L5, L6)

Generated by `gen/gen_place.py`. `place_coreB`, `place_coreC` (spine cores: input and exit port) and `place_coreD`
(the pendant end: input port only), in the pattern of `place_rung`.
-/

@[expose] public section
set_option autoImplicit false

namespace WaveTurbulence.TVine.Chart

open Finset VineParamContract

variable {V D : Type} [DecidableEq V] [Fintype D] [DecidableEq D] {M : Molecule V D} {S : Finset V} {a b : V}

theorem fun8 {P : (Fin 8 → Bool) → Prop} (h : ∀ b0 b1 b2 b3 b4 b5 b6 b7 : Bool, P ![b0, b1, b2, b3, b4, b5, b6, b7])
    (b : Fin 8 → Bool) : P b := by
  have : b = ![b 0, b 1, b 2, b 3, b 4, b 5, b 6, b 7] := by funext i; fin_cases i <;> rfl
  rw [this]; exact h _ _ _ _ _ _ _ _

theorem fun7' {P : (Fin 7 → Bool) → Prop} (h : ∀ b0 b1 b2 b3 b4 b5 b6 : Bool, P ![b0, b1, b2, b3, b4, b5, b6])
    (b : Fin 7 → Bool) : P b := by
  have : b = ![b 0, b 1, b 2, b 3, b 4, b 5, b 6] := by funext i; fin_cases i <;> rfl
  rw [this]; exact h _ _ _ _ _ _ _

/-- **Placing a (B) core** -/
theorem place_coreB (tab : List (LocalChart 3 3 8))
    (htab : ∀ c ∈ tab, c.Valid ∧ CoreOK c ∧ coreBShape.RoleCompat c ∧ c.Rel 1 1 0 ∧ c.ExtrasOK)
    (hcov : ∀ b0 b1 b2 b3 b4 b5 b6 b7 : Bool, coreBShape.OK ![b0, b1, b2, b3, b4, b5, b6, b7] →
      ∃ c ∈ tab, c.src = coreBShape.src ![b0, b1, b2, b3, b4, b5, b6, b7] ∧ c.dst = coreBShape.dst ![b0, b1, b2, b3, b4, b5, b6, b7])
    (hM : M.IsMolecule) {x y z : V}
    (hxy : x ≠ y) (hxz : x ≠ z) (hyz : y ≠ z)
    (hmx : x ∈ M.atoms) (hmy : y ∈ M.atoms) (hmz : z ∈ M.atoms)
    (hdegx : M.degIn S x = 4) (hdegy : M.degIn S y = 4) (hdegz : M.degIn S z = 4)
    (dxy₀ : Bond M S) (hxy₀ : (tl dxy₀ = x ∧ hd dxy₀ = y) ∨ (tl dxy₀ = y ∧ hd dxy₀ = x))
    (dxy₁ : Bond M S) (hxy₁ : (tl dxy₁ = x ∧ hd dxy₁ = y) ∨ (tl dxy₁ = y ∧ hd dxy₁ = x))
    (dyz : Bond M S) (hyz₀ : (tl dyz = y ∧ hd dyz = z) ∨ (tl dyz = z ∧ hd dyz = y))
    (dxz : Bond M S) (hxz₀ : (tl dxz = x ∧ hd dxz = z) ∨ (tl dxz = z ∧ hd dxz = x))
    (hdxy : dxy₀ ≠ dxy₁)
    {Xi Xo : Finset V} (pti : Port2 M S Xi a b) (pto : Port2 M S Xo a b)
    (hXio : Xi ⊆ Xo)
    (hxXi : x ∉ Xi) (hyXi : y ∉ Xi) (hzXi : z ∉ Xi)
    (hxXo : x ∈ Xo) (hyXo : y ∈ Xo) (hzXo : z ∈ Xo)
    (hEi : InEnds pti z x)
    (hEo : OutEnds pto z y)
    : ∃ c ∈ tab, ∃ φ : LocEmb c.graph M S, φ.atom = ![x, y, z] ∧
      φ.bond = ![dxy₀, dxy₁, dyz, dxz, inAt pti z, inAt pti x, outAt pto z, outAt pto y] ∧
      φ.bond c.eO = pti.out ∧ φ.bond c.eI = pti.inn ∧
      ∃ p, c.outM = some p ∧ φ.bond p.1 = pto.out ∧ φ.bond p.2 = pto.inn := by
  classical
  set φA : Fin 3 → V := ![x, y, z]
  set φB : Fin 8 → Bond M S := ![dxy₀, dxy₁, dyz, dxz, inAt pti z, inAt pti x, outAt pto z, outAt pto y]
  have hAinj : Function.Injective φA := by
    intro i j h; fin_cases i <;> fin_cases j <;> simp [φA] at h <;>
      first | rfl | exact absurd h ‹_› | exact absurd h.symm ‹_›
  have hAnotXi : ∀ i, φA i ∉ Xi := by intro i; fin_cases i <;> simp [φA, hxXi, hyXi, hzXi]
  have hAXo : ∀ i, φA i ∈ Xo := by intro i; fin_cases i <;> simp [φA, hxXo, hyXo, hzXo]
  let R : SRole → Finset V := fun ρ => if ρ = .inp then Xi else Xo
  have hcov' : ∀ bb : Fin 8 → Bool, coreBShape.OK bb →
      ∃ c ∈ tab, c.src = coreBShape.src bb ∧ c.dst = coreBShape.dst bb :=
    fun bb => fun8 (P := fun bb => coreBShape.OK bb →
      ∃ c ∈ tab, c.src = coreBShape.src bb ∧ c.dst = coreBShape.dst bb) hcov bb
  have hintNo : ∀ (e : Bond M S) (u w : V), (u ∉ Xi ∧ w ∉ Xi) → (u ∈ Xo ∧ w ∈ Xo) → ((tl e = u ∧ hd e = w) ∨ (tl e = w ∧ hd e = u)) → ∀ ρ : SRole, ¬ Crosses (R ρ) e := by
    intro e u w hi ho he ρ
    by_cases hρ : ρ = .inp
    · simp only [R, hρ, ite_true]
      rcases he with ⟨h1, h2⟩ | ⟨h1, h2⟩
      · exact not_cross_out (h1 ▸ hi.1) (h2 ▸ hi.2)
      · exact not_cross_out (h1 ▸ hi.2) (h2 ▸ hi.1)
    · simp only [R, hρ, ite_false]
      rcases he with ⟨h1, h2⟩ | ⟨h1, h2⟩
      · exact not_cross_in (h1 ▸ ho.1) (h2 ▸ ho.2)
      · exact not_cross_in (h1 ▸ ho.2) (h2 ▸ ho.1)
  have hstubIn : ∀ (v v' : V), v ≠ v' → InEnds pti v v' →
      (hd (inAt pti v) = v ∧ ∀ i, tl (inAt pti v) ≠ φA i) ∨ (tl (inAt pti v) = v ∧ ∀ i, hd (inAt pti v) ≠ φA i) := by
    intro v v' hvv' hE
    rcases inAt_end hvv' hE with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exact Or.inl ⟨h1, fun i h => hAnotXi i (h ▸ h2)⟩
    · exact Or.inr ⟨h1, fun i h => hAnotXi i (h ▸ h2)⟩
  have hstubOut : ∀ (v v' : V), v ≠ v' → OutEnds pto v v' →
      (tl (outAt pto v) = v ∧ ∀ i, hd (outAt pto v) ≠ φA i) ∨ (hd (outAt pto v) = v ∧ ∀ i, tl (outAt pto v) ≠ φA i) := by
    intro v v' hvv' hE
    rcases outAt_end hvv' hE with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exact Or.inl ⟨h1, fun i h => h2 (h ▸ hAXo i)⟩
    · exact Or.inr ⟨h1, fun i h => h2 (h ▸ hAXo i)⟩
  obtain ⟨c, hc, hcs, hcd, φ, hφA, hφB⟩ := place_cell coreBShape tab hcov' hM φA φB R hAinj
    (by intro i; fin_cases i <;> simp [φA, hmx, hmy, hmz])
    (by intro i; fin_cases i <;> simp [φA, hdegx, hdegy, hdegz])
    (by decide) (by decide) (by decide) (by decide)
    (by
      intro l u' w' h
      fin_cases l <;> simp [coreBShape] at h
      · obtain ⟨rfl, rfl⟩ := h; simpa [φA, φB] using hxy₀
      · obtain ⟨rfl, rfl⟩ := h; simpa [φA, φB] using hxy₁
      · obtain ⟨rfl, rfl⟩ := h; simpa [φA, φB] using hyz₀
      · obtain ⟨rfl, rfl⟩ := h; simpa [φA, φB] using hxz₀
      )
    (by
      intro l l' u' w' u'' w'' hne h h' hs
      fin_cases l <;> fin_cases l' <;> simp [coreBShape] at h h' hne <;>
        (try (obtain ⟨rfl, rfl⟩ := h; obtain ⟨rfl, rfl⟩ := h')) <;> simp [Sym2.eq_iff] at hs <;> simp [φB, hdxy, Ne.symm hdxy])
    (by
      intro l u' w' ρ h hρ
      fin_cases l <;> simp [coreBShape] at h
      · exact hintNo dxy₀ x y ⟨hxXi, hyXi⟩ ⟨hxXo, hyXo⟩ hxy₀ ρ
      · exact hintNo dxy₁ x y ⟨hxXi, hyXi⟩ ⟨hxXo, hyXo⟩ hxy₁ ρ
      · exact hintNo dyz y z ⟨hyXi, hzXi⟩ ⟨hyXo, hzXo⟩ hyz₀ ρ
      · exact hintNo dxz x z ⟨hxXi, hzXi⟩ ⟨hxXo, hzXo⟩ hxz₀ ρ
      )
    (by
      intro l u' h
      fin_cases l <;> simp [coreBShape] at h <;> subst h <;> unfold StubAt
      · rcases hstubIn z _ hxz.symm hEi with h | h
        · exact Or.inr h
        · exact Or.inl h
      · rcases hstubIn x _ hxz hEi.symm with h | h
        · exact Or.inr h
        · exact Or.inl h
      · exact hstubOut z _ hyz.symm hEo
      · exact hstubOut y _ hyz hEo.symm
      )
    (by
      intro l u' h
      fin_cases l <;> simp [coreBShape] at h <;> simp only [R, φB, coreBShape]
      · exact inAt_cross pti z
      · exact inAt_cross pti x
      · exact outAt_cross pto z
      · exact outAt_cross pto y
      )
    (by
      intro l l' u' u'' h h' hr
      fin_cases l <;> fin_cases l' <;> simp [coreBShape] at h h' hr <;> simp only [R, φB, coreBShape]
      · exact inAt_not_cross pti hxz.symm hEi hXio hzXo
      · exact inAt_not_cross pti hxz.symm hEi hXio hzXo
      · exact inAt_not_cross pti hxz hEi.symm hXio hxXo
      · exact inAt_not_cross pti hxz hEi.symm hXio hxXo
      · exact outAt_not_cross pto hyz.symm hEo hXio hzXi
      · exact outAt_not_cross pto hyz.symm hEo hXio hzXi
      · exact outAt_not_cross pto hyz hEo.symm hXio hyXi
      · exact outAt_not_cross pto hyz hEo.symm hXio hyXi
      )
    (by
      intro ρ hρ
      simp only [List.mem_cons, List.mem_nil_iff, or_false] at hρ
      rcases hρ with rfl | rfl | rfl
      · apply pair_count _ _ 4 5 (by decide) (by decide)
        simp only [placeBits, φB, φA, coreBShape]
        exact inAt_bits hxz.symm hEi
      · apply pair_count _ _ 6 7 (by decide) (by decide)
        simp only [placeBits, φB, φA, coreBShape]
        exact outAt_bits hyz.symm hEo
      · exact absent_count _ _ (by decide) _
      )
  obtain ⟨-, -, hRC, -, -⟩ := htab c hc
  obtain ⟨hrO, hrI, hsO, hdI, hM', -⟩ := hRC
  have hinp : ∀ l, coreBShape.role l = .inp ↔ l = 4 ∨ l = 5 := by decide
  have hA0 : φ.atom 0 = x := by rw [hφA]; rfl
  have hA1 : φ.atom 1 = y := by rw [hφA]; rfl
  have hA2 : φ.atom 2 = z := by rw [hφA]; rfl
  have bb4 : φ.bond 4 = inAt pti z := by rw [hφB]; rfl
  have bb5 : φ.bond 5 = inAt pti x := by rw [hφB]; rfl
  have bb6 : φ.bond 6 = outAt pto z := by rw [hφB]; rfl
  have bb7 : φ.bond 7 = outAt pto y := by rw [hφB]; rfl
  have hexm : ∀ l, coreBShape.role l = .exM ↔ l = 6 ∨ l = 7 := by decide
  refine ⟨c, hc, φ, hφA, hφB, ?_, ?_, ?_⟩
  · have hs := φ.tl_out c.eO hsO
    rcases (hinp _).mp hrO with h | h <;> rw [h] at hs ⊢
    · rw [bb4]; have := hs 2; rw [bb4, hA2] at this; exact inAt_eq_out pti hxz.symm hEi this
    · rw [bb5]; have := hs 0; rw [bb5, hA0] at this; exact inAt_eq_out pti hxz hEi.symm this
  · have hs := φ.hd_out c.eI hdI
    rcases (hinp _).mp hrI with h | h <;> rw [h] at hs ⊢
    · rw [bb4]; have := hs 2; rw [bb4, hA2] at this; exact inAt_eq_inn' pti this
    · rw [bb5]; have := hs 0; rw [bb5, hA0] at this; exact inAt_eq_inn' pti this
  · revert hM'
    cases hp : c.outM with
    | none => intro h; exact absurd (h 6) (by decide)
    | some p =>
      rintro ⟨hr1, hr2, hd1, hs2⟩
      refine ⟨p, rfl, ?_, ?_⟩
      · have hs := φ.hd_out p.1 hd1
        rcases (hexm _).mp hr1 with h | h <;> rw [h] at hs ⊢
        · rw [bb6]; have := hs 2; rw [bb6, hA2] at this; exact outAt_eq_out pto hyz.symm hEo this
        · rw [bb7]; have := hs 1; rw [bb7, hA1] at this; exact outAt_eq_out pto hyz hEo.symm this
      · have hs := φ.tl_out p.2 hs2
        rcases (hexm _).mp hr2 with h | h <;> rw [h] at hs ⊢
        · rw [bb6]; have := hs 2; rw [bb6, hA2] at this; exact outAt_eq_inn pto hyz.symm hEo this
        · rw [bb7]; have := hs 1; rw [bb7, hA1] at this; exact outAt_eq_inn pto hyz hEo.symm this

/-- **Placing a (C) core** -/
theorem place_coreC (tab : List (LocalChart 3 3 8))
    (htab : ∀ c ∈ tab, c.Valid ∧ CoreOK c ∧ coreCShape.RoleCompat c ∧ c.Rel 1 1 0 ∧ c.ExtrasOK)
    (hcov : ∀ b0 b1 b2 b3 b4 b5 b6 b7 : Bool, coreCShape.OK ![b0, b1, b2, b3, b4, b5, b6, b7] →
      ∃ c ∈ tab, c.src = coreCShape.src ![b0, b1, b2, b3, b4, b5, b6, b7] ∧ c.dst = coreCShape.dst ![b0, b1, b2, b3, b4, b5, b6, b7])
    (hM : M.IsMolecule) {w₁ w₂ w₃ : V}
    (hw₁w₂ : w₁ ≠ w₂) (hw₁w₃ : w₁ ≠ w₃) (hw₂w₃ : w₂ ≠ w₃)
    (hmw₁ : w₁ ∈ M.atoms) (hmw₂ : w₂ ∈ M.atoms) (hmw₃ : w₃ ∈ M.atoms)
    (hdegw₁ : M.degIn S w₁ = 4) (hdegw₂ : M.degIn S w₂ = 4) (hdegw₃ : M.degIn S w₃ = 4)
    (d₁₂ : Bond M S) (h₁₂ : (tl d₁₂ = w₁ ∧ hd d₁₂ = w₂) ∨ (tl d₁₂ = w₂ ∧ hd d₁₂ = w₁))
    (d₁₂' : Bond M S) (h₁₂' : (tl d₁₂' = w₁ ∧ hd d₁₂' = w₂) ∨ (tl d₁₂' = w₂ ∧ hd d₁₂' = w₁))
    (d₂₃ : Bond M S) (h₂₃ : (tl d₂₃ = w₂ ∧ hd d₂₃ = w₃) ∨ (tl d₂₃ = w₃ ∧ hd d₂₃ = w₂))
    (d₂₃' : Bond M S) (h₂₃' : (tl d₂₃' = w₂ ∧ hd d₂₃' = w₃) ∨ (tl d₂₃' = w₃ ∧ hd d₂₃' = w₂))
    (hd₁₂ : d₁₂ ≠ d₁₂')
    (hd₂₃ : d₂₃ ≠ d₂₃')
    {Xi Xo : Finset V} (pti : Port2 M S Xi a b) (pto : Port2 M S Xo a b)
    (hXio : Xi ⊆ Xo)
    (hw₁Xi : w₁ ∉ Xi) (hw₂Xi : w₂ ∉ Xi) (hw₃Xi : w₃ ∉ Xi)
    (hw₁Xo : w₁ ∈ Xo) (hw₂Xo : w₂ ∈ Xo) (hw₃Xo : w₃ ∈ Xo)
    (hEi : InEnds pti w₁ w₃)
    (hEo : OutEnds pto w₁ w₃)
    : ∃ c ∈ tab, ∃ φ : LocEmb c.graph M S, φ.atom = ![w₁, w₂, w₃] ∧
      φ.bond = ![d₁₂, d₁₂', d₂₃, d₂₃', inAt pti w₁, inAt pti w₃, outAt pto w₁, outAt pto w₃] ∧
      φ.bond c.eO = pti.out ∧ φ.bond c.eI = pti.inn ∧
      ∃ p, c.outM = some p ∧ φ.bond p.1 = pto.out ∧ φ.bond p.2 = pto.inn := by
  classical
  set φA : Fin 3 → V := ![w₁, w₂, w₃]
  set φB : Fin 8 → Bond M S := ![d₁₂, d₁₂', d₂₃, d₂₃', inAt pti w₁, inAt pti w₃, outAt pto w₁, outAt pto w₃]
  have hAinj : Function.Injective φA := by
    intro i j h; fin_cases i <;> fin_cases j <;> simp [φA] at h <;>
      first | rfl | exact absurd h ‹_› | exact absurd h.symm ‹_›
  have hAnotXi : ∀ i, φA i ∉ Xi := by intro i; fin_cases i <;> simp [φA, hw₁Xi, hw₂Xi, hw₃Xi]
  have hAXo : ∀ i, φA i ∈ Xo := by intro i; fin_cases i <;> simp [φA, hw₁Xo, hw₂Xo, hw₃Xo]
  let R : SRole → Finset V := fun ρ => if ρ = .inp then Xi else Xo
  have hcov' : ∀ bb : Fin 8 → Bool, coreCShape.OK bb →
      ∃ c ∈ tab, c.src = coreCShape.src bb ∧ c.dst = coreCShape.dst bb :=
    fun bb => fun8 (P := fun bb => coreCShape.OK bb →
      ∃ c ∈ tab, c.src = coreCShape.src bb ∧ c.dst = coreCShape.dst bb) hcov bb
  have hintNo : ∀ (e : Bond M S) (u w : V), (u ∉ Xi ∧ w ∉ Xi) → (u ∈ Xo ∧ w ∈ Xo) → ((tl e = u ∧ hd e = w) ∨ (tl e = w ∧ hd e = u)) → ∀ ρ : SRole, ¬ Crosses (R ρ) e := by
    intro e u w hi ho he ρ
    by_cases hρ : ρ = .inp
    · simp only [R, hρ, ite_true]
      rcases he with ⟨h1, h2⟩ | ⟨h1, h2⟩
      · exact not_cross_out (h1 ▸ hi.1) (h2 ▸ hi.2)
      · exact not_cross_out (h1 ▸ hi.2) (h2 ▸ hi.1)
    · simp only [R, hρ, ite_false]
      rcases he with ⟨h1, h2⟩ | ⟨h1, h2⟩
      · exact not_cross_in (h1 ▸ ho.1) (h2 ▸ ho.2)
      · exact not_cross_in (h1 ▸ ho.2) (h2 ▸ ho.1)
  have hstubIn : ∀ (v v' : V), v ≠ v' → InEnds pti v v' →
      (hd (inAt pti v) = v ∧ ∀ i, tl (inAt pti v) ≠ φA i) ∨ (tl (inAt pti v) = v ∧ ∀ i, hd (inAt pti v) ≠ φA i) := by
    intro v v' hvv' hE
    rcases inAt_end hvv' hE with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exact Or.inl ⟨h1, fun i h => hAnotXi i (h ▸ h2)⟩
    · exact Or.inr ⟨h1, fun i h => hAnotXi i (h ▸ h2)⟩
  have hstubOut : ∀ (v v' : V), v ≠ v' → OutEnds pto v v' →
      (tl (outAt pto v) = v ∧ ∀ i, hd (outAt pto v) ≠ φA i) ∨ (hd (outAt pto v) = v ∧ ∀ i, tl (outAt pto v) ≠ φA i) := by
    intro v v' hvv' hE
    rcases outAt_end hvv' hE with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exact Or.inl ⟨h1, fun i h => h2 (h ▸ hAXo i)⟩
    · exact Or.inr ⟨h1, fun i h => h2 (h ▸ hAXo i)⟩
  obtain ⟨c, hc, hcs, hcd, φ, hφA, hφB⟩ := place_cell coreCShape tab hcov' hM φA φB R hAinj
    (by intro i; fin_cases i <;> simp [φA, hmw₁, hmw₂, hmw₃])
    (by intro i; fin_cases i <;> simp [φA, hdegw₁, hdegw₂, hdegw₃])
    (by decide) (by decide) (by decide) (by decide)
    (by
      intro l u' w' h
      fin_cases l <;> simp [coreCShape] at h
      · obtain ⟨rfl, rfl⟩ := h; simpa [φA, φB] using h₁₂
      · obtain ⟨rfl, rfl⟩ := h; simpa [φA, φB] using h₁₂'
      · obtain ⟨rfl, rfl⟩ := h; simpa [φA, φB] using h₂₃
      · obtain ⟨rfl, rfl⟩ := h; simpa [φA, φB] using h₂₃'
      )
    (by
      intro l l' u' w' u'' w'' hne h h' hs
      fin_cases l <;> fin_cases l' <;> simp [coreCShape] at h h' hne <;>
        (try (obtain ⟨rfl, rfl⟩ := h; obtain ⟨rfl, rfl⟩ := h')) <;> simp [Sym2.eq_iff] at hs <;> simp [φB, hd₁₂, hd₂₃, Ne.symm hd₁₂, Ne.symm hd₂₃])
    (by
      intro l u' w' ρ h hρ
      fin_cases l <;> simp [coreCShape] at h
      · exact hintNo d₁₂ w₁ w₂ ⟨hw₁Xi, hw₂Xi⟩ ⟨hw₁Xo, hw₂Xo⟩ h₁₂ ρ
      · exact hintNo d₁₂' w₁ w₂ ⟨hw₁Xi, hw₂Xi⟩ ⟨hw₁Xo, hw₂Xo⟩ h₁₂' ρ
      · exact hintNo d₂₃ w₂ w₃ ⟨hw₂Xi, hw₃Xi⟩ ⟨hw₂Xo, hw₃Xo⟩ h₂₃ ρ
      · exact hintNo d₂₃' w₂ w₃ ⟨hw₂Xi, hw₃Xi⟩ ⟨hw₂Xo, hw₃Xo⟩ h₂₃' ρ
      )
    (by
      intro l u' h
      fin_cases l <;> simp [coreCShape] at h <;> subst h <;> unfold StubAt
      · rcases hstubIn w₁ _ hw₁w₃ hEi with h | h
        · exact Or.inr h
        · exact Or.inl h
      · rcases hstubIn w₃ _ hw₁w₃.symm hEi.symm with h | h
        · exact Or.inr h
        · exact Or.inl h
      · exact hstubOut w₁ _ hw₁w₃ hEo
      · exact hstubOut w₃ _ hw₁w₃.symm hEo.symm
      )
    (by
      intro l u' h
      fin_cases l <;> simp [coreCShape] at h <;> simp only [R, φB, coreCShape]
      · exact inAt_cross pti w₁
      · exact inAt_cross pti w₃
      · exact outAt_cross pto w₁
      · exact outAt_cross pto w₃
      )
    (by
      intro l l' u' u'' h h' hr
      fin_cases l <;> fin_cases l' <;> simp [coreCShape] at h h' hr <;> simp only [R, φB, coreCShape]
      · exact inAt_not_cross pti hw₁w₃ hEi hXio hw₁Xo
      · exact inAt_not_cross pti hw₁w₃ hEi hXio hw₁Xo
      · exact inAt_not_cross pti hw₁w₃.symm hEi.symm hXio hw₃Xo
      · exact inAt_not_cross pti hw₁w₃.symm hEi.symm hXio hw₃Xo
      · exact outAt_not_cross pto hw₁w₃ hEo hXio hw₁Xi
      · exact outAt_not_cross pto hw₁w₃ hEo hXio hw₁Xi
      · exact outAt_not_cross pto hw₁w₃.symm hEo.symm hXio hw₃Xi
      · exact outAt_not_cross pto hw₁w₃.symm hEo.symm hXio hw₃Xi
      )
    (by
      intro ρ hρ
      simp only [List.mem_cons, List.mem_nil_iff, or_false] at hρ
      rcases hρ with rfl | rfl | rfl
      · apply pair_count _ _ 4 5 (by decide) (by decide)
        simp only [placeBits, φB, φA, coreCShape]
        exact inAt_bits hw₁w₃ hEi
      · apply pair_count _ _ 6 7 (by decide) (by decide)
        simp only [placeBits, φB, φA, coreCShape]
        exact outAt_bits hw₁w₃ hEo
      · exact absent_count _ _ (by decide) _
      )
  obtain ⟨-, -, hRC, -, -⟩ := htab c hc
  obtain ⟨hrO, hrI, hsO, hdI, hM', -⟩ := hRC
  have hinp : ∀ l, coreCShape.role l = .inp ↔ l = 4 ∨ l = 5 := by decide
  have hA0 : φ.atom 0 = w₁ := by rw [hφA]; rfl
  have hA1 : φ.atom 1 = w₂ := by rw [hφA]; rfl
  have hA2 : φ.atom 2 = w₃ := by rw [hφA]; rfl
  have bb4 : φ.bond 4 = inAt pti w₁ := by rw [hφB]; rfl
  have bb5 : φ.bond 5 = inAt pti w₃ := by rw [hφB]; rfl
  have bb6 : φ.bond 6 = outAt pto w₁ := by rw [hφB]; rfl
  have bb7 : φ.bond 7 = outAt pto w₃ := by rw [hφB]; rfl
  have hexm : ∀ l, coreCShape.role l = .exM ↔ l = 6 ∨ l = 7 := by decide
  refine ⟨c, hc, φ, hφA, hφB, ?_, ?_, ?_⟩
  · have hs := φ.tl_out c.eO hsO
    rcases (hinp _).mp hrO with h | h <;> rw [h] at hs ⊢
    · rw [bb4]; have := hs 0; rw [bb4, hA0] at this; exact inAt_eq_out pti hw₁w₃ hEi this
    · rw [bb5]; have := hs 2; rw [bb5, hA2] at this; exact inAt_eq_out pti hw₁w₃.symm hEi.symm this
  · have hs := φ.hd_out c.eI hdI
    rcases (hinp _).mp hrI with h | h <;> rw [h] at hs ⊢
    · rw [bb4]; have := hs 0; rw [bb4, hA0] at this; exact inAt_eq_inn' pti this
    · rw [bb5]; have := hs 2; rw [bb5, hA2] at this; exact inAt_eq_inn' pti this
  · revert hM'
    cases hp : c.outM with
    | none => intro h; exact absurd (h 6) (by decide)
    | some p =>
      rintro ⟨hr1, hr2, hd1, hs2⟩
      refine ⟨p, rfl, ?_, ?_⟩
      · have hs := φ.hd_out p.1 hd1
        rcases (hexm _).mp hr1 with h | h <;> rw [h] at hs ⊢
        · rw [bb6]; have := hs 0; rw [bb6, hA0] at this; exact outAt_eq_out pto hw₁w₃ hEo this
        · rw [bb7]; have := hs 2; rw [bb7, hA2] at this; exact outAt_eq_out pto hw₁w₃.symm hEo.symm this
      · have hs := φ.tl_out p.2 hs2
        rcases (hexm _).mp hr2 with h | h <;> rw [h] at hs ⊢
        · rw [bb6]; have := hs 0; rw [bb6, hA0] at this; exact outAt_eq_inn pto hw₁w₃ hEo this
        · rw [bb7]; have := hs 2; rw [bb7, hA2] at this; exact outAt_eq_inn pto hw₁w₃.symm hEo.symm this

/-- **Placing a (D) core** -/
theorem place_coreD (tab : List (LocalChart 3 3 7))
    (htab : ∀ c ∈ tab, c.Valid ∧ CoreOK c ∧ coreDShape.RoleCompat c ∧ c.Rel 0 0 0 ∧ c.ExtrasOK)
    (hcov : ∀ b0 b1 b2 b3 b4 b5 b6 : Bool, coreDShape.OK ![b0, b1, b2, b3, b4, b5, b6] →
      ∃ c ∈ tab, c.src = coreDShape.src ![b0, b1, b2, b3, b4, b5, b6] ∧ c.dst = coreDShape.dst ![b0, b1, b2, b3, b4, b5, b6])
    (hM : M.IsMolecule) {p r q : V}
    (hpr : p ≠ r) (hpq : p ≠ q) (hrq : r ≠ q)
    (hmp : p ∈ M.atoms) (hmr : r ∈ M.atoms) (hmq : q ∈ M.atoms)
    (hdegp : M.degIn S p = 4) (hdegr : M.degIn S r = 4) (hdegq : M.degIn S q = 4)
    (dpr : Bond M S) (hpr₀ : (tl dpr = p ∧ hd dpr = r) ∨ (tl dpr = r ∧ hd dpr = p))
    (dpr' : Bond M S) (hpr₁ : (tl dpr' = p ∧ hd dpr' = r) ∨ (tl dpr' = r ∧ hd dpr' = p))
    (drq : Bond M S) (hrq₀ : (tl drq = r ∧ hd drq = q) ∨ (tl drq = q ∧ hd drq = r))
    (drq' : Bond M S) (hrq₁ : (tl drq' = r ∧ hd drq' = q) ∨ (tl drq' = q ∧ hd drq' = r))
    (dpq : Bond M S) (hpq₀ : (tl dpq = p ∧ hd dpq = q) ∨ (tl dpq = q ∧ hd dpq = p))
    (hdpr : dpr ≠ dpr')
    (hdrq : drq ≠ drq')
    {Xi : Finset V} (pti : Port2 M S Xi a b)
    (hpXi : p ∉ Xi) (hrXi : r ∉ Xi) (hqXi : q ∉ Xi)
    (hEi : InEnds pti p q)
    : ∃ c ∈ tab, ∃ φ : LocEmb c.graph M S, φ.atom = ![p, r, q] ∧
      φ.bond = ![dpr, dpr', drq, drq', dpq, inAt pti p, inAt pti q] ∧
      φ.bond c.eO = pti.out ∧ φ.bond c.eI = pti.inn := by
  classical
  set φA : Fin 3 → V := ![p, r, q]
  set φB : Fin 7 → Bond M S := ![dpr, dpr', drq, drq', dpq, inAt pti p, inAt pti q]
  have hAinj : Function.Injective φA := by
    intro i j h; fin_cases i <;> fin_cases j <;> simp [φA] at h <;>
      first | rfl | exact absurd h ‹_› | exact absurd h.symm ‹_›
  have hAnotXi : ∀ i, φA i ∉ Xi := by intro i; fin_cases i <;> simp [φA, hpXi, hrXi, hqXi]
  let R : SRole → Finset V := fun _ => Xi
  have hcov' : ∀ bb : Fin 7 → Bool, coreDShape.OK bb →
      ∃ c ∈ tab, c.src = coreDShape.src bb ∧ c.dst = coreDShape.dst bb :=
    fun bb => fun7' (P := fun bb => coreDShape.OK bb →
      ∃ c ∈ tab, c.src = coreDShape.src bb ∧ c.dst = coreDShape.dst bb) hcov bb
  have hintNo : ∀ (e : Bond M S) (u w : V), (u ∉ Xi ∧ w ∉ Xi) → ((tl e = u ∧ hd e = w) ∨ (tl e = w ∧ hd e = u)) → ∀ ρ : SRole, ¬ Crosses (R ρ) e := by
    intro e u w hi he ρ
    simp only [R]
    rcases he with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exact not_cross_out (h1 ▸ hi.1) (h2 ▸ hi.2)
    · exact not_cross_out (h1 ▸ hi.2) (h2 ▸ hi.1)
  have hstubIn : ∀ (v v' : V), v ≠ v' → InEnds pti v v' →
      (hd (inAt pti v) = v ∧ ∀ i, tl (inAt pti v) ≠ φA i) ∨ (tl (inAt pti v) = v ∧ ∀ i, hd (inAt pti v) ≠ φA i) := by
    intro v v' hvv' hE
    rcases inAt_end hvv' hE with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exact Or.inl ⟨h1, fun i h => hAnotXi i (h ▸ h2)⟩
    · exact Or.inr ⟨h1, fun i h => hAnotXi i (h ▸ h2)⟩
  obtain ⟨c, hc, hcs, hcd, φ, hφA, hφB⟩ := place_cell coreDShape tab hcov' hM φA φB R hAinj
    (by intro i; fin_cases i <;> simp [φA, hmp, hmr, hmq])
    (by intro i; fin_cases i <;> simp [φA, hdegp, hdegr, hdegq])
    (by decide) (by decide) (by decide) (by decide)
    (by
      intro l u' w' h
      fin_cases l <;> simp [coreDShape] at h
      · obtain ⟨rfl, rfl⟩ := h; simpa [φA, φB] using hpr₀
      · obtain ⟨rfl, rfl⟩ := h; simpa [φA, φB] using hpr₁
      · obtain ⟨rfl, rfl⟩ := h; simpa [φA, φB] using hrq₀
      · obtain ⟨rfl, rfl⟩ := h; simpa [φA, φB] using hrq₁
      · obtain ⟨rfl, rfl⟩ := h; simpa [φA, φB] using hpq₀
      )
    (by
      intro l l' u' w' u'' w'' hne h h' hs
      fin_cases l <;> fin_cases l' <;> simp [coreDShape] at h h' hne <;>
        (try (obtain ⟨rfl, rfl⟩ := h; obtain ⟨rfl, rfl⟩ := h')) <;> simp [Sym2.eq_iff] at hs <;> simp [φB, hdpr, hdrq, Ne.symm hdpr, Ne.symm hdrq])
    (by
      intro l u' w' ρ h hρ
      fin_cases l <;> simp [coreDShape] at h
      · exact hintNo dpr p r ⟨hpXi, hrXi⟩ hpr₀ ρ
      · exact hintNo dpr' p r ⟨hpXi, hrXi⟩ hpr₁ ρ
      · exact hintNo drq r q ⟨hrXi, hqXi⟩ hrq₀ ρ
      · exact hintNo drq' r q ⟨hrXi, hqXi⟩ hrq₁ ρ
      · exact hintNo dpq p q ⟨hpXi, hqXi⟩ hpq₀ ρ
      )
    (by
      intro l u' h
      fin_cases l <;> simp [coreDShape] at h <;> subst h <;> unfold StubAt
      · rcases hstubIn p _ hpq hEi with h | h
        · exact Or.inr h
        · exact Or.inl h
      · rcases hstubIn q _ hpq.symm hEi.symm with h | h
        · exact Or.inr h
        · exact Or.inl h
      )
    (by
      intro l u' h
      fin_cases l <;> simp [coreDShape] at h <;> simp only [R, φB, coreDShape]
      · exact inAt_cross pti p
      · exact inAt_cross pti q
      )
    (by
      intro l l' u' u'' h h' hr
      fin_cases l <;> fin_cases l' <;> simp [coreDShape] at h h' hr <;> simp only [R, φB, coreDShape]
      )
    (by
      intro ρ hρ
      simp only [List.mem_cons, List.mem_nil_iff, or_false] at hρ
      rcases hρ with rfl | rfl | rfl
      · apply pair_count _ _ 5 6 (by decide) (by decide)
        simp only [placeBits, φB, φA, coreDShape]
        exact inAt_bits hpq hEi
      · exact absent_count _ _ (by decide) _
      · exact absent_count _ _ (by decide) _
      )
  obtain ⟨-, -, hRC, -, -⟩ := htab c hc
  obtain ⟨hrO, hrI, hsO, hdI, hM', -⟩ := hRC
  have hinp : ∀ l, coreDShape.role l = .inp ↔ l = 5 ∨ l = 6 := by decide
  have hA0 : φ.atom 0 = p := by rw [hφA]; rfl
  have hA1 : φ.atom 1 = r := by rw [hφA]; rfl
  have hA2 : φ.atom 2 = q := by rw [hφA]; rfl
  have bb5 : φ.bond 5 = inAt pti p := by rw [hφB]; rfl
  have bb6 : φ.bond 6 = inAt pti q := by rw [hφB]; rfl
  refine ⟨c, hc, φ, hφA, hφB, ?_, ?_⟩
  · have hs := φ.tl_out c.eO hsO
    rcases (hinp _).mp hrO with h | h <;> rw [h] at hs ⊢
    · rw [bb5]; have := hs 0; rw [bb5, hA0] at this; exact inAt_eq_out pti hpq hEi this
    · rw [bb6]; have := hs 2; rw [bb6, hA2] at this; exact inAt_eq_out pti hpq.symm hEi.symm this
  · have hs := φ.hd_out c.eI hdI
    rcases (hinp _).mp hrI with h | h <;> rw [h] at hs ⊢
    · rw [bb5]; have := hs 0; rw [bb5, hA0] at this; exact inAt_eq_inn' pti this
    · rw [bb6]; have := hs 2; rw [bb6, hA2] at this; exact inAt_eq_inn' pti this

end WaveTurbulence.TVine.Chart
