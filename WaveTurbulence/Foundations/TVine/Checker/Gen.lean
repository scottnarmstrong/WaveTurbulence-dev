module

public import WaveTurbulence.Foundations.TVine.Checker.Y2

/-!
# The parametric T-vine family (N2 Lemma 1.7; M4 §5.4 Lemma 1.7′, §8 F1)

The instances are generated by a Lean function from the parameters of N2 Lemma 1.7:
* `tri`: the doubled triangle `T` on `{0, 1, 2}`;
* `z1 es x y a b`: DH23's (Z1) move, replacing one copy of the bond `x–y` by `x–a ≡ b–y` (fresh `a, b`);
* `ladder k es x y N`: `k` successive (Z1) moves, the first on `x–y`, each later one on the triple bond just
  created, with fresh names `N, N+1, …`;
* `genC p`: the closure `T`, `Z_k(T, ℓ)` (`ℓ = 0–1`) or `Z_{k'}(Z_k(T, ℓ), ℓ')` (`ℓ' = x–y`, by position);
* `genB p j`: the block, with the two joints `n, n+1` (`n` the size of the closure) subdividing two bond copies
  (`σ = 0`) or one copy twice (`σ = 1`).

This file also contains the algebra of these operations used by the generation theorem: multiplicities after
(Z1), relabelling, commutation of (Z1) moves.
-/

@[expose] public section

namespace WaveTurbulence.TVine.Checker

open TVine

/-! ## The generator -/

/-- The doubled triangle `T` on `{0, 1, 2}`. -/
def tri : Edges := [(0, 1), (0, 1), (1, 2), (1, 2), (0, 2), (0, 2)]

/-- **(Z1)** (DH23 L1939, inverse of (Y2)): replace one copy of `x–y` by `x–a`, a triple bond `a ≡ b`, `b–y`. -/
def z1 (es : Edges) (x y a b : ℕ) : Edges := eraseOne es x y ++ [(x, a), (a, b), (a, b), (a, b), (b, y)]

/-- `k` successive (Z1) moves: the first at `x–y`, each later one on the triple bond just created; the `i`-th
move creates the fresh atoms `N + 4i, N + 4i + 1` (step 4, so that the two ladders of a closure use disjoint
residues mod 4 and never need renumbering). -/
def ladder : ℕ → Edges → ℕ → ℕ → ℕ → Edges
  | 0, es, _, _, _ => es
  | k + 1, es, x, y, N => ladder k (z1 es x y N (N + 1)) N (N + 1) (N + 4)

/-- Parameters of a closure (N2 Lemma 1.7): the length `k` of the first ladder (started on `ℓ = 0–1` of `T`;
`k = 0` is `T` itself) and, optionally, the second ladder: its start bond `ℓ' = x–y` (by position) and length. -/
structure CParam where
  k : ℕ
  second : Option (ℕ × ℕ × ℕ)
  deriving DecidableEq, Repr

/-- The length of the second ladder (`0` if there is none). -/
def CParam.k₂ (p : CParam) : ℕ :=
  match p.second with
  | none => 0
  | some (_, _, k') => k'

/-- The number of atoms of `genC p`. -/
def CParam.size (p : CParam) : ℕ := 3 + 2 * p.k + 2 * p.k₂

/-- The (fresh) name of the first joint of `genB p`; the second is `p.jname + 1`. -/
def CParam.jname (p : CParam) : ℕ := 4 * (p.k + p.k₂) + 3

/-- The first ladder `Z_k(T, ℓ)`, `ℓ = 0–1`, atoms `3 + 4i, 4 + 4i`. -/
def gen1 (k : ℕ) : Edges := ladder k tri 0 1 3

/-- The closure `T`, `Z_k(T, ℓ)` or `Z_{k'}(Z_k(T, ℓ), ℓ')` (second ladder: atoms `5 + 4i, 6 + 4i`). -/
def genC (p : CParam) : Edges :=
  match p.second with
  | none => gen1 p.k
  | some (x, y, k') => ladder k' (gen1 p.k) x y 5

/-- Joint placements (N2 Lemma 1.7, by position): two bond copies `x₁–y₁`, `x₂–y₂` subdivided by the joints
(`σ = 0`), or one copy `x–y` subdivided twice (`σ = 1`, `x–j₁–j₂–y`). -/
inductive JParam where
  | two (x₁ y₁ x₂ y₂ : ℕ)
  | one (x y : ℕ)
  deriving DecidableEq, Repr

/-- Place the joints `n` (`j₁`) and `n + 1` (`j₂`). -/
def placeJ (es : Edges) (n : ℕ) : JParam → Edges
  | .two x₁ y₁ x₂ y₂ => eraseOne (eraseOne es x₁ y₁) x₂ y₂ ++ [(x₁, n), (n, y₁), (x₂, n + 1), (n + 1, y₂)]
  | .one x y => eraseOne es x y ++ [(x, n), (n, n + 1), (n + 1, y)]

/-- The block with closure `genC p` and joints `p.jname`, `p.jname + 1`. -/
def genB (p : CParam) (j : JParam) : Edges := placeJ (genC p) p.jname j

/-! ## The multigraph of a bond list -/

/-- The `UMultigraph ℕ` of a bond list (vertices: the ends of the bonds). -/
def ofEdges (es : Edges) : UMultigraph ℕ where
  verts := (es.flatMap fun e => [e.1, e.2]).toFinset
  mult e := (es.map fun e => s(e.1, e.2)).count e
  supp := by
    intro e he x hx
    obtain ⟨e', he', rfl⟩ := List.mem_map.mp (List.count_pos_iff.mp (Nat.pos_of_ne_zero he))
    rw [Sym2.mem_iff] at hx
    simp only [List.mem_toFinset, List.mem_flatMap, List.mem_cons, List.not_mem_nil, or_false]
    exact ⟨e', he', hx⟩

theorem ofEdges_mult (es : Edges) (a b : ℕ) : (ofEdges es).mult s(a, b) = mult es a b :=
  (mult_eq_count es a b).symm

theorem mem_ofEdges_verts {es : Edges} {x : ℕ} : x ∈ (ofEdges es).verts ↔ InEnds es x := by
  simp only [ofEdges, List.mem_toFinset, List.mem_flatMap, List.mem_cons, List.not_mem_nil, or_false, InEnds]
  constructor
  · rintro ⟨e, he, h | h⟩
    · exact ⟨e, he, Or.inl h.symm⟩
    · exact ⟨e, he, Or.inr h.symm⟩
  · rintro ⟨e, he, h | h⟩
    · exact ⟨e, he, Or.inl h.symm⟩
    · exact ⟨e, he, Or.inr h.symm⟩

/-- The identity isomorphism. -/
def Iso.refl (es : Edges) : Iso (ofEdges es) es where
  f := id
  g := id
  gf := fun _ _ => rfl
  fg := fun _ _ => rfl
  fv := fun _ h => mem_ofEdges_verts.mp h
  gv := fun _ h => mem_ofEdges_verts.mpr h
  mult_eq := fun u _ v _ => ofEdges_mult es u v

/-- Composition of isomorphisms. -/
def Iso.trans {V : Type*} {G : UMultigraph V} {es es' : Edges} (φ : Iso G es) (ψ : Iso (ofEdges es) es') :
    Iso G es' where
  f := ψ.f ∘ φ.f
  g := φ.g ∘ ψ.g
  gf := fun v hv => by
    simp only [Function.comp]
    rw [ψ.gf _ (mem_ofEdges_verts.mpr (φ.fv v hv)), φ.gf v hv]
  fg := fun x hx => by
    simp only [Function.comp]
    rw [φ.fg _ (mem_ofEdges_verts.mp (ψ.gv x hx)), ψ.fg x hx]
  fv := fun v hv => ψ.fv _ (mem_ofEdges_verts.mpr (φ.fv v hv))
  gv := fun x hx => φ.gv _ (mem_ofEdges_verts.mp (ψ.gv x hx))
  mult_eq := fun u hu v hv => by
    rw [φ.mult_eq u hu v hv, ← ofEdges_mult,
      ψ.mult_eq _ (mem_ofEdges_verts.mpr (φ.fv u hu)) _ (mem_ofEdges_verts.mpr (φ.fv v hv))]
    rfl

/-- Two bond lists with the same multiplicities are isomorphic (by the identity). -/
def Iso.ofSameMult {es es' : Edges} (h : ∀ a b, mult es a b = mult es' a b) : Iso (ofEdges es) es' where
  f := id
  g := id
  gf := fun _ _ => rfl
  fg := fun _ _ => rfl
  fv := fun x hx => by
    obtain ⟨y, hy⟩ := inEnds_iff.mp (mem_ofEdges_verts.mp hx)
    exact inEnds_iff.mpr ⟨y, by rw [← h]; exact hy⟩
  gv := fun x hx => by
    obtain ⟨y, hy⟩ := inEnds_iff.mp hx
    exact mem_ofEdges_verts.mpr (inEnds_iff.mpr ⟨y, by rw [h]; exact hy⟩)
  mult_eq := fun u _ v _ => by rw [ofEdges_mult, h]; rfl

/-! ## Multiplicities after the operations -/

theorem mult_eraseOne (es : Edges) (x y u v : ℕ) (h : mult es x y ≠ 0) :
    mult (eraseOne es x y) u v + (if s(u, v) = s(x, y) then 1 else 0) = mult es u v := by
  induction es with
  | nil => simp at h
  | cons e es ih =>
    simp only [eraseOne]
    by_cases he : isPair x y e = true
    · rw [if_pos he, mult_cons]
      have : isPair u v e = true ↔ s(u, v) = s(x, y) := by
        rw [isPair_iff_sym2, (isPair_iff_sym2 x y e).mp he, eq_comm]
      by_cases huv : s(u, v) = s(x, y)
      · simp [huv, this.mpr huv, Nat.add_comm]
      · have : isPair u v e = false := by
          cases hh : isPair u v e
          · rfl
          · exact absurd (this.mp hh) huv
        simp [huv, this]
    · rw [if_neg he, mult_cons, mult_cons, Nat.add_assoc, ih]
      rw [mult_cons] at h
      simpa [he] using h

theorem mult_z1 (es : Edges) (x y a b u v : ℕ) (h : mult es x y ≠ 0) :
    mult (z1 es x y a b) u v + (if s(u, v) = s(x, y) then 1 else 0) = mult es u v +
      ((if s(u, v) = s(x, a) then 1 else 0) + 3 * (if s(u, v) = s(a, b) then 1 else 0) +
        (if s(u, v) = s(b, y) then 1 else 0)) := by
  have he := mult_eraseOne es x y u v h
  simp only [z1, mult_append]
  have hnew : mult [(x, a), (a, b), (a, b), (a, b), (b, y)] u v =
      (if s(u, v) = s(x, a) then 1 else 0) + 3 * (if s(u, v) = s(a, b) then 1 else 0) +
        (if s(u, v) = s(b, y) then 1 else 0) := by
    simp only [mult_eq_count, List.map_cons, List.map_nil, List.count_cons, List.count_nil]
    have e1 : (s(x, a) == s(u, v)) = decide (s(u, v) = s(x, a)) := by
      rw [beq_eq_decide]; exact decide_eq_decide.mpr eq_comm
    have e2 : (s(a, b) == s(u, v)) = decide (s(u, v) = s(a, b)) := by
      rw [beq_eq_decide]; exact decide_eq_decide.mpr eq_comm
    have e3 : (s(b, y) == s(u, v)) = decide (s(u, v) = s(b, y)) := by
      rw [beq_eq_decide]; exact decide_eq_decide.mpr eq_comm
    rw [e1, e2, e3]
    simp only [decide_eq_true_eq, List.count_nil]
    split_ifs <;> omega
  omega

end WaveTurbulence.TVine.Checker
